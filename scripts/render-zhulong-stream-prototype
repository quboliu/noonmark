#!/usr/bin/env bash
set -euo pipefail

prototype_dir="${NOONMARK_ZHULONG_STREAM_PROTOTYPE_DIR:-docs/design/prototypes/zhulong-converged-2026-07-10}"
out_dir="${NOONMARK_ZHULONG_STREAM_PROTOTYPE_OUT_DIR:-artifacts/zhulong-stream-prototype}"
prototype_html="${prototype_dir}/stream-prototype.html"

chrome_binary="${NOONMARK_CHROME_BINARY:-}"
if [[ -z "$chrome_binary" ]]; then
  if command -v google-chrome >/dev/null 2>&1; then
    chrome_binary="$(command -v google-chrome)"
  elif command -v chromium >/dev/null 2>&1; then
    chrome_binary="$(command -v chromium)"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    chrome_binary="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    echo "missing Chrome/Chromium for Zhulong stream prototype rendering" >&2
    exit 1
  fi
fi

if [[ ! -f "$prototype_html" ]]; then
  echo "missing stream prototype HTML: $prototype_html" >&2
  exit 1
fi

scenarios=(
  "01-c-focus|variant=C&scenario=focus|1320|820"
  "02-c-gate|variant=C&scenario=gate|1320|820"
  "03-c-draft|variant=C&scenario=draft|1320|820"
  "04-c-receipt|variant=C&scenario=receipt|1320|820"
  "05-c-corrected|variant=C&scenario=corrected|1320|820"
  "06-c-long-top|variant=C&scenario=long&scroll=top|1320|820"
  "07-c-long-bottom|variant=C&scenario=long&scroll=bottom|1320|820"
  "08-a-focus|variant=A&scenario=focus|1320|820"
  "09-a-draft|variant=A&scenario=draft|1320|820"
  "10-a-corrected|variant=A&scenario=corrected|1320|820"
  "11-b-focus|variant=B&scenario=focus|1320|820"
  "12-b-draft|variant=B&scenario=draft|1320|820"
  "13-b-corrected|variant=B&scenario=corrected|1320|820"
  "14-c-focus-minimum|variant=C&scenario=focus|1180|760"
  "15-c-draft-minimum|variant=C&scenario=draft|1180|760"
  "16-c-long-top-minimum|variant=C&scenario=long&scroll=top|1180|760"
  "17-a-draft-minimum|variant=A&scenario=draft|1180|760"
  "18-b-draft-minimum|variant=B&scenario=draft|1180|760"
  "19-c-layout-menu|variant=C&scenario=focus&fixture=layout-menu|1320|820"
  "20-c-layout-menu-minimum|variant=C&scenario=focus&fixture=layout-menu|1180|760"
)

rm -rf "$out_dir"
mkdir -p "$out_dir"

cleanup() {
  rm -rf "${out_dir}"/.*-chrome-profile 2>/dev/null || true
}
trap cleanup EXIT INT TERM

for scenario in "${scenarios[@]}"; do
  IFS="|" read -r name query width height <<<"$scenario"
  screenshot="$PWD/${out_dir}/${name}.png"
  user_data_dir="$PWD/${out_dir}/.${name}-chrome-profile"
  url="file://$PWD/${prototype_html}?${query}"

  rm -rf "$user_data_dir" "$screenshot"
  python3 - "$screenshot" "$chrome_binary" \
    --headless=new \
    --disable-gpu \
    --disable-background-networking \
    --disable-component-update \
    --disable-extensions \
    --hide-scrollbars \
    --no-default-browser-check \
    --no-first-run \
    --user-data-dir="$user_data_dir" \
    --virtual-time-budget=1500 \
    --screenshot="$screenshot" \
    --window-size="${width},${height}" \
    "$url" <<'PY'
import os
import signal
import subprocess
import sys
import time

screenshot = sys.argv[1]
command = sys.argv[2:]
process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)


def stop_process():
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        return process.communicate(timeout=3)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        return process.communicate(timeout=3)


deadline = time.monotonic() + 30
while process.poll() is None:
    if os.path.exists(screenshot):
        stop_process()
        raise SystemExit(0)
    if time.monotonic() >= deadline:
        _, stderr = stop_process()
        raise SystemExit(f"stream prototype screenshot timed out after 30s\n{stderr}")
    time.sleep(0.1)

_, stderr = process.communicate()
if os.path.exists(screenshot):
    raise SystemExit(0)
raise SystemExit(stderr or f"stream prototype screenshot failed with exit code {process.returncode}")
PY

  actual_width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  actual_height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"
  file_size="$(stat -f %z "$screenshot")"
  if [[ "$actual_width" -ne "$width" || "$actual_height" -ne "$height" ]]; then
    echo "invalid stream screenshot size for ${name}: ${actual_width}x${actual_height}" >&2
    exit 1
  fi
  if [[ "$file_size" -lt 20000 ]]; then
    echo "stream screenshot appears blank or truncated for ${name}: ${file_size} bytes" >&2
    exit 1
  fi

  echo "rendered ${out_dir}/${name}.png (${actual_width}x${actual_height}, ${file_size} bytes)"
  rm -rf "$user_data_dir"
done

echo "rendered ${#scenarios[@]} stream prototype scenarios into ${out_dir}"
