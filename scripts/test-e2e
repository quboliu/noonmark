mkdir -p "$classification_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$classification_db" \
  --page pool \
  --e2e-classification-edit \
  --e2e-classification-title "$classification_title" \
  --e2e-classification-result-url "$PWD/$classification_edit_result" \
  --e2e-quit-after-automation

if [[ ! -f "$classification_edit_result" ]]; then
  echo "classification edit automation failed: missing result" >&2
  exit 1
fi
if [[ "$(<"$classification_edit_result")" != "ok" ]]; then
  echo "classification edit automation failed: $(<"$classification_edit_result")" >&2
  exit 1
fi

