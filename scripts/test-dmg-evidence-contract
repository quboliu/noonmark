refresh_closure_fixture_bindings() {
  local inner_sha256
  local result_sha256
  local inventory_sha256

  inner_sha256="$(
    shasum -a 256 "$closure_inner_manifest" | awk '{print $1}'
  )"
  result_sha256="$(
    shasum -a 256 "$closure_result" | awk '{print $1}'
  )"
  sed -i '' \
    "s/^closure_e2e_manifest_sha256=.*/closure_e2e_manifest_sha256=${inner_sha256}/" \
    "$closure_manifest"
  sed -i '' \
    "s/^gate_result_sha256=.*/gate_result_sha256=${result_sha256}/" \
    "$closure_manifest"
  rm -f "$closure_inventory"
  if [[ -e "$closure_inventory" || -L "$closure_inventory" ]]; then
    echo "could not clear stale release-closure artifact inventory" >&2
    return 1
  fi
  (
    cd "$fixture_root"
    source scripts/evidence-common
    evidence_inventory \
      "$PWD" \
      artifacts/release-diagnostic-closure-gate/artifact-inventory.sha256 \
      artifacts/release-diagnostic-closure-gate/test-e2e.log \
      artifacts/release-diagnostic-closure-gate/result.txt \
      artifacts/release-diagnostic-closure-gate/e2e-runtime \
      artifacts/release-diagnostic-closure-gate/e2e-diagnostic-closure
  )
  inventory_sha256="$(
    shasum -a 256 "$closure_inventory" | awk '{print $1}'
  )"
  sed -i '' \
    "s/^artifact_inventory_sha256=.*/artifact_inventory_sha256=${inventory_sha256}/" \
    "$closure_manifest"
}

restore_closure_fixture() {
  cp "$closure_manifest_pristine" "$closure_manifest"
  cp "$closure_inner_manifest_pristine" "$closure_inner_manifest"
  cp "$closure_result_pristine" "$closure_result"
  cp "$closure_restart_pristine" "$closure_restart"
  cp "$closure_inventory_pristine" "$closure_inventory"
}
sed -i '' \
  's/^evidence_run_id=.*/evidence_run_id=stale-closure-run/' \
  "$closure_manifest"
set +e
(
  cd "$fixture_root"
  scripts/verify-development-validation-evidence --scope full
) >"$fixture_root/cross-validator-stale-closure-run.stdout" \
  2>"$fixture_root/cross-validator-stale-closure-run.stderr"
stale_closure_run_status=$?
set -e
if [[ "$stale_closure_run_status" -eq 0 ]] ||
  ! grep -F \
    "development-validation evidence disagrees for release diagnostic closure evidence_run_id" \
    "$fixture_root/cross-validator-stale-closure-run.stderr" >/dev/null; then
  echo "full validator accepted a stale release-closure run ID" >&2
  exit 1
fi
restore_closure_fixture

sed -i '' \
  's/^evidence_run_id=.*/evidence_run_id=forged-inner-closure-run/' \
  "$closure_inner_manifest"
refresh_closure_fixture_bindings
set +e
(
  cd "$fixture_root"
  scripts/verify-development-validation-evidence --scope full
) >"$fixture_root/cross-validator-forged-inner-closure-run.stdout" \
  2>"$fixture_root/cross-validator-forged-inner-closure-run.stderr"
