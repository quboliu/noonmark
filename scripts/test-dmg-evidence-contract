rebind_diagnostic_export_claims() {
  local bytes
  local sha256
  local counts
  local record_count
  local active_count
  local capsule_count
  local metric_count
  local detail

  bytes="$(stat -f '%z' "$diagnostic_export")"
  sha256="$(shasum -a 256 "$diagnostic_export" | awk '{print $1}')"
  counts="$(
    jq -r '[
      (.records | length),
      (.activeOperations | length),
      (.operationCapsules | length),
      (.metricAttachments | length)
    ] | @tsv' "$diagnostic_export"
  )"
  IFS=$'\t' read -r \
    record_count active_count capsule_count metric_count <<<"$counts"
  detail="schema=1 bytes=$bytes sha256=$sha256 records=$record_count active=$active_count capsules=$capsule_count metrics=$metric_count sentinels=absent owner_only=true"
  awk -F $'\t' -v OFS=$'\t' -v detail="$detail" '
    $3 == "diagnostic-package" { $4 = detail }
    { print }
  ' "$diagnostic_ledger" >"${diagnostic_ledger}.rebound"
  mv "${diagnostic_ledger}.rebound" "$diagnostic_ledger"
  cp "$diagnostic_ledger" "$diagnostic_helper"
  sed -i '' \
    -e "s/^bytes=.*/bytes=${bytes}/" \
    -e "s/^sha256=.*/sha256=${sha256}/" \
    "$diagnostic_package_report"
  sed -i '' \
    -e "s/^diagnostic_export_bytes=.*/diagnostic_export_bytes=${bytes}/" \
    -e "s/^diagnostic_export_sha256=.*/diagnostic_export_sha256=${sha256}/" \
    "$install_manifest"
  refresh_install_manifest_binding \
    "$diagnostic_export_relative"
  refresh_install_manifest_artifact_binding \
    "$diagnostic_ledger_relative" \
    "diagnostic_export_ledger_sha256"
  refresh_install_manifest_artifact_binding \
    "artifacts/dmg-install/diagnostic-export-helper.log" \
    "diagnostic_export_helper_stdout_sha256"
  refresh_install_manifest_artifact_binding \
    "artifacts/dmg-install/diagnostic-export-package.txt" \
    "diagnostic_export_package_report_sha256"
}

awk 'NR == 8 { held = $0; next } NR == 9 { print; print held; next } { print }' \
