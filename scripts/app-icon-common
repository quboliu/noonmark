# Shared manifest and renderer for the canonical Noonmark app icon assets.

app_icon_resources_dir="App/NoonmarkMacApp/Resources"
app_icon_source_svg="${app_icon_resources_dir}/AppIcon-source.svg"
app_icon_master_png="${app_icon_resources_dir}/AppIcon-master.png"
app_icon_iconset_dir="${app_icon_resources_dir}/AppIcon.iconset"
app_icon_icns_path="${app_icon_resources_dir}/AppIcon.icns"
app_icon_bundle_icon_name="AppIcon"
app_icon_srgb_profile="/System/Library/ColorSync/Profiles/sRGB Profile.icc"
app_icon_representations=(
  "icon_16x16.png:16"
  "icon_16x16@2x.png:32"
  "icon_32x32.png:32"
  "icon_32x32@2x.png:64"
  "icon_128x128.png:128"
  "icon_128x128@2x.png:256"
  "icon_256x256.png:256"
  "icon_256x256@2x.png:512"
  "icon_512x512.png:512"
  "icon_512x512@2x.png:1024"
)

readonly app_icon_resources_dir
readonly app_icon_source_svg
readonly app_icon_master_png
readonly app_icon_iconset_dir
readonly app_icon_icns_path
readonly app_icon_bundle_icon_name
readonly app_icon_srgb_profile
readonly app_icon_representations

app_icon_render_optical_png() {
  local optical_size="$1"
  local size="$2"
  local destination="$3"
  local raw_destination

  raw_destination="${destination}.unprofiled.$$.png"
  NOONMARK_APP_ICON_OPTICAL_SIZE="$optical_size" \
    NOONMARK_APP_ICON_SIZE="$size" \
    NOONMARK_APP_ICON_OUTPUT="$raw_destination" \
    swift scripts/app-icon-optical-renderer.swift

  sips \
    -s format png \
    --matchTo "$app_icon_srgb_profile" \
    "$raw_destination" \
    --out "$destination" >/dev/null
  rm -f "$raw_destination"
}

app_icon_render_representation() {
  local filename="$1"
  local size="$2"
  local destination="$3"

  case "$filename" in
    icon_16x16.png)
      app_icon_render_optical_png 16 "$size" "$destination"
      ;;
    icon_16x16@2x.png)
      app_icon_render_optical_png 16 "$size" "$destination"
      ;;
    icon_32x32.png)
      app_icon_render_optical_png 32 "$size" "$destination"
      ;;
    icon_32x32@2x.png)
      app_icon_render_optical_png 32 "$size" "$destination"
      ;;
    *)
      app_icon_render_png "$size" "$destination"
      ;;
  esac
}

app_icon_render_png() {
  local size="$1"
  local destination="$2"
  local raw_destination

  raw_destination="${destination}.unprofiled.$$.png"
  sips \
    -s format png \
    -z "$size" "$size" \
    "$app_icon_source_svg" \
    --out "$raw_destination" >/dev/null

  sips \
    -s format png \
    --matchTo "$app_icon_srgb_profile" \
    "$raw_destination" \
    --out "$destination" >/dev/null
  rm -f "$raw_destination"
}
