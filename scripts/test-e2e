run_quick_add_ui_probe() {
  local quick_add_dir="artifacts/e2e-quick-add-ui"
  local day_db="$quick_add_dir/day.sqlite"
  local pool_db="$quick_add_dir/pool.sqlite"
  local day_result="$quick_add_dir/day-result.txt"
  local pool_result="$quick_add_dir/pool-result.txt"
  local day_log="$quick_add_dir/day.log"
  local pool_log="$quick_add_dir/pool.log"
  local day_title="dayreturntask"
  local pool_title="poolreturntask"
  local day_persisted
  local pool_persisted

  rm -rf "$quick_add_dir"
  mkdir -p "$quick_add_dir"

  run_terminating_ui_probe \
    "Day Todo quick-add real Return" \
    "$day_result" \
    "$day_log" \
    --data-url "$PWD/$day_db" \
    --page day \
    --e2e-quick-add-via-ui day \
    --e2e-quick-add-ui-title "$day_title" \
    --e2e-quick-add-ui-result-url "$PWD/$day_result"

  day_persisted="$(sqlite3 -noheader "$day_db" "
    SELECT count(*)
    FROM day_traces
    JOIN task_definitions ON task_definitions.id = day_traces.definition_id
    WHERE task_definitions.title = '$day_title'
      AND day_traces.date = '2026-07-05'
      AND day_traces.status = 'pending';
  ")"
  if [[ "$day_persisted" != "1" ]]; then
    echo "Day Todo quick-add persistence failed: ${day_persisted:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-pool quick-add real Return" \
    "$pool_result" \
    "$pool_log" \
    --data-url "$PWD/$pool_db" \
    --page pool \
    --e2e-quick-add-via-ui pool \
    --e2e-quick-add-ui-title "$pool_title" \
    --e2e-quick-add-ui-result-url "$PWD/$pool_result"

  pool_persisted="$(sqlite3 -noheader "$pool_db" "
    SELECT count(*)
    FROM task_chains
    JOIN task_definitions ON task_definitions.chain_id = task_chains.id
    WHERE task_definitions.title = '$pool_title'
      AND task_chains.state = 'active'
      AND NOT EXISTS (
        SELECT 1 FROM day_traces WHERE day_traces.chain_id = task_chains.id
      );
  ")"
  if [[ "$pool_persisted" != "1" ]]; then
    echo "task-pool quick-add persistence failed: ${pool_persisted:-missing}" >&2
    exit 1
  fi

  echo "E2E real quick-add Return, geometry, and persistence: $day_db $pool_db"
}

