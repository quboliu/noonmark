run_zhulong_chat_conversation_probe() {
  local chat_dir="artifacts/e2e-zhulong-chat"
  local chat_database="${chat_dir}/Noonmark.sqlite"
  local interaction_result="${chat_dir}/interaction-result.txt"
  local interaction_log="${chat_dir}/interaction.log"
  local restart_result="${chat_dir}/restart-result.txt"

  rm -rf "$chat_dir"
  mkdir -p "$chat_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "zhulong chat keyboard, reauthorization, and workflow context" \
    "$interaction_result" \
    "$interaction_log" \
    --data-url "$PWD/$chat_database" \
    --page zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-zhulong-chat-provider \
    --e2e-zhulong-chat-ui \
    --e2e-zhulong-chat-result-url "$PWD/$interaction_result"

  capture_app_screenshot \
    "$chat_dir" \
    "zhulong-chat-restart" \
    zhulong \
    --data-url "$PWD/$chat_database" \
    --e2e-zhulong-sidecar-key \
    --e2e-zhulong-chat-provider \
    --e2e-zhulong-chat-restart \
    --e2e-zhulong-chat-result-url "$PWD/$restart_result"

  if [[ ! -f "$restart_result" || "$(<"$restart_result")" != "ok" ]]; then
    echo "zhulong chat restart persistence failed: $(cat "$restart_result" 2>/dev/null || echo missing)" >&2
    terminate_e2e_app
    exit 1
  fi
  terminate_e2e_app
  echo "E2E zhulong chat keyboard, reauthorization, workflow context, and restart persistence: $chat_dir"
}

