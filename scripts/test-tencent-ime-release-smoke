#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

configuration="${1:-debug}"
if [[ "${1:-}" == "--contract" && "$#" -eq 1 ]]; then
  cat <<'EOF'
surface=day-title
input_source=com.tencent.inputmethod.wetype.pinyin
behavior=composition-commit,immediate-exit,restart-sqlite-readback
EOF
  exit 0
fi
if [[ "$#" -gt 1 ]]; then
  echo "usage: scripts/test-tencent-ime-release-smoke [debug|release] | --contract" >&2
  exit 64
fi
case "$configuration" in
  debug | release) ;;
  *)
    echo "unsupported Tencent IME smoke configuration: $configuration" >&2
    exit 64
    ;;
esac

# The release criterion is one stable user promise, not the whole coverage
# catalog: real Tencent composition commits exact text, the app exits while the
# autosave is pending, then the restarted App and SQLite agree on that text.
NOONMARK_TENCENT_IME_TERMINATION_SURFACES=day-title \
  NOONMARK_TENCENT_IME_SKIP_FAILURE_RETRY=1 \
  scripts/test-tencent-ime-termination-persistence "$configuration"

summary_path="artifacts/e2e-tencent-ime-termination/results.tsv"
if ! awk -F $'\t' '
  NR == 1 { next }
  $1 == "day-title" {
    count += 1
    if ($2 == "PASS" && $4 == "false" && $5 == "true" && $6 == "true") {
      passed = 1
    }
  }
  END { exit(count == 1 && passed ? 0 : 1) }
' "$summary_path"; then
  echo "Tencent IME release smoke did not prove the day-title restart path" >&2
  exit 1
fi

echo "Tencent IME release smoke passed: day-title composition, exit, restart"
