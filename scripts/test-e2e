#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "missing required tool: sqlite3" >&2
  exit 1
fi

app_bundle_name="NoonmarkMacAppE2E"
app_executable_name="NoonmarkMacAppE2E"
app_display_name="晷迹 E2E"
expected_window_width="1200"
expected_window_height="768"
app_path="dist/${app_bundle_name}.app"
app_executable_path="${app_path}/Contents/MacOS/${app_executable_name}"
export NOONMARK_E2E_APP_EXECUTABLE_NAME="$app_executable_name"
export NOONMARK_E2E_APP_DISPLAY_NAME="$app_display_name"
export NOONMARK_E2E_EXPECTED_WINDOW_WIDTH="$expected_window_width"
export NOONMARK_E2E_EXPECTED_WINDOW_HEIGHT="$expected_window_height"

scenarios=(
  "day|day|"
  "day-sidebar-collapsed|day|--e2e-collapse-sidebar"
  "day-subtasks-expanded|day|--e2e-expand-first-subtask-trace"
  "day-changed-target|day|--select changed"
  "day-detail|day|--select first"
  "day-manual-detail|day|--select manual"
  "day-review-saved|day|--e2e-update-review --e2e-review-summary E2E自动保存反馈"
  "pool|pool|"
  "pool-context-menu|pool|--e2e-open-pool-context-menu"
  "pool-classification-overflow|pool|--e2e-classification-overflow-via-ui --e2e-classification-overflow-ui-result-url $PWD/artifacts/e2e/pool-classification-overflow-ui.txt --e2e-ui-entry-keep-open"
  "pool-classification-manager|pool|--select first --e2e-classification-manager-via-ui --e2e-classification-manager-ui-result-url $PWD/artifacts/e2e/pool-classification-manager-ui.txt --e2e-ui-entry-keep-open"
  "pool-classification-manager-labels|pool|--select first --e2e-classification-manager-labels-via-ui --e2e-classification-manager-ui-result-url $PWD/artifacts/e2e/pool-classification-manager-labels-ui.txt --e2e-ui-entry-keep-open"
  "pool-detail|pool|--select first"
  "pool-detail-classification-edit|pool|--select first --e2e-open-classification-label-editor"
  "future|future|"
  "future-detail|future|--select first"
  "unfinished|unfinished|"
  "unfinished-detail|unfinished|--select first"
  "completed|completed|"
  "completed-detail|completed|--select first"
  "calendar|calendar|"
  "calendar-detail-expanded|calendar|--e2e-expand-detail-rail"
  "zhulong|zhulong|--e2e-enable-zhulong"
  "zhulong-stream|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session"
  "zhulong-authorized|zhulong|--e2e-zhulong-sidecar-key --e2e-start-zhulong-workflow dailyReview"
  "zhulong-todo-diff-editor|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-todo-diff --e2e-open-zhulong-todo-diff-editor"
  "settings|settings|"
  "settings-groups|settings|--e2e-settings-groups"
  "settings-sync|settings|--e2e-settings-sync"
)

requested_scenarios="${NOONMARK_E2E_SCENARIOS:-}"
if [[ -n "$requested_scenarios" ]]; then
  filtered_scenarios=()
  for requested in $requested_scenarios; do
    found=0
    for scenario in "${scenarios[@]}"; do
      IFS="|" read -r screenshot_name _ <<< "$scenario"
      if [[ "$screenshot_name" == "$requested" ]]; then
        filtered_scenarios+=("$scenario")
        found=1
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      echo "unknown E2E screenshot scenario: $requested" >&2
      exit 1
    fi
  done
  scenarios=("${filtered_scenarios[@]}")
fi

scripts/build-mac-app "$configuration" e2e

mkdir -p artifacts/e2e

terminate_e2e_app() {
  pkill -x "$app_executable_name" 2>/dev/null || true
  for _ in {1..40}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    pkill -9 -x "$app_executable_name" 2>/dev/null || true
  fi
  for _ in {1..20}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    echo "failed to terminate ${app_executable_name}" >&2
    return 1
  fi
  for _ in {1..30}; do
    if ! has_e2e_windows; then
      return 0
    fi
    sleep 0.1
  done
  echo "failed to close visible ${app_display_name} windows" >&2
  return 1
}

visible_e2e_windows() {
  swift -e '
import CoreGraphics
import Foundation

let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner == expectedOwner || owner == expectedDisplayName {
            print("window owner=\(owner) title=\(name)")
        }
    }
}
'
}

has_e2e_windows() {
  [[ -n "$(visible_e2e_windows)" ]]
}

terminate_e2e_app
trap 'terminate_e2e_app >/dev/null 2>&1 || true' EXIT

find_window_id() {
  local expected_title="$1"
  NOONMARK_E2E_EXPECTED_WINDOW_TITLE="$expected_title" swift -e '
import CoreGraphics
import Darwin
import Foundation

let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"
let expectedTitle = ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_TITLE"] ?? "晷迹 · Day Todo — 7月5日"
let expectedWidth = Double(ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_WIDTH"] ?? "") ?? 0
let expectedHeight = Double(ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_HEIGHT"] ?? "") ?? 0

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        var allowedOwners = [expectedOwner, expectedDisplayName]
        if expectedOwner == "NoonmarkMacApp" {
            allowedOwners.append(contentsOf: ["晷迹", "Noonmark", "NoonmarkMacApp"])
        }
        if allowedOwners.contains(owner) && name == expectedTitle {
            let layer = window[kCGWindowLayer as String] as? Int ?? -1
            let bounds = window[kCGWindowBounds as String] as? [String: Any]
            let width = bounds?["Width"] as? Double ?? 0
            let height = bounds?["Height"] as? Double ?? 0
            if layer == 0, width == expectedWidth, height == expectedHeight,
               let number = window[kCGWindowNumber as String]
            {
                print(number)
                exit(0)
            }
        }
    }
}
exit(1)
'
}

find_auxiliary_window_id() {
  local window_id="$1"
  NOONMARK_E2E_WINDOW_ID="$window_id" swift -e '
import CoreGraphics
import Foundation

let expectedID = Int(ProcessInfo.processInfo.environment["NOONMARK_E2E_WINDOW_ID"] ?? "") ?? -1
let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"

guard let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]],
      let main = list.first(where: { ($0[kCGWindowNumber as String] as? Int) == expectedID }),
      let mainBounds = main[kCGWindowBounds as String] as? [String: Any],
      let mainX = mainBounds["X"] as? Double,
      let mainY = mainBounds["Y"] as? Double,
      let mainWidth = mainBounds["Width"] as? Double,
      let mainHeight = mainBounds["Height"] as? Double,
      let mainProcessID = main[kCGWindowOwnerPID as String] as? Int
else {
    exit(1)
}

var best: (id: Int, area: Double)?
for window in list {
    guard let number = window[kCGWindowNumber as String] as? Int,
          number != expectedID,
          (window[kCGWindowOwnerPID as String] as? Int) == mainProcessID,
          let owner = window[kCGWindowOwnerName as String] as? String,
          owner == expectedOwner || owner == expectedDisplayName,
          let bounds = window[kCGWindowBounds as String] as? [String: Any],
          let x = bounds["X"] as? Double,
          let y = bounds["Y"] as? Double,
          let width = bounds["Width"] as? Double,
          let height = bounds["Height"] as? Double,
          width >= 40,
          height >= 40,
          width < mainWidth,
          height < mainHeight,
          x < mainX + mainWidth,
          x + width > mainX,
          y < mainY + mainHeight,
          y + height > mainY
    else { continue }
    let area = width * height
    if best == nil || area > best!.area {
        best = (number, area)
    }
}
if let best {
    print(best.id)
    exit(0)
}
exit(1)
'
}

dump_visible_windows() {
  swift -e '
import CoreGraphics
import Foundation

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner.contains("Noonmark") || owner.contains("晷迹") || name.contains("晷迹") {
            let number = window[kCGWindowNumber as String] as? Int ?? -1
            let processID = window[kCGWindowOwnerPID as String] as? Int ?? -1
            let layer = window[kCGWindowLayer as String] as? Int ?? -1
            let bounds = window[kCGWindowBounds as String] as? [String: Any] ?? [:]
            print("window id=\(number) pid=\(processID) owner=\(owner) title=\(name) layer=\(layer) bounds=\(bounds)")
        }
    }
}
'
}

capture_app_screenshot() {
  local out_dir="$1"
  local screenshot_name="$2"
  local page="$3"
  local launch_log
  local expected_window_title
  local ui_entry_result=""
  shift 3

  local arguments=("$@")
  for ((index = 0; index < ${#arguments[@]}; index++)); do
    if [[ "${arguments[$index]}" == "--e2e-classification-manager-ui-result-url" ||
      "${arguments[$index]}" == "--e2e-classification-overflow-ui-result-url" ]]; then
      ui_entry_result="${arguments[$((index + 1))]:-}"
      break
    fi
  done
  if [[ -n "$ui_entry_result" ]]; then
    rm -f "$ui_entry_result"
  fi

  launch_log="${out_dir}/${screenshot_name}.log"

  case "$page" in
    day)
      if [[ "$screenshot_name" == "day-changed-target" ]]; then
        expected_window_title="晷迹 · Day Todo — 7月4日"
      else
        expected_window_title="晷迹 · Day Todo — 7月5日"
      fi
      ;;
    pool) expected_window_title="晷迹 · 任务池" ;;
    future) expected_window_title="晷迹 · 未来计划" ;;
    unfinished) expected_window_title="晷迹 · 未完成" ;;
    completed) expected_window_title="晷迹 · 已完成" ;;
    calendar) expected_window_title="晷迹 · 日历 — 7月5日" ;;
    zhulong) expected_window_title="晷迹 · 烛龙" ;;
    settings) expected_window_title="晷迹 · 设置" ;;
    *) expected_window_title="晷迹 · Noonmark" ;;
  esac

  window_id=""
  : >"$launch_log"
  for launch_attempt in {1..3}; do
    terminate_e2e_app
    mkdir -p "$out_dir"
    echo "launch attempt=$launch_attempt page=$page expected_title=$expected_window_title" >>"$launch_log"
    "$app_executable_path" "$@" --page "$page" >>"$launch_log" 2>&1 &
    app_pid=$!
    sleep "${NOONMARK_E2E_STARTUP_WAIT:-3}"

    for _ in {1..20}; do
      if window_id="$(find_window_id "$expected_window_title" 2>/dev/null)"; then
        break
      fi
      sleep 0.25
    done

    if [[ -n "$window_id" ]]; then
      disown "$app_pid" 2>/dev/null || true
      break
    fi
    if kill -0 "$app_pid" >/dev/null 2>&1; then
      echo "launch attempt=$launch_attempt pid=$app_pid state=running window_match=missing" >>"$launch_log"
    else
      app_exit_code=0
      wait "$app_pid" || app_exit_code=$?
      echo "launch attempt=$launch_attempt pid=$app_pid state=exited exit_code=$app_exit_code window_match=missing" >>"$launch_log"
    fi
    dump_visible_windows >>"$launch_log"
    terminate_e2e_app
    sleep 0.5
  done

  if [[ -z "$window_id" ]]; then
    echo "Noonmark app window not found for ${page}" >&2
    cat "$launch_log" >&2
    exit 1
  fi

  if [[ -n "$ui_entry_result" ]]; then
    for _ in {1..80}; do
      if [[ -f "$ui_entry_result" ]]; then
        break
      fi
      sleep 0.1
    done
    if [[ ! -f "$ui_entry_result" ]]; then
      echo "UI entry result was not created: $ui_entry_result" >&2
      exit 1
    fi
    if [[ "$(<"$ui_entry_result")" != "ok" ]]; then
      echo "UI entry failed: $(<"$ui_entry_result")" >&2
      exit 1
    fi
  fi

  mkdir -p "$out_dir"
  screenshot="${out_dir}/${screenshot_name}.png"
  if [[ "$screenshot_name" == "pool-classification-overflow" ]]; then
    auxiliary_window_id=""
    for _ in {1..20}; do
      if auxiliary_window_id="$(find_auxiliary_window_id "$window_id" 2>/dev/null)"; then
        break
      fi
      sleep 0.1
    done
    if [[ -z "$auxiliary_window_id" ]]; then
      echo "classification overflow popover window not found" >&2
      dump_visible_windows >&2
      exit 1
    fi
    warmup_screenshot="${screenshot}.warmup.png"
    screencapture -x -l "$window_id" "$warmup_screenshot"
    sleep 0.25
    screencapture -x -l "$window_id" "$screenshot"
    rm -f "$warmup_screenshot"
  else
    warmup_screenshot="${screenshot}.warmup.png"
    screencapture -x -l "$window_id" "$warmup_screenshot"
    sleep 0.25
    screencapture -x -l "$window_id" "$screenshot"
    rm -f "$warmup_screenshot"
  fi
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"

  if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 || "${width:-0}" -gt 3000 || "${height:-0}" -gt 2000 ]]; then
    echo "invalid e2e screenshot size for ${screenshot_name}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  echo "E2E ${screenshot_name} screenshot: ${screenshot} (${width}x${height})"
}

assert_clean_app_log() {
  local label="$1"
  local log_path="$2"
  local failure_pattern='Noonmark persistence (load|save) failed|Fatal error|Assertion failed|Precondition failed'

  if grep -E -n "$failure_pattern" "$log_path" >/dev/null 2>&1; then
    echo "${label} app log contains a persistence or runtime failure:" >&2
    grep -E -n "$failure_pattern" "$log_path" >&2
    exit 1
  fi
}

assert_pool_context_menu_screenshot() {
  local screenshot="artifacts/e2e/pool-context-menu.png"
  local ocr="artifacts/e2e/pool-context-menu-ocr.txt"
  local ocr_log="artifacts/e2e/pool-context-menu-ocr.log"

  if [[ -n "$requested_scenarios" && " $requested_scenarios " != *" pool-context-menu "* ]]; then
    return 0
  fi
  if [[ ! -f "$screenshot" ]]; then
    echo "pool context-menu screenshot is missing: $screenshot" >&2
    exit 1
  fi
  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$screenshot" swift -e '
import AppKit
import Foundation
import Vision

guard let path = ProcessInfo.processInfo.environment["NOONMARK_E2E_OCR_IMAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    exit(1)
}
let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["zh-Hans", "en-US"]
request.usesLanguageCorrection = false
try VNImageRequestHandler(cgImage: cgImage).perform([request])
print((request.results ?? [])
    .compactMap { $0.topCandidates(1).first?.string }
    .joined(separator: "\n"))
' >"$ocr" 2>"$ocr_log"; then
    echo "pool context-menu screenshot OCR failed:" >&2
    cat "$ocr_log" >&2
    exit 1
  fi
  for expected in 排期到今天 排期到明天 选择日期 删除任务; do
    if ! grep -Fq "$expected" "$ocr"; then
      echo "pool context-menu is missing $expected; OCR output:" >&2
      cat "$ocr" >&2
      exit 1
    fi
  done
  echo "E2E pool task real context menu: $screenshot"
}

assert_pool_detail_density_screenshot() {
  local screenshot="artifacts/e2e/pool-detail.png"
  local result="artifacts/e2e/pool-detail-density.txt"
  local result_log="artifacts/e2e/pool-detail-density.log"

  if [[ -n "$requested_scenarios" && " $requested_scenarios " != *" pool-detail "* ]]; then
    return 0
  fi
  if [[ ! -f "$screenshot" ]]; then
    echo "pool detail screenshot is missing: $screenshot" >&2
    exit 1
  fi
  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$screenshot" swift -e '
import AppKit
import Foundation
import Vision

guard let path = ProcessInfo.processInfo.environment["NOONMARK_E2E_OCR_IMAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    exit(1)
}
let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["zh-Hans", "en-US"]
request.usesLanguageCorrection = false
try VNImageRequestHandler(cgImage: cgImage).perform([request])
let observations = request.results ?? []
let railObservations = observations.filter { $0.boundingBox.minX > 0.70 }
func observation(_ expected: String) -> VNRecognizedTextObservation? {
    railObservations.first { $0.topCandidates(1).first?.string == expected }
}
guard let title = observation("预约年度体检"),
      let description = observation("预约年度体检时间。")
else {
    print("missing deterministic pool-detail title or description")
    exit(2)
}
let expectedWindowWidth = CGFloat(
    Double(ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_WIDTH"] ?? "") ?? 0
)
guard expectedWindowWidth > 0 else {
    print("missing expected window width")
    exit(5)
}
let backingScale = CGFloat(cgImage.width) / expectedWindowWidth
let visibleGap = (title.boundingBox.minY - description.boundingBox.maxY)
    * CGFloat(cgImage.height) / backingScale
let roundedGap = visibleGap.rounded()
guard roundedGap >= 10, roundedGap <= 14 else {
    print("title-description visible gap is \(visibleGap)pt; expected rounded 10...14pt")
    exit(3)
}
let forbidden = Set(["更换", "排期"])
let redundantLabels = railObservations.compactMap { $0.topCandidates(1).first?.string }.filter(forbidden.contains)
guard redundantLabels.isEmpty else {
    print("pool detail still contains redundant labels: \(redundantLabels)")
    exit(4)
}
print(String(format: "title-description visible gap: %.2fpt", visibleGap))
' >"$result" 2>"$result_log"; then
    echo "pool detail density screenshot assertion failed:" >&2
    cat "$result" >&2
    cat "$result_log" >&2
    exit 1
  fi
  echo "E2E pool detail density: $(cat "$result")"
}

run_task_note_persistence_probe() {
  local note_dir="artifacts/e2e-task-notes"
  local note_db="${note_dir}/Noonmark.sqlite"
  local note_state="${note_dir}/state.json"
  local mutate_result="${note_dir}/mutate-result.txt"
  local restart_result="${note_dir}/restart-result.txt"
  local mutate_log="${note_dir}/mutate.log"
  local restart_log="${note_dir}/task-note-restart.log"
  local restart_screenshot="${note_dir}/task-note-restart.png"
  local restart_ocr="${note_dir}/task-note-restart-ocr.txt"
  local restart_ocr_log="${note_dir}/task-note-restart-ocr.log"
  local copy_result="${note_dir}/english-copy-result.txt"
  local copy_log="${note_dir}/english-copy.log"
  local mutate_pid
  local note_sql_probe

  rm -rf "$note_dir"
  mkdir -p "$note_dir"

  "$app_executable_path" \
    --data-url "$PWD/$note_db" \
    --page pool \
    --e2e-task-note-mutate \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$mutate_result" \
    >"$mutate_log" 2>&1 &
  mutate_pid=$!
  for _ in {1..100}; do
    if ! kill -0 "$mutate_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$mutate_pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$mutate_pid" 2>/dev/null || true
    echo "task-note mutation automation did not terminate" >&2
    cat "$mutate_log" >&2
    exit 1
  fi
  if ! wait "$mutate_pid"; then
    echo "task-note mutation app launch failed:" >&2
    cat "$mutate_log" >&2
    exit 1
  fi

  if [[ ! -f "$mutate_result" ]]; then
    echo "task-note mutation result was not created: $mutate_result" >&2
    exit 1
  fi
  if [[ "$(<"$mutate_result")" != "ok" ]]; then
    echo "task-note mutation failed: $(<"$mutate_result")" >&2
    exit 1
  fi
  if [[ ! -s "$note_state" ]]; then
    echo "task-note mutation state was not created: $note_state" >&2
    exit 1
  fi
  assert_clean_app_log "task-note mutation" "$mutate_log"

  capture_app_screenshot \
    "$note_dir" \
    "task-note-restart" \
    day \
    --data-url "$PWD/$note_db" \
    --e2e-task-note-verify \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$restart_result"

  if [[ ! -f "$restart_result" ]]; then
    echo "task-note restart result was not created: $restart_result" >&2
    terminate_e2e_app
    exit 1
  fi
  if [[ "$(<"$restart_result")" != "ok" ]]; then
    echo "task-note restart verification failed: $(<"$restart_result")" >&2
    terminate_e2e_app
    exit 1
  fi
  terminate_e2e_app
  assert_clean_app_log "task-note restart" "$restart_log"

  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$restart_screenshot" swift -e '
import AppKit
import Foundation
import Vision

let environment = ProcessInfo.processInfo.environment
guard let path = environment["NOONMARK_E2E_OCR_IMAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    fputs("unable to load task-note screenshot for OCR\n", stderr)
    exit(1)
}

let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["en-US"]
request.usesLanguageCorrection = false
let handler = VNImageRequestHandler(cgImage: cgImage)
try handler.perform([request])
let text = (request.results ?? [])
    .compactMap { $0.topCandidates(1).first?.string }
    .joined(separator: "\n")
print(text)
' >"$restart_ocr" 2>"$restart_ocr_log"; then
    echo "task-note restart screenshot OCR failed:" >&2
    cat "$restart_ocr_log" >&2
    exit 1
  fi

  if ! grep -Fq "VISIBLE NOTE 7263" "$restart_ocr"; then
    echo "task-note edited body was not visible after restart; OCR output:" >&2
    cat "$restart_ocr" >&2
    exit 1
  fi
  if grep -Fq "GHOST NOTE 9184" "$restart_ocr"; then
    echo "task-note deleted body reappeared after restart; OCR output:" >&2
    cat "$restart_ocr" >&2
    exit 1
  fi

  note_sql_probe="$(sqlite3 -separator " " "$note_db" "
    WITH target AS (
      SELECT
        trace.note_entries_json AS trace_note_entries_json,
        chain.note_entries_json AS chain_note_entries_json
      FROM day_traces AS trace
      JOIN task_definitions AS definition ON definition.id = trace.definition_id
      JOIN task_chains AS chain ON chain.id = trace.chain_id
      WHERE definition.title = 'E2E 附言编辑删除'
        AND trace.date = '2026-07-05'
      LIMIT 1
    )
    SELECT
      json_array_length(trace_note_entries_json),
      (SELECT count(DISTINCT json_extract(value, '$.id.rawValue'))
       FROM json_each(trace_note_entries_json)),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_extract(value, '$.body') = 'VISIBLE NOTE 7263'
         AND json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_extract(value, '$.body') = ''
         AND json_type(value, '$.deletedAt') IN ('integer', 'real')
         AND json_extract(value, '$.updatedAt') = json_extract(value, '$.deletedAt')),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'GHOST NOTE 9184') > 0),
      (SELECT count(*)
       FROM json_each(chain_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IN ('integer', 'real'))
    FROM target;
  ")"

  if [[ "$note_sql_probe" != "2 2 1 1 0 2 1 1" ]]; then
    echo "task-note SQLite JSON probe failed: ${note_sql_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note English copy" \
    "$copy_result" \
    "$copy_log" \
    --data-url "$PWD/$note_db" \
    --page day \
    --e2e-task-note-copy-contract \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$copy_result"

  echo "E2E task-note edit/delete restart and English copy: $note_db (probe=$note_sql_probe screenshot=$restart_screenshot)"
}

run_task_note_mutation_atomicity_probe() {
  local atomicity_dir="artifacts/e2e-task-note-atomicity"
  local atomicity_db="${atomicity_dir}/Noonmark.sqlite"
  local atomicity_state="${atomicity_dir}/state.json"
  local exercise_result="${atomicity_dir}/exercise-result.txt"
  local ui_result="${atomicity_dir}/ui-result.txt"
  local restart_result="${atomicity_dir}/restart-result.txt"
  local exercise_log="${atomicity_dir}/exercise.log"
  local ui_log="${atomicity_dir}/ui.log"
  local restart_log="${atomicity_dir}/restart.log"
  local exercise_marker_count
  local ui_marker_count
  local sql_probe

  rm -rf "$atomicity_dir"
  mkdir -p "$atomicity_dir"

  run_terminating_ui_probe \
    "task-note mutation atomicity exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$atomicity_db" \
    --page pool \
    --e2e-persistence-failure-automation \
    --e2e-task-note-atomicity-exercise \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  exercise_marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$exercise_log" || true)"
  if [[ "$exercise_marker_count" -ne 6 ]]; then
    echo "task-note atomicity exercise did not inject exactly six save failures: $exercise_marker_count" >&2
    cat "$exercise_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note mutation atomicity UI" \
    "$ui_result" \
    "$ui_log" \
    --data-url "$PWD/$atomicity_db" \
    --page day \
    --e2e-persistence-failure-automation \
    --e2e-task-note-atomicity-ui-edit \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$ui_result"

  ui_marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$ui_log" || true)"
  if [[ "$ui_marker_count" -ne 1 ]]; then
    echo "task-note atomicity UI did not inject exactly one save failure: $ui_marker_count" >&2
    cat "$ui_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note mutation atomicity restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$atomicity_db" \
    --page day \
    --e2e-task-note-atomicity-verify \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$atomicity_db" "
    SELECT
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM day_traces),
      (SELECT sum(json_array_length(note_entries_json)) FROM task_chains),
      (SELECT sum(json_array_length(note_entries_json)) FROM day_traces),
      (SELECT count(*) FROM task_chains, json_each(task_chains.note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NOT NULL)
        +
      (SELECT count(*) FROM day_traces, json_each(day_traces.note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NOT NULL),
      (SELECT count(*) FROM task_chains, json_each(task_chains.note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'UNSAVED') > 0)
        +
      (SELECT count(*) FROM day_traces, json_each(day_traces.note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'UNSAVED') > 0),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sql_probe" != "2 1 4 2 0 0 6" ]]; then
    echo "task-note mutation atomicity SQLite/restart probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E task-note mutation atomicity UI/SQLite restart: $atomicity_db (probe=$sql_probe)"
}

run_reactivation_atomicity_probe() {
  local reactivation_dir="artifacts/e2e-reactivation-atomicity"
  local reactivation_db="${reactivation_dir}/Noonmark.sqlite"
  local reactivation_state="${reactivation_dir}/state.json"
  local exercise_result="${reactivation_dir}/exercise-result.txt"
  local restart_result="${reactivation_dir}/restart-result.txt"
  local exercise_log="${reactivation_dir}/exercise.log"
  local restart_log="${reactivation_dir}/restart.log"
  local marker_count
  local sql_probe

  rm -rf "$reactivation_dir"
  mkdir -p "$reactivation_dir"

  run_terminating_ui_probe \
    "reactivation atomicity exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$reactivation_db" \
    --page unfinished \
    --e2e-persistence-failure-automation \
    --e2e-reactivation-atomicity-exercise \
    --e2e-reactivation-atomicity-state-url "$PWD/$reactivation_state" \
    --e2e-reactivation-atomicity-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$exercise_log" || true)"
  if [[ "$marker_count" -ne 1 ]]; then
    echo "reactivation atomicity did not inject exactly one save failure: $marker_count" >&2
    cat "$exercise_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "reactivation atomicity restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$reactivation_db" \
    --page unfinished \
    --e2e-reactivation-atomicity-verify \
    --e2e-reactivation-atomicity-state-url "$PWD/$reactivation_state" \
    --e2e-reactivation-atomicity-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$reactivation_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       JOIN task_definitions ON task_definitions.chain_id = task_chains.id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND task_chains.state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND day_traces.status = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND day_traces.status = 'pending'),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sql_probe" != "1 1 0 5" ]]; then
    echo "reactivation atomicity SQLite/restart probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E reactivation atomicity SQLite restart: $reactivation_db (probe=$sql_probe)"
}

