                self.snapshot() == anchor_snapshot
                and sample["variant"] == layout
                and sample["id"] == layout_anchor["id"]
                and sample["visible"]
                and sample["sameScroller"]
                and sample["userOwns"]
                and abs(sample["visibleOffset"] - layout_anchor["visibleOffset"]) <= 8,
                json.dumps({"origin": layout_anchor, "sample": sample}, sort_keys=True),
