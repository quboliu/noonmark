#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"

app_path="$repo_root/dist/Noonmark.app"
app_executable="$app_path/Contents/MacOS/NoonmarkMacApp"
launched_pid=""
minimum_lifetime_ticks="${NOONMARK_INTERACTIVE_LAUNCH_MINIMUM_TICKS:-20}"

if [[ ! "$minimum_lifetime_ticks" =~ ^[1-9][0-9]*$ ]]; then
  echo "NOONMARK_INTERACTIVE_LAUNCH_MINIMUM_TICKS must be a positive integer" >&2
  exit 1
fi

cleanup() {
  if [[ -n "$launched_pid" ]] && kill -0 "$launched_pid" >/dev/null 2>&1; then
    kill -TERM "$launched_pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      kill -0 "$launched_pid" >/dev/null 2>&1 || return 0
      sleep 0.1
    done
    echo "interactive launch probe could not terminate its target app" >&2
    return 1
  fi
}
trap cleanup EXIT

scripts/run-mac-app

if [[ ! -f artifacts/interactive-provider-readiness.txt \
  || "$(<artifacts/interactive-provider-readiness.txt)" != "ready" ]]; then
  echo "interactive launch did not expose a ready Provider configuration to the app" >&2
  exit 1
fi

for _ in {1..50}; do
  candidate_pid="$(pgrep -f -x "$app_executable" || true)"
  if [[ -n "$candidate_pid" ]]; then
    launched_pid="$candidate_pid"
    break
  fi
  sleep 0.1
done

if [[ -z "$launched_pid" ]]; then
  echo "interactive launch did not create the requested Noonmark.app process" >&2
  exit 1
fi

for ((tick = 0; tick < minimum_lifetime_ticks; tick += 1)); do
  if ! kill -0 "$launched_pid" >/dev/null 2>&1; then
    echo "interactive Noonmark.app process exited before it became usable" >&2
    exit 1
  fi
  sleep 0.1
done

echo "Interactive Noonmark.app launch passed: pid=$launched_pid ticks=$minimum_lifetime_ticks"
