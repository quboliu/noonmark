#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

root_view="App/NoonmarkIOSApp/IOSRootView.swift"
calendar_page="App/NoonmarkIOSApp/IOSCalendarAndRecurringPages.swift"
ui_tests="Tests/NoonmarkIOSUITests/NoonmarkIOSUITests.swift"

grep -Fq 'if horizontalSizeClass == .compact' "$root_view"
grep -Fq 'private var compactRoot: some View' "$root_view"
grep -Fq 'NavigationStack {' "$root_view"
grep -Fq 'testUserCanCreateAndPersistTodayTask' "$ui_tests"
grep -Fq 'ScrollView {' "$calendar_page"
grep -Fq 'testUserCanSaveDailyReviewAndReadItAfterRestartInSimulator' "$ui_tests"
grep -Fq 'ios.data-package.import' "$ui_tests"
grep -Fq 'ios.data-package.export' "$ui_tests"
grep -Fq 'IOSDocumentPicker(mode: request.mode)' "$root_view"
grep -Fq 'dataPackagePickerRequest' "$root_view"
grep -Fq 'beginDataPackageImport' "$repo_root/App/NoonmarkIOSApp/IOSStore.swift"
grep -Fq 'simctl erase' "$repo_root/scripts/test-ios-simulator"
grep -Fq 'NewTaskDraftParser.parse' "$repo_root/App/NoonmarkIOSApp/IOSStore.swift"

echo "iOS target contract passed: compact root, stable calendar scroll and simulator persistence symptom gates are present"
