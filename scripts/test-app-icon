#!/usr/bin/env bash
set -euo pipefail

source scripts/app-icon-common

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-app-icon-test.XXXXXX")"

cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

required_files=(
  "$app_icon_source_svg"
  "$app_icon_master_png"
  "$app_icon_icns_path"
  "scripts/app-icon-optical-renderer.swift"
  "scripts/app-icon-optical-probe.swift"
)
for representation in "${app_icon_representations[@]}"; do
  required_files+=("${app_icon_iconset_dir}/${representation%%:*}")
done

for file in "${required_files[@]}"; do
  if [[ ! -f "$file" ]]; then
    echo "missing app icon asset: $file" >&2
    exit 1
  fi
done

if ! grep -Eq '<svg[^>]+viewBox="0 0 1024 1024"' "$app_icon_source_svg"; then
  echo "canonical app icon SVG must use a 0 0 1024 1024 viewBox: $app_icon_source_svg" >&2
  exit 1
fi
if grep -Eq '<image([[:space:]>])' "$app_icon_source_svg"; then
  echo "canonical app icon SVG must not embed raster images: $app_icon_source_svg" >&2
  exit 1
fi
if [[ -e "${app_icon_resources_dir}/AppIcon-source.png" ]]; then
  echo "legacy raster app icon source must be removed in favor of SVG" >&2
  exit 1
fi

assert_png() {
  local path="$1"
  local expected_size="$2"
  local width
  local height
  local format
  local alpha

  width="$(sips -g pixelWidth "$path" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$path" | awk '/pixelHeight/ {print $2}')"
  format="$(sips -g format "$path" | awk '/format/ {print $2}')"
  alpha="$(sips -g hasAlpha "$path" | awk '/hasAlpha/ {print $2}')"

  if [[ "$width" != "$expected_size" || "$height" != "$expected_size" ]]; then
    echo "invalid app icon dimensions: $path is ${width}x${height}, expected ${expected_size}x${expected_size}" >&2
    exit 1
  fi
  if [[ "$format" != "png" ]]; then
    echo "invalid app icon format: $path is $format, expected png" >&2
    exit 1
  fi
  if [[ "$alpha" != "yes" ]]; then
    echo "app icon must preserve alpha: $path" >&2
    exit 1
  fi
  if ! sips -g profile "$path" | grep -q "profile: sRGB"; then
    echo "app icon must use an embedded sRGB profile: $path" >&2
    exit 1
  fi
}

assert_matches_source() {
  local path="$1"
  local expected_size="$2"
  local filename
  local rendered

  filename="$(basename "$path")"
  rendered="${work_dir}/rendered-${expected_size}-${filename}"
  app_icon_render_png "$expected_size" "$rendered"

  if ! cmp -s "$path" "$rendered"; then
    echo "app icon asset is stale relative to AppIcon-source.svg: $path" >&2
    exit 1
  fi
}

assert_matches_representation_renderer() {
  local path="$1"
  local expected_size="$2"
  local filename
  local rendered

  filename="$(basename "$path")"
  rendered="${work_dir}/rendered-${expected_size}-${filename}"
  app_icon_render_representation "$filename" "$expected_size" "$rendered"

  if ! cmp -s "$path" "$rendered"; then
    echo "app icon asset is stale relative to its canonical renderer: $path" >&2
    exit 1
  fi
}

assert_master_mac_icon_bounds() {
  NOONMARK_APP_ICON_MASTER="$app_icon_master_png" swift - <<'SWIFT'
import AppKit
import CoreGraphics
import Foundation

enum BoundsError: Error, CustomStringConvertible {
  case missingEnvironment
  case unreadableImage(String)
  case missingCGImage(String)
  case missingContext
  case noVisiblePixels
  case invalidBounds(minX: Int, minY: Int, maxX: Int, maxY: Int)
  case opaqueCorner(x: Int, y: Int)

  var description: String {
    switch self {
    case .missingEnvironment:
      return "missing NOONMARK_APP_ICON_MASTER"
    case .unreadableImage(let path):
      return "unreadable app icon master: \(path)"
    case .missingCGImage(let path):
      return "app icon master has no CGImage representation: \(path)"
    case .missingContext:
      return "failed to create app icon bounds context"
    case .noVisiblePixels:
      return "app icon master has no visible pixels"
    case .invalidBounds(let minX, let minY, let maxX, let maxY):
      return "app icon master alpha bounds are \(minX),\(minY)-\(maxX),\(maxY), expected an approximately 824 px macOS icon body"
    case .opaqueCorner(let x, let y):
      return "app icon master corner must remain transparent at \(x),\(y)"
    }
  }
}

func alpha(atX x: Int, y: Int, data: [UInt8], width: Int) -> UInt8 {
  data[(y * width + x) * 4 + 3]
}

do {
  guard let path = ProcessInfo.processInfo.environment["NOONMARK_APP_ICON_MASTER"], !path.isEmpty else {
    throw BoundsError.missingEnvironment
  }
  guard let image = NSImage(contentsOfFile: path) else {
    throw BoundsError.unreadableImage(path)
  }
  let width = 1024
  let height = 1024
  var proposedRect = CGRect(origin: .zero, size: CGSize(width: width, height: height))
  guard let cgImage = image.cgImage(forProposedRect: &proposedRect, context: nil, hints: nil) else {
    throw BoundsError.missingCGImage(path)
  }
  let colorSpace = CGColorSpace(name: CGColorSpace.sRGB)!
  var data = [UInt8](repeating: 0, count: width * height * 4)
  guard let context = CGContext(
    data: &data,
    width: width,
    height: height,
    bitsPerComponent: 8,
    bytesPerRow: width * 4,
    space: colorSpace,
    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
  ) else {
    throw BoundsError.missingContext
  }
  context.draw(cgImage, in: CGRect(x: 0, y: 0, width: width, height: height))

  var minX = width
  var minY = height
  var maxX = -1
  var maxY = -1
  for y in 0..<height {
    for x in 0..<width where alpha(atX: x, y: y, data: data, width: width) > 0 {
      minX = min(minX, x)
      minY = min(minY, y)
      maxX = max(maxX, x)
      maxY = max(maxY, y)
    }
  }
  if maxX < 0 || maxY < 0 {
    throw BoundsError.noVisiblePixels
  }
  if !(95...105).contains(minX) || !(95...105).contains(minY)
    || !(918...928).contains(maxX) || !(918...928).contains(maxY)
  {
    throw BoundsError.invalidBounds(minX: minX, minY: minY, maxX: maxX, maxY: maxY)
  }
  for (x, y) in [(0, 0), (0, height - 1), (width - 1, 0), (width - 1, height - 1)] {
    if alpha(atX: x, y: y, data: data, width: width) != 0 {
      throw BoundsError.opaqueCorner(x: x, y: y)
    }
  }
} catch {
  FileHandle.standardError.write("\(error)\n".data(using: .utf8)!)
  exit(1)
}
SWIFT
}

assert_png "$app_icon_master_png" 1024
assert_matches_source "$app_icon_master_png" 1024
assert_master_mac_icon_bounds
for representation in "${app_icon_representations[@]}"; do
  filename="${representation%%:*}"
  size="${representation##*:}"
  path="${app_icon_iconset_dir}/${filename}"
  assert_png "$path" "$size"
  assert_matches_representation_renderer "$path" "$size"
done

source_resamples_dir="${work_dir}/source-resamples"
mkdir -p "$source_resamples_dir"
app_icon_render_png 16 "${source_resamples_dir}/icon_16x16.png"
app_icon_render_png 32 "${source_resamples_dir}/icon_16x16@2x.png"
app_icon_render_png 32 "${source_resamples_dir}/icon_32x32.png"
app_icon_render_png 64 "${source_resamples_dir}/icon_32x32@2x.png"

extracted_iconset="${work_dir}/AppIcon.iconset"
mkdir -p "$extracted_iconset"
iconutil -c iconset -o "$extracted_iconset" "$app_icon_icns_path"
for representation in "${app_icon_representations[@]}"; do
  filename="${representation%%:*}"
  size="${representation##*:}"
  assert_png "${extracted_iconset}/${filename}" "$size"
done

probe_arguments=(
  --large "$app_icon_master_png" 1024
  --small "${app_icon_iconset_dir}/icon_16x16.png" 16
  --small "${app_icon_iconset_dir}/icon_16x16@2x.png" 32
  --small "${app_icon_iconset_dir}/icon_32x32.png" 32
  --small "${app_icon_iconset_dir}/icon_32x32@2x.png" 64
  --distinct "${app_icon_iconset_dir}/icon_16x16.png" "${source_resamples_dir}/icon_16x16.png"
  --distinct "${app_icon_iconset_dir}/icon_16x16@2x.png" "${source_resamples_dir}/icon_16x16@2x.png"
  --distinct "${app_icon_iconset_dir}/icon_32x32.png" "${source_resamples_dir}/icon_32x32.png"
  --distinct "${app_icon_iconset_dir}/icon_32x32@2x.png" "${source_resamples_dir}/icon_32x32@2x.png"
  --distinct "${app_icon_iconset_dir}/icon_16x16@2x.png" "${app_icon_iconset_dir}/icon_32x32.png"
)
for representation in "${app_icon_representations[@]}"; do
  filename="${representation%%:*}"
  probe_arguments+=(
    --round-trip
    "${app_icon_iconset_dir}/${filename}"
    "${extracted_iconset}/${filename}"
  )
done
swift scripts/app-icon-optical-probe.swift "${probe_arguments[@]}"

regenerated_icns="${work_dir}/AppIcon.icns"
iconutil -c icns -o "$regenerated_icns" "$app_icon_iconset_dir"
if ! cmp -s "$app_icon_icns_path" "$regenerated_icns"; then
  echo "AppIcon.icns is stale or differs from the canonical iconset" >&2
  exit 1
fi

if ! cmp -s "$app_icon_master_png" "${app_icon_iconset_dir}/icon_512x512@2x.png"; then
  echo "1024 app icon representation differs from the release master" >&2
  exit 1
fi

echo "Verified app icon sources, optical variants, iconset, and icns"
