#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
repo_parent="$(cd "$repo_root/.." && pwd -P)"
cd "$repo_root"

source scripts/evidence-common

if [[ "$#" -ne 0 ]]; then
  echo "usage: scripts/test-release-diagnostic-closure" >&2
  exit 64
fi

evidence_relative="artifacts/release-diagnostic-closure-gate"
# Delete stale PASS evidence before every precondition, including clean-tree
# validation. A failed preflight must never leave an uploadable old success.
evidence_prepare_fresh_directory "$repo_root" "$evidence_relative"
evidence_root="$repo_root/$evidence_relative"
chmod 700 "$evidence_root"
gate_log="$evidence_root/test-e2e.log"
gate_result="$evidence_root/result.txt"
gate_manifest="$evidence_root/manifest.txt"
gate_inventory="$evidence_root/artifact-inventory.sha256"
source_start_fragment="$evidence_root/source-start.fragment"
source_end_fragment="$evidence_root/source-end.fragment"
evidence_run_id="${NOONMARK_EVIDENCE_RUN_ID:-$(date -u '+%Y%m%dT%H%M%SZ')-$$}"

evidence_capture_source "$repo_root" source "$source_start_fragment"
evidence_begin_manifest \
  "$gate_manifest" \
  "release-diagnostic-closure" \
  "$evidence_run_id" \
  "release" \
  "diagnostic-closure"
evidence_append_snapshot "$gate_manifest" "$source_start_fragment"

source_commit="$(evidence_read "$gate_manifest" source_head_commit)"
gate_parent=""
gate_worktree=""
worktree_added=0
gate_status=0
gate_e2e_status=not-run
closure_restart_result=none
closure_e2e_manifest_path=none
closure_e2e_manifest_sha256=none
artifact_paths=("$gate_log" "$gate_result" "$source_start_fragment")

cleanup_worktree() {
  local cleanup_status=0

  set +e
  if [[ -n "$gate_worktree" &&
    ( "$worktree_added" == "1" || -e "$gate_worktree/.git" ) ]]; then
    "$gate_worktree/scripts/reset-dev-data" e2e >/dev/null 2>&1 ||
      cleanup_status=1
    git worktree remove --force "$gate_worktree" >/dev/null 2>&1 ||
      cleanup_status=1
  fi
  worktree_added=0
  if [[ -n "$gate_parent" && -d "$gate_parent" ]]; then
    rmdir "$gate_parent" >/dev/null 2>&1 || cleanup_status=1
  fi
  set -e
  return "$cleanup_status"
}

cleanup_on_exit() {
  local original_status=$?

  trap - EXIT INT TERM
  if ! cleanup_worktree && [[ "$original_status" -eq 0 ]]; then
    original_status=1
  fi
  exit "$original_status"
}

cleanup_on_signal() {
  local signal_status="$1"

  trap - EXIT INT TERM
  cleanup_worktree || true
  exit "$signal_status"
}
trap cleanup_on_exit EXIT
trap 'cleanup_on_signal 130' INT
trap 'cleanup_on_signal 143' TERM

: >"$gate_log"
if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  echo "release diagnostic closure requires a clean committed source tree" |
    tee -a "$gate_log" >&2
  gate_status=1
else
  gate_parent="$(
    mktemp -d "$repo_parent/.noonmark-release-e2e.XXXXXX"
  )"
  gate_worktree="$gate_parent/worktree"
  if [[ "$gate_parent" != "$repo_parent"/.noonmark-release-e2e.* ||
    -L "$gate_parent" || "$(stat -f '%Lp' "$gate_parent")" != "700" ]]; then
    echo "release diagnostic closure worktree parent is unsafe" |
      tee -a "$gate_log" >&2
    gate_status=1
  elif ! git worktree add \
    --detach "$gate_worktree" "$source_commit" >>"$gate_log" 2>&1; then
    gate_status=1
  else
    worktree_added=1
    if [[ "$(git -C "$gate_worktree" rev-parse --verify HEAD^{commit})" != \
      "$source_commit" ]]; then
      echo "release diagnostic closure worktree changed source identity" |
        tee -a "$gate_log" >&2
      gate_status=1
    else
      set +e
      (
        cd "$gate_worktree"
        NOONMARK_EVIDENCE_RUN_ID="$evidence_run_id" \
          NOONMARK_E2E_DIAGNOSTIC_CLOSURE_ONLY=1 \
          scripts/test-e2e release
      ) >>"$gate_log" 2>&1
      gate_e2e_status=$?
      set -e
      if [[ "$gate_e2e_status" -ne 0 ]]; then
        gate_status="$gate_e2e_status"
      fi
    fi
  fi
fi

closure_root=""
runtime_root=""
if [[ -n "$gate_worktree" ]]; then
  closure_root="${gate_worktree}/artifacts/e2e-diagnostic-closure"
  runtime_root="${gate_worktree}/artifacts/e2e-runtime"
fi
if [[ "$gate_status" -eq 0 ]]; then
  if [[ -z "$closure_root" || -z "$runtime_root" ]]; then
    echo "release diagnostic closure lacks an isolated worktree root" |
      tee -a "$gate_log" >&2
    gate_status=1
  elif [[ ! -f "$closure_root/restart-result.txt" ]]; then
    echo "release diagnostic closure restart result is missing" |
      tee -a "$gate_log" >&2
    gate_status=1
  else
    closure_restart_result="$(<"$closure_root/restart-result.txt")"
  fi
  if [[ "$closure_restart_result" != \
      "ok: restarted evidence exported through UI" ||
    ! -d "$closure_root/helper" || -L "$closure_root/helper" ||
    "$(stat -f '%Lp' "$closure_root/helper")" != "700" ||
    "$(stat -f '%u' "$closure_root/helper")" != "$(id -u)" ||
    "$(evidence_read "$runtime_root/manifest.txt" suite_mode)" != \
      "only:diagnostic-closure" ||
    "$(evidence_read "$runtime_root/manifest.txt" suite_exit_status)" != "0" ||
    "$(evidence_read "$runtime_root/manifest.txt" evidence_run_id)" != \
      "$evidence_run_id" ||
    "$(evidence_read "$runtime_root/manifest.txt" source_head_commit)" != \
      "$source_commit" ]]; then
    echo "release diagnostic closure evidence was incomplete" |
      tee -a "$gate_log" >&2
    gate_status=1
  fi
fi

for source in "$closure_root" "$runtime_root"; do
  if [[ -n "$source" && -d "$source" && ! -L "$source" ]]; then
    destination="$evidence_root/$(basename "$source")"
    cp -R "$source" "$destination"
    artifact_paths+=("$destination")
  fi
done
copied_runtime_manifest="$evidence_root/e2e-runtime/manifest.txt"
if [[ -f "$copied_runtime_manifest" && ! -L "$copied_runtime_manifest" ]]; then
  closure_e2e_manifest_path="${copied_runtime_manifest#"$repo_root/"}"
  closure_e2e_manifest_sha256="$(
    shasum -a 256 "$copied_runtime_manifest" | awk '{print $1}'
  )"
fi

if ! cleanup_worktree; then
  echo "release diagnostic closure could not clean its isolated worktree" |
    tee -a "$gate_log" >&2
  gate_status=1
fi

if ! evidence_capture_source "$repo_root" source_end "$source_end_fragment"; then
  gate_status=1
else
  evidence_append_snapshot "$gate_manifest" "$source_end_fragment" ||
    gate_status=1
  artifact_paths+=("$source_end_fragment")
fi

if [[ "$gate_status" -eq 0 ]]; then
  gate_outcome=PASS
else
  gate_outcome=FAIL
fi
{
  printf 'schema_version=1\n'
  printf 'source_commit=%s\n' "$source_commit"
  printf 'evidence_run_id=%s\n' "$evidence_run_id"
  printf 'status=%s\n' "$gate_outcome"
  printf 'e2e_exit_code=%s\n' "$gate_e2e_status"
  printf 'production_app_executed=false\n'
} >"$gate_result"
chmod 600 "$gate_log" "$gate_result"

evidence_append "$gate_manifest" production_app_executed false
evidence_append "$gate_manifest" closure_e2e_exit_code "$gate_e2e_status"
evidence_append \
  "$gate_manifest" closure_restart_result "$closure_restart_result"
evidence_append \
  "$gate_manifest" closure_e2e_manifest_path "$closure_e2e_manifest_path"
evidence_append \
  "$gate_manifest" closure_e2e_manifest_sha256 "$closure_e2e_manifest_sha256"
evidence_append \
  "$gate_manifest" gate_log_path "${gate_log#"$repo_root/"}"
evidence_append \
  "$gate_manifest" gate_log_sha256 \
  "$(shasum -a 256 "$gate_log" | awk '{print $1}')"
evidence_append \
  "$gate_manifest" gate_result_path "${gate_result#"$repo_root/"}"
evidence_append \
  "$gate_manifest" gate_result_sha256 \
  "$(shasum -a 256 "$gate_result" | awk '{print $1}')"

evidence_inventory \
  "$repo_root" \
  "$gate_inventory" \
  "${artifact_paths[@]}"
chmod 600 "$gate_inventory"
evidence_append \
  "$gate_manifest" artifact_inventory_sha256 \
  "$(shasum -a 256 "$gate_inventory" | awk '{print $1}')"

if ! evidence_finish_manifest \
  "$gate_manifest" \
  "$gate_status" \
  source_worktree_tree_oid \
  source_end_worktree_tree_oid \
  production_app_executed \
  closure_e2e_exit_code \
  closure_restart_result \
  closure_e2e_manifest_path \
  closure_e2e_manifest_sha256 \
  gate_log_sha256 \
  gate_result_sha256 \
  artifact_inventory_sha256; then
  gate_status=1
fi

if [[ "$gate_status" -ne 0 ]]; then
  exit "$gate_status"
fi
echo "Release diagnostic closure passed in an isolated temporary worktree"
