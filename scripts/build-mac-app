#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
profile="${2:-app}"
product="NoonmarkMacApp"
icon_source="App/NoonmarkMacApp/Resources/AppIcon.icns"
icon_name="AppIcon"

case "$profile" in
  app)
    executable_name="NoonmarkMacApp"
    bundle_identifier="app.noonmark.mac"
    bundle_display_name="晷迹"
    bundle_short_name="Noonmark"
    bundle_name="Noonmark"
    ;;
  e2e)
    executable_name="NoonmarkMacAppE2E"
    bundle_identifier="app.noonmark.mac.e2e"
    bundle_display_name="晷迹 E2E"
    bundle_short_name="Noonmark E2E"
    bundle_name="NoonmarkMacAppE2E"
    ;;
  *)
    echo "unknown fixed app profile: $profile" >&2
    exit 1
    ;;
esac
bundle_dir="dist/${bundle_name}.app"
contents_dir="${bundle_dir}/Contents"
macos_dir="${contents_dir}/MacOS"
resources_dir="${contents_dir}/Resources"

scripts/reset-dev-data
swift build -c "$configuration" --product "$product"

rm -rf "$bundle_dir"
mkdir -p "$macos_dir" "$resources_dir"

binary_path=".build/arm64-apple-macosx/${configuration}/${product}"
if [[ ! -x "$binary_path" ]]; then
  binary_path=".build/${configuration}/${product}"
fi

cp "$binary_path" "${macos_dir}/${executable_name}"
chmod +x "${macos_dir}/${executable_name}"

icon_plist_entry=""
if [[ -f "$icon_source" ]]; then
  cp "$icon_source" "${resources_dir}/${icon_name}.icns"
  icon_plist_entry=$(cat <<ICON
  <key>CFBundleIconFile</key>
  <string>${icon_name}</string>
ICON
)
fi

cat > "${contents_dir}/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleDisplayName</key>
  <string>${bundle_display_name}</string>
  <key>CFBundleExecutable</key>
  <string>${executable_name}</string>
  <key>CFBundleIdentifier</key>
  <string>${bundle_identifier}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
${icon_plist_entry}
  <key>CFBundleName</key>
  <string>${bundle_short_name}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
PLIST

codesign --force --sign - "$bundle_dir" >/dev/null
echo "$bundle_dir"
