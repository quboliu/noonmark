expect_e2e_manifest_mutation_rejected() {
  local label="$1"
  local mutation="$2"
  local status

  cp "$e2e_manifest_pristine" "$e2e_manifest"
  sed -i '' "$mutation" "$e2e_manifest"
  set +e
  (
    cd "$fixture_root"
    scripts/verify-development-validation-evidence \
      --scope runtime \
      artifacts/e2e-runtime/manifest.txt \
      artifacts/e2e-data-root-process-lease/manifest.txt
  ) >"$fixture_root/runtime-validator-${label}.stdout" \
    2>"$fixture_root/runtime-validator-${label}.stderr"
  status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    echo "runtime validator accepted E2E evidence mutation: $label" >&2
    exit 1
  fi
}

expect_e2e_manifest_mutation_rejected \
  missing-helper-before-digest \
  '/^helper_binary_sha256_before=/d'
expect_e2e_manifest_mutation_rejected \
  helper-signing-team \
  's/^helper_codesign_team_identifier=.*/helper_codesign_team_identifier=OTHERTEAM/; s/^helper_end_codesign_team_identifier=.*/helper_end_codesign_team_identifier=OTHERTEAM/'
cp "$e2e_manifest_pristine" "$e2e_manifest"

