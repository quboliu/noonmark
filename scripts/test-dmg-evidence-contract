      ;;
  esac
  english_fixture_screenshot="$(
    shasum -a 256 "$fixture_root/artifacts/e2e/${scenario}.png" |
      awk '{print $1}'
  )"
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$scenario" \
