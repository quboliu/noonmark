#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

fail() {
  echo "release version contract: $*" >&2
  exit 1
}

version_file="release/VERSION"
[[ -f "$version_file" ]] || fail "missing tracked version source"

version_lines=()
while IFS= read -r line || [[ -n "$line" ]]; do
  version_lines+=("$line")
done <"$version_file"
[[ "${#version_lines[@]}" -eq 2 ]] ||
  fail "version source must contain exactly two lines"
[[ "${version_lines[0]}" =~ ^marketing_version=[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail "marketing version is not semantic"
[[ "${version_lines[1]}" =~ ^build_number=[1-9][0-9]*$ ]] ||
  fail "build number is not a positive integer"

marketing_version="${version_lines[0]#marketing_version=}"
build_number="${version_lines[1]#build_number=}"
[[ "$(scripts/release-version marketing-version)" == "$marketing_version" ]] ||
  fail "release-version did not read the tracked marketing version"
[[ "$(scripts/release-version build-number)" == "$build_number" ]] ||
  fail "release-version did not read the tracked build number"
if NOONMARK_MARKETING_VERSION=9.9.9 scripts/release-version marketing-version \
  >/dev/null 2>&1; then
  fail "marketing version can still be overridden through the environment"
fi
if scripts/release-version unsupported >/dev/null 2>&1; then
  fail "release-version accepted an unknown query"
fi

ledger_file="release/BUILD-LEDGER.tsv"
[[ -f "$ledger_file" ]] || fail "missing build ledger"
IFS=$'\t' read -r ledger_header <"$ledger_file"
[[ "$ledger_header" == $'marketing_version\tbuild_number\tstate' ]] ||
  fail "build ledger header is invalid"
previous_build=0
current_matches=0
while IFS=$'\t' read -r ledger_version ledger_build ledger_state ledger_extra ||
  [[ -n "${ledger_version:-}" ]]; do
  [[ -z "${ledger_extra:-}" && "$ledger_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ &&
    "$ledger_build" =~ ^[1-9][0-9]*$ ]] ||
    fail "build ledger entry is malformed"
  [[ "$ledger_state" == "candidate" || "$ledger_state" == "released" ||
    "$ledger_state" == "retired" ]] || fail "build ledger state is invalid"
  ((ledger_build > previous_build)) ||
    fail "build ledger numbers are not strictly increasing"
  previous_build="$ledger_build"
  if [[ "$ledger_version" == "$marketing_version" &&
    "$ledger_build" == "$build_number" ]]; then
    [[ "$ledger_state" != "retired" ]] ||
      fail "current version points to a retired build"
    ((current_matches += 1))
  fi
done < <(tail -n +2 "$ledger_file")
[[ "$current_matches" -eq 1 ]] ||
  fail "current version must have exactly one active build ledger entry"

source_identity_file="release/CURRENT-BUILD-SOURCE"
[[ -f "$source_identity_file" && ! -L "$source_identity_file" ]] ||
  fail "current build source identity is missing or not a regular file"
source_identity_lines=()
while IFS= read -r line || [[ -n "$line" ]]; do
  source_identity_lines+=("$line")
done <"$source_identity_file"
[[ "${#source_identity_lines[@]}" -eq 3 ]] ||
  fail "current build source identity must contain exactly three lines"
[[ "${source_identity_lines[0]}" == "marketing_version=$marketing_version" &&
  "${source_identity_lines[1]}" == "build_number=$build_number" &&
  "${source_identity_lines[2]}" =~ ^source_fingerprint_sha256=([0-9a-f]{64})$ ]] ||
  fail "current build source identity does not match the current version"
stored_source_fingerprint="${BASH_REMATCH[1]}"
[[ -x scripts/release-source-fingerprint &&
  -x scripts/verify-release-source-identity ]] ||
  fail "release source identity commands are missing or not executable"
[[ "$stored_source_fingerprint" =~ ^[0-9a-f]{64}$ ]] ||
  fail "current build source fingerprint is malformed"
[[ -x scripts/verify-origin-main-candidate ]] ||
  fail "origin/main candidate verifier is missing or not executable"
[[ -x scripts/verify-release-source-transition ]] ||
  fail "release source transition verifier is missing or not executable"

rg -F 'scripts/release-version marketing-version' scripts/build-mac-app >/dev/null ||
  fail "App build does not read the tracked marketing version"
rg -F 'scripts/release-version build-number' scripts/build-mac-app >/dev/null ||
  fail "App build does not read the tracked build number"
if rg -F 'NOONMARK_MARKETING_VERSION' scripts/build-mac-app >/dev/null ||
  rg -F 'NOONMARK_BUILD_NUMBER' scripts/build-mac-app >/dev/null; then
  fail "App build still accepts environment version overrides"
fi
release_script="scripts/release-private-dmg"
rg -F 'scripts/verify-release-version-tag' "$release_script" >/dev/null ||
  fail "private release entry does not require the exact version tag"
rg -F 'scripts/verify-release-trial-version' "$release_script" >/dev/null ||
  fail "private release entry does not expose the pre-tag trial verifier"
[[ -x scripts/verify-release-trial-version ]] ||
  fail "pre-tag trial version verifier is missing or not executable"
rg -F 'scripts/verify-release-source-identity' scripts/verify-release-trial-version \
  >/dev/null ||
  fail "pre-tag trial verifier does not bind the tracked release source"
rg -F 'scripts/verify-origin-main-candidate' scripts/verify-release-trial-version \
  >/dev/null ||
  fail "pre-tag trial verifier does not require the exact pushed main commit"
rg -F 'scripts/verify-release-source-identity' scripts/verify-release-version-tag \
  >/dev/null ||
  fail "tag verifier does not bind the tracked release source"
rg -F 'scripts/verify-origin-main-candidate' scripts/verify-release-version-tag \
  >/dev/null ||
  fail "tag verifier does not require the exact pushed main commit"
rg -F 'fetch-depth: 0' .github/workflows/release-publish.yml >/dev/null ||
  fail "release workflow does not fetch the annotated version tag"
rg -F 'fetch-depth: 0' .github/workflows/ci.yml >/dev/null ||
  fail "hosted CI does not fetch the source identity history"
rg -F 'ref: ${{ github.event.pull_request.head.sha || github.sha }}' \
  .github/workflows/ci.yml >/dev/null ||
  fail "hosted CI does not audit the pull request head"
rg -F 'scripts/verify-release-source-transition' .github/workflows/ci.yml \
  >/dev/null ||
  fail "hosted CI does not audit changed source identity"
rg -F 'git cat-file -t' scripts/verify-release-version-tag >/dev/null ||
  fail "release version tag verifier does not require an annotated tag"
rg -F 'release/BUILD-LEDGER.tsv' docs/engineering/versioning-and-private-release.md >/dev/null ||
  fail "version governance does not document the build ledger"
rg -F 'scripts/verify-release-source-identity' scripts/test-dmg-install >/dev/null ||
  fail "real DMG install gate does not consume candidate source identity"
rg -F 'scripts/verify-origin-main-candidate' scripts/test-dmg-install >/dev/null ||
  fail "real DMG install gate does not consume pushed main authority"
install_source_gate_line="$(
  awk '$0 == "scripts/verify-release-source-identity" { print NR }' \
    scripts/test-dmg-install
)"
install_remote_gate_line="$(
  awk '$0 == "scripts/verify-origin-main-candidate" { print NR }' \
    scripts/test-dmg-install
)"
install_runtime_setup_line="$(
  awk '$0 == "source scripts/runtime-profile-common" { print NR }' \
    scripts/test-dmg-install
)"
[[ "$install_source_gate_line" =~ ^[1-9][0-9]*$ &&
  "$install_remote_gate_line" =~ ^[1-9][0-9]*$ &&
  "$install_runtime_setup_line" =~ ^[1-9][0-9]*$ ]] ||
  fail "real DMG install source, remote, or runtime gate is ambiguous"
((install_source_gate_line < install_remote_gate_line &&
  install_remote_gate_line < install_runtime_setup_line)) ||
  fail "real DMG install audits candidate authority after runtime profile setup"

rg -F 'scripts/verify-origin-main-candidate' scripts/push-release-tag >/dev/null ||
  fail "tag publisher does not share the pushed main authority"
rg -F 'scripts/test-release-origin-main-contract' scripts/check >/dev/null ||
  fail "origin/main candidate contract is absent from scripts/check"
rg -F 'scripts/test-release-source-transition-contract' scripts/check >/dev/null ||
  fail "source transition contract is absent from scripts/check"

echo "Release version contract passed: $marketing_version ($build_number)"
