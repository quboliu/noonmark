#!/usr/bin/env bash
set -euo pipefail

prototype_dir="${SUNTRACE_PROTOTYPE_DIR:-docs/design/prototypes/claude-mac-ui-2026-07-05}"
out_dir="${SUNTRACE_PROTOTYPE_OUT_DIR:-artifacts/prototype-screenshots}"
window_size="${SUNTRACE_PROTOTYPE_WINDOW_SIZE:-1440,900}"
render_timeout="${SUNTRACE_PROTOTYPE_RENDER_TIMEOUT:-90}"
pages=(${SUNTRACE_PROTOTYPE_PAGES:-day pool future unfinished completed calendar settings})

chrome_binary="${SUNTRACE_CHROME_BINARY:-}"
if [[ -z "$chrome_binary" ]]; then
  if command -v google-chrome >/dev/null 2>&1; then
    chrome_binary="$(command -v google-chrome)"
  elif command -v chromium >/dev/null 2>&1; then
    chrome_binary="$(command -v chromium)"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    chrome_binary="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    echo "missing Chrome/Chromium for prototype screenshot rendering" >&2
    exit 1
  fi
fi

prototype_html="${prototype_dir}/suntrace-mac-prototype.dc.html"
if [[ ! -f "$prototype_html" ]]; then
  echo "missing prototype HTML: $prototype_html" >&2
  exit 1
fi

rm -rf "$out_dir"
mkdir -p "$out_dir"

for page in "${pages[@]}"; do
  work_dir="${out_dir}/.${page}-src"
  mkdir -p "$work_dir"
  cp -R "${prototype_dir}/." "$work_dir/"

  page_html="${work_dir}/suntrace-mac-prototype.dc.html"
  perl -0pi -e "s/page:'day',date:/page:'${page}',date:/" "$page_html"

  user_data_dir="${out_dir}/.${page}-chrome-profile"
  python3 - "$render_timeout" "$chrome_binary" \
    --headless=new \
    --disable-gpu \
    --disable-background-networking \
    --disable-component-update \
    --disable-extensions \
    --hide-scrollbars \
    --no-default-browser-check \
    --no-first-run \
    --user-data-dir="$PWD/$user_data_dir" \
    --virtual-time-budget=3000 \
    --screenshot="$PWD/${out_dir}/${page}.png" \
    --window-size="$window_size" \
    "file://$PWD/$page_html" <<'PY'
import os
import subprocess
import sys

timeout = int(sys.argv[1])
command = sys.argv[2:]
screenshot = next((arg.split("=", 1)[1] for arg in command if arg.startswith("--screenshot=")), None)
try:
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout, check=False)
except subprocess.TimeoutExpired as error:
    if screenshot and os.path.exists(screenshot):
        raise SystemExit(0)
    stderr = error.stderr or ""
    raise SystemExit(f"prototype screenshot timed out after {timeout}s\n{stderr}")

if screenshot and os.path.exists(screenshot):
    raise SystemExit(0)

if result.returncode != 0:
    raise SystemExit(result.stderr or f"prototype screenshot failed with exit code {result.returncode}")
PY

  width="$(sips -g pixelWidth "${out_dir}/${page}.png" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "${out_dir}/${page}.png" | awk '/pixelHeight/ {print $2}')"
  if [[ "${width:-0}" -ne 1440 || "${height:-0}" -ne 900 ]]; then
    echo "invalid prototype screenshot size for ${page}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  python3 - "${out_dir}/${page}.png" "$page" <<'PY'
import struct
import sys
import zlib


def read_png(path):
    with open(path, "rb") as file:
        data = file.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit(f"{path} is not a PNG")

    pos = 8
    width = height = color_type = bit_depth = None
    idat = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos:pos + 4])[0]
        kind = data[pos + 4:pos + 8]
        payload = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            width, height, bit_depth, color_type, _, _, _ = struct.unpack(">IIBBBBB", payload)
        elif kind == b"IDAT":
            idat.extend(payload)
        elif kind == b"IEND":
            break

    if bit_depth != 8 or color_type not in (2, 6):
        raise SystemExit(f"{path} must be 8-bit RGB or RGBA PNG, got bitDepth={bit_depth} colorType={color_type}")

    channels = 4 if color_type == 6 else 3
    stride = width * channels
    raw = zlib.decompress(bytes(idat))
    previous = [0] * stride
    cursor = 0
    non_white = 0
    total = width * height
    for _ in range(height):
        filter_type = raw[cursor]
        cursor += 1
        scanline = list(raw[cursor:cursor + stride])
        cursor += stride
        reconstructed = [0] * stride
        for index, value in enumerate(scanline):
            left = reconstructed[index - channels] if index >= channels else 0
            up = previous[index]
            upper_left = previous[index - channels] if index >= channels else 0
            if filter_type == 0:
                predictor = 0
            elif filter_type == 1:
                predictor = left
            elif filter_type == 2:
                predictor = up
            elif filter_type == 3:
                predictor = (left + up) // 2
            elif filter_type == 4:
                p = left + up - upper_left
                pa = abs(p - left)
                pb = abs(p - up)
                pc = abs(p - upper_left)
                predictor = left if pa <= pb and pa <= pc else up if pb <= pc else upper_left
            else:
                raise SystemExit(f"{path} has unsupported PNG filter {filter_type}")
            reconstructed[index] = (value + predictor) & 0xFF
        previous = reconstructed
        for pixel in range(0, stride, channels):
            red, green, blue = reconstructed[pixel:pixel + 3]
            if red < 245 or green < 245 or blue < 245:
                non_white += 1

    if non_white / total < 0.01:
        page = sys.argv[2]
        raise SystemExit(f"blank prototype screenshot for {page}: non_white_ratio={non_white / total:.6f}")


read_png(sys.argv[1])
PY

  rm -rf "$work_dir" "$user_data_dir"
  echo "Prototype ${page} screenshot: ${out_dir}/${page}.png (${width}x${height})"
done
