english_screenshot_dir="artifacts/e2e-english"
english_screenshot_db="$english_screenshot_dir/Noonmark.sqlite"
english_scenarios_enabled=0
for scenario in "${scenarios[@]}"; do
  IFS="|" read -r _ _ _ scenario_language <<< "$scenario"
  if [[ "$scenario_language" == "english" ]]; then
    english_scenarios_enabled=1
    break
  fi
done
if [[ "$english_scenarios_enabled" == "1" ]]; then
  rm -rf "$english_screenshot_dir"
  mkdir -p "$english_screenshot_dir"
  prepare_english_screenshot_database \
    "$PWD/$english_screenshot_db" \
    "$english_screenshot_dir/bootstrap.log"
fi

for scenario in "${scenarios[@]}"; do
  IFS="|" read -r screenshot_name page extra_args scenario_language <<< "$scenario"
  if [[ "$scenario_language" == "english" ]]; then
    if [[ -n "$extra_args" ]]; then
      # shellcheck disable=SC2086
      NOONMARK_E2E_EXPECTED_LANGUAGE=english capture_app_screenshot \
        artifacts/e2e \
        "$screenshot_name" \
        "$page" \
        --data-url "$PWD/$english_screenshot_db" \
        --e2e-fixed-instant 2026-07-05T16:00:00Z \
        --e2e-fixed-time-zone America/New_York \
        --e2e-fixed-locale en_SG \
        --e2e-reset-selection \
        $extra_args
    else
      NOONMARK_E2E_EXPECTED_LANGUAGE=english capture_app_screenshot \
        artifacts/e2e \
        "$screenshot_name" \
        "$page" \
        --data-url "$PWD/$english_screenshot_db" \
        --e2e-fixed-instant 2026-07-05T16:00:00Z \
        --e2e-fixed-time-zone America/New_York \
        --e2e-fixed-locale en_SG \
        --e2e-reset-selection
    fi
    assert_english_screenshot "artifacts/e2e/${screenshot_name}.png" "$page"
  elif [[ -n "$extra_args" ]]; then
    # shellcheck disable=SC2086
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral --e2e-reset-selection $extra_args
  else
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral --e2e-reset-selection
  fi
  if [[ "$screenshot_name" == "settings" ]]; then
    assert_settings_sidebar_screenshot \
      "artifacts/e2e/${screenshot_name}.png" \
      chinese
  elif [[ "$screenshot_name" == "english-settings" ]]; then
    assert_settings_sidebar_screenshot \
      "artifacts/e2e/${screenshot_name}.png" \
      english
  fi
done

assert_pool_context_menu_screenshot
assert_pool_classification_overflow_screenshot
assert_pool_detail_density_screenshot
assert_sidebar_semantic_icon_colors_screenshot

if [[ "$english_scenarios_enabled" == "1" && "${NOONMARK_E2E_SCREENSHOTS_ONLY:-0}" != "1" ]]; then
  run_english_menu_probe "$PWD/$english_screenshot_db"
fi

if [[ "${NOONMARK_E2E_SCREENSHOTS_ONLY:-0}" == "1" ]]; then
  terminate_e2e_app
  echo "E2E screenshot-only scenarios: ${NOONMARK_E2E_SCENARIOS:-all}"
  exit 0
fi

terminate_e2e_app

run_task_note_persistence_probe

run_task_note_mutation_atomicity_probe

run_reactivation_atomicity_probe

run_copy_undo_persistence_probe

run_ui_entry_probes

