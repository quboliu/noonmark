#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
paths=(Package.swift Sources Tests)
swiftformat_binary="$(scripts/install-pinned-swiftformat)"

if [[ -d App ]]; then
  paths+=(App)
fi

if [[ "$mode" == "--lint" ]]; then
  "$swiftformat_binary" "${paths[@]}" --lint
elif [[ "$mode" == "" ]]; then
  "$swiftformat_binary" "${paths[@]}"
else
  echo "usage: scripts/format [--lint]" >&2
  exit 2
fi
