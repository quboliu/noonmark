#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "missing required tool: sqlite3" >&2
  exit 1
fi

app_bundle_name="${SUNTRACE_E2E_APP_BUNDLE_NAME:-SuntraceMacAppE2E}"
app_executable_name="${SUNTRACE_E2E_APP_EXECUTABLE_NAME:-$app_bundle_name}"
app_bundle_identifier="${SUNTRACE_E2E_BUNDLE_IDENTIFIER:-app.suntrace.mac.e2e}"
app_display_name="${SUNTRACE_E2E_APP_DISPLAY_NAME:-晷迹 E2E}"
app_short_name="${SUNTRACE_E2E_APP_SHORT_NAME:-Suntrace E2E}"
app_path="dist/${app_bundle_name}.app"
export SUNTRACE_E2E_APP_EXECUTABLE_NAME="$app_executable_name"
export SUNTRACE_E2E_APP_DISPLAY_NAME="$app_display_name"

scenarios=(
  "day|day|"
  "day-detail|day|--select first"
  "day-manual-detail|day|--select manual"
  "pool|pool|"
  "pool-detail|pool|--select first"
  "future|future|"
  "future-detail|future|--select first"
  "unfinished|unfinished|"
  "unfinished-detail|unfinished|--select first"
  "completed|completed|"
  "completed-detail|completed|--select first"
  "calendar|calendar|"
  "zhulong|zhulong|"
  "settings|settings|"
)

requested_scenarios="${SUNTRACE_E2E_SCENARIOS:-}"
if [[ -n "$requested_scenarios" ]]; then
  filtered_scenarios=()
  for requested in $requested_scenarios; do
    found=0
    for scenario in "${scenarios[@]}"; do
      IFS="|" read -r screenshot_name _ <<< "$scenario"
      if [[ "$screenshot_name" == "$requested" ]]; then
        filtered_scenarios+=("$scenario")
        found=1
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      echo "unknown E2E screenshot scenario: $requested" >&2
      exit 1
    fi
  done
  scenarios=("${filtered_scenarios[@]}")
fi

SUNTRACE_APP_BUNDLE_NAME="$app_bundle_name" \
  SUNTRACE_APP_EXECUTABLE_NAME="$app_executable_name" \
  SUNTRACE_BUNDLE_IDENTIFIER="$app_bundle_identifier" \
  SUNTRACE_APP_DISPLAY_NAME="$app_display_name" \
  SUNTRACE_APP_SHORT_NAME="$app_short_name" \
  scripts/build-mac-app "$configuration"

mkdir -p artifacts/e2e
pkill -x "$app_executable_name" 2>/dev/null || true
trap 'pkill -x "$app_executable_name" 2>/dev/null || true' EXIT

find_window_id() {
  swift -e '
import CoreGraphics
import Darwin
import Foundation

let expectedOwner = ProcessInfo.processInfo.environment["SUNTRACE_E2E_APP_EXECUTABLE_NAME"] ?? "SuntraceMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["SUNTRACE_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        var allowedOwners = [expectedOwner, expectedDisplayName]
        if expectedOwner == "SuntraceMacApp" {
            allowedOwners.append(contentsOf: ["晷迹", "SuntraceMacApp"])
        }
        if allowedOwners.contains(owner) && name == "晷迹 · suntrace" {
            if let number = window[kCGWindowNumber as String] {
                print(number)
                exit(0)
            }
        }
    }
}
exit(1)
'
}

capture_app_screenshot() {
  local out_dir="$1"
  local screenshot_name="$2"
  local page="$3"
  shift 3

  pkill -x "$app_executable_name" 2>/dev/null || true
  open -n "$app_path" --args "$@" --page "$page"
  sleep "${SUNTRACE_E2E_STARTUP_WAIT:-3}"

  window_id=""
  for _ in {1..20}; do
    if window_id="$(find_window_id 2>/dev/null)"; then
      break
    fi
    sleep 0.25
  done

  if [[ -z "$window_id" ]]; then
    echo "Suntrace app window not found for ${page}" >&2
    exit 1
  fi

  mkdir -p "$out_dir"
  screenshot="${out_dir}/${screenshot_name}.png"
  screencapture -x -l "$window_id" "$screenshot"
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"

  if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 || "${width:-0}" -gt 3000 || "${height:-0}" -gt 2000 ]]; then
    echo "invalid e2e screenshot size for ${screenshot_name}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  echo "E2E ${screenshot_name} screenshot: ${screenshot} (${width}x${height})"
}

for scenario in "${scenarios[@]}"; do
  IFS="|" read -r screenshot_name page extra_args <<< "$scenario"
  if [[ -n "$extra_args" ]]; then
    # shellcheck disable=SC2086
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral $extra_args
  else
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral
  fi
done

if [[ "${SUNTRACE_E2E_SCREENSHOTS_ONLY:-0}" == "1" ]]; then
  pkill -x "$app_executable_name" 2>/dev/null || true
  echo "E2E screenshot-only scenarios: ${SUNTRACE_E2E_SCENARIOS:-all}"
  exit 0
fi

pkill -x "$app_executable_name" 2>/dev/null || true

blank_dir="artifacts/e2e-blank"
blank_db="${blank_dir}/Suntrace.sqlite"
blank_pages=(day pool future unfinished completed calendar)
rm -rf "$blank_dir"
mkdir -p "$blank_dir"

for page in "${blank_pages[@]}"; do
  capture_app_screenshot "$blank_dir" "$page" "$page" --data-url "$PWD/$blank_db"
done

pkill -x "$app_executable_name" 2>/dev/null || true

read -r blank_days blank_chains blank_definitions blank_traces blank_subtasks blank_preferences < <(
  sqlite3 -separator " " "$blank_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$blank_days" -ne 0 || "$blank_chains" -ne 0 || "$blank_definitions" -ne 0 || "$blank_traces" -ne 0 || "$blank_subtasks" -ne 0 || "$blank_preferences" -ne 1 ]]; then
  echo "invalid blank user counts after page screenshots: days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences" >&2
  exit 1
fi

echo "E2E blank user screenshots: $blank_dir (days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences)"

persistence_dir="artifacts/e2e-persistence"
persistence_db="${persistence_dir}/Suntrace.sqlite"
rm -rf "$persistence_dir"
mkdir -p "$persistence_dir"

open -n "$app_path" --args --data-url "$PWD/$persistence_db" --page day
sleep "${SUNTRACE_E2E_STARTUP_WAIT:-3}"
pkill -x "$app_executable_name" 2>/dev/null || true

if [[ ! -f "$persistence_db" ]]; then
  echo "persistence database was not created: $persistence_db" >&2
  exit 1
fi

read -r days chains definitions traces subtasks preferences < <(
  sqlite3 -separator " " "$persistence_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$days" -ne 0 || "$chains" -ne 0 || "$definitions" -ne 0 || "$traces" -ne 0 || "$subtasks" -ne 0 || "$preferences" -ne 1 ]]; then
  echo "invalid persistence counts: days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences" >&2
  exit 1
fi

echo "E2E blank persistence database: $persistence_db (days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences)"

interaction_dir="artifacts/e2e-interaction"
interaction_db="${interaction_dir}/Suntrace.sqlite"
interaction_title="E2E 快速新增任务"
rm -rf "$interaction_dir"
mkdir -p "$interaction_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$interaction_db" \
  --page day \
  --e2e-add-quick-task "$interaction_title" \
  --e2e-quit-after-automation

if [[ ! -f "$interaction_db" ]]; then
  echo "interaction database was not created: $interaction_db" >&2
  exit 1
fi

read -r interaction_definitions interaction_traces < <(
  sqlite3 -separator " " "$interaction_db" "
    SELECT
      (SELECT count(*)
       FROM task_definitions
       WHERE title = '$interaction_title'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$interaction_title'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending');
  "
)

if [[ "$interaction_definitions" -ne 1 || "$interaction_traces" -ne 1 ]]; then
  echo "quick-add interaction failed: definitions=$interaction_definitions traces=$interaction_traces" >&2
  exit 1
fi

echo "E2E quick-add app interaction: $interaction_db (title=$interaction_title definitions=$interaction_definitions traces=$interaction_traces)"

zhulong_dir="artifacts/e2e-zhulong"
zhulong_db="${zhulong_dir}/Suntrace.sqlite"
rm -rf "$zhulong_dir"
mkdir -p "$zhulong_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-generate-zhulong-draft dailyReview \
  --e2e-apply-first-zhulong-operation \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_db" ]]; then
  echo "zhulong database was not created: $zhulong_db" >&2
  exit 1
fi

read -r zhulong_review_count < <(
  sqlite3 "$zhulong_db" "
    SELECT count(*)
    FROM days
    WHERE date = '2026-07-05'
      AND review_summary LIKE '今日共%';
  "
)

if [[ "$zhulong_review_count" -ne 1 ]]; then
  echo "zhulong draft apply failed: review_count=$zhulong_review_count" >&2
  exit 1
fi

echo "E2E zhulong draft apply: $zhulong_db (review_count=$zhulong_review_count)"

provider_dir="artifacts/e2e-provider"
provider_result="${provider_dir}/provider-result.txt"
provider_name="E2E Provider"
provider_base_url="https://provider.example/v1"
provider_model="suntrace-e2e-model"
provider_api_key="suntrace-e2e-dummy-key"
rm -rf "$provider_dir"
mkdir -p "$provider_dir"

open -W -n "$app_path" --args \
  --page zhulong \
  --e2e-configure-provider \
  --e2e-provider-name "$provider_name" \
  --e2e-provider-base-url "$provider_base_url" \
  --e2e-provider-model "$provider_model" \
  --e2e-provider-api-key "$provider_api_key" \
  --e2e-quit-after-automation

open -W -n "$app_path" --args \
  --page zhulong \
  --e2e-verify-provider \
  --e2e-provider-name "$provider_name" \
  --e2e-provider-base-url "$provider_base_url" \
  --e2e-provider-model "$provider_model" \
  --e2e-provider-api-key "$provider_api_key" \
  --e2e-provider-result-url "$PWD/$provider_result" \
  --e2e-quit-after-automation

if [[ ! -f "$provider_result" ]]; then
  echo "provider e2e result was not created: $provider_result" >&2
  exit 1
fi

if [[ "$(cat "$provider_result")" != "ok" ]]; then
  echo "provider e2e failed: $(cat "$provider_result")" >&2
  exit 1
fi

echo "E2E provider config round-trip: $provider_result (name=$provider_name model=$provider_model)"

workflow_dir="artifacts/e2e-workflow"
workflow_db="${workflow_dir}/Suntrace.sqlite"
workflow_result="${workflow_dir}/workflow-result.txt"
workflow_title="E2E 排期延续复盘"
rm -rf "$workflow_dir"
mkdir -p "$workflow_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$workflow_db" \
  --page pool \
  --e2e-domain-workflow \
  --e2e-workflow-title "$workflow_title" \
  --e2e-workflow-result-url "$PWD/$workflow_result" \
  --e2e-quit-after-automation

if [[ ! -f "$workflow_result" ]]; then
  echo "workflow e2e result was not created: $workflow_result" >&2
  exit 1
fi

if [[ "$(cat "$workflow_result")" != "ok" ]]; then
  echo "workflow e2e failed: $(cat "$workflow_result")" >&2
  exit 1
fi

read -r workflow_continued workflow_pending workflow_review < <(
  sqlite3 -separator " " "$workflow_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'continued'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-06'
         AND day_traces.status = 'pending'
         AND day_traces.continuation_seq = 1),
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 已完成排期、延续和复盘写入。'
         AND review_unfinished_reason = '验证真实 App workflow 自动化。'
         AND review_tomorrow_note = '明天检查延续任务。');
  "
)

if [[ "$workflow_continued" -ne 1 || "$workflow_pending" -ne 1 || "$workflow_review" -ne 1 ]]; then
  echo "workflow e2e persistence failed: continued=$workflow_continued pending=$workflow_pending review=$workflow_review" >&2
  exit 1
fi

echo "E2E domain workflow: $workflow_db (continued=$workflow_continued pending=$workflow_pending review=$workflow_review)"

lifecycle_dir="artifacts/e2e-lifecycle"
lifecycle_db="${lifecycle_dir}/Suntrace.sqlite"
lifecycle_result="${lifecycle_dir}/lifecycle-result.txt"
rm -rf "$lifecycle_dir"
mkdir -p "$lifecycle_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$lifecycle_db" \
  --page day \
  --e2e-lifecycle-workflow \
  --e2e-lifecycle-result-url "$PWD/$lifecycle_result" \
  --e2e-quit-after-automation

if [[ ! -f "$lifecycle_result" ]]; then
  echo "lifecycle e2e result was not created: $lifecycle_result" >&2
  exit 1
fi

if [[ "$(cat "$lifecycle_result")" != "ok" ]]; then
  echo "lifecycle e2e failed: $(cat "$lifecycle_result")" >&2
  exit 1
fi

read -r lifecycle_changed lifecycle_new lifecycle_returned lifecycle_abandoned < <(
  sqlite3 -separator " " "$lifecycle_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更旧任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'changed'
         AND day_traces.changed_to_trace_id IS NOT NULL),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更新任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 回池任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'returnedToPool'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'abandoned'
         AND task_chains.state = 'abandoned');
  "
)

if [[ "$lifecycle_changed" -ne 1 || "$lifecycle_new" -ne 1 || "$lifecycle_returned" -ne 1 || "$lifecycle_abandoned" -ne 1 ]]; then
  echo "lifecycle e2e persistence failed: changed=$lifecycle_changed new=$lifecycle_new returned=$lifecycle_returned abandoned=$lifecycle_abandoned" >&2
  exit 1
fi

echo "E2E lifecycle workflow: $lifecycle_db (changed=$lifecycle_changed new=$lifecycle_new returned=$lifecycle_returned abandoned=$lifecycle_abandoned)"

data_package_dir="artifacts/e2e-data-package"
data_package_db="${data_package_dir}/Suntrace.sqlite"
data_package_json="${data_package_dir}/suntrace-e2e-export.json"
data_package_result="${data_package_dir}/data-package-result.txt"
rm -rf "$data_package_dir"
mkdir -p "$data_package_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$data_package_db" \
  --page settings \
  --e2e-data-package-workflow \
  --e2e-data-package-url "$PWD/$data_package_json" \
  --e2e-data-package-result-url "$PWD/$data_package_result" \
  --e2e-quit-after-automation

if [[ ! -f "$data_package_result" ]]; then
  echo "data package e2e result was not created: $data_package_result" >&2
  exit 1
fi

if [[ "$(cat "$data_package_result")" != "ok" ]]; then
  echo "data package e2e failed: $(cat "$data_package_result")" >&2
  exit 1
fi

if [[ ! -s "$data_package_json" ]]; then
  echo "data package export was not created: $data_package_json" >&2
  exit 1
fi

read -r data_package_task data_package_review < <(
  sqlite3 -separator " " "$data_package_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 数据包任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 数据包导出前复盘。'
         AND review_unfinished_reason = '验证 App 导入导出。'
         AND review_tomorrow_note = '导入后继续检查。');
  "
)

if [[ "$data_package_task" -ne 1 || "$data_package_review" -ne 1 ]]; then
  echo "data package e2e persistence failed: task=$data_package_task review=$data_package_review" >&2
  exit 1
fi

echo "E2E data package round-trip: $data_package_json -> $data_package_db (task=$data_package_task review=$data_package_review)"
