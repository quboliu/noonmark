  "$production_bundle_identifier" \
  "$restart_natural_day" \
  "$(evidence_read "$install_manifest" started_at)" \
  "$(evidence_read "$install_manifest" finished_at)"
task_identity="$repo_root/artifacts/dmg-install/task-identity.tsv"
require_install_task_identity "$task_identity"
independent_task_identity="$(tail -n 1 "$task_identity")"
IFS=$'\t' read -r \
  _ _ _ independent_task_day _ _ _ _ <<<"$independent_task_identity"
if [[ "$independent_task_day" != "$exercise_natural_day" ]] ||
  [[ "$exercise_natural_day" != "$restart_natural_day" ]]; then
  echo "installed task natural day disagrees with archived window evidence" >&2
  exit 1
fi
task_snapshot_before="$repo_root/artifacts/dmg-install/task-row-before-restart.txt"
task_snapshot_after="$repo_root/artifacts/dmg-install/task-row-after-restart.txt"
require_install_task_snapshot \
  "$task_snapshot_before" \
  "installed task snapshot before restart" \
  "$independent_task_identity"
require_install_task_snapshot \
  "$task_snapshot_after" \
  "installed task snapshot after restart" \
  "$independent_task_identity"
if ! cmp -s "$task_snapshot_before" "$task_snapshot_after"; then
  echo "installed task snapshots changed across restart" >&2
  exit 1
fi
require_preserved_bundle \
  "$package_manifest" \
  app \
  "$repo_root/dist/Noonmark.app" \
  "package App"
require_preserved_bundle \
  "$install_manifest" \
  installed_app \
  "$repo_root/artifacts/dmg-install/Applications/Noonmark.app" \
  "installed App"
require_preserved_bundle \
  "$install_manifest" \
  helper \
  "$repo_root/artifacts/dmg-install-harness/NoonmarkDMGInstallHarness.app" \
  "install helper"

dmg_path="$(evidence_read "$package_manifest" dmg_path)"
if ! require_safe_repo_relative_path "$dmg_path"; then
  echo "package manifest contains an unsafe DMG path" >&2
  exit 1
fi
dmg_absolute="${repo_root}/${dmg_path}"
checksum_absolute="${dmg_absolute}.sha256"
package_inventory="${dmg_absolute}.inventory.sha256"
require_file_sha256 \
  "$package_manifest" \
  dmg_sha256 \
  "$dmg_absolute" \
  "packaged DMG"
require_file_sha256 \
  "$package_manifest" \
  dmg_checksum_sha256 \
  "$checksum_absolute" \
  "packaged DMG checksum file"
require_file_sha256 \
  "$package_manifest" \
  artifact_inventory_sha256 \
  "$package_inventory" \
  "package artifact inventory"
evidence_verify_inventory "$repo_root" "$package_inventory"
evidence_require_inventory_paths \
  "$repo_root" \
  "$package_inventory" \
  "$repo_root/dist/Noonmark.dmg" \
  "$repo_root/dist/Noonmark.dmg.sha256" \
  "$repo_root/dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp"
if ! (cd "$repo_root" && shasum -a 256 -c "${dmg_path}.sha256" >/dev/null); then
  echo "packaged DMG does not match its checksum file" >&2
  exit 1
fi
if ! scripts/verify-dmg "$dmg_path" >/dev/null; then
  echo "packaged DMG failed fresh mounted verification" >&2
  exit 1
fi

