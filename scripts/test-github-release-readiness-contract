#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

fail() {
  echo "GitHub release readiness contract: $*" >&2
  exit 1
}

require_order() {
  local path="$1"
  local first="$2"
  local second="$3"
  local first_line
  local second_line

  first_line="$(rg -n -F "$first" "$path" | head -n 1 | cut -d: -f1)"
  second_line="$(rg -n -F "$second" "$path" | head -n 1 | cut -d: -f1)"
  [[ "$first_line" =~ ^[0-9]+$ && "$second_line" =~ ^[0-9]+$ &&
    "$first_line" -lt "$second_line" ]] ||
    fail "$path does not order '$first' before '$second'"
}

readiness="scripts/verify-github-release-readiness"
tag_publisher="scripts/push-release-tag"
workflow=".github/workflows/release-publish.yml"
release_guide=".github/RELEASING.md"
release_notes_generator="scripts/generate-github-release-notes"
release_language_verifier="scripts/verify-github-release-language"
publication_verifier="scripts/verify-github-release-publication"

[[ -x "$readiness" ]] || fail "missing executable readiness verifier"
[[ -x "$tag_publisher" ]] || fail "missing executable tag publisher"
[[ -x "$release_notes_generator" ]] ||
  fail "missing executable English release-notes generator"
[[ -x "$release_language_verifier" ]] ||
  fail "missing executable GitHub Release language verifier"

fixture_root="$(
  mktemp -d "${TMPDIR:-/tmp}/noonmark-github-release-readiness.XXXXXX"
)"
cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT

fixture_bin="$fixture_root/bin"
mkdir -p "$fixture_bin"
fake_gh="$fixture_bin/gh"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'case "${1:-} ${2:-}" in' \
  '  "secret list")' \
  '    [[ -r "${NOONMARK_READINESS_SECRETS_FIXTURE:?}" ]]' \
  '    /bin/cat "$NOONMARK_READINESS_SECRETS_FIXTURE"' \
  '    ;;' \
  '  "api repos/quboliu/noonmark/environments/release/deployment-branch-policies")' \
  '    [[ -r "${NOONMARK_READINESS_POLICY_FIXTURE:?}" ]]' \
  '    /bin/cat "$NOONMARK_READINESS_POLICY_FIXTURE"' \
  '    ;;' \
  '  *)' \
  '    echo "unexpected fake gh arguments: $*" >&2' \
  '    exit 64' \
  '    ;;' \
  'esac' >"$fake_gh"
chmod 0700 "$fake_gh"

complete_secrets="$fixture_root/complete-secrets.txt"
missing_secrets="$fixture_root/missing-secrets.txt"
extra_secrets="$fixture_root/extra-secrets.txt"
exact_policy="$fixture_root/exact-policy.txt"
branch_policy="$fixture_root/branch-policy.txt"
broad_policy="$fixture_root/broad-policy.txt"
printf '%s\n' \
  APPLE_DEV_CERT_P12_BASE64 \
  APPLE_DEV_CERT_PASSWORD \
  APPLE_DEV_KEYCHAIN_PASSWORD >"$complete_secrets"
printf '%s\n' \
  APPLE_DEV_CERT_P12_BASE64 \
  APPLE_DEV_CERT_PASSWORD >"$missing_secrets"
printf '%s\n' \
  APPLE_DEV_CERT_P12_BASE64 \
  APPLE_DEV_CERT_PASSWORD \
  APPLE_DEV_KEYCHAIN_PASSWORD \
  UNEXPECTED_RELEASE_SECRET >"$extra_secrets"
printf 'tag\tv*\n' >"$exact_policy"
printf 'branch\tmain\n' >"$branch_policy"
printf 'tag\t*\n' >"$broad_policy"

run_readiness() {
  local secrets_fixture="$1"
  local policy_fixture="$2"
  local output_path="$3"

  PATH="$fixture_bin:$PATH" \
    NOONMARK_READINESS_SECRETS_FIXTURE="$secrets_fixture" \
    NOONMARK_READINESS_POLICY_FIXTURE="$policy_fixture" \
    "$readiness" >"$output_path" 2>&1
}

complete_output="$fixture_root/complete-output.txt"
run_readiness "$complete_secrets" "$exact_policy" "$complete_output" ||
  fail "readiness verifier rejected the exact release environment"
grep -Fqx \
  'GitHub release readiness verified: quboliu/noonmark environment release' \
  "$complete_output" || fail "readiness verifier omitted its success identity"

missing_output="$fixture_root/missing-output.txt"
if run_readiness "$missing_secrets" "$exact_policy" "$missing_output"; then
  fail "readiness verifier accepted a missing signing secret"
fi
grep -Fq 'missing environment secret: APPLE_DEV_KEYCHAIN_PASSWORD' \
  "$missing_output" || fail "missing-secret failure was not specific"

extra_output="$fixture_root/extra-output.txt"
if run_readiness "$extra_secrets" "$exact_policy" "$extra_output"; then
  fail "readiness verifier accepted an unexpected environment secret"
fi
grep -Fq 'release environment must contain exactly the three signing secrets' \
  "$extra_output" || fail "extra-secret failure was not specific"

branch_output="$fixture_root/branch-output.txt"
if run_readiness "$complete_secrets" "$branch_policy" "$branch_output"; then
  fail "readiness verifier accepted a branch deployment policy"
fi
grep -Fq 'release environment must allow exactly the v* tag policy' \
  "$branch_output" || fail "branch-policy failure was not specific"

broad_output="$fixture_root/broad-output.txt"
if run_readiness "$complete_secrets" "$broad_policy" "$broad_output"; then
  fail "readiness verifier accepted an over-broad tag policy"
fi

"$release_language_verifier" --self-test ||
  fail "GitHub Release language verifier self-test failed"
notes_repository="$fixture_root/release-notes-repository"
mkdir -p "$notes_repository/scripts"
cp "$release_notes_generator" \
  "$notes_repository/scripts/generate-github-release-notes"
(
  cd "$notes_repository"
  git init -q
  git config user.name "Release Notes Fixture"
  git config user.email "release-notes@example.invalid"
  printf 'baseline\n' >product.txt
  git add product.txt scripts/generate-github-release-notes
  git commit -qm 'chore(release): establish the prior release'
  git tag -a v0.2.3 -m 'fixture v0.2.3'
  printf 'feature\n' >>product.txt
  git add product.txt
  git commit -qm 'feat(ui): simplify flylight and subtask surfaces'
  printf 'ci\n' >>product.txt
  git add product.txt
  git commit -qm 'fix(ci): pin the SwiftFormat toolchain'
  git tag -a v0.2.4 -m 'fixture v0.2.4'
)
generated_notes="$fixture_root/generated-release-notes.md"
(
  cd "$notes_repository"
  scripts/generate-github-release-notes \
    v0.2.4 \
    "$(git rev-list -n 1 v0.2.4)" \
    21 \
    "$generated_notes"
)
"$release_language_verifier" --file "$generated_notes" ||
  fail "generated GitHub Release notes are not English"
grep -Fqx "## What's Changed" "$generated_notes" ||
  fail "generated release notes lack their English heading"
grep -Fq 'Simplify flylight and subtask surfaces' "$generated_notes" ||
  fail "generated release notes omit the user-facing feature commit"
if grep -Fq 'Pin the SwiftFormat toolchain' "$generated_notes"; then
  fail "generated release notes expose an infrastructure-only commit"
fi

rg -n 'uses: actions/checkout@[0-9a-f]{40}$' "$workflow" >/dev/null ||
  fail "release workflow does not pin checkout to a full commit SHA"
rg -F 'persist-credentials: false' "$workflow" >/dev/null ||
  fail "release workflow leaves checkout credentials available"
for required_path in \
  'NOONMARK_CI_CERT_P12: ${{ runner.temp }}/' \
  'NOONMARK_CI_KEYCHAIN: ${{ runner.temp }}/' \
  'NOONMARK_CI_SIGNING_PROBE: ${{ runner.temp }}/'; do
  [[ "$(grep -Fc "$required_path" "$workflow")" -eq 2 ]] ||
    fail "release workflow does not bind signing material to import and cleanup steps"
done
rg -F "printf '%s' \"\$APPLE_DEV_CERT_P12_BASE64\"" "$workflow" >/dev/null ||
  fail "release workflow does not stream the P12 secret without echo"
if rg -F 'echo "$APPLE_DEV_CERT_P12_BASE64"' "$workflow" >/dev/null; then
  fail "release workflow still passes the P12 secret through echo"
fi
rg -F 'if: always()' "$workflow" >/dev/null ||
  fail "release workflow lacks an unconditional signing cleanup step"
rg -F 'security delete-keychain "$NOONMARK_CI_KEYCHAIN"' \
  "$workflow" >/dev/null ||
  fail "release workflow does not delete its temporary keychain"
rg -F 'rm -f "$NOONMARK_CI_CERT_P12"' "$workflow" >/dev/null ||
  fail "release workflow does not delete its temporary P12"
rg -F 'signing keychain must contain exactly one valid Apple Development identity' \
  "$workflow" >/dev/null ||
  fail "release workflow does not enforce one signing identity"
rg -F 'codesign --verify --strict "$NOONMARK_CI_SIGNING_PROBE"' \
  "$workflow" >/dev/null ||
  fail "release workflow does not prove the imported private key"
require_order \
  "$workflow" \
  'name: Verify prior GitHub-hosted CI' \
  'name: Import and prove Apple Development signing identity'
require_order \
  "$workflow" \
  'name: Remove signing material' \
  'name: Checksum and release notes'
rg -F 'scripts/generate-github-release-notes' "$workflow" >/dev/null ||
  fail "release workflow does not use the English notes generator"
rg -F 'scripts/verify-github-release-language --file RELEASE_NOTES.md' \
  "$workflow" >/dev/null ||
  fail "release workflow does not fail closed on non-English notes"
if rg -F '用户可见变化' "$workflow" >/dev/null; then
  fail "release workflow still extracts Chinese release notes"
fi
rg -F 'scripts/verify-github-release-language "$tag"' \
  "$publication_verifier" >/dev/null ||
  fail "publication verifier does not check the live Release language"

require_order \
  "$tag_publisher" \
  'scripts/verify-github-release-readiness' \
  'scripts/verify-github-hosted-ci "$head_commit"'
require_order \
  "$tag_publisher" \
  'scripts/verify-github-hosted-ci "$head_commit"' \
  'git push origin'
require_order \
  "$tag_publisher" \
  'git push origin' \
  'scripts/verify-github-release-publication'
for forbidden_local_evidence in \
  'scripts/verify-release-static-preflight' \
  'scripts/verify-development-validation-evidence' \
  'scripts/verify-tencent-ime-release-smoke-evidence' \
  'artifacts/e2e-runtime' \
  'artifacts/e2e-data-root-process-lease'; do
  if rg -F "$forbidden_local_evidence" "$tag_publisher" >/dev/null; then
    fail "tag publisher consumes local self-test evidence: $forbidden_local_evidence"
  fi
done
rg -F 'expected_job_boundary=' scripts/verify-github-release-publication >/dev/null ||
  fail "publication verifier does not enforce one GitHub-hosted release job"
if rg -F -- '--clobber' "$workflow" >/dev/null ||
  rg -F 'gh release edit' "$workflow" >/dev/null; then
  fail "release workflow can overwrite an existing delivered build"
fi
rg -F 'GitHub Release already exists; refusing to overwrite this build' \
  "$workflow" >/dev/null ||
  fail "release workflow does not reject an existing release"
if rg -F 'workflow_dispatch:' "$workflow" >/dev/null; then
  fail "release workflow exposes an unauthorized manual publication entry"
fi
rg -F 'release workflow requires an existing v* tag ref' "$workflow" >/dev/null ||
  fail "release workflow is not restricted to a v* tag ref"
rg -F 'actions: read' "$workflow" >/dev/null ||
  fail "release workflow cannot inspect prior candidate runs"
rg -F 'release workflow reruns are forbidden' "$workflow" >/dev/null ||
  fail "release workflow accepts a repeated run attempt"
rg -F 'this candidate commit already entered the release workflow' \
  "$workflow" >/dev/null ||
  fail "manual release entry accepts a previously failed candidate"
rg -F 'scripts/push-release-tag' "$release_guide" >/dev/null ||
  fail "release guide bypasses the guarded tag publisher"
rg -F 'gh secret set --env release' "$release_guide" >/dev/null ||
  fail "release guide does not scope signing secrets to the release environment"

echo "GitHub release readiness contract passed"
