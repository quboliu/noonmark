#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/build-workspace-common"
noonmark_build_workspace_init

source scripts/app-icon-common

app_path="${1:-${NOONMARK_DIST_DIR}/Noonmark.app}"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-app-icon-bundle-test.XXXXXX")"
reference_app="${work_dir}/CanonicalIconReference.app"
launch_services="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

cleanup() {
  if [[ -d "$reference_app" && -x "$launch_services" ]]; then
    "$launch_services" -u "$reference_app" >/dev/null 2>&1 || true
  fi
  rm -rf "$work_dir"
}
trap cleanup EXIT

scripts/test-app-icon

if [[ ! -d "$app_path" ]]; then
  echo "missing app bundle for icon verification: $app_path" >&2
  exit 1
fi

app_directory="$(cd "$(dirname "$app_path")" && pwd)"
app_path="${app_directory}/$(basename "$app_path")"
plist_path="${app_path}/Contents/Info.plist"

if [[ ! -f "$plist_path" ]]; then
  echo "app bundle missing Info.plist: $plist_path" >&2
  exit 1
fi

icon_name="$(plutil -extract CFBundleIconFile raw "$plist_path")"
bundle_icon="${app_path}/Contents/Resources/${icon_name}.icns"
if [[ "$icon_name" != "$app_icon_bundle_icon_name" || ! -f "$bundle_icon" ]]; then
  echo "app bundle missing the canonical ${app_icon_bundle_icon_name}.icns" >&2
  exit 1
fi

if ! cmp -s "$app_icon_icns_path" "$bundle_icon"; then
  echo "app bundle icon differs from the verified repository asset" >&2
  exit 1
fi

codesign --verify --deep --strict "$app_path"

if [[ ! -x "$launch_services" ]]; then
  echo "missing LaunchServices registration tool: $launch_services" >&2
  exit 1
fi
"$launch_services" -f "$app_path" >/dev/null

# NSWorkspace 返回系统呈现后的图标，并不保证保留原始 PNG 的像素。
# 用独立、从标准资源构造的 App 经同一系统路径生成参考；不放宽像素门禁。
mkdir -p "$reference_app/Contents/MacOS" "$reference_app/Contents/Resources"
cp /usr/bin/true "$reference_app/Contents/MacOS/IconReference"
cp "$app_icon_icns_path" "$reference_app/Contents/Resources/AppIcon.icns"
reference_identifier="app.noonmark.test.icon-reference.$(uuidgen | tr '[:upper:]' '[:lower:]')"
cat >"$reference_app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>$reference_identifier</string>
  <key>CFBundleExecutable</key><string>IconReference</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleName</key><string>CanonicalIconReference</string>
</dict></plist>
PLIST
codesign --force --sign - "$reference_app" >/dev/null 2>&1
codesign --verify --strict "$reference_app"
"$launch_services" -f "$reference_app" >/dev/null

source scripts/app-icon-presentation-common

workspace_png="${work_dir}/workspace-icon.png"
reference_png="${work_dir}/reference-icon.png"
render_workspace_icon "$app_path" "$workspace_png"
render_workspace_icon "$reference_app" "$reference_png"

workspace_width="$(sips -g pixelWidth "$workspace_png" | awk '/pixelWidth/ {print $2}')"
workspace_height="$(sips -g pixelHeight "$workspace_png" | awk '/pixelHeight/ {print $2}')"
if [[ "$workspace_width" != "1024" || "$workspace_height" != "1024" ]]; then
  echo "NSWorkspace returned an invalid app icon representation" >&2
  exit 1
fi

compare_workspace_icons "$reference_png" "$workspace_png"

echo "Verified macOS resolved the canonical icon for $app_path"
