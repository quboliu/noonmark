            and all(item["lane"] == "full" and item["role"] == "history-boundary" and item["milestone"] == "历史边界" for item in history_boundary_roles),
            json.dumps(history_boundary_roles, ensure_ascii=False, sort_keys=True),
        )
        self.navigate("variant=C&scenario=receipt&role-case=receipt")
        receipt_roles = self.evaluate(
