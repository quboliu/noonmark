mkdir -p "$diagnostic_dir"
runtime_evidence_snapshot_diagnostics \
  NoonmarkEvidenceFixture \
  "$diagnostic_baseline" \
  "$diagnostic_dir"
runtime_evidence_assert_no_new_diagnostics \
  NoonmarkEvidenceFixture \
  "$diagnostic_baseline" \
  "$fixture/diagnostic-artifacts" \
  1 \
  "$diagnostic_dir"
[[ -f "${diagnostic_baseline}.current" &&
  -f "${diagnostic_baseline}.new" &&
  ! -s "${diagnostic_baseline}.new" ]] ||
  fail "clean diagnostic evidence did not preserve final and empty diff"

sha=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
report="$fixture/sigkill.tsv"
{
  printf 'phase\tpid\tparent_pid\tsignal\treason\texpected_status\tobserved_status\tbinary_path\tbinary_sha256\n'
  printf 'sigkill-holder\t4242\t4000\tSIGKILL\tlease-reacquisition\t137\t137\t/tmp/Noonmark\t%s\n' "$sha"
} >"$report"
evidence_verify_sigkill_allowlist \
  "$report" \
  "4242:SIGKILL:sigkill-holder:137:$sha"
if evidence_verify_sigkill_allowlist "$report" \
  "4243:SIGKILL:sigkill-holder:137:$sha" >/dev/null 2>&1; then
  fail "SIGKILL allowlist accepted the wrong PID"
fi
if evidence_verify_sigkill_allowlist "$report" \
  "4242:SIGTERM:sigkill-holder:137:$sha" >/dev/null 2>&1; then
  fail "SIGKILL allowlist accepted the wrong signal"
fi
cp "$report" "$fixture/extra.tsv"
tail -n 1 "$report" >>"$fixture/extra.tsv"
if evidence_verify_sigkill_allowlist "$fixture/extra.tsv" \
  "4242:SIGKILL:sigkill-holder:137:$sha" >/dev/null 2>&1; then
  fail "SIGKILL allowlist accepted an extra termination"
fi

for literal in \
  'source scripts/evidence-common' \
  'evidence_prepare_fresh_directory "$repo_root" "$check_evidence_dir"' \
  'evidence_capture_source "$repo_root" source "$source_start_fragment"' \
  'evidence_begin_manifest' \
  'evidence_capture_source "$repo_root" source_end "$source_end_fragment"' \
  'evidence_finish_manifest' \
  'artifact_inventory_sha256'; do
  if ! grep -F -- "$literal" "$repo_root/scripts/check" >/dev/null; then
    fail "scripts/check is missing auditable final-check evidence: $literal"
  fi
done
if ! grep -F \
  "artifacts/audit-final/make-check" \
  "$repo_root/.github/workflows/ci.yml" >/dev/null ||
  ! grep -F \
    "artifacts/audit-final" \
    "$repo_root/.github/workflows/release.yml" >/dev/null; then
  fail "check evidence is not retained by CI and release workflows"
fi

echo "Validation evidence common seam checks passed"
