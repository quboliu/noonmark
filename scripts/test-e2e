parse_native_command_help_ready() {
  local ready_path="$1"
  local expected_token="$2"
  local expected_menu_title="$3"
  local expected_menu_item_title="$4"
  local status_line token_line pid_line app_path_line window_number_line
  local window_title_line menu_title_line menu_item_title_line
  local final_byte

  NATIVE_COMMAND_READY_TOKEN=""
  NATIVE_COMMAND_READY_PID=""
  NATIVE_COMMAND_READY_APP_PATH=""
  NATIVE_COMMAND_READY_WINDOW_NUMBER=""
  NATIVE_COMMAND_READY_WINDOW_TITLE=""
  NATIVE_COMMAND_READY_MENU_TITLE=""
  NATIVE_COMMAND_READY_MENU_ITEM_TITLE=""

  if [[ ! "$expected_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "native command Help ready expectation had an invalid launch token" >&2
    return 1
  fi
  if [[ ! -f "$ready_path" || -L "$ready_path" ]] ||
    [[ "$(stat -f '%z' "$ready_path" 2>/dev/null || printf '0')" -gt 8192 ]] ||
    [[ "$(awk 'END { print NR + 0 }' "$ready_path")" != "8" ]]; then
    echo "native command Help ready artifact was not one bounded eight-line file" >&2
    return 1
  fi
  final_byte="$(tail -c 1 "$ready_path" | od -An -t u1 | tr -d ' ')"
  if [[ "$final_byte" != "10" ]]; then
    echo "native command Help ready artifact lacked its exact trailing newline" >&2
    return 1
  fi

  status_line="$(sed -n '1p' "$ready_path")"
  token_line="$(sed -n '2p' "$ready_path")"
  pid_line="$(sed -n '3p' "$ready_path")"
  app_path_line="$(sed -n '4p' "$ready_path")"
  window_number_line="$(sed -n '5p' "$ready_path")"
  window_title_line="$(sed -n '6p' "$ready_path")"
  menu_title_line="$(sed -n '7p' "$ready_path")"
  menu_item_title_line="$(sed -n '8p' "$ready_path")"

  if [[ "$status_line" != "status=ready" ||
    "$token_line" != "launch_token=$expected_token" ||
    ! "$pid_line" =~ ^pid=([1-9][0-9]*)$ ||
    "$app_path_line" != "app_path=$PWD/$app_path" ||
    ! "$window_number_line" =~ ^window_number=([1-9][0-9]*)$ ||
    "$window_title_line" != window_title=* ||
    "$menu_title_line" != "menu_title=$expected_menu_title" ||
    "$menu_item_title_line" != "menu_item_title=$expected_menu_item_title" ]]; then
    echo "native command Help ready artifact did not match its fixed field schema" >&2
    cat "$ready_path" >&2
    return 1
  fi

  NATIVE_COMMAND_READY_TOKEN="${token_line#launch_token=}"
  NATIVE_COMMAND_READY_PID="${pid_line#pid=}"
  NATIVE_COMMAND_READY_APP_PATH="${app_path_line#app_path=}"
  NATIVE_COMMAND_READY_WINDOW_NUMBER="${window_number_line#window_number=}"
  NATIVE_COMMAND_READY_WINDOW_TITLE="${window_title_line#window_title=}"
  NATIVE_COMMAND_READY_MENU_TITLE="${menu_title_line#menu_title=}"
  NATIVE_COMMAND_READY_MENU_ITEM_TITLE="${menu_item_title_line#menu_item_title=}"
  if [[ -z "$NATIVE_COMMAND_READY_WINDOW_TITLE" ||
    "$NATIVE_COMMAND_READY_WINDOW_TITLE" == *"="* ||
    "$NATIVE_COMMAND_READY_WINDOW_TITLE" == *$'\t'* ||
    "$NATIVE_COMMAND_READY_MENU_TITLE" == *$'\t'* ||
    "$NATIVE_COMMAND_READY_MENU_ITEM_TITLE" == *$'\t'* ]]; then
    echo "native command Help ready artifact contained an invalid controlled value" >&2
    return 1
  fi
  native_command_app_ready_identity_matches \
    "$NATIVE_COMMAND_READY_PID" \
    "$NATIVE_COMMAND_READY_APP_PATH" \
    "$NATIVE_COMMAND_READY_WINDOW_NUMBER" \
    "$NATIVE_COMMAND_READY_WINDOW_TITLE"
}

assert_native_command_helper_completion() {
  local completion_path="$1"
  local token="$2"
  local helper_pid="$3"
  local target_pid="$4"
  local window_number="$5"
  local menu_title="$6"
  local menu_item_title="$7"
  local final_byte

  if [[ ! -f "$completion_path" || -L "$completion_path" ]] ||
    [[ "$(stat -f '%z' "$completion_path" 2>/dev/null || printf '0')" -gt 8192 ]] ||
    [[ "$(awk 'END { print NR + 0 }' "$completion_path")" != "7" ]]; then
    echo "native command Helper completion was not one bounded seven-line file" >&2
    return 1
  fi
  final_byte="$(tail -c 1 "$completion_path" | od -An -t u1 | tr -d ' ')"
  if [[ "$final_byte" != "10" ]] ||
    [[ "$(sed -n '1p' "$completion_path")" != "status=complete" ]] ||
    [[ "$(sed -n '2p' "$completion_path")" != "launch_token=$token" ]] ||
    [[ "$(sed -n '3p' "$completion_path")" != "helper_pid=$helper_pid" ]] ||
    [[ "$(sed -n '4p' "$completion_path")" != "target_pid=$target_pid" ]] ||
    [[ "$(sed -n '5p' "$completion_path")" != "window_number=$window_number" ]] ||
    [[ "$(sed -n '6p' "$completion_path")" != "menu_title=$menu_title" ]] ||
    [[ "$(sed -n '7p' "$completion_path")" != "menu_item_title=$menu_item_title" ]]; then
    echo "native command Helper completion did not match this exact launch" >&2
    cat "$completion_path" >&2
    return 1
  fi
}

dump_native_command_helper_evidence() {
  local path
  for path in "$@"; do
    if [[ -f "$path" ]]; then
      echo "native command Helper evidence: $path" >&2
      cat "$path" >&2
    fi
  done
}

wait_for_native_command_helper_process_record() {
  local ledger_path="$1"
  local token="$2"
  local expected_mode="${3:-e2e-menu-command}"
  local helper_pid live_pids
  local observed_token

  NATIVE_COMMAND_HELPER_PID=""
  for _ in {1..400}; do
    if [[ -f "$ledger_path" ]]; then
      if grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
        echo "native command Helper failed before publishing its process identity" >&2
        return 1
      fi
      if IFS=$'\t' read -r helper_pid observed_token < <(
        dmg_harness_process_identity "$expected_mode" "$ledger_path"
      ); then
        if [[ "$observed_token" != "$token" ]]; then
          echo "native command Helper process launch token was invalid" >&2
          return 1
        fi
        if ! native_command_helper_process_matches \
          "$helper_pid" \
          "$expected_mode" \
          "$token"; then
          echo "native command Helper executable, mode, or token identity did not match" >&2
          return 1
        fi
        if ! native_command_helper_bundle_matches "$helper_pid"; then
          return 1
        fi
        live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
        if [[ "$live_pids" != "$helper_pid" ]]; then
          echo "native command Helper launch was not the sole exact helper process: ${live_pids:-none}" >&2
          return 1
        fi
        NATIVE_COMMAND_HELPER_PID="$helper_pid"
        return 0
      elif grep -F $'\tprocess\t' "$ledger_path" >/dev/null 2>&1; then
        echo "native command Helper process record was invalid or duplicated" >&2
        return 1
      fi
    fi
    sleep 0.025
  done
  echo "timed out waiting for the native command Helper process identity" >&2
  return 1
}

assert_native_command_helper_completed() {
  local ledger_path="$1"
  local stdout_path="$2"
  local stderr_path="$3"
  local launch_path="$4"
  local observer_log_path="$5"
  local exit_result_path="$6"
  local completion_path="$7"
  local helper_pid="$8"
  local token="$9"
  local target_pid="${10}"
  local target_app_path="${11}"
  local window_number="${12}"
  local window_title="${13}"
  local menu_title="${14}"
  local menu_item_title="${15}"
  local argument_detail
  local activation_detail

  if ! helper_exit_result_matches \
    "$exit_result_path" \
    "e2e-menu-command" \
    "$helper_pid" \
    "$token"; then
    echo "native command Helper did not expose one normal kernel exit" >&2
    return 1
  fi
  if [[ ! -s "$ledger_path" ]] || ! cmp -s "$ledger_path" "$stdout_path" ||
    [[ -s "$stderr_path" || -s "$launch_path" || -s "$observer_log_path" ]] ||
    grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
    echo "native command Helper output was incomplete, divergent, or failed" >&2
    return 1
  fi
  if ! dmg_harness_require_exact_steps \
    "e2e-menu-command" "$ledger_path"; then
    echo "native command Helper ledger lost its exact ordered protocol" >&2
    return 1
  fi
  if ! dmg_harness_process_observer_evidence_matches \
    "e2e-menu-command" "$ledger_path" "$helper_pid" "$token"; then
    echo "native command Helper process identity evidence was invalid" >&2
    return 1
  fi
  activation_detail="$(
    awk -F $'\t' '$3 == "activation" { print $4 }' "$ledger_path"
  )"
  if ! dmg_harness_activation_evidence_matches \
    "$activation_detail" \
    "app.noonmark.mac.e2e" \
    "$target_app_path" \
    "$target_pid"; then
    echo "native command Helper activation evidence was invalid" >&2
    return 1
  fi
  if ! awk -F $'\t' \
    -v app="$target_app_path" \
    -v target_pid="$target_pid" '
      NR == 4 && $4 != "AXIsProcessTrusted=true CGPreflightPostEventAccess=true" {
        exit 1
      }
      NR == 6 && index($4, "bundle=app.noonmark.mac.e2e path=" app " frontmost=true windows=") != 1 {
        exit 1
      }
      NR == 12 && $4 != "mode=e2e-menu-command" { exit 1 }
      END { exit !(NR == 12) }
    ' "$ledger_path"; then
    echo "native command Helper ledger lost its exact ordered protocol" >&2
    return 1
  fi
  argument_detail="mode=e2e-menu-command pid=$target_pid app=$target_app_path window_number=$window_number window=$window_title menu=$menu_title item=$menu_item_title completion=$completion_path"
  if ! awk -F $'\t' -v detail="$argument_detail" '
    NR == 1 && $2 == "PASS" && $3 == "arguments" && $4 == detail { found = 1 }
    END { exit !found }
  ' "$ledger_path"; then
    echo "native command Helper arguments were not bound to the parsed App ready artifact" >&2
    return 1
  fi
  if ! assert_native_command_helper_completion \
    "$completion_path" \
    "$token" \
    "$helper_pid" \
    "$target_pid" \
    "$window_number" \
    "$menu_title" \
    "$menu_item_title"; then
    return 1
  fi
}

run_native_command_menu_helper() {
  local target_pid="$1"
  local target_app_path="$2"
  local window_number="$3"
  local window_title="$4"
  local menu_title="$5"
  local menu_item_title="$6"
  local token="$7"
  local completion_path="$8"
  local evidence_dir="$9"
  local ledger_path="$evidence_dir/ledger.tsv"
  local stdout_path="$evidence_dir/stdout.log"
  local stderr_path="$evidence_dir/stderr.log"
  local launch_path="$evidence_dir/open.log"
  local observer_log_path="$evidence_dir/exit-observer.log"
  local observer_gate_path="$evidence_dir/exit-observer-gate.txt"
  local exit_result_path="$evidence_dir/exit-status.txt"
  local helper_pid live_pids

  if [[ "$evidence_dir" != /* ]]; then
    evidence_dir="$PWD/$evidence_dir"
    ledger_path="$evidence_dir/ledger.tsv"
    stdout_path="$evidence_dir/stdout.log"
    stderr_path="$evidence_dir/stderr.log"
    launch_path="$evidence_dir/open.log"
    observer_log_path="$evidence_dir/exit-observer.log"
    observer_gate_path="$evidence_dir/exit-observer-gate.txt"
    exit_result_path="$evidence_dir/exit-status.txt"
  fi

  if [[ "$helper_requested" != "1" || ! -x "$helper_executable_path" ]] ||
    ! codesign --verify --deep --strict "$helper_bundle" >/dev/null 2>&1; then
    echo "native command exercise lacks its verified signed Helper bundle" >&2
    return 1
  fi
  if [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ||
    "$completion_path" != /* || -e "$completion_path" || -L "$completion_path" ]]; then
    echo "native command exercise received an invalid Helper completion boundary" >&2
    return 1
  fi
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if [[ -n "$live_pids" ]]; then
    echo "native command exercise refuses to overlap live Helper processes: $live_pids" >&2
    return 1
  fi

  mkdir -p "$evidence_dir"
  rm -f \
    "$ledger_path" \
    "$stdout_path" \
    "$stderr_path" \
    "$launch_path" \
    "$observer_log_path" \
    "$observer_gate_path" \
    "$exit_result_path"
  : >"$stdout_path"
  : >"$stderr_path"
  : >"$launch_path"
  : >"$observer_log_path"

  active_native_command_helper_pid=""
  active_native_command_helper_token="$token"
  active_native_command_helper_mode="e2e-menu-command"

  if ! /usr/bin/open \
    -n \
    -g \
    --stdout "$stdout_path" \
    --stderr "$stderr_path" \
    "$PWD/$helper_bundle" \
    --args \
    --mode e2e-menu-command \
    --ledger "$ledger_path" \
    --launch-token "$token" \
    --start-gate "$observer_gate_path" \
    --pid "$target_pid" \
    --app-path "$target_app_path" \
    --window-number "$window_number" \
    --window-title "$window_title" \
    --menu-title "$menu_title" \
    --menu-item-title "$menu_item_title" \
    --completion "$completion_path" \
    >"$launch_path" 2>&1; then
    echo "LaunchServices rejected the native command Helper launch" >&2
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path"
    return 1
  fi
  if [[ -s "$launch_path" ]]; then
    echo "LaunchServices emitted output for the native command Helper launch" >&2
    dump_native_command_helper_evidence "$launch_path"
    return 1
  fi

  if ! wait_for_native_command_helper_process_record "$ledger_path" "$token"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path"
    return 1
  fi
  helper_pid="$NATIVE_COMMAND_HELPER_PID"
  active_native_command_helper_pid="$helper_pid"
  if ! start_helper_exit_observer_process \
    "e2e-menu-command" \
    "$helper_pid" \
    "$token" \
    "$observer_gate_path" \
    "$exit_result_path" \
    "$observer_log_path" \
    30 \
    "$repo_root/scripts/dmg-install-exit-observer.swift"; then
    dump_native_command_helper_evidence "$ledger_path" "$observer_log_path"
    return 1
  fi
  if ! wait_for_helper_observer_gate \
    "e2e-menu-command" \
    "$helper_pid" \
    "$token" \
    "$observer_gate_path" \
    "$exit_result_path"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$observer_log_path" "$exit_result_path"
    return 1
  fi
  if ! wait_for_helper_exit_result \
    "$helper_pid" \
    "e2e-menu-command" \
    "$token" \
    "$exit_result_path"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stderr_path" "$observer_log_path" "$exit_result_path"
    return 1
  fi
  if ! assert_native_command_helper_completed \
    "$ledger_path" \
    "$stdout_path" \
    "$stderr_path" \
    "$launch_path" \
    "$observer_log_path" \
    "$exit_result_path" \
    "$completion_path" \
    "$helper_pid" \
    "$token" \
    "$target_pid" \
    "$target_app_path" \
    "$window_number" \
    "$window_title" \
    "$menu_title" \
    "$menu_item_title"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path" \
      "$observer_log_path" "$exit_result_path"
    return 1
  fi

  for _ in {1..160}; do
    if ! kill -0 "$helper_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if kill -0 "$helper_pid" 2>/dev/null || [[ -n "$live_pids" ]]; then
    echo "native command Helper remained after its verified exit: ${live_pids:-$helper_pid}" >&2
    return 1
  fi
  active_native_command_helper_pid=""
  active_native_command_helper_token=""
  active_native_command_helper_mode=""
}

parse_open_panel_ready() {
  local ready_path="$1"
  local expected_label="$2"
  local parent_path="${ready_path%/*}"

  OPEN_PANEL_READY_TOKEN=""
  OPEN_PANEL_READY_PID=""
  OPEN_PANEL_READY_APP_PATH=""
  OPEN_PANEL_READY_WINDOW_NUMBER=""
  OPEN_PANEL_READY_WINDOW_LAYER=""
  OPEN_PANEL_READY_WINDOW_TITLE=""
  OPEN_PANEL_READY_SELECTED_PATH=""

  if [[ ! -f "$ready_path" || -L "$ready_path" ]] ||
    [[ "$(stat -f '%Lp' "$ready_path" 2>/dev/null || printf '0')" != "600" ]] ||
    [[ "$(stat -f '%u' "$ready_path" 2>/dev/null || printf 'missing')" != "$(id -u)" ]] ||
    [[ ! -d "$parent_path" || -L "$parent_path" ]] ||
    [[ "$(stat -f '%Lp' "$parent_path" 2>/dev/null || printf '0')" != "700" ]] ||
    ! jq -e --arg label "$expected_label" --arg app "$PWD/$app_path" '
      keys == [
        "appPath", "interactionLabel", "launchToken", "panelLayer",
        "panelTitle", "panelWindowNumber", "schemaVersion", "selectedPath",
        "status", "targetPID"
      ] and
      .schemaVersion == 1 and
      .status == "ready" and
      .interactionLabel == $label and
      (.launchToken | type) == "string" and
      (.targetPID | type) == "number" and
      .targetPID >= 1 and .targetPID <= 2147483647 and
      .appPath == $app and
      (.panelWindowNumber | type) == "number" and
      .panelWindowNumber >= 1 and .panelWindowNumber <= 4294967295 and
      (.panelLayer | type) == "number" and
      .panelLayer >= -2147483648 and .panelLayer <= 2147483647 and
      (.panelTitle | type) == "string" and (.panelTitle | length) > 0 and
      (.selectedPath | type) == "string" and
      (.selectedPath | startswith("/"))
    ' "$ready_path" >/dev/null; then
    echo "Open-panel ready artifact violated its exact owner-only schema: $ready_path" >&2
    return 1
  fi

  OPEN_PANEL_READY_TOKEN="$(jq -r '.launchToken' "$ready_path")"
  OPEN_PANEL_READY_PID="$(jq -r '.targetPID' "$ready_path")"
  OPEN_PANEL_READY_APP_PATH="$(jq -r '.appPath' "$ready_path")"
  OPEN_PANEL_READY_WINDOW_NUMBER="$(jq -r '.panelWindowNumber' "$ready_path")"
  OPEN_PANEL_READY_WINDOW_LAYER="$(jq -r '.panelLayer' "$ready_path")"
  OPEN_PANEL_READY_WINDOW_TITLE="$(jq -r '.panelTitle' "$ready_path")"
  OPEN_PANEL_READY_SELECTED_PATH="$(jq -r '.selectedPath' "$ready_path")"
  if [[ ! "$OPEN_PANEL_READY_TOKEN" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]] ||
    [[ ! -f "$OPEN_PANEL_READY_SELECTED_PATH" || -L "$OPEN_PANEL_READY_SELECTED_PATH" ]] ||
    [[ "$OPEN_PANEL_READY_WINDOW_TITLE" == *$'\n'* ||
      "$OPEN_PANEL_READY_WINDOW_TITLE" == *$'\r'* ]]; then
    echo "Open-panel ready artifact contained an invalid exact identity" >&2
    return 1
  fi
  open_panel_app_ready_identity_matches \
    "$OPEN_PANEL_READY_PID" \
    "$OPEN_PANEL_READY_APP_PATH" \
    "$OPEN_PANEL_READY_WINDOW_NUMBER" \
    "$OPEN_PANEL_READY_WINDOW_TITLE" \
    "$OPEN_PANEL_READY_WINDOW_LAYER"
}

assert_open_panel_completion() {
  local completion_path="$1"
  local token="$2"
  local helper_pid="$3"
  local target_pid="$4"
  local window_number="$5"
  local selected_path="$6"
  local interaction_label="$7"

  [[ -f "$completion_path" && ! -L "$completion_path" ]] &&
    [[ "$(stat -f '%Lp' "$completion_path" 2>/dev/null || printf '0')" == "600" ]] &&
    jq -e \
      --arg token "$token" \
      --argjson helper_pid "$helper_pid" \
      --argjson target_pid "$target_pid" \
      --argjson window_number "$window_number" \
      --arg selected_path "$selected_path" \
      --arg interaction_label "$interaction_label" '
        keys == [
          "buttonTitle", "helperPID", "interactionLabel", "launchToken",
          "leftButtonUp", "panelWindowNumber", "schemaVersion", "selectedPath",
          "source", "status", "targetPID"
        ] and
        .schemaVersion == 1 and
        .status == "complete" and
        .launchToken == $token and
        .helperPID == $helper_pid and
        .targetPID == $target_pid and
        .panelWindowNumber == $window_number and
        .selectedPath == $selected_path and
        .interactionLabel == $interaction_label and
        (.buttonTitle == "打开" or .buttonTitle == "Open") and
        .source == "cghidEventTap" and
        .leftButtonUp == true
      ' "$completion_path" >/dev/null
}

run_open_panel_helper() {
  local ready_path="$1"
  local completion_path="$2"
  local evidence_dir="$3"
  local ledger_path="$evidence_dir/ledger.tsv"
  local stdout_path="$evidence_dir/stdout.log"
  local stderr_path="$evidence_dir/stderr.log"
  local launch_path="$evidence_dir/open.log"
  local observer_log_path="$evidence_dir/exit-observer.log"
  local observer_gate_path="$evidence_dir/exit-observer-gate.txt"
  local exit_result_path="$evidence_dir/exit-status.txt"
  local helper_pid live_pids activation_detail argument_detail

  if [[ "$helper_requested" != "1" || ! -x "$helper_executable_path" ]] ||
    ! codesign --verify --deep --strict "$helper_bundle" >/dev/null 2>&1; then
    echo "Open-panel exercise lacks its verified signed Helper bundle" >&2
    return 1
  fi
  if [[ -e "$completion_path" || -L "$completion_path" ||
    "$ready_path" != /* || "$completion_path" != /* || "$evidence_dir" != /* ]]; then
    echo "Open-panel Helper received an invalid fresh protocol boundary" >&2
    return 1
  fi
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if [[ -n "$live_pids" ]]; then
    echo "Open-panel Helper refuses live Helper overlap: $live_pids" >&2
    return 1
  fi
  if [[ -e "$evidence_dir" || -L "$evidence_dir" ]] ||
    ! mkdir -m 700 "$evidence_dir"; then
    echo "Open-panel Helper evidence directory was not fresh owner-only" >&2
    return 1
  fi
  : >"$stdout_path"
  : >"$stderr_path"
  : >"$launch_path"
  : >"$observer_log_path"

  active_native_command_helper_pid=""
  active_native_command_helper_token="$OPEN_PANEL_READY_TOKEN"
  active_native_command_helper_mode="e2e-open-panel"
  if ! /usr/bin/open \
    -n \
    -g \
    --stdout "$stdout_path" \
    --stderr "$stderr_path" \
    "$PWD/$helper_bundle" \
    --args \
    --mode e2e-open-panel \
    --ledger "$ledger_path" \
    --launch-token "$OPEN_PANEL_READY_TOKEN" \
    --start-gate "$observer_gate_path" \
    --ready "$ready_path" \
    --completion "$completion_path" \
    >"$launch_path" 2>&1; then
    echo "LaunchServices rejected the Open-panel Helper launch" >&2
    return 1
  fi
  if [[ -s "$launch_path" ]] ||
    ! wait_for_native_command_helper_process_record \
      "$ledger_path" \
      "$OPEN_PANEL_READY_TOKEN" \
      "e2e-open-panel"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path"
    return 1
  fi
  helper_pid="$NATIVE_COMMAND_HELPER_PID"
  active_native_command_helper_pid="$helper_pid"
  if ! start_helper_exit_observer_process \
    "e2e-open-panel" \
    "$helper_pid" \
    "$OPEN_PANEL_READY_TOKEN" \
    "$observer_gate_path" \
    "$exit_result_path" \
    "$observer_log_path" \
    30 \
    "$repo_root/scripts/dmg-install-exit-observer.swift" ||
    ! wait_for_helper_observer_gate \
      "e2e-open-panel" \
      "$helper_pid" \
      "$OPEN_PANEL_READY_TOKEN" \
      "$observer_gate_path" \
      "$exit_result_path" ||
    ! wait_for_helper_exit_result \
      "$helper_pid" \
      "e2e-open-panel" \
      "$OPEN_PANEL_READY_TOKEN" \
      "$exit_result_path"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stderr_path" "$observer_log_path" "$exit_result_path"
    return 1
  fi
  if ! helper_exit_result_matches \
    "$exit_result_path" \
    "e2e-open-panel" \
    "$helper_pid" \
    "$OPEN_PANEL_READY_TOKEN" ||
    [[ ! -s "$ledger_path" ]] || ! cmp -s "$ledger_path" "$stdout_path" ||
    [[ -s "$stderr_path" || -s "$launch_path" || -s "$observer_log_path" ]] ||
    grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1 ||
    ! dmg_harness_require_exact_steps "e2e-open-panel" "$ledger_path" ||
    ! dmg_harness_process_observer_evidence_matches \
      "e2e-open-panel" "$ledger_path" "$helper_pid" "$OPEN_PANEL_READY_TOKEN"; then
    echo "Open-panel Helper output or ordered ledger was invalid" >&2
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path" \
      "$observer_log_path" "$exit_result_path"
    return 1
  fi
  activation_detail="$(awk -F $'\t' '$3 == "activation" { print $4 }' "$ledger_path")"
  if ! dmg_harness_activation_evidence_matches \
    "$activation_detail" \
    "app.noonmark.mac.e2e" \
    "$OPEN_PANEL_READY_APP_PATH" \
    "$OPEN_PANEL_READY_PID"; then
    echo "Open-panel Helper activation evidence was invalid" >&2
    return 1
  fi
  argument_detail="mode=e2e-open-panel pid=$OPEN_PANEL_READY_PID app=$OPEN_PANEL_READY_APP_PATH window_number=$OPEN_PANEL_READY_WINDOW_NUMBER window=$OPEN_PANEL_READY_WINDOW_TITLE ready=$ready_path completion=$completion_path"
  if ! awk -F $'\t' -v detail="$argument_detail" '
    NR == 1 && $2 == "PASS" && $3 == "arguments" && $4 == detail { found = 1 }
    END { exit !found }
  ' "$ledger_path" ||
    ! assert_open_panel_completion \
      "$completion_path" \
      "$OPEN_PANEL_READY_TOKEN" \
      "$helper_pid" \
      "$OPEN_PANEL_READY_PID" \
      "$OPEN_PANEL_READY_WINDOW_NUMBER" \
      "$OPEN_PANEL_READY_SELECTED_PATH" \
      "$(jq -r '.interactionLabel' "$ready_path")"; then
    echo "Open-panel Helper completion did not bind the exact ready payload" >&2
    return 1
  fi
  for _ in {1..160}; do
    if ! kill -0 "$helper_pid" 2>/dev/null; then break; fi
    sleep 0.025
  done
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if kill -0 "$helper_pid" 2>/dev/null || [[ -n "$live_pids" ]]; then
    echo "Open-panel Helper remained after verified exit: ${live_pids:-$helper_pid}" >&2
    return 1
  fi
  active_native_command_helper_pid=""
  active_native_command_helper_token=""
  active_native_command_helper_mode=""
}

drive_open_panel_helpers() {
  local launcher_pid="$1"
  local result_path="$2"
  local protocol_directory="$3"
  local evidence_root="$4"
  shift 4
  local interaction_label ready_path completion_path

  if [[ -e "$evidence_root" || -L "$evidence_root" ]] ||
    ! mkdir -m 700 "$evidence_root"; then
    echo "external Open-panel evidence root was not fresh owner-only" >&2
    return 1
  fi

  for interaction_label in "$@"; do
    if [[ ! "$interaction_label" =~ ^[a-z0-9-]+$ ]]; then
      echo "external Open-panel interaction label was invalid" >&2
      return 1
    fi
    ready_path="$protocol_directory/${interaction_label}.ready.json"
    completion_path="$protocol_directory/${interaction_label}.completion.json"
    for _ in {1..1600}; do
      if [[ -f "$ready_path" || -f "$result_path" ]] ||
        ! kill -0 "$launcher_pid" 2>/dev/null; then
        break
      fi
      sleep 0.025
    done
    if [[ ! -f "$ready_path" ]] ||
      ! parse_open_panel_ready "$ready_path" "$interaction_label" ||
      ! run_open_panel_helper \
        "$ready_path" \
        "$completion_path" \
        "$evidence_root/$interaction_label"; then
      echo "external Open-panel interaction failed: $interaction_label" >&2
      return 1
    fi
  done
}

diagnostic_control_directory_is_owner_only() {
  local directory="$1"
  local expected_parent="$2"

  [[ "${directory%/*}" == "$expected_parent" &&
    -d "$directory" && ! -L "$directory" &&
    "$(stat -f '%Lp' "$directory")" == "700" &&
    "$(stat -f '%u' "$directory")" == "$(id -u)" ]]
}

run_diagnostic_export_helper() {
  local target_pid="$1"
  local target_app_path="$2"
  local window_number="$3"
  local window_title="$4"
  local token="$5"
  local database_path="$6"
  local repository_lock_path="$7"
  local export_path="$8"
  local sentinels_path="$9"
  local ledger_path="${10}"
  local observer_gate_path="${11}"
  local evidence_dir="${ledger_path%/*}"
  local stdout_path="$evidence_dir/stdout.log"
  local stderr_path="$evidence_dir/stderr.log"
  local launch_path="$evidence_dir/open.log"
  local observer_log_path="$evidence_dir/exit-observer.log"
  local exit_result_path="$evidence_dir/exit-status.txt"
  local helper_pid=""
  local live_pids=""
  local diagnostic_lock_before=""
  local diagnostic_lock_after=""
  local diagnostic_lock_holder_exit=""
  local activation_detail=""

  if [[ "$helper_requested" != "1" || ! -x "$helper_executable_path" ]] ||
    ! codesign --verify --deep --strict "$helper_bundle" >/dev/null 2>&1; then
    echo "diagnostic export lacks its verified signed Helper bundle" >&2
    return 1
  fi
  if [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ||
    ! "$target_pid" =~ ^[1-9][0-9]*$ ||
    ! "$window_number" =~ ^[1-9][0-9]*$ ||
    "$target_app_path" != /* || "$database_path" != /* ||
    "$repository_lock_path" != /* || "$export_path" != /* ||
    "$sentinels_path" != /* || "$ledger_path" != /* ||
    "$observer_gate_path" != /* ||
    "${observer_gate_path%/*}" != "$evidence_dir" ||
    "${evidence_dir%/*}" != "${export_path%/*}" ||
    -e "$export_path" || -L "$export_path" ]]; then
    echo "diagnostic export Helper received an invalid controlled boundary" >&2
    return 1
  fi
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if [[ -n "$live_pids" ]]; then
    echo "diagnostic export refuses live Helper overlap: $live_pids" >&2
    return 1
  fi

  if [[ -e "$evidence_dir" || -L "$evidence_dir" ]] ||
    ! mkdir -m 700 "$evidence_dir" ||
    ! diagnostic_control_directory_is_owner_only \
      "$evidence_dir" \
      "${export_path%/*}"; then
    echo "diagnostic export Helper control directory was not fresh owner-only" >&2
    return 1
  fi
  rm -f \
    "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path" \
    "$observer_log_path" "$observer_gate_path" "$exit_result_path"
  : >"$stdout_path"
  : >"$stderr_path"
  : >"$launch_path"
  : >"$observer_log_path"
  active_native_command_helper_pid=""
  active_native_command_helper_token="$token"
  active_native_command_helper_mode="diagnostic-export"

  if ! /usr/bin/open \
    -n \
    -g \
    --stdout "$stdout_path" \
    --stderr "$stderr_path" \
    "$PWD/$helper_bundle" \
    --args \
    --mode diagnostic-export \
    --ledger "$ledger_path" \
    --launch-token "$token" \
    --start-gate "$observer_gate_path" \
    --pid "$target_pid" \
    --app-path "$target_app_path" \
    --window-number "$window_number" \
    --window-title "$window_title" \
    --target-profile e2e \
    --database "$database_path" \
    --repository-lock "$repository_lock_path" \
    --export-path "$export_path" \
    --sentinels "$sentinels_path" \
    >"$launch_path" 2>&1; then
    echo "LaunchServices rejected the diagnostic export Helper" >&2
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path"
    return 1
  fi
  if [[ -s "$launch_path" ]] ||
    ! wait_for_native_command_helper_process_record \
      "$ledger_path" \
      "$token" \
      "diagnostic-export"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path"
    return 1
  fi
  helper_pid="$NATIVE_COMMAND_HELPER_PID"
  active_native_command_helper_pid="$helper_pid"
  if ! start_helper_exit_observer_process \
    "diagnostic-export" \
    "$helper_pid" \
    "$token" \
    "$observer_gate_path" \
    "$exit_result_path" \
    "$observer_log_path" \
    45 \
    "$repo_root/scripts/dmg-install-exit-observer.swift" ||
    ! wait_for_helper_observer_gate \
      "diagnostic-export" \
      "$helper_pid" \
      "$token" \
      "$observer_gate_path" \
      "$exit_result_path" ||
    ! wait_for_helper_exit_result \
      "$helper_pid" \
      "diagnostic-export" \
      "$token" \
      "$exit_result_path"; then
    dump_native_command_helper_evidence \
      "$ledger_path" "$stderr_path" "$observer_log_path" "$exit_result_path"
    return 1
  fi
  if ! helper_exit_result_matches \
    "$exit_result_path" \
    "diagnostic-export" \
    "$helper_pid" \
    "$token"; then
    echo "diagnostic export Helper did not expose one normal kernel exit" >&2
    return 1
  fi
  diagnostic_lock_before="$(
    awk -F $'\t' \
      '$3 == "diagnostic-locks-before-export" { print $4 }' \
      "$ledger_path" 2>/dev/null || true
  )"
  diagnostic_lock_after="$(
    awk -F $'\t' \
      '$3 == "diagnostic-locks-after-export" { print $4 }' \
      "$ledger_path" 2>/dev/null || true
  )"
  diagnostic_lock_holder_exit="$(
    awk -F $'\t' \
      '$3 == "diagnostic-lock-holder-exit" { print $4 }' \
      "$ledger_path" 2>/dev/null || true
  )"
  activation_detail="$(
    awk -F $'\t' '$3 == "activation" { print $4 }' \
      "$ledger_path" 2>/dev/null || true
  )"
  if [[ ! -s "$ledger_path" ]] || ! cmp -s "$ledger_path" "$stdout_path" ||
    [[ -s "$stderr_path" || -s "$launch_path" || -s "$observer_log_path" ]] ||
    grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1 ||
    ! dmg_harness_require_exact_steps "diagnostic-export" "$ledger_path" ||
    ! dmg_harness_process_observer_evidence_matches \
      "diagnostic-export" "$ledger_path" "$helper_pid" "$token" ||
    ! dmg_harness_activation_evidence_matches \
      "$activation_detail" \
      "app.noonmark.mac.e2e" \
      "$target_app_path" \
      "$target_pid" ||
    ! diagnostic_lock_evidence_set_matches \
      "$diagnostic_lock_before" \
      "$diagnostic_lock_after" \
      "$diagnostic_lock_holder_exit" \
      "$target_pid" ||
    ! awk -F $'\t' \
      -v app="$target_app_path" '
        NR == 6 && index($4, "bundle=app.noonmark.mac.e2e path=" app " frontmost=true windows=") != 1 { exit 1 }
        NR == 13 && index($4, "schema=1 bytes=") != 1 { exit 1 }
        NR == 15 && $4 != "mode=diagnostic-export" { exit 1 }
        END { exit !(NR == 15) }
      ' "$ledger_path"; then
    echo "diagnostic export Helper evidence was incomplete or out of order" >&2
    dump_native_command_helper_evidence \
      "$ledger_path" "$stdout_path" "$stderr_path" "$launch_path" \
      "$observer_log_path" "$exit_result_path"
    return 1
  fi
  for _ in {1..160}; do
    if ! kill -0 "$helper_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  live_pids="$(pgrep -x "$helper_process_name" 2>/dev/null || true)"
  if kill -0 "$helper_pid" 2>/dev/null || [[ -n "$live_pids" ]]; then
    echo "diagnostic export Helper remained after verified exit" >&2
    return 1
  fi
  if ! diagnostic_control_directory_is_owner_only \
    "$evidence_dir" \
    "${export_path%/*}"; then
    echo "diagnostic export Helper control directory changed identity" >&2
    return 1
  fi
  active_native_command_helper_pid=""
  active_native_command_helper_token=""
  active_native_command_helper_mode=""
}

run_native_command_surface_exercise() {
  local label="$1"
  local result="$2"
  local log="$3"
  local ready_path="$4"
  local helper_evidence_dir="$5"
  local expected_menu_title="$6"
  local expected_menu_item_title="$7"
  local completion_path="${ready_path%/*}/help-completion.txt"
  local token launcher_pid app_pid app_exit_status=0
  shift 7

  rm -f "$result" "$ready_path" "$completion_path"
  rm -rf "$helper_evidence_dir"
  if [[ -n "$(pgrep -x "$helper_process_name" 2>/dev/null || true)" ]]; then
    echo "$label refused to start while a Helper process was already live" >&2
    return 1
  fi
  token="$(uuidgen)"
  if [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "$label could not create one valid Help command token" >&2
    return 1
  fi
  /usr/bin/open -W -n "$app_path" --args \
    "$@" \
    --e2e-native-command-help-ready-url "$PWD/$ready_path" \
    --e2e-native-command-help-completion-url "$PWD/$completion_path" \
    --e2e-native-command-help-token "$token" \
    >"$log" 2>&1 &
  launcher_pid=$!

  for _ in {1..1200}; do
    if [[ -f "$ready_path" || -f "$result" ]] ||
      ! kill -0 "$launcher_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  if [[ ! -f "$ready_path" ]] ||
    ! parse_native_command_help_ready \
      "$ready_path" \
      "$token" \
      "$expected_menu_title" \
      "$expected_menu_item_title"; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$launcher_pid" 2>/dev/null || true
    echo "$label did not publish one valid Help-ready boundary" >&2
    [[ -f "$result" ]] && cat "$result" >&2
    cat "$log" >&2
    return 1
  fi
  app_pid="$NATIVE_COMMAND_READY_PID"

  if ! run_native_command_menu_helper \
    "$NATIVE_COMMAND_READY_PID" \
    "$NATIVE_COMMAND_READY_APP_PATH" \
    "$NATIVE_COMMAND_READY_WINDOW_NUMBER" \
    "$NATIVE_COMMAND_READY_WINDOW_TITLE" \
    "$NATIVE_COMMAND_READY_MENU_TITLE" \
    "$NATIVE_COMMAND_READY_MENU_ITEM_TITLE" \
    "$token" \
    "$PWD/$completion_path" \
    "$helper_evidence_dir"; then
    cleanup_native_command_helper >/dev/null 2>&1 || true
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$launcher_pid" 2>/dev/null || true
    echo "$label external Help selection failed" >&2
    [[ -f "$result" ]] && cat "$result" >&2
    cat "$log" >&2
    return 1
  fi

  # Helper result, kernel exit, and absence are authoritative before the App
  # result is observed. This prevents an App-side window check from masking a
  # failed, duplicated, or lingering physical input sender.
  for _ in {1..1600}; do
    if [[ -f "$result" ]] || ! kill -0 "$launcher_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  if [[ ! -f "$result" || "$(<"$result")" != "ok" ]]; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$launcher_pid" 2>/dev/null || true
    echo "$label App result failed: $([[ -f "$result" ]] && cat "$result" || printf 'missing')" >&2
    cat "$log" >&2
    return 1
  fi
  for _ in {1..160}; do
    if ! kill -0 "$launcher_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  if kill -0 "$launcher_pid" 2>/dev/null; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$launcher_pid" 2>/dev/null || true
    echo "$label wrote ok but its LaunchServices wait did not terminate" >&2
    cat "$log" >&2
    return 1
  fi
  wait "$launcher_pid" || app_exit_status=$?
  if [[ "$app_exit_status" != "0" ]]; then
    echo "$label App process failed with status $app_exit_status" >&2
    cat "$log" >&2
    return 1
  fi
  if kill -0 "$app_pid" 2>/dev/null; then
    echo "$label App process remained after its successful result" >&2
    return 1
  fi
  assert_clean_app_log "$label" "$log"
}

diagnostic_closure_app_process_matches() {
  local pid="$1"
  local token="$2"
  local mode="$3"
  local database_path="$4"
  local sync_root="$5"
  local command_line=""

  if [[ ! "$pid" =~ ^[1-9][0-9]*$ ||
    ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ||
    "$mode" != "seed-failure" && "$mode" != "stall" && "$mode" != "restart" ||
    "$database_path" != /* || "$sync_root" != /* ]]; then
    return 2
  fi
  if ! command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"; then
    return 1
  fi
  [[ "$command_line" == "$PWD/$app_executable_path "* ]] &&
    [[ " $command_line " == *" --e2e-diagnostic-evidence-$mode "* ]] &&
    [[ " $command_line " == *" --e2e-diagnostic-evidence-launch-token $token "* ]] &&
    [[ " $command_line " == *" --data-url $database_path "* ]] &&
    [[ " $command_line " == *" --sync-folder-url $sync_root "* ]]
}

wait_for_diagnostic_closure_app_process_identity() {
  local pid="$1"
  local token="$2"
  local mode="$3"
  local database_path="$4"
  local sync_root="$5"
  local match_status=0
  local process_state="exited"
  local observed_command=""

  for _ in {1..200}; do
    if diagnostic_closure_app_process_matches \
      "$pid" "$token" "$mode" "$database_path" "$sync_root"; then
      return 0
    else
      match_status=$?
    fi
    if [[ "$match_status" == "2" ]]; then
      return 2
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  if kill -0 "$pid" 2>/dev/null; then
    process_state="live"
  fi
  observed_command="$(ps -ww -p "$pid" -o command= 2>/dev/null || true)"
  printf \
    'diagnostic App process identity was not ready: mode=%s pid=%s process_state=%s observed_command=%q\n' \
    "$mode" "$pid" "$process_state" "$observed_command" >&2
  return 1
}

run_diagnostic_evidence_closure_probe() {
  local closure_dir="artifacts/e2e-diagnostic-closure"
  local closure_root="$PWD/$closure_dir"
  local scope_manifest="$closure_root/diagnostic-export-scope.tsv"
  local scope_stderr="$closure_root/diagnostic-export-scope.stderr.log"
  local scope_application=""
  local database=""
  local repository_lock=""
  local sync_root=""
  local export_path=""
  local sentinels=""
  local diagnostic_ledger=""
  local diagnostic_start_gate=""
  local state="$PWD/$closure_dir/state.json"
  local seed_result="$PWD/$closure_dir/seed-result.txt"
  local stall_result="$PWD/$closure_dir/stall-result.txt"
  local restart_result="$PWD/$closure_dir/restart-result.txt"
  local lock_holder_source="$PWD/scripts/e2e-repository-lock-holder.swift"
  local lock_holder_binary="$PWD/$closure_dir/repository-lock-holder"
  local lock_holder_ready="$PWD/$closure_dir/repository-lock-holder.ready"
  local lock_holder_log="$PWD/$closure_dir/repository-lock-holder.log"
  local window_title="晷迹 · Day Todo — 7月5日"
  local restart_window_identity_directory=""
  local restart_window_identity_path=""
  local scope_temp=""
  local seed_token stall_token restart_token helper_token lock_token
  local seed_pid stall_pid restart_pid lock_pid window_number
  local scope_status=0 seed_status=0 stall_status=0 restart_status=0
  local lock_status=0
  local failed_operation_id failed_incident_id stalled_operation_id
  local mutation_incident_id

  rm -rf "$closure_dir"
  mkdir -p "$closure_dir"
  scope_temp="$(mktemp "$closure_root/.diagnostic-export-scope.XXXXXX")"
  : >"$scope_stderr"
  chmod 600 "$scope_temp" "$scope_stderr"
  set +e
  "$helper_executable_path" \
    --mode diagnostic-export-scope \
    --app-path "$PWD/$app_path" \
    --target-profile e2e \
    >"$scope_temp" \
    2>"$scope_stderr"
  scope_status=$?
  set -e
  if [[ "$scope_status" -ne 0 || -s "$scope_stderr" ]] ||
    ! diagnostic_scope_manifest_validate "$scope_temp" e2e; then
    echo "diagnostic closure scope emitter failed its strict schema" >&2
    sed -n '1,120p' "$scope_stderr" >&2
    rm -f "$scope_temp"
    return 1
  fi
  mv "$scope_temp" "$scope_manifest"
  if ! scope_application="$(
      diagnostic_scope_manifest_value "$scope_manifest" application
    )" ||
    ! database="$(
      diagnostic_scope_manifest_value "$scope_manifest" database
    )" ||
    ! repository_lock="$(
      diagnostic_scope_manifest_value "$scope_manifest" repository_lock
    )" ||
    ! export_path="$(
      diagnostic_scope_manifest_value "$scope_manifest" export
    )" ||
    ! sentinels="$(
      diagnostic_scope_manifest_value "$scope_manifest" sentinels
    )" ||
    ! diagnostic_ledger="$(
      diagnostic_scope_manifest_value "$scope_manifest" ledger
    )" ||
    ! diagnostic_start_gate="$(
      diagnostic_scope_manifest_value "$scope_manifest" start_gate
    )"; then
    echo "diagnostic closure could not read its canonical scope" >&2
    return 1
  fi
  sync_root="${repository_lock%/*}"
  if [[ "$scope_application" != "$PWD/$app_path" ||
    "${database%/*}" != "$closure_root" ||
    "${sync_root%/*}" != "$closure_root" ||
    "${export_path%/*}" != "$closure_root" ||
    "${sentinels%/*}" != "$closure_root" ||
    "${diagnostic_ledger%/*}" != "${diagnostic_start_gate%/*}" ||
    "${diagnostic_ledger%/*/*}" != "$closure_root" ||
    "$helper_binary_sha256_before" != \
      "$(shasum -a 256 "$helper_executable_path" | awk '{print $1}')" ]]; then
    echo "diagnostic closure scope escaped its captured helper boundary" >&2
    return 1
  fi
  printf 'this path is intentionally not a directory\n' >"$sync_root"
  seed_token="$(uuidgen)"
  "$PWD/$app_executable_path" \
    --data-url "$database" \
    --sync-folder-url "$sync_root" \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-diagnostic-evidence-seed-failure \
    --e2e-diagnostic-evidence-state-url "$state" \
    --e2e-diagnostic-evidence-result-url "$seed_result" \
    --e2e-diagnostic-evidence-launch-token "$seed_token" \
    >"$closure_dir/seed-app.log" 2>&1 &
  seed_pid=$!
  if ! wait_for_diagnostic_closure_app_process_identity \
    "$seed_pid" "$seed_token" "seed-failure" "$database" "$sync_root"; then
    echo "diagnostic seed App identity did not match its exact launch" >&2
    return 1
  fi
  for _ in {1..600}; do
    if [[ -f "$seed_result" ]] || ! kill -0 "$seed_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ ! -f "$seed_result" ||
    "$(<"$seed_result")" != "ok: seed failure persisted" ]]; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$seed_pid" 2>/dev/null || true
    echo "diagnostic seed failure session did not converge" >&2
    [[ -f "$seed_result" ]] && cat "$seed_result" >&2
    cat "$closure_dir/seed-app.log" >&2
    return 1
  fi
  if wait "$seed_pid"; then seed_status=0; else seed_status=$?; fi
  if [[ "$seed_status" != "0" || ! -s "$state" ]]; then
    echo "diagnostic seed App did not exit cleanly with durable state" >&2
    return 1
  fi

  rm -f "$sync_root"
  mkdir -p "$sync_root"
  xcrun swiftc "$lock_holder_source" -o "$lock_holder_binary"
  lock_token="$(uuidgen)"
  "$lock_holder_binary" \
    "$repository_lock" \
    "$lock_holder_ready" \
    "$lock_token" \
    >"$lock_holder_log" 2>&1 &
  lock_pid=$!
  for _ in {1..200}; do
    if [[ -f "$lock_holder_ready" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
      break
    fi
    sleep 0.025
  done
  if [[ ! -f "$lock_holder_ready" ]] ||
    ! awk -v pid="$lock_pid" -v token="$lock_token" -v lock="$repository_lock" '
      NR == 1 { valid += ($0 == "status=ready") }
      NR == 2 { valid += ($0 == "pid=" pid) }
      NR == 3 { valid += ($0 == "token=" token) }
      NR == 4 { valid += ($0 == "lock=" lock) }
      END { exit !(NR == 4 && valid == 4) }
    ' "$lock_holder_ready" ||
    [[ "$(ps -ww -p "$lock_pid" -o command= 2>/dev/null)" != \
      "$lock_holder_binary $repository_lock $lock_holder_ready $lock_token" ]]; then
    kill -TERM "$lock_pid" 2>/dev/null || true
    wait "$lock_pid" 2>/dev/null || true
    echo "external sync-lock holder did not publish its exact identity" >&2
    cat "$lock_holder_log" >&2
    return 1
  fi

  stall_token="$(uuidgen)"
  "$PWD/$app_executable_path" \
    --data-url "$database" \
    --sync-folder-url "$sync_root" \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-diagnostic-evidence-stall \
    --e2e-diagnostic-evidence-state-url "$state" \
    --e2e-diagnostic-evidence-result-url "$stall_result" \
    --e2e-diagnostic-evidence-launch-token "$stall_token" \
    >"$closure_dir/stall-app.log" 2>&1 &
  stall_pid=$!
  if ! wait_for_diagnostic_closure_app_process_identity \
    "$stall_pid" "$stall_token" "stall" "$database" "$sync_root"; then
    echo "diagnostic stalled App identity did not match its exact launch" >&2
    return 1
  fi
  for _ in {1..600}; do
    if [[ -f "$stall_result" ]] || ! kill -0 "$stall_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ ! -f "$stall_result" ||
    "$(<"$stall_result")" != "ready: stalled sync and rejected mutation" ]] ||
    ! diagnostic_closure_app_process_matches \
      "$stall_pid" "$stall_token" "stall" "$database" "$sync_root"; then
    terminate_e2e_app >/dev/null 2>&1 || true
    kill -TERM "$lock_pid" 2>/dev/null || true
    wait "$stall_pid" 2>/dev/null || true
    wait "$lock_pid" 2>/dev/null || true
    echo "diagnostic stalled App did not reach its durable interruption boundary" >&2
    [[ -f "$stall_result" ]] && cat "$stall_result" >&2
    cat "$closure_dir/stall-app.log" >&2
    return 1
  fi
  if ! kill -KILL "$stall_pid"; then
    echo "could not interrupt the exact diagnostic E2E App" >&2
    return 1
  fi
  if wait "$stall_pid"; then stall_status=0; else stall_status=$?; fi
  if [[ "$stall_status" != "137" ]]; then
    echo "diagnostic E2E interruption was not exact SIGKILL: $stall_status" >&2
    return 1
  fi
  if [[ "$(ps -ww -p "$lock_pid" -o command= 2>/dev/null)" != \
    "$lock_holder_binary $repository_lock $lock_holder_ready $lock_token" ]]; then
    echo "refusing to release an unverified repository lock holder" >&2
    return 1
  fi
  kill -TERM "$lock_pid"
  if wait "$lock_pid"; then lock_status=0; else lock_status=$?; fi
  if [[ "$lock_status" != "143" && "$lock_status" != "0" ]]; then
    echo "repository lock holder exited unexpectedly: $lock_status" >&2
    return 1
  fi

  failed_operation_id="$(jq -er '.failedOperationID' "$state")"
  failed_incident_id="$(jq -er '.failedIncidentID' "$state")"
  stalled_operation_id="$(jq -er '.stalledOperationID' "$state")"
  mutation_incident_id="$(jq -er '.mutationIncidentID' "$state")"
  if [[ ! "$failed_operation_id" =~ ^[0-9A-F-]{36}$ ||
    ! "$failed_incident_id" =~ ^[0-9A-F-]{36}$ ||
    ! "$stalled_operation_id" =~ ^[0-9A-F-]{36}$ ||
    ! "$mutation_incident_id" =~ ^[0-9A-F-]{36}$ ||
    "$failed_operation_id" == "$stalled_operation_id" ||
    "$failed_incident_id" == "$mutation_incident_id" ]]; then
    echo "diagnostic closure lost distinct seed and current correlations" >&2
    return 1
  fi

  printf '%s\n' \
    'E2E_PRIVATE_TASK_CONTENT_MUST_NOT_ENTER_DIAGNOSTICS_8D31A6' \
    "$database" \
    "$sync_root" \
    'sk-private-e2e-credential-9927' \
    'diagnostic-private-person@example.test' \
    'https://secret.example.test/private/path?token=9927' \
    '192.0.2.147' \
    'RUUyRV9QUklWQVRFX0JBU0U2NF9TRU5USU5FTA==' \
    >"$sentinels"
  restart_token="$(uuidgen)"
  if [[ ! "$restart_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "diagnostic restart could not create a canonical window identity token" >&2
    return 1
  fi
  restart_window_identity_directory="$PWD/$closure_dir/.main-window-identity-$restart_token"
  restart_window_identity_path="$restart_window_identity_directory/main-window-identity.json"
  mkdir -m 700 -- "$restart_window_identity_directory"
  "$PWD/$app_executable_path" \
    --data-url "$database" \
    --sync-folder-url "$sync_root" \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-diagnostic-evidence-restart \
    --e2e-diagnostic-evidence-state-url "$state" \
    --e2e-diagnostic-evidence-result-url "$restart_result" \
    --e2e-diagnostic-evidence-export-url "$export_path" \
    --e2e-diagnostic-evidence-launch-token "$restart_token" \
    --e2e-main-window-identity-url "$restart_window_identity_path" \
    --e2e-main-window-launch-token "$restart_token" \
    >"$closure_dir/restart-app.log" 2>&1 &
  restart_pid=$!
  if ! wait_for_diagnostic_closure_app_process_identity \
    "$restart_pid" "$restart_token" "restart" "$database" "$sync_root"; then
    echo "diagnostic restart App identity did not match its exact launch" >&2
    return 1
  fi
  for _ in {1..600}; do
    if [[ -f "$restart_result" ]] || ! kill -0 "$restart_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ ! -f "$restart_result" ||
    "$(<"$restart_result")" != "ready: restart evidence converged" ]]; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$restart_pid" 2>/dev/null || true
    echo "diagnostic restart App did not converge before UI export" >&2
    [[ -f "$restart_result" ]] && cat "$restart_result" >&2
    cat "$closure_dir/restart-app.log" >&2
    return 1
  fi
  window_number="$(
    resolve_exact_e2e_window_id \
      "$restart_window_identity_path" \
      "$restart_token" \
      "$restart_pid" \
      "$window_title" \
      "$expected_window_width" \
      "$expected_window_height"
  )"
  if [[ ! "$window_number" =~ ^[1-9][0-9]*$ ]] ||
    ! native_command_app_ready_identity_matches \
      "$restart_pid" \
      "$scope_application" \
      "$window_number" \
      "$window_title"; then
    echo "diagnostic restart main-window identity did not match" >&2
    dump_exact_e2e_window_evidence \
      "$restart_window_identity_path" \
      "$restart_token" \
      "$restart_pid" \
      "$window_title" \
      "$expected_window_width" \
      "$expected_window_height" >&2
    return 1
  fi
  helper_token="$(uuidgen)"
  if ! run_diagnostic_export_helper \
    "$restart_pid" \
    "$scope_application" \
    "$window_number" \
    "$window_title" \
    "$helper_token" \
    "$database" \
    "$repository_lock" \
    "$export_path" \
    "$sentinels" \
    "$diagnostic_ledger" \
    "$diagnostic_start_gate"; then
    terminate_e2e_app >/dev/null 2>&1 || true
    wait "$restart_pid" 2>/dev/null || true
    echo "diagnostic export UI/lock Helper failed" >&2
    return 1
  fi
  for _ in {1..200}; do
    if [[ "$(<"$restart_result")" == \
      "ok: restarted evidence exported through UI" ]] ||
      ! kill -0 "$restart_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ "$(<"$restart_result")" != \
    "ok: restarted evidence exported through UI" ]]; then
    echo "diagnostic restart App rejected its UI export" >&2
    cat "$restart_result" >&2
    return 1
  fi
  if wait "$restart_pid"; then restart_status=0; else restart_status=$?; fi
  if [[ "$restart_status" != "0" ]]; then
    echo "diagnostic restart App did not terminate cleanly: $restart_status" >&2
    return 1
  fi
  if ! jq -e \
    --arg failed_operation "$failed_operation_id" \
    --arg failed_incident "$failed_incident_id" \
    --arg stalled_operation "$stalled_operation_id" \
    --arg mutation_incident "$mutation_incident_id" '
      ([.operationCapsules[] | select(
        .operationID.rawValue == $failed_operation
        and .incidentID.rawValue == $failed_incident
        and .kind == "localFirstSync"
        and .endpoint == "localFolder"
        and .outcome == "failed"
      )] | length) == 1
      and ([.operationCapsules[] | select(
        .operationID.rawValue == $stalled_operation
        and .incidentID.rawValue == $mutation_incident
        and .kind == "localFirstSync"
        and .lastStage == "transportLockWait"
        and .outcome == "interrupted"
      )] | length) == 1
      and ([.records[] | select(
        .event.code == "previousSessionInterrupted"
        and .event.operationID.rawValue == $stalled_operation
        and .event.incidentID.rawValue == $mutation_incident
        and .event.stage == "transportLockWait"
      )] | length) == 1
      and ([.records[] | select(
        .event.code == "mutationRejected"
        and .event.operationID.rawValue == $stalled_operation
        and .event.incidentID.rawValue == $mutation_incident
        and .event.mutationContext == "task"
        and .event.mutationRejectionReason == "exclusiveOperationInProgress"
      )] | length) == 1
      and ([.records[] | select(
        .event.code == "persistedSyncFailureLoaded"
        and .event.operationID.rawValue == $stalled_operation
        and .event.incidentID.rawValue == $mutation_incident
      )] | length) >= 1
    ' "$export_path" >/dev/null; then
    echo "diagnostic export lost its exact cross-session evidence graph" >&2
    return 1
  fi
  if [[ "$(stat -f '%z' "$export_path")" -gt 8388608 ]] ||
    grep -F -f "$sentinels" "$export_path" >/dev/null 2>&1; then
    echo "diagnostic export violated capacity or privacy" >&2
    return 1
  fi
  assert_clean_app_log "diagnostic seed App" "$closure_dir/seed-app.log"
  assert_clean_app_log "diagnostic restart App" "$closure_dir/restart-app.log"
  echo "E2E diagnostic closure: failed-sync -> lock-wait -> rejected-mutation -> SIGKILL -> restart -> locked UI export"
}

run_terminating_ui_probe() {
  local label="$1"
  local result="$2"
  local log="$3"
  local pid
  local missing_result_process_state
  local missing_result_exit_status
  local protocol_directory="${NOONMARK_E2E_OPEN_PANEL_PROTOCOL_DIRECTORY:-}"
  local helper_evidence_root="${NOONMARK_E2E_OPEN_PANEL_HELPER_EVIDENCE_ROOT:-}"
  local interaction_labels="${NOONMARK_E2E_OPEN_PANEL_INTERACTIONS:-}"
  local -a interactions=()
  shift 3

  rm -f "$result"
  if [[ "${NOONMARK_E2E_LAUNCH_WITH_OPEN:-0}" == "1" ]]; then
    /usr/bin/open -W -n "$app_path" --args "$@" >"$log" 2>&1 &
  else
    "$app_executable_path" "$@" >"$log" 2>&1 &
  fi
  pid=$!

  if [[ -n "$protocol_directory" || -n "$helper_evidence_root" ||
    -n "$interaction_labels" ]]; then
    if [[ -z "$protocol_directory" || -z "$helper_evidence_root" ||
      -z "$interaction_labels" ||
      ! -d "$protocol_directory" || -L "$protocol_directory" ||
      "$(stat -f '%Lp' "$protocol_directory" 2>/dev/null || printf '0')" != "700" ||
      -e "$helper_evidence_root" || -L "$helper_evidence_root" ]]; then
      terminate_e2e_app
      wait "$pid" 2>/dev/null || true
      echo "$label had an invalid external Open-panel boundary" >&2
      exit 1
    fi
    read -r -a interactions <<<"$interaction_labels"
    if (( ${#interactions[@]} == 0 )) ||
      ! drive_open_panel_helpers \
        "$pid" \
        "$result" \
        "$protocol_directory" \
        "$helper_evidence_root" \
        "${interactions[@]}"; then
      cleanup_native_command_helper >/dev/null 2>&1 || true
      terminate_e2e_app
      wait "$pid" 2>/dev/null || true
      echo "$label external Open-panel protocol failed" >&2
      cat "$log" >&2
      exit 1
    fi
  fi

  for _ in {1..400}; do
    if [[ -f "$result" ]] || ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done

  if [[ ! -f "$result" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      missing_result_process_state="running"
      if ! terminate_e2e_app; then
        missing_result_process_state="running-termination-failed"
      fi
    else
      missing_result_process_state="exited"
    fi
    if kill -0 "$pid" 2>/dev/null; then
      missing_result_exit_status="unavailable-running"
    elif wait "$pid" 2>/dev/null; then
      missing_result_exit_status=0
    else
      missing_result_exit_status=$?
    fi
    echo "$label result was not created: $result (process_state=$missing_result_process_state exit_status=$missing_result_exit_status)" >&2
    cat "$log" >&2
    exit 1
  fi
  if [[ "$(<"$result")" != "ok" ]]; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label failed: $(<"$result")" >&2
    cat "$log" >&2
    exit 1
  fi

  for _ in {1..40}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label wrote ok but did not terminate" >&2
    cat "$log" >&2
    exit 1
  fi
  if ! wait "$pid"; then
    echo "$label app process failed" >&2
    cat "$log" >&2
    exit 1
  fi
  assert_clean_app_log "$label" "$log"
}

