  || -f "${zhulong_todo_diff_dir}/ZhulongSidecar/pending-application.zhj" ]]; then
  echo "zhulong Todo diff SQLite/journal crosscheck failed: tasks=$zhulong_todo_diff_task_count" >&2
  exit 1
fi

echo "E2E zhulong Todo diff edit/remove/split and atomic apply: $zhulong_todo_diff_result (tasks=$zhulong_todo_diff_task_count)"

review_zhulong_dir="artifacts/e2e-review-zhulong-entry"
