        for variant in ["A", "B", "C"]:
            motion_query = f"variant={variant}&scenario=long" + ("&demo=motion" if variant == "A" else "")
            self.navigate(motion_query)
            if variant == "A":
                demo_geometry = self.evaluate(
                    "(() => {const scroller=document.querySelector('[data-stream-scroll]');return {"
                    "ratio:scroller.scrollHeight/scroller.clientHeight,expanded:document.querySelectorAll('.activity-bundle.expanded').length,"
                    "label:document.querySelector('.page-header-copy p')?.innerText||''};})()"
                )
                self.check(
                    "motion-demo-exposes-at-least-three-viewports-of-real-stream",
                    demo_geometry["ratio"] >= 3
                    and demo_geometry["expanded"] >= 1
                    and "滚动轨迹演示" in demo_geometry["label"],
                    json.dumps(demo_geometry, ensure_ascii=False, sort_keys=True),
                )
            self.evaluate(
                "(() => {const scroller=document.querySelector('[data-stream-scroll]');"
                "scroller.style.scrollBehavior='auto';scroller.scrollTop=scroller.scrollHeight;return scroller.scrollTop;})()"
            )
            motion_snapshot = self.snapshot()
            active_before_motion = motion_snapshot["active"]
            previous_trace = self.trace_scroll_action(
                '.page-header [data-action="visit-previous"]',
                '[data-stream-node][data-state="current"]',
                '[data-stream-node].is-located',
                "new URLSearchParams(location.search).get('entry') && document.querySelectorAll('[data-stream-node].is-located').length===1",
            )
            self.assert_scroll_trace(
                f"variant-{variant.lower()}-visit-previous-has-continuous-upward-visual-track",
                previous_trace,
                "backward",
            )
            if variant == "A":
                final_motion_sample = previous_trace["samples"][-1]
                motion_distance = abs(float(final_motion_sample["motionTarget"]) - float(final_motion_sample["motionStart"]))
                self.check(
                    "motion-demo-actually-traverses-at-least-three-viewports",
                    motion_distance >= final_motion_sample["clientHeight"] * 3,
                    json.dumps({"distance": motion_distance, "clientHeight": final_motion_sample["clientHeight"]}, sort_keys=True),
                )
            self.check(
                f"variant-{variant.lower()}-visit-previous-motion-keeps-canonical-head",
                self.snapshot() == motion_snapshot
                and self.evaluate("document.querySelector('[data-stream-session]').dataset.activeNodeId") == active_before_motion,
            )
            return_trace = self.trace_scroll_action(
                '[data-action="return-current"]',
                '[data-stream-node].is-located',
                '[data-stream-node][data-state="current"]',
                "!new URLSearchParams(location.search).get('entry') && document.querySelectorAll('[data-stream-node].is-located').length===0",
            )
            self.assert_scroll_trace(
                f"variant-{variant.lower()}-return-current-has-continuous-downward-visual-track",
                return_trace,
                "forward",
                require_action_hit=True,
            )
            self.check(
                f"variant-{variant.lower()}-return-current-motion-keeps-canonical-head",
                self.snapshot() == motion_snapshot
                and self.evaluate("document.querySelector('[data-stream-session]').dataset.activeNodeId") == active_before_motion,
            )

        self.navigate("variant=C&scenario=long&demo=motion&menu-case=motion")
        self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');scroller.style.scrollBehavior='auto';"
            "scroller.scrollTop=scroller.scrollHeight;window.__motionMenuScroller=scroller;})()"
        )
        motion_menu_snapshot = self.snapshot()
        self.click('.page-header [data-action="visit-previous"]')
        self.wait_for(
            "document.querySelector('[data-stream-scroll]').dataset.scrollMotionState==='traveling'",
            "visit-previous motion before opening layout menu",
        )
        self.click('[data-layout-trigger]')
        self.check(
            "opening-layout-menu-does-not-cancel-an-active-scroll-trajectory",
            self.count('[data-layout-menu]') == 1
            and self.evaluate("document.querySelector('[data-stream-scroll]').dataset.scrollMotionState") == "traveling"
            and self.evaluate("document.querySelector('[data-stream-scroll]')===window.__motionMenuScroller"),
        )
        self.click('[data-layout-option][data-value="C"]')
        self.wait_for(
            "!document.querySelector('[data-layout-menu]')"
            " && Boolean(new URLSearchParams(location.search).get('entry'))"
            " && Boolean(document.querySelector('[data-stream-node].is-located'))"
            " && ['settled','idle'].includes(document.querySelector('[data-stream-scroll]').dataset.scrollMotionState)",
            "same-layout re-selection to let the original visit motion settle",
        )
        self.check(
            "reselecting-current-layout-keeps-navigation-intent-and-domain-state",
            self.snapshot() == motion_menu_snapshot
            and self.evaluate("document.querySelector('[data-stream-scroll]')===window.__motionMenuScroller")
            and self.count('[data-return-current].visible') == 1,
        )
        self.click('[data-action="return-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-scroll]').dataset.scrollMotionState==='traveling'",
            "return-current motion before changing layout",
        )
        self.click('[data-layout-trigger]')
        self.click('[data-layout-option][data-value="A"]')
        self.wait_for(
            "Boolean(document.querySelector('[data-variant-view=\"A\"]'))"
            " && document.querySelector('[data-stream-scroll]').dataset.scrollMotionState==='traveling'",
            "cross-layout switch to resume the return-current trajectory",
        )
        cross_layout_initial = self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');"
            "const sidebar=document.querySelector('.sidebar').getBoundingClientRect();const header=document.querySelector('.page-header').getBoundingClientRect();"
            "const rail=document.querySelector('.detail-rail').getBoundingClientRect();return {top:scroller.scrollTop,"
            "shell:[sidebar.x,sidebar.y,sidebar.width,sidebar.height,header.x,header.y,header.width,header.height,rail.x,rail.y,rail.width,rail.height]};})()"
        )
        cross_layout_samples = []
        cross_layout_stable = 0
        cross_layout_last = None
        cross_layout_started = time.monotonic()
        while time.monotonic() - cross_layout_started <= 2.2:
            sample = self.evaluate(
                "(() => {const scroller=document.querySelector('[data-stream-scroll]');const target=document.querySelector('[data-stream-node][data-state=\"current\"]');"
                "const scrollerBox=scroller.getBoundingClientRect();const targetBox=target.getBoundingClientRect();"
                "const visibleHeight=Math.max(0,Math.min(targetBox.bottom,scrollerBox.bottom)-Math.max(targetBox.top,scrollerBox.top));"
                "const action=target.querySelector('[data-current-action] .primary-button');const actionBox=action.getBoundingClientRect();"
                "const hit=document.elementFromPoint(actionBox.left+actionBox.width/2,actionBox.top+actionBox.height/2);"
                "const sidebar=document.querySelector('.sidebar').getBoundingClientRect();const header=document.querySelector('.page-header').getBoundingClientRect();"
                "const rail=document.querySelector('.detail-rail').getBoundingClientRect();return {top:scroller.scrollTop,state:scroller.dataset.scrollMotionState||'',"
                "sameScroller:scroller===window.__motionMenuScroller,controllerMaxStep:Number(scroller.dataset.scrollMotionMaxStep||0),"
                "clientHeight:scroller.clientHeight,targetRatio:targetBox.height?visibleHeight/targetBox.height:0,actionHit:hit===action||action.contains(hit),"
                "semanticDone:!new URLSearchParams(location.search).get('entry')&&!document.querySelector('[data-stream-node].is-located')"
                "&&!document.querySelector('[data-return-current]').classList.contains('visible'),"
                "shell:[sidebar.x,sidebar.y,sidebar.width,sidebar.height,header.x,header.y,header.width,header.height,rail.x,rail.y,rail.width,rail.height]};})()"
            )
            cross_layout_samples.append(sample)
            cross_layout_stable = cross_layout_stable + 1 if cross_layout_last is not None and abs(sample["top"] - cross_layout_last) <= 0.75 else 0
            cross_layout_last = sample["top"]
            if sample["semanticDone"] and sample["state"] in ["settled", "idle"] and cross_layout_stable >= 4:
                break
            time.sleep(0.016)
        cross_positions = [sample["top"] for sample in cross_layout_samples]
        cross_start = cross_positions[0] if cross_positions else cross_layout_initial["top"]
        cross_end = cross_positions[-1] if cross_positions else cross_start
        cross_intermediates = []
        for position in cross_positions:
            if abs(position - cross_start) > 0.75 and abs(position - cross_end) > 0.75:
                if not cross_intermediates or abs(position - cross_intermediates[-1]) > 0.75:
                    cross_intermediates.append(position)
        cross_deltas = [cross_positions[index] - cross_positions[index - 1] for index in range(1, len(cross_positions))]
        cross_reverse = sum(max(0, -delta) for delta in cross_deltas)
        cross_max_step = max((abs(delta) for delta in cross_deltas), default=0)
        cross_shell_drift = max(
            (abs(value - cross_layout_initial["shell"][index]) for sample in cross_layout_samples for index, value in enumerate(sample["shell"])),
            default=999,
        )
        cross_last = cross_layout_samples[-1] if cross_layout_samples else {}
        self.check(
            "changing-layout-mid-return-resumes-the-trajectory-without-a-stuck-return-state",
            self.snapshot() == motion_menu_snapshot
            and self.evaluate("document.querySelector('[data-stream-scroll]')===window.__motionMenuScroller")
            and cross_end > cross_start + 120
            and len(cross_intermediates) >= 4
            and cross_reverse <= 4
            and cross_max_step <= cross_last.get("clientHeight", 0) * 0.48
            and cross_last.get("controllerMaxStep", 999) <= cross_last.get("clientHeight", 0) * 0.18
            and cross_shell_drift <= 1
            and all(sample["sameScroller"] for sample in cross_layout_samples)
            and cross_last.get("semanticDone")
            and cross_last.get("state") in ["settled", "idle"]
            and cross_last.get("targetRatio", 0) >= 0.6
            and cross_last.get("actionHit"),
            json.dumps({"start": cross_start, "end": cross_end, "intermediates": len(cross_intermediates), "reverse": cross_reverse,
                        "maxStep": cross_max_step, "shellDrift": cross_shell_drift, "samples": len(cross_layout_samples), "last": cross_last}, sort_keys=True),
        )

        self.navigate("variant=A&scenario=long")
        self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');"
            "scroller.style.scrollBehavior='auto';scroller.scrollTop=scroller.scrollHeight;return scroller.scrollTop;})()"
        )
        interrupted_snapshot = self.snapshot()
        self.click('.page-header [data-action="visit-previous"]')
        self.wait_for(
            "document.querySelector('[data-stream-scroll]').dataset.scrollMotionState==='traveling'"
            " && Number(document.querySelector('[data-stream-scroll]').dataset.scrollMotionStart)-document.querySelector('[data-stream-scroll]').scrollTop>48",
            "scroll motion to begin before wheel interruption",
        )
        interrupted_at = self.evaluate("document.querySelector('[data-stream-scroll]').scrollTop")
        wheel_point = self.evaluate(
            "(() => {const rect=document.querySelector('[data-stream-scroll]').getBoundingClientRect();"
            "return {x:rect.left+rect.width/2,y:rect.top+rect.height/2};})()"
        )
        self.cdp.command(
            "Input.dispatchMouseEvent",
            {"type": "mouseWheel", "x": wheel_point["x"], "y": wheel_point["y"], "deltaX": 0, "deltaY": 180},
        )
        self.wait_for(
            "document.querySelector('[data-stream-scroll]').dataset.scrollMotionState==='cancelled'",
            "wheel interruption cancels programmatic scroll",
        )
        wheel_positions = []
        stable_wheel_samples = 0
        last_wheel_position = None
        wheel_deadline = time.monotonic() + 1.0
        while time.monotonic() < wheel_deadline and stable_wheel_samples < 4:
            wheel_position = self.evaluate("document.querySelector('[data-stream-scroll]').scrollTop")
            wheel_positions.append(wheel_position)
            stable_wheel_samples = stable_wheel_samples + 1 if last_wheel_position is not None and abs(wheel_position - last_wheel_position) <= 0.75 else 0
            last_wheel_position = wheel_position
            time.sleep(0.05)
        interrupted_after = wheel_positions[-1]
        cancelled_at = self.evaluate("Number(document.querySelector('[data-stream-scroll]').dataset.scrollMotionCancelTop)")
        interrupted_target = self.evaluate("Number(document.querySelector('[data-stream-scroll]').dataset.scrollMotionTarget)")
        self.check(
            "wheel-interruption-takes-control-without-snapback",
            interrupted_after > interrupted_at + 20
            and interrupted_after >= cancelled_at
            and stable_wheel_samples >= 4
            and abs(interrupted_after - interrupted_target) > 12
            and self.snapshot() == interrupted_snapshot
            and self.count('[data-return-current].visible') == 1,
            json.dumps({"beforeDispatch": interrupted_at, "cancelledAt": cancelled_at, "positions": wheel_positions, "target": interrupted_target}, sort_keys=True),
        )

        for variant in ["A", "B", "C"]:
            self.navigate(f"variant={variant}&scenario=focus")
            self.click('[data-action="choose"][data-kind="focus"][data-value="shape"]')
            before_advance_motion = self.snapshot()
            advance_trace = self.trace_scroll_action(
                '[data-action="confirm-current"]',
                '[data-stream-node][data-state="current"]',
                '[data-stream-node][data-state="current"]',
                "document.querySelector('[data-stream-session]').dataset.activeNodeId!==sourceId && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='criteria'",
            )
            self.assert_scroll_trace(
                f"variant-{variant.lower()}-confirming-current-has-continuous-downward-track-to-next-checkpoint",
                advance_trace,
                "forward",
                require_action_hit=True,
            )
            self.assert_append_only(
                before_advance_motion,
                self.snapshot(),
                f"variant-{variant.lower()}-animated-advance-remains-append-only",
            )

        self.evaluate("true")
        self.check(
            "browser-runtime-has-no-uncaught-exceptions",
            not self.cdp.runtime_errors,
            "; ".join(self.cdp.runtime_errors),
        )

        version = self.cdp.command("Browser.getVersion")
        return {
            "status": "PASS",
            "suite": "zhulong-stream-prototype-only-cdp",
            "scope": "throwaway HTML prototype only; not real .app acceptance",
            "checks": len(self.checks),
            "unique_checks": len(set(self.checks)),
            "repeated_check_executions": len(self.checks) - len(set(self.checks)),
            "passed": self.checks,
            "browser": version.get("product", "unknown"),
            "viewport": self.geometry,
            "duration_seconds": round(time.monotonic() - self.started_at, 3),
        }


def main():
    port = int(sys.argv[1])
    websocket = CDPWebSocket(page_websocket_url(port))
    try:
        result = StreamAcceptance(websocket, sys.argv[2]).run()
    finally:
        websocket.close()
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))


try:
    main()
except Exception as error:
    print(
        json.dumps(
            {
                "status": "FAIL",
                "suite": "zhulong-stream-prototype-only-cdp",
                "scope": "throwaway HTML prototype only; not real .app acceptance",
                "error": str(error),
                "error_type": type(error).__name__,
            },
            ensure_ascii=False,
            sort_keys=True,
        ),
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
test_status=$?
set -e

if [[ "$test_status" -ne 0 ]]; then
  if [[ -s "$chrome_log" ]]; then
    printf '%s\n' '{"status":"DIAGNOSTIC","source":"Chrome stderr (tail before isolated cleanup)"}' >&2
    tail -n 120 "$chrome_log" >&2
  fi
  exit "$test_status"
fi
