#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

fail() {
  echo "GitHub-hosted CI contract: $*" >&2
  exit 1
}

verifier="scripts/verify-github-hosted-ci"
[[ -x "$verifier" ]] || fail "live hosted CI verifier is missing"

fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-hosted-ci-contract.XXXXXX")"
cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT

fixture_bin="$fixture_root/bin"
mkdir -p "$fixture_bin"
fake_gh="$fixture_bin/gh"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'case "$*" in' \
  '  *"actions/workflows/ci.yml/runs"*) printf "%s\n" "${NOONMARK_CI_RUN_ROWS:-}" ;;' \
  '  *"actions/runs/123/jobs"*) printf "%s\n" "${NOONMARK_CI_JOB_BOUNDARY:-}" ;;' \
  '  *) echo "unexpected fake gh invocation: $*" >&2; exit 64 ;;' \
  'esac' >"$fake_gh"
chmod 0700 "$fake_gh"

commit="0123456789abcdef0123456789abcdef01234567"
good_run=$'123\tcompleted\tsuccess\t1'
good_job=$'1\tBuild · Lint · UT · IT · ST · DST\tmacos-15\tcompleted\tsuccess'

run_fixture() {
  local run_rows="$1"
  local job_boundary="$2"

  PATH="$fixture_bin:$PATH" \
    NOONMARK_CI_RUN_ROWS="$run_rows" \
    NOONMARK_CI_JOB_BOUNDARY="$job_boundary" \
    "$verifier" "$commit"
}

run_fixture "$good_run" "$good_job" >/dev/null ||
  fail "verifier rejected one successful GitHub-hosted CI run"
if run_fixture $'123\tcompleted\tsuccess\t1\n124\tcompleted\tsuccess\t1' "$good_job" >/dev/null 2>&1; then
  fail "verifier accepted duplicate CI runs"
fi
if run_fixture $'123\tcompleted\tfailure\t1' "$good_job" >/dev/null 2>&1; then
  fail "verifier accepted a failed CI run"
fi
if run_fixture "$good_run" $'1\tBuild · Lint · UT · IT · ST · DST\tself-hosted,macOS\tcompleted\tsuccess' >/dev/null 2>&1; then
  fail "verifier accepted a self-hosted job"
fi

echo "GitHub-hosted CI contract passed"
