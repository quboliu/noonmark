import AppKit
import Foundation

let root = URL(fileURLWithPath: ProcessInfo.processInfo.environment["NOONMARK_FIXTURE_SCREENSHOT_ROOT"]!)
let values: [String: (String, Int, Int)] = [
    "english-day": ("Coordinate the launch readiness", 1920, 1440),
    "english-day-wide": ("Coordinate the launch readiness", 2880, 1800),
    "english-day-history-header": ("History locked", 1920, 1440),
    "english-pool": ("Draft the post-launch accessibility follow-up", 2400, 1536),
    "english-future": ("Run the release candidate VoiceOver walkthrough", 2400, 1536),
    "english-unfinished": ("Review the unresolved keyboard navigation findings", 2400, 1536),
    "english-completed": ("Approve the final English navigation copy", 2400, 1536),
    "english-calendar": ("A whole-month trace overview", 2400, 1536),
    "english-settings": ("Settings\nZhulong Configuration\nWrite & Privacy Boundaries", 1640, 1440),
    "english-zhulong": ("Clarify what is vague and keep what is underway moving", 2400, 1536),
]
for (scenario, value) in values {
    let (text, width, height) = value
    let bitmap = NSBitmapImageRep(
        bitmapDataPlanes: nil,
        pixelsWide: width,
        pixelsHigh: height,
        bitsPerSample: 8,
        samplesPerPixel: 4,
        hasAlpha: true,
        isPlanar: false,
        colorSpaceName: .deviceRGB,
        bytesPerRow: 0,
        bitsPerPixel: 0
    )!
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: bitmap)
    NSColor.white.setFill()
    NSRect(x: 0, y: 0, width: CGFloat(width), height: CGFloat(height)).fill()
    (text as NSString).draw(
        in: NSRect(
            x: 120,
            y: 160,
            width: CGFloat(width - 240),
            height: CGFloat(height - 320)
        ),
        withAttributes: [
            .font: NSFont.systemFont(ofSize: 52, weight: .semibold),
            .foregroundColor: NSColor.black,
        ]
    )
    NSGraphicsContext.restoreGraphicsState()
    let data = bitmap.representation(using: .png, properties: [:])!
    try data.write(to: root.appendingPathComponent("\(scenario).png"))
}
'
IFS=, read -r -a english_fixture_scenarios <<< \
