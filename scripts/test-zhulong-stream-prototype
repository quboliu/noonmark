            " && ['settled','idle'].includes(document.querySelector('[data-stream-scroll]')?.dataset.scrollMotionState)"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.getBoundingClientRect().bottom <= document.querySelector('[data-stream-scroll]').getBoundingClientRect().bottom",
