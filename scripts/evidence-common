#!/usr/bin/env bash

if [[ "${NOONMARK_EVIDENCE_COMMON_LOADED:-0}" == "1" ]]; then
  return 0
fi
NOONMARK_EVIDENCE_COMMON_LOADED=1

evidence_validate_key() {
  [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9_]*$ ]]
}

evidence_validate_value() {
  local value="$1"
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]]
}

evidence_validate_artifact_basename() {
  local value="$1"
  local label="${2:-artifact}"

  if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._\ -]{0,63}$ ||
    "$value" == "." || "$value" == ".." ]]; then
    echo "$label must be a safe ASCII basename" >&2
    return 1
  fi
}

evidence_expected_english_oracles() {
  local scenario="$1"
  local base="screenshot_vision_ocr_no_han"

  case "$scenario" in
    english-day)
      printf '%s\n' \
        "${base}+day_header_pixel+in_app_view_tree_ax+external_ax"
      ;;
    english-day-wide)
      printf '%s\n' "${base}+day_header_pixel+in_app_view_tree_ax"
      ;;
    english-day-history-header)
      printf '%s\n' \
        "${base}+day_header_pixel+in_app_responsive_contract"
      ;;
    english-pool | english-future | english-unfinished | \
      english-completed | english-calendar)
      printf '%s\n' "${base}+in_app_view_tree_ax"
      ;;
    english-settings)
      printf '%s\n' "${base}+settings_sidebar_vision_ocr"
      ;;
    english-zhulong)
      printf '%s\n' "${base}+in_app_zhulong_title_geometry"
      ;;
    *) return 1 ;;
  esac
}

evidence_absolute_repo_root() {
  local repo_root="$1"

  if [[ ! -d "$repo_root" ]]; then
    echo "evidence repository root is missing: $repo_root" >&2
    return 1
  fi
  (cd "$repo_root" && pwd -P)
}

evidence_guard_repo_path() {
  local repo_root="$1"
  local requested_path="$2"
  local repo_absolute
  local parent_absolute
  local requested_absolute

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  if [[ -z "$requested_path" || "$requested_path" == *$'\n'* ||
    "$requested_path" == *$'\r'* ]]; then
    echo "evidence path is empty or contains a line break" >&2
    return 1
  fi
  case "/$requested_path/" in
    */../* | */./*)
      echo "evidence path contains a traversal segment: $requested_path" >&2
      return 1
      ;;
  esac
  if [[ "$requested_path" == /* ]]; then
    requested_absolute="$requested_path"
  else
    requested_absolute="$repo_absolute/$requested_path"
  fi
  if ! mkdir -p "$(dirname "$requested_absolute")"; then
    echo "could not create the evidence parent directory" >&2
    return 1
  fi
  parent_absolute="$(cd "$(dirname "$requested_absolute")" && pwd -P)" ||
    return 1
  requested_absolute="$parent_absolute/$(basename "$requested_absolute")"
  if [[ "$requested_absolute" == "$repo_absolute" ||
    "$requested_absolute" != "$repo_absolute/"* ]]; then
    echo "evidence path escapes the repository: $requested_path" >&2
    return 1
  fi
  printf '%s\n' "$requested_absolute"
}

evidence_prepare_fresh_directory() {
  local repo_root="$1"
  local directory="$2"
  local directory_absolute

  directory_absolute="$(evidence_guard_repo_path "$repo_root" "$directory")" ||
    return 1
  if ! rm -rf -- "$directory_absolute"; then
    echo "could not remove stale evidence: $directory" >&2
    return 1
  fi
  if ! mkdir -p "$directory_absolute"; then
    echo "could not create fresh evidence directory: $directory" >&2
    return 1
  fi
}

evidence_write_fragment_atomically() {
  local output="$1"
  local content_file="$2"
  local output_directory
  local staged

  output_directory="$(dirname "$output")"
  mkdir -p "$output_directory" || return 1
  staged="$(mktemp "${output_directory}/.$(basename "$output").XXXXXX")" ||
    return 1
  if ! cp "$content_file" "$staged" || ! mv -f "$staged" "$output"; then
    rm -f "$staged"
    return 1
  fi
}

evidence_capture_source() {
  local repo_root="$1"
  local prefix="$2"
  local output="$3"
  local repo_absolute
  local head_commit
  local head_tree
  local worktree_tree
  local dirty
  local temporary_index
  local content

  if ! evidence_validate_key "$prefix"; then
    echo "invalid evidence source prefix: $prefix" >&2
    return 1
  fi
  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  head_commit="$(git -C "$repo_absolute" rev-parse --verify HEAD)" || return 1
  head_tree="$(git -C "$repo_absolute" rev-parse --verify 'HEAD^{tree}')" ||
    return 1
  temporary_index="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-index.XXXXXX")" ||
    return 1
  rm -f "$temporary_index"
  if ! GIT_INDEX_FILE="$temporary_index" git -C "$repo_absolute" read-tree HEAD ||
    ! GIT_INDEX_FILE="$temporary_index" git -C "$repo_absolute" add -A ||
    ! worktree_tree="$(
      GIT_INDEX_FILE="$temporary_index" git -C "$repo_absolute" write-tree
    )"; then
    rm -f "$temporary_index"
    echo "could not capture the exact evidence worktree" >&2
    return 1
  fi
  rm -f "$temporary_index"
  dirty=0
  [[ "$worktree_tree" == "$head_tree" ]] || dirty=1
  content="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-source.XXXXXX")" ||
    return 1
  {
    printf '%s_head_commit=%s\n' "$prefix" "$head_commit"
    printf '%s_head_tree_oid=%s\n' "$prefix" "$head_tree"
    printf '%s_worktree_tree_oid=%s\n' "$prefix" "$worktree_tree"
    printf '%s_tree_dirty=%s\n' "$prefix" "$dirty"
  } >"$content"
  if ! evidence_write_fragment_atomically "$output" "$content"; then
    rm -f "$content"
    return 1
  fi
  rm -f "$content"
}

evidence_require_clean_source() {
  local repo_root="$1"
  local snapshot
  local dirty

  snapshot="$(mktemp "${TMPDIR:-/tmp}/noonmark-clean-source.XXXXXX")" ||
    return 1
  if ! evidence_capture_source "$repo_root" clean_source "$snapshot"; then
    rm -f "$snapshot"
    return 1
  fi
  dirty="$(evidence_read "$snapshot" clean_source_tree_dirty)" || {
    rm -f "$snapshot"
    return 1
  }
  rm -f "$snapshot"
  if [[ "$dirty" != "0" ]]; then
    echo "release build requires a clean, committed source tree" >&2
    return 1
  fi
}

evidence_capture_bundle() {
  local bundle_path="$1"
  local stable_required="$2"
  local prefix="$3"
  local output="$4"
  local info_plist="$bundle_path/Contents/Info.plist"
  local executable_name
  local executable_path
  local binary_sha256
  local details
  local identifier
  local team_identifier
  local authority
  local signature
  local requirement
  local requirement_sha256
  local identity_sha1=""
  local identity_sha256=""
  local codesign_kind="other"
  local certificate_prefix
  local content

  if [[ "$stable_required" != "0" && "$stable_required" != "1" ]]; then
    echo "stable bundle evidence flag must be 0 or 1" >&2
    return 1
  fi
  if ! evidence_validate_key "$prefix" || [[ ! -d "$bundle_path" ]] ||
    [[ ! -f "$info_plist" ]]; then
    echo "signed bundle evidence is missing a valid bundle or prefix" >&2
    return 1
  fi
  executable_name="$(
    plutil -extract CFBundleExecutable raw -o - "$info_plist" 2>/dev/null
  )" || {
    echo "signed bundle has no main executable declaration" >&2
    return 1
  }
  executable_path="$bundle_path/Contents/MacOS/$executable_name"
  if [[ ! -f "$executable_path" || ! -x "$executable_path" ]]; then
    echo "signed bundle main executable is missing or not executable" >&2
    return 1
  fi
  if ! codesign --verify --deep --strict "$bundle_path" >/dev/null 2>&1; then
    echo "bundle failed strict code-sign verification" >&2
    return 1
  fi
  details="$(codesign --display --verbose=4 "$bundle_path" 2>&1)" || return 1
  identifier="$(printf '%s\n' "$details" | awk -F= '$1 == "Identifier" { print substr($0, 12); exit }')"
  team_identifier="$(printf '%s\n' "$details" | awk -F= '$1 == "TeamIdentifier" { print substr($0, 16); exit }')"
  authority="$(printf '%s\n' "$details" | awk -F= '$1 == "Authority" { print substr($0, 11); exit }')"
  signature="$(printf '%s\n' "$details" | awk -F= '$1 == "Signature" { print substr($0, 11); exit }')"
  requirement="$(
    codesign --display --requirements - "$bundle_path" 2>&1 |
      awk '/^(# )?designated =>/ { print; exit }'
  )"
  if [[ -z "$identifier" || -z "$requirement" ]]; then
    echo "signed bundle evidence lacks identifier or designated requirement" >&2
    return 1
  fi
  requirement_sha256="$(
    printf '%s' "$requirement" | shasum -a 256 | awk '{print $1}'
  )"
  binary_sha256="$(shasum -a 256 "$executable_path" | awk '{print $1}')" ||
    return 1
  certificate_prefix="$(mktemp -u "${TMPDIR:-/tmp}/noonmark-evidence-cert.XXXXXX")"
  if codesign --display --extract-certificates="$certificate_prefix" \
    "$bundle_path" >/dev/null 2>&1 && [[ -f "${certificate_prefix}0" ]]; then
    identity_sha1="$(shasum "${certificate_prefix}0" | awk '{print $1}')"
    identity_sha256="$(shasum -a 256 "${certificate_prefix}0" | awk '{print $1}')"
  fi
  rm -f "${certificate_prefix}"* 2>/dev/null || true

  case "$authority" in
    "Apple Development:"*) codesign_kind="development" ;;
    "Developer ID Application:"*) codesign_kind="developer-id" ;;
    "Apple Distribution:"*) codesign_kind="distribution" ;;
    "")
      if [[ "$signature" == "adhoc" ]]; then
        codesign_kind="adhoc"
      fi
      ;;
  esac
  if [[ "$stable_required" == "1" ]] && {
    [[ -z "$authority" || -z "$team_identifier" ||
      "$team_identifier" == "not set" || -z "$identity_sha1" ||
      -z "$identity_sha256" || "$requirement" == *"cdhash"* ||
      "$codesign_kind" == "adhoc" ]];
  }; then
    echo "bundle evidence requires a stable Apple signing identity and Team" >&2
    return 1
  fi

  content="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-bundle.XXXXXX")" ||
    return 1
  {
    printf '%s_bundle_path=%s\n' "$prefix" "$bundle_path"
    printf '%s_binary_path=%s\n' "$prefix" "$executable_path"
    printf '%s_binary_sha256=%s\n' "$prefix" "$binary_sha256"
    printf '%s_codesign_identifier=%s\n' "$prefix" "$identifier"
    printf '%s_codesign_kind=%s\n' "$prefix" "$codesign_kind"
    printf '%s_codesign_identity_sha1=%s\n' "$prefix" "$identity_sha1"
    printf '%s_codesign_identity_sha256=%s\n' "$prefix" "$identity_sha256"
    printf '%s_codesign_team_identifier=%s\n' "$prefix" "$team_identifier"
    printf '%s_codesign_authority=%s\n' "$prefix" "$authority"
    printf '%s_designated_requirement_sha256=%s\n' \
      "$prefix" "$requirement_sha256"
    printf '%s_codesign_deep_strict=1\n' "$prefix"
    printf '%s_stable_required=%s\n' "$prefix" "$stable_required"
  } >"$content"
  if ! evidence_write_fragment_atomically "$output" "$content"; then
    rm -f "$content"
    return 1
  fi
  rm -f "$content"
}

evidence_release_dwarf_path() {
  local binary_path="$1"
  local dsym_bundle="$2"
  local dwarf_directory="${dsym_bundle}/Contents/Resources/DWARF"
  local candidate
  local resolved=""
  local count=0
  local candidates

  if [[ ! -f "$binary_path" || -L "$binary_path" ||
    ! -d "$dsym_bundle" || -L "$dsym_bundle" ||
    ! -d "$dwarf_directory" || -L "$dwarf_directory" ]]; then
    echo "release binary or dSYM bundle is missing or unsafe" >&2
    return 1
  fi
  candidates="$(mktemp "${TMPDIR:-/tmp}/noonmark-dwarf-candidates.XXXXXX")" ||
    return 1
  if ! find "$dwarf_directory" \
    -mindepth 1 \
    -maxdepth 1 \
    -type f \
    -print0 >"$candidates"; then
    rm -f "$candidates"
    echo "release dSYM DWARF directory could not be scanned" >&2
    return 1
  fi
  while IFS= read -r -d '' candidate; do
    resolved="$candidate"
    count=$((count + 1))
  done <"$candidates"
  rm -f "$candidates"
  if [[ "$count" -ne 1 || -z "$resolved" || -L "$resolved" ||
    "$(basename "$resolved")" != "$(basename "$binary_path")" ]]; then
    echo "release dSYM must contain exactly the matching main DWARF file" >&2
    return 1
  fi
  printf '%s\n' "$resolved"
}

evidence_release_uuid_set() {
  local artifact_path="$1"
  local dwarfdump_bin
  local output
  local rows
  local sorted_rows
  local canonical_uuid_set
  local line
  local arch
  local uuid
  local line_count=0
  local written_line_count=0
  local uuid_line_regex='^UUID: ([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}) \(([A-Za-z0-9_.-]+)\) .+$'

  if [[ ! -f "$artifact_path" || -L "$artifact_path" ]]; then
    echo "release UUID input is missing or unsafe: $artifact_path" >&2
    return 1
  fi
  dwarfdump_bin="$(xcrun --find dwarfdump)" || return 1
  if [[ "$dwarfdump_bin" != /* || ! -x "$dwarfdump_bin" ]]; then
    echo "release UUID inspection requires an absolute executable dwarfdump" >&2
    return 1
  fi

  output="$(mktemp "${TMPDIR:-/tmp}/noonmark-dwarfdump.XXXXXX")" ||
    return 1
  rows="$(mktemp "${TMPDIR:-/tmp}/noonmark-dwarfdump-rows.XXXXXX")" || {
    rm -f "$output"
    return 1
  }
  sorted_rows="$(mktemp "${TMPDIR:-/tmp}/noonmark-dwarfdump-sorted.XXXXXX")" || {
    rm -f "$output" "$rows"
    return 1
  }
  if ! "$dwarfdump_bin" --uuid "$artifact_path" >"$output"; then
    rm -f "$output" "$rows" "$sorted_rows"
    echo "dwarfdump could not inspect release UUIDs: $artifact_path" >&2
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_count=$((line_count + 1))
    if [[ ! "$line" =~ $uuid_line_regex ]]; then
      rm -f "$output" "$rows" "$sorted_rows"
      echo "dwarfdump emitted an unrecognized UUID row" >&2
      return 1
    fi
    if ! uuid="$(
      printf '%s' "${BASH_REMATCH[1]}" |
        tr '[:lower:]' '[:upper:]'
    )"; then
      rm -f "$output" "$rows" "$sorted_rows"
      echo "release UUID could not be normalized" >&2
      return 1
    fi
    arch="${BASH_REMATCH[2]}"
    if ! printf '%s:%s\n' "$arch" "$uuid" >>"$rows"; then
      rm -f "$output" "$rows" "$sorted_rows"
      echo "release UUID row could not be recorded" >&2
      return 1
    fi
    written_line_count=$((written_line_count + 1))
  done <"$output"
  if [[ "$written_line_count" -ne "$line_count" ]]; then
    rm -f "$output" "$rows" "$sorted_rows"
    echo "release UUID row count is incomplete" >&2
    return 1
  fi
  rm -f "$output"
  if [[ "$line_count" -eq 0 ]] || ! awk -F: '
    NF != 2 || seen_arch[$1]++ || seen_uuid[$2]++ { exit 1 }
  ' "$rows"; then
    rm -f "$rows" "$sorted_rows"
    echo "release UUID evidence is empty or duplicated" >&2
    return 1
  fi
  if ! LC_ALL=C sort "$rows" >"$sorted_rows"; then
    rm -f "$rows" "$sorted_rows"
    echo "release UUID rows could not be sorted canonically" >&2
    return 1
  fi
  canonical_uuid_set="$(paste -sd, "$sorted_rows")" || {
    rm -f "$rows" "$sorted_rows"
    return 1
  }
  rm -f "$rows" "$sorted_rows"
  if [[ -z "$canonical_uuid_set" || "$canonical_uuid_set" == *$'\n'* ||
    "$canonical_uuid_set" == *$'\r'* ]]; then
    return 1
  fi
  printf '%s\n' "$canonical_uuid_set"
}

evidence_release_architecture_description() {
  local uuid_set="$1"
  local entry
  local architecture
  local uuid
  local count=0
  local arm_count=0
  local x86_count=0
  local -a entries

  if [[ -z "$uuid_set" || "$uuid_set" == *$'\n'* ||
    "$uuid_set" == *$'\r'* ]]; then
    return 1
  fi
  IFS=, read -r -a entries <<<"$uuid_set"
  for entry in "${entries[@]}"; do
    architecture="${entry%%:*}"
    uuid="${entry#*:}"
    if [[ "$architecture" == "$entry" ||
      ! "$uuid" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
      return 1
    fi
    case "$architecture" in
      arm64 | arm64e) arm_count=$((arm_count + 1)) ;;
      x86_64) x86_count=$((x86_count + 1)) ;;
      *) return 1 ;;
    esac
    count=$((count + 1))
  done
  if [[ "$count" -eq 1 && "$arm_count" -eq 1 ]]; then
    printf 'arm64\n'
  elif [[ "$count" -eq 1 && "$x86_count" -eq 1 ]]; then
    printf 'x86_64\n'
  elif [[ "$count" -eq 2 && "$arm_count" -eq 1 &&
    "$x86_count" -eq 1 ]]; then
    printf 'Universal\n'
  else
    return 1
  fi
}

evidence_require_release_symbol_pair() {
  local binary_path="$1"
  local dsym_bundle="$2"
  local dwarf_path
  local binary_uuid_set
  local dsym_uuid_set

  dwarf_path="$(evidence_release_dwarf_path "$binary_path" "$dsym_bundle")" ||
    return 1
  binary_uuid_set="$(evidence_release_uuid_set "$binary_path")" || return 1
  dsym_uuid_set="$(evidence_release_uuid_set "$dwarf_path")" || return 1
  if [[ "$binary_uuid_set" != "$dsym_uuid_set" ]]; then
    echo "release binary and dSYM UUID sets do not match" >&2
    return 1
  fi
}

evidence_release_repo_relative_path() {
  local repo_root="$1"
  local requested_path="$2"
  local expected_kind="$3"
  local repo_absolute
  local requested_absolute
  local parent_absolute

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  if [[ -z "$requested_path" || "$requested_path" == *$'\n'* ||
    "$requested_path" == *$'\r'* ]]; then
    return 1
  fi
  if [[ "$requested_path" == /* ]]; then
    requested_absolute="$requested_path"
  else
    requested_absolute="$repo_absolute/$requested_path"
  fi
  if [[ -L "$requested_absolute" ]]; then
    return 1
  fi
  case "$expected_kind" in
    file) [[ -f "$requested_absolute" ]] || return 1 ;;
    directory) [[ -d "$requested_absolute" ]] || return 1 ;;
    *) return 1 ;;
  esac
  parent_absolute="$(cd "$(dirname "$requested_absolute")" && pwd -P)" ||
    return 1
  requested_absolute="$parent_absolute/$(basename "$requested_absolute")"
  if [[ "$requested_absolute" != "$repo_absolute/"* ]]; then
    echo "release symbol evidence path escapes the repository" >&2
    return 1
  fi
  printf '%s\n' "${requested_absolute#"$repo_absolute"/}"
}

evidence_require_exact_keys() {
  local document="$1"
  shift
  local expected_count="$#"
  local actual_count
  local key

  if [[ ! -f "$document" || -L "$document" || "$expected_count" -eq 0 ]] ||
    ! awk -F= '
      NF < 2 || $1 !~ /^[a-zA-Z][a-zA-Z0-9_]*$/ ||
        length(substr($0, index($0, "=") + 1)) == 0 || seen[$1]++ {
        invalid = 1
      }
      END { exit invalid ? 1 : 0 }
    ' "$document"; then
    echo "evidence document has invalid or duplicate keys" >&2
    return 1
  fi
  actual_count="$(wc -l <"$document" | tr -d '[:space:]')" || return 1
  if [[ "$actual_count" != "$expected_count" ]]; then
    echo "evidence document has an unexpected key set" >&2
    return 1
  fi
  for key in "$@"; do
    evidence_read "$document" "$key" >/dev/null || {
      echo "evidence document lacks required key: $key" >&2
      return 1
    }
  done
}

evidence_verify_release_identity_provenance() {
  local repo_root="$1"
  local provenance_path="$2"
  local manifest="$3"
  local manifest_prefix="$4"
  local provenance_relative
  local actual_sha256
  local suffix
  local provenance_value
  local manifest_value

  if ! evidence_validate_key "$manifest_prefix" || [[ ! -f "$manifest" ]]; then
    return 1
  fi
  provenance_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$provenance_path" file
  )" || return 1
  actual_sha256="$(shasum -a 256 "$provenance_path" | awk '{print $1}')" ||
    return 1
  evidence_require_release_symbol_value \
    "$manifest" "${manifest_prefix}_provenance_path" "$provenance_relative" ||
    return 1
  evidence_require_release_symbol_value \
    "$manifest" "${manifest_prefix}_provenance_sha256" "$actual_sha256" ||
    return 1
  evidence_require_exact_keys \
    "$provenance_path" \
    release_build_identity_schema_version \
    release_build_identity_version \
    release_build_identity_build \
    release_build_identity_git_commit \
    release_build_identity_build_date \
    release_build_identity_runtime \
    release_build_identity_minimum_os_version \
    release_build_identity_architecture \
    release_build_identity_binary_uuid_set \
    release_build_identity_binary_sha256 \
    release_build_identity_binary_sha256_scope || return 1
  if [[ "$(
    evidence_read "$provenance_path" release_build_identity_schema_version
  )" != "1" ]]; then
    echo "release build identity provenance has an unsupported schema" >&2
    return 1
  fi
  for suffix in \
    version \
    build \
    git_commit \
    build_date \
    runtime \
    minimum_os_version \
    architecture \
    binary_uuid_set \
    binary_sha256 \
    binary_sha256_scope; do
    provenance_value="$(
      evidence_read "$provenance_path" "release_build_identity_${suffix}"
    )" || return 1
    manifest_value="$(
      evidence_read "$manifest" "${manifest_prefix}_${suffix}"
    )" || return 1
    if [[ "$provenance_value" != "$manifest_value" ]]; then
      echo "release build identity provenance disagrees for $suffix" >&2
      return 1
    fi
  done
}

evidence_capture_release_dsym_inventory() {
  local repo_root="$1"
  local dsym_bundle="$2"
  local output="$3"
  local repo_absolute
  local dsym_relative
  local dsym_absolute
  local candidates
  local unsorted
  local sorted
  local path
  local relative
  local digest
  local size
  local kind
  local candidate_count=0
  local inventory_count=0

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  dsym_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$dsym_bundle" directory
  )" || return 1
  dsym_absolute="$repo_absolute/$dsym_relative"
  candidates="$(mktemp "${TMPDIR:-/tmp}/noonmark-dsym-tree.XXXXXX")" ||
    return 1
  unsorted="$(mktemp "${TMPDIR:-/tmp}/noonmark-dsym-inventory.XXXXXX")" || {
    rm -f "$candidates"
    return 1
  }
  sorted="$(mktemp "${TMPDIR:-/tmp}/noonmark-dsym-inventory-sorted.XXXXXX")" || {
    rm -f "$candidates" "$unsorted"
    return 1
  }
  if ! find "$dsym_absolute" -print0 >"$candidates"; then
    rm -f "$candidates" "$unsorted" "$sorted"
    echo "release dSYM tree could not be scanned" >&2
    return 1
  fi
  while IFS= read -r -d '' path; do
    candidate_count=$((candidate_count + 1))
  done <"$candidates"
  if [[ "$candidate_count" -eq 0 ]]; then
    rm -f "$candidates" "$unsorted" "$sorted"
    echo "release dSYM tree is empty" >&2
    return 1
  fi
  while IFS= read -r -d '' path; do
    relative="${path#"$repo_absolute"/}"
    if [[ "$relative" == "$path" || -z "$relative" ||
      "$relative" == *$'\n'* || "$relative" == *$'\r'* ||
      "$relative" == *$'\t'* || -L "$path" ]]; then
      rm -f "$candidates" "$unsorted" "$sorted"
      echo "release dSYM contains an unsafe path" >&2
      return 1
    fi
    if [[ -d "$path" ]]; then
      kind="D"
      digest="-"
      size=0
    elif [[ -f "$path" ]]; then
      kind="F"
      digest="$(shasum -a 256 "$path" | awk '{print $1}')" || {
        rm -f "$candidates" "$unsorted" "$sorted"
        return 1
      }
      size="$(stat -f '%z' "$path")" || {
        rm -f "$candidates" "$unsorted" "$sorted"
        return 1
      }
    else
      rm -f "$candidates" "$unsorted" "$sorted"
      echo "release dSYM contains an unsupported filesystem entry" >&2
      return 1
    fi
    if ! printf '%s\t%s\t%s\t%s\n' \
      "$kind" "$digest" "$size" "$relative" >>"$unsorted"; then
      rm -f "$candidates" "$unsorted" "$sorted"
      echo "release dSYM inventory row could not be recorded" >&2
      return 1
    fi
    inventory_count=$((inventory_count + 1))
  done <"$candidates"
  rm -f "$candidates"
  if [[ "$inventory_count" -ne "$candidate_count" || ! -s "$unsorted" ]] ||
    ! LC_ALL=C sort -t $'\t' -k4,4 "$unsorted" >"$sorted"; then
    rm -f "$unsorted" "$sorted"
    echo "release dSYM inventory could not be sorted" >&2
    return 1
  fi
  rm -f "$unsorted"
  if ! evidence_write_fragment_atomically "$output" "$sorted"; then
    rm -f "$sorted"
    return 1
  fi
  rm -f "$sorted"
}

evidence_capture_release_symbols() {
  local repo_root="$1"
  local binary_path="$2"
  local dsym_bundle="$3"
  local prefix="$4"
  local output="$5"
  local inventory="$6"
  local dwarf_path
  local binary_uuid_set
  local dsym_uuid_set
  local binary_relative
  local dsym_relative
  local dwarf_relative
  local inventory_absolute
  local inventory_relative
  local repo_absolute
  local dsym_absolute
  local content

  if ! evidence_validate_key "$prefix"; then
    echo "invalid release symbol evidence prefix: $prefix" >&2
    return 1
  fi
  evidence_require_release_symbol_pair "$binary_path" "$dsym_bundle" ||
    return 1
  dwarf_path="$(evidence_release_dwarf_path "$binary_path" "$dsym_bundle")" ||
    return 1
  binary_uuid_set="$(evidence_release_uuid_set "$binary_path")" || return 1
  dsym_uuid_set="$(evidence_release_uuid_set "$dwarf_path")" || return 1
  binary_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$binary_path" file
  )" || return 1
  dsym_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$dsym_bundle" directory
  )" || return 1
  dwarf_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$dwarf_path" file
  )" || return 1
  inventory_absolute="$(evidence_guard_repo_path "$repo_root" "$inventory")" ||
    return 1
  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  dsym_absolute="$repo_absolute/$dsym_relative"
  if [[ "$inventory_absolute" == "$dsym_absolute" ||
    "$inventory_absolute" == "$dsym_absolute/"* ]]; then
    echo "release dSYM inventory cannot be stored inside the dSYM" >&2
    return 1
  fi
  evidence_capture_release_dsym_inventory \
    "$repo_root" "$dsym_bundle" "$inventory_absolute" ||
    return 1
  inventory_relative="$(
    evidence_release_repo_relative_path \
      "$repo_root" "$inventory_absolute" file
  )" || return 1

  content="$(mktemp "${TMPDIR:-/tmp}/noonmark-release-symbols.XXXXXX")" ||
    return 1
  {
    printf '%s_binary_path=%s\n' "$prefix" "$binary_relative"
    printf '%s_binary_sha256=%s\n' \
      "$prefix" "$(shasum -a 256 "$binary_path" | awk '{print $1}')"
    printf '%s_binary_uuid_set=%s\n' "$prefix" "$binary_uuid_set"
    printf '%s_dsym_bundle_path=%s\n' "$prefix" "$dsym_relative"
    printf '%s_dsym_dwarf_path=%s\n' "$prefix" "$dwarf_relative"
    printf '%s_dsym_dwarf_sha256=%s\n' \
      "$prefix" "$(shasum -a 256 "$dwarf_path" | awk '{print $1}')"
    printf '%s_dsym_uuid_set=%s\n' "$prefix" "$dsym_uuid_set"
    printf '%s_dsym_inventory_path=%s\n' "$prefix" "$inventory_relative"
    printf '%s_dsym_inventory_sha256=%s\n' \
      "$prefix" "$(shasum -a 256 "$inventory_absolute" | awk '{print $1}')"
    printf '%s_uuid_match=true\n' "$prefix"
  } >"$content"
  if ! evidence_write_fragment_atomically "$output" "$content"; then
    rm -f "$content"
    return 1
  fi
  rm -f "$content"
}

evidence_require_release_symbol_value() {
  local manifest="$1"
  local key="$2"
  local actual="$3"
  local expected

  expected="$(evidence_read "$manifest" "$key")" || {
    echo "release symbol manifest is missing $key" >&2
    return 1
  }
  if [[ "$expected" != "$actual" ]]; then
    echo "release symbol manifest disagrees for $key" >&2
    return 1
  fi
}

evidence_verify_release_symbols() {
  local repo_root="$1"
  local binary_path="$2"
  local dsym_bundle="$3"
  local manifest="$4"
  local prefix="$5"
  local inventory="$6"
  local dwarf_path
  local binary_relative
  local dsym_relative
  local dwarf_relative
  local inventory_relative
  local binary_sha256
  local dwarf_sha256
  local binary_uuid_set
  local dsym_uuid_set
  local inventory_sha256
  local current_inventory

  if ! evidence_validate_key "$prefix" || [[ ! -f "$manifest" ]]; then
    return 1
  fi
  evidence_require_release_symbol_pair "$binary_path" "$dsym_bundle" ||
    return 1
  dwarf_path="$(evidence_release_dwarf_path "$binary_path" "$dsym_bundle")" ||
    return 1
  binary_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$binary_path" file
  )" || return 1
  dsym_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$dsym_bundle" directory
  )" || return 1
  dwarf_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$dwarf_path" file
  )" || return 1
  inventory_relative="$(
    evidence_release_repo_relative_path "$repo_root" "$inventory" file
  )" || return 1
  binary_sha256="$(shasum -a 256 "$binary_path" | awk '{print $1}')" ||
    return 1
  dwarf_sha256="$(shasum -a 256 "$dwarf_path" | awk '{print $1}')" ||
    return 1
  binary_uuid_set="$(evidence_release_uuid_set "$binary_path")" || return 1
  dsym_uuid_set="$(evidence_release_uuid_set "$dwarf_path")" || return 1
  inventory_sha256="$(shasum -a 256 "$inventory" | awk '{print $1}')" ||
    return 1

  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_binary_path" "$binary_relative" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_binary_sha256" "$binary_sha256" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_binary_uuid_set" "$binary_uuid_set" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_bundle_path" "$dsym_relative" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_dwarf_path" "$dwarf_relative" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_dwarf_sha256" "$dwarf_sha256" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_uuid_set" "$dsym_uuid_set" || return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_inventory_path" "$inventory_relative" ||
    return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_dsym_inventory_sha256" "$inventory_sha256" ||
    return 1
  evidence_require_release_symbol_value \
    "$manifest" "${prefix}_uuid_match" true || return 1
  evidence_require_release_symbol_value \
    "$manifest" app_binary_sha256 "$binary_sha256" || return 1
  if [[ "$binary_uuid_set" != "$dsym_uuid_set" ]]; then
    return 1
  fi

  if ! awk -F '\t' -v expected="$dwarf_relative" '
    $1 == "F" && $4 == expected { count += 1 }
    END { exit count == 1 ? 0 : 1 }
  ' "$inventory"; then
    echo "release dSYM inventory omits its main DWARF file" >&2
    return 1
  fi
  current_inventory="$(
    mktemp "${TMPDIR:-/tmp}/noonmark-current-dsym-inventory.XXXXXX"
  )" || return 1
  if ! evidence_capture_release_dsym_inventory \
    "$repo_root" "$dsym_bundle" "$current_inventory" ||
    ! cmp -s "$inventory" "$current_inventory"; then
    rm -f "$current_inventory"
    echo "release dSYM directory does not match its exact inventory" >&2
    return 1
  fi
  rm -f "$current_inventory"
}

evidence_atomic_append_file() {
  local destination="$1"
  local addition="$2"
  local staged

  [[ -f "$destination" && -r "$destination" ]] || return 1
  staged="$(mktemp "$(dirname "$destination")/.$(basename "$destination").XXXXXX")" ||
    return 1
  if ! cp "$destination" "$staged" || ! cat "$addition" >>"$staged" ||
    ! mv -f "$staged" "$destination"; then
    rm -f "$staged"
    return 1
  fi
}

evidence_manifest_has_key() {
  local manifest="$1"
  local key="$2"
  awk -v key="$key" '
    index($0, key "=") == 1 { count += 1 }
    END { exit count == 1 ? 0 : 1 }
  ' "$manifest"
}

evidence_read() {
  local file="$1"
  local key="$2"

  if ! evidence_validate_key "$key" || [[ ! -f "$file" ]]; then
    return 1
  fi
  awk -v key="$key" '
    index($0, key "=") == 1 {
      count += 1
      value = substr($0, length(key) + 2)
    }
    END {
      if (count != 1 || length(value) == 0) exit 1
      print value
    }
  ' "$file"
}

evidence_begin_manifest() {
  local manifest="$1"
  local suite="$2"
  local run_id="$3"
  local configuration="$4"
  local mode="$5"
  local content

  for value in "$suite" "$run_id" "$configuration" "$mode"; do
    if ! evidence_validate_value "$value"; then
      echo "evidence manifest has an empty or multiline required value" >&2
      return 1
    fi
  done
  content="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-manifest.XXXXXX")" ||
    return 1
  {
    printf 'evidence_schema_version=1\n'
    printf 'suite=%s\n' "$suite"
    printf 'evidence_run_id=%s\n' "$run_id"
    printf 'configuration=%s\n' "$configuration"
    printf 'suite_mode=%s\n' "$mode"
    printf 'started_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$content"
  if ! evidence_write_fragment_atomically "$manifest" "$content"; then
    rm -f "$content"
    return 1
  fi
  rm -f "$content"
}

evidence_append() {
  local manifest="$1"
  local key="$2"
  local value="$3"
  local addition

  if ! evidence_validate_key "$key" || ! evidence_validate_value "$value" ||
    evidence_manifest_has_key "$manifest" "$key"; then
    echo "invalid or duplicate evidence manifest key: $key" >&2
    return 1
  fi
  addition="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-addition.XXXXXX")" ||
    return 1
  printf '%s=%s\n' "$key" "$value" >"$addition"
  if ! evidence_atomic_append_file "$manifest" "$addition"; then
    rm -f "$addition"
    return 1
  fi
  rm -f "$addition"
}

evidence_append_snapshot() {
  local manifest="$1"
  local snapshot="$2"
  local key
  local value
  local seen

  if [[ ! -s "$snapshot" ]]; then
    echo "evidence snapshot is missing or empty" >&2
    return 1
  fi
  seen="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-keys.XXXXXX")" ||
    return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    key="${line%%=*}"
    if [[ "$line" != *"="* ]]; then
      rm -f "$seen"
      return 1
    fi
    value="${line#*=}"
    if ! evidence_validate_key "$key" || ! evidence_validate_value "$value" ||
      evidence_manifest_has_key "$manifest" "$key" ||
      grep -Fqx "$key" "$seen"; then
      rm -f "$seen"
      echo "invalid or duplicate evidence snapshot key: $key" >&2
      return 1
    fi
    printf '%s\n' "$key" >>"$seen"
  done <"$snapshot"
  rm -f "$seen"
  evidence_atomic_append_file "$manifest" "$snapshot"
}

evidence_require_manifest() {
  local manifest="$1"
  shift
  local required

  [[ -f "$manifest" ]] || return 1
  for required in "$@"; do
    if [[ "$required" == *$'\n'* || "$required" != *"="* ]] ||
      [[ "$(grep -Fxc "$required" "$manifest")" != "1" ]]; then
      echo "evidence manifest is missing an exact requirement: $required" >&2
      return 1
    fi
  done
}

evidence_require_bundle_snapshots_equal() {
  local left_path="$1"
  local left_prefix="$2"
  local right_path="$3"
  local right_prefix="$4"
  local label="$5"
  local suffix
  local left_value
  local right_value

  for suffix in \
    binary_sha256 \
    codesign_identifier \
    codesign_kind \
    codesign_identity_sha1 \
    codesign_identity_sha256 \
    codesign_team_identifier \
    codesign_authority \
    designated_requirement_sha256; do
    left_value="$(evidence_read "$left_path" "${left_prefix}_${suffix}")" || {
      echo "$label start bundle evidence is incomplete: $suffix" >&2
      return 1
    }
    right_value="$(evidence_read "$right_path" "${right_prefix}_${suffix}")" || {
      echo "$label end bundle evidence is incomplete: $suffix" >&2
      return 1
    }
    if [[ "$left_value" != "$right_value" ]]; then
      echo "$label changed during evidence collection: $suffix" >&2
      return 1
    fi
  done
}

evidence_finish_manifest() {
  local manifest="$1"
  local exit_status="$2"
  shift 2
  local key
  local addition
  local start_value
  local end_value
  local start_prefix
  local end_prefix

  if [[ ! "$exit_status" =~ ^[0-9]+$ ]] || [[ ! -f "$manifest" ]] ||
    evidence_manifest_has_key "$manifest" "suite_exit_status"; then
    echo "evidence manifest cannot be finished" >&2
    return 1
  fi
  if ! awk -F= '
    $1 !~ /^[a-zA-Z][a-zA-Z0-9_]*$/ || seen[$1]++ { invalid = 1 }
    END { exit invalid ? 1 : 0 }
  ' "$manifest"; then
    echo "evidence manifest contains invalid or duplicate keys" >&2
    return 1
  fi
  for key in "$@"; do
    if ! evidence_validate_key "$key" ||
      ! evidence_read "$manifest" "$key" >/dev/null; then
      echo "evidence manifest lacks required key: $key" >&2
      return 1
    fi
  done
  if [[ "$exit_status" == "0" ]]; then
    if evidence_manifest_has_key "$manifest" "source_end_worktree_tree_oid"; then
      start_value="$(evidence_read "$manifest" "source_worktree_tree_oid")" ||
        return 1
      end_value="$(evidence_read "$manifest" "source_end_worktree_tree_oid")" ||
        return 1
      if [[ "$start_value" != "$end_value" ]]; then
        echo "source worktree changed during evidence collection" >&2
        return 1
      fi
    fi
    for start_prefix in app installed_app helper; do
      end_prefix="${start_prefix}_end"
      if evidence_manifest_has_key \
        "$manifest" \
        "${end_prefix}_binary_sha256"; then
        evidence_require_bundle_snapshots_equal \
          "$manifest" \
          "$start_prefix" \
          "$manifest" \
          "$end_prefix" \
          "signed ${start_prefix//_/ } bundle" || return 1
      fi
    done
    if grep -Eq '^[a-zA-Z][a-zA-Z0-9_]*_unchanged=false$' "$manifest"; then
      echo "evidence manifest reports a changed protected input" >&2
      return 1
    fi
  fi
  addition="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-finish.XXXXXX")" ||
    return 1
  {
    printf 'finished_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'suite_exit_status=%s\n' "$exit_status"
  } >"$addition"
  if ! evidence_atomic_append_file "$manifest" "$addition"; then
    rm -f "$addition"
    return 1
  fi
  rm -f "$addition"
}

evidence_inventory_entry() {
  local repo_absolute="$1"
  local path="$2"
  local output="$3"
  local relative
  local digest
  local size
  local target

  relative="${path#"$repo_absolute"/}"
  if [[ "$relative" == "$path" || -z "$relative" ||
    "$relative" == *$'\n'* || "$relative" == *$'\r'* ||
    "$relative" == *$'\t'* ]]; then
    echo "artifact path cannot be represented safely: $path" >&2
    return 1
  fi
  if [[ -L "$path" ]]; then
    target="$(readlink "$path")" || return 1
    if [[ "$target" == *$'\n'* || "$target" == *$'\r'* ]]; then
      return 1
    fi
    digest="$(printf '%s' "$target" | shasum -a 256 | awk '{print $1}')"
    size="${#target}"
  elif [[ -f "$path" ]]; then
    digest="$(shasum -a 256 "$path" | awk '{print $1}')" || return 1
    size="$(stat -f '%z' "$path")" || return 1
  else
    return 0
  fi
  printf '%s\t%s\t%s\n' "$digest" "$size" "$relative" >>"$output"
}

evidence_inventory() {
  local repo_root="$1"
  local output="$2"
  shift 2
  local repo_absolute
  local candidate
  local candidate_absolute
  local parent_absolute
  local unsorted
  local staged

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  unsorted="$(mktemp "${TMPDIR:-/tmp}/noonmark-evidence-inventory.XXXXXX")" ||
    return 1
  for candidate in "$@"; do
    if [[ -z "$candidate" || "$candidate" == *$'\n'* ||
      "$candidate" == *$'\r'* ]]; then
      rm -f "$unsorted"
      return 1
    fi
    if [[ "$candidate" == /* ]]; then
      candidate_absolute="$candidate"
    else
      candidate_absolute="$repo_absolute/$candidate"
    fi
    if [[ ! -e "$candidate_absolute" && ! -L "$candidate_absolute" ]]; then
      echo "artifact input is missing: $candidate" >&2
      rm -f "$unsorted"
      return 1
    fi
    parent_absolute="$(cd "$(dirname "$candidate_absolute")" && pwd -P)" || {
      rm -f "$unsorted"
      return 1
    }
    candidate_absolute="$parent_absolute/$(basename "$candidate_absolute")"
    if [[ "$candidate_absolute" != "$repo_absolute/"* ]]; then
      echo "artifact input escapes the repository: $candidate" >&2
      rm -f "$unsorted"
      return 1
    fi
    if [[ -d "$candidate_absolute" && ! -L "$candidate_absolute" ]]; then
      while IFS= read -r -d '' path; do
        if ! evidence_inventory_entry "$repo_absolute" "$path" "$unsorted"; then
          rm -f "$unsorted"
          return 1
        fi
      done < <(find "$candidate_absolute" -mindepth 1 \
        \( -type f -o -type l \) -print0)
    elif ! evidence_inventory_entry \
      "$repo_absolute" "$candidate_absolute" "$unsorted"; then
      rm -f "$unsorted"
      return 1
    fi
  done
  if [[ ! -s "$unsorted" ]]; then
    echo "artifact inventory has no files" >&2
    rm -f "$unsorted"
    return 1
  fi
  mkdir -p "$(dirname "$output")" || {
    rm -f "$unsorted"
    return 1
  }
  staged="$(mktemp "$(dirname "$output")/.$(basename "$output").XXXXXX")" || {
    rm -f "$unsorted"
    return 1
  }
  if ! LC_ALL=C sort -t $'\t' -k3,3 "$unsorted" >"$staged" ||
    ! mv -f "$staged" "$output"; then
    rm -f "$unsorted" "$staged"
    return 1
  fi
  rm -f "$unsorted"
}

evidence_verify_inventory() {
  local repo_root="$1"
  local inventory="$2"
  local repo_absolute
  local line
  local line_without_tabs
  local digest
  local declared_size
  local relative
  local extra
  local previous_relative=""
  local artifact_path
  local parent_absolute
  local artifact_absolute
  local actual_digest
  local actual_size
  local target
  local line_number=0
  local LC_ALL=C

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  if [[ ! -f "$inventory" || -L "$inventory" || ! -r "$inventory" ||
    ! -s "$inventory" ]]; then
    echo "artifact inventory is missing, empty, or not a regular file" >&2
    return 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    line_without_tabs="${line//$'\t'/}"
    if [[ -z "$line" || "$line" == *$'\r'* ||
      $((${#line} - ${#line_without_tabs})) -ne 2 ]]; then
      echo "artifact inventory has an invalid row at line $line_number" >&2
      return 1
    fi
    IFS=$'\t' read -r digest declared_size relative extra <<<"$line"
    if [[ -n "${extra:-}" || ! "$digest" =~ ^[0-9a-f]{64}$ ||
      ! "$declared_size" =~ ^(0|[1-9][0-9]*)$ || -z "$relative" ||
      "$relative" == /* || "$relative" == */ || "$relative" == *//* ]]; then
      echo "artifact inventory has an invalid row at line $line_number" >&2
      return 1
    fi
    case "/$relative/" in
      */../* | */./*)
        echo "artifact inventory path is unsafe at line $line_number" >&2
        return 1
        ;;
    esac
    if [[ -n "$previous_relative" &&
      ("$relative" == "$previous_relative" ||
        "$relative" < "$previous_relative") ]]; then
      echo "artifact inventory paths are duplicated or not sorted" >&2
      return 1
    fi

    artifact_path="$repo_absolute/$relative"
    if [[ ! -e "$artifact_path" && ! -L "$artifact_path" ]]; then
      echo "artifact inventory input is missing: $relative" >&2
      return 1
    fi
    parent_absolute="$(cd "$(dirname "$artifact_path")" && pwd -P)" || {
      echo "artifact inventory parent is missing: $relative" >&2
      return 1
    }
    artifact_absolute="$parent_absolute/$(basename "$artifact_path")"
    if [[ "$artifact_absolute" != "$repo_absolute/"* ]]; then
      echo "artifact inventory path escapes the repository: $relative" >&2
      return 1
    fi

    if [[ -L "$artifact_absolute" ]]; then
      target="$(readlink "$artifact_absolute")" || return 1
      if [[ "$target" == *$'\n'* || "$target" == *$'\r'* ]]; then
        echo "artifact symbolic-link target cannot be represented safely" >&2
        return 1
      fi
      actual_digest="$(
        printf '%s' "$target" | shasum -a 256 | awk '{print $1}'
      )" || return 1
      actual_size="${#target}"
    elif [[ -f "$artifact_absolute" ]]; then
      actual_digest="$(
        shasum -a 256 "$artifact_absolute" | awk '{print $1}'
      )" || return 1
      actual_size="$(stat -f '%z' "$artifact_absolute")" || return 1
    else
      echo "artifact inventory input is not a file or symbolic link: $relative" >&2
      return 1
    fi
    if [[ "$actual_digest" != "$digest" ||
      "$actual_size" != "$declared_size" ]]; then
      echo "artifact inventory input changed: $relative" >&2
      return 1
    fi
    previous_relative="$relative"
  done <"$inventory"

  [[ "$line_number" -gt 0 ]]
}

evidence_require_inventory_paths() {
  if [[ "$#" -lt 3 ]]; then
    echo "artifact inventory requires at least one protected path" >&2
    return 1
  fi

  local repo_root="$1"
  local inventory="$2"
  shift 2
  local repo_absolute
  local required
  local requested_absolute
  local parent_absolute
  local artifact_absolute
  local relative
  local existing
  local inventory_digest
  local inventory_size
  local inventory_relative
  local match_count
  local position
  local required_count=0
  local -a required_relatives=()

  repo_absolute="$(evidence_absolute_repo_root "$repo_root")" || return 1
  evidence_verify_inventory "$repo_absolute" "$inventory" || return 1

  for required in "$@"; do
    if [[ -z "$required" || "$required" == *$'\n'* ||
      "$required" == *$'\r'* || "$required" == *$'\t'* ||
      "$required" == */ || "$required" == *//* ]]; then
      echo "required artifact path is empty, unsafe, or non-canonical" >&2
      return 1
    fi
    case "/$required/" in
      */../* | */./*)
        echo "required artifact path contains a traversal segment" >&2
        return 1
        ;;
    esac

    if [[ "$required" == /* ]]; then
      requested_absolute="$required"
    else
      requested_absolute="$repo_absolute/$required"
    fi
    if [[ ! -e "$requested_absolute" && ! -L "$requested_absolute" ]]; then
      echo "required artifact path is missing: $required" >&2
      return 1
    fi
    parent_absolute="$(cd "$(dirname "$requested_absolute")" && pwd -P)" ||
      return 1
    artifact_absolute="$parent_absolute/$(basename "$requested_absolute")"
    if [[ "$artifact_absolute" != "$repo_absolute/"* ]]; then
      echo "required artifact path escapes the repository: $required" >&2
      return 1
    fi
    relative="${artifact_absolute#"$repo_absolute"/}"
    if { [[ "$required" == /* ]] &&
      [[ "$required" != "$artifact_absolute" ]]; } ||
      { [[ "$required" != /* ]] && [[ "$required" != "$relative" ]]; }; then
      echo "required artifact path is not canonical: $required" >&2
      return 1
    fi
    if [[ ! -L "$artifact_absolute" && ! -f "$artifact_absolute" ]]; then
      echo "required artifact is not a regular file or symbolic link: $required" >&2
      return 1
    fi

    position=0
    while [[ "$position" -lt "$required_count" ]]; do
      existing="${required_relatives[$position]}"
      if [[ "$existing" == "$relative" ]]; then
        echo "required artifact path is duplicated: $required" >&2
        return 1
      fi
      position=$((position + 1))
    done
    required_relatives[$required_count]="$relative"
    required_count=$((required_count + 1))

    match_count=0
    while IFS=$'\t' read -r \
      inventory_digest inventory_size inventory_relative; do
      if [[ "$inventory_relative" == "$relative" ]]; then
        match_count=$((match_count + 1))
      fi
    done <"$inventory"
    if [[ "$match_count" != "1" ]]; then
      echo "required artifact is not present exactly once: $required" >&2
      return 1
    fi
  done
}

evidence_verify_sigkill_allowlist() {
  local report="$1"
  local expected="$2"
  local expected_pid
  local expected_signal
  local expected_phase
  local expected_status
  local expected_sha
  local extra

  IFS=: read -r expected_pid expected_signal expected_phase \
    expected_status expected_sha extra <<<"$expected"
  if [[ -n "${extra:-}" || ! "$expected_pid" =~ ^[1-9][0-9]*$ ||
    "$expected_signal" != "SIGKILL" ||
    ! "$expected_phase" =~ ^[a-zA-Z0-9_-]+$ ||
    "$expected_status" != "137" ||
    ! "$expected_sha" =~ ^[0-9a-f]{64}$ || ! -f "$report" ]]; then
    echo "invalid exact SIGKILL allowlist input" >&2
    return 1
  fi
  awk -F '\t' \
    -v pid="$expected_pid" \
    -v signal="$expected_signal" \
    -v phase="$expected_phase" \
    -v status="$expected_status" \
    -v sha="$expected_sha" '
      NR == 1 {
        expected = "phase\tpid\tparent_pid\tsignal\treason\texpected_status\tobserved_status\tbinary_path\tbinary_sha256"
        if ($0 != expected) exit 1
        next
      }
      NR == 2 {
        if (NF != 9 || $1 != phase || $2 != pid || $3 !~ /^[1-9][0-9]*$/ ||
            $4 != signal || length($5) == 0 || $6 != status ||
            $7 != status || $8 !~ /^\// || $9 != sha) exit 1
        next
      }
      NR > 2 { exit 1 }
      END { if (NR != 2) exit 1 }
    ' "$report"
}
