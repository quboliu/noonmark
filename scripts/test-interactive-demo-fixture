#!/usr/bin/env bash
set -euo pipefail

export NOONMARK_REQUIRE_STABLE_UI_SIGNING=1

source scripts/interactive-demo-screenshot-contract
source scripts/runtime-evidence

configuration="${1:-debug}"
app_path="dist/NoonmarkDemo.app"
app_executable="$app_path/Contents/MacOS/NoonmarkMacAppDemo"
app_executable_name="NoonmarkMacAppDemo"

scripts/reset-dev-data demo
scripts/build-mac-app "$configuration" demo >/dev/null
mkdir -p "$PWD/artifacts"
test_root="$(mktemp -d "$PWD/artifacts/demo-fixture-test.XXXXXX")"
database_path="$test_root/Noonmark.sqlite"
result_path="$test_root/fixture-manifest.json"
app_log="$test_root/app.log"
runtime_console_log="$test_root/runtime-console.log"

cleanup() {
  runtime_evidence_stop_console_capture >/dev/null 2>&1 || true
  if [[ -n "${app_pid:-}" ]] \
      && kill -0 "$app_pid" >/dev/null 2>&1; then
    kill -TERM "$app_pid" >/dev/null 2>&1 || true
    wait "$app_pid" 2>/dev/null || true
  fi
  rm -rf "$test_root"
}
trap cleanup EXIT

app_pid=""
runtime_evidence_start_console_capture \
  "$app_executable_name" \
  "$runtime_console_log"
"$app_executable" \
  --data-url "$database_path" \
  --e2e-fixed-instant 2026-07-24T22:00:00Z \
  --e2e-fixed-time-zone America/New_York \
  --e2e-fixed-locale zh_Hans_SG \
  --e2e-zhulong-sidecar-key \
  --interactive-demo-fixture \
  --interactive-demo-result-url "$result_path" \
  --page day \
  >"$app_log" 2>&1 &
app_pid=$!

for ((attempt = 0; attempt < NOONMARK_INTERACTIVE_DEMO_READY_POLL_LIMIT; attempt += 1)); do
  if [[ -f "$result_path" ]]; then
    break
  fi
  if ! kill -0 "$app_pid" >/dev/null 2>&1; then
    wait "$app_pid" || true
    echo "demo fixture app exited before producing a manifest" >&2
    sed -n '1,160p' "$app_log" >&2
    exit 1
  fi
  sleep 0.1
done

if [[ ! -f "$result_path" ]]; then
  echo "demo fixture manifest is missing" >&2
  sed -n '1,160p' "$app_log" >&2
  exit 1
fi

view_tree_path="${result_path%.json}.view-tree.txt"

for expected in \
  '"status" : "ready"' \
  '"anchorDate" : "2026-07-24"' \
  '"fixtureProfile" : "annual-v1"' \
  '"storyDayCount" : 365' \
  '"storyDateGapCount" : 0' \
  '"storyDuplicateDateCount" : 0' \
  '"storyDayWithOrdinaryTraceCount" : 365' \
  '"featureReplayDayCount" : 12' \
  '"featureReplayCoveredQuarterCount" : 4' \
  '"zhulongSessionCount" : 20' \
  '"submittedTodoArtifactCount" : 4' \
  '"editableTodoArtifactCount" : 4' \
  '"dailyReviewReceiptCount" : 4' \
  '"habitInsightSessionCount" : 4' \
  '"taskPoolAnalysisSessionCount" : 4' \
  '"zhulongCoveredQuarterCount" : 4' \
  '"dayTodoMixedStatusSectionCount" : 2' \
  '"dayTodoGroupingPresentationVerified" : true' \
  '"taskCollectionCategoryVisibilityVerified" : true' \
  '"ideasPresentationVerified" : true' \
  '"flylightEditingInteractionVerified" : true' \
  '"flylightGlobalSuggestionVerified" : true' \
  '"completedPoolRowHierarchyVerified" : true' \
  '"visibleScopeReauthorizationCardCount" : 0' \
  '"scopeAuthorizationUIVerified" : true' \
  '"taskPoolStatisticsPresentationVerified" : true' \
  '"taskPoolProviderBoundaryVerified" : true' \
  '"taskPoolProviderReportPresentationVerified" : true' \
  '"taskCyclePresentationVerified" : true' \
  '"calendarRecurringBoundaryVerified" : true' \
  '"visibleRecurringFutureOccurrenceCount" : 16' \
  '"recurringCollectionLeakCount" : 0' \
  '"zhulongHeaderComposerHierarchyVerified" : true'; do
  if ! grep -Fq "$expected" "$result_path"; then
    echo "demo fixture manifest is missing: $expected" >&2
    sed -n '1,200p' "$result_path" >&2
    if [[ -f "$view_tree_path" ]]; then
      sed -n '1,240p' "$view_tree_path" >&2
    fi
    exit 1
  fi
done

single_day_completed_count="$(
  plutil -extract singleDayCompletedTaskCount raw -o - "$result_path"
)"
ordinary_single_day_completed_count="$(
  plutil -extract ordinarySingleDayCompletedTaskCount raw -o - "$result_path"
)"
cycle_single_day_completed_count="$(
  plutil -extract cycleSingleDayCompletedTaskCount raw -o - "$result_path"
)"
multi_day_completed_count="$(
  plutil -extract multiDayCompletedTaskCount raw -o - "$result_path"
)"
cycle_series_count="$(
  plutil -extract core.taskCycleSeriesCount raw -o - "$result_path"
)"
cycle_occurrence_count="$(
  plutil -extract core.taskCycleOccurrenceCount raw -o - "$result_path"
)"
cycle_active_count="$(
  plutil -extract core.taskCycleLifecycleCounts.active raw -o - "$result_path"
)"
cycle_upcoming_count="$(
  plutil -extract core.taskCycleLifecycleCounts.upcoming raw -o - "$result_path"
)"
cycle_ended_count="$(
  plutil -extract core.taskCycleLifecycleCounts.ended raw -o - "$result_path"
)"
cycle_stopped_count="$(
  plutil -extract core.taskCycleLifecycleCounts.stopped raw -o - "$result_path"
)"
collapsible_trail_count="$(
  plutil -extract core.taskWithCollapsibleTrailCount raw -o - "$result_path"
)"
continuable_unfinished_count="$(
  plutil -extract core.continuableUnfinishedTaskCount raw -o - "$result_path"
)"
idea_count="$(
  plutil -extract core.ideaCount raw -o - "$result_path"
)"
idea_day_count="$(
  plutil -extract core.ideaDayCount raw -o - "$result_path"
)"
idea_review_candidate_count="$(
  plutil -extract core.ideaReviewCandidateCount raw -o - "$result_path"
)"
labeled_idea_count="$(
  plutil -extract core.labeledIdeaCount raw -o - "$result_path"
)"
categorized_idea_count="$(
  plutil -extract core.categorizedIdeaCount raw -o - "$result_path"
)"
edited_idea_count="$(
  plutil -extract core.editedIdeaCount raw -o - "$result_path"
)"
tombstoned_idea_count="$(
  plutil -extract core.tombstonedIdeaCount raw -o - "$result_path"
)"
idea_tombstone_leak_count="$(
  plutil -extract core.ideaTimelineTombstoneLeakCount raw -o - "$result_path"
)"
sticky_note_count="$(
  plutil -extract core.stickyNoteCount raw -o - "$result_path"
)"
restored_idea_count="$(
  plutil -extract core.restoredIdeaCount raw -o - "$result_path"
)"
if [[ "$single_day_completed_count" -lt 365 \
      || "$ordinary_single_day_completed_count" -lt 365 \
      || "$cycle_single_day_completed_count" != "0" \
      || "$multi_day_completed_count" -lt 24 \
      || "$cycle_series_count" != "12" \
      || "$cycle_occurrence_count" -lt 500 \
      || "$cycle_active_count" != "3" \
      || "$cycle_upcoming_count" != "3" \
      || "$cycle_ended_count" != "3" \
      || "$cycle_stopped_count" != "3" \
      || "$collapsible_trail_count" -lt 12 \
      || "$continuable_unfinished_count" -lt 1 \
      || "$idea_count" != "8" \
      || "$idea_day_count" != "7" \
      || "$idea_review_candidate_count" -lt 1 \
      || "$labeled_idea_count" -lt 1 \
      || "$categorized_idea_count" -lt 1 \
      || "$edited_idea_count" -lt 1 \
      || "$tombstoned_idea_count" != "1" \
      || "$idea_tombstone_leak_count" != "0" \
      || "$sticky_note_count" -lt 3 \
      || "$restored_idea_count" -lt 1 ]]; then
  echo "demo fixture task and cycle counts drifted" >&2
  sed -n '1,200p' "$result_path" >&2
  exit 1
fi

for page in "${NOONMARK_INTERACTIVE_DEMO_TASK_COLLECTION_SCREENSHOTS[@]}"; do
  screenshot="$test_root/task-collection-$page.png"
  if [[ ! -s "$screenshot" ]]; then
    echo "task collection screenshot is missing: $screenshot" >&2
    exit 1
  fi
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"
  if [[ -z "$width" || -z "$height" \
        || "$width" -lt 600 || "$height" -lt 400 ]]; then
    echo "invalid task collection screenshot size: $screenshot" >&2
    exit 1
  fi
done

for screenshot_name in "${NOONMARK_INTERACTIVE_DEMO_DOCUMENTATION_SCREENSHOTS[@]}"; do
  screenshot="$test_root/$screenshot_name.png"
  if [[ ! -s "$screenshot" ]]; then
    echo "documentation screenshot is missing: $screenshot" >&2
    exit 1
  fi
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"
  if [[ -z "$width" || -z "$height" \
        || "$width" -lt 500 || "$height" -lt 160 ]]; then
    echo "invalid documentation screenshot size: $screenshot" >&2
    exit 1
  fi
done

for screenshot_name in "${NOONMARK_INTERACTIVE_DEMO_FORBIDDEN_DOCUMENTATION_SCREENSHOTS[@]}"; do
  screenshot="$test_root/$screenshot_name.png"
  if [[ -e "$screenshot" ]]; then
    echo "sensitive documentation screenshot must not be produced: $screenshot" >&2
    exit 1
  fi
done

if [[ ! -s "$database_path" ]]; then
  echo "demo fixture SQLite database was not persisted" >&2
  exit 1
fi

sidecar_count="$(
  find "$test_root/ZhulongSidecar" -type f -name '*.zhs' \
    | wc -l \
    | tr -d ' '
)"
if [[ "$sidecar_count" != "20" ]]; then
  echo "expected 20 encrypted Zhulong sessions, found $sidecar_count" >&2
  exit 1
fi

runtime_evidence_stop_console_capture
runtime_evidence_assert_clean_logs \
  "interactive demo fixture" \
  "$app_log" \
  "$runtime_console_log"

echo "interactive demo fixture: ok"
