#!/usr/bin/env bash
set -euo pipefail

scripts/build-mac-app "${1:-debug}"

mkdir -p artifacts/e2e
pkill -x SuntraceMacApp 2>/dev/null || true
trap 'pkill -x SuntraceMacApp 2>/dev/null || true' EXIT

open -n dist/SuntraceMacApp.app --args --page calendar
sleep "${SUNTRACE_E2E_STARTUP_WAIT:-3}"

window_id="$(
  swift -e '
import CoreGraphics
import Darwin

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner == "晷迹" || owner.contains("Suntrace") || name.contains("suntrace") {
            if let number = window[kCGWindowNumber as String] {
                print(number)
                exit(0)
            }
        }
    }
}
exit(1)
'
)"

screencapture -x -l "$window_id" artifacts/e2e/calendar.png
width="$(sips -g pixelWidth artifacts/e2e/calendar.png | awk '/pixelWidth/ {print $2}')"
height="$(sips -g pixelHeight artifacts/e2e/calendar.png | awk '/pixelHeight/ {print $2}')"

if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 ]]; then
  echo "invalid e2e screenshot size: ${width:-unknown}x${height:-unknown}" >&2
  exit 1
fi

echo "E2E calendar screenshot: artifacts/e2e/calendar.png (${width}x${height})"
pkill -x SuntraceMacApp 2>/dev/null || true
