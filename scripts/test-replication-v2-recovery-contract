  --filter LocalFirstReplicationTests/testForkDescendantCreatesANewDurableResolutionInsteadOfBeingIgnored
swift test \
  --filter LocalFirstReplicationTests/testConflictFreeForkRepairsPublishesBaselineAndStaysClosedAfterRestart
swift test \
  --filter LocalFirstReplicationTests/testForkWithDomainConflictDoesNotApplyAdvanceCursorOrPublishBaseline
swift test \
  --filter LocalFirstReplicationTests/testKeepCurrentForkDecisionAtomicallyClosesAndPublishesRepairBaseline
