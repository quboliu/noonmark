  --e2e-quit-after-automation

if [[ ! -f "$zhulong_corruption_result" || "$(cat "$zhulong_corruption_result")" != "corruption-detected" ]]; then
  echo "zhulong corrupted sidecar was not reported fail-closed" >&2
  exit 1
fi

echo "E2E zhulong encrypted persistence and corruption detection: $zhulong_sidecar_dir (sessions=$zhulong_session_count)"

