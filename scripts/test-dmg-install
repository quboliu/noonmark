source scripts/runtime-evidence
source scripts/dmg-install-observer-common
# shellcheck source=scripts/evidence-common
source scripts/evidence-common
# shellcheck source=scripts/runtime-profile-common
source scripts/runtime-profile-common

dmg_path="${1:-dist/Noonmark.dmg}"
package_manifest_path="${dmg_path}.manifest"
package_inventory_path="${dmg_path}.inventory.sha256"
app_short_name="${NOONMARK_APP_SHORT_NAME:-Noonmark}"
evidence_validate_artifact_basename "$app_short_name" "App short name"
work_dir="${repo_root}/artifacts/dmg-install"
install_dir="${work_dir}/Applications"
helper_evidence_root="${repo_root}/artifacts/dmg-install-harness"
helper_app="${repo_root}/artifacts/dmg-install-harness/NoonmarkDMGInstallHarness.app"
helper_executable_name="NoonmarkDMGInstallHarness"
helper_executable="${helper_app}/Contents/MacOS/${helper_executable_name}"
helper_bundle_identifier="app.noonmark.test.dmg-install-harness"
production_bundle_identifier="app.noonmark.mac"
validation_bundle_identifier="app.noonmark.mac.dmg-validation"
validation_bundle_name="NoonmarkDMGValidation.app"
validation_executable_name="NoonmarkMacAppDMGValidation"
validation_data_directory_name="noonmark-dmg-validation"
validation_icloud_repository="Noonmark-DMGValidation/SyncRepository"
window_runtime_evidence_root=""
task_title="dmgvalidationtask"
database_path=""
screenshot_path="${work_dir}/installed-day.png"
window_metadata_path="${work_dir}/installed-day-window.txt"
initial_launch_log="${work_dir}/initial-launch.log"
