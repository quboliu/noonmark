            "lane:entry.dataset.wovenLane,role:entry.dataset.wovenRole,milestone:entry.dataset.wovenMilestone||''}))"
        )
        self.check(
            "variant-c-todo-receipt-is-an-explicit-full-width-result-boundary",
            len(receipt_roles) == 1
            and receipt_roles[0] == {"lane": "full", "role": "receipt", "milestone": "结果回执"},
