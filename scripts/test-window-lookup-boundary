#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

verifier="$repo_root/scripts/verify-window-lookup-boundary"
debug_root="$repo_root/.build/arm64-apple-macosx/debug"
if [[ ! -x "$debug_root/NoonmarkMacApp" ]]; then
  debug_root="$repo_root/.build/debug"
fi
app_binary="$debug_root/NoonmarkMacApp"
helper_binary="$debug_root/NoonmarkDMGInstallHarness"
probe_binary="$debug_root/NoonmarkWindowProbe"

if [[ ! -x "$app_binary" || ! -x "$helper_binary" || ! -x "$probe_binary" ]]; then
  echo "window lookup boundary test requires App, helper, and probe executables" >&2
  exit 1
fi
if [[ ! -x "$verifier" ]]; then
  echo "window lookup boundary verifier is missing" >&2
  exit 1
fi

private_symbol="_AXUIElementGetWindow"
reject_source_literal() {
  local literal="$1"
  local message="$2"
  shift 2
  local scan_status=0

  /usr/bin/grep -R -Fq "$literal" "$@" || scan_status=$?
  case "$scan_status" in
    0)
      echo "$message" >&2
      return 1
      ;;
    1) return 0 ;;
    *)
      echo "could not scan runtime source for forbidden literal: $literal" >&2
      return 1
      ;;
  esac
}

runtime_sources=(
  "$repo_root/App"
  "$repo_root/Sources"
  "$repo_root/Tools"
  "$repo_root/scripts/test-e2e"
  "$repo_root/scripts/test-dmg-install"
)
window_query_sources=(
  "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift"
)
reject_source_literal \
  'CGWindowListCreateDescriptionFromArray' \
  'runtime source contains the known-broken exact-window query' \
  "${runtime_sources[@]}" || exit 1
for source in "${window_query_sources[@]}"; do
  for forbidden_option in \
    '.optionOnScreenOnly' \
    '.optionAll' \
    '.optionOnScreenAboveWindow' \
    '.optionOnScreenBelowWindow' \
    'kCGNullWindowID'; do
    reject_source_literal \
      "$forbidden_option" \
      "runtime source contains a WindowServer enumeration option: $source" \
      "$source" || exit 1
  done
done
if ! query_source_output="$(
  /usr/bin/grep -R -l -F 'CGWindowListCopyWindowInfo' \
    "${runtime_sources[@]}"
)"; then
  echo "could not locate the canonical WindowServer query source" >&2
  exit 1
fi
while IFS= read -r source; do
  [[ -n "$source" ]] || continue
  case "$source" in
    "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift")
      ;;
    *)
      echo "WindowServer query escaped its reviewed choke points: $source" >&2
      exit 1
      ;;
  esac
done <<<"$query_source_output"
if ! /usr/bin/grep -Fq 'CGWindowListCopyWindowInfo' \
  "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift" ||
  ! /usr/bin/grep -Fq '[.optionIncludingWindow]' \
  "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift"; then
  echo "shared window lookup lacks published exact-ID semantics" >&2
  exit 1
fi
if ! exact_query_count="$(
  /usr/bin/grep -c -F 'CGWindowListCopyWindowInfo(' \
    "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift"
)" || ! exact_option_count="$(
  /usr/bin/grep -c -F '[.optionIncludingWindow]' \
    "$repo_root/Sources/NoonmarkMacE2ESupport/ScopedWindowServerLookup.swift"
)"; then
  echo "could not count the canonical exact-ID query implementation" >&2
  exit 1
fi
if [[ "$exact_query_count" != "1" || "$exact_option_count" != "1" ]]; then
  echo "shared window lookup must own exactly one exact-ID query implementation" >&2
  exit 1
fi
reject_source_literal \
  "$private_symbol" \
  'production source contains the helper-only private SPI literal' \
  "$repo_root/App" "$repo_root/Sources" || exit 1
reject_source_literal \
  '@_silgen_name' \
  'DMG helper directly declares a private SPI symbol' \
  "$repo_root/Tools/NoonmarkDMGInstallHarness/AXTarget.swift" || exit 1
if ! /usr/bin/grep -Fq \
  'dlsym(defaultHandle, "_AXUIElementGetWindow")' \
  "$repo_root/Tools/NoonmarkDMGInstallHarness/AXTarget.swift"; then
  echo "DMG helper has no fail-closed dynamic private SPI lookup" >&2
  exit 1
fi
reject_source_literal \
  'NoonmarkDMGInstallHarness' \
  'production package script names the test-only DMG helper' \
  "$repo_root/scripts/package-dmg" || exit 1
reject_source_literal \
  'NoonmarkWindowProbe' \
  'production package script names the test-only window probe' \
  "$repo_root/scripts/package-dmg" || exit 1

fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-window-boundary.XXXXXX")"
cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT

"$verifier" production-binary "$app_binary"
"$verifier" helper-binary "$helper_binary"
"$verifier" probe-binary "$probe_binary"
if "$probe_binary" --window-number 0 \
  >"$fixture_root/probe-invalid.stdout" \
  2>"$fixture_root/probe-invalid.stderr"; then
  echo "window probe accepted a non-positive exact window ID" >&2
  exit 1
fi
if [[ -s "$fixture_root/probe-invalid.stdout" ||
  "$(<"$fixture_root/probe-invalid.stderr")" != "invalid-input" ]]; then
  echo "window probe invalid-input contract drifted" >&2
  exit 1
fi

malicious_app="$fixture_root/NoonmarkMacApp"
cp "$app_binary" "$malicious_app"
printf '\n_AXUIElementGetWindow\n' >>"$malicious_app"
chmod +x "$malicious_app"
if "$verifier" production-binary "$malicious_app" >/dev/null 2>&1; then
  echo "production boundary accepted a private SPI literal" >&2
  exit 1
fi

if "$verifier" helper-binary "$app_binary" >/dev/null 2>&1; then
  echo "helper boundary accepted a binary without the dynamic SPI resolver" >&2
  exit 1
fi

staging_root="$fixture_root/staging"
mkdir -p "$staging_root/Noonmark.app/Contents/MacOS"
cp \
  "$app_binary" \
  "$staging_root/Noonmark.app/Contents/MacOS/NoonmarkMacApp"
ln -s /Applications "$staging_root/Applications"
"$verifier" dmg-staging-root "$staging_root"

mkdir -p "$staging_root/NoonmarkDMGInstallHarness.app"
if "$verifier" dmg-staging-root "$staging_root" \
  >/dev/null 2>&1; then
  echo "DMG staging boundary accepted the install harness" >&2
  exit 1
fi
rm -rf "$staging_root/NoonmarkDMGInstallHarness.app"
mkdir -p "$staging_root/Noonmark.app/Contents/Resources"
cp \
  "$probe_binary" \
  "$staging_root/Noonmark.app/Contents/Resources/window-metadata"
chmod 644 "$staging_root/Noonmark.app/Contents/Resources/window-metadata"
if "$verifier" dmg-staging-root "$staging_root" \
  >/dev/null 2>&1; then
  echo "DMG staging boundary accepted the test-only window probe" >&2
  exit 1
fi
rm -f "$staging_root/Noonmark.app/Contents/Resources/window-metadata"

if NOONMARK_WINDOW_BOUNDARY_INJECT_APP_FIND_FAILURE=1 \
  "$verifier" dmg-staging-root "$staging_root" \
  >/dev/null 2>&1; then
  echo "DMG staging boundary ignored an incomplete App file enumeration" >&2
  exit 1
fi

echo "Window lookup binary boundary passed"
