        last_layout_scroll = None
        layout_scroll_deadline = time.monotonic() + 1.0
        while time.monotonic() < layout_scroll_deadline and stable_layout_scroll < 3:
            current_layout_scroll = self.evaluate("document.querySelector('[data-stream-scroll]').scrollTop")
            stable_layout_scroll = stable_layout_scroll + 1 if last_layout_scroll is not None and abs(current_layout_scroll - last_layout_scroll) <= 0.75 else 0
            last_layout_scroll = current_layout_scroll
            time.sleep(0.05)
        self.check(
            "physical-layout-anchor-wheel-settles-before-view-switch",
            stable_layout_scroll >= 3,
            json.dumps({"scrollTop": last_layout_scroll, "stableSamples": stable_layout_scroll}, sort_keys=True),
        )
        layout_anchor = self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');const box=scroller.getBoundingClientRect();"
            "const inset=document.querySelector('.mac-window').dataset.variant==='C'?42:0;const visibleTop=box.top+inset;"
            "const target=[...document.querySelectorAll('[data-stream-node]')].find((node)=>{const rect=node.getBoundingClientRect();"
            "return node.offsetParent!==null&&rect.bottom>visibleTop+1&&rect.top<box.bottom-1});const rect=target.getBoundingClientRect();"
            "return {id:target.dataset.nodeId,visibleOffset:rect.top-visibleTop,scrollTop:scroller.scrollTop};})()"
        )
        anchor_snapshot = self.snapshot()
        anchor_samples = []
        for layout in ["A", "B", "C"]:
            self.choose_layout(layout)
            sample = self.evaluate(
                f"(() => {{const scroller=document.querySelector('[data-stream-scroll]');"
                f"const target=document.getElementById({json.dumps(layout_anchor['id'])});"
                "const scrollerBox=scroller.getBoundingClientRect();const targetBox=target.getBoundingClientRect();"
                "const inset=document.querySelector('.mac-window').dataset.variant==='C'?42:0;const visibleTop=scrollerBox.top+inset;return {"
                "variant:document.querySelector('.mac-window').dataset.variant,id:target.dataset.nodeId,"
                "visible:target.offsetParent!==null&&targetBox.bottom>visibleTop+1&&targetBox.top<scrollerBox.bottom-1,"
                "visibleOffset:targetBox.top-visibleTop,sameScroller:scroller===window.__layoutScroller,"
                "userOwns:document.querySelector('[data-return-current]').classList.contains('visible')};})()"
            )
            anchor_samples.append(sample)
            self.check(
