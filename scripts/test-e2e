assert_pool_detail_density_screenshot() {
  local screenshot="artifacts/e2e/pool-detail.png"
  local result="artifacts/e2e/pool-detail-density.txt"
  local result_log="artifacts/e2e/pool-detail-density.log"

  if [[ -n "$requested_scenarios" && " $requested_scenarios " != *" pool-detail "* ]]; then
    return 0
  fi
  if [[ ! -f "$screenshot" ]]; then
    echo "pool detail screenshot is missing: $screenshot" >&2
    exit 1
  fi
  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$screenshot" swift -e '
import AppKit
import Foundation
import Vision

guard let path = ProcessInfo.processInfo.environment["NOONMARK_E2E_OCR_IMAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    exit(1)
}

let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["zh-Hans", "en-US"]
request.usesLanguageCorrection = false
try VNImageRequestHandler(cgImage: cgImage).perform([request])
let observations = request.results ?? []
let railObservations = observations.filter { $0.boundingBox.minX > 0.70 }
func observation(_ expected: String) -> VNRecognizedTextObservation? {
    railObservations.first { $0.topCandidates(1).first?.string == expected }
}
guard let title = observation("预约年度体检"),
      let description = observation("预约年度体检时间。")
else {
    print("missing deterministic pool-detail title or description")
    exit(2)
}
let expectedWindowWidth = CGFloat(
    Double(ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_WIDTH"] ?? "") ?? 0
)
guard expectedWindowWidth > 0 else {
    print("missing expected window width")
    exit(5)
}
let backingScale = CGFloat(cgImage.width) / expectedWindowWidth
let visibleGap = (title.boundingBox.minY - description.boundingBox.maxY)
    * CGFloat(cgImage.height) / backingScale
let roundedGap = visibleGap.rounded()
guard roundedGap >= 10, roundedGap <= 14 else {
    print("title-description visible gap is \(visibleGap)pt; expected rounded 10...14pt")
    exit(3)
}
let visibleLabels = railObservations.compactMap {
    $0.topCandidates(1).first?.string
}
let required = ["尚未进入任何", "Day Todo"]
guard required.allSatisfy({ expected in
    visibleLabels.contains { $0.contains(expected) }
}) else {
    print("pool detail is missing its scheduling consequence: \(visibleLabels)")
    exit(4)
}
let forbidden = ["更换", "未排期", "任务链仍在任务池", "任务链状态", "活跃"]
let redundantLabels = visibleLabels.filter { label in
    forbidden.contains { label.contains($0) }
}
guard redundantLabels.isEmpty else {
    print("pool detail still contains redundant labels: \(redundantLabels)")
    exit(6)
}
print(String(format: "title-description visible gap: %.2fpt", visibleGap))
' >"$result" 2>"$result_log"; then
    echo "pool detail density screenshot assertion failed:" >&2
    cat "$result" >&2
    cat "$result_log" >&2
    exit 1
  fi
  echo "E2E pool detail density: $(cat "$result")"
}

assert_sidebar_semantic_icon_colors_screenshot() {
  local screenshot="artifacts/e2e/day.png"
  local zhulong_screenshot="artifacts/e2e/zhulong.png"
  local result="artifacts/e2e/sidebar-semantic-icon-colors.txt"
  local result_log="artifacts/e2e/sidebar-semantic-icon-colors.log"
  local verify_day=1
  local verify_zhulong=1

  if [[ -n "$requested_scenarios" ]]; then
    verify_day=0
    verify_zhulong=0
    if [[ " $requested_scenarios " == *" day "* ]]; then
      verify_day=1
    fi
    if [[ " $requested_scenarios " == *" zhulong "* ]]; then
      verify_zhulong=1
    fi
  fi
  if [[ "$verify_day" == "0" && "$verify_zhulong" == "0" ]]; then
    return 0
  fi
  if [[ "$verify_day" == "1" && ! -f "$screenshot" ]]; then
    echo "sidebar semantic icon color screenshot is missing: $screenshot" >&2
    exit 1
  fi
  if [[ "$verify_zhulong" == "1" && ! -f "$zhulong_screenshot" ]]; then
    echo "Zhulong sidebar semantic icon color screenshot is missing: $zhulong_screenshot" >&2
    exit 1
  fi
  if ! NOONMARK_E2E_DAY_IMAGE="$PWD/$screenshot" \
    NOONMARK_E2E_ZHULONG_IMAGE="$PWD/$zhulong_screenshot" \
    NOONMARK_E2E_VERIFY_DAY="$verify_day" \
    NOONMARK_E2E_VERIFY_ZHULONG="$verify_zhulong" swift -e '
import AppKit
import Foundation

let environment = ProcessInfo.processInfo.environment
func loadImage(_ key: String) -> NSBitmapImageRep? {
    guard let path = environment[key],
          let data = try? Data(contentsOf: URL(fileURLWithPath: path))
    else {
        return nil
    }
    return NSBitmapImageRep(data: data)
}

let verifyDay = environment["NOONMARK_E2E_VERIFY_DAY"] == "1"
let verifyZhulong = environment["NOONMARK_E2E_VERIFY_ZHULONG"] == "1"
let dayImage = verifyDay ? loadImage("NOONMARK_E2E_DAY_IMAGE") : nil
let zhulongImage = verifyZhulong ? loadImage("NOONMARK_E2E_ZHULONG_IMAGE") : nil
guard (!verifyDay || dayImage != nil), (!verifyZhulong || zhulongImage != nil) else {
    exit(1)
}

let dayIcons: [(name: String, centerY: Double, rgb: Int)] = verifyDay ? [
    ("day", 83, 0x2A6FDB),
    ("pool", 125.5, 0x0E9488),
    ("future", 156.5, 0x7C5CFF),
    ("unfinished", 225, 0xE0851B),
    ("completed", 261.5, 0x1F8A5B),
    ("calendar", 299.5, 0xD1477A),
] : []
let zhulongIcons: [(name: String, centerY: Double, rgb: Int)] = verifyZhulong ? [
    ("zhulong", 336.5, 0x7C5CFF),
] : []
var results: [String] = []
for (image, icons) in [(dayImage, dayIcons), (zhulongImage, zhulongIcons)] {
    guard let image else { continue }
    let scale = Double(image.pixelsWide) / 1_200
    for icon in icons {
        let expected = NSColor(
            srgbRed: CGFloat((icon.rgb >> 16) & 0xFF) / 255,
            green: CGFloat((icon.rgb >> 8) & 0xFF) / 255,
            blue: CGFloat(icon.rgb & 0xFF) / 255,
            alpha: 1
        )
        var matchingPixels = 0
        for y in Int((icon.centerY - 11) * scale)..<Int((icon.centerY + 11) * scale) {
            for x in Int(18 * scale)..<Int(44 * scale) {
                guard let color = image.colorAt(x: x, y: y)?.usingColorSpace(.sRGB) else {
                    continue
                }
                let high = max(color.redComponent, color.greenComponent, color.blueComponent)
                let low = min(color.redComponent, color.greenComponent, color.blueComponent)
                let saturation = high == 0 ? 0 : (high - low) / high
                let rawHueDistance = abs(color.hueComponent - expected.hueComponent)
                let hueDistance = min(rawHueDistance, 1 - rawHueDistance)
                if saturation > 0.32, hueDistance < 0.08 {
                    matchingPixels += 1
                }
            }
        }
        guard matchingPixels >= 80 else {
            fputs("\(icon.name) semantic icon color missing (pixels=\(matchingPixels))\n", stderr)
            exit(1)
        }
        results.append("\(icon.name)=\(matchingPixels)")
    }
}
print(results.joined(separator: " "))
' >"$result" 2>"$result_log"; then
    echo "sidebar semantic icon color screenshot probe failed:" >&2
    cat "$result_log" >&2
    exit 1
  fi
  echo "E2E sidebar semantic icon colors: $screenshot ($(cat "$result"))"
}

run_task_note_persistence_probe() {
  local note_dir="artifacts/e2e-task-notes"
  local note_db="${note_dir}/Noonmark.sqlite"
  local note_state="${note_dir}/state.json"
  local mutate_result="${note_dir}/mutate-result.txt"
  local restart_result="${note_dir}/restart-result.txt"
  local mutate_log="${note_dir}/mutate.log"
  local restart_log="${note_dir}/task-note-restart.log"
  local restart_screenshot="${note_dir}/task-note-restart.png"
  local restart_ocr="${note_dir}/task-note-restart-ocr.txt"
  local restart_ocr_log="${note_dir}/task-note-restart-ocr.log"
  local copy_result="${note_dir}/english-copy-result.txt"
  local copy_log="${note_dir}/english-copy.log"
  local mutate_pid
  local note_sql_probe

  rm -rf "$note_dir"
  mkdir -p "$note_dir"

  "$app_executable_path" \
    --data-url "$PWD/$note_db" \
    --page pool \
    --e2e-task-note-mutate \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$mutate_result" \
    >"$mutate_log" 2>&1 &
  mutate_pid=$!
  for _ in {1..100}; do
    if ! kill -0 "$mutate_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$mutate_pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$mutate_pid" 2>/dev/null || true
    echo "task-note mutation automation did not terminate" >&2
    cat "$mutate_log" >&2
    exit 1
  fi
  if ! wait "$mutate_pid"; then
    echo "task-note mutation app launch failed:" >&2
    cat "$mutate_log" >&2
    exit 1
  fi

  if [[ ! -f "$mutate_result" ]]; then
    echo "task-note mutation result was not created: $mutate_result" >&2
    exit 1
  fi
  if [[ "$(<"$mutate_result")" != "ok" ]]; then
    echo "task-note mutation failed: $(<"$mutate_result")" >&2
    exit 1
  fi
  if [[ ! -s "$note_state" ]]; then
    echo "task-note mutation state was not created: $note_state" >&2
    exit 1
  fi
  assert_clean_app_log "task-note mutation" "$mutate_log"

  capture_app_screenshot \
    "$note_dir" \
    "task-note-restart" \
    day \
    --data-url "$PWD/$note_db" \
    --e2e-task-note-verify \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$restart_result"

  if [[ ! -f "$restart_result" ]]; then
    echo "task-note restart result was not created: $restart_result" >&2
    terminate_e2e_app
    exit 1
  fi
  if [[ "$(<"$restart_result")" != "ok" ]]; then
    echo "task-note restart verification failed: $(<"$restart_result")" >&2
    terminate_e2e_app
    exit 1
  fi
  terminate_e2e_app
  assert_clean_app_log "task-note restart" "$restart_log"

  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$restart_screenshot" swift -e '
import AppKit
import Foundation
import Vision

let environment = ProcessInfo.processInfo.environment
guard let path = environment["NOONMARK_E2E_OCR_IMAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    fputs("unable to load task-note screenshot for OCR\n", stderr)
    exit(1)
}

let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["en-US"]
request.usesLanguageCorrection = false
let handler = VNImageRequestHandler(cgImage: cgImage)
try handler.perform([request])
let text = (request.results ?? [])
    .compactMap { $0.topCandidates(1).first?.string }
    .joined(separator: "\n")
print(text)
' >"$restart_ocr" 2>"$restart_ocr_log"; then
    echo "task-note restart screenshot OCR failed:" >&2
    cat "$restart_ocr_log" >&2
    exit 1
  fi

  if ! grep -Fq "VISIBLE NOTE 7263" "$restart_ocr"; then
    echo "task-note edited body was not visible after restart; OCR output:" >&2
    cat "$restart_ocr" >&2
    exit 1
  fi
  if grep -Fq "GHOST NOTE 9184" "$restart_ocr"; then
    echo "task-note deleted body reappeared after restart; OCR output:" >&2
    cat "$restart_ocr" >&2
    exit 1
  fi

  note_sql_probe="$(sqlite3 -separator " " "$note_db" "
    WITH target AS (
      SELECT
        trace.note_entries_json AS trace_note_entries_json,
        chain.note_entries_json AS chain_note_entries_json
      FROM day_traces AS trace
      JOIN task_definitions AS definition ON definition.id = trace.definition_id
      JOIN task_chains AS chain ON chain.id = trace.chain_id
      WHERE definition.title = 'E2E 附言编辑删除'
        AND trace.date = '2026-07-05'
      LIMIT 1
    )
    SELECT
      json_array_length(trace_note_entries_json),
      (SELECT count(DISTINCT json_extract(value, '$.id.rawValue'))
       FROM json_each(trace_note_entries_json)),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_extract(value, '$.body') = 'VISIBLE NOTE 7263'
         AND json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_extract(value, '$.body') = ''
         AND json_type(value, '$.deletedAt') IN ('integer', 'real')
         AND json_extract(value, '$.updatedAt') = json_extract(value, '$.deletedAt')),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'GHOST NOTE 9184') > 0),
      (SELECT count(*)
       FROM json_each(chain_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NULL),
      (SELECT count(*)
       FROM json_each(trace_note_entries_json)
       WHERE json_type(value, '$.deletedAt') IN ('integer', 'real'))
    FROM target;
  ")"

  if [[ "$note_sql_probe" != "2 2 1 1 0 2 1 1" ]]; then
    echo "task-note SQLite JSON probe failed: ${note_sql_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note English copy" \
    "$copy_result" \
    "$copy_log" \
    --data-url "$PWD/$note_db" \
    --page day \
    --e2e-task-note-copy-contract \
    --e2e-task-note-state-url "$PWD/$note_state" \
    --e2e-task-note-result-url "$PWD/$copy_result"

  echo "E2E task-note edit/delete restart and English copy: $note_db (probe=$note_sql_probe screenshot=$restart_screenshot)"
}

run_task_note_mutation_atomicity_probe() {
  local atomicity_dir="artifacts/e2e-task-note-atomicity"
  local atomicity_db="${atomicity_dir}/Noonmark.sqlite"
  local atomicity_state="${atomicity_dir}/state.json"
  local exercise_result="${atomicity_dir}/exercise-result.txt"
  local ui_result="${atomicity_dir}/ui-result.txt"
  local restart_result="${atomicity_dir}/restart-result.txt"
  local exercise_log="${atomicity_dir}/exercise.log"
  local ui_log="${atomicity_dir}/ui.log"
  local restart_log="${atomicity_dir}/restart.log"
  local exercise_marker_count
  local ui_marker_count
  local sql_probe

  rm -rf "$atomicity_dir"
  mkdir -p "$atomicity_dir"

  run_terminating_ui_probe \
    "task-note mutation atomicity exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$atomicity_db" \
    --page pool \
    --e2e-persistence-failure-automation \
    --e2e-task-note-atomicity-exercise \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  exercise_marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$exercise_log" || true)"
  if [[ "$exercise_marker_count" -ne 6 ]]; then
    echo "task-note atomicity exercise did not inject exactly six save failures: $exercise_marker_count" >&2
    cat "$exercise_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note mutation atomicity UI" \
    "$ui_result" \
    "$ui_log" \
    --data-url "$PWD/$atomicity_db" \
    --page day \
    --e2e-persistence-failure-automation \
    --e2e-task-note-atomicity-ui-edit \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$ui_result"

  ui_marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$ui_log" || true)"
  if [[ "$ui_marker_count" -ne 1 ]]; then
    echo "task-note atomicity UI did not inject exactly one save failure: $ui_marker_count" >&2
    cat "$ui_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-note mutation atomicity restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$atomicity_db" \
    --page day \
    --e2e-task-note-atomicity-verify \
    --e2e-task-note-atomicity-state-url "$PWD/$atomicity_state" \
    --e2e-task-note-atomicity-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$atomicity_db" "
    SELECT
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM day_traces),
      (SELECT sum(json_array_length(note_entries_json)) FROM task_chains),
      (SELECT sum(json_array_length(note_entries_json)) FROM day_traces),
      (SELECT count(*) FROM task_chains, json_each(task_chains.note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NOT NULL)
        +
      (SELECT count(*) FROM day_traces, json_each(day_traces.note_entries_json)
       WHERE json_type(value, '$.deletedAt') IS NOT NULL),
      (SELECT count(*) FROM task_chains, json_each(task_chains.note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'UNSAVED') > 0)
        +
      (SELECT count(*) FROM day_traces, json_each(day_traces.note_entries_json)
       WHERE instr(json_extract(value, '$.body'), 'UNSAVED') > 0),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sql_probe" != "2 1 4 2 0 0 7" ]]; then
    echo "task-note mutation atomicity SQLite/restart probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E task-note mutation atomicity UI/SQLite restart: $atomicity_db (probe=$sql_probe)"
}

run_reactivation_atomicity_probe() {
  local reactivation_dir="artifacts/e2e-reactivation-atomicity"
  local reactivation_db="${reactivation_dir}/Noonmark.sqlite"
  local reactivation_state="${reactivation_dir}/state.json"
  local exercise_result="${reactivation_dir}/exercise-result.txt"
  local restart_result="${reactivation_dir}/restart-result.txt"
  local exercise_log="${reactivation_dir}/exercise.log"
  local restart_log="${reactivation_dir}/restart.log"
  local marker_count
  local sql_probe

  rm -rf "$reactivation_dir"
  mkdir -p "$reactivation_dir"

  run_terminating_ui_probe \
    "reactivation atomicity exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$reactivation_db" \
    --page unfinished \
    --e2e-persistence-failure-automation \
    --e2e-reactivation-atomicity-exercise \
    --e2e-reactivation-atomicity-state-url "$PWD/$reactivation_state" \
    --e2e-reactivation-atomicity-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  marker_count="$(grep -cF 'Noonmark E2E injected persistence save failure' "$exercise_log" || true)"
  if [[ "$marker_count" -ne 1 ]]; then
    echo "reactivation atomicity did not inject exactly one save failure: $marker_count" >&2
    cat "$exercise_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "reactivation atomicity restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$reactivation_db" \
    --page unfinished \
    --e2e-reactivation-atomicity-verify \
    --e2e-reactivation-atomicity-state-url "$PWD/$reactivation_state" \
    --e2e-reactivation-atomicity-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$reactivation_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       JOIN task_definitions ON task_definitions.chain_id = task_chains.id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND task_chains.state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND day_traces.status = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 重新启用保存失败'
         AND day_traces.status = 'pending'),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sql_probe" != "1 1 0 5" ]]; then
    echo "reactivation atomicity SQLite/restart probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E reactivation atomicity SQLite restart: $reactivation_db (probe=$sql_probe)"
}

run_ui_entry_probes() {
  local entry_dir="artifacts/e2e-ui-entry"
  local classification_result="${entry_dir}/classification-manager-result.txt"
  local classification_labels_result="${entry_dir}/classification-manager-labels-result.txt"
  local classification_overflow_result="${entry_dir}/classification-overflow-result.txt"
  local zhulong_result="${entry_dir}/zhulong-workflows-result.txt"
  local classification_log="${entry_dir}/classification-manager.log"
  local classification_labels_log="${entry_dir}/classification-manager-labels.log"
  local classification_overflow_log="${entry_dir}/classification-overflow.log"
  local zhulong_log="${entry_dir}/zhulong-workflows.log"

  rm -rf "$entry_dir"
  mkdir -p "$entry_dir"

  run_terminating_ui_probe \
    "classification manager UI entry" \
    "$classification_result" \
    "$classification_log" \
    --ephemeral \
    --page pool \
    --select first \
    --e2e-classification-manager-via-ui \
    --e2e-classification-manager-ui-result-url "$PWD/$classification_result"

  run_terminating_ui_probe \
    "classification manager labels UI entry" \
    "$classification_labels_result" \
    "$classification_labels_log" \
    --ephemeral \
    --page pool \
    --select first \
    --e2e-classification-manager-labels-via-ui \
    --e2e-classification-manager-ui-result-url "$PWD/$classification_labels_result"

  run_terminating_ui_probe \
    "classification overflow UI entry" \
    "$classification_overflow_result" \
    "$classification_overflow_log" \
    --ephemeral \
    --page pool \
    --e2e-classification-overflow-via-ui \
    --e2e-classification-overflow-ui-result-url "$PWD/$classification_overflow_result"

  run_terminating_ui_probe \
    "zhulong workflow UI entry" \
    "$zhulong_result" \
    "$zhulong_log" \
    --ephemeral \
    --page zhulong \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-zhulong-workflows-via-ui \
    --e2e-zhulong-workflows-ui-result-url "$PWD/$zhulong_result"

  echo "E2E real UI entries: $classification_result $classification_labels_result $classification_overflow_result $zhulong_result"
}

