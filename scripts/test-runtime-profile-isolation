assert_namespace_replacement_rejected() {
  local label="$1"
  local source_path="$2"
  local backup_path="$3"
  local target_path="$4"
  local canary_path="$5"
  local marker_path="$fixture_root/$label-race-injected"
  local race_status=0
  local canary_value=""

  NOONMARK_TEST_NAMESPACE_RACE_SOURCE="$source_path"
  NOONMARK_TEST_NAMESPACE_RACE_BACKUP="$backup_path"
  NOONMARK_TEST_NAMESPACE_RACE_TARGET="$target_path"
  NOONMARK_TEST_NAMESPACE_RACE_MARKER="$marker_path"
  run_reset development
  race_status="$reset_status"
  unset \
    NOONMARK_TEST_NAMESPACE_RACE_SOURCE \
    NOONMARK_TEST_NAMESPACE_RACE_BACKUP \
    NOONMARK_TEST_NAMESPACE_RACE_TARGET \
    NOONMARK_TEST_NAMESPACE_RACE_MARKER

  if [[ -f "$canary_path" && ! -L "$canary_path" ]]; then
    canary_value="$(<"$canary_path")"
  fi

  if [[ -L "$source_path" ]]; then
    /bin/rm -f -- "$source_path"
  fi
  if [[ -e "$backup_path" && ! -L "$backup_path" ]]; then
    /bin/mv -- "$backup_path" "$source_path"
  fi

  if [[ "$race_status" -eq 0 ]]; then
    echo "$label namespace replacement was accepted" >&2
    sed -n '1,120p' "$trace_path" >&2
    exit 1
  fi
  if [[ "$canary_value" != "external-canary" ]]; then
    echo "$label namespace replacement changed its external canary" >&2
    sed -n '1,120p' "$trace_path" >&2
    exit 1
  fi
}

ancestor_source="$fixture_home/Library/Application Support"
ancestor_backup="$fixture_home/Library/Application Support.bound-before-race"
ancestor_target="$fixture_root/ancestor-race-target"
mkdir -p "$development_data" "$ancestor_target/noonmark-development"
printf 'selected-canary\n' >"$development_data/selected-canary"
printf 'external-canary\n' \
  >"$ancestor_target/noonmark-development/external-canary"
assert_namespace_replacement_rejected \
  "ancestor" \
  "$ancestor_source" \
  "$ancestor_backup" \
  "$ancestor_target" \
  "$ancestor_target/noonmark-development/external-canary"

leaf_backup="$development_data.bound-before-race"
leaf_target="$fixture_root/leaf-race-target"
mkdir -p "$development_data" "$leaf_target"
printf 'selected-canary\n' >"$development_data/selected-canary"
printf 'external-canary\n' >"$leaf_target/external-canary"
assert_namespace_replacement_rejected \
  "leaf" \
  "$development_data" \
  "$leaf_backup" \
  "$leaf_target" \
  "$leaf_target/external-canary"

