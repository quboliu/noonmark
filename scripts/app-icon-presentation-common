#!/usr/bin/env bash
# Shared real NSWorkspace renderer and exact normalized RGBA comparison.

render_workspace_icon() {
  NOONMARK_APP_PATH="$1" \
    NOONMARK_APP_ICON_OUTPUT="$2" \
    osascript -l JavaScript \
    -e 'ObjC.import("AppKit")' \
    -e 'const environment = $.NSProcessInfo.processInfo.environment' \
    -e 'const appPath = environment.objectForKey("NOONMARK_APP_PATH")' \
    -e 'const outputPath = environment.objectForKey("NOONMARK_APP_ICON_OUTPUT")' \
    -e 'const icon = $.NSWorkspace.sharedWorkspace.iconForFile(appPath)' \
    -e 'const rep = $.NSBitmapImageRep.imageRepWithData(icon.TIFFRepresentation)' \
    -e 'const data = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $({}))' \
    -e 'if (!data.writeToFileAtomically(outputPath, true)) throw new Error("failed to render the app icon through NSWorkspace")'
}


compare_workspace_icons() {
NOONMARK_REFERENCE_ICON="$1" \
  NOONMARK_WORKSPACE_ICON="$2" \
  swift - <<'SWIFT'
import AppKit
import CoreGraphics
import Foundation

enum IconCompareError: Error, CustomStringConvertible {
  case missingEnvironment(String)
  case unreadableImage(String)
  case missingCGImage(String)
  case missingContext
  case differentPixels(count: Int, maxChannelDelta: UInt8)

  var description: String {
    switch self {
    case .missingEnvironment(let name):
      return "missing environment variable: \(name)"
    case .unreadableImage(let path):
      return "unreadable image: \(path)"
    case .missingCGImage(let path):
      return "image has no CGImage representation: \(path)"
    case .missingContext:
      return "failed to create bitmap context"
    case .differentPixels(let count, let maxChannelDelta):
      return "images differ after RGBA normalization: \(count) pixels, max channel delta \(maxChannelDelta)"
    }
  }
}

func pathFromEnvironment(_ name: String) throws -> String {
  guard let value = ProcessInfo.processInfo.environment[name], !value.isEmpty else {
    throw IconCompareError.missingEnvironment(name)
  }
  return value
}

func normalizedRGBA(path: String, width: Int = 1024, height: Int = 1024) throws -> [UInt8] {
  guard let image = NSImage(contentsOfFile: path) else {
    throw IconCompareError.unreadableImage(path)
  }
  var proposedRect = CGRect(origin: .zero, size: CGSize(width: width, height: height))
  guard let cgImage = image.cgImage(forProposedRect: &proposedRect, context: nil, hints: nil) else {
    throw IconCompareError.missingCGImage(path)
  }
  let colorSpace = CGColorSpace(name: CGColorSpace.sRGB)!
  var data = [UInt8](repeating: 0, count: width * height * 4)
  guard let context = CGContext(
    data: &data,
    width: width,
    height: height,
    bitsPerComponent: 8,
    bytesPerRow: width * 4,
    space: colorSpace,
    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
  ) else {
    throw IconCompareError.missingContext
  }
  context.interpolationQuality = .none
  context.draw(cgImage, in: CGRect(x: 0, y: 0, width: width, height: height))
  return data
}

do {
  let reference = try normalizedRGBA(path: pathFromEnvironment("NOONMARK_REFERENCE_ICON"))
  let workspace = try normalizedRGBA(path: pathFromEnvironment("NOONMARK_WORKSPACE_ICON"))
  var differingPixels = 0
  var maxChannelDelta: UInt8 = 0

  for offset in stride(from: 0, to: reference.count, by: 4) {
    var pixelDiffers = false
    for channel in 0..<4 {
      let lhs = reference[offset + channel]
      let rhs = workspace[offset + channel]
      if lhs != rhs {
        pixelDiffers = true
        let delta = lhs > rhs ? lhs - rhs : rhs - lhs
        maxChannelDelta = max(maxChannelDelta, delta)
      }
    }
    if pixelDiffers {
      differingPixels += 1
    }
  }

  if differingPixels != 0 {
    throw IconCompareError.differentPixels(count: differingPixels, maxChannelDelta: maxChannelDelta)
  }
} catch {
  FileHandle.standardError.write("\(error)\n".data(using: .utf8)!)
  exit(1)
}
SWIFT

}
