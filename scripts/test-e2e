  --e2e-quit-after-automation

if [[ ! -f "$zhulong_recovery_result" || "$(cat "$zhulong_recovery_result")" != "ok" ]]; then
  echo "zhulong interrupted cross-store application did not recover" >&2
  exit 1
fi
if [[ -f "$zhulong_recovery_journal" ]]; then
  echo "zhulong recovery journal was not cleared after successful recovery" >&2
  exit 1
fi
zhulong_recovery_review_count="$(sqlite3 "$zhulong_recovery_db" "SELECT count(*) FROM days WHERE review_summary = 'E2E 已确认的每日复盘';")"
if [[ "$zhulong_recovery_review_count" -ne 1 ]]; then
  echo "zhulong recovered daily review was not applied exactly once: count=$zhulong_recovery_review_count" >&2
  exit 1
fi

echo "E2E zhulong interrupted cross-store recovery: $zhulong_recovery_result (review_count=$zhulong_recovery_review_count)"

