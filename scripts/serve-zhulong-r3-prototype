#!/usr/bin/env bash
set -euo pipefail

prototype_dir="${NOONMARK_ZHULONG_R3_PROTOTYPE_DIR:-docs/design/prototypes/zhulong-converged-2026-07-10}"
port="${NOONMARK_ZHULONG_R3_PROTOTYPE_PORT:-4174}"
prototype_html="${prototype_dir}/noonmark-mac-prototype.dc.html"
url="http://127.0.0.1:${port}/noonmark-mac-prototype.dc.html?surface=zhulong&flow=shape&step=home"
prototype_marker="<title>烛龙任务成形 R3 · 收敛原型</title>"

if [[ ! -f "$prototype_html" ]]; then
  echo "missing R3 prototype HTML: $prototype_html" >&2
  exit 1
fi

prototype_is_served() {
  curl --silent --fail "$url" | grep --fixed-strings --quiet "$prototype_marker"
}

if prototype_is_served; then
  open "$url"
  echo "烛龙 R3 prototype 已在运行: $url"
  exit 0
fi

python3 -m http.server "$port" --bind 127.0.0.1 --directory "$prototype_dir" &
server_pid=$!

cleanup() {
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

for _ in {1..40}; do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid" || true
    echo "R3 prototype server failed to start at http://127.0.0.1:${port}" >&2
    exit 1
  fi
  if prototype_is_served; then
    open "$url"
    echo "烛龙 R3 prototype: $url"
    echo "按 Ctrl+C 停止本地服务器。"
    wait "$server_pid"
    exit 0
  fi
  sleep 0.1
done

echo "R3 prototype server did not become ready at http://127.0.0.1:${port}" >&2
exit 1
