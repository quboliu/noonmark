#!/usr/bin/env bash
set -euo pipefail

# Synthetic contract probes dispatch before repository setup so they cannot
# inspect or reset any signed runtime profile.
dmg_window_identity_read_response() {
  local runtime_evidence_root="$1"
  local launch_token="$2"
  local process_identifier="$3"
  local bundle_identifier="$4"
  local window_title="$5"
  local scope="$6"

  NOONMARK_DMG_WINDOW_EVIDENCE_ROOT="$runtime_evidence_root" \
    NOONMARK_DMG_WINDOW_LAUNCH_TOKEN="$launch_token" \
    NOONMARK_DMG_WINDOW_PROCESS_IDENTIFIER="$process_identifier" \
    NOONMARK_DMG_WINDOW_BUNDLE_IDENTIFIER="$bundle_identifier" \
    NOONMARK_DMG_WINDOW_TITLE="$window_title" \
    NOONMARK_DMG_WINDOW_SCOPE="$scope" \
    swift -e '
import CoreFoundation
import Foundation
import Darwin

func exactInteger(_ value: Any?) -> Int? {
    guard let number = value as? NSNumber,
          CFGetTypeID(number) != CFBooleanGetTypeID(),
          number.doubleValue.isFinite,
          number.doubleValue.rounded(.towardZero) == number.doubleValue
    else {
        return nil
    }
    return number.intValue
}

let environment = ProcessInfo.processInfo.environment
guard let root = environment["NOONMARK_DMG_WINDOW_EVIDENCE_ROOT"],
      let scope = environment["NOONMARK_DMG_WINDOW_SCOPE"],
      scope == "live" || scope == "fixture",
      let expectedToken = environment["NOONMARK_DMG_WINDOW_LAUNCH_TOKEN"],
      UUID(uuidString: expectedToken)?.uuidString == expectedToken,
      let expectedProcessIdentifier = environment[
          "NOONMARK_DMG_WINDOW_PROCESS_IDENTIFIER"
      ].flatMap(Int.init),
      expectedProcessIdentifier > 0,
      let expectedBundleIdentifier = environment[
          "NOONMARK_DMG_WINDOW_BUNDLE_IDENTIFIER"
      ],
      expectedBundleIdentifier.isEmpty == false,
      let expectedTitle = environment["NOONMARK_DMG_WINDOW_TITLE"],
      expectedTitle.isEmpty == false
else {
    exit(1)
}

func lexicalComponents(_ path: String) -> [Substring]? {
    guard path.hasPrefix("/"),
          path.contains("//") == false,
          path.contains("\n") == false,
          path.contains("\r") == false,
          path.contains("\0") == false
    else {
        return nil
    }
    let pieces = path.split(separator: "/", omittingEmptySubsequences: false)
    guard pieces.first?.isEmpty == true else { return nil }
    let components = Array(pieces.dropFirst())
    guard components.isEmpty == false,
          components.allSatisfy({ $0.isEmpty == false && $0 != "." && $0 != ".." })
    else {
        return nil
    }
    return components
}

let expectedLiveRoot = NSHomeDirectory()
    + "/Library/Application Support/noonmark-dmg-validation/RuntimeEvidence"
guard let rootComponents = lexicalComponents(root),
      rootComponents.suffix(2).map(String.init) == [
          "noonmark-dmg-validation",
          "RuntimeEvidence",
      ],
      scope != "live" || rootComponents.suffix(3).map(String.init) == [
          "Application Support",
          "noonmark-dmg-validation",
          "RuntimeEvidence",
      ],
      scope != "live" || root == expectedLiveRoot
else {
    exit(1)
}

func openDirectoryChain(_ components: [Substring]) -> Int32 {
    var descriptor = open(
        "/",
        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
    )
    guard descriptor >= 0 else { exit(1) }
    for component in components {
        let nextDescriptor = openat(
            descriptor,
            String(component),
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
        )
        _ = close(descriptor)
        guard nextDescriptor >= 0 else { exit(1) }
        var status = stat()
        guard fstat(nextDescriptor, &status) == 0,
              (status.st_mode & S_IFMT) == S_IFDIR
        else {
            _ = close(nextDescriptor)
            exit(1)
        }
        descriptor = nextDescriptor
    }
    return descriptor
}

let rootFD = openDirectoryChain(rootComponents)
guard rootFD >= 0 else { exit(1) }
defer { close(rootFD) }
var rootStatus = stat()
guard fstat(rootFD, &rootStatus) == 0,
      (rootStatus.st_mode & S_IFMT) == S_IFDIR,
      rootStatus.st_uid == geteuid(),
      (rootStatus.st_mode & 0o777) == 0o700
else {
    exit(1)
}

let responseFD = openat(
    rootFD,
    "main-window-identity.json",
    O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC
)
guard responseFD >= 0 else { exit(1) }
defer { close(responseFD) }

let maximumResponseBytes = 4 * 1024
var statusBefore = stat()
guard fstat(responseFD, &statusBefore) == 0,
      (statusBefore.st_mode & S_IFMT) == S_IFREG,
      statusBefore.st_uid == geteuid(),
      statusBefore.st_nlink == 1,
      (statusBefore.st_mode & 0o777) == 0o600,
      statusBefore.st_size > 0,
      statusBefore.st_size <= maximumResponseBytes
else {
    exit(1)
}

var data = Data()
var buffer = [UInt8](repeating: 0, count: 4096)
while true {
    let count = buffer.withUnsafeMutableBytes {
        Darwin.read(responseFD, $0.baseAddress, $0.count)
    }
    if count < 0 {
        if errno == EINTR { continue }
        exit(1)
    }
    if count == 0 { break }
    guard data.count + count <= maximumResponseBytes else { exit(1) }
    data.append(contentsOf: buffer.prefix(count))
}

var statusAfter = stat()
var pathStatus = stat()
guard fstat(responseFD, &statusAfter) == 0,
      fstatat(
          rootFD,
          "main-window-identity.json",
          &pathStatus,
          AT_SYMLINK_NOFOLLOW
      ) == 0,
      statusBefore.st_dev == statusAfter.st_dev,
      statusBefore.st_ino == statusAfter.st_ino,
      statusBefore.st_size == statusAfter.st_size,
      statusBefore.st_mtimespec.tv_sec == statusAfter.st_mtimespec.tv_sec,
      statusBefore.st_mtimespec.tv_nsec == statusAfter.st_mtimespec.tv_nsec,
      statusBefore.st_ctimespec.tv_sec == statusAfter.st_ctimespec.tv_sec,
      statusBefore.st_ctimespec.tv_nsec == statusAfter.st_ctimespec.tv_nsec,
      statusAfter.st_dev == pathStatus.st_dev,
      statusAfter.st_ino == pathStatus.st_ino,
      statusAfter.st_size == pathStatus.st_size,
      statusAfter.st_mtimespec.tv_sec == pathStatus.st_mtimespec.tv_sec,
      statusAfter.st_mtimespec.tv_nsec == pathStatus.st_mtimespec.tv_nsec,
      statusAfter.st_ctimespec.tv_sec == pathStatus.st_ctimespec.tv_sec,
      statusAfter.st_ctimespec.tv_nsec == pathStatus.st_ctimespec.tv_nsec,
      (pathStatus.st_mode & S_IFMT) == S_IFREG,
      pathStatus.st_uid == geteuid(),
      pathStatus.st_nlink == 1,
      (pathStatus.st_mode & 0o777) == 0o600,
      data.count == statusBefore.st_size,
      data.isEmpty == false,
      let object = try? JSONSerialization.jsonObject(with: data),
      let response = object as? [String: Any],
      Set(response.keys) == Set([
          "schema_version",
          "profile",
          "launch_token",
          "process_identifier",
          "bundle_identifier",
          "window_number",
          "title",
      ]),
      let schemaVersion = exactInteger(response["schema_version"]),
      schemaVersion == 1,
      let profile = response["profile"] as? String,
      profile == "dmg-validation",
      let launchToken = response["launch_token"] as? String,
      launchToken == expectedToken,
      let processIdentifier = exactInteger(response["process_identifier"]),
      processIdentifier == expectedProcessIdentifier,
      let bundleIdentifier = response["bundle_identifier"] as? String,
      bundleIdentifier == expectedBundleIdentifier,
      let windowNumber = exactInteger(response["window_number"]),
      windowNumber > 0,
      let title = response["title"] as? String,
      title == expectedTitle
else {
    exit(1)
}
let canonicalResponse: [String: Any] = [
    "schema_version": schemaVersion,
    "profile": profile,
    "launch_token": launchToken,
    "process_identifier": processIdentifier,
    "bundle_identifier": bundleIdentifier,
    "window_number": windowNumber,
    "title": title,
]
guard let canonicalData = try? JSONSerialization.data(
          withJSONObject: canonicalResponse,
          options: [.sortedKeys, .withoutEscapingSlashes]
      ),
      canonicalData == data
else {
    exit(1)
}
print("\(windowNumber)|\(title)")
'
}

dmg_window_identity_prepare_request() {
  local runtime_evidence_root="$1"
  local launch_token="$2"
  local scope="$3"

  NOONMARK_DMG_WINDOW_EVIDENCE_ROOT="$runtime_evidence_root" \
    NOONMARK_DMG_WINDOW_LAUNCH_TOKEN="$launch_token" \
    NOONMARK_DMG_WINDOW_SCOPE="$scope" \
    swift -e '
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawRoot = environment["NOONMARK_DMG_WINDOW_EVIDENCE_ROOT"],
      let scope = environment["NOONMARK_DMG_WINDOW_SCOPE"],
      scope == "live" || scope == "fixture",
      let launchToken = environment["NOONMARK_DMG_WINDOW_LAUNCH_TOKEN"],
      UUID(uuidString: launchToken)?.uuidString == launchToken
else {
    exit(1)
}

func lexicalComponents(_ path: String) -> [Substring]? {
    guard path.hasPrefix("/"),
          path.contains("//") == false,
          path.contains("\n") == false,
          path.contains("\r") == false,
          path.contains("\0") == false
    else {
        return nil
    }
    let pieces = path.split(separator: "/", omittingEmptySubsequences: false)
    guard pieces.first?.isEmpty == true else { return nil }
    let components = Array(pieces.dropFirst())
    guard components.count >= 3,
          components.allSatisfy({ $0.isEmpty == false && $0 != "." && $0 != ".." })
    else {
        return nil
    }
    return components
}

let expectedLiveRoot = NSHomeDirectory()
    + "/Library/Application Support/noonmark-dmg-validation/RuntimeEvidence"
guard let rootComponents = lexicalComponents(rawRoot),
      rootComponents.suffix(2).map(String.init) == [
          "noonmark-dmg-validation",
          "RuntimeEvidence",
      ],
      scope != "live" || rawRoot == expectedLiveRoot
else {
    exit(1)
}

func openDirectoryChain(_ components: ArraySlice<Substring>) -> Int32 {
    var descriptor = open(
        "/",
        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
    )
    guard descriptor >= 0 else { exit(1) }
    for component in components {
        let nextDescriptor = openat(
            descriptor,
            String(component),
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
        )
        _ = close(descriptor)
        guard nextDescriptor >= 0 else { exit(1) }
        var status = stat()
        guard fstat(nextDescriptor, &status) == 0,
              (status.st_mode & S_IFMT) == S_IFDIR
        else {
            _ = close(nextDescriptor)
            exit(1)
        }
        descriptor = nextDescriptor
    }
    return descriptor
}

let applicationSupportFD = openDirectoryChain(rootComponents.dropLast(2))
guard applicationSupportFD >= 0 else { exit(1) }
defer { close(applicationSupportFD) }
var applicationSupportStatus = stat()
guard fstat(applicationSupportFD, &applicationSupportStatus) == 0,
      (applicationSupportStatus.st_mode & S_IFMT) == S_IFDIR,
      applicationSupportStatus.st_uid == geteuid()
else {
    exit(1)
}

func openOwnedDirectory(parentFD: Int32, name: String) -> Int32 {
    if mkdirat(parentFD, name, 0o700) != 0, errno != EEXIST {
        exit(1)
    }
    let descriptor = openat(
        parentFD,
        name,
        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
    )
    guard descriptor >= 0 else { exit(1) }
    var status = stat()
    guard fstat(descriptor, &status) == 0,
          (status.st_mode & S_IFMT) == S_IFDIR,
          status.st_uid == geteuid(),
          (status.st_mode & 0o777) == 0o700
    else {
        close(descriptor)
        exit(1)
    }
    return descriptor
}

let dataFD = openOwnedDirectory(
    parentFD: applicationSupportFD,
    name: "noonmark-dmg-validation"
)
defer { close(dataFD) }
let runtimeFD = openOwnedDirectory(parentFD: dataFD, name: "RuntimeEvidence")
defer { close(runtimeFD) }

func sameIdentity(_ lhs: stat, _ rhs: stat) -> Bool {
    lhs.st_dev == rhs.st_dev
        && lhs.st_ino == rhs.st_ino
        && lhs.st_size == rhs.st_size
        && lhs.st_mtimespec.tv_sec == rhs.st_mtimespec.tv_sec
        && lhs.st_mtimespec.tv_nsec == rhs.st_mtimespec.tv_nsec
        && lhs.st_ctimespec.tv_sec == rhs.st_ctimespec.tv_sec
        && lhs.st_ctimespec.tv_nsec == rhs.st_ctimespec.tv_nsec
}

func removeVerifiedOwnedFile(_ name: String) {
    let descriptor = openat(
        runtimeFD,
        name,
        O_RDONLY | O_NOFOLLOW | O_CLOEXEC
    )
    if descriptor < 0 {
        if errno == ENOENT { return }
        exit(1)
    }
    defer { close(descriptor) }

    var descriptorStatus = stat()
    var pathStatus = stat()
    guard fstat(descriptor, &descriptorStatus) == 0,
          fstatat(runtimeFD, name, &pathStatus, AT_SYMLINK_NOFOLLOW) == 0,
          sameIdentity(descriptorStatus, pathStatus),
          (descriptorStatus.st_mode & S_IFMT) == S_IFREG,
          descriptorStatus.st_uid == geteuid(),
          descriptorStatus.st_nlink == 1,
          (descriptorStatus.st_mode & 0o777) == 0o600,
          unlinkat(runtimeFD, name, 0) == 0
    else {
        exit(1)
    }

    var unlinkedStatus = stat()
    guard fstat(descriptor, &unlinkedStatus) == 0,
          descriptorStatus.st_dev == unlinkedStatus.st_dev,
          descriptorStatus.st_ino == unlinkedStatus.st_ino,
          descriptorStatus.st_size == unlinkedStatus.st_size,
          descriptorStatus.st_mtimespec.tv_sec
              == unlinkedStatus.st_mtimespec.tv_sec,
          descriptorStatus.st_mtimespec.tv_nsec
              == unlinkedStatus.st_mtimespec.tv_nsec,
          unlinkedStatus.st_nlink == 0
    else {
        exit(1)
    }
    var absentStatus = stat()
    guard fstatat(runtimeFD, name, &absentStatus, AT_SYMLINK_NOFOLLOW) != 0,
          errno == ENOENT
    else {
        exit(1)
    }
}

let requestName = "main-window-request.json"
let responseName = "main-window-identity.json"
removeVerifiedOwnedFile(responseName)
removeVerifiedOwnedFile(requestName)

let requestObject: [String: Any] = [
    "schema_version": 1,
    "profile": "dmg-validation",
    "launch_token": launchToken,
]
guard JSONSerialization.isValidJSONObject(requestObject),
      var requestData = try? JSONSerialization.data(
          withJSONObject: requestObject,
          options: [.sortedKeys, .withoutEscapingSlashes]
      )
else {
    exit(1)
}

let temporaryName = ".main-window-request.\(launchToken).tmp"
var temporaryFD = openat(
    runtimeFD,
    temporaryName,
    O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
    0o600
)
guard temporaryFD >= 0 else { exit(1) }
var temporaryPublished = false
defer {
    if temporaryFD >= 0 { close(temporaryFD) }
    if temporaryPublished == false {
        _ = unlinkat(runtimeFD, temporaryName, 0)
    }
}

var offset = 0
let writeSucceeded = requestData.withUnsafeBytes { rawBuffer -> Bool in
    guard let baseAddress = rawBuffer.baseAddress else { return false }
    while offset < requestData.count {
        let count = write(
            temporaryFD,
            baseAddress.advanced(by: offset),
            requestData.count - offset
        )
        if count < 0 {
            if errno == EINTR { continue }
            return false
        }
        guard count > 0 else { return false }
        offset += count
    }
    return true
}
guard writeSucceeded, fsync(temporaryFD) == 0 else { exit(1) }

var temporaryStatus = stat()
guard fstat(temporaryFD, &temporaryStatus) == 0,
      (temporaryStatus.st_mode & S_IFMT) == S_IFREG,
      temporaryStatus.st_uid == geteuid(),
      temporaryStatus.st_nlink == 1,
      (temporaryStatus.st_mode & 0o777) == 0o600,
      temporaryStatus.st_size == requestData.count
else {
    exit(1)
}
guard renameatx_np(
          runtimeFD,
          temporaryName,
          runtimeFD,
          requestName,
          UInt32(RENAME_EXCL)
      ) == 0
else {
    exit(1)
}
temporaryPublished = true
guard fsync(runtimeFD) == 0 else { exit(1) }

var publishedFDStatus = stat()
var publishedStatus = stat()
guard fstat(temporaryFD, &publishedFDStatus) == 0,
      fstatat(runtimeFD, requestName, &publishedStatus, AT_SYMLINK_NOFOLLOW) == 0,
      (publishedStatus.st_mode & S_IFMT) == S_IFREG,
      publishedStatus.st_uid == geteuid(),
      publishedStatus.st_nlink == 1,
      (publishedStatus.st_mode & 0o777) == 0o600,
      publishedStatus.st_dev == publishedFDStatus.st_dev,
      publishedStatus.st_ino == publishedFDStatus.st_ino,
      publishedStatus.st_size == publishedFDStatus.st_size,
      publishedStatus.st_mtimespec.tv_sec == publishedFDStatus.st_mtimespec.tv_sec,
      publishedStatus.st_mtimespec.tv_nsec == publishedFDStatus.st_mtimespec.tv_nsec,
      publishedStatus.st_ctimespec.tv_sec == publishedFDStatus.st_ctimespec.tv_sec,
      publishedStatus.st_ctimespec.tv_nsec == publishedFDStatus.st_ctimespec.tv_nsec
else {
    exit(1)
}
var responseStatusAfterPublication = stat()
guard fstatat(
          runtimeFD,
          responseName,
          &responseStatusAfterPublication,
          AT_SYMLINK_NOFOLLOW
      ) != 0,
      errno == ENOENT
else {
    exit(1)
}
'
}

if [[ "${1:-}" == "--verify-window-identity-fixture" ]]; then
  if [[ "$#" -ne 6 ]]; then
    echo "usage: scripts/test-dmg-install --verify-window-identity-fixture ROOT TOKEN PID BUNDLE TITLE" >&2
    exit 64
  fi
  dmg_window_identity_read_response "$2" "$3" "$4" "$5" "$6" fixture
  exit $?
fi
if [[ "${1:-}" == "--prepare-window-identity-fixture" ]]; then
  if [[ "$#" -ne 3 ]]; then
    echo "usage: scripts/test-dmg-install --prepare-window-identity-fixture ROOT TOKEN" >&2
    exit 64
  fi
  dmg_window_identity_prepare_request "$2" "$3" fixture
  exit $?
fi

# The LaunchServices helper posts physical WindowServer input. Require a stable
# designated requirement so its one-time TCC authorization survives rebuilds.
export NOONMARK_REQUIRE_STABLE_UI_SIGNING=1

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
