#!/usr/bin/env bash
set -euo pipefail

prototype_dir="${NOONMARK_PROTOTYPE_DIR:-docs/design/prototypes/claude-mac-ui-2026-07-05}"
out_dir="${NOONMARK_PROTOTYPE_OUT_DIR:-artifacts/prototype-screenshots}"
window_size="${NOONMARK_PROTOTYPE_WINDOW_SIZE:-1440,900}"
render_timeout="${NOONMARK_PROTOTYPE_RENDER_TIMEOUT:-90}"
render_attempts="${NOONMARK_PROTOTYPE_RENDER_ATTEMPTS:-3}"
pages=(${NOONMARK_PROTOTYPE_PAGES:-day day-detail day-manual-detail day-review-saved pool pool-detail future future-detail unfinished unfinished-detail completed completed-detail calendar settings})

chrome_binary="${NOONMARK_CHROME_BINARY:-}"
if [[ -z "$chrome_binary" ]]; then
  if command -v google-chrome >/dev/null 2>&1; then
    chrome_binary="$(command -v google-chrome)"
  elif command -v chromium >/dev/null 2>&1; then
    chrome_binary="$(command -v chromium)"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    chrome_binary="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    echo "missing Chrome/Chromium for prototype screenshot rendering" >&2
    exit 1
  fi
fi

prototype_html="${prototype_dir}/noonmark-mac-prototype.dc.html"
if [[ ! -f "$prototype_html" ]]; then
  echo "missing prototype HTML: $prototype_html" >&2
  exit 1
fi

rm -rf "$out_dir"
mkdir -p "$out_dir"

for page in "${pages[@]}"; do
  prototype_page="$page"
  prototype_date=""
  prototype_selection=""
  prototype_review_summary=""
  case "$page" in
    day-detail)
      prototype_page="day"
      prototype_selection="t3"
      ;;
    day-manual-detail)
      prototype_page="day"
      prototype_selection="t3"
      ;;
    day-review-saved)
      prototype_page="day"
      prototype_review_summary="E2E自动保存反馈"
      ;;
    pool-detail)
      prototype_page="pool"
      prototype_selection="t12"
      ;;
    future-detail)
      prototype_page="future"
      prototype_selection="t18"
      ;;
    unfinished-detail)
      prototype_page="unfinished"
      prototype_selection="t2"
      ;;
    completed-detail)
      prototype_page="completed"
      prototype_selection="t14"
      ;;
  esac

  work_dir="${out_dir}/.${page}-src"
  mkdir -p "$work_dir"
  cp -R "${prototype_dir}/." "$work_dir/"

  page_html="${work_dir}/noonmark-mac-prototype.dc.html"
  python3 - "$page_html" "$prototype_page" "$prototype_date" "$prototype_selection" "$prototype_review_summary" <<'PY'
import sys

path, page, date, selection, review_summary = sys.argv[1:6]
with open(path, "r", encoding="utf-8") as file:
    html = file.read()

html = html.replace("page:'day',date:this.TODAY,sel:null", f"page:'{page}',date:this.TODAY,sel:{repr(selection) if selection else 'null'}")
if date:
    html = html.replace("date:this.TODAY", f"date:'{date}'", 1)
if review_summary:
    html = html.replace("'2026-07-05':{sum:'',why:'',nxt:''}", f"'2026-07-05':{{sum:{repr(review_summary)},why:'',nxt:''}}")

with open(path, "w", encoding="utf-8") as file:
    file.write(html)
PY

  valid=0
  width=0
  height=0
  for attempt in $(seq 1 "$render_attempts"); do
    user_data_dir="${out_dir}/.${page}-chrome-profile-${attempt}"
    rm -rf "$user_data_dir" "${out_dir}/${page}.png"
    if ! python3 - "$render_timeout" "$chrome_binary" \
      --headless=new \
      --disable-gpu \
      --disable-background-networking \
      --disable-component-update \
      --disable-extensions \
      --hide-scrollbars \
      --no-default-browser-check \
      --no-first-run \
      --user-data-dir="$PWD/$user_data_dir" \
      --virtual-time-budget=3000 \
      --screenshot="$PWD/${out_dir}/${page}.png" \
      --window-size="$window_size" \
      "file://$PWD/$page_html" <<'PY'
import os
import signal
import subprocess
import sys
import time

timeout = int(sys.argv[1])
command = sys.argv[2:]
screenshot = next((arg.split("=", 1)[1] for arg in command if arg.startswith("--screenshot=")), None)
process = subprocess.Popen(
    command,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    start_new_session=True,
)


def signal_process(signal_number):
    errors = []
    for send_signal in (
        lambda: os.killpg(process.pid, signal_number),
        lambda: process.send_signal(signal_number),
    ):
        try:
            send_signal()
            return ""
        except ProcessLookupError:
            return ""
        except PermissionError as error:
            errors.append(str(error))
    return "; ".join(errors)


def stop_process():
    signal_error = signal_process(signal.SIGTERM)
    try:
        return process.communicate(timeout=3)
    except subprocess.TimeoutExpired:
        kill_error = signal_process(signal.SIGKILL)
        try:
            return process.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            errors = "\n".join(error for error in (signal_error, kill_error) if error)
            return "", errors or "prototype screenshot process did not stop after SIGKILL"


deadline = time.monotonic() + timeout
stdout = ""
stderr = ""
while process.poll() is None:
    if screenshot and os.path.exists(screenshot):
        try:
            process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            stop_process()
        raise SystemExit(0)
    if time.monotonic() >= deadline:
        stdout, stderr = stop_process()
        if screenshot and os.path.exists(screenshot):
            raise SystemExit(0)
        raise SystemExit(f"prototype screenshot timed out after {timeout}s\n{stderr}")
    time.sleep(0.2)

stdout, stderr = process.communicate()

if screenshot and os.path.exists(screenshot):
    raise SystemExit(0)

if process.returncode != 0:
    raise SystemExit(stderr or f"prototype screenshot failed with exit code {process.returncode}")
PY
    then
      if [[ "$attempt" -eq "$render_attempts" ]]; then
        exit 1
      fi
      echo "Retry prototype ${page} screenshot after render failure (${attempt}/${render_attempts})" >&2
      continue
    fi

    width="$(sips -g pixelWidth "${out_dir}/${page}.png" | awk '/pixelWidth/ {print $2}')"
    height="$(sips -g pixelHeight "${out_dir}/${page}.png" | awk '/pixelHeight/ {print $2}')"
    if [[ "${width:-0}" -ne 1440 || "${height:-0}" -ne 900 ]]; then
      if [[ "$attempt" -eq "$render_attempts" ]]; then
        echo "invalid prototype screenshot size for ${page}: ${width:-unknown}x${height:-unknown}" >&2
        exit 1
      fi
      echo "Retry prototype ${page} screenshot after invalid size ${width:-unknown}x${height:-unknown} (${attempt}/${render_attempts})" >&2
      continue
    fi

    if python3 - "${out_dir}/${page}.png" "$page" <<'PY'
import struct
import sys
import zlib


def read_png(path):
    with open(path, "rb") as file:
        data = file.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit(f"{path} is not a PNG")

    pos = 8
    width = height = color_type = bit_depth = None
    idat = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos:pos + 4])[0]
        kind = data[pos + 4:pos + 8]
        payload = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            width, height, bit_depth, color_type, _, _, _ = struct.unpack(">IIBBBBB", payload)
        elif kind == b"IDAT":
            idat.extend(payload)
        elif kind == b"IEND":
            break

    if bit_depth != 8 or color_type not in (2, 6):
        raise SystemExit(f"{path} must be 8-bit RGB or RGBA PNG, got bitDepth={bit_depth} colorType={color_type}")

    channels = 4 if color_type == 6 else 3
    stride = width * channels
    raw = zlib.decompress(bytes(idat))
    previous = [0] * stride
    cursor = 0
    non_white = 0
    total = width * height
    for _ in range(height):
        filter_type = raw[cursor]
        cursor += 1
        scanline = list(raw[cursor:cursor + stride])
        cursor += stride
        reconstructed = [0] * stride
        for index, value in enumerate(scanline):
            left = reconstructed[index - channels] if index >= channels else 0
            up = previous[index]
            upper_left = previous[index - channels] if index >= channels else 0
            if filter_type == 0:
                predictor = 0
            elif filter_type == 1:
                predictor = left
            elif filter_type == 2:
                predictor = up
            elif filter_type == 3:
                predictor = (left + up) // 2
            elif filter_type == 4:
                p = left + up - upper_left
                pa = abs(p - left)
                pb = abs(p - up)
                pc = abs(p - upper_left)
                predictor = left if pa <= pb and pa <= pc else up if pb <= pc else upper_left
            else:
                raise SystemExit(f"{path} has unsupported PNG filter {filter_type}")
            reconstructed[index] = (value + predictor) & 0xFF
        previous = reconstructed
        for pixel in range(0, stride, channels):
            red, green, blue = reconstructed[pixel:pixel + 3]
            if red < 245 or green < 245 or blue < 245:
                non_white += 1

    if non_white / total < 0.01:
        page = sys.argv[2]
        raise SystemExit(f"blank prototype screenshot for {page}: non_white_ratio={non_white / total:.6f}")


read_png(sys.argv[1])
PY
    then
      valid=1
      break
    fi

    if [[ "$attempt" -eq "$render_attempts" ]]; then
      exit 1
    fi
    echo "Retry prototype ${page} screenshot after blank image (${attempt}/${render_attempts})" >&2
  done

  if [[ "$valid" -ne 1 ]]; then
    echo "failed to render nonblank prototype screenshot for ${page}" >&2
    exit 1
  fi

  rm -rf "$work_dir" "${out_dir}/.${page}-chrome-profile-"*
  echo "Prototype ${page} screenshot: ${out_dir}/${page}.png (${width}x${height})"
done
