#!/usr/bin/env bash
set -euo pipefail

source scripts/app-icon-common
source scripts/codesign-common
source scripts/runtime-profile-common
# shellcheck source=scripts/evidence-common
source scripts/evidence-common

configuration="${1:-debug}"
profile="${2:-}"
product="NoonmarkMacApp"
marketing_version="${NOONMARK_MARKETING_VERSION:-0.1.1}"
build_number="${NOONMARK_BUILD_NUMBER:-3}"
minimum_os_version="14.0"
runtime_description="Swift-native"

if [[ ! "$marketing_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "NOONMARK_MARKETING_VERSION must contain three numeric components" >&2
  exit 1
fi
if [[ ! "$build_number" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
  echo "NOONMARK_BUILD_NUMBER must contain one to three numeric components" >&2
  exit 1
fi

if [[ -z "$profile" ]]; then
  echo "usage: scripts/build-mac-app <debug|release> <app|development|e2e|demo|audit|dmg-validation>" >&2
  exit 1
fi

case "$profile" in
  app)
    if [[ "$configuration" != "release" \
      || "${NOONMARK_PRODUCTION_BUILD_CONTEXT:-}" != "package-dmg" ]]; then
      echo "production App builds are reserved for scripts/package-dmg" >&2
      exit 1
    fi
    runtime_profile="production"
    ;;
  development | e2e | demo | audit | dmg-validation)
    runtime_profile="$profile"
    ;;
  *)
    echo "unknown fixed app profile: $profile" >&2
    exit 1
    ;;
esac
noonmark_runtime_validate_all_profiles
noonmark_runtime_profile_load "$runtime_profile"
executable_name="$NOONMARK_RUNTIME_PROCESS_NAME"
bundle_identifier="$NOONMARK_RUNTIME_BUNDLE_IDENTIFIER"
bundle_display_name="$NOONMARK_RUNTIME_BUNDLE_DISPLAY_NAME"
bundle_short_name="$NOONMARK_RUNTIME_BUNDLE_SHORT_NAME"
bundle_name="$NOONMARK_RUNTIME_APP_BUNDLE_NAME"
if [[ "$configuration" == "release" && "$profile" == "app" ]]; then
  evidence_require_clean_source "$(git rev-parse --show-toplevel)"
fi
bundle_dir="dist/${bundle_name}.app"
contents_dir="${bundle_dir}/Contents"
macos_dir="${contents_dir}/MacOS"
resources_dir="${contents_dir}/Resources"
release_dsym_path="${bundle_dir}.dSYM"
release_dsym_inventory_path="${bundle_dir}.dSYM.inventory.sha256"
release_build_identity_path="${bundle_dir}.release-build-identity"
cloudkit_container_id="${NOONMARK_CLOUDKIT_CONTAINER_ID:-}"
cloudkit_environment="${NOONMARK_CLOUDKIT_ENVIRONMENT:-}"
codesign_identity="${NOONMARK_CODESIGN_IDENTITY:-}"
require_stable_ui_signing="${NOONMARK_REQUIRE_STABLE_UI_SIGNING:-0}"
provisioning_profile="${NOONMARK_PROVISIONING_PROFILE:-}"
cloudkit_signing_enabled=0
stable_codesigning_enabled=0
release_symbols_enabled=0
linked_binary_sha256=""
linked_binary_uuid_set=""
build_architecture=""
build_git_commit=""
build_date=""
decoded_profile=""
claimed_entitlements=""
release_build_identity_content=""

cleanup() {
  [[ -z "$decoded_profile" ]] || rm -f "$decoded_profile"
  [[ -z "$claimed_entitlements" ]] || rm -f "$claimed_entitlements"
  [[ -z "$release_build_identity_content" ]] ||
    rm -f "$release_build_identity_content"
}
trap cleanup EXIT

noonmark_resolve_codesign_identity \
  "$codesign_identity" \
  "$require_stable_ui_signing"
codesign_identity="$NOONMARK_RESOLVED_CODESIGN_IDENTITY"
stable_codesigning_enabled="$NOONMARK_STABLE_CODESIGNING_ENABLED"

plist_value() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$2" 2>/dev/null
}

plist_array_contains() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$3" 2>/dev/null \
    | sed -e '1d' -e '$d' -e 's/^[[:space:]]*//' \
    | grep -Fqx "$2"
}

if [[ -n "$cloudkit_container_id" ]]; then
  cloudkit_signing_enabled=1
  if [[ ! "$cloudkit_container_id" =~ ^iCloud\.[A-Za-z0-9.-]+$ ]]; then
    echo "invalid NOONMARK_CLOUDKIT_CONTAINER_ID: $cloudkit_container_id" >&2
    exit 1
  fi
  case "$cloudkit_environment" in
    Development)
      aps_environment="development"
      ;;
    Production)
      aps_environment="production"
      ;;
    *)
      echo "CloudKit build requires NOONMARK_CLOUDKIT_ENVIRONMENT=Development or Production" >&2
      exit 1
      ;;
  esac
  if [[ -z "$codesign_identity" || "$codesign_identity" == "-" ]]; then
    echo "CloudKit build requires a non-ad-hoc NOONMARK_CODESIGN_IDENTITY" >&2
    exit 1
  fi
  if [[ -z "$provisioning_profile" || ! -f "$provisioning_profile" ]]; then
    echo "CloudKit build requires an existing NOONMARK_PROVISIONING_PROFILE" >&2
    exit 1
  fi
  decoded_profile="$(mktemp -t noonmark-cloudkit-profile.XXXXXX)"
  if ! security cms -D -i "$provisioning_profile" >"$decoded_profile"; then
    echo "CloudKit provisioning profile could not be decoded" >&2
    exit 1
  fi
  PROFILE_PLIST="$decoded_profile" swift -e '
import Foundation
import Darwin

let path = ProcessInfo.processInfo.environment["PROFILE_PLIST"]!
let data = try Data(contentsOf: URL(fileURLWithPath: path))
let value = try PropertyListSerialization.propertyList(from: data, format: nil)
guard let profile = value as? [String: Any],
      let expiration = profile["ExpirationDate"] as? Date,
      expiration > Date()
else {
    FileHandle.standardError.write(
        Data("CloudKit provisioning profile is expired or malformed\n".utf8)
    )
    exit(1)
}
' >/dev/null

  profile_team_identifier="$(plist_value "TeamIdentifier:0" "$decoded_profile")"
  profile_app_identifier="$(
    plist_value "Entitlements:application-identifier" "$decoded_profile" \
      || plist_value "Entitlements:com.apple.application-identifier" "$decoded_profile"
  )"
  profile_bundle_identifier="${profile_app_identifier#*.}"
  if [[ -z "$profile_team_identifier" \
        || "$profile_bundle_identifier" != "$bundle_identifier" ]]; then
    echo "CloudKit provisioning profile does not authorize $bundle_identifier" >&2
    exit 1
  fi
  if ! plist_array_contains \
    "Entitlements:com.apple.developer.icloud-container-identifiers" \
    "$cloudkit_container_id" \
    "$decoded_profile"; then
    echo "CloudKit provisioning profile does not authorize $cloudkit_container_id" >&2
    exit 1
  fi
  if ! plist_array_contains \
    "Entitlements:com.apple.developer.icloud-services" \
    "CloudKit" \
    "$decoded_profile"; then
    echo "CloudKit provisioning profile does not authorize the CloudKit service" >&2
    exit 1
  fi
  if [[ "$(plist_value "Entitlements:com.apple.developer.icloud-container-environment" "$decoded_profile")" \
        != "$cloudkit_environment" ]]; then
    echo "CloudKit provisioning profile environment does not match $cloudkit_environment" >&2
    exit 1
  fi
  if [[ "$(plist_value "Entitlements:com.apple.developer.aps-environment" "$decoded_profile")" \
        != "$aps_environment" ]]; then
    echo "CloudKit provisioning profile APNs environment does not match $aps_environment" >&2
    exit 1
  fi
fi

scripts/test-app-icon
swift build -c "$configuration" --product "$product"

rm -rf "$bundle_dir" "$release_dsym_path"
rm -f \
  "dist/NoonmarkCloudKit.entitlements" \
  "$release_dsym_inventory_path" \
  "$release_build_identity_path"
mkdir -p "$macos_dir" "$resources_dir"

binary_path=".build/arm64-apple-macosx/${configuration}/${product}"
if [[ ! -x "$binary_path" ]]; then
  binary_path=".build/${configuration}/${product}"
fi

cp "$binary_path" "${macos_dir}/${executable_name}"
chmod +x "${macos_dir}/${executable_name}"
scripts/verify-window-lookup-boundary \
  production-binary \
  "${macos_dir}/${executable_name}"

linked_binary_sha256="$(
  shasum -a 256 "${macos_dir}/${executable_name}" | awk '{print $1}'
)"
linked_binary_uuid_set="$(
  evidence_release_uuid_set "${macos_dir}/${executable_name}"
)"
build_architecture="$(
  evidence_release_architecture_description "$linked_binary_uuid_set"
)"
build_git_commit="$(git rev-parse --verify HEAD)"
build_date="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
if [[ ! "$linked_binary_sha256" =~ ^[0-9a-f]{64}$ ||
  ! "$build_git_commit" =~ ^[0-9a-f]{40}$ ||
  ! "$build_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
  echo "build identity could not be captured exactly" >&2
  exit 1
fi

if [[ "$configuration" == "release" && "$profile" == "app" ]]; then
  dsymutil_bin="$(xcrun --find dsymutil)"
  if [[ "$dsymutil_bin" != /* || ! -x "$dsymutil_bin" ]]; then
    echo "release build requires an absolute executable dsymutil" >&2
    exit 1
  fi
  "$dsymutil_bin" \
    "${macos_dir}/${executable_name}" \
    -o "$release_dsym_path"
  evidence_require_release_symbol_pair \
    "${macos_dir}/${executable_name}" \
    "$release_dsym_path"
  release_symbols_enabled=1
fi

cp "$app_icon_icns_path" "${resources_dir}/${app_icon_bundle_icon_name}.icns"

cat > "${contents_dir}/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleDisplayName</key>
  <string>${bundle_display_name}</string>
  <key>CFBundleExecutable</key>
  <string>${executable_name}</string>
  <key>CFBundleIdentifier</key>
  <string>${bundle_identifier}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleIconFile</key>
  <string>${app_icon_bundle_icon_name}</string>
  <key>CFBundleName</key>
  <string>${bundle_short_name}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${marketing_version}</string>
  <key>CFBundleVersion</key>
  <string>${build_number}</string>
  <key>LSMinimumSystemVersion</key>
  <string>${minimum_os_version}</string>
  <key>NoonmarkGitCommit</key>
  <string>${build_git_commit}</string>
  <key>NoonmarkBuildDate</key>
  <string>${build_date}</string>
  <key>NoonmarkRuntime</key>
  <string>${runtime_description}</string>
  <key>NoonmarkMinimumOSVersion</key>
  <string>${minimum_os_version}</string>
  <key>NoonmarkBuildArchitecture</key>
  <string>${build_architecture}</string>
  <key>NoonmarkBinaryUUID</key>
  <string>${linked_binary_uuid_set}</string>
  <key>NoonmarkBinarySHA256</key>
  <string>${linked_binary_sha256}</string>
  <key>NoonmarkBinarySHA256Scope</key>
  <string>linked-before-bundle-signing</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeDescription</key>
      <string>Noonmark Task Priority</string>
      <key>UTTypeIdentifier</key>
      <string>app.noonmark.task-priority</string>
    </dict>
  </array>
</dict>
</plist>
PLIST

if [[ "$release_symbols_enabled" -eq 1 ]]; then
  release_build_identity_content="$(
    mktemp "${TMPDIR:-/tmp}/noonmark-release-build-identity.XXXXXX"
  )"
  {
    printf 'release_build_identity_schema_version=1\n'
    printf 'release_build_identity_version=%s\n' "$marketing_version"
    printf 'release_build_identity_build=%s\n' "$build_number"
    printf 'release_build_identity_git_commit=%s\n' "$build_git_commit"
    printf 'release_build_identity_build_date=%s\n' "$build_date"
    printf 'release_build_identity_runtime=%s\n' "$runtime_description"
    printf 'release_build_identity_minimum_os_version=%s\n' \
      "$minimum_os_version"
    printf 'release_build_identity_architecture=%s\n' "$build_architecture"
    printf 'release_build_identity_binary_uuid_set=%s\n' \
      "$linked_binary_uuid_set"
    printf 'release_build_identity_binary_sha256=%s\n' \
      "$linked_binary_sha256"
    printf '%s\n' \
      'release_build_identity_binary_sha256_scope=linked-before-bundle-signing'
  } >"$release_build_identity_content"
  evidence_write_fragment_atomically \
    "$release_build_identity_path" \
    "$release_build_identity_content"
  rm -f "$release_build_identity_content"
  release_build_identity_content=""
fi

if [[ "$cloudkit_signing_enabled" -eq 1 ]]; then
  /usr/libexec/PlistBuddy -c "Add :UIBackgroundModes array" "${contents_dir}/Info.plist"
  /usr/libexec/PlistBuddy -c "Add :UIBackgroundModes:0 string remote-notification" \
    "${contents_dir}/Info.plist"
  cp "$provisioning_profile" "${contents_dir}/embedded.provisionprofile"
  entitlements_path="dist/NoonmarkCloudKit.entitlements"
  cat >"$entitlements_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.application-identifier</key>
  <string>${profile_app_identifier}</string>
  <key>com.apple.developer.team-identifier</key>
  <string>${profile_team_identifier}</string>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>${cloudkit_container_id}</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudKit</string>
  </array>
  <key>com.apple.developer.icloud-container-environment</key>
  <string>${cloudkit_environment}</string>
  <key>com.apple.developer.aps-environment</key>
  <string>${aps_environment}</string>
</dict>
</plist>
PLIST
  codesign \
    --force \
    --sign "$codesign_identity" \
    --entitlements "$entitlements_path" \
    "$bundle_dir" >/dev/null

  claimed_entitlements="$(mktemp -t noonmark-cloudkit-entitlements.XXXXXX)"
  codesign --display --entitlements - --xml "$bundle_dir" \
    >"$claimed_entitlements" 2>/dev/null
  if [[ "$(plist_value "com.apple.application-identifier" "$claimed_entitlements")" \
        != "$profile_app_identifier" \
        || "$(plist_value "com.apple.developer.team-identifier" "$claimed_entitlements")" \
        != "$profile_team_identifier" \
        || "$(plist_value "com.apple.developer.icloud-container-environment" "$claimed_entitlements")" \
        != "$cloudkit_environment" \
        || "$(plist_value "com.apple.developer.aps-environment" "$claimed_entitlements")" \
        != "$aps_environment" ]]; then
    echo "signed app does not contain the expected CloudKit scalar entitlements" >&2
    exit 1
  fi
  if ! plist_array_contains \
    "com.apple.developer.icloud-container-identifiers" \
    "$cloudkit_container_id" \
    "$claimed_entitlements" \
    || ! plist_array_contains \
      "com.apple.developer.icloud-services" \
      "CloudKit" \
      "$claimed_entitlements"; then
    echo "signed app does not contain the expected CloudKit array entitlements" >&2
    exit 1
  fi
  signed_team_identifier="$(
    codesign --display --verbose=4 "$bundle_dir" 2>&1 \
      | awk -F= '/^TeamIdentifier=/{print $2}'
  )"
  if [[ "$signed_team_identifier" != "$profile_team_identifier" ]]; then
    echo "signed app team does not match the provisioning profile" >&2
    exit 1
  fi
elif [[ "$stable_codesigning_enabled" -eq 1 ]]; then
  codesign --force --sign "$codesign_identity" "$bundle_dir" >/dev/null
else
  codesign --force --sign - "$bundle_dir" >/dev/null
fi

signed_binary_uuid_set="$(
  evidence_release_uuid_set "${macos_dir}/${executable_name}"
)"
if [[ "$signed_binary_uuid_set" != "$linked_binary_uuid_set" ]]; then
  echo "bundle signing changed the build identity Mach-O UUID set" >&2
  exit 1
fi
if [[ "$release_symbols_enabled" -eq 1 ]]; then
  evidence_require_release_symbol_pair \
    "${macos_dir}/${executable_name}" \
    "$release_dsym_path"
fi

if [[ "$require_stable_ui_signing" == "1" ]]; then
  noonmark_verify_stable_designated_requirement \
    "$bundle_dir" \
    "$bundle_identifier"
fi
scripts/verify-mac-app-metadata "$bundle_dir"
scripts/test-app-icon-bundle "$bundle_dir"
echo "$bundle_dir"
