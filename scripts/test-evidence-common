#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$repo_root/scripts/evidence-common"
source "$repo_root/scripts/runtime-evidence"

fixture="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-evidence-common.XXXXXX")"
fixture="$(cd "$fixture" && pwd -P)"
trap 'rm -rf "$fixture"' EXIT

fail() {
  echo "$1" >&2
  exit 1
}

evidence_validate_artifact_basename "Noonmark Debug" "fixture artifact"
for unsafe_artifact_name in '' '.' '..' '../escape' 'nested/name'; do
  if evidence_validate_artifact_basename \
    "$unsafe_artifact_name" \
    "fixture artifact" >/dev/null 2>&1; then
    fail "artifact basename guard accepted: $unsafe_artifact_name"
  fi
done

git_fixture="$fixture/repository"
mkdir -p "$git_fixture"
git -C "$git_fixture" init -q
git -C "$git_fixture" config user.name "Evidence Fixture"
git -C "$git_fixture" config user.email "evidence@example.invalid"
printf 'tracked\n' >"$git_fixture/tracked.txt"
git -C "$git_fixture" add tracked.txt
git -C "$git_fixture" commit -qm "fixture"
clean_fragment="$fixture/clean.fragment"
dirty_fragment="$fixture/dirty.fragment"
evidence_capture_source "$git_fixture" source "$clean_fragment"
[[ "$(evidence_read "$clean_fragment" source_tree_dirty)" == "0" ]] ||
  fail "clean source snapshot was marked dirty"
evidence_require_clean_source "$git_fixture"
index_before="$(shasum -a 256 "$git_fixture/.git/index" | awk '{print $1}')"
printf 'changed\n' >>"$git_fixture/tracked.txt"
printf 'untracked\n' >"$git_fixture/untracked.txt"
evidence_capture_source "$git_fixture" source "$dirty_fragment"
[[ "$(evidence_read "$dirty_fragment" source_tree_dirty)" == "1" ]] ||
  fail "dirty source snapshot was marked clean"
[[ "$(evidence_read "$dirty_fragment" source_worktree_tree_oid)" != \
  "$(evidence_read "$clean_fragment" source_worktree_tree_oid)" ]] ||
  fail "worktree tree ignored tracked or untracked changes"
if evidence_require_clean_source "$git_fixture" >/dev/null 2>&1; then
  fail "clean-source release guard accepted a dirty worktree"
fi
index_after="$(shasum -a 256 "$git_fixture/.git/index" | awk '{print $1}')"
[[ "$index_before" == "$index_after" ]] ||
  fail "source capture modified the real Git index"

fresh_root="$git_fixture/artifacts/fresh"
mkdir -p "$fresh_root"
printf 'stale\n' >"$fresh_root/stale.txt"
evidence_prepare_fresh_directory "$git_fixture" "$fresh_root"
[[ ! -e "$fresh_root/stale.txt" ]] || fail "fresh evidence retained stale data"
if evidence_prepare_fresh_directory "$git_fixture" "$git_fixture/../outside" \
  >/dev/null 2>&1; then
  fail "fresh evidence accepted an escaping path"
fi

missing_escape_parent="$fixture/missing-outside-parent"
if evidence_prepare_fresh_directory \
  "$git_fixture" \
  "$missing_escape_parent/evidence" >/dev/null 2>&1; then
  fail "fresh evidence accepted a missing absolute escape"
fi
[[ ! -e "$missing_escape_parent" ]] ||
  fail "escaping evidence path created an outside parent before rejection"

symlink_target="$fixture/symlink-target"
mkdir -p "$symlink_target"
ln -s "$symlink_target" "$git_fixture/evidence-link"
if evidence_prepare_fresh_directory \
  "$git_fixture" \
  "$git_fixture/evidence-link/created/evidence" >/dev/null 2>&1; then
  fail "fresh evidence accepted a symlink parent"
fi
[[ ! -e "$symlink_target/created" ]] ||
  fail "symlinked evidence path created an outside parent before rejection"

assert_prepare_interposition_rejected() {
  local replacement_kind="$1"
  local case_root="$git_fixture/artifacts/prepare-$replacement_kind"
  local target="$case_root/fresh"
  local outside="$fixture/prepare-$replacement_kind-outside"
  local ready_fifo="$fixture/prepare-$replacement_kind-ready"
  local release_fifo="$fixture/prepare-$replacement_kind-release"
  local output="$fixture/prepare-$replacement_kind-output.log"
  local prepare_pid
  local prepare_status
  local ready_marker=""

  mkdir -p "$target" "$outside"
  printf 'stale\n' >"$target/stale.txt"
  printf 'outside-canary\n' >"$outside/canary.txt"
  mkfifo "$ready_fifo" "$release_fifo"
  exec 8<>"$ready_fifo"
  exec 9<>"$release_fifo"

  NOONMARK_EVIDENCE_TEST_READY_FD=8 \
    NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
    evidence_prepare_fresh_directory \
      "$git_fixture" \
      "$target" >"$output" 2>&1 &
  prepare_pid=$!

  if ! IFS= read -r -n 1 -t 10 ready_marker <&8 ||
    [[ "$ready_marker" != "R" ]]; then
    kill "$prepare_pid" >/dev/null 2>&1 || true
    wait "$prepare_pid" >/dev/null 2>&1 || true
    exec 8>&-
    exec 9>&-
    fail "fresh evidence did not expose the descriptor-bound test seam"
  fi

  case "$replacement_kind" in
    parent)
      mv "$case_root" "${case_root}-bound"
      ln -s "$outside" "$case_root"
      ;;
    leaf)
      mv "$target" "${target}-bound"
      ln -s "$outside" "$target"
      ;;
    *) fail "unknown prepare interposition kind: $replacement_kind" ;;
  esac

  printf 'G' >&9
  set +e
  wait "$prepare_pid"
  prepare_status=$?
  set -e
  exec 8>&-
  exec 9>&-

  [[ "$prepare_status" -ne 0 ]] ||
    fail "fresh evidence accepted a post-bind $replacement_kind replacement"
  [[ "$(<"$outside/canary.txt")" == "outside-canary" ]] ||
    fail "fresh evidence changed the outside $replacement_kind canary"
  [[ ! -e "$outside/stale.txt" ]] ||
    fail "fresh evidence crossed the post-bind $replacement_kind symlink"
}

assert_prepare_interposition_rejected parent
assert_prepare_interposition_rejected leaf

assert_inventory_interposition_rejected() {
  local replacement_kind="$1"
  local case_root="$git_fixture/artifacts/inventory-$replacement_kind"
  local candidate="$case_root/candidate"
  local output="$case_root/inventory.tsv"
  local outside="$fixture/inventory-$replacement_kind-outside"
  local ready_fifo="$fixture/inventory-$replacement_kind-ready"
  local release_fifo="$fixture/inventory-$replacement_kind-release"
  local command_output="$fixture/inventory-$replacement_kind-output.log"
  local inventory_pid
  local inventory_status
  local ready_marker=""

  mkdir -p "$case_root" "$outside"
  printf 'outside-canary\n' >"$outside/canary.txt"
  if [[ "$replacement_kind" == "inode" ]]; then
    printf 'bound-inventory-file\n' >"$candidate"
  else
    mkdir -p "$candidate"
    printf 'bound-inventory-file\n' >"$candidate/result.txt"
  fi
  mkfifo "$ready_fifo" "$release_fifo"
  exec 8<>"$ready_fifo"
  exec 9<>"$release_fifo"

  NOONMARK_EVIDENCE_TEST_READY_FD=8 \
    NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
    evidence_inventory \
      "$git_fixture" \
      "$output" \
      "$candidate" >"$command_output" 2>&1 &
  inventory_pid=$!

  if ! IFS= read -r -n 1 -t 10 ready_marker <&8 ||
    [[ "$ready_marker" != "R" ]]; then
    kill "$inventory_pid" >/dev/null 2>&1 || true
    wait "$inventory_pid" >/dev/null 2>&1 || true
    exec 8>&-
    exec 9>&-
    fail "artifact inventory did not expose the descriptor-bound test seam"
  fi

  case "$replacement_kind" in
    parent)
      mv "$case_root" "${case_root}-bound"
      ln -s "$outside" "$case_root"
      ;;
    leaf)
      mv "$candidate" "${candidate}-bound"
      ln -s "$outside" "$candidate"
      ;;
    inode)
      mv "$candidate" "${candidate}-bound"
      printf 'replacement-inventory-file\n' >"$candidate"
      ;;
    *) fail "unknown inventory interposition kind: $replacement_kind" ;;
  esac

  printf 'G' >&9
  set +e
  wait "$inventory_pid"
  inventory_status=$?
  set -e
  exec 8>&-
  exec 9>&-

  [[ "$inventory_status" -ne 0 ]] ||
    fail "artifact inventory accepted a post-bind $replacement_kind replacement"
  [[ "$(<"$outside/canary.txt")" == "outside-canary" ]] ||
    fail "artifact inventory changed the outside $replacement_kind canary"
  [[ ! -e "$outside/inventory.tsv" ]] ||
    fail "artifact inventory crossed the post-bind $replacement_kind symlink"
}

assert_inventory_interposition_rejected parent
assert_inventory_interposition_rejected leaf
assert_inventory_interposition_rejected inode

assert_bootstrap_cleanup_interposition_rejected() {
  local bootstrap_parent="$fixture/bootstrap-cleanup-parent"
  local moved_root="$fixture/bootstrap-cleanup-bound"
  local outside="$fixture/bootstrap-cleanup-outside"
  local ready_fifo="$fixture/bootstrap-cleanup-ready"
  local release_fifo="$fixture/bootstrap-cleanup-release"
  local output="$fixture/bootstrap-cleanup-output.log"
  local bootstrap_root
  local helper_pid
  local helper_status
  local ready_marker=""

  mkdir -p "$bootstrap_parent" "$outside"
  printf 'outside-canary\n' >"$outside/canary.txt"
  mkfifo "$ready_fifo" "$release_fifo"
  exec 8<>"$ready_fifo"
  exec 9<>"$release_fifo"

  TMPDIR="$bootstrap_parent" \
    NOONMARK_EVIDENCE_TEST_READY_FD=8 \
    NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
    "$repo_root/scripts/run-evidence-path-helper" \
      bootstrap-cleanup-contract >"$output" 2>&1 &
  helper_pid=$!
  if ! IFS= read -r -n 1 -t 10 ready_marker <&8 ||
    [[ "$ready_marker" != "R" ]]; then
    kill "$helper_pid" >/dev/null 2>&1 || true
    wait "$helper_pid" >/dev/null 2>&1 || true
    exec 8>&-
    exec 9>&-
    fail "bootstrap cleanup did not expose the inherited-FD test seam"
  fi

  bootstrap_root="$(
    find "$bootstrap_parent" \
      -mindepth 1 \
      -maxdepth 1 \
      -type d \
      -name 'noonmark-evidence-path-helper.*' \
      -print
  )"
  [[ -n "$bootstrap_root" && "$bootstrap_root" != *$'\n'* ]] ||
    fail "bootstrap cleanup test could not identify one bound root"
  mv "$bootstrap_root" "$moved_root"
  ln -s "$outside" "$bootstrap_root"

  printf 'G' >&9
  set +e
  wait "$helper_pid"
  helper_status=$?
  set -e
  exec 8>&-
  exec 9>&-

  [[ "$helper_status" -ne 0 ]] ||
    fail "bootstrap cleanup accepted a replaced root binding"
  [[ "$(<"$outside/canary.txt")" == "outside-canary" ]] ||
    fail "bootstrap cleanup changed the replacement target"
  [[ -L "$bootstrap_root" ]] ||
    fail "bootstrap cleanup removed the replacement path"
  [[ -d "$moved_root" ]] ||
    fail "bootstrap cleanup lost its descriptor-bound root"
  [[ -z "$(find "$moved_root" -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
    fail "bootstrap cleanup retained its descriptor-bound helper binary"
}

assert_bootstrap_release_timeout_rejected() {
  local bootstrap_parent="$fixture/bootstrap-timeout-parent"
  local ready_fifo="$fixture/bootstrap-timeout-ready"
  local release_fifo="$fixture/bootstrap-timeout-release"
  local output="$fixture/bootstrap-timeout-output.log"
  local helper_pid
  local helper_status
  local ready_marker=""

  mkdir -p "$bootstrap_parent"
  mkfifo "$ready_fifo" "$release_fifo"
  exec 8<>"$ready_fifo"
  exec 9<>"$release_fifo"
  TMPDIR="$bootstrap_parent" \
    NOONMARK_EVIDENCE_TEST_READY_FD=8 \
    NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
    "$repo_root/scripts/run-evidence-path-helper" \
      bootstrap-cleanup-contract >"$output" 2>&1 &
  helper_pid=$!
  if ! IFS= read -r -n 1 -t 10 ready_marker <&8 ||
    [[ "$ready_marker" != "R" ]]; then
    kill "$helper_pid" >/dev/null 2>&1 || true
    wait "$helper_pid" >/dev/null 2>&1 || true
    exec 8>&-
    exec 9>&-
    fail "bootstrap timeout test did not reach the inherited-FD seam"
  fi

  set +e
  wait "$helper_pid"
  helper_status=$?
  set -e
  exec 8>&-
  exec 9>&-
  [[ "$helper_status" -ne 0 ]] ||
    fail "bootstrap cleanup accepted a missing release byte"
  [[ -z "$(
    find "$bootstrap_parent" \
      -mindepth 1 \
      -maxdepth 1 \
      -name 'noonmark-evidence-path-helper.*' \
      -print \
      -quit
  )" ]] ||
    fail "bootstrap timeout retained a compiled helper"
}

assert_bootstrap_cleanup_interposition_rejected
assert_bootstrap_release_timeout_rejected

assert_manifest_mutation_interposition_rejected() {
  local operation="$1"
  local replacement_kind="$2"
  local case_root="$git_fixture/artifacts/$operation-$replacement_kind"
  local destination_parent="$case_root/destination"
  local destination="$destination_parent/manifest.txt"
  local bound_parent="$case_root/destination-bound"
  local bound_destination="$destination_parent/manifest-bound.txt"
  local addition="$case_root/addition.txt"
  local outside="$fixture/$operation-$replacement_kind-outside"
  local ready_fifo="$fixture/$operation-$replacement_kind-ready"
  local release_fifo="$fixture/$operation-$replacement_kind-release"
  local output="$fixture/$operation-$replacement_kind-output.log"
  local mutation_pid
  local mutation_status
  local ready_marker=""

  mkdir -p "$destination_parent" "$outside"
  printf 'first=value\n' >"$destination"
  printf 'second=value\n' >"$addition"
  printf 'outside-canary\n' >"$outside/manifest.txt"
  mkfifo "$ready_fifo" "$release_fifo"
  exec 8<>"$ready_fifo"
  exec 9<>"$release_fifo"

  if [[ "$operation" == "fragment-replace" ]]; then
    NOONMARK_EVIDENCE_TEST_READY_FD=8 \
      NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
      evidence_write_fragment_atomically \
        "$destination" \
        "$addition" >"$output" 2>&1 &
  elif [[ "$operation" == "manifest-append" ]]; then
    NOONMARK_EVIDENCE_TEST_READY_FD=8 \
      NOONMARK_EVIDENCE_TEST_RELEASE_FD=9 \
      evidence_atomic_append_file \
        "$destination" \
        "$addition" >"$output" 2>&1 &
  else
    fail "unknown manifest mutation operation: $operation"
  fi
  mutation_pid=$!

  if ! IFS= read -r -n 1 -t 10 ready_marker <&8 ||
    [[ "$ready_marker" != "R" ]]; then
    kill "$mutation_pid" >/dev/null 2>&1 || true
    wait "$mutation_pid" >/dev/null 2>&1 || true
    exec 8>&-
    exec 9>&-
    fail "$operation did not expose the descriptor-bound test seam"
  fi

  case "$replacement_kind" in
    parent)
      mv "$destination_parent" "$bound_parent"
      ln -s "$outside" "$destination_parent"
      ;;
    leaf)
      mv "$destination" "$bound_destination"
      printf 'replacement=value\n' >"$destination"
      ;;
    *) fail "unknown manifest replacement kind: $replacement_kind" ;;
  esac

  printf 'G' >&9
  set +e
  wait "$mutation_pid"
  mutation_status=$?
  set -e
  exec 8>&-
  exec 9>&-

  [[ "$mutation_status" -ne 0 ]] ||
    fail "$operation accepted a post-bind $replacement_kind replacement"
  [[ "$(<"$outside/manifest.txt")" == "outside-canary" ]] ||
    fail "$operation changed the outside $replacement_kind canary"
  if [[ "$replacement_kind" == "leaf" ]]; then
    [[ "$(<"$destination")" == "replacement=value" ]] ||
      fail "$operation changed the replacement leaf"
  fi
}

assert_manifest_mutation_interposition_rejected fragment-replace parent
assert_manifest_mutation_interposition_rejected fragment-replace leaf
assert_manifest_mutation_interposition_rejected manifest-append parent
assert_manifest_mutation_interposition_rejected manifest-append leaf

mkdir -p "$fresh_root/current"
printf 'current\n' >"$fresh_root/current/result.txt"
printf 'second\n' >"$fresh_root/current/second.txt"
printf 'stale\n' >"$fresh_root/stale.txt"
inventory="$fresh_root/inventory.tsv"
evidence_inventory "$git_fixture" "$inventory" "$fresh_root/current"
grep -Fq 'artifacts/fresh/current/result.txt' "$inventory" ||
  fail "inventory omitted a current artifact"
grep -Fq 'artifacts/fresh/current/second.txt' "$inventory" ||
  fail "inventory omitted a second current artifact"
if grep -Fq 'stale.txt' "$inventory"; then
  fail "inventory included an unrequested stale artifact"
fi
newline_path="$fresh_root/current/line"$'\n'"break.txt"
printf 'unsafe\n' >"$newline_path"
if evidence_inventory "$git_fixture" "$fresh_root/unsafe.tsv" \
  "$fresh_root/current" >/dev/null 2>&1; then
  fail "inventory accepted a filename with a newline"
fi
rm -f "$newline_path"

unsafe_inventory_root="$git_fixture/artifacts/inventory-special-files"
mkdir -p "$unsafe_inventory_root/nested"
printf 'safe\n' >"$unsafe_inventory_root/safe.txt"
ln -s ../safe.txt "$unsafe_inventory_root/nested/link.txt"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/symlink-input.tsv" \
  "$unsafe_inventory_root" >/dev/null 2>&1; then
  fail "inventory accepted a symbolic-link input"
fi
[[ ! -e "$fresh_root/symlink-input.tsv" ]] ||
  fail "rejected symbolic-link input published an inventory"

printf 'hard-link\n' >"$unsafe_inventory_root/hard-source.txt"
ln "$unsafe_inventory_root/hard-source.txt" \
  "$unsafe_inventory_root/hard-input.txt"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/hard-link-input.tsv" \
  "$unsafe_inventory_root/hard-input.txt" >/dev/null 2>&1; then
  fail "inventory accepted a multiply-linked input"
fi
[[ ! -e "$fresh_root/hard-link-input.tsv" ]] ||
  fail "rejected hard-link input published an inventory"

mkfifo "$unsafe_inventory_root/fifo-input"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/fifo-input.tsv" \
  "$unsafe_inventory_root/fifo-input" >/dev/null 2>&1; then
  fail "inventory accepted a FIFO input"
fi
[[ ! -e "$fresh_root/fifo-input.tsv" ]] ||
  fail "rejected FIFO input published an inventory"

output_canary="$fixture/inventory-output-canary.txt"
printf 'output-canary\n' >"$output_canary"
ln -s "$output_canary" "$fresh_root/symlink-output.tsv"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/symlink-output.tsv" \
  "$fresh_root/current/result.txt" >/dev/null 2>&1; then
  fail "inventory accepted a symbolic-link output"
fi
[[ "$(<"$output_canary")" == "output-canary" ]] ||
  fail "rejected symbolic-link output changed its target"

printf 'existing-output\n' >"$fresh_root/output-source.tsv"
ln "$fresh_root/output-source.tsv" "$fresh_root/hard-link-output.tsv"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/hard-link-output.tsv" \
  "$fresh_root/current/result.txt" >/dev/null 2>&1; then
  fail "inventory accepted a multiply-linked output"
fi
[[ "$(<"$fresh_root/output-source.tsv")" == "existing-output" ]] ||
  fail "rejected hard-link output changed its peer"

mkfifo "$fresh_root/fifo-output.tsv"
if evidence_inventory \
  "$git_fixture" \
  "$fresh_root/fifo-output.tsv" \
  "$fresh_root/current/result.txt" >/dev/null 2>&1; then
  fail "inventory accepted a FIFO output"
fi

expect_inventory_verification_failure() {
  local description="$1"
  local candidate_inventory="$2"

  if evidence_verify_inventory \
    "$git_fixture" \
    "$candidate_inventory" >/dev/null 2>&1; then
    fail "inventory verification accepted $description"
  fi
}

verification_index_before="$(
  shasum -a 256 "$git_fixture/.git/index" | awk '{print $1}'
)"
evidence_verify_inventory "$git_fixture" "$inventory"

printf 'altered\n' >"$fresh_root/current/result.txt"
expect_inventory_verification_failure \
  "changed artifact content with the same size" \
  "$inventory"
printf 'current\n' >"$fresh_root/current/result.txt"

printf 'current with a different size\n' >"$fresh_root/current/result.txt"
expect_inventory_verification_failure "changed artifact size" "$inventory"
printf 'current\n' >"$fresh_root/current/result.txt"

wrong_size_inventory="$fresh_root/wrong-size-inventory.tsv"
awk -F '\t' -v OFS='\t' '
  $3 == "artifacts/fresh/current/result.txt" { $2 += 1 }
  { print }
' "$inventory" >"$wrong_size_inventory"
expect_inventory_verification_failure \
  "an incorrect declared artifact size" \
  "$wrong_size_inventory"

rm "$fresh_root/current/result.txt"
expect_inventory_verification_failure "a deleted artifact" "$inventory"
printf 'current\n' >"$fresh_root/current/result.txt"

duplicate_inventory="$fresh_root/duplicate-inventory.tsv"
{
  cat "$inventory"
  head -n 1 "$inventory"
} >"$duplicate_inventory"
expect_inventory_verification_failure \
  "a duplicate artifact path" \
  "$duplicate_inventory"

invalid_inventory="$fresh_root/invalid-inventory.tsv"
printf 'not-an-inventory-row\n' >"$invalid_inventory"
expect_inventory_verification_failure \
  "an invalid inventory row" \
  "$invalid_inventory"

escaping_inventory="$fresh_root/escaping-inventory.tsv"
printf '%s\t1\t../outside.txt\n' \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  >"$escaping_inventory"
expect_inventory_verification_failure \
  "an artifact path outside the repository" \
  "$escaping_inventory"

directory_inventory="$fresh_root/directory-inventory.tsv"
printf '%s\t0\tartifacts/fresh/current\n' \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
  >"$directory_inventory"
expect_inventory_verification_failure \
  "a directory artifact" \
  "$directory_inventory"

unsorted_inventory="$fresh_root/unsorted-inventory.tsv"
awk '{ row[NR] = $0 } END { for (position = NR; position >= 1; position--) print row[position] }' \
  "$inventory" >"$unsorted_inventory"
expect_inventory_verification_failure \
  "non-canonical artifact ordering" \
  "$unsorted_inventory"

expect_required_inventory_paths_failure() {
  local description="$1"
  local candidate_inventory="$2"
  shift 2

  if evidence_require_inventory_paths \
    "$git_fixture" \
    "$candidate_inventory" \
    "$@" >/dev/null 2>&1; then
    fail "required inventory paths accepted $description"
  fi
}

result_relative='artifacts/fresh/current/result.txt'
current_absolute="$(cd "$fresh_root/current" && pwd -P)"
fresh_absolute="$(cd "$fresh_root" && pwd -P)"
result_absolute="$current_absolute/result.txt"
second_absolute="$current_absolute/second.txt"
evidence_require_inventory_paths \
  "$git_fixture" \
  "$inventory" \
  "$result_relative" \
  "$second_absolute"

expect_required_inventory_paths_failure \
  "an empty required-path declaration" \
  "$inventory"
expect_required_inventory_paths_failure \
  "a path omitted from the inventory" \
  "$inventory" \
  "$fresh_absolute/stale.txt"
expect_required_inventory_paths_failure \
  "a duplicate required path" \
  "$inventory" \
  "$result_relative" \
  "$result_relative"
expect_required_inventory_paths_failure \
  "relative and absolute aliases for the same required path" \
  "$inventory" \
  "$result_relative" \
  "$result_absolute"
printf 'outside\n' >"$fixture/outside-required.txt"
outside_absolute="$(cd "$fixture" && pwd -P)/outside-required.txt"
expect_required_inventory_paths_failure \
  "a required path outside the repository" \
  "$inventory" \
  "$outside_absolute"
expect_required_inventory_paths_failure \
  "a non-canonical required path" \
  "$inventory" \
  'artifacts/fresh/current/../current/result.txt'
expect_required_inventory_paths_failure \
  "a directory instead of a file or symbolic link" \
  "$inventory" \
  "$current_absolute"
expect_required_inventory_paths_failure \
  "an inventory that has not passed verification" \
  "$duplicate_inventory" \
  "$result_relative"

verification_index_after="$(
  shasum -a 256 "$git_fixture/.git/index" | awk '{print $1}'
)"
[[ "$verification_index_before" == "$verification_index_after" ]] ||
  fail "inventory verification modified the real Git index"

manifest="$fresh_root/manifest.txt"
evidence_begin_manifest "$manifest" fixture run-1 debug filtered
evidence_append_snapshot "$manifest" "$dirty_fragment"
if evidence_append "$manifest" suite duplicate >/dev/null 2>&1; then
  fail "manifest accepted a duplicate key"
fi
if evidence_finish_manifest "$manifest" 0 missing_key >/dev/null 2>&1; then
  fail "manifest accepted a missing required field"
fi
corrupted_manifest="$fresh_root/corrupted-manifest.txt"
cp "$manifest" "$corrupted_manifest"
printf 'suite=duplicate\n' >>"$corrupted_manifest"
if evidence_finish_manifest "$corrupted_manifest" 1 >/dev/null 2>&1; then
  fail "manifest accepted an externally duplicated key"
fi
evidence_append "$manifest" artifact_inventory_sha256 \
  "$(shasum -a 256 "$inventory" | awk '{print $1}')"
evidence_finish_manifest \
  "$manifest" \
  0 \
  source_worktree_tree_oid \
  artifact_inventory_sha256
grep -Fqx 'suite_exit_status=0' "$manifest" ||
  fail "manifest did not publish its final successful state"

changed_manifest="$fresh_root/changed-manifest.txt"
evidence_begin_manifest "$changed_manifest" fixture run-2 debug full
evidence_append "$changed_manifest" app_binary_sha256 \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
evidence_append "$changed_manifest" app_end_binary_sha256 \
  bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
if evidence_finish_manifest "$changed_manifest" 0 \
  app_binary_sha256 app_end_binary_sha256 >/dev/null 2>&1; then
  fail "manifest accepted a binary replacement during the suite"
fi

resigned_manifest="$fresh_root/resigned-manifest.txt"
evidence_begin_manifest "$resigned_manifest" fixture run-3 debug full
for suffix in \
  binary_sha256 \
  codesign_identifier \
  codesign_kind \
  codesign_identity_sha1 \
  codesign_identity_sha256 \
  codesign_team_identifier \
  codesign_authority \
  designated_requirement_sha256; do
  start_value="fixture-${suffix}"
  end_value="$start_value"
  if [[ "$suffix" == "codesign_identity_sha256" ]]; then
    end_value="replacement-${suffix}"
  fi
  evidence_append "$resigned_manifest" "app_${suffix}" "$start_value"
  evidence_append "$resigned_manifest" "app_end_${suffix}" "$end_value"
done
if evidence_finish_manifest "$resigned_manifest" 0 \
  app_binary_sha256 app_end_binary_sha256 >/dev/null 2>&1; then
  fail "manifest accepted a signature replacement with an unchanged binary"
fi

release_binary="$git_fixture/artifacts/release/Noonmark.app/Contents/MacOS/NoonmarkMacApp"
release_dsym="$git_fixture/artifacts/release/Noonmark.app.dSYM"
release_dwarf="${release_dsym}/Contents/Resources/DWARF/NoonmarkMacApp"
release_symbols_fragment="$fresh_root/release-symbols.fragment"
release_symbols_inventory="$git_fixture/artifacts/release/Noonmark.app.dSYM.inventory.sha256"
release_symbols_manifest="$fresh_root/release-symbols.manifest"
release_tool_dir="$fixture/release-tools"
fixture_dwarfdump="$release_tool_dir/dwarfdump"
mkdir -p "$release_tool_dir"
mkdir -p "$(dirname "$release_binary")" "$(dirname "$release_dwarf")"
printf 'arch=arm64\nuuid=AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE\n' \
  >"$release_binary"
printf 'arch=arm64\nuuid=AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE\n' \
  >"$release_dwarf"
cat >"$fixture_dwarfdump" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
[[ "$1" == "--uuid" && -f "$2" ]]
arch="$(sed -n 's/^arch=//p' "$2")"
uuid="$(sed -n 's/^uuid=//p' "$2")"
[[ -n "$arch" && -n "$uuid" ]]
printf 'UUID: %s (%s) %s\n' "$uuid" "$arch" "$2"
SCRIPT
chmod +x "$fixture_dwarfdump"
cat >"$release_tool_dir/xcrun" <<SCRIPT
#!/usr/bin/env bash
set -euo pipefail
[[ "\$1" == "--find" && "\$2" == "dwarfdump" ]]
printf '%s\n' "$fixture_dwarfdump"
SCRIPT
chmod +x "$release_tool_dir/xcrun"

[[ "$(evidence_release_architecture_description \
  'arm64:AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE')" == "arm64" ]] ||
  fail "release identity did not normalize an arm64 architecture"
[[ "$(evidence_release_architecture_description \
  'x86_64:AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE')" == "x86_64" ]] ||
  fail "release identity did not preserve an x86_64 architecture"
[[ "$(evidence_release_architecture_description \
  'arm64:AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE,x86_64:FFFFFFFF-1111-4222-8333-444444444444')" == "Universal" ]] ||
  fail "release identity did not recognize a Universal architecture"

PATH="$release_tool_dir:$PATH" \
  evidence_capture_release_symbols \
  "$git_fixture" \
  "$release_binary" \
  "$release_dsym" \
  release_symbols \
  "$release_symbols_fragment" \
  "$release_symbols_inventory"
evidence_begin_manifest \
  "$release_symbols_manifest" fixture run-4 release full
evidence_append \
  "$release_symbols_manifest" \
  app_binary_sha256 \
  "$(shasum -a 256 "$release_binary" | awk '{print $1}')"
evidence_append_snapshot \
  "$release_symbols_manifest" \
  "$release_symbols_fragment"
evidence_finish_manifest \
  "$release_symbols_manifest" \
  0 \
  release_symbols_binary_uuid_set \
  release_symbols_dsym_uuid_set \
  release_symbols_dsym_inventory_sha256
PATH="$release_tool_dir:$PATH" \
  evidence_verify_release_symbols \
  "$git_fixture" \
  "$release_binary" \
  "$release_dsym" \
  "$release_symbols_manifest" \
  release_symbols \
  "$release_symbols_inventory"

cat >"$release_tool_dir/sort" <<'SCRIPT'
#!/usr/bin/env bash
exit 73
SCRIPT
chmod +x "$release_tool_dir/sort"
if PATH="$release_tool_dir:$PATH" \
  evidence_release_uuid_set "$release_binary" >/dev/null 2>&1; then
  fail "release UUID evidence hid a canonical-sort failure"
fi
rm -f "$release_tool_dir/sort"

cat >"$release_tool_dir/tr" <<'SCRIPT'
#!/usr/bin/env bash
exit 79
SCRIPT
chmod +x "$release_tool_dir/tr"
if PATH="$release_tool_dir:$PATH" \
  evidence_release_uuid_set "$release_binary" >/dev/null 2>&1; then
  fail "release UUID evidence hid a normalization failure"
fi
rm -f "$release_tool_dir/tr"

uuid_write_fixture="$fixture/uuid-write-failure"
mkdir -p "$uuid_write_fixture"
if (
  export TMPDIR="$uuid_write_fixture"
  mktemp() {
    case "$1" in
      */noonmark-dwarfdump-rows.XXXXXX)
        command mktemp -d "$1"
        ;;
      *)
        command mktemp "$@"
        ;;
    esac
  }
  PATH="$release_tool_dir:$PATH" \
    evidence_release_uuid_set "$release_binary" >/dev/null 2>&1
); then
  fail "release UUID evidence hid a row-write failure"
fi

inventory_write_fixture="$fixture/inventory-write-failure"
mkdir -p "$inventory_write_fixture"
if (
  export TMPDIR="$inventory_write_fixture"
  mktemp() {
    case "$1" in
      */noonmark-dsym-inventory.XXXXXX)
        command mktemp -d "$1"
        ;;
      *)
        command mktemp "$@"
        ;;
    esac
  }
  evidence_capture_release_dsym_inventory \
    "$git_fixture" \
    "$release_dsym" \
    "$fresh_root/rejected-dsym-inventory" >/dev/null 2>&1
); then
  fail "release dSYM evidence hid an inventory row-write failure"
fi

cat >"$release_tool_dir/find" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\0' "$1/NoonmarkMacApp"
exit 74
SCRIPT
chmod +x "$release_tool_dir/find"
if PATH="$release_tool_dir:$PATH" \
  evidence_release_dwarf_path \
  "$release_binary" \
  "$release_dsym" >/dev/null 2>&1; then
  fail "release dSYM evidence hid a directory-scan failure"
fi
rm -f "$release_tool_dir/find"

mv "$release_dsym" "${release_dsym}.missing"
if PATH="$release_tool_dir:$PATH" \
  evidence_verify_release_symbols \
  "$git_fixture" \
  "$release_binary" \
  "$release_dsym" \
  "$release_symbols_manifest" \
  release_symbols \
  "$release_symbols_inventory" >/dev/null 2>&1; then
  fail "release symbol evidence accepted a missing dSYM"
fi
mv "${release_dsym}.missing" "$release_dsym"

printf 'arch=arm64\nuuid=FFFFFFFF-1111-4222-8333-444444444444\n' \
  >"$release_dwarf"
if PATH="$release_tool_dir:$PATH" \
  evidence_require_release_symbol_pair \
  "$release_binary" \
  "$release_dsym" >/dev/null 2>&1; then
  fail "release symbol evidence accepted a mismatched dSYM UUID"
fi
printf 'arch=arm64\nuuid=AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE\n' \
  >"$release_dwarf"

printf 'unexpected directory member\n' >"$(dirname "$release_dwarf")/unexpected.txt"
if PATH="$release_tool_dir:$PATH" \
  evidence_verify_release_symbols \
  "$git_fixture" \
  "$release_binary" \
  "$release_dsym" \
  "$release_symbols_manifest" \
  release_symbols \
  "$release_symbols_inventory" >/dev/null 2>&1; then
  fail "release symbol evidence accepted dSYM directory drift"
fi
rm -f "$(dirname "$release_dwarf")/unexpected.txt"

mkdir "$(dirname "$release_dwarf")/unexpected-empty-directory"
if PATH="$release_tool_dir:$PATH" \
  evidence_verify_release_symbols \
  "$git_fixture" \
  "$release_binary" \
  "$release_dsym" \
  "$release_symbols_manifest" \
  release_symbols \
  "$release_symbols_inventory" >/dev/null 2>&1; then
  fail "release symbol evidence accepted an added empty dSYM directory"
fi
rmdir "$(dirname "$release_dwarf")/unexpected-empty-directory"

app="$fixture/AdHoc.app"
mkdir -p "$app/Contents/MacOS"
printf '#!/usr/bin/env bash\nexit 0\n' >"$app/Contents/MacOS/AdHoc"
chmod +x "$app/Contents/MacOS/AdHoc"
plutil -create xml1 "$app/Contents/Info.plist"
plutil -insert CFBundleIdentifier -string app.noonmark.evidence.fixture \
  "$app/Contents/Info.plist"
plutil -insert CFBundleExecutable -string AdHoc "$app/Contents/Info.plist"
codesign --force --sign - "$app" >/dev/null 2>&1
evidence_capture_bundle "$app" 0 adhoc "$fixture/adhoc.fragment"
if evidence_capture_bundle "$app" 1 stable "$fixture/stable.fragment" \
  >/dev/null 2>&1; then
  fail "stable bundle evidence accepted ad-hoc signing"
fi

diagnostic_dir="$fixture/DiagnosticReports"
