if [[ "$forged_inner_closure_status" -eq 0 ]] ||
  ! grep -F \
    "development-validation evidence disagrees for release diagnostic closure inner evidence_run_id" \
    "$fixture_root/cross-validator-forged-inner-closure-run.stderr" >/dev/null; then
  echo "full validator accepted a forged inner release-closure run ID" >&2
  exit 1
