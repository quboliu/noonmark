noonmark_runtime_validate_all_profiles
noonmark_runtime_profile_load dmg-validation
if [[ "$NOONMARK_RUNTIME_PROFILE" != "dmg-validation" ||
  "$NOONMARK_RUNTIME_BUNDLE_IDENTIFIER" != "$validation_bundle_identifier" ||
  "$NOONMARK_RUNTIME_PROCESS_NAME" != "$validation_executable_name" ||
  "${NOONMARK_RUNTIME_APP_BUNDLE_NAME}.app" != "$validation_bundle_name" ||
  "$NOONMARK_RUNTIME_DATA_DIRECTORY_NAME" != \
    "$validation_data_directory_name" ||
  "$NOONMARK_RUNTIME_ICLOUD_REPOSITORY_NAME" != \
    "$validation_icloud_repository" ||
  "$NOONMARK_RUNTIME_RESETTABLE" != "1" ]]; then
  echo "DMG validation runtime profile does not match the install harness" >&2
  exit 1
fi

evidence_prepare_fresh_directory "$repo_root" "$work_dir"
evidence_prepare_fresh_directory "$repo_root" "$helper_evidence_root"
rm -f "$artifact_inventory_path"

required_tools=(
  awk
  cmp
  ditto
  grep
  hdiutil
  id
  jq
  log
  open
  pgrep
  ps
  screencapture
  sips
  sqlite3
  stat
  sw_vers
  swift
  tail
  uname
  uuidgen
)
for tool in "${required_tools[@]}"; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "missing required tool: $tool" >&2
    exit 1
  fi
done
if [[ ! -x /usr/libexec/PlistBuddy ]]; then
  echo "missing required tool: /usr/libexec/PlistBuddy" >&2
  exit 1
fi

require_equal_evidence_value() {
  local left_path="$1"
  local left_key="$2"
  local right_path="$3"
  local right_key="$4"
  local label="$5"
  local left_value
  local right_value

  left_value="$(evidence_read "$left_path" "$left_key")"
  right_value="$(evidence_read "$right_path" "$right_key")"
  if [[ -z "$left_value" || -z "$right_value" ||
    "$left_value" != "$right_value" ]]; then
    echo "DMG install evidence disagreed for $label" >&2
    return 1
  fi
}

require_installed_identity_value() {
  local manifest_key="$1"
  local plist_key="$2"
  local expected
  local actual

  expected="$(evidence_read "$package_manifest_path" "$manifest_key")"
  actual="$(plutil -extract "$plist_key" raw -o - "$info_plist")"
  if [[ -z "$expected" || "$expected" != "$actual" ]]; then
    echo "installed App identity disagreed for $plist_key" >&2
    return 1
  fi
}

process_uses_installed_executable() {
  local pid="$1"
  local expected_executable="$2"
  local command_line
  local ps_status

  if [[ ! "$pid" =~ ^[0-9]+$ || -z "$expected_executable" ]]; then
    return 2
  fi
  if command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"; then
    if [[ -z "$command_line" ]]; then
      echo "ps returned an empty command for live pid $pid" >&2
      return 2
    fi
  else
    ps_status=$?
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "failed to inspect live pid $pid with ps (status=$ps_status)" >&2
      return 2
    fi
    return 1
  fi
  case "$command_line" in
    "$expected_executable" | "$expected_executable "*) return 0 ;;
    *) return 1 ;;
  esac
}

process_has_helper_command_identity() {
  local pid="$1"
  local mode="$2"
  local token="$3"
  local command_line
  local executable_status

  if [[ "$mode" != "preflight" && "$mode" != "exercise" &&
    "$mode" != "restart" && "$mode" != "diagnostic-export" ]] ||
    [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    return 2
  fi
  process_uses_installed_executable "$pid" "$helper_executable" || {
    executable_status=$?
    return "$executable_status"
  }
  if ! command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"; then
    if kill -0 "$pid" >/dev/null 2>&1; then
      echo "failed to inspect live helper pid $pid" >&2
      return 2
    fi
    return 1
  fi
  case " $command_line " in
    *" --mode $mode "*" --launch-token $token "*) return 0 ;;
    *) return 1 ;;
  esac
}

process_has_helper_bundle_identity() {
  local pid="$1"
  local wait_seconds="${2:-0}"

  if ! process_uses_installed_executable "$pid" "$helper_executable"; then
    return 1
  fi
  if [[ ! "$wait_seconds" =~ ^[0-9]+$ ]]; then
    return 2
  fi

  NOONMARK_DMG_HELPER_PID="$pid" \
    NOONMARK_DMG_HELPER_PATH="$helper_app" \
    NOONMARK_DMG_HELPER_BUNDLE_ID="$helper_bundle_identifier" \
    NOONMARK_DMG_HELPER_IDENTITY_WAIT_SECONDS="$wait_seconds" \
    swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawPID = environment["NOONMARK_DMG_HELPER_PID"],
      let pid = Int32(rawPID),
      let expectedPath = environment["NOONMARK_DMG_HELPER_PATH"],
      let expectedBundleID = environment["NOONMARK_DMG_HELPER_BUNDLE_ID"],
      let rawWaitSeconds = environment["NOONMARK_DMG_HELPER_IDENTITY_WAIT_SECONDS"],
      let waitSeconds = TimeInterval(rawWaitSeconds), waitSeconds >= 0
else {
    fputs("helper process identity was unavailable\n", stderr)
    exit(1)
}

let expected = URL(fileURLWithPath: expectedPath)
    .standardizedFileURL.resolvingSymlinksInPath().path
let deadline = ProcessInfo.processInfo.systemUptime + waitSeconds
repeat {
    if let app = NSRunningApplication(processIdentifier: pid), app.isTerminated == false {
        if let bundleID = app.bundleIdentifier, let bundleURL = app.bundleURL {
            guard bundleID == expectedBundleID else {
                fputs("helper process bundle id was \(bundleID), expected \(expectedBundleID)\n", stderr)
                exit(1)
            }
            let actual = bundleURL.standardizedFileURL.resolvingSymlinksInPath().path
            guard actual == expected else {
                fputs("helper process bundle path was \(actual), expected \(expected)\n", stderr)
                exit(1)
            }
            exit(0)
        }
    }
    if ProcessInfo.processInfo.systemUptime >= deadline { break }
    usleep(25000)
} while true

fputs("helper process LaunchServices identity was unavailable before the deadline\n", stderr)
exit(1)
'
}

helper_process_identity_matches() {
  local pid="$1"
  local mode="$2"
  local token="$3"
  local wait_seconds="${4:-0}"

  process_has_helper_command_identity "$pid" "$mode" "$token" &&
    process_has_helper_bundle_identity "$pid" "$wait_seconds"
}

matching_owned_helper_pids() {
  local mode="$1"
  local token="$2"
  local candidate
  local matches=""
  local match_status
  local pgrep_output=""
  local pgrep_status

  if pgrep_output="$(pgrep -x "$helper_executable_name" 2>/dev/null)"; then
    :
  else
    pgrep_status=$?
    if [[ "$pgrep_status" -eq 1 ]]; then
      return 0
    fi
    echo "failed to enumerate $helper_executable_name processes (pgrep=$pgrep_status)" >&2
    return 2
  fi
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if process_has_helper_command_identity "$candidate" "$mode" "$token"; then
      if [[ -n "$matches" ]]; then
        matches+=$'\n'
      fi
      matches+="$candidate"
    else
      match_status=$?
      if [[ "$match_status" -ge 2 ]]; then
        return "$match_status"
      fi
    fi
  done <<<"$pgrep_output"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches"
  fi
}

terminate_verified_helper() {
  local pid="${1:-}"
  local mode="${2:-}"
  local token="${3:-}"

  if [[ -z "$pid" ]] || ! kill -0 "$pid" >/dev/null 2>&1; then
    return 0
  fi
  if ! helper_process_identity_matches "$pid" "$mode" "$token"; then
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    echo "refusing to terminate helper pid without exact command and bundle identity: $pid" >&2
    ps -ww -p "$pid" -o pid=,command= >&2 || true
    return 1
  fi

  kill -TERM "$pid" >/dev/null 2>&1 || true
  for _ in {1..40}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  if ! helper_process_identity_matches "$pid" "$mode" "$token"; then
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    echo "refusing to force-terminate helper pid after its identity changed: $pid" >&2
    ps -ww -p "$pid" -o pid=,command= >&2 || true
    return 1
  fi
  kill -KILL "$pid" >/dev/null 2>&1 || true
  for _ in {1..20}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  echo "failed to terminate verified helper pid: $pid" >&2
  ps -ww -p "$pid" -o pid=,command= >&2 || true
  return 1
}

helper_observer_is_owned_child() {
  local pid="$1"
  local expected_parent="$2"
  local expected_token="$3"
  local observed_parent
  local command_line
  local observer_module="NoonmarkExitObserver_${expected_token//-/}"

  if ! observed_parent="$(ps -p "$pid" -o ppid= 2>/dev/null)"; then
    return 1
  fi
  observed_parent="${observed_parent//[[:space:]]/}"
  if [[ "$observed_parent" != "$expected_parent" ]] ||
    ! command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"; then
    return 1
  fi
  case " $command_line " in
    *" -module-name $observer_module "*) return 0 ;;
    *) return 1 ;;
  esac
}

stop_active_helper_observer() {
  local pid="$active_helper_observer_pid"
  local expected_parent="$active_helper_observer_parent_pid"
  local expected_token="$active_helper_observer_token"

  if [[ -z "$pid" ]]; then
    return 0
  fi
  if kill -0 "$pid" >/dev/null 2>&1; then
    if ! helper_observer_is_owned_child "$pid" "$expected_parent" "$expected_token"; then
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        wait "$pid" >/dev/null 2>&1 || true
        active_helper_observer_pid=""
        active_helper_observer_parent_pid=""
        active_helper_observer_token=""
        return 0
      fi
      echo "refusing to signal an unverified helper exit observer: $pid" >&2
      return 1
    fi
    kill -TERM "$pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        break
      fi
      sleep 0.05
    done
    if kill -0 "$pid" >/dev/null 2>&1; then
      if ! helper_observer_is_owned_child "$pid" "$expected_parent" "$expected_token"; then
        if ! kill -0 "$pid" >/dev/null 2>&1; then
          wait "$pid" >/dev/null 2>&1 || true
          active_helper_observer_pid=""
          active_helper_observer_parent_pid=""
          active_helper_observer_token=""
          return 0
        fi
        echo "refusing to force-terminate a reused observer pid: $pid" >&2
        return 1
      fi
      kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
  fi
  wait "$pid" >/dev/null 2>&1 || true
  active_helper_observer_pid=""
  active_helper_observer_parent_pid=""
  active_helper_observer_token=""
}

cleanup_owned_helper_processes() {
  local mode="$active_helper_mode"
  local token="$active_helper_token"
  local owned_pids=""
  local remaining_pids=""
  local pid

  if [[ -z "$mode" || -z "$token" ]]; then
    return 0
  fi
  if ! owned_pids="$(matching_owned_helper_pids "$mode" "$token")"; then
    echo "failed to enumerate helper processes owned by this launch token" >&2
    return 1
  fi
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      continue
    fi
    if ! process_has_helper_bundle_identity "$pid"; then
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        continue
      fi
      echo "refusing to terminate token-matched helper without bundle identity: $pid" >&2
      return 1
    fi
    if ! terminate_verified_helper "$pid" "$mode" "$token"; then
      return 1
    fi
  done <<<"$owned_pids"
  if ! remaining_pids="$(matching_owned_helper_pids "$mode" "$token")"; then
    echo "failed to prove token-scoped helper cleanup" >&2
    return 1
  fi
  if [[ -n "$remaining_pids" ]]; then
    echo "token-scoped helper process survived cleanup: $remaining_pids" >&2
    return 1
  fi
  active_helper_pid=""
  active_helper_mode=""
  active_helper_token=""
}

terminate_verified_app() {
  local pid="${1:-}"
  local expected_executable="${2:-}"

  if [[ -z "$pid" ]]; then
    return 0
  fi
  if ! kill -0 "$pid" >/dev/null 2>&1; then
    return 0
  fi
  if [[ -z "$expected_executable" ]] ||
    ! process_uses_installed_executable "$pid" "$expected_executable"; then
    echo "refusing to terminate unverified pid $pid" >&2
    ps -ww -p "$pid" -o pid=,command= >&2 || true
    return 1
  fi
  if [[ "$expected_executable" == "$installed_executable" &&
    -n "$installed_app" ]] &&
    ! process_has_installed_bundle_identity "$pid"; then
    echo "refusing to terminate pid $pid without a current bundle identity match" >&2
    return 1
  fi

  kill -TERM "$pid" >/dev/null 2>&1 || true
  for _ in {1..40}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  if ! process_uses_installed_executable "$pid" "$expected_executable"; then
    echo "refusing to force-terminate pid $pid after its executable identity changed" >&2
    ps -ww -p "$pid" -o pid=,command= >&2 || true
    return 1
  fi
  if [[ "$expected_executable" == "$installed_executable" &&
    -n "$installed_app" ]] &&
    ! process_has_installed_bundle_identity "$pid"; then
    echo "refusing to force-terminate pid $pid without a current bundle identity match" >&2
    return 1
  fi
  kill -KILL "$pid" >/dev/null 2>&1 || true
  for _ in {1..20}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  echo "failed to terminate verified installed app pid: $pid" >&2
  ps -ww -p "$pid" -o pid=,command= >&2 || true
  return 1
}

capture_diagnostic_final_and_diff() {
  local process_name="$1"
  local baseline_path="$2"
  local final_path="$3"
  local diff_path="$4"

  if ! runtime_evidence_snapshot_diagnostics "$process_name" "$final_path"; then
    return 1
  fi
  if ! comm -13 "$baseline_path" "$final_path" >"$diff_path"; then
    echo "failed to preserve DiagnosticReports diff for $process_name" >&2
    return 1
  fi
  if [[ -s "$diff_path" ]]; then
    echo "new DiagnosticReports remained for $process_name" >&2
    cat "$diff_path" >&2
    return 1
  fi
}

cleanup() {
  local original_status=$?
  local final_status="$original_status"
  local diagnostic_wait_attempts=30
  local diagnostic_status=missing
  local helper_unchanged=true
  local installed_app_unchanged=true
  local source_tree_unchanged=true
  local exact_pids=""
  local remaining_pids=""
  local verified_pid
  local diagnostic_inventory_count=""
  local diagnostic_inventory_digest=""
  local diagnostic_inventory_size=""
  local diagnostic_inventory_relative=""

  trap - EXIT
  set +e

  if ! cleanup_owned_helper_processes; then
    final_status=1
  fi
  if ! stop_active_helper_observer; then
    final_status=1
  fi
  if ! terminate_verified_app "$active_app_pid" "$installed_executable"; then
    final_status=1
  fi
  active_app_pid=""
  if ! exact_pids="$(matching_executable_pids)"; then
    echo "failed to enumerate exact-path installed app processes during cleanup" >&2
    final_status=1
  else
    while IFS= read -r verified_pid; do
      [[ -n "$verified_pid" ]] || continue
      if ! process_has_installed_bundle_identity "$verified_pid"; then
        echo "refusing to terminate exact-path pid without bundle identity: $verified_pid" >&2
        final_status=1
        continue
      fi
      if ! terminate_verified_app "$verified_pid" "$installed_executable"; then
        final_status=1
      fi
    done <<<"$exact_pids"
  fi
  if ! remaining_pids="$(matching_executable_pids)"; then
    echo "failed to prove exact-path process cleanup" >&2
    final_status=1
  elif [[ -n "$remaining_pids" ]]; then
    echo "exact-path installed app process survived cleanup: $remaining_pids" >&2
    final_status=1
  fi
  if ! runtime_evidence_stop_console_capture; then
    final_status=1
  fi

  if [[ "$mount_cleanup_armed" -eq 1 && -n "$mountpoint" ]]; then
    if ! hdiutil detach "$mountpoint" -quiet >/dev/null 2>&1; then
      echo "failed to detach DMG validation mountpoint: $mountpoint" >&2
      final_status=1
    fi
    mount_cleanup_armed=0
    if ! rmdir "$mountpoint" >/dev/null 2>&1; then
      echo "failed to remove DMG validation mountpoint: $mountpoint" >&2
      final_status=1
    fi
  fi

  if [[ "$original_status" -ne 0 ]]; then
    diagnostic_wait_attempts=150
  fi
  if [[ "$diagnostic_baselines_ready" -eq 1 ]]; then
    if ! runtime_evidence_assert_no_new_diagnostics \
      "$executable_name" \
      "$app_diagnostic_baseline" \
      "$diagnostic_artifact_dir" \
      "$diagnostic_wait_attempts"; then
      final_status=1
    fi
    if ! runtime_evidence_assert_no_new_diagnostics \
      "$helper_executable_name" \
      "$helper_diagnostic_baseline" \
      "$diagnostic_artifact_dir" \
      "$diagnostic_wait_attempts"; then
      final_status=1
    fi
    if ! capture_diagnostic_final_and_diff \
      "$executable_name" \
      "$app_diagnostic_baseline" \
      "$app_diagnostic_final" \
      "$app_diagnostic_diff"; then
      final_status=1
    fi
    if ! capture_diagnostic_final_and_diff \
      "$helper_executable_name" \
      "$helper_diagnostic_baseline" \
      "$helper_diagnostic_final" \
      "$helper_diagnostic_diff"; then
      final_status=1
    fi
  fi
  if [[ "$runtime_manifest_started" -eq 1 ]]; then
    if ! evidence_capture_source \
      "$repo_root" \
      "source_end" \
      "$source_end_fragment"; then
      source_tree_unchanged=false
      final_status=1
    else
      evidence_append_snapshot "$runtime_manifest_path" "$source_end_fragment"
      if ! require_equal_evidence_value \
        "$source_fragment" \
        "source_worktree_tree_oid" \
        "$source_end_fragment" \
        "source_end_worktree_tree_oid" \
        "install source tree stability"; then
        source_tree_unchanged=false
        final_status=1
      fi
    fi
    if ! evidence_capture_bundle \
      "$installed_app" \
      1 \
      "installed_app_end" \
      "$installed_app_end_fragment"; then
      installed_app_unchanged=false
      final_status=1
    else
      evidence_append_snapshot \
        "$runtime_manifest_path" \
        "$installed_app_end_fragment"
      if ! evidence_require_bundle_snapshots_equal \
        "$installed_app_fragment" \
        "installed_app" \
        "$installed_app_end_fragment" \
        "installed_app_end" \
        "installed App"; then
        installed_app_unchanged=false
        final_status=1
      fi
    fi
    if ! evidence_capture_bundle \
      "$helper_app" \
      1 \
      "helper_end" \
      "$helper_end_fragment"; then
      helper_unchanged=false
      final_status=1
    else
      evidence_append_snapshot "$runtime_manifest_path" "$helper_end_fragment"
      if ! evidence_require_bundle_snapshots_equal \
        "$helper_fragment" \
        "helper" \
        "$helper_end_fragment" \
        "helper_end" \
        "DMG install helper"; then
        helper_unchanged=false
        final_status=1
      fi
    fi
    evidence_append \
      "$runtime_manifest_path" \
      "source_tree_unchanged" \
      "$source_tree_unchanged"
    evidence_append \
      "$runtime_manifest_path" \
      "installed_app_binary_unchanged" \
      "$installed_app_unchanged"
    evidence_append \
      "$runtime_manifest_path" \
      "installed_app_signature_unchanged" \
      "$installed_app_unchanged"
    evidence_append \
      "$runtime_manifest_path" \
      "helper_binary_unchanged" \
      "$helper_unchanged"
    evidence_append \
      "$runtime_manifest_path" \
      "helper_signature_unchanged" \
      "$helper_unchanged"
    if [[ -f "$app_diagnostic_baseline" &&
      -f "$app_diagnostic_final" &&
      -f "$app_diagnostic_diff" &&
      -f "$helper_diagnostic_baseline" &&
      -f "$helper_diagnostic_final" &&
      -f "$helper_diagnostic_diff" ]]; then
      evidence_append \
        "$runtime_manifest_path" \
        "app_diagnostic_baseline_sha256" \
        "$(shasum -a 256 "$app_diagnostic_baseline" | awk '{print $1}')"
      evidence_append \
        "$runtime_manifest_path" \
        "app_diagnostic_final_sha256" \
        "$(shasum -a 256 "$app_diagnostic_final" | awk '{print $1}')"
      evidence_append \
        "$runtime_manifest_path" \
        "app_diagnostic_diff_sha256" \
        "$(shasum -a 256 "$app_diagnostic_diff" | awk '{print $1}')"
      evidence_append \
        "$runtime_manifest_path" \
        "helper_diagnostic_baseline_sha256" \
        "$(shasum -a 256 "$helper_diagnostic_baseline" | awk '{print $1}')"
      evidence_append \
        "$runtime_manifest_path" \
        "helper_diagnostic_final_sha256" \
        "$(shasum -a 256 "$helper_diagnostic_final" | awk '{print $1}')"
      evidence_append \
        "$runtime_manifest_path" \
        "helper_diagnostic_diff_sha256" \
        "$(shasum -a 256 "$helper_diagnostic_diff" | awk '{print $1}')"
      if cmp -s "$app_diagnostic_baseline" "$app_diagnostic_final" &&
        cmp -s "$helper_diagnostic_baseline" "$helper_diagnostic_final" &&
        [[ ! -s "$app_diagnostic_diff" ]] &&
        [[ ! -s "$helper_diagnostic_diff" ]]; then
        diagnostic_status=clean
      else
        diagnostic_status=changed
        final_status=1
      fi
    else
      final_status=1
    fi
    evidence_append \
      "$runtime_manifest_path" \
      "diagnostic_diff_status" \
      "$diagnostic_status"
    release_symbols_unchanged=true
    if ! evidence_verify_release_symbols \
      "$repo_root" \
      "$release_binary_path" \
      "$release_dsym_path" \
      "$package_manifest_path" \
      "release_symbols" \
      "$release_dsym_inventory_path"; then
      release_symbols_unchanged=false
      final_status=1
    fi
    evidence_append \
      "$runtime_manifest_path" \
      "release_symbols_unchanged" \
      "$release_symbols_unchanged"
    release_identity_provenance_unchanged=true
    if ! evidence_verify_release_identity_provenance \
      "$repo_root" \
      "$release_identity_provenance_path" \
      "$package_manifest_path" \
      release_identity; then
      release_identity_provenance_unchanged=false
      final_status=1
    fi
    evidence_append \
      "$runtime_manifest_path" \
      "release_identity_provenance_unchanged" \
      "$release_identity_provenance_unchanged"
    if [[ "$final_status" -eq 0 ]]; then
      if evidence_inventory \
        "$repo_root" \
        "$artifact_inventory_path" \
        "$dmg_path" \
        "${dmg_path}.sha256" \
        "$package_manifest_path" \
        "$package_inventory_path" \
        "$release_dsym_path" \
        "$release_dsym_inventory_path" \
        "$release_identity_provenance_path" \
        "$helper_app" \
        "$install_dir" \
        "$validation_derivation_fragment" \
        "$screenshot_path" \
        "$window_metadata_path" \
        "$initial_launch_log" \
        "$initial_console_log" \
        "$permission_ledger" \
        "$permission_log" \
        "$permission_console_log" \
        "$exercise_ledger" \
        "$exercise_launch_log" \
        "$exercise_helper_log" \
        "$exercise_console_log" \
        "$exercise_screenshot_path" \
        "$exercise_window_metadata_path" \
        "$restart_ledger" \
        "$restart_launch_log" \
        "$restart_helper_log" \
        "$restart_console_log" \
        "$restart_screenshot_path" \
        "$restart_window_metadata_path" \
        "$diagnostic_export_ledger" \
        "$diagnostic_export_launch_log" \
        "$diagnostic_export_helper_log" \
        "$diagnostic_export_helper_stderr_log" \
        "$diagnostic_export_helper_launch_log" \
        "$diagnostic_export_helper_observer_log" \
        "$diagnostic_export_helper_observer_gate" \
        "$diagnostic_export_helper_exit_status" \
        "$diagnostic_export_console_log" \
        "$diagnostic_export_screenshot_path" \
        "$diagnostic_export_window_metadata_path" \
        "$diagnostic_export_path" \
        "$diagnostic_export_sentinels_path" \
        "$diagnostic_export_package_report" \
        "$task_identity_path" \
        "$task_snapshot_before_path" \
        "$task_snapshot_after_path" \
        "$app_diagnostic_baseline" \
        "$app_diagnostic_final" \
        "$app_diagnostic_diff" \
        "$helper_diagnostic_baseline" \
        "$helper_diagnostic_final" \
        "$helper_diagnostic_diff"; then
        diagnostic_inventory_relative="$(
          evidence_read "$runtime_manifest_path" diagnostic_export_path
        )"
        IFS=$'\t' read -r \
          diagnostic_inventory_count \
          diagnostic_inventory_digest \
          diagnostic_inventory_size < <(
            awk -F $'\t' -v expected="$diagnostic_inventory_relative" '
              $3 == expected {
                count += 1
                digest = $1
                size = $2
              }
              END { printf "%d\t%s\t%s\n", count, digest, size }
            ' "$artifact_inventory_path"
          )
        if [[ "$diagnostic_inventory_count" -ne 1 ||
          "$diagnostic_inventory_digest" != "$(
            evidence_read "$runtime_manifest_path" diagnostic_export_sha256
          )" ||
          "$diagnostic_inventory_size" != "$(
            evidence_read "$runtime_manifest_path" diagnostic_export_bytes
          )" ]]; then
          echo "diagnostic export changed before its final artifact inventory binding" >&2
          final_status=1
        else
          evidence_append \
            "$runtime_manifest_path" \
            "artifact_inventory_sha256" \
            "$(shasum -a 256 "$artifact_inventory_path" | awk '{print $1}')"
        fi
      else
        final_status=1
      fi
    fi
    if ! evidence_finish_manifest \
      "$runtime_manifest_path" \
      "$final_status" \
      "source_worktree_tree_oid" \
      "source_end_worktree_tree_oid" \
      "mounted_app_binary_sha256" \
      "installed_app_binary_sha256" \
      "installed_app_end_binary_sha256" \
      "helper_binary_sha256" \
      "helper_end_binary_sha256" \
      "dmg_sha256" \
      "package_manifest_sha256" \
      "package_release_symbols_binary_sha256" \
      "package_release_symbols_binary_uuid_set" \
      "package_release_symbols_dsym_dwarf_sha256" \
      "package_release_symbols_dsym_uuid_set" \
      "package_release_symbols_dsym_inventory_sha256" \
      "package_release_identity_version" \
      "package_release_identity_build" \
      "package_release_identity_git_commit" \
      "package_release_identity_build_date" \
      "package_release_identity_runtime" \
      "package_release_identity_minimum_os_version" \
      "package_release_identity_architecture" \
      "package_release_identity_binary_uuid_set" \
      "package_release_identity_binary_sha256" \
      "package_release_identity_binary_sha256_scope" \
      "package_release_identity_provenance_path" \
      "package_release_identity_provenance_sha256" \
      "production_bundle_identifier" \
      "production_mounted_executable" \
      "production_app_executed" \
      "validation_bundle_identifier" \
      "validation_executable" \
      "validation_data_directory_name" \
      "validation_icloud_repository" \
      "validation_derivation_allowed_delta" \
      "validation_derivation_source_binary_sha256" \
      "validation_derivation_pre_sign_binary_sha256" \
      "validation_derivation_pre_sign_uuid_set" \
      "validation_source_linked_binary_sha256" \
      "validation_source_linked_binary_sha256_scope" \
      "validation_source_linked_binary_uuid_set" \
      "validation_signed_binary_sha256" \
      "validation_signed_binary_uuid_set" \
      "validation_derivation_fragment_sha256" \
      "validation_app_executed" \
      "diagnostic_export_ui_completed" \
      "diagnostic_export_lock_overlap" \
      "diagnostic_export_schema_version" \
      "diagnostic_export_identity_match" \
      "diagnostic_export_runtime_identity_match" \
      "diagnostic_export_size_within_limit" \
      "diagnostic_export_sentinels_absent" \
      "diagnostic_export_owner_only" \
      "diagnostic_export_path" \
      "diagnostic_export_bytes" \
      "diagnostic_export_sha256" \
      "diagnostic_export_runtime_architecture" \
      "diagnostic_export_operating_system_version" \
      "diagnostic_export_darwin_version" \
      "diagnostic_export_ledger_sha256" \
      "diagnostic_export_app_launch_sha256" \
      "diagnostic_export_helper_stdout_sha256" \
      "diagnostic_export_helper_stderr_sha256" \
      "diagnostic_export_helper_launch_sha256" \
      "diagnostic_export_helper_observer_sha256" \
      "diagnostic_export_helper_observer_gate_sha256" \
      "diagnostic_export_helper_exit_status_sha256" \
      "diagnostic_export_window_metadata_sha256" \
      "diagnostic_export_console_sha256" \
      "diagnostic_export_package_report_sha256" \
      "release_symbols_unchanged" \
      "release_identity_provenance_unchanged" \
      "artifact_inventory_sha256" \
      "source_tree_unchanged" \
      "installed_app_binary_unchanged" \
      "installed_app_signature_unchanged" \
      "helper_binary_unchanged" \
      "helper_signature_unchanged" \
      "diagnostic_diff_status"; then
      final_status=1
    fi
  fi

  if [[ "$final_status" -ne 0 && "$original_status" -eq 0 ]]; then
    echo "DMG install validation failed while collecting runtime evidence" >&2
  fi
  exit "$final_status"
}
trap cleanup EXIT

matching_executable_pids() {
  local candidate
  local matches=""
  local match_status
  local pgrep_output=""
  local pgrep_status

  if [[ -z "$installed_executable" ]]; then
    return 0
  fi
  if pgrep_output="$(pgrep -x "$executable_name" 2>/dev/null)"; then
    :
  else
    pgrep_status=$?
    if [[ "$pgrep_status" -eq 1 ]]; then
      return 0
    fi
    echo "failed to enumerate $executable_name processes (pgrep=$pgrep_status)" >&2
    return 2
  fi
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if process_uses_installed_executable "$candidate" "$installed_executable"; then
      if [[ -n "$matches" ]]; then
        matches+=$'\n'
      fi
      matches+="$candidate"
    else
      match_status=$?
      if [[ "$match_status" -ge 2 ]]; then
        return "$match_status"
      fi
    fi
  done <<<"$pgrep_output"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches"
  fi
}

matching_installed_pids() {
  local candidate
  local executable_pids=""
  local matches=""

  if [[ -z "$installed_app" ]]; then
    return 0
  fi
  if ! executable_pids="$(matching_executable_pids)"; then
    return 2
  fi
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if process_has_installed_bundle_identity "$candidate" 2>/dev/null; then
      if [[ -n "$matches" ]]; then
        matches+=$'\n'
      fi
      matches+="$candidate"
    fi
  done <<<"$executable_pids"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches"
  fi
}

single_installed_pid() {
  local pids

  if ! pids="$(matching_installed_pids)"; then
    return 2
  fi
  if [[ -z "$pids" || "$pids" == *$'\n'* ]]; then
    return 1
  fi
  printf '%s\n' "$pids"
}

wait_for_installed_pid() {
  local pid=""
  local status

  for _ in {1..80}; do
    if pid="$(single_installed_pid)"; then
      printf '%s\n' "$pid"
      return 0
    else
      status=$?
      if [[ "$status" -ge 2 ]]; then
        echo "installed app process enumeration failed closed" >&2
        return "$status"
      fi
    fi
    sleep 0.1
  done
  echo "installed app did not expose exactly one verified $executable_name process" >&2
  pgrep -alf "$executable_name" >&2 || true
  return 1
}

run_verified_app_action() {
  local pid="$1"
  local action="$2"

  if ! process_uses_installed_executable "$pid" "$installed_executable"; then
    return 1
  fi

    NOONMARK_DMG_APP_PID="$pid" \
    NOONMARK_DMG_APP_PATH="$installed_app" \
    NOONMARK_DMG_BUNDLE_ID="$validation_bundle_identifier" \
    NOONMARK_DMG_APP_ACTION="$action" \
    swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawPID = environment["NOONMARK_DMG_APP_PID"],
      let pid = Int32(rawPID),
      let expectedPath = environment["NOONMARK_DMG_APP_PATH"],
      let expectedBundleID = environment["NOONMARK_DMG_BUNDLE_ID"],
      let action = environment["NOONMARK_DMG_APP_ACTION"],
      action == "verify" || action == "terminate",
      let app = NSRunningApplication(processIdentifier: pid),
      app.isTerminated == false,
      app.bundleIdentifier == expectedBundleID,
      let bundleURL = app.bundleURL
else {
    fputs("installed process identity was unavailable\n", stderr)
    exit(1)
}
let actual = bundleURL.standardizedFileURL.resolvingSymlinksInPath().path
let expected = URL(fileURLWithPath: expectedPath)
    .standardizedFileURL.resolvingSymlinksInPath().path
guard actual == expected else {
    fputs("installed process bundle path was \(actual), expected \(expected)\n", stderr)
    exit(1)
}
if action == "terminate", app.terminate() == false {
    fputs("verified validation app rejected its termination request\n", stderr)
    exit(1)
}
'
}

process_has_installed_bundle_identity() {
  run_verified_app_action "$1" verify
}

verify_installed_process_identity() {
  local pid="$1"

  if ! process_has_installed_bundle_identity "$pid"; then
    echo "unexpected installed app identity for pid $pid" >&2
    ps -ww -p "$pid" -o pid=,command= >&2 || true
    return 1
  fi
}

request_verified_app_termination() {
  local pid="$1"

  run_verified_app_action "$pid" terminate
  if ! wait_for_pid_exit "$pid"; then
    echo "verified installed app did not accept a graceful termination request" >&2
    return 1
  fi
}

wait_for_pid_exit() {
  local pid="$1"

  for _ in {1..80}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  echo "process did not terminate after its verified termination action: $pid" >&2
  return 1
}

start_runtime_capture() {
  local output_path="$1"

  runtime_evidence_start_console_capture \
    "$executable_name" \
    "$output_path" \
    "$helper_executable_name"
}

dump_helper_evidence() {
  local ledger_path="$1"
  local helper_log_path="$2"
  local helper_stderr_path="$3"
  local helper_launch_path="$4"
  local observer_log_path="$5"
  local exit_result_path="$6"
  local evidence_path

  for evidence_path in \
    "$ledger_path" \
    "$helper_log_path" \
    "$helper_stderr_path" \
    "$helper_launch_path" \
    "$observer_log_path" \
    "$exit_result_path"; do
    if [[ -f "$evidence_path" ]]; then
      echo "helper evidence: $evidence_path" >&2
      cat "$evidence_path" >&2
    fi
  done
}

HELPER_PROCESS_PID=""

wait_for_helper_process_record() {
  local mode="$1"
  local token="$2"
  local ledger_path="$3"
  local process_count process_detail
  local mode_field pid_field token_field extra_field
  local helper_pid owned_pids

  HELPER_PROCESS_PID=""
  for _ in {1..400}; do
    if [[ -f "$ledger_path" ]]; then
      if grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
        echo "DMG install harness failed before its process identity was verified" >&2
        return 1
      fi
      IFS=$'\t' read -r process_count process_detail < <(
        awk -F $'\t' '
          $2 == "PASS" && $3 == "process" { count += 1; detail = $4 }
          END { printf "%d\t%s\n", count, detail }
        ' "$ledger_path"
      )
      if [[ "$process_count" -gt 1 ]]; then
        echo "DMG install harness emitted duplicate process records" >&2
        return 1
      fi
      if [[ "$process_count" -eq 1 ]]; then
        read -r mode_field pid_field token_field extra_field <<<"$process_detail"
        if [[ -n "${extra_field:-}" || "$mode_field" != "mode=$mode" ||
          "$pid_field" != helper_pid=* || "$token_field" != "launch_token=$token" ]]; then
          echo "invalid helper process record: $process_detail" >&2
          return 1
        fi
        helper_pid="${pid_field#helper_pid=}"
        if [[ ! "$helper_pid" =~ ^[0-9]+$ || "$helper_pid" -le 0 ]]; then
          echo "invalid helper pid in process record: $helper_pid" >&2
          return 1
        fi
        active_helper_pid="$helper_pid"
        if ! helper_process_identity_matches "$helper_pid" "$mode" "$token" 3; then
          echo "helper process failed exact executable, command, bundle, or path identity" >&2
          ps -ww -p "$helper_pid" -o pid=,command= >&2 || true
          return 1
        fi
        if ! owned_pids="$(matching_owned_helper_pids "$mode" "$token")"; then
          echo "failed to enumerate the token-scoped helper process" >&2
          return 1
        fi
        if [[ "$owned_pids" != "$helper_pid" ]]; then
          echo "launch token did not identify exactly one helper pid: $owned_pids" >&2
          return 1
        fi
        HELPER_PROCESS_PID="$helper_pid"
        return 0
      fi
    fi
    sleep 0.025
  done
  echo "timed out waiting for the LaunchServices helper process record" >&2
  return 1
}

start_helper_exit_observer() {
  local mode="$1"
  local helper_pid="$2"
  local token="$3"
  local gate_path="$4"
  local result_path="$5"
  local observer_log_path="$6"

  start_helper_exit_observer_process \
    "$mode" \
    "$helper_pid" \
    "$token" \
    "$gate_path" \
    "$result_path" \
    "$observer_log_path" \
    120 \
    "${repo_root}/scripts/dmg-install-exit-observer.swift"
}

assert_helper_completed() {
  local mode="$1"
  local ledger_path="$2"
  local helper_log_path="$3"
  local helper_stderr_path="$4"
  local helper_launch_path="$5"
  local observer_log_path="$6"
  local exit_result_path="$7"
  local helper_pid="$8"
  local token="$9"
  local last_line=""
  local timestamp status step detail
  local required_step step_count step_line previous_step_line=0
  local required_steps=()

  if ! awk -v mode="$mode" -v pid="$helper_pid" -v token="$token" '
    NR == 1 { valid += ($0 == "status=PASS") }
    NR == 2 { valid += ($0 == "mode=" mode) }
    NR == 3 { valid += ($0 == "helper_pid=" pid) }
    NR == 4 { valid += ($0 == "launch_token=" token) }
    NR == 5 { valid += ($0 ~ /^fflags=0x[0-9A-F]+$/) }
    NR == 6 { valid += ($0 == "raw_status=0") }
    NR == 7 { valid += ($0 == "normal_exit=true") }
    NR == 8 { valid += ($0 == "exit_code=0") }
    NR == 9 { valid += ($0 == "signal=0") }
    END { exit !(NR == 9 && valid == 9) }
  ' "$exit_result_path"; then
    echo "DMG install harness did not expose a normal kernel exit status in $mode mode" >&2
    return 1
  fi
  if [[ ! -s "$ledger_path" ]]; then
    echo "DMG install harness ledger is missing or empty: $ledger_path" >&2
    return 1
  fi
  if ! cmp -s "$ledger_path" "$helper_log_path"; then
    echo "DMG install harness stdout did not exactly match its synchronized ledger" >&2
    return 1
  fi
  if [[ -s "$helper_stderr_path" || -s "$helper_launch_path" ||
    -s "$observer_log_path" ]]; then
    echo "DMG install harness emitted unexpected stderr, launcher, or observer output" >&2
    return 1
  fi
  if grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
    echo "DMG install harness recorded a failure in $mode mode" >&2
    cat "$ledger_path" >&2
    return 1
  fi
  if ! grep -F $'\tPASS\tpermissions\tAXIsProcessTrusted=true CGPreflightPostEventAccess=true' \
    "$ledger_path" >/dev/null 2>&1; then
    echo "DMG install harness did not prove both input permissions in $mode mode" >&2
    cat "$ledger_path" >&2
    return 1
  fi

  case "$mode" in
    preflight)
      required_steps=(arguments process exit-observer permissions complete)
      ;;
    exercise)
      required_steps=(
        arguments
        process
        exit-observer
        permissions
        target
        main-window
        settings-menu
        settings-window
        settings-close
        quick-entry-menu
        quick-entry-input
        quick-entry-add
        exercise-title-visible
        quit
        complete
      )
      ;;
    restart)
      required_steps=(
        arguments
        process
        exit-observer
        permissions
        target
        main-window
        restart-title-visible
        quit
        complete
      )
      ;;
    diagnostic-export)
      required_steps=(
        arguments
        process
        exit-observer
        permissions
        target
        diagnostic-locks-before-export
        diagnostic-window
        diagnostic-menu
        diagnostic-preview
        diagnostic-export-ui
        diagnostic-locks-after-export
        diagnostic-package
        complete
      )
      ;;
    *)
      echo "unknown DMG install harness mode: $mode" >&2
      return 1
      ;;
  esac
  for required_step in "${required_steps[@]}"; do
    IFS=$'\t' read -r step_count step_line < <(
      awk -F $'\t' -v expected="$required_step" '
        $2 == "PASS" && $3 == expected { count += 1; line = NR }
        END { printf "%d\t%d\n", count, line }
      ' "$ledger_path"
    )
    if [[ "$step_count" -ne 1 || "$step_line" -le "$previous_step_line" ]]; then
      echo "DMG install harness step $required_step was absent, duplicated, or out of order in $mode mode" >&2
      cat "$ledger_path" >&2
      return 1
    fi
    previous_step_line="$step_line"
  done

  if ! awk -F $'\t' \
    -v process_detail="mode=$mode helper_pid=$helper_pid launch_token=$token" \
    -v observer_detail="helper_pid=$helper_pid launch_token=$token observer=EVFILT_PROC+NOTE_EXITSTATUS" '
      $2 == "PASS" && $3 == "process" && $4 == process_detail { process_count += 1 }
      $2 == "PASS" && $3 == "exit-observer" && $4 == observer_detail {
        observer_count += 1
      }
      END { exit !(process_count == 1 && observer_count == 1) }
    ' "$ledger_path"; then
    echo "DMG install harness process or exit-observer identity detail was invalid" >&2
    return 1
  fi

  if [[ "$mode" == "diagnostic-export" ]] &&
    ! awk -F $'\t' '
      $2 == "PASS" &&
        $3 == "diagnostic-locks-before-export" &&
        $4 == "sqlite_writer=busy repository_flock=would-block held=true" {
        before += 1
      }
      $2 == "PASS" &&
        $3 == "diagnostic-locks-after-export" &&
        $4 == "sqlite_writer=busy repository_flock=would-block held=true" {
        after += 1
      }
      $2 == "PASS" && $3 == "diagnostic-export-ui" &&
        $4 == "menu=physical preview=physical save_panel=physical path=selected toast=visible source=cghidEventTap" {
        ui += 1
      }
      $2 == "PASS" && $3 == "diagnostic-package" &&
        $4 ~ /^schema=1 bytes=[1-9][0-9]* sha256=[0-9a-f]{64} records=[0-9]+ active=[0-9]+ capsules=[0-9]+ metrics=[0-9]+ sentinels=absent owner_only=true$/ {
        package += 1
      }
      END { exit !(before == 1 && after == 1 && ui == 1 && package == 1) }
    ' "$ledger_path"; then
    echo "diagnostic export helper omitted exact lock, UI, or package evidence" >&2
    return 1
  fi

  last_line="$(tail -n 1 "$ledger_path")"
  IFS=$'\t' read -r timestamp status step detail <<<"$last_line"
  if [[ -z "$timestamp" || "$status" != "PASS" || "$step" != "complete" ||
    "$detail" != "mode=$mode" ]]; then
    echo "DMG install harness did not finish $mode mode: $last_line" >&2
    return 1
  fi
}

run_helper() {
  local mode="$1"
  local pid="$2"
  local ledger_path="$3"
  local helper_log_path="$4"
  local helper_log_base="${helper_log_path%.log}"
  local helper_stderr_path="${helper_log_base}-stderr.log"
  local helper_launch_path="${helper_log_base}-launch.log"
  local observer_log_path="${helper_log_base}-exit-observer.log"
  local observer_gate_path="${helper_log_base}-exit-observer-gate.txt"
  local exit_result_path="${helper_log_base}-exit-status.txt"
  local token
  local helper_pid
  local open_status
  local remaining_pids
  local helper_args=()

  token="$(uuidgen)"
  if [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "uuidgen returned an invalid helper launch token" >&2
    return 1
  fi
  helper_args=(
    --mode "$mode"
    --ledger "$ledger_path"
    --launch-token "$token"
    --start-gate "$observer_gate_path"
  )
  case "$mode" in
    preflight) ;;
    exercise | restart)
      helper_args+=(
        --pid "$pid"
        --app-path "$installed_app"
        --task-title "$task_title"
      )
      ;;
    diagnostic-export)
      if [[ -z "$CAPTURED_WINDOW_ID" || -z "$CAPTURED_WINDOW_TITLE" ||
        -z "$database_path" || -z "$diagnostic_repository_lock" ||
        -z "$diagnostic_export_path" ||
        -z "$diagnostic_export_sentinels_path" ]]; then
        echo "diagnostic export helper inputs are incomplete" >&2
        return 1
      fi
      helper_args+=(
        --pid "$pid"
        --app-path "$installed_app"
        --window-number "$CAPTURED_WINDOW_ID"
        --window-title "$CAPTURED_WINDOW_TITLE"
        --target-profile "dmg-validation"
        --database "$database_path"
        --repository-lock "$diagnostic_repository_lock"
        --export-path "$diagnostic_export_path"
        --sentinels "$diagnostic_export_sentinels_path"
      )
      ;;
    *)
      echo "unsupported DMG install harness mode: $mode" >&2
      return 1
      ;;
  esac

  rm -f \
    "$ledger_path" \
    "$helper_log_path" \
    "$helper_stderr_path" \
    "$helper_launch_path" \
    "$observer_log_path" \
    "$observer_gate_path" \
    "$exit_result_path"
  : >"$helper_log_path"
  : >"$helper_stderr_path"
  : >"$helper_launch_path"
  : >"$observer_log_path"

  last_helper_stderr_log="$helper_stderr_path"
  last_helper_launch_log="$helper_launch_path"
  last_helper_observer_log="$observer_log_path"
  last_helper_exit_result="$exit_result_path"
  active_helper_pid=""
  active_helper_mode="$mode"
  active_helper_token="$token"

  set +e
  /usr/bin/open \
    -n \
    -g \
    --stdout "$helper_log_path" \
    --stderr "$helper_stderr_path" \
    "$helper_app" \
    --args "${helper_args[@]}" \
    >"$helper_launch_path" 2>&1
  open_status=$?
  set -e
  if [[ "$open_status" -ne 0 ]]; then
    echo "LaunchServices rejected the $mode helper launch: status=$open_status" >&2
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  if [[ -s "$helper_launch_path" ]]; then
    echo "LaunchServices emitted unexpected output for the $mode helper launch" >&2
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi

  if ! wait_for_helper_process_record "$mode" "$token" "$ledger_path"; then
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  helper_pid="$HELPER_PROCESS_PID"
  start_helper_exit_observer \
    "$mode" \
    "$helper_pid" \
    "$token" \
    "$observer_gate_path" \
    "$exit_result_path" \
    "$observer_log_path"
  if ! wait_for_helper_observer_gate \
    "$mode" \
    "$helper_pid" \
    "$token" \
    "$observer_gate_path" \
    "$exit_result_path"; then
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  if ! wait_for_helper_exit_result \
    "$helper_pid" \
    "$mode" \
    "$token" \
    "$exit_result_path"; then
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  if ! assert_helper_completed \
    "$mode" \
    "$ledger_path" \
    "$helper_log_path" \
    "$helper_stderr_path" \
    "$helper_launch_path" \
    "$observer_log_path" \
    "$exit_result_path" \
    "$helper_pid" \
    "$token"; then
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi

  if ! remaining_pids="$(matching_owned_helper_pids "$mode" "$token")"; then
    echo "failed to prove helper process exit after $mode" >&2
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  if [[ -n "$remaining_pids" ]]; then
    echo "helper process remained after its observed exit: $remaining_pids" >&2
    dump_helper_evidence \
      "$ledger_path" \
      "$helper_log_path" \
      "$helper_stderr_path" \
      "$helper_launch_path" \
      "$observer_log_path" \
      "$exit_result_path"
    return 1
  fi
  active_helper_pid=""
  active_helper_mode=""
  active_helper_token=""
}

current_day_metadata() {
  swift -e '
import Foundation
import Darwin

var calendar = Calendar(identifier: .gregorian)
calendar.locale = Locale(identifier: "en_US_POSIX")
calendar.timeZone = .autoupdatingCurrent
let now = Date()
let components = calendar.dateComponents([.year, .month, .day], from: now)
guard let year = components.year,
      let month = components.month,
      let day = components.day
else {
    fputs("unable to resolve the validation natural day\n", stderr)
    exit(1)
}
let formatter = DateFormatter()
formatter.calendar = Calendar(identifier: .gregorian)
formatter.locale = Locale(identifier: "zh_Hans_SG")
formatter.timeZone = .autoupdatingCurrent
formatter.dateFormat = "M月d日"
let localDay = String(format: "%04d-%02d-%02d", year, month, day)
let title = "晷迹 · Day Todo — \(formatter.string(from: now))"
print("\(localDay)|\(title)")
'
}

prepare_main_window_identity_handshake() {
  local token

  active_window_launch_token=""
  if [[ -z "$window_runtime_evidence_root" ]]; then
    echo "dmg-validation window evidence root is unavailable" >&2
    return 1
  fi
  token="$(uuidgen)"
  if [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "uuidgen returned an invalid main-window launch token" >&2
    return 1
  fi
  dmg_window_identity_prepare_request \
    "$window_runtime_evidence_root" \
    "$token" \
    live
  active_window_launch_token="$token"
}

launch_installed_app() {
  local launch_log_path="$1"

  prepare_main_window_identity_handshake
  /usr/bin/open -n "$installed_app" >"$launch_log_path" 2>&1
}

verify_exact_main_window() {
  local pid="$1"
  local window_number="$2"
  local window_title="$3"

  NOONMARK_DMG_APP_PID="$pid" \
    NOONMARK_DMG_WINDOW_NUMBER="$window_number" \
    NOONMARK_DMG_WINDOW_TITLE="$window_title" \
    swift -e '
import CoreGraphics
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let expectedPID = Int(environment["NOONMARK_DMG_APP_PID"] ?? ""),
      expectedPID > 0,
      let rawWindowNumber = UInt32(
          environment["NOONMARK_DMG_WINDOW_NUMBER"] ?? ""
      ),
      rawWindowNumber > 0,
      let expectedTitle = environment["NOONMARK_DMG_WINDOW_TITLE"],
      expectedTitle.isEmpty == false,
      let windows = CGWindowListCopyWindowInfo(
          [.optionIncludingWindow],
          CGWindowID(rawWindowNumber)
      ) as? [[String: Any]],
      windows.count == 1,
      let window = windows.first,
      let windowNumber = window[kCGWindowNumber as String] as? NSNumber,
      windowNumber.uint32Value == rawWindowNumber,
      let ownerPID = window[kCGWindowOwnerPID as String] as? NSNumber,
      ownerPID.intValue == expectedPID,
      let title = window[kCGWindowName as String] as? String,
      title == expectedTitle,
      let layer = window[kCGWindowLayer as String] as? NSNumber,
      layer.intValue == 0,
      let isOnscreen = window[kCGWindowIsOnscreen as String] as? NSNumber,
      isOnscreen.boolValue,
      let bounds = window[kCGWindowBounds as String] as? [String: Any],
      let width = bounds["Width"] as? NSNumber,
      width.doubleValue >= 960,
      let height = bounds["Height"] as? NSNumber,
      height.doubleValue >= 720
else {
    exit(1)
}
'
}

wait_for_main_window_metadata() {
  local pid="$1"
  local launch_token="$2"
  local natural_day=""
  local expected_title=""
  local response=""
  local window_number=""
  local response_title=""

  if [[ ! "$launch_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "main-window launch token was invalid" >&2
    return 1
  fi
  IFS='|' read -r natural_day expected_title < <(current_day_metadata)
  if [[ -z "$natural_day" || -z "$expected_title" ]]; then
    echo "dmg-validation natural-day window identity was unavailable" >&2
    return 1
  fi

  for _ in {1..80}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      echo "dmg-validation App exited before its scoped window response: profile=dmg-validation pid=$pid token=$launch_token" >&2
      return 1
    fi
    if response="$(
      dmg_window_identity_read_response \
        "$window_runtime_evidence_root" \
        "$launch_token" \
        "$pid" \
        "$validation_bundle_identifier" \
        "$expected_title" \
        live \
        2>/dev/null
    )"; then
      IFS='|' read -r window_number response_title <<<"$response"
      if [[ "$response_title" == "$expected_title" ]] &&
        verify_exact_main_window \
          "$pid" \
          "$window_number" \
          "$response_title" \
          2>/dev/null; then
        printf '%s|%s|%s\n' "$window_number" "$natural_day" "$response_title"
        return 0
      fi
    fi
    sleep 0.1
  done
  echo "dmg-validation scoped main window was not verified: profile=dmg-validation pid=$pid token=$launch_token response=RuntimeEvidence/main-window-identity.json" >&2
  return 1
}

run_permission_preflight() {
  rm -f "$permission_ledger" "$permission_log" "$permission_console_log"
  start_runtime_capture "$permission_console_log"
  run_helper \
    "preflight" \
    "" \
    "$permission_ledger" \
    "$permission_log"
  runtime_evidence_stop_console_capture
  runtime_evidence_assert_clean_logs \
    "DMG install harness permission preflight" \
    "$permission_log" \
    "$last_helper_stderr_log" \
    "$last_helper_launch_log" \
    "$last_helper_observer_log" \
    "$permission_console_log"
  if [[ -e "$database_path" ]]; then
    echo "permission preflight unexpectedly created validation persistence: $database_path" >&2
    return 1
  fi
}

CAPTURED_WINDOW_ID=""
CAPTURED_WINDOW_DAY=""
CAPTURED_WINDOW_TITLE=""
CAPTURED_WINDOW_WIDTH=""
CAPTURED_WINDOW_HEIGHT=""

capture_window_evidence() {
  local pid="$1"
  local destination_screenshot="$2"
  local destination_metadata="$3"
  local phase="$4"
  local launch_token="$5"
  local metadata window_id natural_day expected_title width height

  metadata="$(wait_for_main_window_metadata "$pid" "$launch_token")"
  IFS='|' read -r window_id natural_day expected_title <<<"$metadata"
  if [[ -z "$window_id" || -z "$natural_day" || -z "$expected_title" ]]; then
    echo "$phase window metadata was incomplete: $metadata" >&2
    return 1
  fi

  screencapture -x -o -l"$window_id" "$destination_screenshot"
  if [[ ! -s "$destination_screenshot" ]]; then
    echo "$phase screenshot was not created: $destination_screenshot" >&2
    return 1
  fi
  width="$(sips -g pixelWidth "$destination_screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$destination_screenshot" | awk '/pixelHeight/ {print $2}')"
  if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 ||
    "${width:-0}" -gt 4800 || "${height:-0}" -gt 3200 ]]; then
    echo "invalid $phase screenshot size: ${width:-unknown}x${height:-unknown}" >&2
    return 1
  fi

  {
    printf 'phase=%s\n' "$phase"
    printf 'pid=%s\n' "$pid"
    printf 'bundle_identifier=%s\n' "$validation_bundle_identifier"
    printf 'bundle_path=%s\n' "$installed_app"
    printf 'executable_path=%s\n' "$installed_executable"
    printf 'window_id=%s\n' "$window_id"
    printf 'natural_day=%s\n' "$natural_day"
    printf 'title=%s\n' "$expected_title"
    printf 'screenshot=%s\n' "$destination_screenshot"
    printf 'pixel_size=%sx%s\n' "$width" "$height"
  } >"$destination_metadata"

  CAPTURED_WINDOW_ID="$window_id"
  CAPTURED_WINDOW_DAY="$natural_day"
  CAPTURED_WINDOW_TITLE="$expected_title"
  CAPTURED_WINDOW_WIDTH="$width"
  CAPTURED_WINDOW_HEIGHT="$height"
}

VALIDATION_PHASE_DAY=""

run_validation_helper_phase() {
  local mode="$1"
  local ledger_path
  local launch_log_path
  local helper_log_path
  local console_log_path
  local phase_screenshot_path
  local phase_window_metadata_path
  local phase_label
  local pid

  case "$mode" in
    exercise)
      ledger_path="$exercise_ledger"
      launch_log_path="$exercise_launch_log"
      helper_log_path="$exercise_helper_log"
      console_log_path="$exercise_console_log"
      phase_screenshot_path="$exercise_screenshot_path"
      phase_window_metadata_path="$exercise_window_metadata_path"
      phase_label="dmg-validation exercise"
      ;;
    restart)
      ledger_path="$restart_ledger"
      launch_log_path="$restart_launch_log"
      helper_log_path="$restart_helper_log"
      console_log_path="$restart_console_log"
      phase_screenshot_path="$restart_screenshot_path"
      phase_window_metadata_path="$restart_window_metadata_path"
      phase_label="dmg-validation restart"
      ;;
    *)
      echo "unsupported validation helper phase: $mode" >&2
      return 1
      ;;
  esac

  rm -f \
    "$ledger_path" \
    "$launch_log_path" \
    "$helper_log_path" \
    "$console_log_path"
  start_runtime_capture "$console_log_path"
  : >"$launch_log_path"
  launch_installed_app "$launch_log_path"
  pid="$(wait_for_installed_pid)"
  verify_installed_process_identity "$pid"
  active_app_pid="$pid"
  capture_window_evidence \
    "$pid" \
    "$phase_screenshot_path" \
    "$phase_window_metadata_path" \
    "$phase_label" \
    "$active_window_launch_token"
  VALIDATION_PHASE_DAY="$CAPTURED_WINDOW_DAY"

  run_helper \
    "$mode" \
    "$pid" \
    "$ledger_path" \
    "$helper_log_path"
  wait_for_pid_exit "$pid"
  active_app_pid=""
  runtime_evidence_stop_console_capture
  runtime_evidence_assert_clean_logs \
    "installed $phase_label" \
    "$launch_log_path" \
    "$helper_log_path" \
    "$last_helper_stderr_log" \
    "$last_helper_launch_log" \
    "$last_helper_observer_log" \
    "$console_log_path"
}

prepare_diagnostic_export_contract() {
  local validation_data_root="${database_path%/Noonmark.sqlite}"

  if [[ "$validation_data_root" == "$database_path" ||
    "$validation_data_root" != \
      */Library/Application\ Support/noonmark-dmg-validation ||
    ! -d "$validation_data_root" || -L "$validation_data_root" ]]; then
    echo "refusing to prepare diagnostics outside the real dmg-validation data root: $validation_data_root" >&2
    return 1
  fi

  diagnostic_repository_root="${validation_data_root}/sync-repository"
  diagnostic_repository_lock="${diagnostic_repository_root}/.repository.lock"
  if [[ -e "$diagnostic_repository_root" ]]; then
    if [[ ! -d "$diagnostic_repository_root" ||
      -L "$diagnostic_repository_root" ]]; then
      echo "dmg-validation sync repository is not a real directory" >&2
      return 1
    fi
  else
    mkdir -m 700 "$diagnostic_repository_root"
  fi
  chmod 700 "$diagnostic_repository_root"
  if [[ -e "$diagnostic_repository_lock" &&
    (! -f "$diagnostic_repository_lock" ||
      -L "$diagnostic_repository_lock") ]]; then
    echo "dmg-validation repository lock is not a regular file" >&2
    return 1
  fi

  case "$diagnostic_export_path" in
    "$work_dir"/*.noonmarkdiagnostics) ;;
    *)
      echo "diagnostic export destination escaped its fixed artifact root" >&2
      return 1
      ;;
  esac
  rm -f \
    "$diagnostic_export_path" \
    "$diagnostic_export_sentinels_path" \
    "$diagnostic_export_package_report"
  (
    umask 077
    printf '%s\n' \
      "$task_title" \
      "$database_path" \
      "$diagnostic_repository_lock" \
      "private-user-9f3a7c42@example.invalid" \
      "https://sync-secret.example.invalid/noonmark/private-tenant-82f6" \
      "sk-noonmark-private-provider-17e4caa987fa" \
      >"$diagnostic_export_sentinels_path"
  )
  if [[ ! -f "$diagnostic_export_sentinels_path" ||
    -L "$diagnostic_export_sentinels_path" ]] ||
    [[ "$(stat -f '%Lp' "$diagnostic_export_sentinels_path")" != "600" ]]; then
    echo "diagnostic privacy sentinel fixture is not an owner-only regular file" >&2
    return 1
  fi
}

validate_diagnostic_export_package() {
  local bytes mode_decimal mode_text sha256 owner_uid link_count
  local record_count active_count capsule_count metric_count
  local expected_version expected_build expected_commit expected_build_date
  local expected_runtime expected_minimum_os expected_build_architecture
  local expected_binary_uuid expected_binary_sha256 expected_binary_scope
  local expected_ledger_detail relative_export_path sentinel
  local runtime_architecture operating_system_version darwin_version
  local os_major os_minor os_patch os_extra

  if [[ ! -f "$diagnostic_export_path" || -L "$diagnostic_export_path" ]]; then
    echo "diagnostic export is missing or is not a regular file" >&2
    return 1
  fi
  bytes="$(stat -f '%z' "$diagnostic_export_path")"
  mode_text="$(stat -f '%Lp' "$diagnostic_export_path")"
  owner_uid="$(stat -f '%u' "$diagnostic_export_path")"
  link_count="$(stat -f '%l' "$diagnostic_export_path")"
  if [[ ! "$bytes" =~ ^[1-9][0-9]*$ || "$bytes" -gt 8388608 ||
    ! "$mode_text" =~ ^[0-7]{3,4}$ || "$owner_uid" != "$(id -u)" ||
    "$link_count" != "1" ]]; then
    echo "diagnostic export has an invalid size, owner, link count, or permission mode" >&2
    return 1
  fi
  mode_decimal=$((8#$mode_text))
  if (( (mode_decimal & 0077) != 0 || (mode_decimal & 0600) != 0600 )); then
    echo "diagnostic export is not owner-readable/writable and group/other closed" >&2
    return 1
  fi
  sha256="$(shasum -a 256 "$diagnostic_export_path" | awk '{print $1}')"
  if [[ ! "$sha256" =~ ^[0-9a-f]{64}$ ]]; then
    echo "diagnostic export SHA-256 is invalid" >&2
    return 1
  fi

  expected_version="$(evidence_read "$package_manifest_path" release_identity_version)"
  expected_build="$(evidence_read "$package_manifest_path" release_identity_build)"
  expected_commit="$(evidence_read "$package_manifest_path" release_identity_git_commit)"
  expected_build_date="$(evidence_read "$package_manifest_path" release_identity_build_date)"
  expected_runtime="$(evidence_read "$package_manifest_path" release_identity_runtime)"
  expected_minimum_os="$(evidence_read "$package_manifest_path" release_identity_minimum_os_version)"
  expected_build_architecture="$(evidence_read "$package_manifest_path" release_identity_architecture)"
  expected_binary_uuid="$(evidence_read "$package_manifest_path" release_identity_binary_uuid_set)"
  expected_binary_sha256="$(evidence_read "$package_manifest_path" release_identity_binary_sha256)"
  expected_binary_scope="$(evidence_read "$package_manifest_path" release_identity_binary_sha256_scope)"
  runtime_architecture="$(uname -m)"
  operating_system_version="$(sw_vers -productVersion)"
  darwin_version="$(uname -r)"
  IFS=. read -r os_major os_minor os_patch os_extra \
    <<<"$operating_system_version"
  os_patch="${os_patch:-0}"
  if [[ ! "$runtime_architecture" =~ ^(arm64|x86_64)$ ||
    ! "$operating_system_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ||
    ! "$darwin_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ||
    ! "$os_major" =~ ^[0-9]+$ || ! "$os_minor" =~ ^[0-9]+$ ||
    ! "$os_patch" =~ ^[0-9]+$ || -n "${os_extra:-}" ]]; then
    echo "host runtime identity could not be normalized" >&2
    return 1
  fi

  if ! jq -e \
    --arg version "$expected_version" \
    --arg build "$expected_build" \
    --arg commit "$expected_commit" \
    --arg build_date "$expected_build_date" \
    --arg runtime "$expected_runtime" \
    --arg minimum_os "$expected_minimum_os" \
    --arg build_architecture "$expected_build_architecture" \
    --arg binary_uuid "$expected_binary_uuid" \
    --arg binary_sha256 "$expected_binary_sha256" \
    --arg binary_scope "$expected_binary_scope" \
    --arg runtime_architecture "$runtime_architecture" \
    --arg darwin_version "$darwin_version" \
    --argjson os_major "$os_major" \
    --argjson os_minor "$os_minor" \
    --argjson os_patch "$os_patch" '
      type == "object" and
      ((keys | sort) == [
        "activeOperations",
        "manifest",
        "metricAttachments",
        "operationCapsules",
        "records"
      ]) and
      (.manifest.schemaVersion == 1) and
      (.manifest.redactionVersion == 1) and
      (.records | type == "array") and
      (.activeOperations | type == "array") and
      (.operationCapsules | type == "array") and
      (.metricAttachments | type == "array") and
      (.manifest.recordCount == (.records | length)) and
      (.manifest.activeOperationCount == (.activeOperations | length)) and
      (.manifest.operationCapsuleCount == (.operationCapsules | length)) and
      (.manifest.metricPayloadCount == (.metricAttachments | length)) and
      (.manifest.appIdentity.version == $version) and
      (.manifest.appIdentity.build == $build) and
      (.manifest.appIdentity.commitSHA == $commit) and
      (.manifest.appIdentity.buildDate == $build_date) and
      (.manifest.appIdentity.runtime == $runtime) and
      (.manifest.appIdentity.minimumOSVersion == $minimum_os) and
      (.manifest.appIdentity.buildArchitecture == $build_architecture) and
      (.manifest.appIdentity.binaryUUID == $binary_uuid) and
      (.manifest.appIdentity.binarySHA256 == $binary_sha256) and
      (.manifest.appIdentity.binarySHA256Scope == $binary_scope) and
      (.manifest.appIdentity.architecture == $runtime_architecture) and
      (.manifest.appIdentity.operatingSystemMajorVersion == $os_major) and
      (.manifest.appIdentity.operatingSystemMinorVersion == $os_minor) and
      (.manifest.appIdentity.operatingSystemPatchVersion == $os_patch) and
      (.manifest.appIdentity.darwinVersion == $darwin_version)
    ' "$diagnostic_export_path" >/dev/null; then
    echo "diagnostic export schema, counts, or release identity disagreed" >&2
    return 1
  fi

  while IFS= read -r sentinel || [[ -n "$sentinel" ]]; do
    if [[ -z "$sentinel" ]]; then
      echo "diagnostic privacy sentinel fixture contains an empty value" >&2
      return 1
    fi
    if LC_ALL=C grep -F -- "$sentinel" "$diagnostic_export_path" >/dev/null; then
      echo "diagnostic export leaked a privacy sentinel" >&2
      return 1
    fi
  done <"$diagnostic_export_sentinels_path"

  record_count="$(jq -r '.records | length' "$diagnostic_export_path")"
  active_count="$(jq -r '.activeOperations | length' "$diagnostic_export_path")"
  capsule_count="$(jq -r '.operationCapsules | length' "$diagnostic_export_path")"
  metric_count="$(jq -r '.metricAttachments | length' "$diagnostic_export_path")"
  expected_ledger_detail="schema=1 bytes=$bytes sha256=$sha256 records=$record_count active=$active_count capsules=$capsule_count metrics=$metric_count sentinels=absent owner_only=true"
  if ! awk -F $'\t' -v expected="$expected_ledger_detail" '
    $2 == "PASS" && $3 == "diagnostic-package" && $4 == expected {
      count += 1
    }
    END { exit !(count == 1) }
  ' "$diagnostic_export_ledger"; then
    echo "diagnostic export package disagreed with its helper ledger" >&2
    return 1
  fi

  relative_export_path="${diagnostic_export_path#${repo_root}/}"
  if [[ "$relative_export_path" == "$diagnostic_export_path" ]]; then
    echo "diagnostic export path is not repository-relative" >&2
    return 1
  fi
  {
    printf 'schema_version=1\n'
    printf 'path=%s\n' "$relative_export_path"
    printf 'bytes=%s\n' "$bytes"
    printf 'sha256=%s\n' "$sha256"
    printf 'mode=%s\n' "$mode_text"
    printf 'record_count=%s\n' "$record_count"
    printf 'active_operation_count=%s\n' "$active_count"
    printf 'operation_capsule_count=%s\n' "$capsule_count"
    printf 'metric_payload_count=%s\n' "$metric_count"
    printf 'identity_match=true\n'
    printf 'runtime_identity_match=true\n'
    printf 'runtime_architecture=%s\n' "$runtime_architecture"
    printf 'operating_system_version=%s\n' "$operating_system_version"
    printf 'darwin_version=%s\n' "$darwin_version"
    printf 'sentinels_absent=true\n'
    printf 'lock_overlap=sqlite-writer+sync-repository\n'
  } >"$diagnostic_export_package_report"

  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_ui_completed" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_lock_overlap" "sqlite-writer+sync-repository"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_schema_version" "1"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_identity_match" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_runtime_identity_match" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_size_within_limit" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_sentinels_absent" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_owner_only" "true"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_path" "$relative_export_path"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_bytes" "$bytes"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_sha256" "$sha256"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_runtime_architecture" "$runtime_architecture"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_operating_system_version" "$operating_system_version"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_darwin_version" "$darwin_version"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_ledger_sha256" \
    "$(shasum -a 256 "$diagnostic_export_ledger" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_app_launch_sha256" \
    "$(shasum -a 256 "$diagnostic_export_launch_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_stdout_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_stderr_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_stderr_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_launch_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_launch_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_observer_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_observer_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_observer_gate_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_observer_gate" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_helper_exit_status_sha256" \
    "$(shasum -a 256 "$diagnostic_export_helper_exit_status" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_window_metadata_sha256" \
    "$(shasum -a 256 "$diagnostic_export_window_metadata_path" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_console_sha256" \
    "$(shasum -a 256 "$diagnostic_export_console_log" | awk '{print $1}')"
  evidence_append "$runtime_manifest_path" \
    "diagnostic_export_package_report_sha256" \
    "$(shasum -a 256 "$diagnostic_export_package_report" | awk '{print $1}')"
}

run_validation_diagnostic_export_phase() {
  local pid

  prepare_diagnostic_export_contract
  rm -f \
    "$diagnostic_export_ledger" \
    "$diagnostic_export_launch_log" \
    "$diagnostic_export_helper_log" \
    "$diagnostic_export_console_log" \
    "$diagnostic_export_screenshot_path" \
    "$diagnostic_export_window_metadata_path"
  start_runtime_capture "$diagnostic_export_console_log"
  : >"$diagnostic_export_launch_log"
  launch_installed_app "$diagnostic_export_launch_log"
  pid="$(wait_for_installed_pid)"
  verify_installed_process_identity "$pid"
  active_app_pid="$pid"
  capture_window_evidence \
    "$pid" \
    "$diagnostic_export_screenshot_path" \
    "$diagnostic_export_window_metadata_path" \
    "dmg-validation diagnostic export" \
    "$active_window_launch_token"
  run_helper \
    "diagnostic-export" \
    "$pid" \
    "$diagnostic_export_ledger" \
    "$diagnostic_export_helper_log"
  if [[ "$last_helper_stderr_log" != \
      "$diagnostic_export_helper_stderr_log" ||
    "$last_helper_launch_log" != \
      "$diagnostic_export_helper_launch_log" ||
    "$last_helper_observer_log" != \
      "$diagnostic_export_helper_observer_log" ||
    "$last_helper_exit_result" != \
      "$diagnostic_export_helper_exit_status" ||
    ! -f "$diagnostic_export_helper_observer_gate" ||
    -L "$diagnostic_export_helper_observer_gate" ]]; then
    echo "diagnostic helper evidence paths did not match their fixed contract" >&2
    return 1
  fi
  request_verified_app_termination "$pid"
  active_app_pid=""
  runtime_evidence_stop_console_capture
  runtime_evidence_assert_clean_logs \
    "installed dmg-validation diagnostic export" \
    "$diagnostic_export_launch_log" \
    "$diagnostic_export_helper_log" \
    "$last_helper_stderr_log" \
    "$last_helper_launch_log" \
    "$last_helper_observer_log" \
    "$diagnostic_export_console_log"
  validate_diagnostic_export_package
}

assert_database_integrity() {
  local label="$1"
  local integrity

  if [[ ! -f "$database_path" ]]; then
    echo "$label did not create persistence database: $database_path" >&2
    return 1
  fi
  integrity="$(sqlite3 "$database_path" 'PRAGMA integrity_check;')"
  if [[ "$integrity" != "ok" ]]; then
    echo "$label persistence integrity_check failed: $integrity" >&2
    return 1
  fi
}

assert_blank_persistence() {
  local counts
  local days chains definitions traces subtasks preferences

  assert_database_integrity "installed negative canary"
  counts="$(sqlite3 -separator $'\t' "$database_path" '
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  ')"
  IFS=$'\t' read -r \
    days chains definitions traces subtasks preferences <<<"$counts"
  if [[ "$days" -ne 0 || "$chains" -ne 0 || "$definitions" -ne 0 ||
    "$traces" -ne 0 || "$subtasks" -ne 0 || "$preferences" -ne 1 ]]; then
    echo "invalid installed app empty persistence counts: days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences" >&2
    return 1
  fi
  {
    printf 'integrity_check=ok\n'
    printf 'days=%s\n' "$days"
    printf 'task_chains=%s\n' "$chains"
    printf 'task_definitions=%s\n' "$definitions"
    printf 'day_traces=%s\n' "$traces"
    printf 'subtasks=%s\n' "$subtasks"
    printf 'app_preferences=%s\n' "$preferences"
  } >"${work_dir}/negative-canary-persistence.txt"
}

TASK_IDENTITY_LINE=""

capture_task_snapshot() {
  local expected_day="$1"
  local output_path="$2"
  local counts identity_line row_json
  local title_count matching_count chains definitions traces days preferences
  local trace_id chain_id definition_id actual_day trace_status chain_state
  local definition_sequence definition_title

  if [[ ! "$expected_day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "refusing to query an invalid natural day: $expected_day" >&2
    return 1
  fi
  assert_database_integrity "DMG validation task"

  counts="$(sqlite3 -separator $'\t' "$database_path" "
    SELECT
      (SELECT count(*)
       FROM task_definitions
       WHERE title = '$task_title'),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_chains AS chain ON chain.id = trace.chain_id
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       WHERE definition.title = '$task_title'
         AND trace.date = '$expected_day'
         AND trace.status = 'pending'
         AND chain.state = 'active'
         AND definition.superseded_at IS NULL
         AND definition.superseded_by_definition_id IS NULL),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM app_preferences);
  ")"
  IFS=$'\t' read -r \
    title_count matching_count chains definitions traces days preferences <<<"$counts"
  if [[ "$title_count" -ne 1 || "$matching_count" -ne 1 ||
    "$chains" -ne 1 || "$definitions" -ne 1 || "$traces" -ne 1 ||
    "$days" -ne 1 || "$preferences" -ne 1 ]]; then
    echo "invalid DMG validation task counts: title=$title_count matching=$matching_count chains=$chains definitions=$definitions traces=$traces days=$days preferences=$preferences" >&2
    return 1
  fi

  identity_line="$(sqlite3 -separator $'\t' "$database_path" "
    SELECT
      trace.id,
      chain.id,
      definition.id,
      trace.date,
      trace.status,
      chain.state,
      definition.sequence,
      definition.title
    FROM day_traces AS trace
    JOIN task_chains AS chain ON chain.id = trace.chain_id
    JOIN task_definitions AS definition ON definition.id = trace.definition_id
    WHERE definition.title = '$task_title'
      AND trace.date = '$expected_day'
      AND trace.status = 'pending'
      AND chain.state = 'active'
      AND definition.superseded_at IS NULL
      AND definition.superseded_by_definition_id IS NULL;
  ")"
  if [[ -z "$identity_line" || "$identity_line" == *$'\n'* ]]; then
    echo "DMG validation task did not resolve to one identity row" >&2
    return 1
  fi
  IFS=$'\t' read -r \
    trace_id chain_id definition_id actual_day trace_status chain_state \
    definition_sequence definition_title <<<"$identity_line"
  if [[ -z "$trace_id" || -z "$chain_id" || -z "$definition_id" ||
    "$actual_day" != "$expected_day" || "$trace_status" != "pending" ||
    "$chain_state" != "active" || ! "$definition_sequence" =~ ^[0-9]+$ ||
    "$definition_title" != "$task_title" ]]; then
    echo "DMG validation task identity was invalid: $identity_line" >&2
    return 1
  fi

  row_json="$(sqlite3 "$database_path" "
    SELECT json_object(
      'trace', json_object(
        'id', trace.id,
        'chain_id', trace.chain_id,
        'definition_id', trace.definition_id,
        'date', trace.date,
        'status', trace.status,
        'priority', trace.priority,
        'continuation_seq', trace.continuation_seq,
        'description_text', trace.description_text,
        'note_entries_json', trace.note_entries_json,
        'manual_progress_percent', trace.manual_progress_percent,
        'carried_from_trace_id', trace.carried_from_trace_id,
        'changed_to_trace_id', trace.changed_to_trace_id,
        'created_at', trace.created_at,
        'created_at_bits', trace.created_at_bits,
        'content_updated_at', trace.content_updated_at,
        'content_updated_at_bits', trace.content_updated_at_bits,
        'completed_at', trace.completed_at,
        'completed_at_bits', trace.completed_at_bits,
        'settled_at', trace.settled_at,
        'settled_at_bits', trace.settled_at_bits
      ),
      'chain', json_object(
        'id', chain.id,
        'state', chain.state,
        'note_entries_json', chain.note_entries_json,
        'created_at', chain.created_at,
        'created_at_bits', chain.created_at_bits,
        'updated_at', chain.updated_at,
        'updated_at_bits', chain.updated_at_bits
      ),
      'definition', json_object(
        'id', definition.id,
        'chain_id', definition.chain_id,
        'sequence', definition.sequence,
        'title', definition.title,
        'description_text', definition.description_text,
        'planned_subtasks_json', definition.planned_subtasks_json,
        'created_at', definition.created_at,
        'content_updated_at', definition.content_updated_at,
        'superseded_at', definition.superseded_at,
        'superseded_by_definition_id', definition.superseded_by_definition_id
      )
    )
    FROM day_traces AS trace
    JOIN task_chains AS chain ON chain.id = trace.chain_id
    JOIN task_definitions AS definition ON definition.id = trace.definition_id
    WHERE definition.title = '$task_title'
      AND trace.date = '$expected_day'
      AND trace.status = 'pending'
      AND chain.state = 'active'
      AND definition.superseded_at IS NULL
      AND definition.superseded_by_definition_id IS NULL;
  ")"
  if [[ -z "$row_json" || "$row_json" == *$'\n'* ]]; then
    echo "DMG validation task full-row snapshot was invalid" >&2
    return 1
  fi

  {
    printf 'integrity_check=ok\n'
    printf 'identity=%s\n' "$identity_line"
    printf 'joined_row=%s\n' "$row_json"
  } >"$output_path"
  TASK_IDENTITY_LINE="$identity_line"
}

database_path="$(swift -e '
import Foundation

guard let base = FileManager.default.urls(
    for: .applicationSupportDirectory,
    in: .userDomainMask
).first else {
    exit(1)
}
print(base
    .appendingPathComponent("noonmark-dmg-validation", isDirectory: true)
    .appendingPathComponent("Noonmark.sqlite")
    .path)
')"
