run_review_detail_ux_probe() {
  local review_dir="artifacts/e2e-review-detail-ux"
  local review_db="$review_dir/Noonmark.sqlite"
  local review_result="$review_dir/result.txt"
  local review_log="$review_dir/app.log"

  rm -rf "$review_dir"
  mkdir -p "$review_dir"
  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "review editor first-line layout" \
    "$review_result" \
    "$review_log" \
    --data-url "$PWD/$review_db" \
    --page day \
    --e2e-review-editor-layout-result-url "$PWD/$review_result"

  echo "E2E review editor first-line layout: $review_result"
}

run_copy_undo_persistence_probe() {
  local copy_undo_dir="artifacts/e2e-copy-undo-persistence"
  local copy_undo_db="${copy_undo_dir}/Noonmark.sqlite"
  local copy_undo_state="${copy_undo_dir}/state.json"
  local setup_result="${copy_undo_dir}/setup-result.txt"
  local verify_result="${copy_undo_dir}/verify-result.txt"
  local setup_log="${copy_undo_dir}/setup.log"
  local verify_log="${copy_undo_dir}/verify.log"
  local sql_probe

  rm -rf "$copy_undo_dir"
  mkdir -p "$copy_undo_dir"

  run_terminating_ui_probe \
    "snapshot undo evidence-matrix setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$copy_undo_db" \
    --page day \
    --e2e-fixed-instant 2026-07-16T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-copy-undo-persistence-setup \
    --e2e-copy-undo-persistence-state-url "$PWD/$copy_undo_state" \
    --e2e-copy-undo-persistence-result-url "$PWD/$setup_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "snapshot undo evidence-matrix restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$copy_undo_db" \
    --page pool \
    --e2e-fixed-instant 2026-07-16T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-copy-undo-persistence-verify \
    --e2e-copy-undo-persistence-state-url "$PWD/$copy_undo_state" \
    --e2e-copy-undo-persistence-result-url "$PWD/$verify_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$copy_undo_db" "
    WITH state(payload) AS (
      SELECT CAST(readfile('$PWD/$copy_undo_state') AS TEXT)
    ), source AS (
      SELECT json_extract(payload, '$.sourceChainID') AS chain_id
      FROM state
    ), new_today AS (
      SELECT
        json_extract(payload, '$.newTodayTask.title') AS title,
        json_extract(payload, '$.newTodayTask.dateISO8601') AS date,
        json_extract(payload, '$.newTodayTask.chainID') AS chain_id,
        json_extract(payload, '$.newTodayTask.definitionID') AS definition_id,
        json_extract(payload, '$.newTodayTask.traceID') AS trace_id,
        json_extract(payload, '$.newTodayTask.cancellationID') AS cancellation_id,
        CAST(json_extract(payload, '$.newTodayTask.creationBits') AS INTEGER)
          AS creation_bits,
        CAST(json_extract(payload, '$.newTodayTask.undoBits') AS INTEGER)
          AS undo_bits
      FROM state
    ), scheduled_pool AS (
      SELECT
        json_extract(payload, '$.scheduledPoolTask.title') AS title,
        json_extract(payload, '$.scheduledPoolTask.dateISO8601') AS date,
        json_extract(payload, '$.scheduledPoolTask.chainID') AS chain_id,
        json_extract(payload, '$.scheduledPoolTask.definitionID') AS definition_id,
        json_extract(payload, '$.scheduledPoolTask.traceID') AS trace_id,
        json_extract(payload, '$.scheduledPoolTask.cancellationID') AS cancellation_id,
        CAST(json_extract(payload, '$.scheduledPoolTask.poolCreationBits') AS INTEGER)
          AS pool_creation_bits,
        CAST(json_extract(payload, '$.scheduledPoolTask.scheduleBits') AS INTEGER)
          AS schedule_bits,
        CAST(json_extract(payload, '$.scheduledPoolTask.undoBits') AS INTEGER)
          AS undo_bits
      FROM state
    ), added_subtask AS (
      SELECT
        json_extract(payload, '$.addedSubtask.parentTitle') AS parent_title,
        json_extract(payload, '$.addedSubtask.subtaskTitle') AS subtask_title,
        json_extract(payload, '$.addedSubtask.dateISO8601') AS date,
        json_extract(payload, '$.addedSubtask.chainID') AS chain_id,
        json_extract(payload, '$.addedSubtask.definitionID') AS definition_id,
        json_extract(payload, '$.addedSubtask.traceID') AS trace_id,
        json_extract(payload, '$.addedSubtask.subtaskID') AS subtask_id,
        json_extract(payload, '$.addedSubtask.cancellationID') AS cancellation_id,
        CAST(json_extract(payload, '$.addedSubtask.parentCreationBits') AS INTEGER)
          AS parent_creation_bits,
        CAST(json_extract(payload, '$.addedSubtask.subtaskCreationBits') AS INTEGER)
          AS subtask_creation_bits,
        CAST(json_extract(payload, '$.addedSubtask.firstUndoBits') AS INTEGER)
          AS first_undo_bits,
        CAST(json_extract(payload, '$.addedSubtask.redoBits') AS INTEGER)
          AS redo_bits,
        CAST(json_extract(payload, '$.addedSubtask.finalUndoBits') AS INTEGER)
          AS final_undo_bits
      FROM state
    ), copied AS (
      SELECT
        json_extract(payload, '$.copiedTask.title') AS title,
        json_extract(payload, '$.copiedTask.chainID') AS chain_id,
        json_extract(payload, '$.copiedTask.definitionID') AS definition_id,
        CAST(json_extract(payload, '$.copiedTask.creationBits') AS INTEGER)
          AS creation_bits,
        CAST(json_extract(payload, '$.copiedTask.undoBits') AS INTEGER)
          AS undo_bits
      FROM state
    ), continuation AS (
      SELECT
        json_extract(payload, '$.continuation.title') AS title,
        json_extract(payload, '$.continuation.sourceDateISO8601') AS source_date,
        json_extract(payload, '$.continuation.targetDateISO8601') AS target_date,
        json_extract(payload, '$.continuation.chainID') AS chain_id,
        json_extract(payload, '$.continuation.definitionID') AS definition_id,
        json_extract(payload, '$.continuation.sourceTraceID') AS source_trace_id,
        json_extract(payload, '$.continuation.targetTraceID') AS target_trace_id,
        json_extract(payload, '$.continuation.cancellationID') AS cancellation_id,
        CAST(json_extract(payload, '$.continuation.sourceCreationBits') AS INTEGER)
          AS source_creation_bits,
        CAST(json_extract(payload, '$.continuation.continuationBits') AS INTEGER)
          AS continuation_bits,
        CAST(json_extract(payload, '$.continuation.undoBits') AS INTEGER)
          AS undo_bits
      FROM state
    ), copied_classification AS (
      SELECT DISTINCT
        record.record_id,
        record.source_kind,
        record.source_from_chain_id,
        record.source_reason
      FROM classification_change_records AS record
      JOIN classification_change_record_changes AS delta
        ON delta.record_id = record.record_id
      JOIN copied ON copied.chain_id = delta.chain_id
    )
    SELECT
      (SELECT count(*)
       FROM new_today
       JOIN task_chains AS chain ON chain.id = new_today.chain_id
       JOIN task_definitions AS definition
         ON definition.id = new_today.definition_id
        AND definition.chain_id = chain.id
       JOIN day_traces AS trace
         ON trace.id = new_today.trace_id
        AND trace.chain_id = chain.id
        AND trace.definition_id = definition.id
       JOIN days AS day ON day.date = new_today.date
       WHERE chain.state = 'abandoned'
         AND chain.created_at_bits = new_today.creation_bits
         AND chain.updated_at_bits = new_today.undo_bits
         AND definition.title = new_today.title
         AND definition.created_at_bits = new_today.creation_bits
         AND definition.content_updated_at_bits = new_today.creation_bits
         AND definition.superseded_at IS NULL
         AND trace.date = new_today.date
         AND trace.status = 'cancelledDraft'
         AND trace.draft_cancellation_id = new_today.cancellation_id
         AND trace.draft_cancelled_on = new_today.date
         AND trace.created_at_bits = new_today.creation_bits
         AND trace.content_updated_at_bits = new_today.undo_bits
         AND trace.settled_at_bits = new_today.undo_bits
         AND day.created_at_bits = new_today.creation_bits
         AND day.updated_at_bits = new_today.creation_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN new_today
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = new_today.creation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = new_today.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = new_today.definition_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = new_today.trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = new_today.date)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN new_today
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = new_today.undo_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = new_today.chain_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = new_today.trace_id)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN new_today
       WHERE (
         (journal.entity_type = 'taskChain'
           AND journal.entity_id = new_today.chain_id)
         OR (journal.entity_type = 'taskDefinition'
           AND journal.entity_id = new_today.definition_id)
         OR (journal.entity_type = 'dayTrace'
           AND journal.entity_id = new_today.trace_id)
         OR (journal.entity_type = 'day'
           AND journal.entity_id = new_today.date)
       )),
      (SELECT count(*)
       FROM scheduled_pool
       JOIN task_chains AS chain ON chain.id = scheduled_pool.chain_id
       JOIN task_definitions AS definition
         ON definition.id = scheduled_pool.definition_id
        AND definition.chain_id = chain.id
       JOIN day_traces AS trace
         ON trace.id = scheduled_pool.trace_id
        AND trace.chain_id = chain.id
        AND trace.definition_id = definition.id
       JOIN days AS day ON day.date = scheduled_pool.date
       WHERE chain.state = 'active'
         AND chain.created_at_bits = scheduled_pool.pool_creation_bits
         AND chain.updated_at_bits = scheduled_pool.pool_creation_bits
         AND definition.title = scheduled_pool.title
         AND definition.superseded_at IS NULL
         AND definition.created_at_bits = scheduled_pool.pool_creation_bits
         AND definition.content_updated_at_bits =
             scheduled_pool.pool_creation_bits
         AND trace.date = scheduled_pool.date
         AND trace.status = 'cancelledDraft'
         AND trace.draft_cancellation_id = scheduled_pool.cancellation_id
         AND trace.draft_cancelled_on = scheduled_pool.date
         AND trace.created_at_bits = scheduled_pool.schedule_bits
         AND trace.content_updated_at_bits = scheduled_pool.undo_bits
         AND trace.settled_at_bits = scheduled_pool.undo_bits
         AND day.created_at_bits = scheduled_pool.schedule_bits
         AND day.updated_at_bits = scheduled_pool.schedule_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN scheduled_pool
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = scheduled_pool.pool_creation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = scheduled_pool.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = scheduled_pool.definition_id)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN scheduled_pool
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = scheduled_pool.schedule_bits
         AND (
           (journal.entity_type = 'dayTrace'
             AND journal.entity_id = scheduled_pool.trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = scheduled_pool.date)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN scheduled_pool
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = scheduled_pool.undo_bits
         AND journal.entity_type = 'dayTrace'
         AND journal.entity_id = scheduled_pool.trace_id),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN scheduled_pool
       WHERE (
         (journal.entity_type = 'taskChain'
           AND journal.entity_id = scheduled_pool.chain_id)
         OR (journal.entity_type = 'taskDefinition'
           AND journal.entity_id = scheduled_pool.definition_id)
         OR (journal.entity_type = 'dayTrace'
           AND journal.entity_id = scheduled_pool.trace_id)
         OR (journal.entity_type = 'day'
           AND journal.entity_id = scheduled_pool.date)
       )),
      (SELECT count(*)
       FROM added_subtask
       JOIN task_chains AS chain ON chain.id = added_subtask.chain_id
       JOIN task_definitions AS definition
         ON definition.id = added_subtask.definition_id
        AND definition.chain_id = chain.id
       JOIN day_traces AS trace
         ON trace.id = added_subtask.trace_id
        AND trace.chain_id = chain.id
        AND trace.definition_id = definition.id
       JOIN subtasks AS subtask
         ON subtask.id = added_subtask.subtask_id
        AND subtask.trace_id = trace.id
       WHERE chain.state = 'active'
         AND chain.created_at_bits = added_subtask.parent_creation_bits
         AND chain.updated_at_bits = added_subtask.parent_creation_bits
         AND definition.title = added_subtask.parent_title
         AND definition.superseded_at IS NULL
         AND definition.created_at_bits = added_subtask.parent_creation_bits
         AND definition.content_updated_at_bits =
             added_subtask.parent_creation_bits
         AND trace.date = added_subtask.date
         AND trace.status = 'pending'
         AND trace.created_at_bits = added_subtask.parent_creation_bits
         AND trace.content_updated_at_bits =
             added_subtask.parent_creation_bits
         AND subtask.title = added_subtask.subtask_title
         AND subtask.status = 'cancelledDraft'
         AND subtask.draft_cancellation_id =
             added_subtask.cancellation_id
         AND subtask.created_at_bits = added_subtask.subtask_creation_bits
         AND subtask.updated_at_bits = added_subtask.final_undo_bits
         AND subtask.settled_at_bits = added_subtask.final_undo_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = added_subtask.parent_creation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = added_subtask.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = added_subtask.definition_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = added_subtask.trace_id)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.entity_type = 'subtask'
         AND journal.entity_id = added_subtask.subtask_id
         AND journal.changed_at_bits =
             added_subtask.subtask_creation_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.entity_type = 'subtask'
         AND journal.entity_id = added_subtask.subtask_id
         AND journal.changed_at_bits = added_subtask.first_undo_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.entity_type = 'subtask'
         AND journal.entity_id = added_subtask.subtask_id
         AND journal.changed_at_bits = added_subtask.redo_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.entity_type = 'subtask'
         AND journal.entity_id = added_subtask.subtask_id
         AND journal.changed_at_bits = added_subtask.final_undo_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN added_subtask
       WHERE (
         (journal.entity_type = 'taskChain'
           AND journal.entity_id = added_subtask.chain_id)
         OR (journal.entity_type = 'taskDefinition'
           AND journal.entity_id = added_subtask.definition_id)
         OR (journal.entity_type = 'dayTrace'
           AND journal.entity_id = added_subtask.trace_id)
         OR (journal.entity_type = 'subtask'
           AND journal.entity_id = added_subtask.subtask_id)
       )),
      (SELECT count(*)
       FROM continuation
       JOIN task_chains AS chain ON chain.id = continuation.chain_id
       JOIN task_definitions AS definition
         ON definition.id = continuation.definition_id
        AND definition.chain_id = chain.id
       JOIN day_traces AS source
         ON source.id = continuation.source_trace_id
        AND source.chain_id = chain.id
        AND source.definition_id = definition.id
       JOIN day_traces AS target
         ON target.id = continuation.target_trace_id
        AND target.chain_id = chain.id
        AND target.definition_id = definition.id
       JOIN days AS target_day ON target_day.date = continuation.target_date
       WHERE chain.state = 'active'
         AND chain.created_at_bits = continuation.source_creation_bits
         AND chain.updated_at_bits = continuation.continuation_bits
         AND definition.title = continuation.title
         AND definition.superseded_at IS NULL
         AND definition.created_at_bits =
             continuation.source_creation_bits
         AND definition.content_updated_at_bits =
             continuation.source_creation_bits
         AND source.date = continuation.source_date
         AND source.status = 'pending'
         AND source.created_at_bits = continuation.source_creation_bits
         AND source.content_updated_at_bits = continuation.undo_bits
         AND target.date = continuation.target_date
         AND target.status = 'cancelledDraft'
         AND target.continued_from_trace_id =
             continuation.source_trace_id
         AND target.draft_cancellation_id =
             continuation.cancellation_id
         AND target.draft_cancelled_on = continuation.target_date
         AND target.created_at_bits = continuation.continuation_bits
         AND target.content_updated_at_bits = continuation.undo_bits
         AND target.settled_at_bits = continuation.undo_bits
         AND target_day.created_at_bits = continuation.continuation_bits
         AND target_day.updated_at_bits = continuation.continuation_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN continuation
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits =
             continuation.source_creation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = continuation.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = continuation.definition_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = continuation.source_trace_id)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN continuation
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = continuation.continuation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = continuation.chain_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = continuation.source_trace_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = continuation.target_trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = continuation.target_date)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN continuation
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = continuation.undo_bits
         AND journal.entity_type = 'dayTrace'
         AND journal.entity_id IN (
           continuation.source_trace_id,
           continuation.target_trace_id
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN continuation
       WHERE (
         (journal.entity_type = 'taskChain'
           AND journal.entity_id = continuation.chain_id)
         OR (journal.entity_type = 'taskDefinition'
           AND journal.entity_id = continuation.definition_id)
         OR (journal.entity_type = 'dayTrace'
           AND journal.entity_id IN (
             continuation.source_trace_id,
             continuation.target_trace_id
           ))
         OR (journal.entity_type = 'day'
           AND journal.entity_id = continuation.target_date)
       )),
      (SELECT count(*)
       FROM copied
       JOIN task_chains AS chain ON chain.id = copied.chain_id
       JOIN task_definitions AS definition
         ON definition.id = copied.definition_id
        AND definition.chain_id = chain.id
       WHERE chain.state = 'abandoned'
         AND chain.created_at_bits = copied.creation_bits
         AND chain.updated_at_bits = copied.undo_bits
         AND definition.title = copied.title
         AND definition.created_at_bits = copied.creation_bits
         AND definition.content_updated_at_bits = copied.creation_bits
         AND definition.superseded_at IS NULL
         AND NOT EXISTS (
           SELECT 1
           FROM day_traces AS trace
           WHERE trace.chain_id = chain.id
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN copied
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = copied.creation_bits
         AND (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = copied.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = copied.definition_id)
         )),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN copied
       WHERE journal.operation = 'upsert'
         AND journal.record_payload IS NULL
         AND journal.changed_at_bits = copied.undo_bits
         AND journal.entity_type = 'taskChain'
         AND journal.entity_id = copied.chain_id),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN copied
       WHERE (
         (journal.entity_type = 'taskChain'
           AND journal.entity_id = copied.chain_id)
         OR (journal.entity_type = 'taskDefinition'
           AND journal.entity_id = copied.definition_id)
       )),
      (SELECT count(*) FROM copied_classification),
      (SELECT count(*)
       FROM copied_classification
       JOIN copied
       JOIN change_journal AS journal
         ON journal.entity_type = 'classificationCommit'
        AND journal.entity_id = copied_classification.record_id
        AND journal.changed_at_bits = copied.creation_bits
       WHERE copied_classification.source_kind = 'inherited'),
      (SELECT count(*)
       FROM copied_classification
       JOIN copied
       JOIN change_journal AS journal
         ON journal.entity_type = 'classificationCommit'
        AND journal.entity_id = copied_classification.record_id
        AND journal.changed_at_bits = copied.undo_bits
       WHERE copied_classification.source_kind =
           'deterministicDomainAction'
         AND copied_classification.source_reason =
           'task removed from task pool while preserving classification history'),
      (SELECT count(*)
       FROM classification_relation_history
       JOIN copied ON copied.chain_id =
           classification_relation_history.chain_id),
      (SELECT count(*)
       FROM copied_classification
       JOIN source
       WHERE copied_classification.source_kind = 'inherited'
         AND copied_classification.source_from_chain_id = source.chain_id),
      (SELECT count(*)
       FROM classification_change_records
       WHERE source_kind = 'deterministicDomainAction'
         AND source_reason =
           'task removed from task pool while preserving classification history'
         AND decision_id IS NULL),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'classificationCommit');
  ")"
  if [[ "$sql_probe" != "1 4 2 6 1 2 2 1 5 1 3 1 1 1 1 7 1 3 4 2 9 1 2 1 3 2 1 1 2 1 1 3" ]]; then
    echo "snapshot undo evidence-matrix SQLite/journal probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E snapshot undo raw facts, HLC journal, projections, and restart: $copy_undo_db (probe=$sql_probe)"
}

run_lifecycle_persistence_probe() {
  local lifecycle_dir="artifacts/e2e-lifecycle"
  local lifecycle_db="${lifecycle_dir}/Noonmark.sqlite"
  local setup_result="${lifecycle_dir}/setup-result.txt"
  local restart_result="${lifecycle_dir}/restart-result.txt"
  local setup_log="${lifecycle_dir}/setup.log"
  local restart_log="${lifecycle_dir}/restart.log"
  local lifecycle_probe

  rm -rf "$lifecycle_dir"
  mkdir -p "$lifecycle_dir"

  run_terminating_ui_probe \
    "lifecycle persistence setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$lifecycle_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-lifecycle-workflow \
    --e2e-lifecycle-result-url "$PWD/$setup_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "lifecycle persistence restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$lifecycle_db" \
    --page unfinished \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-lifecycle-restart-verify \
    --e2e-lifecycle-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  lifecycle_probe="$(sqlite3 -noheader -separator ' ' "$lifecycle_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更旧任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'changed'
         AND day_traces.changed_to_trace_id IS NOT NULL),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更新任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 回池任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'returnedToPool'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'
         AND day_traces.settled_at IS NULL
         AND day_traces.description_text = 'E2E 固定时钟重启修改。'
         AND julianday(day_traces.content_updated_at) >=
             julianday('2026-07-05T16:00:00Z')
         AND julianday(day_traces.content_updated_at) <
             julianday('2026-07-05T16:00:01Z')
         AND julianday(task_chains.updated_at) >=
             julianday('2026-07-05T16:00:00Z')
         AND julianday(task_chains.updated_at) <
             julianday('2026-07-05T16:00:01Z')
         AND task_chains.state = 'active'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.status = 'abandoned'
         AND task_chains.state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 废弃任务'),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND record_payload IS NOT NULL
         AND length(record_payload) > 0);
  ")"
  if [[ "$lifecycle_probe" != "1 1 1 1 0 1 1" ]]; then
    echo "lifecycle E2E SQLite/restart probe failed: ${lifecycle_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E lifecycle SQLite restart: $lifecycle_db (probe=$lifecycle_probe)"
}

run_natural_day_rollover_probe() {
  local rollover_dir="artifacts/e2e-natural-day"
  local rollover_db="${rollover_dir}/Noonmark.sqlite"
  local rollover_state="${rollover_dir}/state.json"
  local exercise_result="${rollover_dir}/exercise-result.txt"
  local restart_result="${rollover_dir}/restart-result.txt"
  local exercise_log="${rollover_dir}/exercise.log"
  local restart_log="${rollover_dir}/restart.log"
  local sqlite_probe
  local wake_block_count
  local manual_block_count
  local retry_count
  local backward_count
  local forward_count

  rm -rf "$rollover_dir"
  mkdir -p "$rollover_dir"

  run_terminating_ui_probe \
    "natural-day live rollover" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$rollover_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-persistence-failure-automation \
    --e2e-natural-day-rollover-exercise \
    --e2e-natural-day-rollover-state-url "$PWD/$rollover_state" \
    --e2e-natural-day-rollover-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  wake_block_count="$(grep -cF 'natural day blocked signal=wake applied=2026-07-05 candidate=2026-07-06' "$exercise_log" || true)"
  manual_block_count="$(grep -cF 'natural day blocked signal=manual applied=2026-07-05 candidate=2026-07-06' "$exercise_log" || true)"
  retry_count="$(grep -cF 'natural day reconciled signal=applicationBecameActive previous=2026-07-05 current=2026-07-06' "$exercise_log" || true)"
  backward_count="$(grep -cF 'natural day reconciled signal=timeZoneChanged previous=2026-07-06 current=2026-07-05' "$exercise_log" || true)"
  forward_count="$(grep -cF 'natural day reconciled signal=timeZoneChanged previous=2026-07-05 current=2026-07-06' "$exercise_log" || true)"
  if [[ "$wake_block_count" -ne 1 || "$manual_block_count" -ne 1 ||
    "$retry_count" -ne 1 || "$backward_count" -ne 1 || "$forward_count" -ne 1 ]]; then
    echo "natural-day lifecycle log markers are incomplete or duplicated" >&2
    cat "$exercise_log" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "natural-day restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$rollover_db" \
    --page day \
    --e2e-fixed-instant 2026-07-06T04:30:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-natural-day-rollover-restart-verify \
    --e2e-natural-day-rollover-state-url "$PWD/$rollover_state" \
    --e2e-natural-day-rollover-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$rollover_db" "
    WITH target AS (
      SELECT trace.status, trace.settled_at, day.locked_at
      FROM day_traces AS trace
      JOIN task_definitions AS definition ON definition.id = trace.definition_id
      JOIN days AS day ON day.date = trace.date
      WHERE definition.title = 'E2E natural day atomic rollover'
        AND trace.date = '2026-07-05'
    )
    SELECT
      (SELECT count(*) FROM target WHERE status = 'unfinished'),
      (SELECT count(*) FROM target WHERE status = 'pending'),
      (SELECT count(*) FROM target
       WHERE settled_at IS NOT NULL
         AND locked_at IS NOT NULL
         AND settled_at = locked_at);
  ")"
  if [[ "$sqlite_probe" != "1 0 1" ]]; then
    echo "natural-day SQLite rollover probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E natural-day wake/retry/time-zone/restart: $rollover_db (probe=$sqlite_probe)"
}

run_preferences_clock_probe() {
  local preferences_dir="artifacts/e2e-preferences-clock"
  local preferences_db="${preferences_dir}/Noonmark.sqlite"
  local state_file="${preferences_dir}/state.json"
  local setup_result="${preferences_dir}/setup-result.txt"
  local setup_log="${preferences_dir}/setup.log"
  local exercise_result="${preferences_dir}/exercise-result.txt"
  local exercise_log="${preferences_dir}/exercise.log"
  local restart_result="${preferences_dir}/restart-result.txt"
  local restart_log="${preferences_dir}/restart.log"
  local sync_root="/tmp/noonmark-e2e-preferences-clock-sync-$$"
  local remote_bits
  local theme_bits
  local language_bits
  local final_header_bits
  local final_payload_bits
  local remote_sha256
  local final_sha256
  local final_snapshot_id
  local final_snapshot_digest
  local final_snapshot_sha256
  local sqlite_probe
  local trace_probe

  rm -rf "$preferences_dir"
  rm -rf "$sync_root"
  mkdir -p "$preferences_dir"

  run_terminating_ui_probe \
    "preference logical-clock remote setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$preferences_db" \
    --sync-folder-url "$sync_root" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-preferences-clock-setup \
    --e2e-preferences-clock-state-url "$PWD/$state_file" \
    --e2e-preferences-clock-result-url "$PWD/$setup_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "preference logical-clock native Settings exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$preferences_db" \
    --sync-folder-url "$sync_root" \
    --page settings \
    --e2e-expand-settings-poem \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-preferences-clock-exercise \
    --e2e-preferences-clock-state-url "$PWD/$state_file" \
    --e2e-preferences-clock-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "preference logical-clock stale-remote restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$preferences_db" \
    --sync-folder-url "$sync_root" \
    --page settings \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-preferences-clock-verify \
    --e2e-preferences-clock-state-url "$PWD/$state_file" \
    --e2e-preferences-clock-result-url "$PWD/$restart_result"

  remote_bits="$(/usr/bin/plutil -extract remoteClockBits raw -o - \
    "$state_file")"
  theme_bits="$(/usr/bin/plutil -extract themeClockBits raw -o - \
    "$state_file")"
  language_bits="$(/usr/bin/plutil -extract languageClockBits raw -o - \
    "$state_file")"
  final_header_bits="$(/usr/bin/plutil -extract finalHeaderClockBits raw -o - \
    "$state_file")"
  final_payload_bits="$(/usr/bin/plutil -extract finalPayloadClockBits raw -o - \
    "$state_file")"
  remote_sha256="$(/usr/bin/plutil -extract remoteRecordSHA256 raw -o - \
    "$state_file")"
  final_sha256="$(/usr/bin/plutil -extract finalRecordSHA256 raw -o - \
    "$state_file")"
  final_snapshot_id="$(/usr/bin/plutil -extract finalSnapshotID raw -o - \
    "$state_file")"
  final_snapshot_digest="$(/usr/bin/plutil \
    -extract finalSnapshotPayloadDigest raw -o - "$state_file")"
  final_snapshot_sha256="$(/usr/bin/plutil \
    -extract finalSnapshotSHA256 raw -o - "$state_file")"

  if (( remote_bits >= theme_bits || theme_bits >= language_bits )); then
    echo "preference logical-clock state did not advance exactly in order" >&2
    exit 1
  fi
  if [[ "$final_header_bits" != "$language_bits" \
    || "$final_payload_bits" != "$language_bits" ]]; then
    echo "preference remote header/payload exact clock probe failed" >&2
    exit 1
  fi

  if [[ "$(shasum -a 256 \
    "${preferences_dir}/remote-future-preferences.json" \
    | awk '{print $1}')" != "$remote_sha256" \
    || "$(shasum -a 256 \
      "${preferences_dir}/remote-before-local-settings.json" \
      | awk '{print $1}')" != "$remote_sha256" \
    || "$(shasum -a 256 \
      "${preferences_dir}/stale-remote-reintroduced.json" \
      | awk '{print $1}')" != "$remote_sha256" \
    || "$(shasum -a 256 \
      "${preferences_dir}/stale-remote-before-restart-sync.json" \
      | awk '{print $1}')" != "$remote_sha256" \
    || "$(shasum -a 256 \
      "${preferences_dir}/final-local-winner-preferences.json" \
      | awk '{print $1}')" != "$final_sha256" \
    || "$(shasum -a 256 \
      "${preferences_dir}/final-local-winner-snapshot.json" \
      | awk '{print $1}')" != "$final_snapshot_sha256" ]]; then
    echo "preference local-folder record SHA-256 evidence failed" >&2
    exit 1
  fi

  if [[ "$(/usr/bin/plutil -extract id raw -o - \
      "${preferences_dir}/final-local-winner-snapshot.json")" \
      != "$final_snapshot_id" \
    || "$(/usr/bin/plutil -extract recordCount raw -o - \
      "${preferences_dir}/final-local-winner-snapshot.json")" != "1" \
    || "$(/usr/bin/plutil -extract recordIDs.0.rawValue raw -o - \
      "${preferences_dir}/final-local-winner-snapshot.json")" \
      != "preferences:default" \
    || "$(/usr/bin/plutil -extract payloadDigest raw -o - \
      "${preferences_dir}/final-local-winner-snapshot.json")" \
      != "$final_snapshot_digest" ]]; then
    echo "preference local-folder snapshot winner evidence failed" >&2
    exit 1
  fi

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$preferences_db" "
    WITH settings AS (
      SELECT
        max(CASE WHEN key = 'app.data_mode' THEN value END) AS data_mode,
        max(CASE WHEN key = 'app.local_first_sync.enabled'
          THEN value END) AS sync_enabled,
        max(CASE WHEN key = 'app.local_first_sync.endpoint'
          THEN value END) AS sync_endpoint,
        max(CASE WHEN key = 'app.local_first_sync.mode'
          THEN value END) AS sync_mode,
        max(CASE WHEN key = 'app.settings_poem.enabled'
          THEN value END) AS poem_enabled,
        max(CASE WHEN key = 'app.settings_poem.text'
          THEN value END) AS poem_text
      FROM sync_settings
    ), preference_journal AS (
      SELECT *
      FROM change_journal
      WHERE entity_type = 'appPreferences'
        AND entity_id = 'default'
        AND operation = 'upsert'
    ), preference_audit AS (
      SELECT *
      FROM sync_audit_log
      WHERE entity_type = 'appPreferences'
        AND entity_id = 'default'
    )
    SELECT
      (SELECT count(*)
       FROM app_preferences
       WHERE theme = 'coolGray'
         AND language = 'chinese'
         AND theme_language_updated_at_bits = $language_bits
         AND theme_language_writer_id = (
           SELECT device_id FROM sync_device_identity WHERE id = 1
         )),
      (SELECT count(*)
       FROM settings
       WHERE data_mode = 'localFirst'
         AND sync_enabled = 'true'
         AND sync_endpoint = 'localFolder'
         AND sync_mode = 'manual'
         AND poem_enabled = 'false'
         AND poem_text = 'E2E local-only preference sentinel 6049'),
      (SELECT count(*) FROM preference_journal),
      (SELECT count(*)
       FROM preference_journal
       WHERE sync_state = 'uploaded'
         AND retry_count = 0
         AND last_error IS NULL
         AND record_payload IS NOT NULL
         AND length(record_payload) > 0),
      (SELECT count(*)
       FROM preference_journal
       WHERE sync_state IN ('pendingUpload', 'failed')),
      (SELECT count(*)
       FROM preference_journal
       WHERE changed_at_bits = $theme_bits
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.theme'
         ) = 'coolGray'
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.language'
         ) = 'english'
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.writerDeviceID.rawValue'
         ) = (
           SELECT device_id FROM sync_device_identity WHERE id = 1
         )
         AND CAST(json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.updatedAt'
         ) AS INTEGER) = changed_at_bits),
      (SELECT count(*)
       FROM preference_journal
       WHERE changed_at_bits = $language_bits
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.theme'
         ) = 'coolGray'
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.language'
         ) = 'chinese'
         AND json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.writerDeviceID.rawValue'
         ) = (
           SELECT device_id FROM sync_device_identity WHERE id = 1
         )
         AND CAST(json_extract(
           CAST(record_payload AS TEXT),
           '$.payload.updatedAt'
         ) AS INTEGER) = changed_at_bits),
      (SELECT count(*) FROM preference_audit),
      (SELECT count(*)
       FROM preference_audit
       WHERE direction = 'upload' AND action = 'uploaded'),
      (SELECT count(*)
       FROM preference_audit
       WHERE direction = 'download' AND action = 'merged'),
      (SELECT count(*)
       FROM preference_audit
       WHERE direction = 'download' AND action = 'ignored');
  ")"
  if [[ "$sqlite_probe" != "1 1 2 2 0 1 1 5 2 1 2" ]]; then
    echo "preference SQLite/journal/audit exact-bit probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  trace_probe="$(awk '
    /click identifier=settings.preferences.theme/ { theme = 1 }
    /click identifier=settings.preferences.language/ { language = 1 }
    /click identifier=settings.preferences.poem.enabled/ { poem = 1 }
    /sync uploaded=2 pending=0 failed=0/ { synced = 1 }
    /restart stale=/ { restarted = 1 }
    END { print theme, language, poem, synced, restarted }
  ' "${preferences_dir}/input-trace.txt")"
  if [[ "$trace_probe" != "1 1 1 1 1" ]]; then
    echo "preference WindowServer input trace probe failed: ${trace_probe:-missing}" >&2
    exit 1
  fi

  printf '%s\n' \
    "remoteClockBits=$remote_bits" \
    "themeClockBits=$theme_bits" \
    "languageClockBits=$language_bits" \
    "finalHeaderClockBits=$final_header_bits" \
    "finalPayloadClockBits=$final_payload_bits" \
    "finalSnapshotID=$final_snapshot_id" \
    "finalSnapshotPayloadDigest=$final_snapshot_digest" \
    "sqliteProbe=$sqlite_probe" \
    "inputTraceProbe=$trace_probe" \
    >"${preferences_dir}/probe.txt"

  rm -rf "$sync_root"
  echo "E2E native Settings preference HLC, local-only boundary, sync, and restart: $preferences_db (probe=$sqlite_probe)"
}

run_mutation_clock_probe() {
  local clock_dir="artifacts/e2e-mutation-clock"
  local clock_db="${clock_dir}/Noonmark.sqlite"
  local clock_state="${clock_dir}/state.json"
  local exercise_result="${clock_dir}/exercise-result.txt"
  local restart_result="${clock_dir}/restart-result.txt"
  local exercise_log="${clock_dir}/exercise.log"
  local restart_log="${clock_dir}/restart.log"
  local sqlite_probe

  rm -rf "$clock_dir"
  mkdir -p "$clock_dir"

  run_terminating_ui_probe \
    "mutation-clock future-frontier exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$clock_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-mutation-clock-exercise \
    --e2e-mutation-clock-state-url "$PWD/$clock_state" \
    --e2e-mutation-clock-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "mutation-clock restart follow-up" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$clock_db" \
    --page day \
    --e2e-fixed-instant 2026-07-06T04:30:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-mutation-clock-restart-verify \
    --e2e-mutation-clock-state-url "$PWD/$clock_state" \
    --e2e-mutation-clock-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$clock_db" "
    WITH source AS (
      SELECT
        chain.id AS chain_id,
        definition.id AS definition_id,
        trace.id AS trace_id,
        chain.created_at_bits AS chain_created_bits,
        chain.updated_at_bits AS chain_updated_bits,
        definition.created_at_bits AS definition_created_bits,
        definition.content_updated_at_bits AS definition_updated_bits,
        trace.created_at_bits AS trace_created_bits,
        trace.content_updated_at_bits AS trace_updated_bits,
        trace.settled_at_bits AS trace_settled_bits,
        day.created_at_bits AS day_created_bits,
        day.updated_at_bits AS day_updated_bits,
        day.locked_at_bits AS day_locked_bits
      FROM task_chains AS chain
      JOIN task_definitions AS definition
        ON definition.chain_id = chain.id
      JOIN day_traces AS trace
        ON trace.definition_id = definition.id
      JOIN days AS day
        ON day.date = trace.date
      WHERE definition.title = 'E2E mutation clock source'
        AND trace.date = '2026-07-05'
        AND trace.status = 'unfinished'
        AND trace.description_text = 'E2E mutation clock trace edit'
    ), follow_up AS (
      SELECT
        chain.id AS chain_id,
        definition.id AS definition_id,
        trace.id AS trace_id,
        chain.created_at_bits AS chain_created_bits,
        chain.updated_at_bits AS chain_updated_bits,
        definition.created_at_bits AS definition_created_bits,
        definition.content_updated_at_bits AS definition_updated_bits,
        trace.created_at_bits AS trace_created_bits,
        trace.content_updated_at_bits AS trace_updated_bits,
        day.created_at_bits AS day_created_bits,
        day.updated_at_bits AS day_updated_bits
      FROM task_chains AS chain
      JOIN task_definitions AS definition
        ON definition.chain_id = chain.id
      JOIN day_traces AS trace
        ON trace.definition_id = definition.id
      JOIN days AS day
        ON day.date = trace.date
      WHERE definition.title = 'E2E mutation clock restart follow-up'
        AND trace.date = '2026-07-06'
        AND trace.status = 'pending'
    ), classification AS (
      SELECT record.record_id
      FROM classification_change_records AS record
      JOIN classification_change_record_changes AS delta
        ON delta.record_id = record.record_id
      JOIN source
        ON source.chain_id = delta.chain_id
      WHERE delta.kind = 'setCurrent'
    ), classification_journal AS (
      SELECT journal.changed_at_bits
      FROM change_journal AS journal
      JOIN classification
        ON classification.record_id = journal.entity_id
      WHERE journal.entity_type = 'classificationCommit'
    ), rollover_events AS (
      SELECT event.event_id
      FROM trace_classification_snapshot_events AS event
      JOIN source
        ON source.trace_id = event.trace_id
      WHERE event.status = 'unfinished'
    ), trace_edit AS (
      SELECT journal.changed_at_bits
      FROM change_journal AS journal
      JOIN source
        ON source.trace_id = journal.entity_id
      JOIN classification_journal
      WHERE journal.entity_type = 'dayTrace'
        AND journal.changed_at_bits > source.trace_created_bits
        AND journal.changed_at_bits < classification_journal.changed_at_bits
    )
    SELECT
      (SELECT count(*) FROM source),
      (SELECT count(*) FROM follow_up),
      (SELECT count(*) FROM classification),
      (SELECT count(*) FROM rollover_events),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN source ON source.trace_id = journal.entity_id
       WHERE journal.entity_type = 'dayTrace'),
      (SELECT count(*)
       FROM change_journal AS journal
       WHERE journal.entity_type = 'day'
         AND journal.entity_id = '2026-07-05'),
      (SELECT count(*) FROM change_journal),
      (SELECT count(*)
       FROM source
       WHERE chain_created_bits = chain_updated_bits
         AND chain_created_bits = definition_created_bits
         AND chain_created_bits = definition_updated_bits
         AND chain_created_bits = trace_created_bits
         AND chain_created_bits = day_created_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN source
         ON (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = source.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = source.definition_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = source.trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = '2026-07-05')
         )
       WHERE journal.changed_at_bits = source.chain_created_bits),
      (SELECT count(*) FROM trace_edit),
      (SELECT count(*) FROM classification_journal),
      (SELECT count(*)
       FROM source
       WHERE trace_updated_bits = trace_settled_bits
         AND trace_updated_bits = day_updated_bits
         AND trace_updated_bits = day_locked_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN source
         ON (
           (journal.entity_type = 'dayTrace'
             AND journal.entity_id = source.trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = '2026-07-05')
         )
       WHERE journal.changed_at_bits = source.trace_settled_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN rollover_events
         ON rollover_events.event_id = journal.entity_id
       JOIN source
       WHERE journal.entity_type = 'traceClassificationEvent'
         AND journal.changed_at_bits = source.trace_settled_bits),
      (SELECT count(*)
       FROM follow_up
       WHERE chain_created_bits = chain_updated_bits
         AND chain_created_bits = definition_created_bits
         AND chain_created_bits = definition_updated_bits
         AND chain_created_bits = trace_created_bits
         AND chain_created_bits = trace_updated_bits
         AND chain_created_bits = day_created_bits
         AND chain_created_bits = day_updated_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN follow_up
         ON (
           (journal.entity_type = 'taskChain'
             AND journal.entity_id = follow_up.chain_id)
           OR (journal.entity_type = 'taskDefinition'
             AND journal.entity_id = follow_up.definition_id)
           OR (journal.entity_type = 'dayTrace'
             AND journal.entity_id = follow_up.trace_id)
           OR (journal.entity_type = 'day'
             AND journal.entity_id = '2026-07-06')
         )
       WHERE journal.changed_at_bits = follow_up.chain_created_bits),
      (SELECT count(*)
       FROM source
       JOIN trace_edit
       JOIN classification_journal
       JOIN follow_up
       WHERE source.trace_created_bits < trace_edit.changed_at_bits
         AND trace_edit.changed_at_bits < classification_journal.changed_at_bits
         AND classification_journal.changed_at_bits < source.trace_settled_bits
         AND source.trace_settled_bits < follow_up.chain_created_bits);
  ")"
  if [[ "$sqlite_probe" != "1 1 1 1 3 2 13 1 4 1 1 1 2 1 1 4 1" ]]; then
    echo "mutation-clock SQLite/journal exact-bit probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E future-frontier mutation clock, rollover, and restart: $clock_db (probe=$sqlite_probe)"
}

run_subtask_clock_probe() {
  local subtask_dir="artifacts/e2e-subtask-clock"
  local subtask_db="${subtask_dir}/Noonmark.sqlite"
  local subtask_state="${subtask_dir}/state.json"
  local exercise_result="${subtask_dir}/exercise-result.txt"
  local restart_result="${subtask_dir}/restart-result.txt"
  local exercise_log="${subtask_dir}/exercise.log"
  local restart_log="${subtask_dir}/restart.log"
  local sqlite_probe

  rm -rf "$subtask_dir"
  mkdir -p "$subtask_dir"

  run_terminating_ui_probe \
    "subtask updatedAt exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$subtask_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-subtask-clock-exercise \
    --e2e-subtask-clock-state-url "$PWD/$subtask_state" \
    --e2e-subtask-clock-result-url "$PWD/$exercise_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "subtask updatedAt restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$subtask_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-subtask-clock-restart-verify \
    --e2e-subtask-clock-state-url "$PWD/$subtask_state" \
    --e2e-subtask-clock-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$subtask_db" "
    WITH state(payload) AS (
      SELECT CAST(readfile('$PWD/$subtask_state') AS TEXT)
    ), target AS (
      SELECT
        subtask.id,
        subtask.created_at_bits,
        subtask.updated_at_bits
      FROM subtasks AS subtask
      JOIN day_traces AS trace
        ON trace.id = subtask.trace_id
      JOIN task_definitions AS definition
        ON definition.id = trace.definition_id
      JOIN state
      WHERE subtask.id = json_extract(state.payload, '$.subtaskID')
        AND trace.id = json_extract(state.payload, '$.traceID')
        AND definition.title = 'E2E subtask updatedAt clock parent'
        AND subtask.title = 'E2E subtask updatedAt clock'
        AND subtask.status = 'pending'
        AND subtask.completed_at IS NULL
        AND subtask.settled_at IS NULL
        AND subtask.difficulty = 3
    ), mutation_clocks AS (
      SELECT
        CAST(clock.key AS INTEGER) AS position,
        CAST(clock.value AS INTEGER) AS bits
      FROM state, json_each(state.payload, '$.mutationBits') AS clock
    ), target_journal AS (
      SELECT journal.changed_at_bits
      FROM change_journal AS journal
      JOIN target
        ON target.id = journal.entity_id
      WHERE journal.entity_type = 'subtask'
        AND journal.operation = 'upsert'
        AND journal.record_payload IS NULL
    )
    SELECT
      (SELECT count(*) FROM target),
      (SELECT count(*)
       FROM target
       WHERE updated_at_bits != created_at_bits),
      (SELECT count(*) FROM mutation_clocks),
      (SELECT count(DISTINCT bits) FROM mutation_clocks),
      (SELECT count(*)
       FROM target_journal),
      (SELECT count(DISTINCT changed_at_bits)
       FROM target_journal),
      (SELECT count(*)
       FROM target
       WHERE (
         SELECT max(changed_at_bits) FROM target_journal
       ) = target.updated_at_bits),
      (SELECT count(*)
       FROM target
       WHERE (
         SELECT min(changed_at_bits) FROM target_journal
       ) = target.created_at_bits),
      (SELECT count(*)
       FROM mutation_clocks
       JOIN target_journal
         ON target_journal.changed_at_bits = mutation_clocks.bits),
      (SELECT count(*)
       FROM target, state
       WHERE target.created_at_bits =
           CAST(json_extract(state.payload, '$.createdBits') AS INTEGER)
         AND target.updated_at_bits =
           CAST(json_extract(state.payload, '$.mapperModifiedBits') AS INTEGER)),
      (SELECT count(*)
       FROM target
       WHERE NOT EXISTS (
         SELECT 1
         FROM mutation_clocks AS later
         JOIN mutation_clocks AS earlier
           ON later.position = earlier.position + 1
         WHERE later.bits <= earlier.bits
       )
         AND (
           SELECT min(bits) FROM mutation_clocks
         ) > target.created_at_bits);
  ")"
  if [[ "$sqlite_probe" != "1 1 5 5 6 6 1 1 5 1 1" ]]; then
    echo "subtask updatedAt SQLite/journal/mapper probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E subtask updatedAt, Store undo/redo, mapper, and restart: $subtask_db (probe=$sqlite_probe)"
}

run_zhulong_navigation_probe() {
  local navigation_dir="artifacts/e2e-zhulong-navigation"
  local navigation_result="${navigation_dir}/zhulong-navigation-result.txt"
  local navigation_log="${navigation_dir}/zhulong-navigation.log"

  rm -rf "$navigation_dir"
  mkdir -p "$navigation_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "zhulong navigation visibility" \
    "$navigation_result" \
    "$navigation_log" \
    --ephemeral \
    --page zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-zhulong-navigation \
    --e2e-zhulong-navigation-result-url "$PWD/$navigation_result"

  echo "E2E zhulong navigation visibility: $navigation_result"
}

run_zhulong_daily_recovery_clock_probe() {
  local recovery_dir="artifacts/e2e-zhulong-recovery"
  local recovery_db="${recovery_dir}/Noonmark.sqlite"
  local recovery_result="${recovery_dir}/recovery-result.txt"
  local interruption_result="${recovery_dir}/interruption-result.txt"
  local recovery_log="${recovery_dir}/recovery.log"
  local recovery_journal="${recovery_dir}/ZhulongSidecar/pending-application.zhj"
  local before_recovery_hash
  local after_recovery_hash
  local clock_probe

  rm -rf "$recovery_dir"
  mkdir -p "$recovery_dir"

  /usr/bin/open -W -n "$app_path" --args \
    --data-url "$PWD/$recovery_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-start-zhulong-workflow dailyReview \
    --e2e-rich-zhulong-session \
    --e2e-interrupt-zhulong-daily-review \
    --e2e-zhulong-interruption-result-url "$PWD/$interruption_result" \
    --e2e-quit-after-automation

  if [[ "$(cat "$interruption_result" 2>/dev/null || true)" != \
    "ok: mutation blocked pending Zhulong application" ]]; then
    echo "zhulong interrupted durable-after/pending-gate evidence failed: $(cat "$interruption_result" 2>/dev/null || echo missing)" >&2
    exit 1
  fi
  if [[ ! -f "$recovery_journal" ]]; then
    echo "zhulong interrupted application journal was not persisted" >&2
    exit 1
  fi
  before_recovery_hash="$(shasum -a 256 "$recovery_db" | awk '{print $1}')"

  run_terminating_ui_probe \
    "zhulong interrupted application recovery" \
    "$recovery_result" \
    "$recovery_log" \
    --data-url "$PWD/$recovery_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-expect-zhulong-recovery \
    --e2e-verify-zhulong-persistence-result-url "$PWD/$recovery_result"

  after_recovery_hash="$(shasum -a 256 "$recovery_db" | awk '{print $1}')"
  if [[ "$after_recovery_hash" != "$before_recovery_hash" ]]; then
    echo "zhulong current==after recovery rewrote the engine database" >&2
    exit 1
  fi
  if [[ -f "$recovery_journal" ]]; then
    echo "zhulong recovery journal was not cleared after successful recovery" >&2
    exit 1
  fi

  clock_probe="$(sqlite3 -noheader -separator ' ' "$recovery_db" "
    SELECT
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 已确认的每日复盘'),
      (SELECT count(*)
       FROM days
       JOIN change_journal
         ON change_journal.entity_type = 'day'
        AND change_journal.entity_id = days.date
        AND change_journal.changed_at_bits = days.updated_at_bits
       WHERE days.date = '2026-07-05'),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'day'
         AND entity_id = '2026-07-05');
  ")"
  if [[ "$clock_probe" != "1 1 1" ]]; then
    echo "zhulong daily-review joint clock probe failed: ${clock_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E fixed-clock Zhulong daily review and no-rewrite recovery: $recovery_db (probe=$clock_probe)"
}

run_zhulong_exact_recovery_identity_probe() {
  local evidence_dir="artifacts/e2e-zhulong-exact-recovery"
  local exact_dir="${evidence_dir}/exact-after"
  local exact_db="${exact_dir}/Noonmark.sqlite"
  local exact_state="${exact_dir}/state.json"
  local exact_setup_result="${exact_dir}/setup-result.txt"
  local exact_setup_log="${exact_dir}/setup.log"
  local exact_verify_result="${exact_dir}/verify-result.txt"
  local exact_verify_log="${exact_dir}/verify.log"
  local exact_journal="${exact_dir}/ZhulongSidecar/pending-application.zhj"
  local exact_before_database_sha256
  local exact_after_database_sha256
  local exact_before_bits
  local exact_after_bits
  local exact_before_digest
  local exact_after_digest
  local exact_current_digest
  local exact_chain_id
  local exact_definition_sequence
  local exact_sqlite_probe
  local conflict_dir="${evidence_dir}/preference-conflict"
  local conflict_db="${conflict_dir}/Noonmark.sqlite"
  local conflict_state="${conflict_dir}/state.json"
  local conflict_setup_result="${conflict_dir}/setup-result.txt"
  local conflict_setup_log="${conflict_dir}/setup.log"
  local conflict_verify_result="${conflict_dir}/verify-result.txt"
  local conflict_verify_log="${conflict_dir}/verify.log"
  local conflict_journal="${conflict_dir}/ZhulongSidecar/pending-application.zhj"
  local conflict_before_database_sha256
  local conflict_after_database_sha256
  local conflict_before_journal_sha256
  local conflict_after_journal_sha256
  local conflict_before_data_mode
  local conflict_current_data_mode
  local conflict_before_digest
  local conflict_after_digest
  local conflict_current_digest
  local conflict_sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$exact_dir" "$conflict_dir"

  run_terminating_ui_probe \
    "zhulong exact-after recovery setup" \
    "$exact_setup_result" \
    "$exact_setup_log" \
    --data-url "$PWD/$exact_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-exact-recovery exact-after \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$exact_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$exact_setup_result"

  if [[ ! -f "$exact_journal" ]]; then
    echo "zhulong exact-after setup did not persist its encrypted journal" >&2
    exit 1
  fi
  exact_before_database_sha256="$(
    shasum -a 256 "$exact_db" | awk '{print $1}'
  )"
  exact_before_bits="$(
    /usr/bin/plutil -extract beforeUpdatedAtBits raw -o - "$exact_state"
  )"
  exact_after_bits="$(
    /usr/bin/plutil -extract afterUpdatedAtBits raw -o - "$exact_state"
  )"
  exact_before_digest="$(
    /usr/bin/plutil -extract beforeDigest raw -o - "$exact_state"
  )"
  exact_after_digest="$(
    /usr/bin/plutil -extract afterDigest raw -o - "$exact_state"
  )"
  exact_current_digest="$(
    /usr/bin/plutil -extract currentDigest raw -o - "$exact_state"
  )"
  exact_chain_id="$(
    /usr/bin/plutil -extract chainID raw -o - "$exact_state"
  )"
  exact_definition_sequence="$(
    /usr/bin/plutil -extract definitionSequence raw -o - "$exact_state"
  )"
  if [[ ! "$exact_before_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$exact_after_digest" =~ ^[0-9a-f]{64}$ \
    || "$exact_before_digest" == "$exact_after_digest" \
    || "$exact_current_digest" != "$exact_after_digest" ]]; then
    echo "zhulong exact-after state did not distinguish its snapshot identities" >&2
    exit 1
  fi
  if [[ "$(sqlite3 -noheader :memory: "
    SELECT
      CAST('$exact_after_bits' AS INTEGER) =
      CAST('$exact_before_bits' AS INTEGER) + 1;
  ")" != "1" ]]; then
    echo "zhulong exact-after state clocks are not adjacent Date bits" >&2
    exit 1
  fi
  exact_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$exact_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       WHERE id = '$exact_chain_id'
         AND state = 'active'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND updated_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM task_definitions
       WHERE chain_id = '$exact_chain_id'
         AND sequence = CAST('$exact_definition_sequence' AS INTEGER)
         AND title = 'E2E 烛龙精确 after 时钟'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND content_updated_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND superseded_at IS NULL),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id'
         AND change_journal.changed_at_bits =
             CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id');
  ")"
  if [[ "$exact_sqlite_probe" != "1 1 1 1 1 2 1" ]]; then
    echo "zhulong exact-after SQLite bit probe failed: ${exact_sqlite_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong exact-after no-rewrite recovery" \
    "$exact_verify_result" \
    "$exact_verify_log" \
    --data-url "$PWD/$exact_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-exact-recovery exact-after \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$exact_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$exact_verify_result"

  exact_after_database_sha256="$(
    shasum -a 256 "$exact_db" | awk '{print $1}'
  )"
  if [[ "$exact_after_database_sha256" != "$exact_before_database_sha256" ]]; then
    echo "zhulong exact-after recovery rewrote the engine database" >&2
    exit 1
  fi
  if [[ -f "$exact_journal" ]]; then
    echo "zhulong exact-after recovery did not clear its journal" >&2
    exit 1
  fi
  exact_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$exact_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       WHERE id = '$exact_chain_id'
         AND state = 'active'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND updated_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM task_definitions
       WHERE chain_id = '$exact_chain_id'
         AND sequence = CAST('$exact_definition_sequence' AS INTEGER)
         AND title = 'E2E 烛龙精确 after 时钟'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND content_updated_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND superseded_at IS NULL),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id'
         AND change_journal.changed_at_bits =
             CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id');
  ")"
  if [[ "$exact_sqlite_probe" != "1 1 1 1 1 2 1" ]]; then
    echo "zhulong exact-after restart lost its bit reconciliation" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong local-only preference conflict setup" \
    "$conflict_setup_result" \
    "$conflict_setup_log" \
    --data-url "$PWD/$conflict_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-exact-recovery preference-conflict \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$conflict_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$conflict_setup_result"

  if [[ ! -f "$conflict_journal" ]]; then
    echo "zhulong preference-conflict setup did not persist its encrypted journal" >&2
    exit 1
  fi
  conflict_before_database_sha256="$(
    shasum -a 256 "$conflict_db" | awk '{print $1}'
  )"
  conflict_before_journal_sha256="$(
    shasum -a 256 "$conflict_journal" | awk '{print $1}'
  )"
  conflict_before_data_mode="$(
    /usr/bin/plutil -extract beforeDataMode raw -o - "$conflict_state"
  )"
  conflict_current_data_mode="$(
    /usr/bin/plutil -extract currentDataMode raw -o - "$conflict_state"
  )"
  conflict_before_digest="$(
    /usr/bin/plutil -extract beforeDigest raw -o - "$conflict_state"
  )"
  conflict_after_digest="$(
    /usr/bin/plutil -extract afterDigest raw -o - "$conflict_state"
  )"
  conflict_current_digest="$(
    /usr/bin/plutil -extract currentDigest raw -o - "$conflict_state"
  )"
  if [[ "$conflict_before_data_mode" != "localFirst" \
    || "$conflict_current_data_mode" != "onlineFirst" \
    || ! "$conflict_before_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$conflict_after_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$conflict_current_digest" =~ ^[0-9a-f]{64}$ \
    || "$conflict_before_digest" == "$conflict_after_digest" \
    || "$conflict_before_digest" == "$conflict_current_digest" \
    || "$conflict_after_digest" == "$conflict_current_digest" ]]; then
    echo "zhulong preference-conflict state did not isolate local-only data mode" >&2
    exit 1
  fi
  conflict_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$conflict_db" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*)
       FROM task_chains),
      (SELECT count(*)
       FROM task_definitions),
      (SELECT count(*)
       FROM day_traces),
      (SELECT count(*)
       FROM subtasks),
      (SELECT count(*)
       FROM change_journal),
      (SELECT count(*)
       FROM app_preferences
       WHERE id = 1
         AND theme = 'coolGray'
         AND language = 'chinese'
         AND theme_language_writer_id = 'noonmark.bootstrap'),
      (SELECT count(*)
       FROM sync_settings
       WHERE
         (key = 'app.backup.frequency' AND value = 'off')
         OR (key = 'app.backup.destination' AND value = 'iCloudDrive')
         OR (key = 'app.local_first_sync.enabled' AND value = 'false')
         OR (key = 'app.local_first_sync.endpoint' AND value = 'iCloud')
         OR (key = 'app.local_first_sync.mode' AND value = 'manual')
         OR (key = 'app.local_first_sync.interval_seconds' AND value = '300')
         OR (key = 'app.local_first_sync.generate_conflict_copy' AND value = 'true')
         OR (key = 'app.local_first_sync.retention_days' AND value = '180')
         OR (key = 'app.local_first_sync.retention_daily' AND value = '2')
         OR (key = 'app.settings_poem.enabled' AND value = 'true')
         OR (key = 'app.settings_poem.text' AND length(value) > 0)),
      (SELECT count(*) FROM sync_settings);
  ")"
  if [[ "$conflict_sqlite_probe" != "onlineFirst 0 0 0 0 0 1 11 12" ]]; then
    echo "zhulong preference-conflict third-snapshot probe failed: ${conflict_sqlite_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong local-only preference recovery conflict" \
    "$conflict_verify_result" \
    "$conflict_verify_log" \
    --data-url "$PWD/$conflict_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-exact-recovery preference-conflict \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$conflict_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$conflict_verify_result"

  conflict_after_database_sha256="$(
    shasum -a 256 "$conflict_db" | awk '{print $1}'
  )"
  if [[ "$conflict_after_database_sha256" != "$conflict_before_database_sha256" ]]; then
    echo "zhulong preference conflict changed the engine database" >&2
    exit 1
  fi
  if [[ ! -f "$conflict_journal" ]]; then
    echo "zhulong preference conflict incorrectly cleared its journal" >&2
    exit 1
  fi
  conflict_after_journal_sha256="$(
    shasum -a 256 "$conflict_journal" | awk '{print $1}'
  )"
  if [[ "$conflict_after_journal_sha256" != "$conflict_before_journal_sha256" ]]; then
    echo "zhulong preference conflict rewrote its retained journal" >&2
    exit 1
  fi
  conflict_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$conflict_db" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*)
       FROM task_chains),
      (SELECT count(*)
       FROM task_definitions),
      (SELECT count(*)
       FROM day_traces),
      (SELECT count(*)
       FROM subtasks),
      (SELECT count(*)
       FROM change_journal),
      (SELECT count(*)
       FROM app_preferences
       WHERE id = 1
         AND theme = 'coolGray'
         AND language = 'chinese'
         AND theme_language_writer_id = 'noonmark.bootstrap'),
      (SELECT count(*)
       FROM sync_settings
       WHERE
         (key = 'app.backup.frequency' AND value = 'off')
         OR (key = 'app.backup.destination' AND value = 'iCloudDrive')
         OR (key = 'app.local_first_sync.enabled' AND value = 'false')
         OR (key = 'app.local_first_sync.endpoint' AND value = 'iCloud')
         OR (key = 'app.local_first_sync.mode' AND value = 'manual')
         OR (key = 'app.local_first_sync.interval_seconds' AND value = '300')
         OR (key = 'app.local_first_sync.generate_conflict_copy' AND value = 'true')
         OR (key = 'app.local_first_sync.retention_days' AND value = '180')
         OR (key = 'app.local_first_sync.retention_daily' AND value = '2')
         OR (key = 'app.settings_poem.enabled' AND value = 'true')
         OR (key = 'app.settings_poem.text' AND length(value) > 0)),
      (SELECT count(*) FROM sync_settings);
  ")"
  if [[ "$conflict_sqlite_probe" != "onlineFirst 0 0 0 0 0 1 11 12" ]]; then
    echo "zhulong preference conflict applied the pending after snapshot" >&2
    exit 1
  fi

  echo "E2E Zhulong exact identity recovery and local-only preference conflict: $evidence_dir"
}

run_zhulong_pending_gate_probe() {
  local evidence_dir="artifacts/e2e-zhulong-pending-gate"
  local database="${evidence_dir}/Noonmark.sqlite"
  local sidecar_dir="${evidence_dir}/ZhulongSidecar"
  local journal="${sidecar_dir}/pending-application.zhj"
  local setup_result="${evidence_dir}/setup-result.txt"
  local setup_log="${evidence_dir}/setup.log"
  local verify_result="${evidence_dir}/verify-result.txt"
  local verify_log="${evidence_dir}/verify.log"
  local sqlite_lock_fifo="${evidence_dir}/sqlite-lock.fifo"
  local sqlite_lock_log="${evidence_dir}/sqlite-lock.log"
  local sqlite_lock_pid
  local sqlite_lock_acquired=0
  local session_file
  local session_count
  local before_database_sha256
  local before_journal_sha256
  local before_session_sha256
  local after_database_sha256
  local after_journal_sha256
  local after_session_sha256
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"

  run_terminating_ui_probe \
    "zhulong pending-gate bootstrap setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$database" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-pending-gate \
    --e2e-zhulong-pending-gate-result-url "$PWD/$setup_result"

  if [[ ! -f "$journal" ]]; then
    echo "zhulong pending-gate setup did not retain its journal" >&2
    exit 1
  fi
  session_count="$(find "$sidecar_dir" -type f -name '*.zhs' | wc -l | tr -d ' ')"
  if [[ "$session_count" -ne 1 ]]; then
    echo "zhulong pending-gate setup expected one Session: $session_count" >&2
    exit 1
  fi
  session_file="$(find "$sidecar_dir" -type f -name '*.zhs' -print -quit)"
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sqlite_probe" != "onlineFirst 0 0 0 0 0 0" ]]; then
    echo "zhulong pending-gate setup was not the empty third Engine: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  before_database_sha256="$(shasum -a 256 "$database" | awk '{print $1}')"
  before_journal_sha256="$(shasum -a 256 "$journal" | awk '{print $1}')"
  before_session_sha256="$(shasum -a 256 "$session_file" | awk '{print $1}')"

  rm -f "$sqlite_lock_fifo" "$sqlite_lock_log"
  mkfifo "$sqlite_lock_fifo"
  sqlite3 "$database" <"$sqlite_lock_fifo" >"$sqlite_lock_log" 2>&1 &
  sqlite_lock_pid=$!
  exec 9>"$sqlite_lock_fifo"
  printf 'PRAGMA busy_timeout = 0;\nBEGIN IMMEDIATE;\n' >&9
  for _ in {1..50}; do
    if ! sqlite3 "$database" \
      'PRAGMA busy_timeout = 0; BEGIN IMMEDIATE; ROLLBACK;' \
      >/dev/null 2>&1; then
      sqlite_lock_acquired=1
      break
    fi
    sleep 0.1
  done
  if [[ "$sqlite_lock_acquired" != "1" ]] ||
    ! kill -0 "$sqlite_lock_pid" 2>/dev/null; then
    exec 9>&-
    wait "$sqlite_lock_pid" 2>/dev/null || true
    echo "failed to hold the pending-gate SQLite write lock" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi

  # A RESERVED lock permits Store bootstrap reads but turns any attempted
  # bootstrap save into a real startup failure. The pending journal must make
  # loadOrSeed skip that ordinary write and proceed to exact recovery instead.
  run_terminating_ui_probe \
    "zhulong bootstrap and Engine writer pending gate" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$database" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-pending-gate \
    --e2e-zhulong-pending-gate-result-url "$PWD/$verify_result"

  printf 'ROLLBACK;\n.quit\n' >&9
  exec 9>&-
  if ! wait "$sqlite_lock_pid"; then
    echo "pending-gate SQLite lock holder failed" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi
  rm -f "$sqlite_lock_fifo"

  after_database_sha256="$(shasum -a 256 "$database" | awk '{print $1}')"
  after_journal_sha256="$(shasum -a 256 "$journal" | awk '{print $1}')"
  after_session_sha256="$(shasum -a 256 "$session_file" | awk '{print $1}')"
  if [[ "$after_database_sha256" != "$before_database_sha256" \
    || "$after_journal_sha256" != "$before_journal_sha256" \
    || "$after_session_sha256" != "$before_session_sha256" ]]; then
    echo "zhulong pending gate changed Engine, journal, or Session bytes" >&2
    exit 1
  fi

  echo "E2E Zhulong bootstrap/direct-save/rollover/import/sync pending gate: $evidence_dir"
}

run_zhulong_todo_diff_clock_probe() {
  local todo_dir="artifacts/e2e-zhulong-todo-diff"
  local todo_db="${todo_dir}/Noonmark.sqlite"
  local todo_result="${todo_dir}/result.txt"
  local todo_log="${todo_dir}/app.log"
  local clock_probe

  rm -rf "$todo_dir"
  mkdir -p "$todo_dir"

  run_terminating_ui_probe \
    "zhulong preauthorized Todo diff joint clock" \
    "$todo_result" \
    "$todo_log" \
    --data-url "$PWD/$todo_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-prepare-zhulong-todo-diff \
    --e2e-zhulong-todo-diff-result-url "$PWD/$todo_result"

  clock_probe="$(sqlite3 -noheader -separator ' ' "$todo_db" "
    WITH ai_definitions AS (
      SELECT id, created_at_bits
      FROM task_definitions
      WHERE superseded_at IS NULL
        AND title IN ('E2E 编辑后的测量', 'E2E 拆分后的验证')
    ), post_apply AS (
      SELECT id, created_at_bits
      FROM task_definitions
      WHERE superseded_at IS NULL
        AND title = 'E2E 烛龙应用后普通写入'
    )
    SELECT
      (SELECT count(*) FROM ai_definitions),
      (SELECT count(*) FROM post_apply),
      (SELECT count(*)
       FROM ai_definitions
       WHERE EXISTS (
         SELECT 1
         FROM change_journal
         WHERE entity_type = 'taskDefinition'
           AND entity_id = ai_definitions.id
           AND changed_at_bits = ai_definitions.created_at_bits
       )),
      (SELECT count(*)
       FROM post_apply
       WHERE EXISTS (
         SELECT 1
         FROM change_journal
         WHERE entity_type = 'taskDefinition'
           AND entity_id = post_apply.id
           AND changed_at_bits = post_apply.created_at_bits
       )),
      (SELECT min(post_apply.created_at_bits) > max(ai_definitions.created_at_bits)
       FROM post_apply, ai_definitions);
  ")"
  if [[ "$clock_probe" != "2 1 2 1 1" \
    || -f "${todo_dir}/ZhulongSidecar/pending-application.zhj" ]]; then
    echo "zhulong Todo diff joint clock probe failed: ${clock_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E fixed-clock Zhulong Todo apply and following Store mutation: $todo_db (probe=$clock_probe)"
}

run_terminating_ui_probe() {
  local label="$1"
  local result="$2"
  local log="$3"
  local pid
  shift 3

  rm -f "$result"
  if [[ "${NOONMARK_E2E_LAUNCH_WITH_OPEN:-0}" == "1" ]]; then
    /usr/bin/open -W -n "$app_path" --args "$@" >"$log" 2>&1 &
  else
    "$app_executable_path" "$@" >"$log" 2>&1 &
  fi
  pid=$!

  for _ in {1..400}; do
    if [[ -f "$result" ]] || ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done

  if [[ ! -f "$result" ]]; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label result was not created: $result" >&2
    cat "$log" >&2
    exit 1
  fi
  if [[ "$(<"$result")" != "ok" ]]; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label failed: $(<"$result")" >&2
    cat "$log" >&2
    exit 1
  fi

  for _ in {1..40}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label wrote ok but did not terminate" >&2
    cat "$log" >&2
    exit 1
  fi
  if ! wait "$pid"; then
    echo "$label app process failed" >&2
    cat "$log" >&2
    exit 1
  fi
  assert_clean_app_log "$label" "$log"
}

