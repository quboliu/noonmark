#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

catalog="Tests/Fixtures/tencent-ime-input-surfaces.tsv"
automation="App/NoonmarkMacApp/TencentIMEInputSurfaceMatrixE2EAutomation.swift"
matrix_script="scripts/test-tencent-ime-input-matrix"
termination_script="scripts/test-tencent-ime-termination-persistence"

fail() {
  echo "Tencent IME input contract failed: $*" >&2
  exit 1
}

expected_header=$'surface\tlabel\tarea\tsave_policy\tmarked_text_required\timmediate_exit_probe'
if [[ ! -f "$catalog" ]] \
    || [[ "$(head -n 1 "$catalog")" != "$expected_header" ]]; then
  fail "surface catalog header drifted"
fi

if ! awk -F $'\t' '
  NR == 1 { next }
  NF != 6 { exit 1 }
  $1 == "" || $2 == "" || $3 == "" { exit 1 }
  $4 != "none" &&
    $4 != "submit" &&
    $4 != "manual-save" &&
    $4 != "sqlite-autosave" &&
    $4 != "sidecar-autosave" { exit 1 }
  $5 != "true" && $5 != "false" { exit 1 }
  $6 != "true" && $6 != "false" { exit 1 }
' "$catalog"; then
  fail "surface catalog contains an invalid row"
fi

surface_count="$(
  awk -F $'\t' 'NR > 1 && NF { count += 1 } END { print count + 0 }' \
    "$catalog"
)"
if [[ "$surface_count" != "53" ]]; then
  fail "expected 53 input surfaces, found $surface_count"
fi

duplicate_surfaces="$(
  awk -F $'\t' 'NR > 1 && NF { print $1 }' "$catalog" \
    | sort \
    | uniq -d
)"
if [[ -n "$duplicate_surfaces" ]]; then
  fail "duplicate input surfaces: $duplicate_surfaces"
fi

termination_surface_count="$(
  awk -F $'\t' '
    NR > 1 && $6 == "true" { count += 1 }
    END { print count + 0 }
  ' "$catalog"
)"
if [[ "$termination_surface_count" != "24" ]]; then
  fail \
    "expected 24 immediate-exit probes, found $termination_surface_count"
fi

non_composition_surfaces="$(
  awk -F $'\t' 'NR > 1 && $5 == "false" { print $1 }' "$catalog"
)"
if [[ "$non_composition_surfaces" != "provider-api-key" ]]; then
  fail \
    "only the native secure API Key field may omit marked-text observation"
fi

if ! awk -F $'\t' '
  NR > 1 && $6 == "true" &&
    $4 != "sqlite-autosave" &&
    $4 != "sidecar-autosave" { exit 1 }
' "$catalog"; then
  fail "an immediate-exit probe does not use automatic persistence"
fi

if ! diff -u \
    <(
      awk -F $'\t' 'NR > 1 && NF { print $1 }' "$catalog"
    ) \
    <(
      sed -n \
        '/private enum Surface: String {/,/        var label: String {/p' \
        "$automation" \
        | perl -0777 -ne \
          'while (/case\s+\w+\s*=\s*"([^"]+)"/g) { print "$1\n" }'
    ); then
  fail "Swift automation and surface catalog differ"
fi

for script in "$matrix_script" "$termination_script"; do
  if [[ ! -x "$script" ]]; then
    fail "$script is not executable"
  fi
  if ! grep -Fq \
      'Tests/Fixtures/tencent-ime-input-surfaces.tsv' \
      "$script"; then
    fail "$script does not consume the shared surface catalog"
  fi
done

if ! grep -Fq 'NF != 22' "$matrix_script"; then
  fail "input matrix does not fail closed on its result schema"
fi
if ! grep -Fq 'NF != 7' "$termination_script"; then
  fail "termination matrix does not fail closed on its result schema"
fi

for contract_line in \
  '"com.tencent.inputmethod.wetype.pinyin"' \
  'private static let p95LimitMilliseconds = 100.0' \
  'private static let maximumLimitMilliseconds = 250.0' \
  'private static let burstLimitMilliseconds = 1000.0' \
  'private static let durableLimitMilliseconds = 1500.0' \
  '25.0' \
  'installRealisticWorkloadIfRequested(on: store)' \
  'premature_persist_count=' \
  'durable_readback_match=' \
  'self != .providerAPIKey'; do
  if ! grep -Fq "$contract_line" "$automation"; then
    fail "automation contract is missing: $contract_line"
  fi
done

implementation_contracts=(
  'App/NoonmarkMacApp/NoonmarkStore.swift:let reviewAutosaveStatus = ReviewAutosaveStatus()'
  'App/NoonmarkMacApp/ReviewRail.swift:ReviewSavedStatusView(status: store.reviewAutosaveStatus)'
  'App/NoonmarkMacApp/NoonmarkQuickEntryWindowController.swift:guard contentHeight != nextContentHeight else { return }'
  'App/NoonmarkMacApp/IMECompositionIsolatedTextField.swift:private var buffer: IMETextBindingBuffer'
  'App/NoonmarkMacApp/IMECompositionIsolatedTextField.swift:buffer.takeImmediatePublication()'
  'App/NoonmarkMacApp/TencentIMEInputSurfaceMatrixE2EAutomation.swift:try await activate(focusedWindow)'
  'App/NoonmarkMacApp/TencentIMEInputSurfaceMatrixE2EAutomation.swift:consecutiveReadySamples >= 3'
  'App/NoonmarkMacApp/TencentIMEInputSurfaceMatrixE2EAutomation.swift:isActivationInterruption(error)'
  'Sources/NoonmarkMacRuntime/IMETextBindingBuffer.swift:public static let defaultIdleDelayMilliseconds: UInt64 = 200'
  'Sources/NoonmarkMacRuntime/OrderedEngineMutationLane.swift:qos: .utility'
)
for contract in "${implementation_contracts[@]}"; do
  source="${contract%%:*}"
  contract_line="${contract#*:}"
  if ! grep -Fq "$contract_line" "$source"; then
    fail "input isolation contract is missing: $contract_line"
  fi
done
if grep -Fq \
    '@Published var reviewAutosaveMessage' \
    App/NoonmarkMacApp/NoonmarkStore.swift; then
  fail "review autosave status must not invalidate the global store"
fi

inline_draft_card="App/NoonmarkMacApp/ZhulongInlineTaskDraftCard.swift"
inline_isolated_field_count="$(
  grep -Fc 'IMECompositionIsolatedTextField(' "$inline_draft_card"
)"
if [[ "$inline_isolated_field_count" != "5" ]]; then
  fail \
    "expected five IME-isolated Zhulong inline fields, found $inline_isolated_field_count"
fi
if grep -Eq '^[[:space:]]*TextField\(' "$inline_draft_card"; then
  fail "Zhulong inline draft must not bind SwiftUI TextField directly"
fi

required_sources=(
  Sources/NoonmarkMacRuntime/IMETextBindingBuffer.swift
  Sources/NoonmarkMacRuntime/IMETextDraftAutosaveGate.swift
  Sources/NoonmarkMacRuntime/InputDraftFlushCoordinator.swift
  Sources/NoonmarkMacRuntime/OrderedEngineMutationLane.swift
  Sources/NoonmarkZhulong/ZhulongDraftPersistenceLane.swift
  Tests/NoonmarkMacRuntimeTests/IMETextBindingBufferTests.swift
  Tests/NoonmarkMacRuntimeTests/IMETextDraftAutosaveGateTests.swift
  Tests/NoonmarkMacRuntimeTests/InputDraftFlushCoordinatorTests.swift
  Tests/NoonmarkMacRuntimeTests/OrderedEngineMutationLaneTests.swift
  Tests/NoonmarkZhulongTests/ZhulongDraftPersistenceLaneTests.swift
)
for source in "${required_sources[@]}"; do
  if [[ ! -s "$source" ]]; then
    fail "required implementation or regression test is missing: $source"
  fi
done

echo \
  "Tencent IME input contract: ok ($surface_count surfaces, $termination_surface_count immediate-exit probes)"
