        layout_forward = self.evaluate(
            "(() => new Promise((resolve)=>{window.addEventListener('popstate',()=>setTimeout(()=>resolve(document.querySelector('.mac-window').dataset.variant),50),{once:true});history.forward();}))()"
        )
        self.check(
            "browser-history-can-revisit-layouts-without-changing-session-or-user-preference",
            layout_back == "A"
            and layout_forward == "B"
            and self.snapshot() == history_snapshot
            and self.evaluate("localStorage.getItem('noonmark.zhulong.stream-layout')") == history_preference,
            json.dumps({"back": layout_back, "forward": layout_forward, "preference": history_preference}, sort_keys=True),
        )

        self.navigate("variant=C&scenario=corrected&role-case=history-boundary")
        history_boundary_roles = self.evaluate(
