refresh_install_manifest_binding() {
  local relative_path="$1"
  local inventory_sha256

  refresh_inventory_record "$install_inventory" "$relative_path"
  inventory_sha256="$(shasum -a 256 "$install_inventory" | awk '{print $1}')"
  sed -i '' \
    "s/^artifact_inventory_sha256=.*/artifact_inventory_sha256=${inventory_sha256}/" \
    "$install_manifest"
}

refresh_install_manifest_artifact_binding() {
  local relative_path="$1"
  local manifest_key="$2"
  local artifact_path="$fixture_root/$relative_path"
  local artifact_sha256

  refresh_install_manifest_binding "$relative_path"
  artifact_sha256="$(shasum -a 256 "$artifact_path" | awk '{print $1}')"
  sed -i '' \
    "s/^${manifest_key}=.*/${manifest_key}=${artifact_sha256}/" \
    "$install_manifest"
}

