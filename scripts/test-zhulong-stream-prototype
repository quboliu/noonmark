                "const target=nodes[Math.min(2,nodes.length-1)];const box=scroller.getBoundingClientRect();"
                "scroller.style.scrollBehavior='auto';scroller.scrollTop+=target.getBoundingClientRect().top-box.top;"
                "window.__layoutScroller=scroller;const settled=target.getBoundingClientRect();"
