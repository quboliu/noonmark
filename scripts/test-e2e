run_copy_undo_persistence_probe() {
  local copy_undo_dir="artifacts/e2e-copy-undo-persistence"
  local copy_undo_db="${copy_undo_dir}/Noonmark.sqlite"
  local copy_undo_state="${copy_undo_dir}/state.json"
  local setup_result="${copy_undo_dir}/setup-result.txt"
  local verify_result="${copy_undo_dir}/verify-result.txt"
  local setup_log="${copy_undo_dir}/setup.log"
  local verify_log="${copy_undo_dir}/verify.log"
  local sql_probe

  rm -rf "$copy_undo_dir"
  mkdir -p "$copy_undo_dir"

  run_terminating_ui_probe \
    "classified copy undo persistence setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$copy_undo_db" \
    --page day \
    --e2e-copy-undo-persistence-setup \
    --e2e-copy-undo-persistence-state-url "$PWD/$copy_undo_state" \
    --e2e-copy-undo-persistence-result-url "$PWD/$setup_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "classified copy undo persistence restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$copy_undo_db" \
    --page pool \
    --e2e-copy-undo-persistence-verify \
    --e2e-copy-undo-persistence-state-url "$PWD/$copy_undo_state" \
    --e2e-copy-undo-persistence-result-url "$PWD/$verify_result" \
    --e2e-quit-after-automation

  sql_probe="$(sqlite3 -noheader -separator ' ' "$copy_undo_db" "
    WITH copied AS (
      SELECT chain.id
      FROM task_chains AS chain
      JOIN task_definitions AS definition ON definition.chain_id = chain.id
      WHERE definition.title = 'E2E 持久化已分类复制来源'
        AND chain.state = 'abandoned'
        AND NOT EXISTS (
          SELECT 1 FROM day_traces AS trace WHERE trace.chain_id = chain.id
        )
    )
    SELECT
      (SELECT count(*) FROM copied),
      (SELECT count(*) FROM task_chain_categories WHERE chain_id IN copied),
      (SELECT count(*) FROM task_chain_label_relations WHERE chain_id IN copied),
      (SELECT count(*) FROM classification_relation_history WHERE chain_id IN copied),
      (SELECT count(*) FROM classification_change_records
       WHERE source_kind = 'inherited' AND source_from_chain_id IS NOT NULL),
      (SELECT count(*) FROM classification_change_records
       WHERE source_kind = 'deterministicDomainAction'
         AND source_reason = 'task removed from task pool while preserving classification history'
         AND decision_id IS NULL),
      (SELECT count(*) FROM change_journal WHERE entity_type = 'classificationCommit');
  ")"
  if [[ "$sql_probe" != "1 0 0 2 1 1 3" ]]; then
    echo "classified copy undo SQLite/sync probe failed: ${sql_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E classified copy undo SQLite restart: $copy_undo_db (probe=$sql_probe)"
}

run_lifecycle_persistence_probe() {
  local lifecycle_dir="artifacts/e2e-lifecycle"
  local lifecycle_db="${lifecycle_dir}/Noonmark.sqlite"
  local setup_result="${lifecycle_dir}/setup-result.txt"
  local restart_result="${lifecycle_dir}/restart-result.txt"
  local setup_log="${lifecycle_dir}/setup.log"
  local restart_log="${lifecycle_dir}/restart.log"
  local lifecycle_probe

  rm -rf "$lifecycle_dir"
  mkdir -p "$lifecycle_dir"

  run_terminating_ui_probe \
    "lifecycle persistence setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$lifecycle_db" \
    --page day \
    --e2e-lifecycle-workflow \
    --e2e-lifecycle-result-url "$PWD/$setup_result" \
    --e2e-quit-after-automation

  run_terminating_ui_probe \
    "lifecycle persistence restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$lifecycle_db" \
    --page unfinished \
    --e2e-lifecycle-restart-verify \
    --e2e-lifecycle-result-url "$PWD/$restart_result" \
    --e2e-quit-after-automation

  lifecycle_probe="$(sqlite3 -noheader -separator ' ' "$lifecycle_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更旧任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'changed'
         AND day_traces.changed_to_trace_id IS NOT NULL),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更新任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 回池任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'returnedToPool'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'
         AND day_traces.settled_at IS NULL
         AND task_chains.state = 'active'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.status = 'abandoned'
         AND task_chains.state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 废弃任务'),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND record_payload IS NOT NULL
         AND length(record_payload) > 0);
  ")"
  if [[ "$lifecycle_probe" != "1 1 1 1 0 1 1" ]]; then
    echo "lifecycle E2E SQLite/restart probe failed: ${lifecycle_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E lifecycle SQLite restart: $lifecycle_db (probe=$lifecycle_probe)"
}

run_terminating_ui_probe() {
  local label="$1"
  local result="$2"
  local log="$3"
  local pid
  shift 3

  rm -f "$result"
  if [[ "${NOONMARK_E2E_LAUNCH_WITH_OPEN:-0}" == "1" ]]; then
    /usr/bin/open -W -n "$app_path" --args "$@" >"$log" 2>&1 &
  else
    "$app_executable_path" "$@" >"$log" 2>&1 &
  fi
  pid=$!

  for _ in {1..400}; do
    if [[ -f "$result" ]] || ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done

  if [[ ! -f "$result" ]]; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label result was not created: $result" >&2
    cat "$log" >&2
    exit 1
  fi
  if [[ "$(<"$result")" != "ok" ]]; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label failed: $(<"$result")" >&2
    cat "$log" >&2
    exit 1
  fi

  for _ in {1..40}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$pid" 2>/dev/null || true
    echo "$label wrote ok but did not terminate" >&2
    cat "$log" >&2
    exit 1
  fi
  if ! wait "$pid"; then
    echo "$label app process failed" >&2
    cat "$log" >&2
    exit 1
  fi
  assert_clean_app_log "$label" "$log"
}

if [[ "${NOONMARK_E2E_UI_ENTRY_ONLY:-0}" == "1" ]]; then
