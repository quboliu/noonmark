#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "missing required tool: sqlite3" >&2
  exit 1
fi

app_bundle_name="${NOONMARK_E2E_APP_BUNDLE_NAME:-NoonmarkMacAppE2E}"
app_executable_name="${NOONMARK_E2E_APP_EXECUTABLE_NAME:-$app_bundle_name}"
app_bundle_identifier="${NOONMARK_E2E_BUNDLE_IDENTIFIER:-app.noonmark.mac.e2e}"
app_display_name="${NOONMARK_E2E_APP_DISPLAY_NAME:-晷迹 E2E}"
app_short_name="${NOONMARK_E2E_APP_SHORT_NAME:-Noonmark E2E}"
app_path="dist/${app_bundle_name}.app"
app_executable_path="${app_path}/Contents/MacOS/${app_executable_name}"
export NOONMARK_E2E_APP_EXECUTABLE_NAME="$app_executable_name"
export NOONMARK_E2E_APP_DISPLAY_NAME="$app_display_name"

scenarios=(
  "day|day|"
  "day-subtasks-expanded|day|--e2e-expand-first-subtask-trace"
  "day-changed-target|day|--select changed"
  "day-detail|day|--select first"
  "day-manual-detail|day|--select manual"
  "day-review-saved|day|--e2e-update-review --e2e-review-summary E2E自动保存反馈"
  "pool|pool|"
  "pool-classification-overflow|pool|--e2e-open-first-classification-overflow"
  "pool-classification-manager|pool|--select first --e2e-open-classification-manager"
  "pool-classification-manager-labels|pool|--select first --e2e-open-classification-manager --e2e-classification-manager-labels"
  "pool-detail|pool|--select first"
  "pool-detail-classification-edit|pool|--select first --e2e-open-classification-label-editor"
  "future|future|"
  "future-detail|future|--select first"
  "unfinished|unfinished|"
  "unfinished-detail|unfinished|--select first"
  "completed|completed|"
  "completed-detail|completed|--select first"
  "calendar|calendar|"
  "zhulong|zhulong|--e2e-enable-zhulong"
  "zhulong-stream-a|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-variant A"
  "zhulong-stream-b|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-variant B"
  "zhulong-stream-c|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-variant C"
  "zhulong-authorized|zhulong|--e2e-zhulong-sidecar-key --e2e-generate-zhulong-draft dailyReview --e2e-zhulong-variant C"
  "zhulong-todo-diff-editor|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-todo-diff --e2e-open-zhulong-todo-diff-editor --e2e-zhulong-variant C"
  "settings|settings|"
  "settings-groups|settings|--e2e-settings-groups"
)

requested_scenarios="${NOONMARK_E2E_SCENARIOS:-}"
if [[ -n "$requested_scenarios" ]]; then
  filtered_scenarios=()
  for requested in $requested_scenarios; do
    found=0
    for scenario in "${scenarios[@]}"; do
      IFS="|" read -r screenshot_name _ <<< "$scenario"
      if [[ "$screenshot_name" == "$requested" ]]; then
        filtered_scenarios+=("$scenario")
        found=1
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      echo "unknown E2E screenshot scenario: $requested" >&2
      exit 1
    fi
  done
  scenarios=("${filtered_scenarios[@]}")
fi

NOONMARK_APP_BUNDLE_NAME="$app_bundle_name" \
  NOONMARK_APP_EXECUTABLE_NAME="$app_executable_name" \
  NOONMARK_BUNDLE_IDENTIFIER="$app_bundle_identifier" \
  NOONMARK_APP_DISPLAY_NAME="$app_display_name" \
  NOONMARK_APP_SHORT_NAME="$app_short_name" \
  scripts/build-mac-app "$configuration"

mkdir -p artifacts/e2e

terminate_e2e_app() {
  pkill -x "$app_executable_name" 2>/dev/null || true
  for _ in {1..40}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    pkill -9 -x "$app_executable_name" 2>/dev/null || true
  fi
  for _ in {1..20}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    echo "failed to terminate ${app_executable_name}" >&2
    return 1
  fi
  for _ in {1..30}; do
    if ! has_e2e_windows; then
      return 0
    fi
    sleep 0.1
  done
  echo "failed to close visible ${app_display_name} windows" >&2
  return 1
}

visible_e2e_windows() {
  swift -e '
import CoreGraphics
import Foundation

let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner == expectedOwner || owner == expectedDisplayName {
            print("window owner=\(owner) title=\(name)")
        }
    }
}
'
}

has_e2e_windows() {
  [[ -n "$(visible_e2e_windows)" ]]
}

terminate_e2e_app
trap 'terminate_e2e_app >/dev/null 2>&1 || true' EXIT

find_window_id() {
  local expected_title="$1"
  NOONMARK_E2E_EXPECTED_WINDOW_TITLE="$expected_title" swift -e '
import CoreGraphics
import Darwin
import Foundation

let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"
let expectedTitle = ProcessInfo.processInfo.environment["NOONMARK_E2E_EXPECTED_WINDOW_TITLE"] ?? "晷迹 · Day Todo — 7月5日"

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        var allowedOwners = [expectedOwner, expectedDisplayName]
        if expectedOwner == "NoonmarkMacApp" {
            allowedOwners.append(contentsOf: ["晷迹", "Noonmark", "NoonmarkMacApp"])
        }
        if allowedOwners.contains(owner) && name == expectedTitle {
            let layer = window[kCGWindowLayer as String] as? Int ?? -1
            let bounds = window[kCGWindowBounds as String] as? [String: Any]
            let width = bounds?["Width"] as? Double ?? 0
            let height = bounds?["Height"] as? Double ?? 0
            if layer == 0, width >= 1180, height >= 760,
               let number = window[kCGWindowNumber as String]
            {
                print(number)
                exit(0)
            }
        }
    }
}
exit(1)
'
}

find_auxiliary_window_id() {
  local window_id="$1"
  NOONMARK_E2E_WINDOW_ID="$window_id" swift -e '
import CoreGraphics
import Foundation

let expectedID = Int(ProcessInfo.processInfo.environment["NOONMARK_E2E_WINDOW_ID"] ?? "") ?? -1
let expectedOwner = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_EXECUTABLE_NAME"] ?? "NoonmarkMacAppE2E"
let expectedDisplayName = ProcessInfo.processInfo.environment["NOONMARK_E2E_APP_DISPLAY_NAME"] ?? "晷迹 E2E"

guard let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]],
      let main = list.first(where: { ($0[kCGWindowNumber as String] as? Int) == expectedID }),
      let mainBounds = main[kCGWindowBounds as String] as? [String: Any],
      let mainX = mainBounds["X"] as? Double,
      let mainY = mainBounds["Y"] as? Double,
      let mainWidth = mainBounds["Width"] as? Double,
      let mainHeight = mainBounds["Height"] as? Double
else {
    exit(1)
}

var best: (id: Int, area: Double)?
for window in list {
    guard let number = window[kCGWindowNumber as String] as? Int,
          number != expectedID,
          let owner = window[kCGWindowOwnerName as String] as? String,
          owner == expectedOwner || owner == expectedDisplayName,
          (window[kCGWindowLayer as String] as? Int ?? -1) == 0,
          let bounds = window[kCGWindowBounds as String] as? [String: Any],
          let x = bounds["X"] as? Double,
          let y = bounds["Y"] as? Double,
          let width = bounds["Width"] as? Double,
          let height = bounds["Height"] as? Double,
          width >= 100,
          height >= 80,
          width < mainWidth,
          height < mainHeight,
          x < mainX + mainWidth,
          x + width > mainX,
          y < mainY + mainHeight,
          y + height > mainY
    else { continue }
    let area = width * height
    if best == nil || area > best!.area {
        best = (number, area)
    }
}
if let best {
    print(best.id)
    exit(0)
}
exit(1)
'
}

dump_visible_windows() {
  swift -e '
import CoreGraphics
import Foundation

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner.contains("Noonmark") || owner.contains("晷迹") || name.contains("晷迹") {
            print("window owner=\(owner) title=\(name)")
        }
    }
}
'
}

capture_app_screenshot() {
  local out_dir="$1"
  local screenshot_name="$2"
  local page="$3"
  local expected_window_title
  shift 3

  case "$page" in
    day)
      if [[ "$screenshot_name" == "day-changed-target" ]]; then
        expected_window_title="晷迹 · Day Todo — 7月4日"
      else
        expected_window_title="晷迹 · Day Todo — 7月5日"
      fi
      ;;
    pool) expected_window_title="晷迹 · 任务池" ;;
    future) expected_window_title="晷迹 · 未来计划" ;;
    unfinished) expected_window_title="晷迹 · 未完成" ;;
    completed) expected_window_title="晷迹 · 已完成" ;;
    calendar) expected_window_title="晷迹 · 日历 — 7月5日" ;;
    zhulong) expected_window_title="晷迹 · 烛龙" ;;
    settings) expected_window_title="晷迹 · 设置" ;;
    *) expected_window_title="晷迹 · Noonmark" ;;
  esac

  window_id=""
  for launch_attempt in {1..3}; do
    terminate_e2e_app
    "$app_executable_path" "$@" --page "$page" >/dev/null 2>&1 &
    disown "$!" 2>/dev/null || true
    sleep "${NOONMARK_E2E_STARTUP_WAIT:-3}"

    for _ in {1..20}; do
      if window_id="$(find_window_id "$expected_window_title" 2>/dev/null)"; then
        break
      fi
      sleep 0.25
    done

    if [[ -n "$window_id" ]]; then
      break
    fi
    terminate_e2e_app
    sleep 0.5
  done

  if [[ -z "$window_id" ]]; then
    echo "Noonmark app window not found for ${page}" >&2
    dump_visible_windows >&2
    exit 1
  fi

  mkdir -p "$out_dir"
  screenshot="${out_dir}/${screenshot_name}.png"
  if [[ "$screenshot_name" == "pool-classification-overflow" ]]; then
    auxiliary_window_id=""
    for _ in {1..20}; do
      if auxiliary_window_id="$(find_auxiliary_window_id "$window_id" 2>/dev/null)"; then
        break
      fi
      sleep 0.1
    done
    if [[ -z "$auxiliary_window_id" ]]; then
      echo "classification overflow popover window not found" >&2
      dump_visible_windows >&2
      exit 1
    fi
    screencapture -x -l "$auxiliary_window_id" "$screenshot"
  else
    warmup_screenshot="${screenshot}.warmup.png"
    screencapture -x -l "$window_id" "$warmup_screenshot"
    sleep 0.25
    screencapture -x -l "$window_id" "$screenshot"
    rm -f "$warmup_screenshot"
  fi
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"

  if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 || "${width:-0}" -gt 3000 || "${height:-0}" -gt 2000 ]]; then
    echo "invalid e2e screenshot size for ${screenshot_name}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  echo "E2E ${screenshot_name} screenshot: ${screenshot} (${width}x${height})"
}

for scenario in "${scenarios[@]}"; do
  IFS="|" read -r screenshot_name page extra_args <<< "$scenario"
  if [[ -n "$extra_args" ]]; then
    # shellcheck disable=SC2086
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral --e2e-reset-selection $extra_args
  else
    capture_app_screenshot artifacts/e2e "$screenshot_name" "$page" --ephemeral --e2e-reset-selection
  fi
done

if [[ "${NOONMARK_E2E_SCREENSHOTS_ONLY:-0}" == "1" ]]; then
  terminate_e2e_app
  echo "E2E screenshot-only scenarios: ${NOONMARK_E2E_SCENARIOS:-all}"
  exit 0
fi

terminate_e2e_app

summary_sidebar_dir="artifacts/e2e-summary-sidebar"
summary_sidebar_result="${summary_sidebar_dir}/summary-sidebar-result.txt"
rm -rf "$summary_sidebar_dir"
mkdir -p "$summary_sidebar_dir"

"$app_executable_path" \
  --ephemeral \
  --page pool \
  --e2e-summary-sidebar-probe \
  --e2e-summary-sidebar-result-url "$PWD/$summary_sidebar_result" \
  --e2e-quit-after-automation

if [[ ! -f "$summary_sidebar_result" ]]; then
  echo "summary sidebar result was not created: $summary_sidebar_result" >&2
  exit 1
fi

if [[ "$(cat "$summary_sidebar_result")" != "ok" ]]; then
  echo "summary sidebar probe failed: $(cat "$summary_sidebar_result")" >&2
  exit 1
fi

echo "E2E summary sidebar and calendar insight: $summary_sidebar_result"

blank_dir="artifacts/e2e-blank"
blank_db="${blank_dir}/Noonmark.sqlite"
blank_pages=(day pool future unfinished completed calendar zhulong)
rm -rf "$blank_dir"
mkdir -p "$blank_dir"

for page in "${blank_pages[@]}"; do
  if [[ "$page" == "zhulong" ]]; then
    capture_app_screenshot "$blank_dir" "$page" "$page" --data-url "$PWD/$blank_db" --e2e-reset-selection --e2e-enable-zhulong
  else
    capture_app_screenshot "$blank_dir" "$page" "$page" --data-url "$PWD/$blank_db" --e2e-reset-selection
  fi
done

terminate_e2e_app

read -r blank_days blank_chains blank_definitions blank_traces blank_subtasks blank_preferences < <(
  sqlite3 -separator " " "$blank_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$blank_days" -ne 0 || "$blank_chains" -ne 0 || "$blank_definitions" -ne 0 || "$blank_traces" -ne 0 || "$blank_subtasks" -ne 0 || "$blank_preferences" -ne 1 ]]; then
  echo "invalid blank user counts after page screenshots: days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences" >&2
  exit 1
fi

echo "E2E blank user screenshots: $blank_dir (days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences)"

persistence_dir="artifacts/e2e-persistence"
persistence_db="${persistence_dir}/Noonmark.sqlite"
rm -rf "$persistence_dir"
mkdir -p "$persistence_dir"

"$app_executable_path" --data-url "$PWD/$persistence_db" --e2e-reset-selection --page day >/dev/null 2>&1 &
disown "$!" 2>/dev/null || true
sleep "${NOONMARK_E2E_STARTUP_WAIT:-3}"
terminate_e2e_app

if [[ ! -f "$persistence_db" ]]; then
  echo "persistence database was not created: $persistence_db" >&2
  exit 1
fi

read -r days chains definitions traces subtasks preferences < <(
  sqlite3 -separator " " "$persistence_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$days" -ne 0 || "$chains" -ne 0 || "$definitions" -ne 0 || "$traces" -ne 0 || "$subtasks" -ne 0 || "$preferences" -ne 1 ]]; then
  echo "invalid persistence counts: days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences" >&2
  exit 1
fi

echo "E2E blank persistence database: $persistence_db (days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences)"

classification_dir="artifacts/e2e-classification"
classification_db="${classification_dir}/Noonmark.sqlite"
classification_edit_result="${classification_dir}/edit-result.txt"
classification_restart_result="${classification_dir}/restart-result.txt"
classification_title="E2E 分类持久化"
rm -rf "$classification_dir"
mkdir -p "$classification_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$classification_db" \
  --page pool \
  --e2e-classification-edit \
  --e2e-classification-title "$classification_title" \
  --e2e-classification-result-url "$PWD/$classification_edit_result" \
  --e2e-quit-after-automation

if [[ ! -f "$classification_edit_result" ]]; then
  echo "classification edit automation failed: missing result" >&2
  exit 1
fi
if [[ "$(<"$classification_edit_result")" != "ok" ]]; then
  echo "classification edit automation failed: $(<"$classification_edit_result")" >&2
  exit 1
fi

capture_app_screenshot \
  "$classification_dir" \
  "classification-restart" \
  pool \
  --data-url "$PWD/$classification_db" \
  --e2e-classification-verify \
  --e2e-classification-title "$classification_title" \
  --e2e-classification-result-url "$PWD/$classification_restart_result"

if [[ ! -f "$classification_restart_result" ]]; then
  echo "classification restart automation failed: missing result" >&2
  terminate_e2e_app
  exit 1
fi
if [[ "$(<"$classification_restart_result")" != "ok" ]]; then
  echo "classification restart automation failed: $(<"$classification_restart_result")" >&2
  terminate_e2e_app
  exit 1
fi
terminate_e2e_app

read -r \
  classification_category_count \
  classification_label_count \
  classification_expected_label_count \
  classification_metadata_count \
  classification_name_version_count \
  classification_revision \
  classification_record_count \
  classification_plan_digest_count \
  classification_integrity_digest_count \
  classification_record_finalization_count \
  classification_valid_after_count \
  classification_after_count \
  classification_commit_count \
  classification_receipt_count \
  classification_receipt_digest_count \
  classification_commit_finalization_count \
  classification_crosscheck_count < <(
  sqlite3 -separator " " "$classification_db" "
    WITH target AS (
      SELECT task_chains.id AS chain_id
      FROM task_chains
      JOIN task_definitions ON task_definitions.chain_id = task_chains.id
      WHERE task_definitions.title = '$classification_title'
        AND task_definitions.superseded_at IS NULL
      LIMIT 1
    ), target_category AS (
      SELECT relation.category_id AS item_id
      FROM task_chain_categories AS relation
      WHERE relation.chain_id = (SELECT chain_id FROM target)
    ), target_labels AS (
      SELECT relation.label_id AS item_id
      FROM task_chain_label_relations AS relation
      WHERE relation.chain_id = (SELECT chain_id FROM target)
    ), target_change AS (
      SELECT record.record_id
      FROM classification_change_records AS record
      JOIN classification_change_record_changes AS record_change
        ON record_change.record_id = record.record_id
      WHERE record_change.kind = 'setCurrent'
        AND record_change.chain_id = (SELECT chain_id FROM target)
    )
    SELECT
      (SELECT count(*)
       FROM target_category
       JOIN task_categories ON task_categories.id = target_category.item_id
       WHERE task_categories.name = '验证'),
      (SELECT count(*) FROM target_labels),
      (SELECT count(*)
       FROM target_labels
       JOIN task_labels ON task_labels.id = target_labels.item_id
       WHERE task_labels.name IN ('SQLite', '重启', '白盒')),
      (SELECT count(*)
       FROM classification_item_metadata AS metadata
       WHERE metadata.lifecycle = 'active'
         AND (
           (metadata.kind = 'category' AND metadata.item_id IN (SELECT item_id FROM target_category))
           OR (metadata.kind = 'label' AND metadata.item_id IN (SELECT item_id FROM target_labels))
         )),
      (SELECT count(*)
       FROM classification_name_versions AS version
       WHERE (version.kind = 'category' AND version.item_id IN (SELECT item_id FROM target_category))
          OR (version.kind = 'label' AND version.item_id IN (SELECT item_id FROM target_labels))),
      (SELECT revision FROM classification_state WHERE id = 1),
      (SELECT count(*) FROM target_change),
      (SELECT count(*)
       FROM classification_change_record_plan_digests
       WHERE record_id = (SELECT record_id FROM target_change)
         AND length(digest) = 64),
      (SELECT count(*)
       FROM classification_change_record_integrity_digests
       WHERE record_id = (SELECT record_id FROM target_change)
         AND length(digest) = 64),
      (SELECT count(*)
       FROM classification_change_record_finalizations
       WHERE record_id = (SELECT record_id FROM target_change)
         AND change_count = 1
         AND notice_count = 0),
      (SELECT count(*)
       FROM classification_change_selection_items AS item
       WHERE item.record_id = (SELECT record_id FROM target_change)
         AND item.selection_side = 'after'
         AND item.resolution = 'new'
         AND (
           (item.item_kind = 'category' AND item.name = '验证')
           OR (item.item_kind = 'label' AND item.name IN ('SQLite', '重启', '白盒'))
         )),
      (SELECT count(*)
       FROM classification_change_selection_items AS item
       WHERE item.record_id = (SELECT record_id FROM target_change)
         AND item.selection_side = 'after'),
      (SELECT count(*) FROM classification_commits),
      (SELECT count(*) FROM classification_commit_receipt_metadata),
      (SELECT count(*)
       FROM classification_commit_receipt_integrity_digests AS digest
       JOIN classification_change_records AS record
         ON record.interaction_id = digest.interaction_id
       WHERE record.record_id = (SELECT record_id FROM target_change)
         AND length(digest.digest) = 64),
      (SELECT count(*)
       FROM classification_commit_finalizations AS finalization
       JOIN classification_change_records AS record
         ON record.interaction_id = finalization.interaction_id
       WHERE record.record_id = (SELECT record_id FROM target_change)
         AND finalization.notice_count = 0),
      (SELECT count(*)
       FROM classification_change_records AS record
       JOIN classification_change_record_changes AS record_change
         ON record_change.record_id = record.record_id
       JOIN classification_commits AS commit_record
         ON commit_record.interaction_id = record.interaction_id
        AND commit_record.plan_id = record.plan_id
        AND commit_record.revision = record.revision
       JOIN classification_commit_receipt_metadata AS receipt
         ON receipt.interaction_id = record.interaction_id
        AND receipt.change_record_id = record.record_id
        AND receipt.decision_id = record.decision_id
       WHERE record_change.kind = 'setCurrent'
         AND record_change.chain_id = (SELECT chain_id FROM target)
         AND record.source_kind = 'userDirect'
         AND record.decision_id IS NOT NULL);
  "
)

if [[ "$classification_category_count" -ne 1 \
  || "$classification_label_count" -ne 3 \
  || "$classification_expected_label_count" -ne 3 \
  || "$classification_metadata_count" -ne 4 \
  || "$classification_name_version_count" -ne 4 \
  || "$classification_revision" -ne 1 \
  || "$classification_record_count" -ne 1 \
  || "$classification_plan_digest_count" -ne 1 \
  || "$classification_integrity_digest_count" -ne 1 \
  || "$classification_record_finalization_count" -ne 1 \
  || "$classification_valid_after_count" -ne 4 \
  || "$classification_after_count" -ne 4 \
  || "$classification_commit_count" -ne 1 \
  || "$classification_receipt_count" -ne 1 \
  || "$classification_receipt_digest_count" -ne 1 \
  || "$classification_commit_finalization_count" -ne 1 \
  || "$classification_crosscheck_count" -ne 1 ]]; then
  echo "classification persistence probe failed: category=$classification_category_count labels=$classification_label_count expected_labels=$classification_expected_label_count metadata=$classification_metadata_count name_versions=$classification_name_version_count revision=$classification_revision records=$classification_record_count plan_digests=$classification_plan_digest_count integrity_digests=$classification_integrity_digest_count record_finalizations=$classification_record_finalization_count valid_after=$classification_valid_after_count after=$classification_after_count commits=$classification_commit_count receipts=$classification_receipt_count receipt_digests=$classification_receipt_digest_count commit_finalizations=$classification_commit_finalization_count crosscheck=$classification_crosscheck_count" >&2
  exit 1
fi

echo "E2E classification edit and restart: $classification_db (category=$classification_category_count labels=$classification_label_count revision=$classification_revision records=$classification_record_count crosscheck=$classification_crosscheck_count)"

interaction_dir="artifacts/e2e-interaction"
interaction_db="${interaction_dir}/Noonmark.sqlite"
interaction_title="E2E 快速新增任务"
rm -rf "$interaction_dir"
mkdir -p "$interaction_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$interaction_db" \
  --page day \
  --e2e-add-quick-task "$interaction_title" \
  --e2e-quit-after-automation

if [[ ! -f "$interaction_db" ]]; then
  echo "interaction database was not created: $interaction_db" >&2
  exit 1
fi

read -r interaction_definitions interaction_traces < <(
  sqlite3 -separator " " "$interaction_db" "
    SELECT
      (SELECT count(*)
       FROM task_definitions
       WHERE title = '$interaction_title'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$interaction_title'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending');
  "
)

if [[ "$interaction_definitions" -ne 1 || "$interaction_traces" -ne 1 ]]; then
  echo "quick-add interaction failed: definitions=$interaction_definitions traces=$interaction_traces" >&2
  exit 1
fi

echo "E2E quick-add app interaction: $interaction_db (title=$interaction_title definitions=$interaction_definitions traces=$interaction_traces)"

