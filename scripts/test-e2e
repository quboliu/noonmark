run_pool_context_menu_action_probe() {
  local action_dir="artifacts/e2e-pool-context-menu-action"
  local action_db="$action_dir/Noonmark.sqlite"
  local action_result="$action_dir/result.txt"
  local action_chain="$action_dir/chain.txt"
  local action_log="$action_dir/app.log"
  local chain_id
  local persisted

  rm -rf "$action_dir"
  mkdir -p "$action_dir"
  run_terminating_ui_probe \
    "pool context-menu schedule action" \
    "$action_result" \
    "$action_log" \
    --data-url "$PWD/$action_db" \
    --page pool \
    --e2e-pool-context-menu-action-result-url "$PWD/$action_result" \
    --e2e-pool-context-menu-action-chain-url "$PWD/$action_chain"

  chain_id="$(<"$action_chain")"
  persisted="$(sqlite3 -noheader "$action_db" "
    SELECT count(*)
    FROM day_traces
    WHERE chain_id = '$chain_id'
      AND status = 'pending';
  ")"
  if [[ "$persisted" != "1" ]]; then
    echo "pool context-menu schedule persistence failed: ${persisted:-missing}" >&2
    exit 1
  fi
  echo "E2E pool context-menu schedule and persistence: $action_db"
}

run_unfinished_action_probe() {
  local action_dir="artifacts/e2e-unfinished-actions"
  local action_db="$action_dir/Noonmark.sqlite"
  local exercise_result="$action_dir/exercise-result.txt"
  local exercise_log="$action_dir/exercise.log"
  local restart_result="$action_dir/restart-result.txt"
  local restart_log="$action_dir/restart.log"
  local persisted

  rm -rf "$action_dir"
  mkdir -p "$action_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "unfinished row/detail abandon actions" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$action_db" \
    --page unfinished \
    --e2e-reset-selection \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-unfinished-action-exercise \
    --e2e-unfinished-action-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "unfinished action restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$action_db" \
    --page unfinished \
    --e2e-reset-selection \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-unfinished-action-restart \
    --e2e-unfinished-action-result-url "$PWD/$restart_result"

  persisted="$(sqlite3 -noheader -separator ' ' "$action_db" "
    WITH targets AS (
      SELECT chain.id AS chain_id
      FROM task_chains AS chain
      JOIN task_definitions AS definition
        ON definition.chain_id = chain.id
       AND definition.superseded_at IS NULL
      WHERE definition.title IN (
        'E2E 已延续列表废弃',
        'E2E 已延续详情废弃'
      )
    )
    SELECT
      (SELECT count(*)
       FROM task_chains
       WHERE id IN (SELECT chain_id FROM targets)
         AND state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       WHERE chain_id IN (SELECT chain_id FROM targets)
         AND status = 'continued'),
      (SELECT count(*)
       FROM day_traces
       WHERE chain_id IN (SELECT chain_id FROM targets)
         AND status = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       WHERE chain_id IN (SELECT chain_id FROM targets)
         AND status = 'pending');
  ")"
  if [[ "$persisted" != "2 2 2 0" ]]; then
    echo "unfinished action SQLite/restart probe failed: ${persisted:-missing}" >&2
    exit 1
  fi

  echo "E2E unfinished row/detail actions and restart: $action_db (probe=$persisted)"
}

