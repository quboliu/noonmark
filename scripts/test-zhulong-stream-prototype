        self.evaluate(
            "(() => {const query=new URLSearchParams(location.search);query.set('variant','B');"
            "history.pushState({},'',location.pathname+'?'+query.toString());window.dispatchEvent(new PopStateEvent('popstate'));})()"
        )
        self.wait_for("Boolean(document.querySelector('[data-variant-view=\"B\"]'))", "history-pushed layout B")
        layout_back = self.evaluate(
