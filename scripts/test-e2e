run_native_command_surface_probe() {
  local command_dir="artifacts/e2e-native-command-surface"
  local command_db="$command_dir/Noonmark.sqlite"
  local state_file="$command_dir/state.json"
  local help_shortcut_result="$command_dir/help-shortcut-result.txt"
  local help_shortcut_log="$command_dir/help-shortcut.log"
  local exercise_result="$command_dir/exercise-result.txt"
  local exercise_log="$command_dir/exercise.log"
  local verify_result="$command_dir/verify-result.txt"
  local verify_log="$command_dir/verify.log"
  local sqlite_probe

  rm -rf "$command_dir"
  mkdir -p "$command_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "native Help shortcut" \
    "$help_shortcut_result" \
    "$help_shortcut_log" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-help-shortcut \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$help_shortcut_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "native command surface exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-surface-exercise \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "native command surface restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-surface-verify \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$verify_result"

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$command_db" "
    SELECT
      count(*),
      count(DISTINCT trace.id),
      count(DISTINCT definition.chain_id)
    FROM day_traces AS trace
    JOIN task_definitions AS definition ON definition.id = trace.definition_id
    JOIN task_chains AS chain ON chain.id = trace.chain_id
    WHERE definition.title = 'commandrecoverytask'
      AND definition.superseded_at IS NULL
      AND trace.date = '2026-07-05'
      AND trace.status = 'pending'
      AND chain.state = 'active';
  ")"
  if [[ "$sqlite_probe" != "1 1 1" ]]; then
    echo "native command surface SQLite restart probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E native menus, Settings, Quick Entry, Search, Undo/Redo restart: $command_db (probe=$sqlite_probe)"
}

run_completion_control_probe() {
  local completion_dir="artifacts/e2e-completion-control"
  local completion_db="$completion_dir/Noonmark.sqlite"
  local state_file="$completion_dir/state.json"
  local exercise_result="$completion_dir/exercise-result.txt"
  local exercise_log="$completion_dir/exercise.log"
  local verify_result="$completion_dir/verify-result.txt"
  local verify_log="$completion_dir/verify.log"
  local sqlite_probe

  rm -rf "$completion_dir"
  mkdir -p "$completion_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "parent completion control exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$completion_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-reset-selection \
    --e2e-completion-control-exercise \
    --e2e-completion-control-state-url "$PWD/$state_file" \
    --e2e-completion-control-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "parent completion control restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$completion_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-reset-selection \
    --e2e-completion-control-verify \
    --e2e-completion-control-state-url "$PWD/$state_file" \
    --e2e-completion-control-result-url "$PWD/$verify_result"

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$completion_db" "
    SELECT
      count(DISTINCT trace.id),
      count(DISTINCT subtask.id),
      count(*)
    FROM day_traces AS trace
    JOIN task_definitions AS definition ON definition.id = trace.definition_id
    JOIN subtasks AS subtask ON subtask.trace_id = trace.id
    WHERE definition.title = 'E2E parent completion control'
      AND trace.date = '2026-07-05'
      AND trace.status = 'pending'
      AND trace.completed_at IS NULL
      AND subtask.title = 'E2E final open subtask'
      AND subtask.status = 'completed'
      AND subtask.completed_at IS NOT NULL;
  ")"
  if [[ "$sqlite_probe" != "1 1 1" ]]; then
    echo "parent completion control SQLite restart probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E parent completion gate, AX labels, undo, and restart: $completion_db (probe=$sqlite_probe)"
}

run_workspace_productivity_probe() {
  local productivity_dir="artifacts/e2e-workspace-productivity"
  local productivity_db="$productivity_dir/Noonmark.sqlite"
  local state_file="$productivity_dir/state.json"
  local exercise_result="$productivity_dir/exercise-result.txt"
  local exercise_log="$productivity_dir/exercise.log"
  local verify_result="$productivity_dir/verify-result.txt"
  local verify_log="$productivity_dir/verify.log"
  local persisted_order
  local sqlite_probe
  local completion_capability_probe

  rm -rf "$productivity_dir"
  mkdir -p "$productivity_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "workspace productivity exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$productivity_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-reset-selection \
    --e2e-persistence-failure-automation \
    --e2e-workspace-productivity-exercise \
    --e2e-workspace-productivity-state-url "$PWD/$state_file" \
    --e2e-workspace-productivity-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "workspace productivity restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$productivity_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale zh_Hans_SG \
    --e2e-reset-selection \
    --e2e-workspace-productivity-verify \
    --e2e-workspace-productivity-state-url "$PWD/$state_file" \
    --e2e-workspace-productivity-result-url "$PWD/$verify_result"

  persisted_order="$(sqlite3 -noheader "$productivity_db" "
    SELECT group_concat(title, '|')
    FROM (
      SELECT definition.title AS title
      FROM day_traces AS trace
      JOIN task_definitions AS definition ON definition.id = trace.definition_id
      WHERE trace.date = '2026-07-05'
        AND definition.title LIKE 'E2E workspace drag %'
      ORDER BY trace.priority
    );
  ")"
  if [[ "$persisted_order" != "E2E workspace drag D|E2E workspace drag A|E2E workspace drag B|E2E workspace drag C" ]]; then
    echo "workspace drag SQLite order probe failed: ${persisted_order:-missing}" >&2
    exit 1
  fi

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$productivity_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       WHERE trace.date = '2026-07-05'
         AND trace.status = 'completed'
         AND definition.title LIKE 'E2E workspace drag %'),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       WHERE trace.date = '2026-07-05'
         AND trace.status = 'pending'
         AND definition.title LIKE 'E2E workspace pool %'),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       WHERE trace.status = 'cancelledDraft'
         AND definition.title LIKE 'E2E workspace future %'),
      (SELECT count(*)
       FROM future_plan_view
       WHERE title LIKE 'E2E workspace future %'),
      (SELECT count(*)
       FROM task_pool_view
       WHERE title LIKE 'E2E workspace future %'),
      (SELECT count(DISTINCT trace.priority)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       WHERE trace.date = '2026-07-05'
         AND definition.title LIKE 'E2E workspace drag %'
         AND trace.priority BETWEEN 1 AND 4);
  ")"
  if [[ "$sqlite_probe" != "4 3 3 0 3 4" ]]; then
    echo "workspace bulk-action SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  completion_capability_probe="$(sqlite3 -noheader -separator ' ' "$productivity_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       JOIN subtasks AS subtask ON subtask.trace_id = trace.id
       WHERE definition.title = 'E2E workspace drag A'
         AND trace.status = 'completed'
         AND trace.completed_at IS NOT NULL
         AND subtask.title = 'E2E workspace processed subtask'
         AND subtask.status = 'completed'
         AND subtask.completed_at IS NOT NULL),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN task_definitions AS definition ON definition.id = trace.definition_id
       JOIN subtasks AS subtask ON subtask.trace_id = trace.id
       WHERE definition.title = 'E2E workspace blocked parent'
         AND trace.status = 'pending'
         AND trace.completed_at IS NULL
         AND trace.settled_at IS NULL
         AND subtask.title = 'E2E workspace open subtask'
         AND subtask.status = 'pending'
         AND subtask.completed_at IS NULL
         AND subtask.settled_at IS NULL);
  ")"
  if [[ "$completion_capability_probe" != "1 1" ]]; then
    echo "workspace completion capability SQLite probe failed: ${completion_capability_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E workspace selection, bulk actions, drag order, atomic save failure, and restart: $productivity_db (probe=$sqlite_probe capability=$completion_capability_probe)"
}

run_data_import_ui_probe() {
  local import_dir="artifacts/e2e-data-import-ui"
  local import_db="${import_dir}/Noonmark.sqlite"
  local fixture_dir="/tmp/noonmark-e2e-import-ui"
  local fixture_json="${fixture_dir}/fixture.json"
  local state_file="${import_dir}/state.json"
  local setup_result="${import_dir}/setup-result.txt"
  local exercise_result="${import_dir}/exercise-result.txt"
  local restart_result="${import_dir}/restart-result.txt"
  local setup_log="${import_dir}/setup.log"
  local exercise_log="${import_dir}/exercise.log"
  local restart_log="${import_dir}/restart.log"
  local sqlite_probe

  rm -rf "$import_dir"
  rm -rf "$fixture_dir"
  mkdir -p "$fixture_dir"
  mkdir -p "$import_dir"

  run_terminating_ui_probe \
    "data-import UI fixture setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-ui-setup \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$setup_result"

  if [[ "$(sqlite3 -noheader "$import_db" "
    SELECT count(*)
    FROM task_definitions
    WHERE title = 'E2E UI import baseline 7319';
  ")" != "1" ]]; then
    echo "data-import UI setup did not persist its baseline" >&2
    exit 1
  fi

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "data-import real File menu and NSOpenPanel" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-ui-exercise \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "data-import UI restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-ui-verify \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$restart_result"

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$import_db" "
    SELECT
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import baseline 7319'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import scheduled 7319'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import pool 7319'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import returned 7319'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E UI import returned 7319'
         AND day_traces.status = 'cancelledDraft'),
      (SELECT count(*) FROM task_pool_view
       WHERE title = 'E2E UI import returned 7319'),
      (SELECT count(*) FROM future_plan_view
       WHERE title = 'E2E UI import returned 7319'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import retired 7319'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E UI import retired 7319'
         AND day_traces.status = 'cancelledDraft'),
      (SELECT count(*) FROM task_pool_view
       WHERE title = 'E2E UI import retired 7319'),
      (SELECT count(*) FROM future_plan_view
       WHERE title = 'E2E UI import retired 7319'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E UI import decoy 7319'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E UI import scheduled 7319'
         AND day_traces.date = '2026-07-05'),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces);
  ")"
  if [[ "$sqlite_probe" != "0 1 1 1 1 1 0 1 1 0 0 0 1 4 3" ]]; then
    echo "data-import UI SQLite/restart probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  rm -rf "$fixture_dir"
  echo "E2E File > Import, real NSOpenPanel, cancel, destructive confirm, SQLite/restart: $import_db (probe=$sqlite_probe)"
}

data_import_integrity_journal_digest() {
  local database_path="$1"

  sqlite3 -noheader "$database_path" "
    SELECT
      hex(id) || '|' ||
      hex(entity_type) || '|' ||
      hex(entity_id) || '|' ||
      hex(operation) || '|' ||
      hex(changed_at) || '|' ||
      printf('%lld', changed_at_bits) || '|' ||
      hex(device_id) || '|' ||
      hex(sync_state) || '|' ||
      printf('%lld', retry_count) || '|' ||
      CASE
        WHEN last_error IS NULL THEN '-'
        ELSE '+' || hex(last_error)
      END || '|' ||
      CASE
        WHEN record_payload IS NULL THEN '-'
        ELSE '+' || hex(record_payload)
      END
    FROM change_journal
    ORDER BY changed_at,
      CASE entity_type
        WHEN 'taskChain' THEN 0
        WHEN 'taskDefinition' THEN 1
        WHEN 'day' THEN 2
        WHEN 'classificationCommit' THEN 3
        WHEN 'dayTrace' THEN 4
        WHEN 'traceClassificationEvent' THEN 5
        WHEN 'subtask' THEN 6
        WHEN 'appPreferences' THEN 7
        ELSE 8
      END,
      entity_id,
      id;
  " | shasum -a 256 | awk '{print $1}'
}

run_data_import_integrity_probe() {
  local import_dir="artifacts/e2e-data-import-integrity"
  local import_db="${import_dir}/Noonmark.sqlite"
  local fixture_dir="/tmp/noonmark-e2e-import-integrity"
  local fixture_json="${fixture_dir}/duplicate-subtask-identity.json"
  local state_file="${import_dir}/state.json"
  local panel_trace="${import_dir}/panel-events.txt"
  local probe_file="${import_dir}/integrity-probe.txt"
  local setup_result="${import_dir}/setup-result.txt"
  local exercise_result="${import_dir}/exercise-result.txt"
  local restart_result="${import_dir}/restart-result.txt"
  local setup_log="${import_dir}/setup.log"
  local exercise_log="${import_dir}/exercise.log"
  local restart_log="${import_dir}/restart.log"
  local baseline_database_sha256
  local exercise_database_sha256
  local restart_database_sha256
  local baseline_journal_digest
  local exercise_journal_digest
  local restart_journal_digest
  local baseline_journal_count
  local exercise_journal_count
  local restart_journal_count
  local state_format_version
  local state_journal_count
  local state_journal_sha256
  local scenario_xml
  local completed_xml
  local scenario_count
  local completed_count
  local sqlite_probe
  local scenario
  local fixture_sha256
  local state_fixture_sha256
  local scenarios=(
    "duplicate-subtask-identity"
    "dangling-subtask-parent"
    "invalid-subtask-terminal-facts"
    "invalid-planned-subtask-position"
  )

  rm -rf "$import_dir"
  rm -rf "$fixture_dir"
  mkdir -p "$fixture_dir"
  mkdir -p "$import_dir"

  run_terminating_ui_probe \
    "data-import integrity fixture setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-integrity-setup \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$setup_result"

  baseline_database_sha256="$(shasum -a 256 "$import_db" | awk '{print $1}')"
  baseline_journal_digest="$(data_import_integrity_journal_digest "$import_db")"
  baseline_journal_count="$(sqlite3 -noheader "$import_db" \
    "SELECT count(*) FROM change_journal;")"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "data-import malformed Snapshot fail-closed UI" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-integrity-exercise \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$exercise_result"

  exercise_database_sha256="$(shasum -a 256 "$import_db" | awk '{print $1}')"
  exercise_journal_digest="$(data_import_integrity_journal_digest "$import_db")"
  exercise_journal_count="$(sqlite3 -noheader "$import_db" \
    "SELECT count(*) FROM change_journal;")"
  if [[ "$exercise_database_sha256" != "$baseline_database_sha256" \
    || "$exercise_journal_digest" != "$baseline_journal_digest" \
    || "$exercise_journal_count" != "$baseline_journal_count" ]]; then
    echo "malformed data-import changed SQLite or its journal" >&2
    exit 1
  fi

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "data-import malformed Snapshot restart" \
    "$restart_result" \
    "$restart_log" \
    --data-url "$PWD/$import_db" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-data-import-integrity-verify \
    --e2e-data-import-ui-fixture-url "$fixture_json" \
    --e2e-data-import-ui-state-url "$PWD/$state_file" \
    --e2e-data-import-ui-result-url "$PWD/$restart_result"

  restart_database_sha256="$(shasum -a 256 "$import_db" | awk '{print $1}')"
  restart_journal_digest="$(data_import_integrity_journal_digest "$import_db")"
  restart_journal_count="$(sqlite3 -noheader "$import_db" \
    "SELECT count(*) FROM change_journal;")"
  if [[ "$restart_database_sha256" != "$baseline_database_sha256" \
    || "$restart_journal_digest" != "$baseline_journal_digest" \
    || "$restart_journal_count" != "$baseline_journal_count" ]]; then
    echo "malformed data-import baseline changed after restart" >&2
    exit 1
  fi

  state_format_version="$(/usr/bin/plutil -extract formatVersion raw -o - \
    "$state_file")"
  state_journal_count="$(/usr/bin/plutil -extract baselineJournalCount raw -o - \
    "$state_file")"
  state_journal_sha256="$(/usr/bin/plutil -extract baselineJournalSHA256 raw -o - \
    "$state_file")"
  scenario_xml="$(/usr/bin/plutil -extract scenarioIDs xml1 -o - "$state_file")"
  completed_xml="$(/usr/bin/plutil -extract completedScenarioIDs xml1 -o - \
    "$state_file")"
  scenario_count="$(grep -c '<string>' <<<"$scenario_xml")"
  completed_count="$(grep -c '<string>' <<<"$completed_xml")"
  if [[ "$state_format_version" != "2" \
    || "$state_journal_count" != "$baseline_journal_count" \
    || "${#state_journal_sha256}" -ne 64 \
    || "$scenario_count" -ne "${#scenarios[@]}" \
    || "$completed_count" -ne "${#scenarios[@]}" ]]; then
    echo "data-import integrity state is incomplete or inconsistent" >&2
    exit 1
  fi

  for scenario in "${scenarios[@]}"; do
    if [[ "$(grep -Fc "<string>${scenario}</string>" <<<"$scenario_xml")" -ne 1 \
      || "$(grep -Fc "<string>${scenario}</string>" <<<"$completed_xml")" -ne 1 ]]; then
      echo "data-import integrity scenario was not completed: $scenario" >&2
      exit 1
    fi
    if ! awk -v scenario="$scenario" '
      $1 == scenario && index($0, "typed-fixture-path ") { typed = 1 }
      $1 == scenario &&
        index($0, "exact-file-selected-and-sent-open-return") { selected = 1 }
      END { exit !(typed && selected) }
    ' "$panel_trace"; then
      echo "data-import integrity scenario lacked real NSOpenPanel input: $scenario" >&2
      exit 1
    fi
    fixture_sha256="$(shasum -a 256 "${fixture_dir}/${scenario}.json" \
      | awk '{print $1}')"
    state_fixture_sha256="$(/usr/bin/plutil \
      -extract "fixtureSHA256ByScenarioID.${scenario}" raw -o - "$state_file")"
    if [[ "$fixture_sha256" != "$state_fixture_sha256" ]]; then
      echo "data-import integrity fixture changed after setup: $scenario" >&2
      exit 1
    fi
  done

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$import_db" "
    SELECT
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E import integrity baseline 9340'),
      (SELECT count(*) FROM task_definitions
       WHERE title = 'E2E malformed import payload 9340'),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM task_pool_view
       WHERE title = 'E2E import integrity baseline 9340'),
      (SELECT count(*)
       FROM task_chains AS chain
       JOIN task_definitions AS definition
         ON definition.chain_id = chain.id
       WHERE definition.title = 'E2E import integrity baseline 9340'
         AND chain.created_at_bits = chain.updated_at_bits
         AND chain.created_at_bits = definition.created_at_bits
         AND chain.created_at_bits = definition.content_updated_at_bits),
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN task_chains AS chain
         ON journal.entity_type = 'taskChain'
        AND journal.entity_id = chain.id
       JOIN task_definitions AS definition
         ON definition.chain_id = chain.id
       WHERE definition.title = 'E2E import integrity baseline 9340'
         AND journal.changed_at_bits = chain.created_at_bits)
        +
      (SELECT count(*)
       FROM change_journal AS journal
       JOIN task_definitions AS definition
         ON journal.entity_type = 'taskDefinition'
        AND journal.entity_id = definition.id
       WHERE definition.title = 'E2E import integrity baseline 9340'
         AND journal.changed_at_bits = definition.created_at_bits),
      (SELECT count(*) FROM change_journal);
  ")"
  if [[ "$sqlite_probe" != "1 0 1 1 0 0 1 1 2 $baseline_journal_count" ]]; then
    echo "data-import integrity SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  {
    echo "format_version=$state_format_version"
    echo "scenario_count=$scenario_count"
    echo "completed_scenario_count=$completed_count"
    echo "baseline_database_sha256=$baseline_database_sha256"
    echo "exercise_database_sha256=$exercise_database_sha256"
    echo "restart_database_sha256=$restart_database_sha256"
    echo "baseline_journal_digest=$baseline_journal_digest"
    echo "exercise_journal_digest=$exercise_journal_digest"
    echo "restart_journal_digest=$restart_journal_digest"
    echo "baseline_journal_count=$baseline_journal_count"
    echo "state_journal_sha256=$state_journal_sha256"
    echo "sqlite_probe=$sqlite_probe"
  } >"$probe_file"

  rm -rf "$fixture_dir"
  echo "E2E malformed DataPackage v2 fail-closed, real NSOpenPanel, SQLite/journal/restart: $import_db (probe=$probe_file)"
}

