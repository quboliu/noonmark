run_quick_add_ui_probe() {
  local quick_add_dir="artifacts/e2e-quick-add-ui"
  local day_db="$quick_add_dir/day.sqlite"
  local future_db="$quick_add_dir/future.sqlite"
  local pool_db="$quick_add_dir/pool.sqlite"
  local day_result="$quick_add_dir/day-result.txt"
  local future_result="$quick_add_dir/future-result.txt"
  local pool_result="$quick_add_dir/pool-result.txt"
  local day_log="$quick_add_dir/day.log"
  local future_log="$quick_add_dir/future.log"
  local pool_log="$quick_add_dir/pool.log"
  local day_title="dayreturntask"
  local future_title="futurereturntask"
  local pool_title="poolreturntask"
  local day_persisted
  local future_persisted
  local pool_persisted

  rm -rf "$quick_add_dir"
  mkdir -p "$quick_add_dir"

  run_terminating_ui_probe \
    "Day Todo quick-add real Return" \
    "$day_result" \
    "$day_log" \
    --data-url "$PWD/$day_db" \
    --page day \
    --e2e-quick-add-via-ui day \
    --e2e-quick-add-ui-title "$day_title" \
    --e2e-quick-add-ui-result-url "$PWD/$day_result"

  day_persisted="$(sqlite3 -noheader -separator '|' "$day_db" "
    SELECT count(*), count(DISTINCT job.id)
    FROM day_traces
    JOIN task_definitions ON task_definitions.id = day_traces.definition_id
    JOIN automatic_classification_jobs AS job
      ON job.chain_id = day_traces.chain_id
    WHERE task_definitions.title = '$day_title'
      AND day_traces.date = '2026-07-05'
      AND day_traces.status = 'pending'
      AND job.state = 'waitingForConfiguration'
      AND job.generation = 1;
  ")"
  if [[ "$day_persisted" != "1|1" ]]; then
    echo "Day Todo quick-add task/job persistence failed: ${day_persisted:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "future Day Todo quick-add real Return" \
    "$future_result" \
    "$future_log" \
    --data-url "$PWD/$future_db" \
    --page day \
    --e2e-quick-add-via-ui future \
    --e2e-quick-add-ui-title "$future_title" \
    --e2e-quick-add-ui-result-url "$PWD/$future_result"

  future_persisted="$(sqlite3 -noheader -separator '|' "$future_db" "
    SELECT count(*), count(DISTINCT job.id)
    FROM day_traces
    JOIN task_definitions ON task_definitions.id = day_traces.definition_id
    JOIN automatic_classification_jobs AS job
      ON job.chain_id = day_traces.chain_id
    WHERE task_definitions.title = '$future_title'
      AND day_traces.date = '2026-07-06'
      AND day_traces.status = 'pending'
      AND job.state = 'waitingForConfiguration'
      AND job.generation = 1;
  ")"
  if [[ "$future_persisted" != "1|1" ]]; then
    echo "future quick-add task/job persistence failed: ${future_persisted:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "task-pool quick-add real Return" \
    "$pool_result" \
    "$pool_log" \
    --data-url "$PWD/$pool_db" \
    --page pool \
    --e2e-quick-add-via-ui pool \
    --e2e-quick-add-ui-title "$pool_title" \
    --e2e-quick-add-ui-result-url "$PWD/$pool_result"

  pool_persisted="$(sqlite3 -noheader -separator '|' "$pool_db" "
    SELECT
      count(*),
      count(DISTINCT job.id),
      sum(task_definitions.description_text IS NULL),
      sum(json_array_length(task_chains.note_entries_json))
    FROM task_chains
    JOIN task_definitions ON task_definitions.chain_id = task_chains.id
    JOIN automatic_classification_jobs AS job
      ON job.chain_id = task_chains.id
    WHERE task_definitions.title = '$pool_title'
      AND task_chains.state = 'active'
      AND job.state = 'waitingForConfiguration'
      AND job.generation = 1
      AND NOT EXISTS (
        SELECT 1 FROM day_traces WHERE day_traces.chain_id = task_chains.id
      );
  ")"
  if [[ "$pool_persisted" != "1|1|1|0" ]]; then
    echo "task-pool quick-add task/job persistence failed: ${pool_persisted:-missing}" >&2
    exit 1
  fi

  echo "E2E real quick-add Return, task/job atomicity, geometry, and persistence: $day_db $future_db $pool_db"
}

