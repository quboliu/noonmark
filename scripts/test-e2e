#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
pages=(
  day
  pool
  future
  unfinished
  completed
  calendar
  zhulong
  settings
)

scripts/build-mac-app "$configuration"

mkdir -p artifacts/e2e
pkill -x SuntraceMacApp 2>/dev/null || true
trap 'pkill -x SuntraceMacApp 2>/dev/null || true' EXIT

find_window_id() {
  swift -e '
import CoreGraphics
import Darwin

if let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] {
    for window in list {
        let owner = window[kCGWindowOwnerName as String] as? String ?? ""
        let name = window[kCGWindowName as String] as? String ?? ""
        if owner == "晷迹" || owner.contains("Suntrace") || name.contains("suntrace") {
            if let number = window[kCGWindowNumber as String] {
                print(number)
                exit(0)
            }
        }
    }
}
exit(1)
'
}

for page in "${pages[@]}"; do
  pkill -x SuntraceMacApp 2>/dev/null || true
  open -n dist/SuntraceMacApp.app --args --page "$page"
  sleep "${SUNTRACE_E2E_STARTUP_WAIT:-3}"

  window_id="$(find_window_id)"
  screenshot="artifacts/e2e/${page}.png"
  screencapture -x -l "$window_id" "$screenshot"
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"

  if [[ "${width:-0}" -lt 1200 || "${height:-0}" -lt 700 ]]; then
    echo "invalid e2e screenshot size for ${page}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  echo "E2E ${page} screenshot: ${screenshot} (${width}x${height})"
done

pkill -x SuntraceMacApp 2>/dev/null || true
