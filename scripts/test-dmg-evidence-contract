cp "$e2e_inventory" "$e2e_inventory_pristine"

refresh_inventory_record() {
  local inventory_path="$1"
  local relative_path="$2"
  local artifact_path="$fixture_root/$relative_path"
  local digest
  local size
  local staged

  digest="$(shasum -a 256 "$artifact_path" | awk '{print $1}')"
  size="$(stat -f '%z' "$artifact_path")"
  staged="${inventory_path}.refresh"
  awk -F $'\t' -v OFS=$'\t' \
    -v expected="$relative_path" -v digest="$digest" -v size="$size" '
      $3 == expected { $1 = digest; $2 = size; found += 1 }
      { print }
      END { exit !(found == 1) }
    ' "$inventory_path" >"$staged"
  mv "$staged" "$inventory_path"
}

refresh_e2e_manifest_bindings() {
  local ledger_relative="artifacts/e2e-runtime/english-scenario-ledger.tsv"
  local ledger_sha256
  local inventory_sha256

  ledger_sha256="$(shasum -a 256 "$english_ledger" | awk '{print $1}')"
  refresh_inventory_record "$e2e_inventory" "$ledger_relative"
  inventory_sha256="$(shasum -a 256 "$e2e_inventory" | awk '{print $1}')"
  sed -i '' \
    -e "s/^english_scenario_ledger_sha256=.*/english_scenario_ledger_sha256=${ledger_sha256}/" \
    -e "s/^artifact_inventory_sha256=.*/artifact_inventory_sha256=${inventory_sha256}/" \
    "$e2e_manifest"
}

expect_runtime_semantic_mutation_rejected() {
  local label="$1"
  local expected_message="$2"
  local status

  set +e
  (
    cd "$fixture_root"
    scripts/verify-development-validation-evidence \
      --scope runtime \
      artifacts/e2e-runtime/manifest.txt \
      artifacts/e2e-data-root-process-lease/manifest.txt
  ) >"$fixture_root/runtime-validator-${label}.stdout" \
    2>"$fixture_root/runtime-validator-${label}.stderr"
  status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    echo "runtime validator accepted semantic mutation: $label" >&2
    exit 1
  fi
  if ! grep -F "$expected_message" \
    "$fixture_root/runtime-validator-${label}.stderr" >/dev/null; then
    echo "runtime validator rejected $label for the wrong reason" >&2
    cat "$fixture_root/runtime-validator-${label}.stderr" >&2
    exit 1
  fi
}

