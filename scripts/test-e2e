        "artifacts/e2e-english/zhulong-title-geometry.txt" \
        home \
        zhulong.home.title \
        Zhulong
      ;;
  esac
  if [[ "$scenario_language" == "english" ]]; then
    record_english_scenario_evidence \
      "$screenshot_name" \
      "artifacts/e2e/${screenshot_name}.png"
  fi
  if [[ "$screenshot_name" == "day-pointer-selection" ]]; then
    xcrun swift scripts/assert-selection-focus-screenshot.swift \
      "artifacts/e2e/${screenshot_name}.png"
  fi
done

