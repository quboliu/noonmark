            "stream.scrollTop=0; const topHeader=document.querySelector('.page-header').getBoundingClientRect().top;"
            "stream.scrollTop=stream.scrollHeight; const bottomHeader=document.querySelector('.page-header').getBoundingClientRect().top;"
