#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

tree_source="App/NoonmarkMacApp/AppViewTreeE2E.swift"
settings_source="App/NoonmarkMacApp/SettingsPaneContent.swift"
automation_source="App/NoonmarkMacApp/PreferencesClockE2EAutomation.swift"
lifecycle_source="App/NoonmarkMacApp/ReplicationV2LifecycleE2EEndpoint.swift"
sync_source="App/NoonmarkMacApp/NoonmarkStore+Sync.swift"

rg -F 'static func checkboxInteractionTarget(' "$tree_source" >/dev/null
rg -F 'anchorFrame.contains(' "$tree_source" >/dev/null
rg -F 'anchor.enclosingScrollView?.documentView' "$tree_source" >/dev/null
rg -F 'hitView === documentView || hitView.isDescendant(of: documentView)' "$tree_source" >/dev/null
rg -F 'AppE2EViewAnchor(' "$settings_source" >/dev/null
rg -F 'identifier: "settings.preferences.poem.enabled"' "$settings_source" >/dev/null
rg -F '.accessibilityIdentifier("settings.sync.enabled")' "$settings_source" >/dev/null
rg -F 'identifier: "settings.sync.enabled"' "$settings_source" >/dev/null
if rg -n '^[[:space:]]*\.disabled\(store\.isLocalFirstSyncing\)[[:space:]]*$' \
  "$settings_source" >/dev/null; then
  echo "Preferences sync card still disables its stop control during an active run" >&2
  exit 1
fi
rg -F 'try await clickCheckbox(' "$automation_source" >/dev/null
rg -F 'sync v2 task-mutation=allowed checkbox-disable=stopping join=held' \
  "$automation_source" >/dev/null
rg -F 'sync v2 disabled worker=disabled incident=cleared warning=suppressed' \
  "$automation_source" >/dev/null
rg -F 'sync v2 restart worker=disabled warning=suppressed ' \
  "$automation_source" >/dev/null
rg -F 'actor ReplicationV2LifecycleE2EEndpoint: ReplicationEndpoint' \
  "$lifecycle_source" >/dev/null
rg -F 'func armReadFailure() -> Bool' "$lifecycle_source" >/dev/null
rg -F 'func armBlockingRead() -> Bool' "$lifecycle_source" >/dev/null
rg -F 'await underlying.cancelAndJoin()' "$lifecycle_source" >/dev/null
rg -F 'Bundle.main.bundleIdentifier == "app.noonmark.mac.e2e"' \
  "$sync_source" >/dev/null
rg -F '"--e2e-replication-v2-lifecycle-endpoint"' \
  "$sync_source" >/dev/null
disabled_line="$(rg -n -F 'case .disabled:' "$sync_source" \
  | head -1 | cut -d: -f1)"
notice_clear_line="$(awk -v start="$disabled_line" '
  NR > start && index($0, "resolveOperationFailure(.sync)") {
    print NR
    exit
  }
' "$sync_source")"
[[ -n "$disabled_line" && -n "$notice_clear_line" ]] || {
  echo "V2 disabled state no longer suppresses the actionable sync warning" >&2
  exit 1
}
rg -F 'AppViewTreeE2E.attachedView(identifier: identifier)' "$automation_source" >/dev/null
rg -F 'anchor.scrollToVisible(anchor.bounds.insetBy(dx: 0, dy: -24))' "$automation_source" >/dev/null
rg -F 'checkbox hit target was not visible:' "$automation_source" >/dev/null
rg -F 'AppViewTreeE2E.checkboxInteractionTarget(' "$automation_source" >/dev/null
rg -F 'checkbox interaction target changed:' "$automation_source" >/dev/null

if rg -n \
  'PersistedSyncFailureRestoreE2EGate|SQLiteLocalFirstSyncCoordinator|SQLiteLocalFirstSyncStatus|e2e-persisted-sync-failure-restore-race' \
  App/NoonmarkMacApp scripts/test-e2e >/dev/null; then
  echo "V1 persisted-failure automation escaped the V2 clean cut" >&2
  exit 1
fi

echo "Preferences checkbox interaction target contract passed"
