run_idea_capture_probe() {
  local idea_dir="artifacts/e2e-idea-capture"
  local idea_db="$idea_dir/Noonmark.sqlite"
  local exercise_result="$idea_dir/exercise-result.txt"
  local exercise_log="$idea_dir/exercise.log"
  local verify_result="$idea_dir/verify-result.txt"
  local verify_log="$idea_dir/verify.log"
  local cancel_proof="$idea_dir/cancel-sqlite-proof.tsv"
  local cancel_id
  local cancel_updated_at_bits
  local cancel_sql_probe
  local idea_sql_probe
  local screenshot

  rm -rf "$idea_dir"
  mkdir -p "$idea_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "idea capture exercise" \
    "$exercise_result" \
    "$exercise_log" \
    --data-url "$PWD/$idea_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-seed-default-state \
    --e2e-idea-capture exercise \
    --e2e-idea-capture-result-url "$PWD/$exercise_result" \
    --e2e-idea-capture-screenshot-dir "$PWD/$idea_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "idea capture restart verification" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$idea_db" \
    --page ideas \
    --e2e-reset-selection \
    --e2e-idea-capture verify \
    --e2e-idea-capture-result-url "$PWD/$verify_result" \
    --e2e-idea-capture-screenshot-dir "$PWD/$idea_dir"

  idea_sql_probe="$(sqlite3 -noheader -separator ' ' "$idea_db" "
    SELECT
      count(*),
      (SELECT count(*) FROM idea_entries WHERE deleted_at IS NULL),
      (SELECT count(*) FROM idea_entries
       WHERE body = '## e2e Flylight alpha' || char(10)
         || '- second line https://example.com/@user'
         AND deleted_at IS NULL
         AND category_id IS NOT NULL
         AND json_array_length(label_ids_json) = 1),
      (SELECT count(*) FROM idea_entries
       WHERE body = ''
         AND deleted_at IS NOT NULL
         AND typeof(deleted_at_bits) = 'integer'
         AND updated_at_bits = deleted_at_bits),
      (SELECT count(*) FROM idea_entries
       WHERE body = 'e2e panel idea gamma' AND deleted_at IS NULL),
      (SELECT count(*) FROM idea_entries
       WHERE body = 'e2e hotkey idea delta' AND deleted_at IS NULL),
      (SELECT count(*) FROM idea_entries
       WHERE body IN ('e2e idea beta marker', 'e2e idea beta edited',
                      'e2e idea epsilon marker', 'e2e draft discarded')),
      (SELECT count(*) FROM idea_entries
       WHERE deleted_at IS NULL AND pinned_at IS NOT NULL),
      (SELECT count(*) FROM idea_entries
       WHERE body = 'e2e panel idea gamma'
         AND pinned_at IS NOT NULL
         AND typeof(pinned_at_bits) = 'integer'),
      (SELECT count(*) FROM idea_entries
       WHERE body = '## e2e Flylight alpha' || char(10)
         || '- second line https://example.com/@user'
         AND pinned_at IS NULL),
      (SELECT count(*) FROM idea_entries
       WHERE body = 'e2e idea beta restored'
         AND deleted_at IS NULL
         AND pinned_at IS NULL)
    FROM idea_entries;
  ")"
  if [[ "$idea_sql_probe" != "6 4 1 2 1 1 0 1 1 1 0" ]]; then
    echo "idea capture SQLite probe failed: ${idea_sql_probe:-missing}" >&2
    exit 1
  fi

  if [[ ! -s "$cancel_proof" ]]; then
    echo "idea capture cancellation SQLite proof was not created" >&2
    exit 1
  fi
  IFS=$'\t' read -r cancel_id cancel_updated_at_bits < "$cancel_proof"
  if [[ ! "$cancel_id" =~ ^[0-9A-Fa-f-]{36}$ ]] \
    || [[ ! "$cancel_updated_at_bits" =~ ^-?[0-9]+$ ]]; then
    echo "idea capture cancellation SQLite proof was malformed" >&2
    exit 1
  fi
  cancel_sql_probe="$(sqlite3 -noheader "$idea_db" "
    SELECT count(*) FROM idea_entries
    WHERE id = '$cancel_id'
      AND body = 'e2e cancellation persistence proof'
      AND updated_at_bits = $cancel_updated_at_bits
      AND deleted_at IS NULL;
  ")"
  if [[ "$cancel_sql_probe" != "1" ]]; then
    echo "idea capture cancellation changed body or updated_at_bits in SQLite" >&2
    exit 1
  fi

  for screenshot in \
    ideas-empty.png \
    ideas-detail-collapsed.png \
    ideas-detail-expanded.png \
    ideas-composer-failed.png \
    ideas-composer-saved.png \
    ideas-filtered.png \
    ideas-classification-filtered.png \
    ideas-edited.png \
    ideas-empty-focused.png \
    sticky-notes-wall.png \
    sticky-notes-selected.png \
    sticky-notes-restart.png \
    idea-capture-panel.png \
    ideas-restart.png; do
    if [[ ! -s "$idea_dir/$screenshot" ]]; then
      echo "idea capture screenshot was not created: $idea_dir/$screenshot" >&2
      exit 1
    fi
  done

  echo "E2E Flylight composer/Markdown/filter/edit/delete, cancel invariants, hidden tombstones, Sticky Note modes, panel, hotkey, restart, and SQLite probe: $idea_db (probe=$idea_sql_probe cancel=$cancel_sql_probe)"
}

run_native_command_surface_probe() {
  local command_dir="artifacts/e2e-native-command-surface"
  local command_db="$command_dir/Noonmark.sqlite"
  local state_file="$command_dir/state.json"
  local help_shortcut_result="$command_dir/help-shortcut-result.txt"
  local help_shortcut_log="$command_dir/help-shortcut.log"
  local exercise_result="$command_dir/exercise-result.txt"
  local exercise_log="$command_dir/exercise.log"
  local help_ready_path="$command_dir/help-ready.txt"
  local helper_evidence_dir="$command_dir/help-menu-helper"
  local verify_result="$command_dir/verify-result.txt"
  local verify_log="$command_dir/verify.log"
  local sqlite_probe

  rm -rf "$command_dir"
  mkdir -p "$command_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "native Help shortcut" \
    "$help_shortcut_result" \
    "$help_shortcut_log" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-help-shortcut \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$help_shortcut_result"

  run_native_command_surface_exercise \
    "native command surface exercise" \
    "$exercise_result" \
    "$exercise_log" \
    "$help_ready_path" \
    "$helper_evidence_dir" \
    "帮助" \
    "晷迹使用帮助" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-surface-exercise \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "native command surface restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$command_db" \
    --page day \
    --e2e-reset-selection \
    --e2e-native-command-surface-verify \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$verify_result"

  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$command_db" "
    SELECT
      count(*),
      count(DISTINCT trace.id),
      count(DISTINCT definition.chain_id),
      (SELECT count(*)
       FROM automatic_classification_jobs AS job
       WHERE job.chain_id = definition.chain_id
         AND job.state = 'waitingForConfiguration'
         AND job.generation = 2),
      (SELECT count(*)
       FROM task_cycle_series
       WHERE title = 'recurringsearchplan')
    FROM day_traces AS trace
    JOIN task_definitions AS definition ON definition.id = trace.definition_id
    JOIN task_chains AS chain ON chain.id = trace.chain_id
    WHERE definition.title = 'commandrecoverytask'
      AND definition.superseded_at IS NULL
      AND trace.date = '2026-07-05'
      AND trace.status = 'pending'
      AND chain.state = 'active';
  ")"
  if [[ "$sqlite_probe" != "1 1 1 1 1" ]]; then
    echo "native command surface SQLite restart probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E native menus, Settings, Quick Entry, Search, Undo/Redo restart: $command_db (probe=$sqlite_probe)"
}

run_completion_control_probe() {
  local completion_dir="artifacts/e2e-completion-control"
