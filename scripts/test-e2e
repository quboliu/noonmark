blank_dir="artifacts/e2e-blank"
blank_db="${blank_dir}/Noonmark.sqlite"
blank_pages=(day pool future unfinished completed calendar zhulong)
rm -rf "$blank_dir"
mkdir -p "$blank_dir"

for page in "${blank_pages[@]}"; do
  if [[ "$page" == "zhulong" ]]; then
    capture_app_screenshot "$blank_dir" "$page" "$page" --data-url "$PWD/$blank_db" --e2e-reset-selection --e2e-enable-zhulong
  else
    capture_app_screenshot "$blank_dir" "$page" "$page" --data-url "$PWD/$blank_db" --e2e-reset-selection
  fi
done

terminate_e2e_app

read -r blank_days blank_chains blank_definitions blank_traces blank_subtasks blank_preferences < <(
  sqlite3 -separator " " "$blank_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$blank_days" -ne 0 || "$blank_chains" -ne 0 || "$blank_definitions" -ne 0 || "$blank_traces" -ne 0 || "$blank_subtasks" -ne 0 || "$blank_preferences" -ne 1 ]]; then
  echo "invalid blank user counts after page screenshots: days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences" >&2
  exit 1
fi

echo "E2E blank user screenshots: $blank_dir (days=$blank_days chains=$blank_chains definitions=$blank_definitions traces=$blank_traces subtasks=$blank_subtasks preferences=$blank_preferences)"

persistence_dir="artifacts/e2e-persistence"
persistence_db="${persistence_dir}/Noonmark.sqlite"
rm -rf "$persistence_dir"
mkdir -p "$persistence_dir"

"$app_executable_path" --data-url "$PWD/$persistence_db" --e2e-reset-selection --page day >/dev/null 2>&1 &
disown "$!" 2>/dev/null || true
sleep "${NOONMARK_E2E_STARTUP_WAIT:-3}"
terminate_e2e_app

if [[ ! -f "$persistence_db" ]]; then
  echo "persistence database was not created: $persistence_db" >&2
  exit 1
fi

read -r days chains definitions traces subtasks preferences < <(
  sqlite3 -separator " " "$persistence_db" "
    SELECT
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*) FROM app_preferences);
  "
)

if [[ "$days" -ne 0 || "$chains" -ne 0 || "$definitions" -ne 0 || "$traces" -ne 0 || "$subtasks" -ne 0 || "$preferences" -ne 1 ]]; then
  echo "invalid persistence counts: days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences" >&2
  exit 1
fi

echo "E2E blank persistence database: $persistence_db (days=$days chains=$chains definitions=$definitions traces=$traces subtasks=$subtasks preferences=$preferences)"

classification_dir="artifacts/e2e-classification"
classification_db="${classification_dir}/Noonmark.sqlite"
classification_edit_result="${classification_dir}/edit-result.txt"
classification_restart_result="${classification_dir}/restart-result.txt"
classification_title="E2E 分类持久化"
rm -rf "$classification_dir"
mkdir -p "$classification_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$classification_db" \
  --page pool \
  --e2e-classification-edit \
  --e2e-classification-title "$classification_title" \
  --e2e-classification-result-url "$PWD/$classification_edit_result" \
  --e2e-quit-after-automation

if [[ ! -f "$classification_edit_result" ]]; then
  echo "classification edit automation failed: missing result" >&2
  exit 1
fi
if [[ "$(<"$classification_edit_result")" != "ok" ]]; then
  echo "classification edit automation failed: $(<"$classification_edit_result")" >&2
  exit 1
fi

capture_app_screenshot \
  "$classification_dir" \
  "classification-restart" \
  pool \
  --data-url "$PWD/$classification_db" \
  --e2e-classification-verify \
  --e2e-classification-title "$classification_title" \
  --e2e-classification-result-url "$PWD/$classification_restart_result"

if [[ ! -f "$classification_restart_result" ]]; then
  echo "classification restart automation failed: missing result" >&2
  terminate_e2e_app
  exit 1
fi
if [[ "$(<"$classification_restart_result")" != "ok" ]]; then
  echo "classification restart automation failed: $(<"$classification_restart_result")" >&2
  terminate_e2e_app
  exit 1
fi
terminate_e2e_app

read -r \
  classification_category_count \
  classification_label_count \
  classification_expected_label_count \
  classification_metadata_count \
  classification_name_version_count \
  classification_revision \
  classification_record_count \
  classification_plan_digest_count \
  classification_integrity_digest_count \
  classification_record_finalization_count \
  classification_valid_after_count \
  classification_after_count \
  classification_commit_count \
  classification_receipt_count \
  classification_receipt_digest_count \
  classification_commit_finalization_count \
  classification_crosscheck_count < <(
  sqlite3 -separator " " "$classification_db" "
    WITH target AS (
      SELECT task_chains.id AS chain_id
      FROM task_chains
      JOIN task_definitions ON task_definitions.chain_id = task_chains.id
      WHERE task_definitions.title = '$classification_title'
        AND task_definitions.superseded_at IS NULL
      LIMIT 1
    ), target_category AS (
      SELECT relation.category_id AS item_id
      FROM task_chain_categories AS relation
      WHERE relation.chain_id = (SELECT chain_id FROM target)
    ), target_labels AS (
      SELECT relation.label_id AS item_id
      FROM task_chain_label_relations AS relation
      WHERE relation.chain_id = (SELECT chain_id FROM target)
    ), target_change AS (
      SELECT record.record_id
      FROM classification_change_records AS record
      JOIN classification_change_record_changes AS record_change
        ON record_change.record_id = record.record_id
      WHERE record_change.kind = 'setCurrent'
        AND record_change.chain_id = (SELECT chain_id FROM target)
    )
    SELECT
      (SELECT count(*)
       FROM target_category
       JOIN task_categories ON task_categories.id = target_category.item_id
       WHERE task_categories.name = '验证'),
      (SELECT count(*) FROM target_labels),
      (SELECT count(*)
       FROM target_labels
       JOIN task_labels ON task_labels.id = target_labels.item_id
       WHERE task_labels.name IN ('SQLite', '重启', '白盒')),
      (SELECT count(*)
       FROM classification_item_metadata AS metadata
       WHERE metadata.lifecycle = 'active'
         AND (
           (metadata.kind = 'category' AND metadata.item_id IN (SELECT item_id FROM target_category))
           OR (metadata.kind = 'label' AND metadata.item_id IN (SELECT item_id FROM target_labels))
         )),
      (SELECT count(*)
       FROM classification_name_versions AS version
       WHERE (version.kind = 'category' AND version.item_id IN (SELECT item_id FROM target_category))
          OR (version.kind = 'label' AND version.item_id IN (SELECT item_id FROM target_labels))),
      (SELECT revision FROM classification_state WHERE id = 1),
      (SELECT count(*) FROM target_change),
      (SELECT count(*)
       FROM classification_change_record_plan_digests
       WHERE record_id = (SELECT record_id FROM target_change)
         AND length(digest) = 64),
      (SELECT count(*)
       FROM classification_change_record_integrity_digests
       WHERE record_id = (SELECT record_id FROM target_change)
         AND length(digest) = 64),
      (SELECT count(*)
       FROM classification_change_record_finalizations
       WHERE record_id = (SELECT record_id FROM target_change)
         AND change_count = 1
         AND notice_count = 0),
      (SELECT count(*)
       FROM classification_change_selection_items AS item
       WHERE item.record_id = (SELECT record_id FROM target_change)
         AND item.selection_side = 'after'
         AND item.resolution = 'new'
         AND (
           (item.item_kind = 'category' AND item.name = '验证')
           OR (item.item_kind = 'label' AND item.name IN ('SQLite', '重启', '白盒'))
         )),
      (SELECT count(*)
       FROM classification_change_selection_items AS item
       WHERE item.record_id = (SELECT record_id FROM target_change)
         AND item.selection_side = 'after'),
      (SELECT count(*) FROM classification_commits),
      (SELECT count(*) FROM classification_commit_receipt_metadata),
      (SELECT count(*)
       FROM classification_commit_receipt_integrity_digests AS digest
       JOIN classification_change_records AS record
         ON record.interaction_id = digest.interaction_id
       WHERE record.record_id = (SELECT record_id FROM target_change)
         AND length(digest.digest) = 64),
      (SELECT count(*)
       FROM classification_commit_finalizations AS finalization
       JOIN classification_change_records AS record
         ON record.interaction_id = finalization.interaction_id
       WHERE record.record_id = (SELECT record_id FROM target_change)
         AND finalization.notice_count = 0),
      (SELECT count(*)
       FROM classification_change_records AS record
       JOIN classification_change_record_changes AS record_change
         ON record_change.record_id = record.record_id
       JOIN classification_commits AS commit_record
         ON commit_record.interaction_id = record.interaction_id
        AND commit_record.plan_id = record.plan_id
        AND commit_record.revision = record.revision
       JOIN classification_commit_receipt_metadata AS receipt
         ON receipt.interaction_id = record.interaction_id
        AND receipt.change_record_id = record.record_id
        AND receipt.decision_id = record.decision_id
       WHERE record_change.kind = 'setCurrent'
         AND record_change.chain_id = (SELECT chain_id FROM target)
         AND record.source_kind = 'userDirect'
         AND record.decision_id IS NOT NULL);
  "
)

if [[ "$classification_category_count" -ne 1 \
  || "$classification_label_count" -ne 3 \
  || "$classification_expected_label_count" -ne 3 \
  || "$classification_metadata_count" -ne 4 \
  || "$classification_name_version_count" -ne 4 \
  || "$classification_revision" -ne 1 \
  || "$classification_record_count" -ne 1 \
  || "$classification_plan_digest_count" -ne 1 \
  || "$classification_integrity_digest_count" -ne 1 \
  || "$classification_record_finalization_count" -ne 1 \
  || "$classification_valid_after_count" -ne 4 \
  || "$classification_after_count" -ne 4 \
  || "$classification_commit_count" -ne 1 \
  || "$classification_receipt_count" -ne 1 \
  || "$classification_receipt_digest_count" -ne 1 \
  || "$classification_commit_finalization_count" -ne 1 \
  || "$classification_crosscheck_count" -ne 1 ]]; then
  echo "classification persistence probe failed: category=$classification_category_count labels=$classification_label_count expected_labels=$classification_expected_label_count metadata=$classification_metadata_count name_versions=$classification_name_version_count revision=$classification_revision records=$classification_record_count plan_digests=$classification_plan_digest_count integrity_digests=$classification_integrity_digest_count record_finalizations=$classification_record_finalization_count valid_after=$classification_valid_after_count after=$classification_after_count commits=$classification_commit_count receipts=$classification_receipt_count receipt_digests=$classification_receipt_digest_count commit_finalizations=$classification_commit_finalization_count crosscheck=$classification_crosscheck_count" >&2
  exit 1
fi

echo "E2E classification edit and restart: $classification_db (category=$classification_category_count labels=$classification_label_count revision=$classification_revision records=$classification_record_count crosscheck=$classification_crosscheck_count)"

zhulong_dir="artifacts/e2e-zhulong"
zhulong_db="${zhulong_dir}/Noonmark.sqlite"
rm -rf "$zhulong_dir"
mkdir -p "$zhulong_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-enable-zhulong \
  --e2e-zhulong-sidecar-key \
  --e2e-start-zhulong-workflow dailyReview \
  --e2e-rich-zhulong-session \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_db" ]]; then
  echo "zhulong database was not created: $zhulong_db" >&2
  exit 1
fi

zhulong_sidecar_dir="${zhulong_dir}/ZhulongSidecar"
zhulong_session_count="$(find "$zhulong_sidecar_dir" -type f -name '*.zhs' | wc -l | tr -d ' ')"
if [[ "$zhulong_session_count" -ne 1 ]]; then
  echo "zhulong encrypted session was not persisted: sessions=$zhulong_session_count" >&2
  exit 1
fi

if grep -a -q "结束今天并形成下一次可信承诺" "$zhulong_sidecar_dir"/*.zhs; then
  echo "zhulong session leaked plaintext intent" >&2
  exit 1
fi

zhulong_persistence_result="${zhulong_dir}/persistence-result.txt"
open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-enable-zhulong \
  --e2e-zhulong-sidecar-key \
  --e2e-verify-zhulong-persistence-result-url "$PWD/$zhulong_persistence_result" \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_persistence_result" || "$(cat "$zhulong_persistence_result")" != "ok" ]]; then
  echo "zhulong encrypted session did not recover after relaunch" >&2
  exit 1
fi

printf 'invalid encrypted sidecar' > "$zhulong_sidecar_dir/invalid.zhs"
zhulong_corruption_result="${zhulong_dir}/corruption-result.txt"
open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-enable-zhulong \
  --e2e-zhulong-sidecar-key \
  --e2e-verify-zhulong-persistence-result-url "$PWD/$zhulong_corruption_result" \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_corruption_result" || "$(cat "$zhulong_corruption_result")" != "corruption-detected" ]]; then
  echo "zhulong corrupted sidecar was not reported fail-closed" >&2
  exit 1
fi

echo "E2E zhulong encrypted persistence and corruption detection: $zhulong_sidecar_dir (sessions=$zhulong_session_count)"

run_zhulong_daily_recovery_clock_probe
run_zhulong_exact_recovery_identity_probe
run_zhulong_pending_gate_probe
run_zhulong_todo_diff_clock_probe

