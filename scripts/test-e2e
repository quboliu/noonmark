run_zhulong_provider_settings_ui_probe() (
  set -euo pipefail
  local settings_dir="artifacts/e2e-zhulong-provider-settings"
  local settings_result="${settings_dir}/settings-result.txt"
  local settings_log="${settings_dir}/settings.log"
  local provider_ready="${settings_dir}/provider-ready.txt"
  local provider_count="${settings_dir}/provider-count.txt"
  local provider_health_count="${settings_dir}/provider-health-count.txt"
  local provider_log="${settings_dir}/provider.log"
  local provider_pid=""
  local provider_port

  rm -rf "$settings_dir"
  mkdir -p "$settings_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$provider_health_count" \
    "$PWD/$provider_log"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "zhulong Provider settings feedback and API Key mask" \
    "$settings_result" \
    "$settings_log" \
    --ephemeral \
    --page settings \
    --e2e-settings-zhulong \
    --e2e-zhulong-provider-settings-ui \
    --e2e-zhulong-provider-settings-base-url \
    "http://127.0.0.1:${provider_port}/v1" \
    --e2e-zhulong-provider-settings-result-url "$PWD/$settings_result"

  assert_automatic_classification_provider_count \
    "zhulong Provider settings health check" \
    "$provider_health_count" \
    "2"
  echo "E2E zhulong Provider Settings test, feedback, save, mask, and clear: $settings_result"
)

run_zhulong_daily_recovery_clock_probe() {
  local recovery_dir="artifacts/e2e-zhulong-recovery"
  local recovery_db="${recovery_dir}/Noonmark.sqlite"
  local recovery_result="${recovery_dir}/recovery-result.txt"
  local interruption_result="${recovery_dir}/interruption-result.txt"
  local recovery_log="${recovery_dir}/recovery.log"
  local recovery_journal="${recovery_dir}/ZhulongSidecar/pending-application.zhj"
  local before_recovery_hash
  local after_recovery_hash
  local clock_probe

  rm -rf "$recovery_dir"
  mkdir -p "$recovery_dir"

  /usr/bin/open -W -n "$app_path" --args \
    --data-url "$PWD/$recovery_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-start-zhulong-workflow dailyReview \
    --e2e-rich-zhulong-session \
    --e2e-interrupt-zhulong-daily-review \
    --e2e-zhulong-interruption-result-url "$PWD/$interruption_result" \
    --e2e-quit-after-automation

  if [[ "$(cat "$interruption_result" 2>/dev/null || true)" != \
    "ok: mutation blocked pending Zhulong application" ]]; then
    echo "zhulong interrupted durable-after/pending-gate evidence failed: $(cat "$interruption_result" 2>/dev/null || echo missing)" >&2
    exit 1
  fi
  if [[ ! -f "$recovery_journal" ]]; then
    echo "zhulong interrupted application journal was not persisted" >&2
    exit 1
  fi
  before_recovery_hash="$(shasum -a 256 "$recovery_db" | awk '{print $1}')"

  run_terminating_ui_probe \
    "zhulong interrupted application recovery" \
    "$recovery_result" \
    "$recovery_log" \
    --data-url "$PWD/$recovery_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-expect-zhulong-recovery \
    --e2e-verify-zhulong-persistence-result-url "$PWD/$recovery_result"

  after_recovery_hash="$(shasum -a 256 "$recovery_db" | awk '{print $1}')"
  if [[ "$after_recovery_hash" != "$before_recovery_hash" ]]; then
    echo "zhulong current==after recovery rewrote the engine database" >&2
    exit 1
  fi
  if [[ -f "$recovery_journal" ]]; then
    echo "zhulong recovery journal was not cleared after successful recovery" >&2
    exit 1
  fi

  clock_probe="$(sqlite3 -noheader -separator ' ' "$recovery_db" "
    SELECT
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 已确认的每日复盘'),
      (SELECT count(*)
       FROM days
       JOIN change_journal
         ON change_journal.entity_type = 'day'
        AND change_journal.entity_id = days.date
        AND change_journal.changed_at_bits = days.updated_at_bits
       WHERE days.date = '2026-07-05'),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'day'
         AND entity_id = '2026-07-05');
  ")"
  if [[ "$clock_probe" != "1 1 1" ]]; then
    echo "zhulong daily-review joint clock probe failed: ${clock_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E fixed-clock Zhulong daily review and no-rewrite recovery: $recovery_db (probe=$clock_probe)"
}

run_zhulong_exact_recovery_identity_probe() {
  local evidence_dir="artifacts/e2e-zhulong-exact-recovery"
  local exact_dir="${evidence_dir}/exact-after"
  local exact_db="${exact_dir}/Noonmark.sqlite"
  local exact_state="${exact_dir}/state.json"
  local exact_setup_result="${exact_dir}/setup-result.txt"
  local exact_setup_log="${exact_dir}/setup.log"
  local exact_verify_result="${exact_dir}/verify-result.txt"
  local exact_verify_log="${exact_dir}/verify.log"
  local exact_journal="${exact_dir}/ZhulongSidecar/pending-application.zhj"
  local exact_before_database_sha256
  local exact_after_database_sha256
  local exact_before_bits
  local exact_after_bits
  local exact_before_digest
  local exact_after_digest
  local exact_current_digest
  local exact_chain_id
  local exact_definition_sequence
  local exact_sqlite_probe
  local conflict_dir="${evidence_dir}/preference-conflict"
  local conflict_db="${conflict_dir}/Noonmark.sqlite"
  local conflict_state="${conflict_dir}/state.json"
  local conflict_setup_result="${conflict_dir}/setup-result.txt"
  local conflict_setup_log="${conflict_dir}/setup.log"
  local conflict_verify_result="${conflict_dir}/verify-result.txt"
  local conflict_verify_log="${conflict_dir}/verify.log"
  local conflict_journal="${conflict_dir}/ZhulongSidecar/pending-application.zhj"
  local conflict_before_database_sha256
  local conflict_after_database_sha256
  local conflict_before_journal_sha256
  local conflict_after_journal_sha256
  local conflict_before_data_mode
  local conflict_current_data_mode
  local conflict_before_digest
  local conflict_after_digest
  local conflict_current_digest
  local conflict_sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$exact_dir" "$conflict_dir"

  run_terminating_ui_probe \
    "zhulong exact-after recovery setup" \
    "$exact_setup_result" \
    "$exact_setup_log" \
    --data-url "$PWD/$exact_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-exact-recovery exact-after \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$exact_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$exact_setup_result"

  if [[ ! -f "$exact_journal" ]]; then
    echo "zhulong exact-after setup did not persist its encrypted journal" >&2
    exit 1
  fi
  exact_before_database_sha256="$(
    shasum -a 256 "$exact_db" | awk '{print $1}'
  )"
  exact_before_bits="$(
    /usr/bin/plutil -extract beforeUpdatedAtBits raw -o - "$exact_state"
  )"
  exact_after_bits="$(
    /usr/bin/plutil -extract afterUpdatedAtBits raw -o - "$exact_state"
  )"
  exact_before_digest="$(
    /usr/bin/plutil -extract beforeDigest raw -o - "$exact_state"
  )"
  exact_after_digest="$(
    /usr/bin/plutil -extract afterDigest raw -o - "$exact_state"
  )"
  exact_current_digest="$(
    /usr/bin/plutil -extract currentDigest raw -o - "$exact_state"
  )"
  exact_chain_id="$(
    /usr/bin/plutil -extract chainID raw -o - "$exact_state"
  )"
  exact_definition_sequence="$(
    /usr/bin/plutil -extract definitionSequence raw -o - "$exact_state"
  )"
  if [[ ! "$exact_before_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$exact_after_digest" =~ ^[0-9a-f]{64}$ \
    || "$exact_before_digest" == "$exact_after_digest" \
    || "$exact_current_digest" != "$exact_after_digest" ]]; then
    echo "zhulong exact-after state did not distinguish its snapshot identities" >&2
    exit 1
  fi
  if [[ "$(sqlite3 -noheader :memory: "
    SELECT
      CAST('$exact_after_bits' AS INTEGER) =
      CAST('$exact_before_bits' AS INTEGER) + 1;
  ")" != "1" ]]; then
    echo "zhulong exact-after state clocks are not adjacent Date bits" >&2
    exit 1
  fi
  exact_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$exact_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       WHERE id = '$exact_chain_id'
         AND state = 'active'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND updated_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM task_definitions
       WHERE chain_id = '$exact_chain_id'
         AND sequence = CAST('$exact_definition_sequence' AS INTEGER)
         AND title = 'E2E 烛龙精确 after 时钟'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND content_updated_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND superseded_at IS NULL),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id'
         AND change_journal.changed_at_bits =
             CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id');
  ")"
  if [[ "$exact_sqlite_probe" != "1 1 1 1 1 2 1" ]]; then
    echo "zhulong exact-after SQLite bit probe failed: ${exact_sqlite_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong exact-after no-rewrite recovery" \
    "$exact_verify_result" \
    "$exact_verify_log" \
    --data-url "$PWD/$exact_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-exact-recovery exact-after \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$exact_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$exact_verify_result"

  exact_after_database_sha256="$(
    shasum -a 256 "$exact_db" | awk '{print $1}'
  )"
  if [[ "$exact_after_database_sha256" != "$exact_before_database_sha256" ]]; then
    echo "zhulong exact-after recovery rewrote the engine database" >&2
    exit 1
  fi
  if [[ -f "$exact_journal" ]]; then
    echo "zhulong exact-after recovery did not clear its journal" >&2
    exit 1
  fi
  exact_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$exact_db" "
    SELECT
      (SELECT count(*)
       FROM task_chains
       WHERE id = '$exact_chain_id'
         AND state = 'active'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND updated_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM task_definitions
       WHERE chain_id = '$exact_chain_id'
         AND sequence = CAST('$exact_definition_sequence' AS INTEGER)
         AND title = 'E2E 烛龙精确 after 时钟'
         AND created_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND content_updated_at_bits = CAST('$exact_before_bits' AS INTEGER)
         AND superseded_at IS NULL),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'
         AND changed_at_bits = CAST('$exact_after_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id'
         AND change_journal.changed_at_bits =
             CAST('$exact_before_bits' AS INTEGER)),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'taskChain'
         AND entity_id = '$exact_chain_id'),
      (SELECT count(*)
       FROM change_journal
       JOIN task_definitions
         ON task_definitions.id = change_journal.entity_id
       WHERE change_journal.entity_type = 'taskDefinition'
         AND task_definitions.chain_id = '$exact_chain_id');
  ")"
  if [[ "$exact_sqlite_probe" != "1 1 1 1 1 2 1" ]]; then
    echo "zhulong exact-after restart lost its bit reconciliation" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong local-only preference conflict setup" \
    "$conflict_setup_result" \
    "$conflict_setup_log" \
    --data-url "$PWD/$conflict_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-exact-recovery preference-conflict \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$conflict_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$conflict_setup_result"

  if [[ ! -f "$conflict_journal" ]]; then
    echo "zhulong preference-conflict setup did not persist its encrypted journal" >&2
    exit 1
  fi
  conflict_before_database_sha256="$(
    shasum -a 256 "$conflict_db" | awk '{print $1}'
  )"
  conflict_before_journal_sha256="$(
    shasum -a 256 "$conflict_journal" | awk '{print $1}'
  )"
  conflict_before_data_mode="$(
    /usr/bin/plutil -extract beforeDataMode raw -o - "$conflict_state"
  )"
  conflict_current_data_mode="$(
    /usr/bin/plutil -extract currentDataMode raw -o - "$conflict_state"
  )"
  conflict_before_digest="$(
    /usr/bin/plutil -extract beforeDigest raw -o - "$conflict_state"
  )"
  conflict_after_digest="$(
    /usr/bin/plutil -extract afterDigest raw -o - "$conflict_state"
  )"
  conflict_current_digest="$(
    /usr/bin/plutil -extract currentDigest raw -o - "$conflict_state"
  )"
  if [[ "$conflict_before_data_mode" != "localFirst" \
    || "$conflict_current_data_mode" != "onlineFirst" \
    || ! "$conflict_before_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$conflict_after_digest" =~ ^[0-9a-f]{64}$ \
    || ! "$conflict_current_digest" =~ ^[0-9a-f]{64}$ \
    || "$conflict_before_digest" == "$conflict_after_digest" \
    || "$conflict_before_digest" == "$conflict_current_digest" \
    || "$conflict_after_digest" == "$conflict_current_digest" ]]; then
    echo "zhulong preference-conflict state did not isolate local-only data mode" >&2
    exit 1
  fi
  conflict_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$conflict_db" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*)
       FROM task_chains),
      (SELECT count(*)
       FROM task_definitions),
      (SELECT count(*)
       FROM day_traces),
      (SELECT count(*)
       FROM subtasks),
      (SELECT count(*)
       FROM change_journal),
      (SELECT count(*)
       FROM app_preferences
       WHERE id = 1
         AND theme = 'coolGray'
         AND language = 'chinese'
         AND theme_language_writer_id = 'noonmark.bootstrap'),
      (SELECT count(*)
       FROM sync_settings
       WHERE
         (key = 'app.backup.frequency' AND value = 'off')
         OR (key = 'app.backup.destination' AND value = 'iCloudDrive')
         OR (key = 'app.local_first_sync.enabled' AND value = 'false')
         OR (key = 'app.local_first_sync.endpoint' AND value = 'iCloud')
         OR (key = 'app.local_first_sync.mode' AND value = 'manual')
         OR (key = 'app.local_first_sync.interval_seconds' AND value = '300')
         OR (key = 'app.local_first_sync.generate_conflict_copy' AND value = 'true')
         OR (key = 'app.local_first_sync.retention_days' AND value = '180')
         OR (key = 'app.local_first_sync.retention_daily' AND value = '2')
         OR (key = 'app.settings_poem.enabled' AND value = 'true')
         OR (key = 'app.settings_poem.text' AND length(value) > 0)),
      (SELECT count(*) FROM sync_settings);
  ")"
  if [[ "$conflict_sqlite_probe" != "onlineFirst 0 0 0 0 0 1 11 12" ]]; then
    echo "zhulong preference-conflict third-snapshot probe failed: ${conflict_sqlite_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "zhulong local-only preference recovery conflict" \
    "$conflict_verify_result" \
    "$conflict_verify_log" \
    --data-url "$PWD/$conflict_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-exact-recovery preference-conflict \
    --e2e-zhulong-exact-recovery-state-url "$PWD/$conflict_state" \
    --e2e-zhulong-exact-recovery-result-url "$PWD/$conflict_verify_result"

  conflict_after_database_sha256="$(
    shasum -a 256 "$conflict_db" | awk '{print $1}'
  )"
  if [[ "$conflict_after_database_sha256" != "$conflict_before_database_sha256" ]]; then
    echo "zhulong preference conflict changed the engine database" >&2
    exit 1
  fi
  if [[ ! -f "$conflict_journal" ]]; then
    echo "zhulong preference conflict incorrectly cleared its journal" >&2
    exit 1
  fi
  conflict_after_journal_sha256="$(
    shasum -a 256 "$conflict_journal" | awk '{print $1}'
  )"
  if [[ "$conflict_after_journal_sha256" != "$conflict_before_journal_sha256" ]]; then
    echo "zhulong preference conflict rewrote its retained journal" >&2
    exit 1
  fi
  conflict_sqlite_probe="$(sqlite3 -noheader -separator ' ' "$conflict_db" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*)
       FROM task_chains),
      (SELECT count(*)
       FROM task_definitions),
      (SELECT count(*)
       FROM day_traces),
      (SELECT count(*)
       FROM subtasks),
      (SELECT count(*)
       FROM change_journal),
      (SELECT count(*)
       FROM app_preferences
       WHERE id = 1
         AND theme = 'coolGray'
         AND language = 'chinese'
         AND theme_language_writer_id = 'noonmark.bootstrap'),
      (SELECT count(*)
       FROM sync_settings
       WHERE
         (key = 'app.backup.frequency' AND value = 'off')
         OR (key = 'app.backup.destination' AND value = 'iCloudDrive')
         OR (key = 'app.local_first_sync.enabled' AND value = 'false')
         OR (key = 'app.local_first_sync.endpoint' AND value = 'iCloud')
         OR (key = 'app.local_first_sync.mode' AND value = 'manual')
         OR (key = 'app.local_first_sync.interval_seconds' AND value = '300')
         OR (key = 'app.local_first_sync.generate_conflict_copy' AND value = 'true')
         OR (key = 'app.local_first_sync.retention_days' AND value = '180')
         OR (key = 'app.local_first_sync.retention_daily' AND value = '2')
         OR (key = 'app.settings_poem.enabled' AND value = 'true')
         OR (key = 'app.settings_poem.text' AND length(value) > 0)),
      (SELECT count(*) FROM sync_settings);
  ")"
  if [[ "$conflict_sqlite_probe" != "onlineFirst 0 0 0 0 0 1 11 12" ]]; then
    echo "zhulong preference conflict applied the pending after snapshot" >&2
    exit 1
  fi

  echo "E2E Zhulong exact identity recovery and local-only preference conflict: $evidence_dir"
}

run_zhulong_pending_gate_probe() (
  local evidence_dir="artifacts/e2e-zhulong-pending-gate"
  local database="${evidence_dir}/Noonmark.sqlite"
  local sidecar_dir="${evidence_dir}/ZhulongSidecar"
  local journal="${sidecar_dir}/pending-application.zhj"
  local setup_result="${evidence_dir}/setup-result.txt"
  local setup_log="${evidence_dir}/setup.log"
  local verify_result="${evidence_dir}/verify-result.txt"
  local verify_log="${evidence_dir}/verify.log"
  local sqlite_lock_fifo="${evidence_dir}/sqlite-lock.fifo"
  local sqlite_lock_ready="${evidence_dir}/sqlite-lock-ready"
  local sqlite_lock_log="${evidence_dir}/sqlite-lock.log"
  local session_file
  local session_count
  local before_database_sha256
  local before_journal_sha256
  local before_session_sha256
  local after_database_sha256
  local after_journal_sha256
  local after_session_sha256
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  trap 'stop_sqlite_write_lock_holder >/dev/null 2>&1 || true' EXIT

  run_terminating_ui_probe \
    "zhulong pending-gate bootstrap setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$database" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-setup-zhulong-pending-gate \
    --e2e-zhulong-pending-gate-result-url "$PWD/$setup_result"

  if [[ ! -f "$journal" ]]; then
    echo "zhulong pending-gate setup did not retain its journal" >&2
    exit 1
  fi
  session_count="$(find "$sidecar_dir" -type f -name '*.zhs' | wc -l | tr -d ' ')"
  if [[ "$session_count" -ne 1 ]]; then
    echo "zhulong pending-gate setup expected one Session: $session_count" >&2
    exit 1
  fi
  session_file="$(find "$sidecar_dir" -type f -name '*.zhs' -print -quit)"
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT value
       FROM sync_settings
       WHERE key = 'app.data_mode'),
      (SELECT count(*) FROM days),
      (SELECT count(*) FROM task_chains),
      (SELECT count(*) FROM task_definitions),
      (SELECT count(*) FROM day_traces),
      (SELECT count(*) FROM subtasks),
      (SELECT count(*)
       FROM change_journal
       WHERE entity_type = 'appPreferences'
         AND entity_id = 'default'
         AND operation = 'upsert'
         AND device_id = 'noonmark.bootstrap'
         AND sync_state = 'pendingUpload'
         AND retry_count = 0
         AND COALESCE(last_error, '') = ''
         AND json_extract(record_payload, '$.formatVersion') = 6
         AND json_extract(record_payload, '$.payload.theme') = 'coolGray'
         AND json_extract(record_payload, '$.payload.language') = 'chinese'
         AND json_extract(
               record_payload,
               '$.payload.writerDeviceID.rawValue'
             ) = 'noonmark.bootstrap'),
      (SELECT count(*) FROM change_journal),
      (SELECT count(*)
       FROM sync_metadata
       WHERE key = 'localFirst.sync.baselineManifest'
         AND json_valid(value) = 1
         AND json_extract(value, '$.state') = 'pending'
         AND json_array_length(
               json_extract(value, '$.expectations')
             ) = 1);
  ")"
  if [[ "$sqlite_probe" != "onlineFirst 0 0 0 0 0 1 1 1" ]]; then
    echo "zhulong pending-gate setup lost its empty Engine or exact import baseline: ${sqlite_probe:-missing}" >&2
    exit 1
  fi

  before_database_sha256="$(shasum -a 256 "$database" | awk '{print $1}')"
  before_journal_sha256="$(shasum -a 256 "$journal" | awk '{print $1}')"
  before_session_sha256="$(shasum -a 256 "$session_file" | awk '{print $1}')"

  if ! start_sqlite_write_lock_holder \
    "$database" \
    "$sqlite_lock_fifo" \
    "$sqlite_lock_ready" \
    "$sqlite_lock_log"; then
    echo "failed to hold the pending-gate SQLite write lock" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi

  # A WAL writer lock permits Store bootstrap reads but turns any attempted
  # bootstrap save into a real startup failure. The pending journal must make
  # loadOrSeed skip that ordinary write and proceed to exact recovery instead.
  run_terminating_ui_probe \
    "zhulong bootstrap and Engine writer pending gate" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$PWD/$database" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-zhulong-sidecar-key \
    --e2e-verify-zhulong-pending-gate \
    --e2e-zhulong-pending-gate-result-url "$PWD/$verify_result"

  if ! stop_sqlite_write_lock_holder; then
    echo "pending-gate SQLite lock holder failed" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi

  after_database_sha256="$(shasum -a 256 "$database" | awk '{print $1}')"
  after_journal_sha256="$(shasum -a 256 "$journal" | awk '{print $1}')"
  after_session_sha256="$(shasum -a 256 "$session_file" | awk '{print $1}')"
  if [[ "$after_database_sha256" != "$before_database_sha256" \
    || "$after_journal_sha256" != "$before_journal_sha256" \
    || "$after_session_sha256" != "$before_session_sha256" ]]; then
    echo "zhulong pending gate changed Engine, journal, or Session bytes" >&2
    exit 1
  fi

  echo "E2E Zhulong bootstrap/direct-save/rollover/import/sync pending gate: $evidence_dir"
)

automatic_classification_e2e_credential_state() {
  local find_status=0
  security find-generic-password \
    -s app.noonmark.zhulong.provider.e2e \
    >/dev/null 2>&1 || find_status=$?
  return "$find_status"
}

automatic_classification_e2e_defaults_state() {
  local defaults_output=""
  if defaults_output="$(
    defaults read \
      app.noonmark.mac.e2e \
      noonmark.zhulong.provider.config \
      2>&1
  )"; then
    return 0
  fi
  if [[ "$defaults_output" == *"does not exist"* ]]; then
    return 44
  fi
  return 1
}

clear_automatic_classification_e2e_credentials() {
  local deletion_count=0
  local credential_state=0
  local defaults_state=0
  while true; do
    credential_state=0
    automatic_classification_e2e_credential_state || credential_state=$?
    if [[ "$credential_state" -eq 44 ]]; then
      break
    fi
    if [[ "$credential_state" -ne 0 ]]; then
      echo "automatic classification E2E Keychain state could not be read" >&2
      return 1
    fi
    security delete-generic-password \
      -s app.noonmark.zhulong.provider.e2e \
      >/dev/null 2>&1
    deletion_count=$((deletion_count + 1))
    if [[ "$deletion_count" -ge 64 ]]; then
      echo "automatic classification E2E Keychain cleanup exceeded its bound" >&2
      return 1
    fi
  done
  defaults_state=0
  automatic_classification_e2e_defaults_state || defaults_state=$?
  if [[ "$defaults_state" -eq 0 ]]; then
    defaults delete \
      app.noonmark.mac.e2e \
      noonmark.zhulong.provider.config \
      >/dev/null 2>&1
  elif [[ "$defaults_state" -ne 44 ]]; then
    echo "automatic classification E2E Provider defaults could not be read" >&2
    return 1
  fi
  assert_automatic_classification_e2e_credentials_cleared
}

assert_automatic_classification_e2e_credentials_cleared() {
  local credential_state=0
  local defaults_state=0
  automatic_classification_e2e_credential_state || credential_state=$?
  if [[ "$credential_state" -eq 0 ]]; then
    echo "automatic classification E2E Keychain credential was not cleared" >&2
    return 1
  fi
  if [[ "$credential_state" -ne 44 ]]; then
    echo "automatic classification E2E Keychain cleanup could not be verified" >&2
    return 1
  fi
  defaults_state=0
  automatic_classification_e2e_defaults_state || defaults_state=$?
  if [[ "$defaults_state" -eq 0 ]]; then
    echo "automatic classification E2E Provider defaults were not cleared" >&2
    return 1
  fi
  if [[ "$defaults_state" -ne 44 ]]; then
    echo "automatic classification E2E Provider cleanup could not be verified" >&2
    return 1
  fi
}

start_automatic_classification_e2e_provider() {
  local ready_file="$1"
  local count_file="$2"
  local health_count_file="$3"
  local log_file="$4"
  local -a provider_arguments=(
    --ready-file "$ready_file"
    --count-file "$count_file"
  )
  shift 4

  if [[ "$health_count_file" != "-" ]]; then
    provider_arguments+=(--health-count-file "$health_count_file")
  fi
  provider_arguments+=("$@")
  scripts/automatic-classification-provider-stub.py \
    "${provider_arguments[@]}" >"$log_file" 2>&1 &
  provider_pid=$!

  for _ in {1..100}; do
    [[ -s "$ready_file" ]] && break
    kill -0 "$provider_pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ ! -s "$ready_file" ]]; then
    echo "automatic classification deterministic Provider did not become ready" >&2
    cat "$log_file" >&2
    exit 1
  fi
  provider_port="$(<"$ready_file")"
  if [[ ! "$provider_port" =~ ^[0-9]+$ ]] \
    || (( provider_port < 1 || provider_port > 65535 )); then
    echo "automatic classification deterministic Provider returned an invalid port" >&2
    exit 1
  fi
}

assert_automatic_classification_provider_count() {
  local label="$1"
  local count_file="$2"
  local expected="$3"
  if [[ ! -f "$count_file" || "$(<"$count_file")" != "$expected" ]]; then
    echo "$label expected $expected requests, observed $(cat "$count_file" 2>/dev/null || echo missing)" >&2
    exit 1
  fi
}

assert_automatic_classification_diagnostic() {
  local label="$1"
  local log_file="$2"
  local pattern="$3"
  if [[ ! -f "$log_file" ]] || ! grep -E -q "$pattern" "$log_file"; then
    echo "$label diagnostic was not recorded: $pattern" >&2
    cat "$log_file" >&2 2>/dev/null || true
    exit 1
  fi
}

run_automatic_classification_operational_clock_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/operational-clock"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local app_log="${evidence_dir}/app.log"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  scripts/automatic-classification-provider-stub.py \
    --ready-file "$PWD/$provider_ready" \
    --count-file "$PWD/$provider_count" \
    >"$provider_log" 2>&1 &
  provider_pid=$!
  for _ in {1..100}; do
    [[ -s "$provider_ready" ]] && break
    kill -0 "$provider_pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ ! -s "$provider_ready" ]]; then
    echo "automatic classification deterministic Provider did not become ready" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  provider_port="$(<"$provider_ready")"
  if [[ ! "$provider_port" =~ ^[0-9]+$ ]] \
    || (( provider_port < 1 || provider_port > 65535 )); then
    echo "automatic classification deterministic Provider returned an invalid port" >&2
    exit 1
  fi

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification future domain frontier" \
      "$result" \
      "$app_log" \
      --data-url "$PWD/$database" \
      --page day \
      --e2e-automatic-classification-operational-clock \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if [[ "$(<"$provider_count")" != "1" ]]; then
    echo "future-frontier classification did not make exactly one Provider request" >&2
    exit 1
  fi
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    WITH target AS (
      SELECT chain.id AS chain_id, definition.created_at,
             definition.created_at_bits
      FROM task_chains AS chain
      JOIN task_definitions AS definition
        ON definition.chain_id = chain.id
      WHERE definition.title = 'E2E 未来前沿自动归类'
        AND definition.superseded_at IS NULL
    ), seed AS (
      SELECT definition.created_at, definition.created_at_bits
      FROM task_definitions AS definition
      WHERE definition.title = 'E2E 未来领域时钟前沿'
        AND definition.superseded_at IS NULL
    ), automatic_change AS (
      SELECT record.record_id
      FROM classification_change_records AS record
      JOIN classification_change_record_changes AS change
        ON change.record_id = record.record_id
      JOIN target ON target.chain_id = change.chain_id
      WHERE change.kind = 'setCurrent'
        AND record.source_kind = 'automaticAI'
    )
    SELECT
      job.state,
      job.attempt,
      target.created_at_bits > seed.created_at_bits,
      job.created_at < unixepoch(seed.created_at) - 978307200,
      job.available_at < unixepoch(seed.created_at) - 978307200,
      job.terminal_at < unixepoch(seed.created_at) - 978307200,
      (SELECT count(*)
       FROM change_journal AS journal
       WHERE journal.entity_id = target.chain_id
         AND journal.changed_at_bits > seed.created_at_bits),
      (SELECT count(*) FROM automatic_change),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       WHERE fact.chain_id = target.chain_id
         AND fact.kind = 'category'
         AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       WHERE fact.chain_id = target.chain_id
         AND fact.kind = 'label'
         AND fact.source_kind = 'automaticAI')
    FROM target, seed
    JOIN automatic_classification_jobs AS job
      ON job.chain_id = target.chain_id;
  ")"
  if [[ "$sqlite_probe" != "completed 1 1 1 1 1 1 1 1 2" ]]; then
    echo "automatic classification operational/domain clock probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification future domain frontier: $database (probe=$sqlite_probe)"
)

run_automatic_classification_checkpoint_restart_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/checkpoint-restart"
  local database="${evidence_dir}/Noonmark.sqlite"
  local state="${evidence_dir}/state.json"
  local setup_result="${evidence_dir}/setup-result.txt"
  local verify_result="${evidence_dir}/verify-result.txt"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local checkpoint_probe
  local completion_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  scripts/automatic-classification-provider-stub.py \
    --ready-file "$PWD/$provider_ready" \
    --count-file "$PWD/$provider_count" \
    >"$provider_log" 2>&1 &
  provider_pid=$!
  for _ in {1..100}; do
    [[ -s "$provider_ready" ]] && break
    kill -0 "$provider_pid" 2>/dev/null || break
    sleep 0.05
  done
  if [[ ! -s "$provider_ready" ]]; then
    echo "checkpoint deterministic Provider did not become ready" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  provider_port="$(<"$provider_ready")"
  if [[ ! "$provider_port" =~ ^[0-9]+$ ]] \
    || (( provider_port < 1 || provider_port > 65535 )); then
    echo "checkpoint deterministic Provider returned an invalid port" >&2
    exit 1
  fi

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification checkpoint setup" \
      "$setup_result" \
      "${evidence_dir}/setup.log" \
      --data-url "$PWD/$database" \
      --page day \
      --e2e-automatic-classification-checkpoint-setup \
      --e2e-automatic-classification-state-url "$PWD/$state" \
      --e2e-automatic-classification-result-url "$PWD/$setup_result"

  checkpoint_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT state, attempt, proposal_checkpoint IS NOT NULL
    FROM automatic_classification_jobs;
  ")"
  if [[ "$checkpoint_probe" != "proposalReady 1 1" \
    || "$(<"$provider_count")" != "1" \
    || ! -s "$state" ]]; then
    echo "automatic classification checkpoint setup probe failed: ${checkpoint_probe:-missing}" >&2
    exit 1
  fi

  # Phase two deliberately starts without Provider credentials. A durable
  # proposalReady checkpoint must remain locally consumable while the provider
  # circuit is unconfigured, without issuing a second paid request.
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared

  kill "$provider_pid" >/dev/null 2>&1 || true
  wait "$provider_pid" 2>/dev/null || true
  provider_pid=""

  run_terminating_ui_probe \
    "automatic classification checkpoint restart" \
    "$verify_result" \
    "${evidence_dir}/verify.log" \
    --data-url "$PWD/$database" \
    --page day \
    --e2e-automatic-classification-checkpoint-verify \
    --e2e-automatic-classification-state-url "$PWD/$state" \
    --e2e-automatic-classification-result-url "$PWD/$verify_result"

  completion_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      job.state,
      job.attempt,
      job.proposal_checkpoint IS NULL,
      job.terminal_at IS NOT NULL,
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       WHERE fact.chain_id = job.chain_id
         AND fact.kind = 'category'
         AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       WHERE fact.chain_id = job.chain_id
         AND fact.kind = 'label'
         AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NULL
         AND failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1)
    FROM automatic_classification_jobs AS job;
  ")"
  if [[ "$completion_probe" != "completed 2 1 1 1 2 unconfigured 1" \
    || "$(<"$provider_count")" != "1" ]]; then
    echo "automatic classification checkpoint restart repeated or failed: ${completion_probe:-missing}" >&2
    exit 1
  fi
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification checkpoint restart without repeated Provider: $database"
)

run_automatic_classification_backlog_start_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/backlog-start"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local request_received="${evidence_dir}/request-received.txt"
  local response_release="${evidence_dir}/response-release.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --request-received-file "$PWD/$request_received" \
    --response-gate-file "$PWD/$response_release"

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification exact backlog authorization" \
      "$result" \
      "${evidence_dir}/app.log" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-backlog-start \
      --e2e-provider-request-received-url "$PWD/$request_received" \
      --e2e-provider-response-release-url "$PWD/$response_release" \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "backlog-start Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "backlog-start classification" "$provider_count" 3
  assert_automatic_classification_provider_count \
    "backlog-start health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed'),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'superseded' AND generation = 1 AND attempt = 1
         AND error_code = 'contentOrCatalogChanged'
         AND dispatch_authorization = 'explicit'
         AND authorization_id IS NOT NULL AND authorized_at IS NOT NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 2 AND attempt = 1
         AND error_code IS NULL AND dispatch_authorization = 'explicit'
         AND authorization_id IS NOT NULL AND authorized_at IS NOT NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE dispatch_authorization = 'explicit'
         AND authorization_id IS NOT NULL AND authorized_at IS NOT NULL),
      (SELECT count(DISTINCT chain_id) FROM automatic_classification_jobs
       WHERE dispatch_authorization = 'explicit'),
      (SELECT count(DISTINCT authorization_id)
       FROM automatic_classification_jobs
       WHERE dispatch_authorization = 'explicit'),
      (SELECT count(DISTINCT authorized_at)
       FROM automatic_classification_jobs
       WHERE dispatch_authorization = 'explicit'),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 1 AND attempt = 1
         AND error_code IS NULL AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       WHERE fact.kind = 'category' AND fact.source_kind = 'automaticAI'),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       WHERE fact.kind = 'label' AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "5 3 2 2 4 2 1 1 1 3 6 closed 0 1 1" ]]; then
    echo "automatic classification backlog-start SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification exact backlog authorization: $database (probe=$sqlite_probe)"
)

run_automatic_classification_backlog_later_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/backlog-later"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log"

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification later backlog decision" \
      "$result" \
      "${evidence_dir}/app.log" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-backlog-later \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "backlog-later Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "backlog-later classification" "$provider_count" 1
  assert_automatic_classification_provider_count \
    "backlog-later health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'waitingForConfiguration'
         AND dispatch_authorization = 'pendingUserDecision'
         AND attempt = 0 AND error_code IS NULL
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND terminal_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND dispatch_authorization = 'automatic'
         AND attempt = 1 AND error_code IS NULL
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE job.state = 'waitingForConfiguration'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE job.state = 'completed' AND fact.kind = 'category'
         AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE job.state = 'completed' AND fact.kind = 'label'
         AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "3 2 1 0 1 2 closed 0 1 1" ]]; then
    echo "automatic classification backlog-later SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification later session decision: $database (probe=$sqlite_probe)"
)

run_automatic_classification_future_only_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/future-only"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log"

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification future-only backlog decision" \
      "$result" \
      "${evidence_dir}/app.log" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-future-only \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "future-only Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "future-only classification" "$provider_count" 1
  assert_automatic_classification_provider_count \
    "future-only health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    WITH manual_job AS (
      SELECT chain_id FROM automatic_classification_jobs
      WHERE state = 'superseded' AND error_code = 'manualClassificationWon'
    )
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'superseded'
         AND dispatch_authorization = 'pendingUserDecision'
         AND attempt = 0 AND error_code = 'manualClassificationWon'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'superseded'
         AND dispatch_authorization = 'pendingUserDecision'
         AND attempt = 0 AND error_code = 'contentOrCatalogChanged'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'cancelled'
         AND dispatch_authorization = 'pendingUserDecision'
         AND attempt = 0 AND error_code = 'backlogSkippedByUser'
         AND cancelled_by_undo = 0
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND dispatch_authorization = 'automatic'
         AND attempt = 1 AND error_code IS NULL
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       JOIN manual_job ON manual_job.chain_id = fact.chain_id),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       JOIN manual_job ON manual_job.chain_id = fact.chain_id
       WHERE fact.source_kind = 'userDirect'),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       JOIN manual_job ON manual_job.chain_id = fact.chain_id
       WHERE fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE job.state = 'completed' AND fact.kind = 'category'
         AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE job.state = 'completed' AND fact.kind = 'label'
         AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "4 1 1 1 1 2 2 0 1 2 closed 0 1" ]]; then
    echo "automatic classification future-only SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification future-only and manual priority: $database (probe=$sqlite_probe)"
)

run_automatic_classification_failed_edit_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/failed-edit"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local app_log="${evidence_dir}/app.log"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --post-outcomes 200,200 \
    --post-content-outcomes malformed,valid

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification failed job user edit replacement" \
      "$result" \
      "$app_log" \
      --data-url "$PWD/$database" \
      --page pool \
      --e2e-automatic-classification-failed-edit \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "failed-edit Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "failed-edit classification" "$provider_count" 2
  assert_automatic_classification_provider_count \
    "failed-edit health" "$health_count" 0
  assert_automatic_classification_diagnostic \
    "failed-edit normalized Provider outcome" "$app_log" \
    'event=provider-outcome code=invalid-response'
  assert_automatic_classification_diagnostic \
    "failed-edit replacement fence" "$app_log" \
    'event=job-mutation kind=replace'
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    WITH target_chain AS (
      SELECT chain_id FROM task_definitions
      WHERE title = 'E2E 失败后编辑自动归类'
        AND superseded_at IS NULL
    )
    SELECT
      (SELECT count(*) FROM target_chain),
      (SELECT count(*) FROM task_definitions
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND description_text = 'E2E 用户编辑后的任务描述'
         AND superseded_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND state = 'superseded' AND generation = 1 AND attempt = 1
         AND error_code = 'contentOrCatalogChanged'
         AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND claim_id IS NOT NULL AND claimed_at IS NOT NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND state = 'completed' AND generation = 2 AND attempt = 1
         AND error_code IS NULL AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND claim_id IS NOT NULL AND claimed_at IS NOT NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND state = 'failed'),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(DISTINCT id) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)),
      (SELECT count(DISTINCT content_digest)
       FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)),
      (SELECT sum(attempt) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target_chain)),
      (SELECT count(*) FROM classification_current_relation_facts
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND source_kind = 'automaticAI'),
      (SELECT count(*) FROM classification_current_relation_facts
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND kind = 'category' AND source_kind = 'automaticAI'),
      (SELECT count(*) FROM classification_current_relation_facts
       WHERE chain_id IN (SELECT chain_id FROM target_chain)
         AND kind = 'label' AND source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures
       FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "1 1 2 1 1 0 2 2 2 2 3 1 2 closed 0 1 1" ]]; then
    echo "automatic classification failed-edit SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification failed job edit replacement: $database (probe=$sqlite_probe)"
)

run_automatic_classification_status_surfaces_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/status-surfaces"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local screenshot="${evidence_dir}/status-surfaces.png"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --post-outcomes 200,200 \
    --post-content-outcomes malformed,valid

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 \
    NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification cross-page status AX" \
      "$result" \
      "${evidence_dir}/app.log" \
      --data-url "$PWD/$database" \
      --page day \
      --e2e-fixed-instant 2026-07-05T16:00:00Z \
      --e2e-fixed-time-zone America/New_York \
      --e2e-fixed-locale zh_Hans_SG \
      --e2e-automatic-classification-status-surfaces \
      --e2e-automatic-classification-status-screenshot-url "$PWD/$screenshot" \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if [[ ! -s "$screenshot" ]]; then
    echo "automatic classification status-surfaces screenshot was not created" >&2
    exit 1
  fi

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "status-surfaces Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "status-surfaces classification" "$provider_count" 2
  assert_automatic_classification_provider_count \
    "status-surfaces health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    WITH target AS (
      SELECT chain_id, title
      FROM task_definitions
      WHERE title IN (
        'E2E 自动归类状态未完成',
        'E2E 自动归类状态已完成',
        'E2E 自动归类状态子任务父项',
        'E2E 自动归类状态失败重试'
      ) AND superseded_at IS NULL
    ), failed_chain AS (
      SELECT chain_id FROM target
      WHERE title = 'E2E 自动归类状态失败重试'
    ), edited_backlog_chain AS (
      SELECT chain_id FROM target
      WHERE title = 'E2E 自动归类状态已完成'
    ), backlog_chains AS (
      SELECT chain_id FROM target
      WHERE title != 'E2E 自动归类状态失败重试'
    )
    SELECT
      (SELECT count(*) FROM target),
      (SELECT count(*) FROM day_traces
       WHERE chain_id IN (SELECT chain_id FROM target)),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN target ON target.chain_id = trace.chain_id
       WHERE target.title IN (
         'E2E 自动归类状态未完成',
         'E2E 自动归类状态子任务父项'
       ) AND trace.date = '2026-07-05'
         AND trace.status = 'unfinished' AND trace.settled_at IS NOT NULL),
      (SELECT count(*)
       FROM day_traces AS trace
       JOIN target ON target.chain_id = trace.chain_id
       WHERE target.title IN (
         'E2E 自动归类状态已完成',
         'E2E 自动归类状态失败重试'
       ) AND trace.date = '2026-07-05'
         AND trace.status = 'completed' AND trace.completed_at IS NOT NULL),
      (SELECT count(*)
       FROM subtasks AS subtask
       JOIN day_traces AS trace ON trace.id = subtask.trace_id
       JOIN target ON target.chain_id = trace.chain_id
       WHERE target.title = 'E2E 自动归类状态子任务父项'
         AND subtask.title = 'E2E 自动归类状态已完成子任务'
         AND subtask.status = 'completed'
         AND subtask.completed_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target)),
      (SELECT count(*) FROM automatic_classification_jobs AS job
       WHERE job.chain_id IN (SELECT chain_id FROM backlog_chains)
         AND NOT EXISTS (
           SELECT 1 FROM automatic_classification_jobs AS newer
           WHERE newer.chain_id = job.chain_id
             AND newer.generation > job.generation
         )
         AND job.state = 'waitingForConfiguration'
         AND job.dispatch_authorization = 'pendingUserDecision'
         AND job.attempt = 0 AND job.claim_id IS NULL
         AND job.claimed_at IS NULL AND job.authorization_id IS NULL
         AND job.authorized_at IS NULL AND job.error_code IS NULL
         AND job.proposal_checkpoint IS NULL AND job.terminal_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM edited_backlog_chain)
         AND generation = 1 AND state = 'superseded' AND attempt = 0
         AND error_code = 'contentOrCatalogChanged'
         AND dispatch_authorization = 'pendingUserDecision'
         AND claim_id IS NULL AND claimed_at IS NULL
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM edited_backlog_chain)
         AND generation = 2 AND state = 'waitingForConfiguration'
         AND dispatch_authorization = 'pendingUserDecision'
         AND attempt = 0 AND error_code IS NULL
         AND claim_id IS NULL AND claimed_at IS NULL
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM failed_chain)
         AND generation = 1 AND state = 'superseded' AND attempt = 2
         AND error_code = 'contentOrCatalogChanged'
         AND dispatch_authorization = 'automatic'
         AND claim_id IS NOT NULL AND claimed_at IS NOT NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM failed_chain)
         AND generation = 2 AND state = 'completed' AND attempt = 1
         AND error_code IS NULL AND dispatch_authorization = 'automatic'
         AND claim_id IS NOT NULL AND claimed_at IS NOT NULL
         AND proposal_checkpoint IS NULL AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE chain_id IN (SELECT chain_id FROM target)
         AND state IN ('ready', 'running', 'proposalReady', 'failed')),
      (SELECT count(*) FROM classification_current_relation_facts
       WHERE chain_id IN (SELECT chain_id FROM failed_chain)
         AND kind = 'category' AND source_kind = 'automaticAI'),
      (SELECT count(*) FROM classification_current_relation_facts
       WHERE chain_id IN (SELECT chain_id FROM failed_chain)
         AND kind = 'label' AND source_kind = 'automaticAI'),
      (SELECT count(*) FROM days
       WHERE date = '2026-07-05' AND locked_at IS NOT NULL),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT consecutive_failures = 0 AND failure_code IS NULL
         AND retry_at IS NULL AND probe_job_id IS NULL
         AND probe_generation IS NULL AND probe_attempt IS NULL
         AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "4 4 2 2 1 6 3 1 1 1 1 0 1 2 1 unconfigured 1 1" ]]; then
    echo "automatic classification status-surfaces SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification status AX surfaces: $database (probe=$sqlite_probe screenshot=$screenshot)"
)

run_automatic_classification_provider_block_retry_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/provider-block-retry"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local app_log="${evidence_dir}/app.log"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --post-outcomes 401,200,200,200 \
    --health-outcomes 200

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification blocked Provider health retry" \
      "$result" \
      "$app_log" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-provider-block-retry \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "provider-block-retry Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "provider-block-retry classification" "$provider_count" 4
  assert_automatic_classification_provider_count \
    "provider-block-retry health" "$health_count" 1
  assert_automatic_classification_diagnostic \
    "Provider rejection outcome" "$app_log" \
    'event=provider-outcome code=credentials-rejected'
  assert_automatic_classification_diagnostic \
    "blocked circuit snapshot" "$app_log" \
    'event=snapshot .*state=blocked .*failure=providerRejected'
  assert_automatic_classification_diagnostic \
    "manual circuit health retry" "$app_log" \
    'event=circuit-manual-retry phase=succeeded'
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND error_code IS NULL
         AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'superseded' AND generation = 1 AND attempt = 1
         AND error_code = 'contentOrCatalogChanged'
         AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 2 AND attempt = 1
         AND error_code IS NULL AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 1 AND attempt = 2
         AND error_code IS NULL AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND terminal_at IS NOT NULL),
      (SELECT count(*) FROM automatic_classification_jobs WHERE attempt = 2),
      (SELECT count(*) FROM automatic_classification_jobs WHERE attempt = 1),
      (SELECT sum(attempt) FROM automatic_classification_jobs),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       WHERE fact.kind = 'category' AND fact.source_kind = 'automaticAI'),
      (SELECT count(*) FROM classification_current_relation_facts AS fact
       WHERE fact.kind = 'label' AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "5 3 2 2 1 1 4 6 3 6 closed 0 1 1" ]]; then
    echo "automatic classification provider-block-retry SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification global block and health retry: $database (probe=$sqlite_probe)"
)

run_automatic_classification_provider_transient_circuit_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/provider-transient-circuit"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local app_log="${evidence_dir}/app.log"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local gate_directory="${evidence_dir}/provider-gates"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir" "$gate_directory"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --post-outcomes 429,503,503 \
    --response-gate-directory "$PWD/$gate_directory"

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    run_terminating_ui_probe \
      "automatic classification transient Provider circuit" \
      "$result" \
      "$app_log" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-provider-transient-circuit \
      --e2e-provider-gate-directory "$PWD/$gate_directory" \
      --e2e-automatic-classification-retry-delays-ms 100,100,100 \
      --e2e-automatic-classification-result-url "$PWD/$result"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "provider-transient-circuit Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "provider-transient-circuit classification" "$provider_count" 3
  assert_automatic_classification_provider_count \
    "provider-transient-circuit health" "$health_count" 0
  assert_automatic_classification_diagnostic \
    "rate-limit cooldown" "$app_log" \
    'event=provider-outcome code=rate-limited .*retry_at_bits=[0-9]+'
  assert_automatic_classification_diagnostic \
    "global transient circuit" "$app_log" \
    'event=snapshot .*state=blocked .*failure=providerUnavailable .*failures=3'
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'ready' AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE attempt = 3 AND error_code = 'providerUnavailable'
         AND terminal_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE attempt = 0 AND error_code IS NULL AND terminal_at IS NULL),
      (SELECT sum(attempt) FROM automatic_classification_jobs),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT failure_code FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT retry_at IS NULL AND probe_job_id IS NULL
         AND probe_generation IS NULL AND probe_attempt IS NULL
         AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "4 4 1 3 3 0 blocked providerUnavailable 3 1 1" ]]; then
    echo "automatic classification provider-transient-circuit SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification bounded global transient circuit: $database (probe=$sqlite_probe)"
)

run_automatic_classification_contention_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/contention"
  local database="${evidence_dir}/Noonmark.sqlite"
  local state="${evidence_dir}/state.json"
  local setup_result="${evidence_dir}/setup-result.txt"
  local setup_log="${evidence_dir}/setup.log"
  local verify_result="${evidence_dir}/verify-result.txt"
  local verify_log="${evidence_dir}/verify.log"
  local contention_marker="${evidence_dir}/contention-marker.txt"
  local sqlite_lock_fifo="${evidence_dir}/sqlite-lock.fifo"
  local sqlite_lock_ready="${evidence_dir}/sqlite-lock-ready"
  local sqlite_lock_log="${evidence_dir}/sqlite-lock.log"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local provider_configuration_persisted=0
  local app_pid=""
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
      kill "$app_pid" >/dev/null 2>&1 || true
      wait "$app_pid" 2>/dev/null || true
    fi
    stop_sqlite_write_lock_holder >/dev/null 2>&1 || true
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  run_terminating_ui_probe \
    "automatic classification contention setup" \
    "$setup_result" \
    "$setup_log" \
    --data-url "$PWD/$database" \
    --page settings \
    --e2e-automatic-classification-contention-setup \
    --e2e-automatic-classification-state-url "$PWD/$state" \
    --e2e-automatic-classification-result-url "$PWD/$setup_result" \
    --e2e-quit-after-automation

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log"

  rm -f "$contention_marker" "$verify_result"
  if ! start_sqlite_write_lock_holder \
    "$database" \
    "$sqlite_lock_fifo" \
    "$sqlite_lock_ready" \
    "$sqlite_lock_log"; then
    echo "failed to hold automatic classification SQLite write lock" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    "$app_executable_path" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-contention \
      --e2e-automatic-classification-contention-verify \
      --e2e-automatic-classification-state-url "$PWD/$state" \
      --e2e-automatic-classification-contention-marker-url "$PWD/$contention_marker" \
      --e2e-automatic-classification-result-url "$PWD/$verify_result" \
      >"$verify_log" 2>&1 &
  app_pid=$!

  # Store startup also reconciles the initially unconfigured circuit. Wait for
  # the launch automation to persist the configured Provider, then discard any
  # earlier marker so the observed retry belongs to that exact transition.
  for _ in {1..200}; do
    if defaults read \
      app.noonmark.mac.e2e \
      noonmark.zhulong.provider.config \
      >/dev/null 2>&1 \
      && security find-generic-password \
        -s app.noonmark.zhulong.provider.e2e \
        >/dev/null 2>&1; then
      provider_configuration_persisted=1
      break
    fi
    if ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ "$provider_configuration_persisted" != "1" ]]; then
    echo "contention App did not persist its configured Provider" >&2
    cat "$verify_log" >&2
    exit 1
  fi
  rm -f "$contention_marker"

  for _ in {1..400}; do
    if [[ -f "$contention_marker" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$contention_marker" \
    || "$(<"$contention_marker")" != "provider-reconciliation" ]]; then
    echo "automatic classification did not expose Provider reconciliation contention" >&2
    cat "$verify_log" >&2
    exit 1
  fi

  if ! stop_sqlite_write_lock_holder; then
    echo "automatic classification SQLite lock holder failed" >&2
    cat "$sqlite_lock_log" >&2
    exit 1
  fi

  for _ in {1..400}; do
    if [[ -f "$verify_result" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$verify_result" || "$(<"$verify_result")" != "ok" ]]; then
    echo "automatic classification contention verification failed: $(cat "$verify_result" 2>/dev/null || echo missing)" >&2
    cat "$verify_log" >&2
    exit 1
  fi
  for _ in {1..40}; do
    if ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$app_pid" 2>/dev/null; then
    echo "automatic classification contention App did not terminate" >&2
    cat "$verify_log" >&2
    exit 1
  fi
  if ! wait "$app_pid"; then
    echo "automatic classification contention App process failed" >&2
    cat "$verify_log" >&2
    exit 1
  fi
  app_pid=""
  assert_clean_app_log "automatic classification Provider contention" "$verify_log"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "contention Provider exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "contention classification" "$provider_count" 1
  assert_automatic_classification_provider_count \
    "contention health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 1 AND attempt = 1
         AND dispatch_authorization = 'explicit'
         AND authorization_id IS NOT NULL AND authorized_at IS NOT NULL
         AND error_code IS NULL),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE fact.kind = 'category' AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE fact.kind = 'label' AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "1 1 1 2 closed 0 1 1" ]]; then
    echo "automatic classification contention SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification Provider reconciliation contention: $database (probe=$sqlite_probe)"
)

run_automatic_classification_provider_race_probe() (
  set -euo pipefail
  local evidence_dir="artifacts/e2e-automatic-classification/provider-race"
  local database="${evidence_dir}/Noonmark.sqlite"
  local result="${evidence_dir}/result.txt"
  local app_log="${evidence_dir}/app.log"
  local request_received="${evidence_dir}/request-received.txt"
  local response_release="${evidence_dir}/response-release.txt"
  local save_trigger="${evidence_dir}/save-trigger.txt"
  local save_completed="${evidence_dir}/save-completed.txt"
  local provider_ready="${evidence_dir}/provider-ready.txt"
  local provider_count="${evidence_dir}/provider-count.txt"
  local health_count="${evidence_dir}/health-count.txt"
  local provider_log="${evidence_dir}/provider.log"
  local provider_pid=""
  local provider_port
  local app_pid=""
  local sqlite_probe

  rm -rf "$evidence_dir"
  mkdir -p "$evidence_dir"
  clear_automatic_classification_e2e_credentials
  trap '
    if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
      kill "$app_pid" >/dev/null 2>&1 || true
      wait "$app_pid" 2>/dev/null || true
    fi
    if [[ -n "$provider_pid" ]]; then
      kill "$provider_pid" >/dev/null 2>&1 || true
      wait "$provider_pid" 2>/dev/null || true
    fi
    clear_automatic_classification_e2e_credentials
  ' EXIT

  start_automatic_classification_e2e_provider \
    "$PWD/$provider_ready" \
    "$PWD/$provider_count" \
    "$PWD/$health_count" \
    "$provider_log" \
    --request-received-file "$PWD/$request_received" \
    --response-gate-file "$PWD/$response_release"

  NOONMARK_E2E_AI_BASE_URL="http://127.0.0.1:${provider_port}/v1" \
    NOONMARK_E2E_AI_MODEL="noonmark-e2e-automatic-classification" \
    NOONMARK_E2E_AI_API_KEY="noonmark-e2e-local-provider-key" \
    "$app_executable_path" \
      --data-url "$PWD/$database" \
      --page settings \
      --e2e-automatic-classification-provider-race \
      --e2e-automatic-classification-provider-save-trigger-url "$PWD/$save_trigger" \
      --e2e-automatic-classification-provider-save-completed-url "$PWD/$save_completed" \
      --e2e-automatic-classification-result-url "$PWD/$result" \
      >"$app_log" 2>&1 &
  app_pid=$!

  for _ in {1..400}; do
    if [[ -f "$request_received" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$request_received" || "$(<"$request_received")" != "1" ]]; then
    echo "Provider race did not reach its first in-flight request" >&2
    cat "$app_log" >&2
    cat "$provider_log" >&2
    exit 1
  fi

  printf 'save\n' >"$save_trigger"
  for _ in {1..400}; do
    if [[ -f "$save_completed" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$save_completed" || "$(<"$save_completed")" != "ok" ]]; then
    echo "same-config Provider save did not preserve in-flight work" >&2
    cat "$app_log" >&2
    exit 1
  fi

  printf 'release\n' >"$response_release"
  for _ in {1..400}; do
    if [[ -f "$result" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$result" || "$(<"$result")" != "ok" ]]; then
    echo "Provider race verification failed: $(cat "$result" 2>/dev/null || echo missing)" >&2
    cat "$app_log" >&2
    exit 1
  fi
  for _ in {1..40}; do
    if ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$app_pid" 2>/dev/null; then
    echo "Provider race App did not terminate" >&2
    cat "$app_log" >&2
    exit 1
  fi
  if ! wait "$app_pid"; then
    echo "Provider race App process failed" >&2
    cat "$app_log" >&2
    exit 1
  fi
  app_pid=""
  assert_clean_app_log "automatic classification same-config Provider race" "$app_log"

  if ! kill -0 "$provider_pid" 2>/dev/null; then
    echo "Provider race stub exited before evidence collection" >&2
    cat "$provider_log" >&2
    exit 1
  fi
  assert_automatic_classification_provider_count \
    "Provider race classification" "$provider_count" 1
  assert_automatic_classification_provider_count \
    "Provider race health" "$health_count" 0
  sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
    SELECT
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*) FROM automatic_classification_jobs
       WHERE state = 'completed' AND generation = 1 AND attempt = 1
         AND dispatch_authorization = 'automatic'
         AND authorization_id IS NULL AND authorized_at IS NULL
         AND proposal_checkpoint IS NULL AND error_code IS NULL),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE fact.kind = 'category' AND fact.source_kind = 'automaticAI'),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN automatic_classification_jobs AS job ON job.chain_id = fact.chain_id
       WHERE fact.kind = 'label' AND fact.source_kind = 'automaticAI'),
      (SELECT state FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT consecutive_failures FROM automatic_classification_provider_circuit
       WHERE singleton_id = 1),
      (SELECT provider_execution_revision IS NOT NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1),
      (SELECT failure_code IS NULL AND retry_at IS NULL
         AND probe_job_id IS NULL AND probe_generation IS NULL
         AND probe_attempt IS NULL AND probe_claim_id IS NULL
       FROM automatic_classification_provider_circuit WHERE singleton_id = 1);
  ")"
  if [[ "$sqlite_probe" != "1 1 1 2 closed 0 1 1" ]]; then
    echo "automatic classification Provider race SQLite probe failed: ${sqlite_probe:-missing}" >&2
    exit 1
  fi
  clear_automatic_classification_e2e_credentials
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification same-config Provider race: $database (probe=$sqlite_probe)"
)

run_automatic_classification_probe() {
  local evidence_dir="artifacts/e2e-automatic-classification"
  local enqueue_dir="${evidence_dir}/enqueue"
  local enqueue_database="${enqueue_dir}/Noonmark.sqlite"
  local enqueue_result="${enqueue_dir}/result.txt"
  local enqueue_probe
  local lifecycle_dir="${evidence_dir}/lifecycle"
  local lifecycle_database="${lifecycle_dir}/Noonmark.sqlite"
  local lifecycle_result="${lifecycle_dir}/result.txt"
  local lifecycle_probe

  rm -rf "$evidence_dir"
  mkdir -p "$enqueue_dir" "$lifecycle_dir"
  clear_automatic_classification_e2e_credentials

  run_terminating_ui_probe \
    "automatic classification atomic enqueue" \
    "$enqueue_result" \
    "${enqueue_dir}/app.log" \
    --data-url "$PWD/$enqueue_database" \
    --page day \
    --e2e-automatic-classification-enqueue \
    --e2e-automatic-classification-result-url "$PWD/$enqueue_result" \
    --e2e-quit-after-automation

  assert_automatic_classification_diagnostic \
    "automatic classification enqueue counts" "${enqueue_dir}/app.log" \
    'event=snapshot .*waitingForConfiguration:2'

  enqueue_probe="$(sqlite3 -noheader -separator ' ' "$enqueue_database" "
    SELECT
      (SELECT count(*)
       FROM task_definitions
       WHERE title IN (
         'E2E 自动归类 Day 任务',
         'E2E 自动归类任务池任务'
       ) AND superseded_at IS NULL),
      (SELECT count(*) FROM automatic_classification_jobs),
      (SELECT count(*)
       FROM automatic_classification_jobs
       WHERE state = 'waitingForConfiguration' AND generation = 1),
      (SELECT count(*)
       FROM classification_current_relation_facts AS fact
       JOIN task_labels AS label ON label.id = fact.item_id
       WHERE fact.kind = 'label'
         AND fact.source_kind = 'userDirect'
         AND label.name = '用户标签');
  ")"
  if [[ "$enqueue_probe" != "2 2 2 1" ]]; then
    echo "automatic classification enqueue persistence probe failed: ${enqueue_probe:-missing}" >&2
    exit 1
  fi

  run_terminating_ui_probe \
    "automatic classification lifecycle" \
    "$lifecycle_result" \
    "${lifecycle_dir}/app.log" \
    --data-url "$PWD/$lifecycle_database" \
    --page day \
    --e2e-automatic-classification-lifecycle \
    --e2e-automatic-classification-result-url "$PWD/$lifecycle_result" \
    --e2e-quit-after-automation

  assert_automatic_classification_diagnostic \
    "automatic classification manual override fence" "${lifecycle_dir}/app.log" \
    'event=job-mutation kind=fence-invalidated reason=user-classification-won'
  assert_automatic_classification_diagnostic \
    "automatic classification undo fence" "${lifecycle_dir}/app.log" \
    'event=job-mutation kind=fence-invalidated reason=snapshot-undo'

  lifecycle_probe="$(sqlite3 -noheader -separator ' ' "$lifecycle_database" "
    SELECT
      (SELECT count(*)
       FROM automatic_classification_jobs
       WHERE state = 'superseded'
         AND error_code = 'manualClassificationWon'),
      (SELECT count(*)
       FROM automatic_classification_jobs
       WHERE state = 'cancelled'
         AND error_code = 'cancelledByUndo'
         AND cancelled_by_undo = 1),
      (SELECT count(*)
       FROM automatic_classification_jobs
       WHERE state = 'waitingForConfiguration'
         AND generation = 2),
      (SELECT count(*)
       FROM automatic_classification_jobs
       WHERE state NOT IN ('completed', 'superseded', 'cancelled', 'failed'));
  ")"
  if [[ "$lifecycle_probe" != "1 1 1 1" ]]; then
    echo "automatic classification lifecycle persistence probe failed: ${lifecycle_probe:-missing}" >&2
    exit 1
  fi

  run_automatic_classification_operational_clock_probe
  run_automatic_classification_checkpoint_restart_probe
  run_automatic_classification_backlog_start_probe
  run_automatic_classification_backlog_later_probe
  run_automatic_classification_future_only_probe
  run_automatic_classification_failed_edit_probe
  run_automatic_classification_status_surfaces_probe
  run_automatic_classification_provider_block_retry_probe
  run_automatic_classification_provider_transient_circuit_probe
  run_automatic_classification_contention_probe
  run_automatic_classification_provider_race_probe
  assert_automatic_classification_e2e_credentials_cleared
  echo "E2E automatic classification enqueue/lifecycle: $evidence_dir"
}

run_zhulong_todo_diff_clock_probe() {
  local todo_dir="artifacts/e2e-zhulong-todo-diff"
  local todo_db="${todo_dir}/Noonmark.sqlite"
  local todo_result="${todo_dir}/result.txt"
  local todo_log="${todo_dir}/app.log"
  local clock_probe

  rm -rf "$todo_dir"
  mkdir -p "$todo_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "zhulong preauthorized Todo diff joint clock" \
    "$todo_result" \
    "$todo_log" \
    --data-url "$PWD/$todo_db" \
    --page zhulong \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-enable-zhulong \
    --e2e-zhulong-sidecar-key \
    --e2e-prepare-zhulong-todo-diff \
    --e2e-zhulong-todo-diff-result-url "$PWD/$todo_result"

  clock_probe="$(sqlite3 -noheader -separator ' ' "$todo_db" "
    WITH ai_definitions AS (
      SELECT id, chain_id, created_at_bits
      FROM task_definitions
      WHERE superseded_at IS NULL
        AND title IN ('E2E 编辑后的测量', 'E2E 拆分后的验证')
    ), post_apply AS (
      SELECT id, chain_id, created_at_bits
      FROM task_definitions
      WHERE superseded_at IS NULL
        AND title = 'E2E 烛龙应用后普通写入'
    )
    SELECT
      (SELECT count(*) FROM ai_definitions),
      (SELECT count(*) FROM post_apply),
      (SELECT count(*)
       FROM ai_definitions
       WHERE EXISTS (
         SELECT 1
         FROM change_journal
         WHERE entity_type = 'taskDefinition'
           AND entity_id = ai_definitions.id
           AND changed_at_bits = ai_definitions.created_at_bits
       )),
      (SELECT count(*)
       FROM post_apply
       WHERE EXISTS (
         SELECT 1
         FROM change_journal
         WHERE entity_type = 'taskDefinition'
           AND entity_id = post_apply.id
           AND changed_at_bits = post_apply.created_at_bits
       )),
      (SELECT min(post_apply.created_at_bits) > max(ai_definitions.created_at_bits)
       FROM post_apply, ai_definitions),
      (SELECT count(*)
       FROM automatic_classification_jobs AS job
       WHERE job.chain_id IN (SELECT chain_id FROM ai_definitions)
         AND job.state = 'waitingForConfiguration'
         AND job.generation = 1),
      (SELECT count(*)
       FROM automatic_classification_jobs AS job
       WHERE job.chain_id IN (SELECT chain_id FROM post_apply)
         AND job.state = 'waitingForConfiguration'
         AND job.generation = 1),
      (SELECT count(DISTINCT job.chain_id)
       FROM automatic_classification_jobs AS job
       WHERE job.chain_id IN (
         SELECT chain_id FROM ai_definitions
         UNION ALL
         SELECT chain_id FROM post_apply
       ));
  ")"
  if [[ "$clock_probe" != "2 1 2 1 1 2 1 3" \
    || -f "${todo_dir}/ZhulongSidecar/pending-application.zhj" ]]; then
    echo "zhulong Todo diff joint clock probe failed: ${clock_probe:-missing}" >&2
    exit 1
  fi

  echo "E2E fixed-clock Zhulong Todo apply and following Store mutation: $todo_db (probe=$clock_probe)"
}

