workflow_dir="artifacts/e2e-workflow"
workflow_db="${workflow_dir}/Noonmark.sqlite"
workflow_result="${workflow_dir}/workflow-result.txt"
workflow_title="E2E 排期延续复盘"
rm -rf "$workflow_dir"
mkdir -p "$workflow_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$workflow_db" \
  --page pool \
  --e2e-domain-workflow \
  --e2e-workflow-title "$workflow_title" \
  --e2e-workflow-result-url "$PWD/$workflow_result" \
  --e2e-quit-after-automation

if [[ ! -f "$workflow_result" ]]; then
  echo "workflow e2e result was not created: $workflow_result" >&2
  exit 1
fi

if [[ "$(cat "$workflow_result")" != "ok" ]]; then
  echo "workflow e2e failed: $(cat "$workflow_result")" >&2
  exit 1
fi

read -r workflow_continued workflow_pending workflow_review < <(
  sqlite3 -separator " " "$workflow_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'continued'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-06'
         AND day_traces.status = 'pending'
         AND day_traces.continuation_seq = 1),
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 已完成排期、延续和复盘写入。'
         AND review_unfinished_reason = '验证真实 App workflow 自动化。'
         AND review_tomorrow_note = '明天检查延续任务。');
  "
)

if [[ "$workflow_continued" -ne 1 || "$workflow_pending" -ne 1 || "$workflow_review" -ne 1 ]]; then
  echo "workflow e2e persistence failed: continued=$workflow_continued pending=$workflow_pending review=$workflow_review" >&2
  exit 1
fi

echo "E2E domain workflow: $workflow_db (continued=$workflow_continued pending=$workflow_pending review=$workflow_review)"

lifecycle_dir="artifacts/e2e-lifecycle"
lifecycle_db="${lifecycle_dir}/Noonmark.sqlite"
lifecycle_result="${lifecycle_dir}/lifecycle-result.txt"
rm -rf "$lifecycle_dir"
mkdir -p "$lifecycle_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$lifecycle_db" \
  --page day \
  --e2e-lifecycle-workflow \
  --e2e-lifecycle-result-url "$PWD/$lifecycle_result" \
  --e2e-quit-after-automation

if [[ ! -f "$lifecycle_result" ]]; then
  echo "lifecycle e2e result was not created: $lifecycle_result" >&2
  exit 1
fi

if [[ "$(cat "$lifecycle_result")" != "ok" ]]; then
  echo "lifecycle e2e failed: $(cat "$lifecycle_result")" >&2
  exit 1
fi

read -r lifecycle_changed lifecycle_new lifecycle_returned lifecycle_reenabled lifecycle_abandoned lifecycle_abandon_total < <(
  sqlite3 -separator " " "$lifecycle_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更旧任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'changed'
         AND day_traces.changed_to_trace_id IS NOT NULL),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 变更新任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 回池任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'returnedToPool'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'
         AND task_chains.state = 'active'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       JOIN task_chains ON task_chains.id = day_traces.chain_id
       WHERE task_definitions.title = 'E2E 废弃任务'
         AND day_traces.status = 'abandoned'
         AND task_chains.state = 'abandoned'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 废弃任务');
  "
)

if [[ "$lifecycle_changed" -ne 1 || "$lifecycle_new" -ne 1 || "$lifecycle_returned" -ne 1 || "$lifecycle_reenabled" -ne 1 || "$lifecycle_abandoned" -ne 0 || "$lifecycle_abandon_total" -ne 1 ]]; then
  echo "lifecycle e2e persistence failed: changed=$lifecycle_changed new=$lifecycle_new returned=$lifecycle_returned reenabled=$lifecycle_reenabled abandoned=$lifecycle_abandoned abandon_total=$lifecycle_abandon_total" >&2
  exit 1
fi

echo "E2E lifecycle workflow: $lifecycle_db (changed=$lifecycle_changed new=$lifecycle_new returned=$lifecycle_returned reenabled=$lifecycle_reenabled abandoned=$lifecycle_abandoned abandon_total=$lifecycle_abandon_total)"

data_package_dir="artifacts/e2e-data-package"
data_package_db="${data_package_dir}/Noonmark.sqlite"
data_package_json="${data_package_dir}/noonmark-e2e-export.json"
data_package_result="${data_package_dir}/data-package-result.txt"
rm -rf "$data_package_dir"
mkdir -p "$data_package_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$data_package_db" \
  --page settings \
  --e2e-data-package-workflow \
  --e2e-data-package-url "$PWD/$data_package_json" \
  --e2e-data-package-result-url "$PWD/$data_package_result" \
  --e2e-quit-after-automation

if [[ ! -f "$data_package_result" ]]; then
  echo "data package e2e result was not created: $data_package_result" >&2
  exit 1
fi

if [[ "$(cat "$data_package_result")" != "ok" ]]; then
  echo "data package e2e failed: $(cat "$data_package_result")" >&2
  exit 1
fi

if [[ ! -s "$data_package_json" ]]; then
  echo "data package export was not created: $data_package_json" >&2
  exit 1
fi

read -r data_package_task data_package_review < <(
  sqlite3 -separator " " "$data_package_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = 'E2E 数据包任务'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'pending'),
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 数据包导出前复盘。'
         AND review_unfinished_reason = '验证 App 导入导出。'
         AND review_tomorrow_note = '导入后继续检查。');
  "
)

if [[ "$data_package_task" -ne 1 || "$data_package_review" -ne 1 ]]; then
  echo "data package e2e persistence failed: task=$data_package_task review=$data_package_review" >&2
  exit 1
fi

echo "E2E data package round-trip: $data_package_json -> $data_package_db (task=$data_package_task review=$data_package_review)"
