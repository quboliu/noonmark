    --e2e-fixed-instant 2026-07-28T16:00:00Z
    --e2e-fixed-time-zone America/New_York
    --e2e-fixed-locale zh_Hans_SG
    --e2e-subtask-layout-restart-verify
    --e2e-subtask-layout-result-url "$PWD/$restart_result"
  )
  local persisted

  if [[ -n "$ime_input_mode" ]]; then
    expected_title="你好，你好。"
    exercise_args+=(
      --e2e-subtask-ime-input-mode "$ime_input_mode"
    )
    restart_args+=(
      --e2e-subtask-ime-input-mode "$ime_input_mode"
    )
  fi

  rm -rf "$layout_dir"
  mkdir -p "$layout_dir"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "pool and Day Todo multiline subtask layout and inline editing" \
    "$exercise_result" \
    "$exercise_log" \
    "${exercise_args[@]}"

  if [[ -z "$ime_input_mode" ]]; then
    if [[ ! -f "$ascii_latency_report" ]] ||
      [[ "$(head -n 1 "$ascii_latency_report")" != \
        $'key\ttotal_ms\tpost_ms\techo_wait_ms\tevent_delivery_ms\tevent_to_key_down_ms\tkey_down_ms\tsuper_key_down_ms\tnative_snapshot_callback_ms\tevent_to_observation_ms' ]] ||
      [[ "$(awk 'END { print NR }' "$ascii_latency_report")" != "11" ]]; then
      echo "subtask ASCII latency evidence is incomplete" >&2
      [[ -f "$ascii_latency_report" ]] && cat "$ascii_latency_report" >&2
      exit 1
    fi
  fi

  if [[ ! -s "$pool_screenshot" || ! -s "$inline_edit_screenshot" ]]; then
    echo "subtask layout screenshots were not created" >&2
    exit 1
  fi

  persisted="$(sqlite3 -noheader "$layout_db" "
    SELECT count(*)
    FROM subtasks AS subtask
    JOIN day_traces AS trace
      ON trace.id = subtask.trace_id
    WHERE subtask.title = '$expected_title'
      AND trace.date = '2026-07-28'
      AND trace.status = 'pending';
  ")"
  if [[ "$persisted" != "1" ]]; then
    echo "subtask inline edit SQLite probe failed: ${persisted:-missing}" >&2
    exit 1
  fi

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "Day Todo inline subtask title restart readback" \
    "$restart_result" \
    "$restart_log" \
    "${restart_args[@]}"

  echo "E2E multiline subtask layout, inline editing, SQLite, and restart: $layout_db $pool_screenshot $inline_edit_screenshot"
}

