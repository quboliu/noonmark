expect_runtime_manifest_mutation_rejected() {
  local label="$1"
  local mutation="$2"
  local status

  cp "$lease_manifest_pristine" "$lease_manifest"
  sed -i '' "$mutation" "$lease_manifest"
  set +e
  (
    cd "$fixture_root"
    scripts/verify-development-validation-evidence \
      --scope runtime \
      artifacts/e2e-runtime/manifest.txt \
      artifacts/e2e-data-root-process-lease/manifest.txt
  ) >"$fixture_root/runtime-validator-${label}.stdout" \
    2>"$fixture_root/runtime-validator-${label}.stderr"
  status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    echo "runtime validator accepted evidence mutation: $label" >&2
    exit 1
  fi
}

expect_runtime_manifest_mutation_rejected \
  replaced-run-id \
  's/^evidence_run_id=.*/evidence_run_id=replaced-run/'
expect_runtime_manifest_mutation_rejected \
  replaced-source-tree \
  's/^source_worktree_tree_oid=.*/source_worktree_tree_oid=replaced/'
expect_runtime_manifest_mutation_rejected \
  replaced-signing-identity \
  's/^app_codesign_identity_sha256=.*/app_codesign_identity_sha256=replaced/'
expect_runtime_manifest_mutation_rejected \
  replaced-signing-team \
  's/^app_codesign_team_identifier=.*/app_codesign_team_identifier=REPLACEDTEAM/'
expect_runtime_manifest_mutation_rejected \
  replaced-intentional-phase \
  's/^intentional_sigkill_phase=.*/intentional_sigkill_phase=replaced-phase/'
cp "$lease_manifest_pristine" "$lease_manifest"

e2e_manifest="$fixture_root/artifacts/e2e-runtime/manifest.txt"
e2e_manifest_pristine="$fixture_root/artifacts/e2e-runtime/manifest.pristine"
