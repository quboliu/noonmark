  for menu_identity_key in CFBundleName CFBundleDisplayName; do
    if ! production_menu_identity="$(
      /usr/libexec/PlistBuddy \
        -c "Print :${menu_identity_key}" \
        "$production_info_plist"
    )" || ! validation_menu_identity="$(
      /usr/libexec/PlistBuddy \
        -c "Print :${menu_identity_key}" \
        "$validation_info_plist"
    )" || [[ -z "$production_menu_identity" ||
      "$validation_menu_identity" != "$production_menu_identity" ]]; then
      echo "DMG validation App changed production menu identity: $menu_identity_key" >&2
