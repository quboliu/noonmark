restore_closure_fixture

expect_closure_mutation_rejected() {
  local name="$1"
  local expected_message="$2"
  local status

  set +e
  (
    cd "$fixture_root"
    scripts/verify-development-validation-evidence --scope full
  ) >"$fixture_root/cross-validator-${name}.stdout" \
    2>"$fixture_root/cross-validator-${name}.stderr"
