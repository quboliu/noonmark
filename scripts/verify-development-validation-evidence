require_install_ledger_semantics \
  exercise \
  "$repo_root/artifacts/dmg-install/exercise-ledger.tsv" \
  "arguments,process,exit-observer,permissions,target,main-window,settings-menu,settings-window,settings-close,quick-entry-menu,quick-entry-input,quick-entry-add,exercise-title-visible,quit-menu,quit,complete"
require_install_ledger_semantics \
  restart \
  "$repo_root/artifacts/dmg-install/restart-ledger.tsv" \
  "arguments,process,exit-observer,permissions,target,main-window,restart-title-visible,quit-menu,quit,complete"
installed_bundle_path="$repo_root/artifacts/dmg-install/Applications/Noonmark.app"
installed_executable_path="$(evidence_read "$install_manifest" production_executable)"
production_bundle_identifier="$(
  evidence_read "$install_manifest" production_bundle_identifier
)"
if [[ "$installed_executable_path" != \
    "$installed_bundle_path/Contents/MacOS/NoonmarkMacApp" ]] ||
  [[ "$production_bundle_identifier" != "app.noonmark.mac" ]]; then
  echo "install manifest does not identify the archived production App" >&2
  exit 1
fi
exercise_window_metadata="$repo_root/artifacts/dmg-install/installed-exercise-window.txt"
restart_window_metadata="$repo_root/artifacts/dmg-install/installed-restart-window.txt"
require_install_window_metadata \
  exercise \
  "$exercise_window_metadata" \
  "$repo_root/artifacts/dmg-install/exercise-ledger.tsv" \
  "$repo_root/artifacts/dmg-install/installed-exercise-before-input.png" \
  "$installed_bundle_path" \
  "$installed_executable_path" \
  "$production_bundle_identifier"
require_install_window_metadata \
  restart \
  "$restart_window_metadata" \
  "$repo_root/artifacts/dmg-install/restart-ledger.tsv" \
  "$repo_root/artifacts/dmg-install/installed-restart.png" \
  "$installed_bundle_path" \
  "$installed_executable_path" \
  "$production_bundle_identifier"
exercise_natural_day="$(evidence_read "$exercise_window_metadata" natural_day)"
restart_natural_day="$(evidence_read "$restart_window_metadata" natural_day)"
require_install_process_log \
  exercise \
  "$repo_root/artifacts/dmg-install/exercise-console.log" \
  "$(evidence_read "$exercise_window_metadata" pid)" \
