#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd -P)"
cd "$repo_root"

# shellcheck source=scripts/evidence-common
source scripts/evidence-common
# shellcheck source=scripts/runtime-evidence
source scripts/runtime-evidence

scope="full"
if [[ "${1:-}" == "--scope" ]]; then
  if [[ $# -lt 2 ]]; then
    echo "usage: $0 [--scope runtime|full] [e2e lease [package install]]" >&2
    exit 2
  fi
  scope="$2"
  shift 2
fi
case "$scope" in
  runtime | full) ;;
  *)
    echo "validation evidence scope must be runtime or full" >&2
    exit 2
    ;;
esac

e2e_manifest="${1:-artifacts/e2e-runtime/manifest.txt}"
lease_manifest="${2:-artifacts/e2e-data-root-process-lease/manifest.txt}"
package_manifest="${3:-dist/Noonmark.dmg.manifest}"
install_manifest="${4:-artifacts/dmg-install/runtime-manifest.txt}"
expected_english_scenarios="english-day,english-day-wide,english-day-history-header,english-pool,english-future,english-unfinished,english-completed,english-calendar,english-settings,english-zhulong"
english_ledger="$(dirname "$e2e_manifest")/english-scenario-ledger.tsv"
install_evidence_dir="$(dirname "$install_manifest")"
e2e_evidence_dir="$(dirname "$e2e_manifest")"
lease_evidence_dir="$(dirname "$lease_manifest")"
if [[ "$e2e_evidence_dir" == /* ]]; then
  e2e_evidence_absolute="$e2e_evidence_dir"
else
  e2e_evidence_absolute="$repo_root/$e2e_evidence_dir"
fi
if [[ "$lease_evidence_dir" == /* ]]; then
  lease_evidence_absolute="$lease_evidence_dir"
else
  lease_evidence_absolute="$repo_root/$lease_evidence_dir"
fi
e2e_inventory="${e2e_evidence_dir}/artifact-inventory.sha256"
lease_inventory="${lease_evidence_dir}/artifact-inventory.sha256"
install_inventory="$(dirname "$install_evidence_dir")/dmg-install-artifact-inventory.sha256"

require_equal_manifest_value() {
  local left_manifest="$1"
  local left_key="$2"
  local right_manifest="$3"
  local right_key="$4"
  local label="$5"
  local left_value
  local right_value

  left_value="$(evidence_read "$left_manifest" "$left_key")"
  right_value="$(evidence_read "$right_manifest" "$right_key")"
  if [[ "$left_value" != "$right_value" ]]; then
    echo "development-validation evidence disagrees for $label" >&2
    return 1
  fi
}

require_same_bundle_evidence() {
  local manifest="$1"
  local start_prefix="$2"
  local end_prefix="$3"
  local label="$4"
  local suffix

  evidence_require_manifest \
    "$manifest" \
    "${start_prefix}_stable_required=1" \
    "${start_prefix}_codesign_deep_strict=1" \
    "${end_prefix}_stable_required=1" \
    "${end_prefix}_codesign_deep_strict=1"
  for suffix in \
    binary_sha256 \
    codesign_identifier \
    codesign_kind \
    codesign_identity_sha1 \
    codesign_identity_sha256 \
    codesign_team_identifier \
    codesign_authority \
    designated_requirement_sha256; do
    require_equal_manifest_value \
      "$manifest" \
      "${start_prefix}_${suffix}" \
      "$manifest" \
      "${end_prefix}_${suffix}" \
      "$label $suffix"
  done
}

require_bundle_evidence_equal() {
  local left_manifest="$1"
  local left_prefix="$2"
  local right_manifest="$3"
  local right_prefix="$4"
  local label="$5"
  local suffix

  for suffix in \
    binary_sha256 \
    codesign_identifier \
    codesign_kind \
    codesign_identity_sha1 \
    codesign_identity_sha256 \
    codesign_team_identifier \
    codesign_authority \
    designated_requirement_sha256; do
    require_equal_manifest_value \
      "$left_manifest" \
      "${left_prefix}_${suffix}" \
      "$right_manifest" \
      "${right_prefix}_${suffix}" \
      "$label $suffix"
  done
}

require_file_sha256() {
  local manifest="$1"
  local key="$2"
  local path="$3"
  local label="$4"
  local expected
  local actual

  if [[ ! -f "$path" || -L "$path" ]]; then
    echo "$label is missing: $path" >&2
    return 1
  fi
  expected="$(evidence_read "$manifest" "$key")"
  actual="$(shasum -a 256 "$path" | awk '{print $1}')"
  if [[ "$actual" != "$expected" ]]; then
    echo "$label does not match $key" >&2
    return 1
  fi
}

require_preserved_bundle() {
  local manifest="$1"
  local prefix="$2"
  local bundle="$3"
  local label="$4"
  local observed

  if [[ ! -d "$bundle" || -L "$bundle" ]]; then
    echo "$label preserved bundle is missing or unsafe: $bundle" >&2
    return 1
  fi
  observed="$(mktemp "${TMPDIR:-/tmp}/noonmark-observed-bundle.XXXXXX")" ||
    return 1
  if ! evidence_capture_bundle "$bundle" 1 observed "$observed"; then
    rm -f "$observed"
    echo "$label preserved bundle failed strict signed evidence capture" >&2
    return 1
  fi
  if ! require_bundle_evidence_equal \
    "$manifest" \
    "$prefix" \
    "$observed" \
    observed \
    "$label preserved bundle"; then
    rm -f "$observed"
    return 1
  fi
  rm -f "$observed"
}

require_clean_diagnostic_evidence() {
  local directory="$1"
  local prefix="$2"
  local label="$3"
  local baseline="${directory}/${prefix}diagnostic-baseline.txt"
  local final="${baseline}.current"
  local diff="${baseline}.new"
  local result="${directory}/${prefix}diagnostic-result.txt"

  for path in "$baseline" "$final" "$diff" "$result"; do
    if [[ ! -f "$path" ]]; then
      echo "$label diagnostic evidence is missing: $path" >&2
      return 1
    fi
  done
  if [[ -s "$diff" ]] ||
    [[ "$(<"$result")" != "new_diagnostic_count=0" ]]; then
    echo "$label diagnostic evidence reports a new crash or failure" >&2
    return 1
  fi
}

require_safe_repo_relative_path() {
  local path="$1"

  if [[ -z "$path" || "$path" == /* || "$path" == *$'\n'* ||
    "$path" == *$'\r'* ]]; then
    return 1
  fi
  case "/$path/" in
    */../* | */./*) return 1 ;;
  esac
}

expected_english_oracles() {
  local scenario="$1"
  local base="screenshot_vision_ocr_no_han"

  case "$scenario" in
    english-day)
      printf '%s\n' \
        "${base}+day_header_pixel+in_app_view_tree_ax+external_ax"
      ;;
    english-day-wide)
      printf '%s\n' "${base}+day_header_pixel+in_app_view_tree_ax"
      ;;
    english-day-history-header)
      printf '%s\n' \
        "${base}+day_header_pixel+in_app_responsive_contract"
      ;;
    english-pool | english-future | english-unfinished | \
      english-completed | english-calendar)
      printf '%s\n' "${base}+in_app_view_tree_ax"
      ;;
    english-settings)
      printf '%s\n' "${base}+settings_sidebar_vision_ocr"
      ;;
    english-zhulong)
      printf '%s\n' "$base"
      ;;
    *) return 1 ;;
  esac
}

require_png_evidence() {
  local path="$1"
  local label="$2"
  local magic
  local dimensions
  local width
  local height

  if [[ ! -f "$path" || -L "$path" ]]; then
    echo "$label PNG is missing or unsafe: $path" >&2
    return 1
  fi
  magic="$(LC_ALL=C od -An -tx1 -N8 "$path" | tr -d ' \n')"
  if [[ "$magic" != "89504e470d0a1a0a" ]]; then
    echo "$label is not a PNG file" >&2
    return 1
  fi
  if ! dimensions="$(/usr/bin/sips -g pixelWidth -g pixelHeight "$path" 2>/dev/null)"; then
    echo "$label PNG could not be decoded" >&2
    return 1
  fi
  width="$(awk '/pixelWidth:/ { print $2 }' <<<"$dimensions")"
  height="$(awk '/pixelHeight:/ { print $2 }' <<<"$dimensions")"
  if [[ ! "$width" =~ ^[0-9]+$ || ! "$height" =~ ^[0-9]+$ ]] ||
    (( width < 100 || height < 100 )); then
    echo "$label PNG dimensions are implausible: ${width:-unknown}x${height:-unknown}" >&2
    return 1
  fi
}

require_settings_window_geometry() {
  local detail="$1"

  if ! printf '%s\n' "$detail" | awk '
    {
      value = $0
      if (value !~ /^independent=true window=\([-0-9.]+, [-0-9.]+, [-0-9.]+, [-0-9.]+\) sidebar=\([-0-9.]+, [-0-9.]+, [-0-9.]+, [-0-9.]+\) content=\([-0-9.]+, [-0-9.]+, [-0-9.]+, [-0-9.]+\)$/) {
        exit 1
      }
      sub(/^independent=true window=\(/, "", value)
      gsub(/\) sidebar=\(/, ", ", value)
      gsub(/\) content=\(/, ", ", value)
      sub(/\)$/, "", value)
      count = split(value, values, /, /)
      if (count != 12) exit 1
      for (field = 1; field <= count; field += 1) {
        if (values[field] !~ /^-?[0-9]+([.][0-9]+)?$/) exit 1
      }

      windowX = values[1] + 0
      windowY = values[2] + 0
      windowWidth = values[3] + 0
      windowHeight = values[4] + 0
      sidebarX = values[5] + 0
      sidebarY = values[6] + 0
      sidebarWidth = values[7] + 0
      sidebarHeight = values[8] + 0
      contentX = values[9] + 0
      contentY = values[10] + 0
      contentWidth = values[11] + 0
      contentHeight = values[12] + 0
      tolerance = 0.01

      if (windowWidth < 680 || windowHeight < 500 ||
          sidebarWidth <= 0 || sidebarHeight <= 0 ||
          contentWidth <= 0 || contentHeight <= 0) exit 1
      if (sidebarX < windowX - tolerance || sidebarY < windowY - tolerance ||
          sidebarX + sidebarWidth > windowX + windowWidth + tolerance ||
          sidebarY + sidebarHeight > windowY + windowHeight + tolerance ||
          contentX < windowX - tolerance || contentY < windowY - tolerance ||
          contentX + contentWidth > windowX + windowWidth + tolerance ||
          contentY + contentHeight > windowY + windowHeight + tolerance) exit 1
      if (!(sidebarX + sidebarWidth <= contentX + tolerance ||
            contentX + contentWidth <= sidebarX + tolerance ||
            sidebarY + sidebarHeight <= contentY + tolerance ||
            contentY + contentHeight <= sidebarY + tolerance)) exit 1
    }
  '; then
    echo "DMG install exercise ledger has invalid Settings window geometry" >&2
    return 1
  fi
}

require_install_window_metadata() {
  local mode="$1"
  local path="$2"
  local ledger="$3"
  local screenshot="$4"
  local expected_bundle_path="$5"
  local expected_executable_path="$6"
  local expected_bundle_identifier="$7"
  local arguments_detail
  local ledger_pid
  local ledger_app_path
  local metadata_pid
  local natural_day
  local normalized_day
  local month
  local month_day
  local expected_title
  local dimensions
  local width
  local height

  if [[ ! -f "$path" || -L "$path" ]] ||
    ! awk '
      BEGIN {
        expected[1] = "phase"
        expected[2] = "pid"
        expected[3] = "bundle_identifier"
        expected[4] = "bundle_path"
        expected[5] = "executable_path"
        expected[6] = "window_id"
        expected[7] = "natural_day"
        expected[8] = "title"
        expected[9] = "screenshot"
        expected[10] = "pixel_size"
      }
      {
        prefix = expected[NR] "="
        if (NR > 10 || index($0, prefix) != 1 ||
            length(substr($0, length(prefix) + 1)) == 0) exit 1
      }
      END { exit !(NR == 10) }
    ' "$path"; then
    echo "DMG install $mode window metadata is incomplete or unsafe" >&2
    return 1
  fi

  arguments_detail="$(awk -F $'\t' '$3 == "arguments" { print $4 }' "$ledger")"
  if [[ ! "$arguments_detail" =~ ^mode=$mode[[:space:]]pid=([1-9][0-9]*)[[:space:]]app=(/.*/Applications/Noonmark\.app)$ ]]; then
    echo "DMG install $mode ledger cannot be bound to window metadata" >&2
    return 1
  fi
  ledger_pid="${BASH_REMATCH[1]}"
  ledger_app_path="${BASH_REMATCH[2]}"
  metadata_pid="$(evidence_read "$path" pid)"
  if [[ "$(evidence_read "$path" phase)" != "production $mode" ]] ||
    [[ "$metadata_pid" != "$ledger_pid" ]] ||
    [[ "$(evidence_read "$path" bundle_identifier)" != "$expected_bundle_identifier" ]] ||
    [[ "$ledger_app_path" != "$expected_bundle_path" ]] ||
    [[ "$(evidence_read "$path" bundle_path)" != "$expected_bundle_path" ]] ||
    [[ "$(evidence_read "$path" executable_path)" != "$expected_executable_path" ]] ||
    [[ ! "$(evidence_read "$path" window_id)" =~ ^[1-9][0-9]*$ ]] ||
    [[ "$(evidence_read "$path" screenshot)" != "$screenshot" ]]; then
    echo "DMG install $mode ledger disagrees with archived window metadata" >&2
    return 1
  fi

  natural_day="$(evidence_read "$path" natural_day)"
  if [[ ! "$natural_day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
    ! normalized_day="$(/bin/date -j -f '%Y-%m-%d' "$natural_day" '+%Y-%m-%d' 2>/dev/null)" ||
    [[ "$normalized_day" != "$natural_day" ]]; then
    echo "DMG install $mode window metadata has an invalid natural day" >&2
    return 1
  fi
  month="$((10#${natural_day:5:2}))"
  month_day="$((10#${natural_day:8:2}))"
  expected_title="晷迹 · Day Todo — ${month}月${month_day}日"
  if [[ "$(evidence_read "$path" title)" != "$expected_title" ]]; then
    echo "DMG install $mode window title disagrees with its natural day" >&2
    return 1
  fi

  dimensions="$(/usr/bin/sips -g pixelWidth -g pixelHeight "$screenshot" 2>/dev/null)"
  width="$(awk '/pixelWidth:/ { print $2 }' <<<"$dimensions")"
  height="$(awk '/pixelHeight:/ { print $2 }' <<<"$dimensions")"
  if [[ "$(evidence_read "$path" pixel_size)" != "${width}x${height}" ]]; then
    echo "DMG install $mode window metadata disagrees with its screenshot dimensions" >&2
    return 1
  fi
}

require_install_process_log() {
  local mode="$1"
  local path="$2"
  local expected_pid="$3"
  local expected_bundle_path="$4"
  local expected_executable_path="$5"
  local expected_bundle_identifier="$6"
  local expected_natural_day="$7"
  local install_started="$8"
  local install_finished="$9"
  local capture_started
  local capture_epoch
  local install_started_epoch
  local install_finished_epoch
  local identity_rows
  local identity_count
  local identity_row
  local audit_token
  local audit_pid_hex
  local audit_pid
  local process_pids
  local process_days
  local process_line
  local process_day
  local process_timestamp
  local process_epoch

  if [[ ! -f "$path" || -L "$path" ]]; then
    echo "DMG install $mode system runtime log is missing or unsafe" >&2
    return 1
  fi
  capture_started="$(evidence_read "$path" runtime_evidence_capture_started)"
  if [[ ! "$capture_started" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
    [[ ! "$install_started" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
    [[ ! "$install_finished" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
    ! capture_epoch="$(/bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' \
      "$capture_started" '+%s' 2>/dev/null)" ||
    ! install_started_epoch="$(/bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' \
      "$install_started" '+%s' 2>/dev/null)" ||
    ! install_finished_epoch="$(/bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' \
      "$install_finished" '+%s' 2>/dev/null)"; then
    echo "DMG install $mode system runtime log has an invalid capture time" >&2
    return 1
  fi

  process_pids="$(
    sed -nE 's/.*NoonmarkMacApp\[([0-9]+):[^]]*\].*/\1/p' "$path" |
      sort -u | paste -sd, -
  )"
  if [[ "$process_pids" != "$expected_pid" ]]; then
    echo "DMG install $mode archived PID disagrees with the system runtime log" >&2
    return 1
  fi
  identity_rows="$(grep -F "pid=$expected_pid appInfo=" "$path" || true)"
  identity_count="$(
    awk 'length($0) > 0 { count += 1 } END { print count + 0 }' \
      <<<"$identity_rows"
  )"
  if [[ "$identity_count" != "1" ]]; then
    echo "DMG install $mode system runtime log has duplicate or contradictory App identity" >&2
    return 1
  fi
  identity_row="$identity_rows"
  if [[ "$identity_row" != \
      *"\"CFBundleExecutablePath\"=\"$expected_executable_path\""* ]] ||
    [[ "$identity_row" != \
      *"\"CFBundleIdentifier\"=\"$expected_bundle_identifier\""* ]] ||
    [[ "$identity_row" != *"\"LSBundlePath\"=\"$expected_bundle_path\""* ]] ||
    [[ ! "$identity_row" =~ LSAuditToken\"=\$([0-9A-F]{64}) ]]; then
    echo "DMG install $mode system runtime log has duplicate or contradictory App identity" >&2
    return 1
  fi
  audit_token="${BASH_REMATCH[1]}"
  audit_pid_hex="${audit_token:40:8}"
  audit_pid="$(
    printf '%d' "$((16#${audit_pid_hex:6:2}${audit_pid_hex:4:2}${audit_pid_hex:2:2}${audit_pid_hex:0:2}))"
  )"
  if [[ "$audit_pid" != "$expected_pid" ]]; then
    echo "DMG install $mode visible PID disagrees with its kernel audit token" >&2
    return 1
  fi
  process_days="$(
    sed -nE \
      "s/^([0-9]{4}-[0-9]{2}-[0-9]{2}) .*NoonmarkMacApp\\[$expected_pid:.*/\\1/p" \
      "$path" | sort -u | paste -sd, -
  )"
  if [[ "$process_days" != "$expected_natural_day" ]]; then
    echo "DMG install $mode process dates disagree with its natural day" >&2
    return 1
  fi
  process_line="$(
    grep -m 1 -E \
      "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[.]?[0-9]* .*NoonmarkMacApp\\[$expected_pid:" \
      "$path" || true
  )"
  process_day="${process_line%% *}"
  if [[ -z "$process_line" || "$process_day" != "$expected_natural_day" ]]; then
    echo "DMG install $mode natural day disagrees with the system runtime log" >&2
    return 1
  fi
  process_timestamp="${process_line:0:19}"
  if ! process_epoch="$(/bin/date -j -f '%Y-%m-%d %H:%M:%S' \
    "$process_timestamp" '+%s' 2>/dev/null)" ||
    ((install_started_epoch > capture_epoch)) ||
    ((capture_epoch > process_epoch)) ||
    ((process_epoch > install_finished_epoch)) ||
    ((process_epoch - capture_epoch > 120)); then
    echo "DMG install $mode system runtime timeline is outside its install manifest" >&2
    return 1
  fi
}

require_install_task_identity() {
  local path="$1"
  local identity_line
  local trace_id
  local chain_id
  local definition_id
  local natural_day
  local trace_status
  local chain_state
  local definition_sequence
  local definition_title
  local uuid_pattern='^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$'

  if [[ ! -f "$path" || -L "$path" ]] ||
    ! awk -F $'\t' '
      NR == 1 {
        valid += ($0 == "trace_id\tchain_id\tdefinition_id\tdate\ttrace_status\tchain_state\tdefinition_sequence\ttitle")
      }
      NR == 2 {
        valid += (NF == 8 && $1 != "" && $2 != "" && $3 != "" &&
          $4 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ &&
          $5 == "pending" && $6 == "active" && $7 ~ /^[0-9]+$/ &&
          $8 == "dmgproductiontask")
      }
      END { exit !(NR == 2 && valid == 2) }
    ' "$path"; then
    echo "installed task independent identity ledger is incomplete or unsafe" >&2
    return 1
  fi
  identity_line="$(tail -n 1 "$path")"
  IFS=$'\t' read -r \
    trace_id chain_id definition_id natural_day trace_status chain_state \
    definition_sequence definition_title <<<"$identity_line"
  if [[ ! "$trace_id" =~ $uuid_pattern ]] ||
    [[ ! "$chain_id" =~ $uuid_pattern ]] ||
    [[ ! "$definition_id" =~ $uuid_pattern ]]; then
    echo "installed task independent identity ledger has an invalid UUID schema" >&2
    return 1
  fi
}

require_install_ledger_semantics() {
  local mode="$1"
  local path="$2"
  local expected_steps="$3"
  local actual_steps

  if [[ ! -f "$path" || -L "$path" ]]; then
    echo "DMG install $mode ledger is missing or unsafe" >&2
    return 1
  fi
  if ! actual_steps="$(awk -F $'\t' '
    NF != 4 ||
      $1 !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/ ||
      $2 != "PASS" || $3 == "" || $4 == "" { exit 1 }
    { steps = steps (steps == "" ? "" : ",") $3 }
    END { if (NR == 0) exit 1; print steps }
  ' "$path")"; then
    echo "DMG install $mode ledger has an invalid row" >&2
    return 1
  fi
  if [[ "$actual_steps" != "$expected_steps" ]]; then
    echo "DMG install $mode ledger has an incomplete or reordered phase set" >&2
    return 1
  fi
  if [[ "$(awk -F $'\t' '$3 == "permissions" && $4 == "AXIsProcessTrusted=true CGPreflightPostEventAccess=true" { count += 1 } END { print count + 0 }' "$path")" != "1" ]] ||
    [[ "$(tail -n 1 "$path")" != *$'\tPASS\tcomplete\t'"mode=$mode" ]]; then
    echo "DMG install $mode ledger lacks its exact permission or completion proof" >&2
    return 1
  fi

  local arguments_detail
  local process_detail
  local observer_detail
  local helper_pid
  local launch_token
  local app_path
  arguments_detail="$(awk -F $'\t' '$3 == "arguments" { print $4 }' "$path")"
  process_detail="$(awk -F $'\t' '$3 == "process" { print $4 }' "$path")"
  observer_detail="$(awk -F $'\t' '$3 == "exit-observer" { print $4 }' "$path")"
  if [[ ! "$process_detail" =~ ^mode=$mode[[:space:]]helper_pid=([1-9][0-9]*)[[:space:]]launch_token=([0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12})$ ]]; then
    echo "DMG install $mode ledger has an invalid helper process proof" >&2
    return 1
  fi
  helper_pid="${BASH_REMATCH[1]}"
  launch_token="${BASH_REMATCH[2]}"
  if [[ "$observer_detail" != \
    "helper_pid=$helper_pid launch_token=$launch_token observer=EVFILT_PROC+NOTE_EXITSTATUS" ]]; then
    echo "DMG install $mode ledger has a mismatched exit-observer proof" >&2
    return 1
  fi

  if [[ "$mode" == "preflight" ]]; then
    if [[ "$arguments_detail" != "mode=preflight" ]]; then
      echo "DMG install preflight ledger has an invalid arguments proof" >&2
      return 1
    fi
    return 0
  fi

  if [[ ! "$arguments_detail" =~ ^mode=$mode[[:space:]]pid=([1-9][0-9]*)[[:space:]]app=(/.*/Applications/Noonmark\.app)$ ]]; then
    echo "DMG install $mode ledger has an invalid installed App arguments proof" >&2
    return 1
  fi
  app_path="${BASH_REMATCH[2]}"
  if [[ "$(awk -F $'\t' '$3 == "target" { print $4 }' "$path")" != \
    "bundle=app.noonmark.mac path=$app_path frontmost=true windows=1" ]]; then
    echo "DMG install $mode ledger has an invalid target proof" >&2
    return 1
  fi
  if [[ "$(awk -F $'\t' '$3 == "main-window" { print $4 }' "$path")" != \
    "native AXWindow is visible" ]]; then
    echo "DMG install $mode ledger has an invalid main-window proof" >&2
    return 1
  fi
  if [[ "$(awk -F $'\t' '$3 == "quit-menu" { print $4 }' "$path")" != \
    "title=退出晷迹 shortcut=Command-q" ]] ||
    [[ "$(awk -F $'\t' '$3 == "quit" { print $4 }' "$path")" != \
      "terminated via real App menu click" ]]; then
    echo "DMG install $mode ledger has an invalid native quit proof" >&2
    return 1
  fi

  if [[ "$mode" == "exercise" ]]; then
    local settings_window_detail
    local title_visible_pattern
    settings_window_detail="$(
      awk -F $'\t' '$3 == "settings-window" { print $4 }' "$path"
    )"
    title_visible_pattern='^title=dmgproductiontask visibleAXMatches=[1-9][0-9]*$'
    if [[ "$(awk -F $'\t' '$3 == "settings-menu" { print $4 }' "$path")" != \
      "title=设置… shortcut=Command-," ]] ||
      ! require_settings_window_geometry "$settings_window_detail" ||
      [[ "$(awk -F $'\t' '$3 == "settings-close" { print $4 }' "$path")" != \
        "closed with real WindowServer click" ]] ||
      [[ "$(awk -F $'\t' '$3 == "quick-entry-menu" { print $4 }' "$path")" != \
        "title=快速记录… shortcut=Command-n" ]] ||
      [[ "$(awk -F $'\t' '$3 == "quick-entry-input" { print $4 }' "$path")" != \
        "value=dmgproductiontask source=cghidEventTap" ]] ||
      [[ "$(awk -F $'\t' '$3 == "quick-entry-add" { print $4 }' "$path")" != \
        "panel dismissed after real click" ]] ||
      [[ ! "$(awk -F $'\t' '$3 == "exercise-title-visible" { print $4 }' "$path")" =~ $title_visible_pattern ]]; then
      echo "DMG install exercise ledger has an invalid Settings, Quick Entry, input, or title proof" >&2
      return 1
    fi
  elif [[ ! "$(awk -F $'\t' '$3 == "restart-title-visible" { print $4 }' "$path")" =~ \
    ^title=dmgproductiontask[[:space:]]visibleAXMatches=[1-9][0-9]*$ ]]; then
    echo "DMG install restart ledger has an invalid persisted-title proof" >&2
    return 1
  fi
}

require_install_task_snapshot() {
  local path="$1"
  local label="$2"
  local expected_identity_line="$3"

  if [[ ! -f "$path" || -L "$path" ]] ||
    ! awk -F $'\t' '
      NR == 1 { valid += ($0 == "integrity_check=ok") }
      NR == 2 {
        sub(/^identity=/, "", $1)
        valid += (NF == 8 && $1 != "" && $2 != "" && $3 != "" &&
          $4 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ &&
          $5 == "pending" && $6 == "active" && $7 ~ /^[0-9]+$/ &&
          $8 == "dmgproductiontask")
      }
      NR == 3 {
        valid += ($0 ~ /^joined_row=\{"trace":\{/ &&
          $0 ~ /,"chain":\{/ && $0 ~ /,"definition":\{/)
      }
      END { exit !(NR == 3 && valid == 3) }
    ' "$path"; then
    echo "$label is not a complete installed task row snapshot" >&2
    return 1
  fi

  local identity_line
  local trace_id
  local chain_id
  local definition_id
  local natural_day
  local trace_status
  local chain_state
  local definition_sequence
  local definition_title
  local joined_json
  local json_path
  identity_line="$(sed -n '2s/^identity=//p' "$path")"
  if [[ "$identity_line" != "$expected_identity_line" ]]; then
    echo "installed task snapshot disagrees with its independent identity ledger" >&2
    return 1
  fi
  IFS=$'\t' read -r \
    trace_id chain_id definition_id natural_day trace_status chain_state \
    definition_sequence definition_title <<<"$identity_line"
  joined_json="$(sed -n '3s/^joined_row=//p' "$path")"
  json_path="$(mktemp "${TMPDIR:-/tmp}/noonmark-task-snapshot.XXXXXX.json")"
  printf '%s\n' "$joined_json" >"$json_path"
  if [[ "$(/usr/bin/plutil -extract trace.id raw -o - "$json_path" 2>/dev/null)" != "$trace_id" ]] ||
    [[ "$(/usr/bin/plutil -extract trace.chain_id raw -o - "$json_path")" != "$chain_id" ]] ||
    [[ "$(/usr/bin/plutil -extract trace.definition_id raw -o - "$json_path")" != "$definition_id" ]] ||
    [[ "$(/usr/bin/plutil -extract trace.date raw -o - "$json_path")" != "$natural_day" ]] ||
    [[ "$(/usr/bin/plutil -extract trace.status raw -o - "$json_path")" != "$trace_status" ]] ||
    [[ "$(/usr/bin/plutil -extract chain.id raw -o - "$json_path")" != "$chain_id" ]] ||
    [[ "$(/usr/bin/plutil -extract chain.state raw -o - "$json_path")" != "$chain_state" ]] ||
    [[ "$(/usr/bin/plutil -extract definition.id raw -o - "$json_path")" != "$definition_id" ]] ||
    [[ "$(/usr/bin/plutil -extract definition.chain_id raw -o - "$json_path")" != "$chain_id" ]] ||
    [[ "$(/usr/bin/plutil -extract definition.sequence raw -o - "$json_path")" != "$definition_sequence" ]] ||
    [[ "$(/usr/bin/plutil -extract definition.title raw -o - "$json_path")" != "$definition_title" ]]; then
    rm -f "$json_path"
    echo "$label identity disagrees with its joined SQLite row" >&2
    return 1
  fi
  rm -f "$json_path"
}

