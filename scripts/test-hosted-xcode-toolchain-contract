#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

fail() {
  echo "Hosted Xcode toolchain contract: $*" >&2
  exit 1
}

for workflow in .github/workflows/ci.yml .github/workflows/release-publish.yml; do
  [[ "$(grep -Fc 'runs-on: macos-15' "$workflow")" -ge 1 ]] ||
    fail "$workflow no longer uses the expected hosted macOS image"
  [[ "$(grep -Fc 'DEVELOPER_DIR: /Applications/Xcode_26.2.app/Contents/Developer' "$workflow")" -eq 1 ]] ||
    fail "$workflow does not bind exactly one Xcode 26.2 developer directory"
  [[ "$(grep -Fc '[[ "$(xcodebuild -version | sed -n '\''1p'\'')" == "Xcode 26.2" ]]' "$workflow")" -eq 1 ]] ||
    fail "$workflow does not fail closed on the selected Xcode version"
done

[[ "$(grep -Fc 'brew install actionlint ripgrep swiftlint swiftformat' \
  .github/workflows/ci.yml)" -eq 1 ]] ||
  fail "ordinary CI does not install the complete hosted check toolset"
[[ "$(grep -Fc 'brew install ripgrep' \
  .github/workflows/release-publish.yml)" -eq 1 ]] ||
  fail "release packaging does not install its ripgrep dependency"
if rg -F 'swiftlint swiftformat' \
  .github/workflows/release-publish.yml >/dev/null; then
  fail "release packaging reinstalls tools owned by the prior hosted check"
fi

rg -F 'swift xcodebuild xcrun actionlint rg swiftlint swiftformat sips iconutil' \
  scripts/check >/dev/null ||
  fail "scripts/check does not fail fast when ripgrep is unavailable"

rg -F 'NOONMARK_EVIDENCE_RUN_ID: github-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.sha }}' \
  .github/workflows/ci.yml >/dev/null ||
  fail "hosted check lacks its source-bound run ID"

echo "Hosted Xcode toolchain contract passed"
