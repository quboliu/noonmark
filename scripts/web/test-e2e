#!/usr/bin/env bash
set -euo pipefail
noonmark_e2e_build="${NOONMARK_E2E_BUILD_ROOT:-${NOONMARK_BUILD_ROOT:-}}"
if [[ -z "$noonmark_e2e_build" ]]; then
  source "$(dirname -- "$0")/env" release-validation
  "$NOONMARK_SOURCE_ROOT/scripts/web/package"
  noonmark_e2e_build="$NOONMARK_BUILD_ROOT"
fi
source "$(dirname -- "$0")/env" e2e
export NOONMARK_E2E_BUILD_ROOT="$noonmark_e2e_build"
export CS_TEST_STACK=1
trap '"$NOONMARK_SOURCE_ROOT/scripts/web/check-workspace"' EXIT
python3 -B "$NOONMARK_SOURCE_ROOT/scripts/web/test-e2e.py"
