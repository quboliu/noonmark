workflow_dir="artifacts/e2e-workflow"
workflow_db="${workflow_dir}/Noonmark.sqlite"
workflow_result="${workflow_dir}/workflow-result.txt"
workflow_title="E2E 排期延期复盘"
rm -rf "$workflow_dir"
mkdir -p "$workflow_dir"

open -W -n "$app_path" --args \
  --data-url "$PWD/$workflow_db" \
  --page pool \
  --e2e-fixed-instant 2026-07-05T16:00:00Z \
  --e2e-fixed-time-zone America/New_York \
  --e2e-domain-workflow \
  --e2e-workflow-title "$workflow_title" \
  --e2e-workflow-result-url "$PWD/$workflow_result" \
  --e2e-quit-after-automation

if [[ ! -f "$workflow_result" ]]; then
  echo "workflow e2e result was not created: $workflow_result" >&2
  exit 1
fi

if [[ "$(cat "$workflow_result")" != "ok" ]]; then
  echo "workflow e2e failed: $(cat "$workflow_result")" >&2
  exit 1
fi

read -r workflow_deferred workflow_pending workflow_review < <(
  sqlite3 -separator " " "$workflow_db" "
    SELECT
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-05'
         AND day_traces.status = 'deferred'),
      (SELECT count(*)
       FROM day_traces
       JOIN task_definitions ON task_definitions.id = day_traces.definition_id
       WHERE task_definitions.title = '$workflow_title'
         AND day_traces.date = '2026-07-06'
         AND day_traces.status = 'pending'
         AND day_traces.continuation_seq = 0
         AND day_traces.carried_from_trace_id IN (
           SELECT source.id
           FROM day_traces AS source
           JOIN task_definitions AS source_definition
             ON source_definition.id = source.definition_id
           WHERE source_definition.title = '$workflow_title'
             AND source.date = '2026-07-05'
             AND source.status = 'deferred'
         )),
      (SELECT count(*)
       FROM days
       WHERE date = '2026-07-05'
         AND review_summary = 'E2E 已完成排期、延期和复盘写入。'
         AND review_unfinished_reason = '验证真实 App workflow 自动化。'
         AND review_tomorrow_note = '明天检查延期任务。');
  "
)

if [[ "$workflow_deferred" -ne 1 || "$workflow_pending" -ne 1 || "$workflow_review" -ne 1 ]]; then
  echo "workflow e2e persistence failed: deferred=$workflow_deferred pending=$workflow_pending review=$workflow_review" >&2
  exit 1
fi

echo "E2E domain workflow: $workflow_db (deferred=$workflow_deferred pending=$workflow_pending review=$workflow_review)"

run_lifecycle_persistence_probe
run_mutation_clock_probe
run_preferences_clock_probe
run_natural_day_rollover_probe

