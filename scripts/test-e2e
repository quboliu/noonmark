#!/usr/bin/env bash
set -euo pipefail

# Physical WindowServer input is meaningful only when rebuilds preserve the
# App's designated requirement and the user's one-time TCC authorization.
export NOONMARK_REQUIRE_STABLE_UI_SIGNING=1

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

source scripts/runtime-evidence
source scripts/evidence-common
source scripts/dmg-install-observer-common
source scripts/diagnostic-scope-manifest
source scripts/diagnostic-lock-evidence
source scripts/dmg-harness-evidence

configuration="${1:-debug}"
evidence_prepare_fresh_directory "$repo_root" "artifacts/e2e-runtime"
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "missing required tool: sqlite3" >&2
  exit 1
fi
if ! command -v caffeinate >/dev/null 2>&1; then
  echo "missing required tool: caffeinate" >&2
  exit 1
fi
console_session_state="$(/usr/sbin/ioreg -n Root -d1 2>/dev/null || true)"
if [[ "$console_session_state" == *'"CGSSessionScreenIsLocked"=Yes'* ]]; then
  echo "real App E2E requires an unlocked macOS console session" >&2
  exit 1
fi

# The suite exercises real AppKit focus, keyboard events, menus, and screenshots.
# Wake the interactive display once, then keep it awake until this process exits.
# Without this assertion, a long suite can cross macOS display sleep and produce
# false focus or framebuffer failures halfway through otherwise valid scenarios.
caffeinate -d -i -u -w "$$" >/dev/null 2>&1 &
display_assertion_pid=$!

app_bundle_name="NoonmarkE2E"
app_executable_name="NoonmarkMacAppE2E"
app_display_name="晷迹 E2E"
expected_window_width="1200"
expected_window_height="768"
app_path="dist/${app_bundle_name}.app"
app_executable_path="${app_path}/Contents/MacOS/${app_executable_name}"
runtime_evidence_dir="artifacts/e2e-runtime"
runtime_console_log="${runtime_evidence_dir}/unified.log"
runtime_diagnostic_baseline="${runtime_evidence_dir}/diagnostic-baseline.txt"
runtime_diagnostic_result="${runtime_evidence_dir}/diagnostic-result.txt"
runtime_manifest="${runtime_evidence_dir}/runtime-manifest.txt"
runtime_evidence_started=0
evidence_manifest="${runtime_evidence_dir}/manifest.txt"
evidence_inventory_path="${runtime_evidence_dir}/artifact-inventory.sha256"
evidence_source_start="${runtime_evidence_dir}/source-start.fragment"
evidence_source_end="${runtime_evidence_dir}/source-end.fragment"
evidence_app_start="${runtime_evidence_dir}/app-start.fragment"
evidence_app_end="${runtime_evidence_dir}/app-end.fragment"
evidence_app_snapshot="${runtime_evidence_dir}/app-snapshot/NoonmarkE2E.app"
english_scenario_ledger="${runtime_evidence_dir}/english-scenario-ledger.tsv"
helper_process_name="NoonmarkDMGInstallHarness"
helper_bundle="artifacts/dmg-install-harness/${helper_process_name}.app"
helper_executable_path="${repo_root}/${helper_bundle}/Contents/MacOS/${helper_process_name}"
helper_bundle_identifier="app.noonmark.test.dmg-install-harness"
window_probe_executable_path="${repo_root}/artifacts/window-probe/NoonmarkWindowProbe"
helper_diagnostic_baseline="${runtime_evidence_dir}/helper-diagnostic-baseline.txt"
helper_diagnostic_result="${runtime_evidence_dir}/helper-diagnostic-result.txt"
evidence_helper_start="${runtime_evidence_dir}/helper-start.fragment"
evidence_helper_end="${runtime_evidence_dir}/helper-end.fragment"
evidence_helper_snapshot="${runtime_evidence_dir}/helper-snapshot/NoonmarkDMGInstallHarness.app"
evidence_window_probe_snapshot="${runtime_evidence_dir}/probe-snapshot/NoonmarkWindowProbe"
windowserver_input_cleanup_result="${runtime_evidence_dir}/windowserver-input-cleanup-result.txt"
windowserver_input_cleanup_log="${runtime_evidence_dir}/windowserver-input-cleanup.log"
evidence_run_id="${NOONMARK_EVIDENCE_RUN_ID:-$(date -u '+%Y%m%dT%H%M%SZ')-$$}"
suite_mode="full"
only_mode=""
app_binary_sha256_before=""
helper_binary_sha256_before=""
window_probe_binary_sha256_before=""
english_helper_requested=0
helper_requested=0
active_native_command_helper_pid=""
active_native_command_helper_token=""
active_native_command_helper_mode=""
active_helper_observer_pid=""
active_helper_observer_parent_pid=""
active_helper_observer_token=""
active_ui_entry_start_gate=""
active_ui_entry_start_gate_token=""
ui_entry_start_gate_fd_open=0
e2e_owned_artifact_roots=(
  artifacts/e2e
  artifacts/e2e-automatic-classification
  artifacts/e2e-blank
  artifacts/e2e-calendar-grid-topology
  artifacts/e2e-classification
  artifacts/e2e-completion-control
  artifacts/e2e-context-menu-actions
  artifacts/e2e-copy-undo-persistence
  artifacts/e2e-data-import-integrity
  artifacts/e2e-data-import-ui
  artifacts/e2e-data-package
  artifacts/e2e-data-package-import-failure
  artifacts/e2e-date-picker
  artifacts/e2e-date-strip
  artifacts/e2e-detail-rail
  artifacts/e2e-diagnostic-closure
  artifacts/e2e-english
  artifacts/e2e-english-native-command-surface
  artifacts/e2e-english-native-command-stress
  artifacts/e2e-global-quick-entry
  artifacts/e2e-header-navigation-hit-target
  artifacts/e2e-idea-capture
  artifacts/e2e-keyboard-date
  artifacts/e2e-lifecycle
  artifacts/e2e-markdown-editor
  artifacts/e2e-main-window-chrome
  artifacts/e2e-mutation-clock
  artifacts/e2e-native-command-surface
  artifacts/e2e-native-command-stress
  artifacts/e2e-natural-day
  artifacts/e2e-persistence
  artifacts/e2e-pool-context-menu-action
  artifacts/e2e-pool-list-layout
  artifacts/e2e-preferences-clock
  artifacts/e2e-provider
  artifacts/e2e-quick-add-ui
  artifacts/e2e-reactivation-atomicity
  artifacts/e2e-review-zhulong-entry
  artifacts/e2e-review-detail-ux
  artifacts/e2e-runtime
  artifacts/e2e-seed-clock
  artifacts/e2e-subtask-clock
  artifacts/e2e-subtask-layout
  artifacts/e2e-summary-sidebar
  artifacts/e2e-task-note-atomicity
  artifacts/e2e-task-notes
  artifacts/e2e-ui-entry
  artifacts/e2e-undo
  artifacts/e2e-unfinished-actions
  artifacts/e2e-window-close
  artifacts/e2e-window-resize
  artifacts/e2e-workflow
  artifacts/e2e-workspace-productivity
  artifacts/e2e-workspace-restoration
  artifacts/e2e-zhulong
  artifacts/e2e-zhulong-chat
  artifacts/e2e-zhulong-inline-artifact
  artifacts/e2e-zhulong-exact-recovery
  artifacts/e2e-zhulong-navigation
  artifacts/e2e-zhulong-pending-gate
  artifacts/e2e-zhulong-provider-settings
  artifacts/e2e-zhulong-recovery
  artifacts/e2e-zhulong-todo-diff
)
export NOONMARK_E2E_APP_EXECUTABLE_NAME="$app_executable_name"
export NOONMARK_E2E_APP_DISPLAY_NAME="$app_display_name"
export NOONMARK_E2E_EXPECTED_WINDOW_WIDTH="$expected_window_width"
export NOONMARK_E2E_EXPECTED_WINDOW_HEIGHT="$expected_window_height"

scenarios=(
  "day|day|"
  "day-sidebar-collapsed|day|--e2e-collapse-sidebar"
  "day-subtasks-expanded|day|--e2e-expand-first-subtask-trace"
  "day-changed-target|day|--select changed"
  "day-detail|day|--select first"
  "day-pointer-selection|day|--e2e-selection-focus-result-url $PWD/artifacts/e2e/day-pointer-selection-result.txt"
  "day-manual-detail|day|--select manual"
  "day-review-saved|day|--e2e-update-review --e2e-review-summary E2E自动保存反馈"
  "pool|pool|"
  "pool-context-menu|pool|--e2e-open-pool-context-menu"
  "pool-classification-overflow|pool|--e2e-classification-overflow-via-ui --e2e-classification-overflow-ui-result-url $PWD/artifacts/e2e/pool-classification-overflow-ui.txt --e2e-ui-entry-keep-open --e2e-classification-overflow-invalidate-first-ready"
  "pool-classification-manager|pool|--select first --e2e-classification-manager-via-ui --e2e-classification-manager-ui-result-url $PWD/artifacts/e2e/pool-classification-manager-ui.txt --e2e-ui-entry-keep-open"
  "pool-classification-manager-labels|pool|--select first --e2e-classification-manager-labels-via-ui --e2e-classification-manager-ui-result-url $PWD/artifacts/e2e/pool-classification-manager-labels-ui.txt --e2e-ui-entry-keep-open"
  "pool-detail|pool|--select first"
  "pool-detail-classification-edit|pool|--select first --e2e-open-classification-label-editor"
  "pool-detail-classification-label-menu|pool|--select first --e2e-classification-label-menu-via-ui --e2e-classification-label-menu-ui-result-url $PWD/artifacts/e2e/pool-classification-label-menu-ui.txt --e2e-ui-entry-keep-open"
  "future|future|"
  "future-detail|future|--select first"
  "unfinished|unfinished|"
  "unfinished-detail|unfinished|--select first"
  "completed|completed|"
  "completed-detail|completed|--select first"
  "calendar|calendar|"
  "calendar-detail-expanded|calendar|--e2e-expand-detail-rail"
  "zhulong|zhulong|--e2e-enable-zhulong --e2e-zhulong-title-geometry --e2e-zhulong-title-geometry-result-url $PWD/artifacts/e2e/zhulong-title-geometry.txt"
  "zhulong-stream|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-title-geometry --e2e-zhulong-title-geometry-result-url $PWD/artifacts/e2e/zhulong-stream-title-geometry.txt"
  "zhulong-stream-detail-expanded|zhulong|--e2e-expand-detail-rail --e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-title-geometry --e2e-zhulong-title-geometry-result-url $PWD/artifacts/e2e/zhulong-stream-detail-expanded-title-geometry.txt"
  "zhulong-stream-dossier|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-stream-variant dossier"
  "zhulong-stream-chapters|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-stream-variant chapters"
  "zhulong-stream-weave|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-intent 结束今天并安排明天 --e2e-rich-zhulong-session --e2e-zhulong-stream-variant weave"
  "zhulong-authorized|zhulong|--e2e-zhulong-sidecar-key --e2e-start-zhulong-workflow dailyReview"
  "zhulong-todo-diff-editor|zhulong|--e2e-zhulong-sidecar-key --e2e-prepare-zhulong-todo-diff --e2e-open-zhulong-todo-diff-editor"
  "settings|settings|"
  "settings-zhulong|settings|--e2e-settings-zhulong"
  "settings-groups|settings|--e2e-settings-groups"
  "settings-sync|settings|--e2e-settings-sync"
  "day-minimum-window|day|--e2e-window-size 960x720"
  "day-wide-window|day|--e2e-window-size 1440x900"
  "english-day|day|--select first --e2e-window-size 960x720 --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/day-ui.txt|english"
  "english-day-wide|day|--select first --e2e-window-size 1440x900 --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/day-wide-ui.txt|english"
  "english-day-history-header|day|--e2e-window-size 960x720 --e2e-expand-detail-rail --e2e-verify-english-populated-screenshot --e2e-english-history-header --e2e-english-ui-result-url $PWD/artifacts/e2e-english/day-history-header-ui.txt|english"
  "english-pool|pool|--select first --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/pool-ui.txt|english"
  "english-future|future|--select first --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/future-ui.txt|english"
  "english-unfinished|unfinished|--select first --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/unfinished-ui.txt|english"
  "english-completed|completed|--select first --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/completed-ui.txt|english"
  "english-calendar|calendar|--e2e-expand-detail-rail --e2e-verify-english-populated-screenshot --e2e-english-ui-result-url $PWD/artifacts/e2e-english/calendar-ui.txt|english"
  "english-settings|settings||english"
  "english-zhulong|zhulong|--e2e-enable-zhulong --e2e-zhulong-title-geometry --e2e-zhulong-title-geometry-result-url $PWD/artifacts/e2e-english/zhulong-title-geometry.txt|english"
)

english_full_scenario_set="english-day,english-day-wide,english-day-history-header,english-pool,english-future,english-unfinished,english-completed,english-calendar,english-settings,english-zhulong"
only_mode_specs=(
  "NOONMARK_E2E_AUTOMATIC_CLASSIFICATION_ONLY:automatic-classification"
  "NOONMARK_E2E_AUTOMATIC_CLASSIFICATION_STATUS_SURFACES_ONLY:automatic-classification-status-surfaces"
  "NOONMARK_E2E_AUTOMATIC_CLASSIFICATION_PROVIDER_BLOCK_RETRY_ONLY:automatic-classification-provider-block-retry"
  "NOONMARK_E2E_CONTEXT_MENU_ACTIONS_ONLY:context-menu-actions"
  "NOONMARK_E2E_UI_ENTRY_ONLY:ui-entry"
  "NOONMARK_E2E_TASK_CYCLE_MUTATION_ONLY:task-cycle-mutation"
  "NOONMARK_E2E_SEED_CLOCK_ONLY:seed-clock"
  "NOONMARK_E2E_TASK_NOTE_ONLY:task-note"
  "NOONMARK_E2E_TASK_NOTE_ATOMICITY_ONLY:task-note-atomicity"
  "NOONMARK_E2E_REVIEW_DETAIL_UX_ONLY:review-detail-ux"
  "NOONMARK_E2E_COPY_UNDO_ONLY:copy-undo"
  "NOONMARK_E2E_LIFECYCLE_ONLY:lifecycle"
  "NOONMARK_E2E_NATURAL_DAY_ONLY:natural-day"
  "NOONMARK_E2E_MUTATION_CLOCK_ONLY:mutation-clock"
  "NOONMARK_E2E_PREFERENCES_CLOCK_ONLY:preferences-clock"
  "NOONMARK_E2E_SUBTASK_CLOCK_ONLY:subtask-clock"
  "NOONMARK_E2E_SUBTASK_LAYOUT_ONLY:subtask-layout"
  "NOONMARK_E2E_WINDOW_RESIZE_ONLY:window-resize"
  "NOONMARK_E2E_COMPLETION_SEQUENCE_ONLY:completion-sequence"
  "NOONMARK_E2E_WINDOW_STATE_ONLY:window-state"
  "NOONMARK_E2E_GLOBAL_QUICK_ENTRY_ONLY:global-quick-entry"
  "NOONMARK_E2E_IDEA_CAPTURE_ONLY:idea-capture"
  "NOONMARK_E2E_NATIVE_COMMANDS_ONLY:native-commands"
  "NOONMARK_E2E_ENGLISH_NATIVE_COMMANDS_ONLY:english-native-commands"
  "NOONMARK_E2E_COMPLETION_CONTROL_ONLY:completion-control"
  "NOONMARK_E2E_WORKSPACE_PRODUCTIVITY_ONLY:workspace-productivity"
  "NOONMARK_E2E_DATA_IMPORT_UI_ONLY:data-import-ui"
  "NOONMARK_E2E_DATA_IMPORT_INTEGRITY_ONLY:data-import-integrity"
  "NOONMARK_E2E_DIAGNOSTIC_CLOSURE_ONLY:diagnostic-closure"
  "NOONMARK_E2E_DATE_PICKER_ONLY:date-picker"
  "NOONMARK_E2E_HORIZONTAL_PAGE_NAVIGATION_ONLY:horizontal-page-navigation"
  "NOONMARK_E2E_POOL_LIST_LAYOUT_ONLY:pool-list-layout"
  "NOONMARK_E2E_POOL_CONTEXT_ACTION_ONLY:pool-context-action"
  "NOONMARK_E2E_UNFINISHED_ACTION_ONLY:unfinished-action"
  "NOONMARK_E2E_IMMEDIATE_TASK_MUTATION_ONLY:immediate-task-mutation"
  "NOONMARK_E2E_SUMMARY_SIDEBAR_ONLY:summary-sidebar"
  "NOONMARK_E2E_MARKDOWN_ONLY:markdown"
  "NOONMARK_E2E_QUICK_ADD_UI_ONLY:quick-add-ui"
  "NOONMARK_E2E_ZHULONG_NAVIGATION_ONLY:zhulong-navigation"
  "NOONMARK_E2E_ZHULONG_CHAT_ONLY:zhulong-chat"
  "NOONMARK_E2E_ZHULONG_INLINE_ARTIFACT_ONLY:zhulong-inline-artifact"
  "NOONMARK_E2E_ZHULONG_PROVIDER_SETTINGS_ONLY:zhulong-provider-settings"
  "NOONMARK_E2E_ZHULONG_PENDING_GATE_ONLY:zhulong-pending-gate"
  "NOONMARK_E2E_ZHULONG_TODO_DIFF_ONLY:zhulong-todo-diff"
  "NOONMARK_E2E_ZHULONG_APPLICATION_CLOCK_ONLY:zhulong-application-clock"
)
only_mode_count=0
for only_spec in "${only_mode_specs[@]}"; do
  IFS=":" read -r only_variable only_name <<< "$only_spec"
  only_value="${!only_variable:-0}"
  if [[ "$only_value" != "0" && "$only_value" != "1" ]]; then
    echo "$only_variable must be exactly 0 or 1" >&2
    exit 1
  fi
  if [[ "$only_value" == "1" ]]; then
    only_mode_count=$((only_mode_count + 1))
    only_mode="$only_name"
  fi
done
if (( only_mode_count > 1 )); then
  echo "exactly zero or one NOONMARK_E2E_*_ONLY mode may be enabled" >&2
  exit 1
fi

native_command_stress_count="${NOONMARK_E2E_NATIVE_COMMAND_STRESS_COUNT:-1}"
if [[ ! "$native_command_stress_count" =~ ^[1-9][0-9]*$ ]] ||
  (( native_command_stress_count > 32 )); then
  echo "NOONMARK_E2E_NATIVE_COMMAND_STRESS_COUNT must be an integer from 1 through 32" >&2
  exit 1
fi
if (( native_command_stress_count > 1 )) &&
  [[ "$only_mode" != "native-commands" && "$only_mode" != "english-native-commands" ]]; then
  echo "native command stress requires one native-command ONLY mode" >&2
  exit 1
fi

screenshots_only="${NOONMARK_E2E_SCREENSHOTS_ONLY:-0}"
if [[ "$screenshots_only" != "0" && "$screenshots_only" != "1" ]]; then
  echo "NOONMARK_E2E_SCREENSHOTS_ONLY must be exactly 0 or 1" >&2
  exit 1
fi
requested_scenarios="${NOONMARK_E2E_SCENARIOS:-}"
if (( only_mode_count == 1 )) &&
  { [[ -n "$requested_scenarios" ]] || [[ "$screenshots_only" == "1" ]]; }; then
  echo "an E2E ONLY mode cannot be combined with screenshot filters" >&2
  exit 1
fi
if (( only_mode_count == 1 )); then
  suite_mode="only:${only_mode}"
elif [[ "$screenshots_only" == "1" ]]; then
  suite_mode="screenshots-only"
elif [[ -n "$requested_scenarios" ]]; then
  suite_mode="filtered-screenshots-plus-full-probes"
fi

require_full_suite="${NOONMARK_EVIDENCE_REQUIRE_FULL_SUITE:-0}"
if [[ "$require_full_suite" != "0" && "$require_full_suite" != "1" ]]; then
  echo "NOONMARK_EVIDENCE_REQUIRE_FULL_SUITE must be exactly 0 or 1" >&2
  exit 1
fi
if [[ "$require_full_suite" == "1" && "$suite_mode" != "full" ]]; then
  echo "the final evidence gate requires the unfiltered full E2E suite" >&2
  exit 1
fi

if [[ -n "$requested_scenarios" ]]; then
  filtered_scenarios=()
  filtered_scenario_names=()
  for requested in $requested_scenarios; do
    for filtered_name in "${filtered_scenario_names[@]:-}"; do
      if [[ "$filtered_name" == "$requested" ]]; then
        echo "duplicate E2E screenshot scenario: $requested" >&2
        exit 1
      fi
    done
    found=0
    for scenario in "${scenarios[@]}"; do
      IFS="|" read -r screenshot_name _ <<< "$scenario"
      if [[ "$screenshot_name" == "$requested" ]]; then
        filtered_scenarios+=("$scenario")
        filtered_scenario_names+=("$requested")
        found=1
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      echo "unknown E2E screenshot scenario: $requested" >&2
      exit 1
    fi
  done
  if (( ${#filtered_scenarios[@]} == 0 )); then
    echo "NOONMARK_E2E_SCENARIOS must select at least one exact scenario" >&2
    exit 1
  fi
  scenarios=("${filtered_scenarios[@]}")
fi

scenario_names=()
english_scenario_names=()
if (( only_mode_count == 0 )); then
  for scenario in "${scenarios[@]}"; do
    IFS="|" read -r screenshot_name _ _ scenario_language <<< "$scenario"
    scenario_names+=("$screenshot_name")
    if [[ "$scenario_language" == "english" ]]; then
      english_scenario_names+=("$screenshot_name")
    fi
  done
fi
scenario_set="none"
if (( ${#scenario_names[@]} > 0 )); then
  scenario_set="$(IFS=,; echo "${scenario_names[*]}")"
fi
english_scenario_set="none"
if (( ${#english_scenario_names[@]} > 0 )); then
  english_scenario_set="$(IFS=,; echo "${english_scenario_names[*]}")"
fi
for english_scenario_name in "${english_scenario_names[@]:-}"; do
  if [[ "$english_scenario_name" == "english-day" ]]; then
    english_helper_requested=1
    break
  fi
done
helper_requested="$english_helper_requested"
if [[ "$screenshots_only" != "1" ]] && {
  (( only_mode_count == 0 )) ||
    [[ "$only_mode" == "native-commands" ]] ||
    [[ "$only_mode" == "english-native-commands" ]] ||
    [[ "$only_mode" == "completion-sequence" ]] ||
    [[ "$only_mode" == "data-import-ui" ]] ||
    [[ "$only_mode" == "data-import-integrity" ]] ||
    [[ "$only_mode" == "diagnostic-closure" ]];
}; then
  helper_requested=1
fi

mkdir -p artifacts
for artifact_root in "${e2e_owned_artifact_roots[@]}"; do
  evidence_prepare_fresh_directory "$repo_root" "$artifact_root"
done
evidence_capture_source "$repo_root" "source" "$evidence_source_start"
evidence_begin_manifest \
  "$evidence_manifest" \
  "mac-app-e2e" \
  "$evidence_run_id" \
  "$configuration" \
  "$suite_mode"
evidence_append_snapshot "$evidence_manifest" "$evidence_source_start"
evidence_append "$evidence_manifest" "scenario_count" "${#scenario_names[@]}"
evidence_append "$evidence_manifest" "scenario_set" "$scenario_set"
evidence_append \
  "$evidence_manifest" \
  "english_scenario_expected_count" \
  "${#english_scenario_names[@]}"
evidence_append \
  "$evidence_manifest" \
  "english_scenario_expected_set" \
  "$english_scenario_set"
evidence_append "$evidence_manifest" "only_mode" "${only_mode:-none}"
evidence_append \
  "$evidence_manifest" \
  "english_full_scenario_set" \
  "$english_full_scenario_set"
evidence_append \
  "$evidence_manifest" \
  "english_oracle_policy" \
  "screenshot+in_app_contract;external_ax=english-day-only"
printf 'scenario\tapp_binary_sha256\tscreenshot_sha256\toracles\texternal_ax\n' \
  >"$english_scenario_ledger"

scripts/reset-dev-data e2e
scripts/build-mac-app "$configuration" e2e
scripts/build-window-probe "$configuration" >/dev/null
if [[ ! -f "$window_probe_executable_path" ||
  -L "$window_probe_executable_path" ||
  ! -x "$window_probe_executable_path" ]]; then
  echo "E2E window probe build did not create its fixed executable" >&2
  exit 1
fi
window_probe_binary_sha256_before="$(
  shasum -a 256 "$window_probe_executable_path" | awk '{print $1}'
)"
if [[ ! "$window_probe_binary_sha256_before" =~ ^[0-9a-f]{64}$ ]]; then
  echo "E2E window probe SHA-256 was unavailable" >&2
  exit 1
fi
evidence_append \
  "$evidence_manifest" \
  "window_probe_binary_sha256_before" \
  "$window_probe_binary_sha256_before"
evidence_capture_bundle "$app_path" 1 "app" "$evidence_app_start"
evidence_append_snapshot "$evidence_manifest" "$evidence_app_start"
app_binary_sha256_before="$(evidence_read "$evidence_app_start" "app_binary_sha256")"
evidence_append \
  "$evidence_manifest" \
  "app_binary_sha256_before" \
  "$app_binary_sha256_before"
english_scenarios_requested=0
if (( only_mode_count == 0 )); then
  for scenario in "${scenarios[@]}"; do
    IFS="|" read -r _ _ _ scenario_language <<< "$scenario"
    if [[ "$scenario_language" == "english" ]]; then
      english_scenarios_requested=1
      break
    fi
  done
fi
if [[ "$helper_requested" == "1" ]]; then
  scripts/build-dmg-install-harness "$configuration"
  evidence_capture_bundle \
    "$helper_bundle" \
    1 \
    "helper" \
    "$evidence_helper_start"
  evidence_append_snapshot "$evidence_manifest" "$evidence_helper_start"
  helper_binary_sha256_before="$(
    evidence_read "$evidence_helper_start" "helper_binary_sha256"
  )"
  evidence_append \
    "$evidence_manifest" \
    "helper_binary_sha256_before" \
    "$helper_binary_sha256_before"
fi

mkdir -p artifacts/e2e

terminate_e2e_app() {
  pkill -x "$app_executable_name" 2>/dev/null || true
  for _ in {1..40}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    pkill -9 -x "$app_executable_name" 2>/dev/null || true
  fi
  for _ in {1..20}; do
    if ! pgrep -x "$app_executable_name" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    echo "failed to terminate ${app_executable_name}" >&2
    return 1
  fi
  return 0
}

native_command_helper_process_matches() {
  local pid="$1"
  local mode="$2"
  local token="$3"
  local command_line

  if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]] ||
    { [[ "$mode" != "e2e-menu-command" ]] &&
      [[ "$mode" != "e2e-open-panel" ]] &&
      [[ "$mode" != "diagnostic-export" ]]; } ||
    [[ ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    return 2
  fi
  if ! command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"; then
    return 1
  fi
  { [[ "$command_line" == "$helper_executable_path" ]] ||
    [[ "$command_line" == "$helper_executable_path "* ]]; } &&
    [[ " $command_line " == *" --mode $mode "* ]] &&
    [[ " $command_line " == *" --launch-token $token "* ]]
}

native_command_helper_bundle_matches() {
  local pid="$1"

  NOONMARK_E2E_HELPER_PID="$pid" \
    NOONMARK_E2E_HELPER_BUNDLE="$PWD/$helper_bundle" \
    NOONMARK_E2E_HELPER_BUNDLE_ID="$helper_bundle_identifier" \
    swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawPID = environment["NOONMARK_E2E_HELPER_PID"],
      let pid = Int32(rawPID), pid > 0,
      let expectedBundle = environment["NOONMARK_E2E_HELPER_BUNDLE"],
      let expectedBundleID = environment["NOONMARK_E2E_HELPER_BUNDLE_ID"]
else {
    exit(2)
}
let expectedPath = URL(fileURLWithPath: expectedBundle)
    .standardizedFileURL.resolvingSymlinksInPath().path
let deadline = ProcessInfo.processInfo.systemUptime + 3
repeat {
    if let app = NSRunningApplication(processIdentifier: pid),
       app.isTerminated == false,
       let bundleURL = app.bundleURL,
       app.bundleIdentifier == expectedBundleID,
       bundleURL.standardizedFileURL.resolvingSymlinksInPath().path == expectedPath
    {
        exit(0)
    }
    usleep(25_000)
} while ProcessInfo.processInfo.systemUptime < deadline
fputs("helper LaunchServices bundle identity did not match\n", stderr)
exit(1)
'
}

native_command_app_ready_identity_matches() {
  local pid="$1"
  local app_bundle_path="$2"
  local window_number="$3"
  local window_title="$4"
  local snapshot

  if ! NOONMARK_E2E_READY_PID="$pid" \
    NOONMARK_E2E_READY_APP="$app_bundle_path" \
    NOONMARK_E2E_READY_WINDOW_NUMBER="$window_number" \
    NOONMARK_E2E_READY_WINDOW_TITLE="$window_title" \
    swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawPID = environment["NOONMARK_E2E_READY_PID"],
      let pid = Int32(rawPID), pid > 0,
      let expectedApp = environment["NOONMARK_E2E_READY_APP"],
      let rawWindowNumber = environment["NOONMARK_E2E_READY_WINDOW_NUMBER"],
      let windowNumber = UInt32(rawWindowNumber), windowNumber > 0,
      let expectedWindowTitle = environment["NOONMARK_E2E_READY_WINDOW_TITLE"],
      expectedWindowTitle.isEmpty == false,
      let app = NSRunningApplication(processIdentifier: pid),
      app.isTerminated == false,
      app.isActive,
      app.bundleIdentifier == "app.noonmark.mac.e2e",
      let bundleURL = app.bundleURL
else {
    fputs("ready App process identity was invalid\n", stderr)
    exit(1)
}

let expectedPath = URL(fileURLWithPath: expectedApp)
    .standardizedFileURL.resolvingSymlinksInPath().path
let actualPath = bundleURL.standardizedFileURL.resolvingSymlinksInPath().path
guard actualPath == expectedPath else {
    fputs("ready App bundle identity was invalid\n", stderr)
    exit(1)
}
'
  then
    return 1
  fi
  if ! snapshot="$(
    "$window_probe_executable_path" --window-number "$window_number" 2>/dev/null
  )"; then
    return 1
  fi
  jq -e \
    --argjson expected_window_number "$window_number" \
    --argjson expected_pid "$pid" \
    --arg expected_title "$window_title" \
    'keys == [
      "alpha", "frame", "is_onscreen", "layer",
      "owner_process_identifier", "schema_version", "title", "window_number"
    ] and
    .schema_version == 1 and
    .window_number == $expected_window_number and
    .owner_process_identifier == $expected_pid and
    .layer == 0 and
    .is_onscreen == true and
    (.title == null or .title == $expected_title)' \
    <<<"$snapshot" >/dev/null
}

open_panel_app_ready_identity_matches() {
  local pid="$1"
  local app_bundle_path="$2"
  local window_number="$3"
  local window_title="$4"
  local window_layer="$5"
  local snapshot

  if ! NOONMARK_E2E_READY_PID="$pid" \
    NOONMARK_E2E_READY_APP="$app_bundle_path" \
    swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let rawPID = environment["NOONMARK_E2E_READY_PID"],
      let pid = Int32(rawPID), pid > 0,
      let expectedApp = environment["NOONMARK_E2E_READY_APP"],
      let app = NSRunningApplication(processIdentifier: pid),
      app.isTerminated == false,
      app.bundleIdentifier == "app.noonmark.mac.e2e",
      let bundleURL = app.bundleURL
else { exit(1) }
let expectedPath = URL(fileURLWithPath: expectedApp)
    .standardizedFileURL.resolvingSymlinksInPath().path
let actualPath = bundleURL.standardizedFileURL.resolvingSymlinksInPath().path
guard actualPath == expectedPath else { exit(1) }
'; then
    echo "Open-panel ready App PID, bundle, or canonical path was invalid" >&2
    return 1
  fi
  if ! snapshot="$(
    "$window_probe_executable_path" --window-number "$window_number" 2>/dev/null
  )"; then
    echo "Open-panel ready exact WindowServer ID was unavailable: $window_number" >&2
    return 1
  fi
  if ! jq -e \
    --argjson expected_window_number "$window_number" \
    --argjson expected_layer "$window_layer" \
    --arg expected_title "$window_title" '
      keys == [
        "alpha", "frame", "is_onscreen", "layer",
        "owner_process_identifier", "schema_version", "title", "window_number"
      ] and
      .schema_version == 1 and
      .window_number == $expected_window_number and
      (.owner_process_identifier | type) == "number" and
      .owner_process_identifier > 0 and
      .layer == $expected_layer and
      .is_onscreen == true and
      (.title == null or .title == $expected_title)' \
    <<<"$snapshot" >/dev/null; then
    echo "Open-panel ready WindowServer snapshot did not match exact ID/title/layer" >&2
    printf '%s\n' "$snapshot" >&2
    return 1
  fi
}

cleanup_native_command_helper() {
  local cleanup_status=0
  local command_line=""

  if [[ -n "$active_native_command_helper_pid" ]] &&
    kill -0 "$active_native_command_helper_pid" 2>/dev/null; then
    command_line="$(
      ps -ww -p "$active_native_command_helper_pid" -o command= 2>/dev/null || true
    )"
    if native_command_helper_process_matches \
      "$active_native_command_helper_pid" \
      "$active_native_command_helper_mode" \
      "$active_native_command_helper_token"; then
      kill -TERM "$active_native_command_helper_pid" 2>/dev/null || true
      for _ in {1..80}; do
        if ! kill -0 "$active_native_command_helper_pid" 2>/dev/null; then
          break
        fi
        sleep 0.025
      done
      if kill -0 "$active_native_command_helper_pid" 2>/dev/null; then
        kill -KILL "$active_native_command_helper_pid" 2>/dev/null || true
        cleanup_status=1
      fi
    else
      echo "refusing to terminate an unverified helper process: $command_line" >&2
      cleanup_status=1
    fi
  fi
  if [[ -n "$active_helper_observer_pid" ]] &&
    [[ "$active_helper_observer_parent_pid" == "$$" ]]; then
    if kill -0 "$active_helper_observer_pid" 2>/dev/null; then
      kill -TERM "$active_helper_observer_pid" 2>/dev/null || true
    fi
    wait "$active_helper_observer_pid" 2>/dev/null || true
  fi
  active_native_command_helper_pid=""
  active_native_command_helper_token=""
  active_native_command_helper_mode=""
  active_helper_observer_pid=""
  active_helper_observer_parent_pid=""
  active_helper_observer_token=""
  return "$cleanup_status"
}

run_windowserver_input_cleanup() {
  local cleanup_pid=""
  local cleanup_process_status=0
  local cleanup_result="missing"
  local cleanup_status=0

  rm -f "$windowserver_input_cleanup_result"
  : >"$windowserver_input_cleanup_log"
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    echo "signed-App input cleanup refused to overlap a live E2E App" \
      >>"$windowserver_input_cleanup_log"
    cleanup_status=1
  else
    /usr/bin/open -W -n \
      -o "$windowserver_input_cleanup_log" \
      --stderr "$windowserver_input_cleanup_log" \
      "$app_path" \
      --args \
      --e2e-windowserver-input-cleanup-result-url \
      "$PWD/$windowserver_input_cleanup_result" \
      >>"$windowserver_input_cleanup_log" 2>&1 &
    cleanup_pid=$!

    for _ in {1..100}; do
      if [[ -f "$windowserver_input_cleanup_result" ]] ||
        ! kill -0 "$cleanup_pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    for _ in {1..40}; do
      if ! kill -0 "$cleanup_pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    if kill -0 "$cleanup_pid" 2>/dev/null; then
      echo "signed-App input cleanup did not terminate" \
        >>"$windowserver_input_cleanup_log"
      kill "$cleanup_pid" 2>/dev/null || true
      cleanup_status=1
    fi
    if wait "$cleanup_pid" 2>/dev/null; then
      cleanup_process_status=0
    else
      cleanup_process_status=$?
      echo "signed-App input cleanup exited ${cleanup_process_status}" \
        >>"$windowserver_input_cleanup_log"
      cleanup_status=1
    fi
  fi

  if [[ -f "$windowserver_input_cleanup_result" ]]; then
    cleanup_result="$(<"$windowserver_input_cleanup_result")"
  fi
  if [[ "$cleanup_result" != "ok" ]]; then
    echo "signed-App input cleanup result: $cleanup_result" \
      >>"$windowserver_input_cleanup_log"
    cleanup_status=1
  fi
  if pgrep -x "$app_executable_name" >/dev/null 2>&1; then
    terminate_e2e_app >/dev/null 2>&1 || true
    cleanup_status=1
  fi

  evidence_append \
    "$evidence_manifest" \
    "windowserver_input_cleanup_result" \
    "$cleanup_result" || cleanup_status=1
  evidence_append \
    "$evidence_manifest" \
    "windowserver_input_cleanup_result_path" \
    "$windowserver_input_cleanup_result" || cleanup_status=1
  evidence_append \
    "$evidence_manifest" \
    "windowserver_input_cleanup_result_sha256" \
    "$([[ -f "$windowserver_input_cleanup_result" ]] && \
      shasum -a 256 "$windowserver_input_cleanup_result" | awk '{print $1}' || \
      printf 'missing')" || cleanup_status=1
  evidence_append \
    "$evidence_manifest" \
    "windowserver_input_cleanup_log_path" \
    "$windowserver_input_cleanup_log" || cleanup_status=1

  return "$cleanup_status"
}

validate_english_scenario_ledger() {
  local actual_count
  local actual_set="none"
  local expected_external_ax_count=0

  if [[ ! -f "$english_scenario_ledger" ]] ||
    [[ "$(head -n 1 "$english_scenario_ledger")" != \
      $'scenario\tapp_binary_sha256\tscreenshot_sha256\toracles\texternal_ax' ]]; then
    echo "English scenario evidence ledger is missing its exact header" >&2
    return 1
  fi
  actual_count="$(awk 'NR > 1 { count += 1 } END { print count + 0 }' \
    "$english_scenario_ledger")"
  if (( actual_count > 0 )); then
    actual_set="$(awk -F $'\t' 'NR > 1 { print $1 }' \
      "$english_scenario_ledger" | paste -sd, -)"
  fi
  if [[ "$actual_count" != "${#english_scenario_names[@]}" ||
    "$actual_set" != "$english_scenario_set" ]]; then
    echo "English scenario evidence is incomplete: expected=$english_scenario_set actual=$actual_set" >&2
    return 1
  fi
  if ! awk -F $'\t' -v expected="$app_binary_sha256_before" '
    NR == 1 { next }
    NF != 5 || $2 != expected || length($3) != 64 || $3 !~ /^[0-9a-f]+$/ { exit 1 }
  ' "$english_scenario_ledger"; then
    echo "English scenario evidence is not bound to one App binary and screenshot set" >&2
    return 1
  fi
  if [[ ",$english_scenario_set," == *",english-day,"* ]]; then
    expected_external_ax_count=1
  fi
  if [[ "$(awk -F $'\t' 'NR > 1 && $5 == "true" { count += 1 } END { print count + 0 }' \
    "$english_scenario_ledger")" != "$expected_external_ax_count" ]] ||
    ! awk -F $'\t' '
      NR == 1 { next }
      $5 == "true" && $1 != "english-day" { exit 1 }
      ($1 == "english-settings" || $1 == "english-zhulong") && $5 != "false" { exit 1 }
    ' "$english_scenario_ledger"; then
    echo "English external AX evidence was attributed to an unobserved scenario" >&2
    return 1
  fi
  if [[ "$suite_mode" == "full" ]] && {
    [[ "$english_scenario_set" != "$english_full_scenario_set" ]] ||
      [[ "$actual_count" != "10" ]];
  }; then
    echo "full E2E did not verify the exact ten-scenario English ledger" >&2
    return 1
  fi

  evidence_append \
    "$evidence_manifest" \
    "english_scenario_verified_count" \
    "$actual_count"
  evidence_append \
    "$evidence_manifest" \
    "english_scenario_verified_set" \
    "$actual_set"
  evidence_append \
    "$evidence_manifest" \
    "english_scenario_ledger_sha256" \
    "$(shasum -a 256 "$english_scenario_ledger" | awk '{print $1}')"
}

finish_e2e_evidence() {
  local suite_status="$1"
  local app_binary_sha256_after=""
  local helper_binary_sha256_after=""
  local window_probe_binary_sha256_after=""
  local inventory_sha256
  local -a artifact_paths=()
  local -a required_keys=(
    scenario_count
    scenario_set
    english_scenario_expected_count
    english_scenario_expected_set
    english_scenario_verified_count
    english_scenario_verified_set
    english_scenario_ledger_sha256
    app_binary_sha256_before
    app_binary_sha256_after
    app_binary_unchanged
    window_probe_binary_sha256_before
    window_probe_binary_sha256_after
    window_probe_binary_unchanged
    artifact_inventory_sha256
    diagnostic_baseline_path
    diagnostic_final_path
    diagnostic_diff_path
    diagnostic_result_path
    windowserver_input_cleanup_result
    windowserver_input_cleanup_result_path
    windowserver_input_cleanup_result_sha256
    windowserver_input_cleanup_log_path
  )

  if ! validate_english_scenario_ledger; then
    suite_status=1
  fi
  if evidence_capture_source \
    "$repo_root" \
    "source_end" \
    "$evidence_source_end"; then
    if ! evidence_append_snapshot "$evidence_manifest" "$evidence_source_end"; then
      suite_status=1
    fi
  else
    suite_status=1
  fi
  if evidence_capture_bundle \
    "$app_path" \
    1 \
    "app_end" \
    "$evidence_app_end"; then
    if ! evidence_append_snapshot "$evidence_manifest" "$evidence_app_end"; then
      suite_status=1
    fi
    app_binary_sha256_after="$(
      evidence_read "$evidence_app_end" "app_end_binary_sha256"
    )"
  else
    suite_status=1
  fi
  rm -rf "$evidence_app_snapshot"
  mkdir -p "$(dirname "$evidence_app_snapshot")"
  if ! ditto "$app_path" "$evidence_app_snapshot"; then
    echo "could not preserve the exact E2E App bundle snapshot" >&2
    suite_status=1
  fi
  if [[ -f "$window_probe_executable_path" &&
    ! -L "$window_probe_executable_path" &&
    -x "$window_probe_executable_path" ]]; then
    window_probe_binary_sha256_after="$(
      shasum -a 256 "$window_probe_executable_path" | awk '{print $1}'
    )"
  fi
  evidence_append \
    "$evidence_manifest" \
    "window_probe_binary_sha256_after" \
    "${window_probe_binary_sha256_after:-missing}" || suite_status=1
  if [[ -n "$window_probe_binary_sha256_after" &&
    "$window_probe_binary_sha256_after" == \
      "$window_probe_binary_sha256_before" ]]; then
    evidence_append \
      "$evidence_manifest" \
      "window_probe_binary_unchanged" \
      "true" || suite_status=1
  else
    evidence_append \
      "$evidence_manifest" \
      "window_probe_binary_unchanged" \
      "false" || true
    suite_status=1
  fi
  rm -f "$evidence_window_probe_snapshot"
  mkdir -p "$(dirname "$evidence_window_probe_snapshot")"
  if ! cp -p "$window_probe_executable_path" \
    "$evidence_window_probe_snapshot"; then
    echo "could not preserve the exact E2E window probe snapshot" >&2
    suite_status=1
  fi
  if [[ "$helper_requested" == "1" ]]; then
    required_keys+=(
      helper_binary_sha256_before
      helper_binary_sha256_after
      helper_binary_unchanged
      helper_diagnostic_baseline_path
      helper_diagnostic_final_path
      helper_diagnostic_diff_path
      helper_diagnostic_result_path
    )
    if evidence_capture_bundle \
      "$helper_bundle" \
      1 \
      "helper_end" \
      "$evidence_helper_end"; then
      if ! evidence_append_snapshot \
        "$evidence_manifest" \
        "$evidence_helper_end"; then
        suite_status=1
      fi
      helper_binary_sha256_after="$(
        evidence_read "$evidence_helper_end" "helper_end_binary_sha256"
      )"
    else
      suite_status=1
    fi
    rm -rf "$evidence_helper_snapshot"
    mkdir -p "$(dirname "$evidence_helper_snapshot")"
    if ! ditto "$helper_bundle" "$evidence_helper_snapshot"; then
      echo "could not preserve the exact E2E helper bundle snapshot" >&2
      suite_status=1
    fi
    evidence_append \
      "$evidence_manifest" \
      "helper_binary_sha256_after" \
      "${helper_binary_sha256_after:-missing}" || suite_status=1
    if [[ -n "$helper_binary_sha256_after" ]] &&
      evidence_require_bundle_snapshots_equal \
        "$evidence_helper_start" \
        helper \
        "$evidence_helper_end" \
        helper_end \
        "E2E helper"; then
      evidence_append \
        "$evidence_manifest" \
        "helper_binary_unchanged" \
        "true" || suite_status=1
    else
      evidence_append \
        "$evidence_manifest" \
        "helper_binary_unchanged" \
        "false" || true
      suite_status=1
    fi
    evidence_append \
      "$evidence_manifest" \
      "helper_diagnostic_baseline_path" \
      "$helper_diagnostic_baseline" || suite_status=1
    evidence_append \
      "$evidence_manifest" \
      "helper_diagnostic_final_path" \
      "${helper_diagnostic_baseline}.current" || suite_status=1
    evidence_append \
      "$evidence_manifest" \
      "helper_diagnostic_diff_path" \
      "${helper_diagnostic_baseline}.new" || suite_status=1
    evidence_append \
      "$evidence_manifest" \
      "helper_diagnostic_result_path" \
      "$helper_diagnostic_result" || suite_status=1
  fi
  if ! evidence_append \
    "$evidence_manifest" \
    "app_binary_sha256_after" \
    "${app_binary_sha256_after:-missing}"; then
    suite_status=1
  fi
  if [[ -n "$app_binary_sha256_after" ]] &&
    evidence_require_bundle_snapshots_equal \
      "$evidence_app_start" \
      app \
      "$evidence_app_end" \
      app_end \
      "E2E App"; then
    if ! evidence_append "$evidence_manifest" "app_binary_unchanged" "true"; then
      suite_status=1
    fi
  else
    evidence_append "$evidence_manifest" "app_binary_unchanged" "false" || true
    echo "E2E App binary changed during the suite" >&2
    suite_status=1
  fi
  evidence_append \
    "$evidence_manifest" \
    "diagnostic_baseline_path" \
    "$runtime_diagnostic_baseline" || suite_status=1
  evidence_append \
    "$evidence_manifest" \
    "diagnostic_final_path" \
    "${runtime_diagnostic_baseline}.current" || suite_status=1
  evidence_append \
    "$evidence_manifest" \
    "diagnostic_diff_path" \
    "${runtime_diagnostic_baseline}.new" || suite_status=1
  evidence_append \
    "$evidence_manifest" \
    "diagnostic_result_path" \
    "$runtime_diagnostic_result" || suite_status=1

  for artifact_path in "${e2e_owned_artifact_roots[@]}"; do
    if [[ "$artifact_path" != "$runtime_evidence_dir" ]]; then
      artifact_paths+=("$artifact_path")
    fi
  done
  artifact_paths+=(
    "$runtime_console_log"
    "$runtime_manifest"
    "$runtime_diagnostic_baseline"
    "${runtime_diagnostic_baseline}.current"
    "${runtime_diagnostic_baseline}.new"
    "$runtime_diagnostic_result"
    "$windowserver_input_cleanup_result"
    "$windowserver_input_cleanup_log"
    "$english_scenario_ledger"
    "$evidence_source_start"
    "$evidence_source_end"
    "$evidence_app_start"
    "$evidence_app_end"
    "$evidence_app_snapshot"
    "$evidence_window_probe_snapshot"
  )
  if [[ -d "${runtime_evidence_dir}/DiagnosticReports" ]]; then
    artifact_paths+=("${runtime_evidence_dir}/DiagnosticReports")
  fi
  if [[ "$helper_requested" == "1" ]]; then
    artifact_paths+=(
      "$evidence_helper_snapshot"
      "$helper_diagnostic_baseline"
      "${helper_diagnostic_baseline}.current"
      "${helper_diagnostic_baseline}.new"
      "$helper_diagnostic_result"
      "${runtime_evidence_dir}/HelperDiagnosticReports"
      "$evidence_helper_start"
      "$evidence_helper_end"
    )
  fi
  if evidence_inventory \
    "$repo_root" \
    "$evidence_inventory_path" \
    "${artifact_paths[@]}"; then
    inventory_sha256="$(
      shasum -a 256 "$evidence_inventory_path" | awk '{print $1}'
    )"
    if ! evidence_append \
      "$evidence_manifest" \
      "artifact_inventory_sha256" \
      "$inventory_sha256"; then
      suite_status=1
    fi
  else
    suite_status=1
  fi

  if ! evidence_finish_manifest \
    "$evidence_manifest" \
    "$suite_status" \
    "${required_keys[@]}"; then
    suite_status=1
  fi
  return "$suite_status"
}

finish_e2e_session() {
  local suite_status="${1:-0}"
  local diagnostic_wait_attempts=30

  trap - EXIT
  close_ui_entry_start_gate >/dev/null 2>&1 || suite_status=1
  if ! cleanup_native_command_helper; then
    suite_status=1
  fi
  if ! terminate_e2e_app >/dev/null 2>&1; then
    suite_status=1
  fi
  if declare -F clear_automatic_classification_e2e_credentials \
    >/dev/null 2>&1; then
    if ! clear_automatic_classification_e2e_credentials; then
      suite_status=1
    fi
  fi
  if ! run_windowserver_input_cleanup; then
    suite_status=1
  fi
  rm -rf "/private/tmp/noonmark-e2e-preferences-clock-sync-$$"
  if kill -0 "$display_assertion_pid" >/dev/null 2>&1; then
    kill "$display_assertion_pid" >/dev/null 2>&1 || true
    wait "$display_assertion_pid" 2>/dev/null || true
  fi
  if [[ "$runtime_evidence_started" == "1" ]]; then
    if ! runtime_evidence_stop_console_capture; then
      suite_status=1
    fi
    if ! runtime_evidence_assert_clean_logs \
      "E2E runtime evidence" \
      "$runtime_console_log"; then
      suite_status=1
    fi
    if [[ "$suite_status" -ne 0 ]]; then
      diagnostic_wait_attempts=150
    fi
    if runtime_evidence_assert_no_new_diagnostics \
      "$app_executable_name" \
      "$runtime_diagnostic_baseline" \
      "${runtime_evidence_dir}/DiagnosticReports" \
      "$diagnostic_wait_attempts"; then
      printf 'new_diagnostic_count=0\n' >"$runtime_diagnostic_result"
      mkdir -p "${runtime_evidence_dir}/DiagnosticReports"
      printf 'new_diagnostic_count=0\n' \
        >"${runtime_evidence_dir}/DiagnosticReports/result.txt"
    else
      printf 'new_diagnostic_count=nonzero\n' >"$runtime_diagnostic_result"
      suite_status=1
    fi
    if [[ "$helper_requested" == "1" ]]; then
      if runtime_evidence_assert_no_new_diagnostics \
        "$helper_process_name" \
        "$helper_diagnostic_baseline" \
        "${runtime_evidence_dir}/HelperDiagnosticReports" \
        "$diagnostic_wait_attempts"; then
        printf 'new_diagnostic_count=0\n' >"$helper_diagnostic_result"
        mkdir -p "${runtime_evidence_dir}/HelperDiagnosticReports"
        printf 'new_diagnostic_count=0\n' \
          >"${runtime_evidence_dir}/HelperDiagnosticReports/result.txt"
      else
        printf 'new_diagnostic_count=nonzero\n' >"$helper_diagnostic_result"
        suite_status=1
      fi
    fi
    if ! runtime_evidence_write_manifest_finish \
      "$runtime_manifest" \
      "$suite_status"; then
      suite_status=1
    fi
  fi
  if ! finish_e2e_evidence "$suite_status"; then
    suite_status=1
  fi
  exit "$suite_status"
}

terminate_e2e_app
trap 'finish_e2e_session "$?"' EXIT
mkdir -p "$runtime_evidence_dir"
runtime_evidence_snapshot_diagnostics \
  "$app_executable_name" \
  "$runtime_diagnostic_baseline"
if [[ "$helper_requested" == "1" ]]; then
  runtime_evidence_snapshot_diagnostics \
    "$helper_process_name" \
    "$helper_diagnostic_baseline"
fi
runtime_evidence_write_manifest_start \
  "$runtime_manifest" \
  "$app_executable_name" \
  "$app_path"
if [[ "$helper_requested" == "1" ]]; then
  runtime_evidence_start_console_capture \
    "$app_executable_name" \
    "$runtime_console_log" \
    "$helper_process_name"
else
  runtime_evidence_start_console_capture \
    "$app_executable_name" \
    "$runtime_console_log"
fi
runtime_evidence_started=1

resolve_exact_e2e_window_id() {
  local identity_path="$1"
  local launch_token="$2"
  local expected_process_id="$3"
  local expected_ready_title="$4"
  local expected_width="${5:-$expected_window_width}"
  local expected_height="${6:-$expected_window_height}"
  local identity_window_number
  local snapshot

  if ! identity_window_number="$(
    NOONMARK_E2E_WINDOW_IDENTITY_PATH="$identity_path" \
    NOONMARK_E2E_WINDOW_LAUNCH_TOKEN="$launch_token" \
    NOONMARK_E2E_EXPECTED_PROCESS_ID="$expected_process_id" \
    NOONMARK_E2E_EXPECTED_APP_PATH="$PWD/$app_path" swift -e '
import AppKit
import Darwin
import Foundation

struct Identity: Codable {
    let schemaVersion: Int
    let profile: String
    let launchToken: String
    let processIdentifier: Int
    let bundleIdentifier: String
    let windowNumber: Int
    let title: String

    enum CodingKeys: String, CodingKey {
        case schemaVersion = "schema_version"
        case profile
        case launchToken = "launch_token"
        case processIdentifier = "process_identifier"
        case bundleIdentifier = "bundle_identifier"
        case windowNumber = "window_number"
        case title
    }
}

func sameSnapshot(_ lhs: stat, _ rhs: stat) -> Bool {
    lhs.st_dev == rhs.st_dev
        && lhs.st_ino == rhs.st_ino
        && lhs.st_size == rhs.st_size
        && lhs.st_mtimespec.tv_sec == rhs.st_mtimespec.tv_sec
        && lhs.st_mtimespec.tv_nsec == rhs.st_mtimespec.tv_nsec
        && lhs.st_ctimespec.tv_sec == rhs.st_ctimespec.tv_sec
        && lhs.st_ctimespec.tv_nsec == rhs.st_ctimespec.tv_nsec
}

func openDirectoryWithoutFollowingLinks(_ path: String) -> Int32? {
    guard path.hasPrefix("/") else { return nil }
    var descriptor = Darwin.open(
        "/",
        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
    )
    guard descriptor >= 0 else { return nil }
    for component in path.split(separator: "/") {
        let nextDescriptor = openat(
            descriptor,
            String(component),
            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
        )
        _ = Darwin.close(descriptor)
        guard nextDescriptor >= 0 else { return nil }
        descriptor = nextDescriptor
    }
    return descriptor
}

let environment = ProcessInfo.processInfo.environment
guard let identityPath = environment["NOONMARK_E2E_WINDOW_IDENTITY_PATH"],
      identityPath.hasPrefix("/"),
      let launchToken = environment["NOONMARK_E2E_WINDOW_LAUNCH_TOKEN"],
      UUID(uuidString: launchToken)?.uuidString == launchToken,
      let rawProcessID = environment["NOONMARK_E2E_EXPECTED_PROCESS_ID"],
      let expectedProcessID = Int32(rawProcessID), expectedProcessID > 0,
      let expectedAppPath = environment["NOONMARK_E2E_EXPECTED_APP_PATH"]
else { exit(2) }
let identityURL = URL(fileURLWithPath: identityPath)
guard identityURL.lastPathComponent == "main-window-identity.json" else { exit(2) }
guard let directoryDescriptor = openDirectoryWithoutFollowingLinks(
    identityURL.deletingLastPathComponent().path
) else { exit(1) }
defer { _ = Darwin.close(directoryDescriptor) }
var directoryStatus = stat()
guard fstat(directoryDescriptor, &directoryStatus) == 0,
      directoryStatus.st_mode & mode_t(S_IFMT) == mode_t(S_IFDIR),
      directoryStatus.st_uid == geteuid(),
      directoryStatus.st_mode & mode_t(0o777) == mode_t(0o700)
else { exit(1) }

var pathStatus = stat()
guard fstatat(
    directoryDescriptor,
    "main-window-identity.json",
    &pathStatus,
    AT_SYMLINK_NOFOLLOW
) == 0,
    pathStatus.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
    pathStatus.st_uid == geteuid(),
    pathStatus.st_nlink == 1,
    pathStatus.st_mode & mode_t(0o777) == mode_t(0o600),
    pathStatus.st_size > 0,
    pathStatus.st_size <= 4096
else { exit(1) }
let descriptor = openat(
    directoryDescriptor,
    "main-window-identity.json",
    O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC
)
guard descriptor >= 0 else { exit(1) }
defer { _ = Darwin.close(descriptor) }
var openedStatus = stat()
guard fstat(descriptor, &openedStatus) == 0,
      sameSnapshot(pathStatus, openedStatus)
else { exit(1) }
var data = Data()
var buffer = [UInt8](repeating: 0, count: 4097)
while data.count <= 4096 {
    let remaining = 4097 - data.count
    let count = buffer.withUnsafeMutableBytes {
        Darwin.read(descriptor, $0.baseAddress, min($0.count, remaining))
    }
    if count > 0 {
        data.append(contentsOf: buffer.prefix(count))
        continue
    }
    if count == 0 { break }
    if errno == EINTR { continue }
    exit(1)
}
var finalStatus = stat()
var finalPathStatus = stat()
guard data.count <= 4096,
      fstat(descriptor, &finalStatus) == 0,
      fstatat(
          directoryDescriptor,
          "main-window-identity.json",
          &finalPathStatus,
          AT_SYMLINK_NOFOLLOW
      ) == 0,
      sameSnapshot(openedStatus, finalStatus),
      sameSnapshot(openedStatus, finalPathStatus),
      finalStatus.st_size == data.count,
      let rawObject = try? JSONSerialization.jsonObject(with: data),
      let object = rawObject as? [String: Any],
      Set(object.keys) == Set([
          "schema_version", "profile", "launch_token",
          "process_identifier", "bundle_identifier", "window_number", "title"
      ]),
      let identity = try? JSONDecoder().decode(Identity.self, from: data)
else { exit(1) }
let encoder = JSONEncoder()
encoder.outputFormatting = [.sortedKeys]
guard let canonicalData = try? encoder.encode(identity),
      canonicalData == data,
      identity.schemaVersion == 1,
      identity.profile == "e2e",
      identity.launchToken == launchToken,
      identity.processIdentifier == Int(expectedProcessID),
      identity.bundleIdentifier == "app.noonmark.mac.e2e",
      identity.windowNumber > 0,
      identity.title.isEmpty == false,
      identity.title.utf8.count <= 512,
      identity.title.unicodeScalars.allSatisfy({
          CharacterSet.controlCharacters.contains($0) == false
      }),
      let runningApp = NSRunningApplication(processIdentifier: expectedProcessID),
      runningApp.isTerminated == false,
      runningApp.isActive,
      runningApp.bundleIdentifier == identity.bundleIdentifier,
      let bundleURL = runningApp.bundleURL
else { exit(1) }
let actualAppPath = bundleURL.standardizedFileURL.resolvingSymlinksInPath().path
let normalizedExpectedAppPath = URL(fileURLWithPath: expectedAppPath)
    .standardizedFileURL.resolvingSymlinksInPath().path
guard actualAppPath == normalizedExpectedAppPath else { exit(1) }
print(identity.windowNumber)
'
  )"; then
    return 1
  fi
  if ! snapshot="$(
    "$window_probe_executable_path" \
      --window-number "$identity_window_number" 2>/dev/null
  )"; then
    return 1
  fi
  if ! jq -e \
    --argjson expected_window_number "$identity_window_number" \
    --argjson expected_pid "$expected_process_id" \
    --arg expected_title "$expected_ready_title" \
    --argjson expected_width "$expected_width" \
    --argjson expected_height "$expected_height" \
    'keys == [
      "alpha", "frame", "is_onscreen", "layer",
      "owner_process_identifier", "schema_version", "title", "window_number"
    ] and
    .schema_version == 1 and
    .window_number == $expected_window_number and
    .owner_process_identifier == $expected_pid and
    .layer == 0 and
    .is_onscreen == true and
    (.title == null or .title == $expected_title) and
    (.frame != null) and
    (($expected_width <= 0 or $expected_height <= 0) or
      (.frame.width == $expected_width and
       .frame.height == $expected_height))' \
    <<<"$snapshot" >/dev/null; then
    return 1
  fi
  printf '%s\n' "$identity_window_number"
}

exact_auxiliary_window_matches() {
  local main_window_id="$1"
  local auxiliary_window_id="$2"
  local expected_process_id="$3"
  local main_snapshot
  local auxiliary_snapshot
  if ! NOONMARK_E2E_MAIN_WINDOW_ID="$main_window_id" \
    NOONMARK_E2E_AUXILIARY_WINDOW_ID="$auxiliary_window_id" \
    NOONMARK_E2E_EXPECTED_PROCESS_ID="$expected_process_id" swift -e '
import AppKit
import Darwin
import Foundation

let environment = ProcessInfo.processInfo.environment
guard let mainID = UInt32(environment["NOONMARK_E2E_MAIN_WINDOW_ID"] ?? ""), mainID > 0,
      let auxiliaryID = UInt32(environment["NOONMARK_E2E_AUXILIARY_WINDOW_ID"] ?? ""),
      auxiliaryID > 0, auxiliaryID != mainID,
      let processID = Int32(environment["NOONMARK_E2E_EXPECTED_PROCESS_ID"] ?? ""),
      processID > 0,
      let app = NSRunningApplication(processIdentifier: processID),
      app.isTerminated == false,
      app.bundleIdentifier == "app.noonmark.mac.e2e"
else { exit(2) }
'
  then
    return 1
  fi
  if ! main_snapshot="$(
    "$window_probe_executable_path" --window-number "$main_window_id" 2>/dev/null
  )" || ! auxiliary_snapshot="$(
    "$window_probe_executable_path" \
      --window-number "$auxiliary_window_id" 2>/dev/null
  )"; then
    return 1
  fi
  printf '%s\n%s\n' "$main_snapshot" "$auxiliary_snapshot" | jq -s -e \
    --argjson main_window_id "$main_window_id" \
    --argjson auxiliary_window_id "$auxiliary_window_id" \
    --argjson expected_pid "$expected_process_id" \
    'length == 2 and
    .[0].window_number == $main_window_id and
    .[1].window_number == $auxiliary_window_id and
    (.[0].owner_process_identifier == $expected_pid) and
    (.[1].owner_process_identifier == $expected_pid) and
    (.[0].layer == 0 and .[1].layer == 0) and
    (.[0].is_onscreen == true and .[1].is_onscreen == true) and
    (.[0].frame != null and .[1].frame != null) and
    (.[1].frame.width >= 40 and .[1].frame.height >= 40) and
    (.[1].frame.width < .[0].frame.width) and
    (.[1].frame.height < .[0].frame.height) and
    (.[1].frame.x < (.[0].frame.x + .[0].frame.width)) and
    ((.[1].frame.x + .[1].frame.width) > .[0].frame.x) and
    (.[1].frame.y < (.[0].frame.y + .[0].frame.height)) and
    ((.[1].frame.y + .[1].frame.height) > .[0].frame.y)' \
    >/dev/null
}

dump_exact_e2e_window_evidence() {
  local identity_path="$1"
  local launch_token="$2"
  local process_id="$3"
  local title="$4"
  local width="$5"
  local height="$6"
  local resolved_id=""
  if resolved_id="$(
    resolve_exact_e2e_window_id \
      "$identity_path" "$launch_token" "$process_id" "$title" "$width" "$height"
  )"; then
    printf 'exact E2E window id=%s pid=%s title=%s\n' \
      "$resolved_id" "$process_id" "$title"
  elif [[ -f "$identity_path" ]]; then
    printf 'exact E2E window identity present but invalid: %s pid=%s\n' \
      "$identity_path" "$process_id"
  else
    printf 'exact E2E window identity missing: %s pid=%s\n' \
      "$identity_path" "$process_id"
  fi
}

close_ui_entry_start_gate() {
  local gate_path="$active_ui_entry_start_gate"

  if [[ "$ui_entry_start_gate_fd_open" == "1" ]]; then
    exec 8>&-
    ui_entry_start_gate_fd_open=0
  fi
  if [[ -n "$gate_path" ]]; then
    if [[ "$gate_path" != "$repo_root/artifacts/e2e/"*.fifo ]]; then
      echo "refusing to remove an unexpected UI-entry start gate: $gate_path" >&2
      return 1
    fi
    rm -f -- "$gate_path"
  fi
  active_ui_entry_start_gate=""
  active_ui_entry_start_gate_token=""
}

prepare_ui_entry_start_gate() {
  local ui_entry_start_gate="$1"
  local token="$2"

  close_ui_entry_start_gate
  if [[ "$ui_entry_start_gate" != "$repo_root/artifacts/e2e/"*.fifo ||
    ! "$token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    echo "invalid UI-entry start gate identity" >&2
    return 1
  fi
  rm -f -- "$ui_entry_start_gate"
  mkfifo -m 600 "$ui_entry_start_gate"
  exec 8<>"$ui_entry_start_gate"
  ui_entry_start_gate_fd_open=1
  active_ui_entry_start_gate="$ui_entry_start_gate"
  active_ui_entry_start_gate_token="$token"
}

arm_ui_entry_start_gate() {
  local result_path="$1"
  local token="$2"
  local process_id="$3"
  local main_window_id="$4"
  local waiting_state=""

  if [[ "$ui_entry_start_gate_fd_open" != "1" ||
    "$active_ui_entry_start_gate_token" != "$token" ||
    ! "$process_id" =~ ^[1-9][0-9]*$ ||
    ! "$main_window_id" =~ ^[1-9][0-9]*$ ]]; then
    echo "UI-entry start gate cannot be armed with a stale identity" >&2
    return 1
  fi
  for _ in {1..120}; do
    if [[ -f "$result_path" ]]; then
      waiting_state="$(<"$result_path")"
      if [[ "$waiting_state" == "waiting|$token|$process_id" ]]; then
        break
      fi
      if [[ "$waiting_state" == failed:* ]]; then
        break
      fi
    fi
    sleep 0.025
  done
  if [[ "$waiting_state" != "waiting|$token|$process_id" ]]; then
    echo "UI-entry start gate did not bind its exact waiting App identity: ${waiting_state:-missing}" >&2
    return 1
  fi
  printf 'arm|%s|%s|%s\n' "$token" "$process_id" "$main_window_id" >&8
  printf 'armed|%s|%s|%s\n' \
    "$token" "$process_id" "$main_window_id" \
    >"${result_path}.start-gate.txt"
}

capture_classification_overflow_handshake() {
  local main_window_id="$1"
  local process_id="$2"
  local result_path="$3"
  local screenshot="$4"
  local expected_recovery_count="$5"
  local acknowledgement_path="${result_path}.ack"
  local warmup_screenshot="${screenshot}.warmup.png"
  local result_value=""
  local status=""
  local generation=""
  local ready_process_id=""
  local ready_main_window_id=""
  local ready_presentation_window_id=""
  local ready_recovery_count=""
  local extra_field=""
  local acknowledgement_state=""

  for _ in {1..200}; do
    if [[ -f "$result_path" ]]; then
      result_value="$(<"$result_path")"
      if [[ "$result_value" == failed:* ]]; then
        echo "classification overflow capture handshake failed: $result_value" >&2
        return 1
      fi
      IFS="|" read -r status generation ready_process_id ready_main_window_id \
        ready_presentation_window_id ready_recovery_count extra_field <<<"$result_value"
      if [[ "$status" == "ready" && -n "$generation" && -z "$extra_field" &&
        "$ready_process_id" == "$process_id" &&
        "$ready_main_window_id" == "$main_window_id" &&
        "$ready_presentation_window_id" =~ ^[0-9]+$ &&
        "$ready_recovery_count" =~ ^[0-9]+$ ]] &&
        ((ready_recovery_count >= expected_recovery_count)); then
        if exact_auxiliary_window_matches \
          "$main_window_id" \
          "$ready_presentation_window_id" \
          "$process_id" 2>/dev/null; then
          screencapture -x -o -l"$main_window_id" "$warmup_screenshot"
          sleep 0.25
          if [[ -f "$result_path" && "$(<"$result_path")" == "$result_value" ]] &&
            exact_auxiliary_window_matches \
              "$main_window_id" \
              "$ready_presentation_window_id" \
              "$process_id" 2>/dev/null; then
            screencapture -x -o -l"$main_window_id" "$screenshot"
            if [[ -f "$result_path" && "$(<"$result_path")" == "$result_value" ]] &&
              exact_auxiliary_window_matches \
                "$main_window_id" \
                "$ready_presentation_window_id" \
                "$process_id" 2>/dev/null; then
              printf '%s\n' "$generation" >"$acknowledgement_path"
              for _ in {1..80}; do
                acknowledgement_state=""
                if [[ -f "$result_path" ]]; then
                  acknowledgement_state="$(<"$result_path")"
                fi
                if [[ "$acknowledgement_state" == \
                  "ok|$generation|$ready_recovery_count" ]]; then
                  rm -f "$warmup_screenshot"
                  echo "E2E classification overflow capture handshake: generation=$generation recovery=$ready_recovery_count"
                  return 0
                fi
                if [[ "$acknowledgement_state" == failed:* ]]; then
                  echo "classification overflow capture acknowledgement failed: $acknowledgement_state" >&2
                  return 1
                fi
                if [[ -n "$acknowledgement_state" &&
                  "$acknowledgement_state" != "$result_value" ]]; then
                  break
                fi
                sleep 0.05
              done
            fi
          fi
          rm -f "$warmup_screenshot" "$screenshot"
        fi
      fi
    fi
    sleep 0.05
  done

  echo "classification overflow capture-ready handshake timed out" >&2
  if [[ -f "$result_path" ]]; then
    echo "last handshake state: $(<"$result_path")" >&2
  fi
  return 1
}

capture_app_screenshot() {
  local out_dir="$1"
  local screenshot_name="$2"
  local page="$3"
  local app_pid
  local launch_log
  local launcher_pid
  local expected_window_title
  local expected_frame_width="$expected_window_width"
  local expected_frame_height="$expected_window_height"
  local expected_language="${NOONMARK_E2E_EXPECTED_LANGUAGE:-chinese}"
  local ui_entry_result=""
  local uses_ui_entry_start_gate=0
  local ui_entry_start_gate=""
  local ui_entry_start_gate_token=""
  local english_ui_result=""
  local zhulong_title_geometry_result=""
  local expected_overflow_recovery_count=0
  local window_identity_directory=""
  local window_identity_path=""
  local window_identity_token=""
  local launch_arguments=()
  shift 3

  local arguments=("$@")
  for ((index = 0; index < ${#arguments[@]}; index++)); do
    if [[ "${arguments[$index]}" == "--e2e-window-size" ]]; then
      requested_window_size="${arguments[$((index + 1))]:-}"
      if [[ "$requested_window_size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        expected_frame_width="${BASH_REMATCH[1]}"
        expected_frame_height="${BASH_REMATCH[2]}"
      else
        echo "invalid E2E window size: ${requested_window_size:-missing}" >&2
        exit 1
      fi
    fi
    if [[ "${arguments[$index]}" == "--e2e-classification-manager-ui-result-url" ||
      "${arguments[$index]}" == "--e2e-classification-overflow-ui-result-url" ||
      "${arguments[$index]}" == "--e2e-selection-focus-result-url" ]]; then
      ui_entry_result="${arguments[$((index + 1))]:-}"
    fi
    if [[ "${arguments[$index]}" == "--e2e-english-ui-result-url" ]]; then
      english_ui_result="${arguments[$((index + 1))]:-}"
    fi
    if [[ "${arguments[$index]}" == "--e2e-zhulong-title-geometry-result-url" ]]; then
      zhulong_title_geometry_result="${arguments[$((index + 1))]:-}"
    fi
    if [[ "${arguments[$index]}" == "--e2e-classification-overflow-invalidate-first-ready" ]]; then
      expected_overflow_recovery_count=1
    fi
    if [[ "${arguments[$index]}" == "--e2e-classification-overflow-via-ui" ]]; then
      uses_ui_entry_start_gate=1
    fi
  done
  if [[ -n "$ui_entry_result" ]]; then
    rm -f "$ui_entry_result" "${ui_entry_result}.ack"
  fi
  if [[ -n "$english_ui_result" ]]; then
    rm -f "$english_ui_result"
  fi
  if [[ -n "$zhulong_title_geometry_result" ]]; then
    rm -f "$zhulong_title_geometry_result"
  fi
  if [[ "$page" == "settings" ]]; then
    expected_frame_width=0
    expected_frame_height=0
  fi

  launch_log="${out_dir}/${screenshot_name}.log"

  if [[ "$expected_language" == "english" ]]; then
    case "$page" in
      day)
        if [[ "$screenshot_name" == "english-day-history-header" ]]; then
          expected_window_title="Noonmark · Day Todo — 30 Sep"
        else
          expected_window_title="Noonmark · Day Todo — 5 Jul"
        fi
        ;;
      pool) expected_window_title="Noonmark · Task Pool" ;;
      future) expected_window_title="Noonmark · Upcoming" ;;
      unfinished) expected_window_title="Noonmark · Unfinished" ;;
      completed) expected_window_title="Noonmark · Completed" ;;
      calendar) expected_window_title="Noonmark · Calendar — 5 Jul" ;;
      zhulong) expected_window_title="Noonmark · Zhulong" ;;
      settings) expected_window_title="Settings" ;;
      *) expected_window_title="Noonmark" ;;
    esac
  else
    case "$page" in
      day)
        if [[ "$screenshot_name" == "day-changed-target" ]]; then
          expected_window_title="晷迹 · Day Todo — 7月4日"
        else
          expected_window_title="晷迹 · Day Todo — 7月5日"
        fi
        ;;
      pool) expected_window_title="晷迹 · 任务池" ;;
      future) expected_window_title="晷迹 · 未来计划" ;;
      unfinished) expected_window_title="晷迹 · 未完成" ;;
      completed) expected_window_title="晷迹 · 已完成" ;;
      calendar) expected_window_title="晷迹 · 日历 — 7月5日" ;;
      zhulong) expected_window_title="晷迹 · 烛龙" ;;
      settings) expected_window_title="设置" ;;
      *) expected_window_title="晷迹 · Noonmark" ;;
    esac
  fi

  window_id=""
  mkdir -p "$out_dir"
  : >"$launch_log"
  for launch_attempt in {1..3}; do
    terminate_e2e_app
    window_id=""
    launch_arguments=("${arguments[@]}")
    window_identity_token="$(uuidgen)"
    if [[ ! "$window_identity_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
      echo "could not create one canonical E2E window identity token" >&2
      exit 1
    fi
    window_identity_directory="${out_dir}/.main-window-identity-${screenshot_name}-${launch_attempt}-${window_identity_token}"
    window_identity_path="${window_identity_directory}/main-window-identity.json"
    mkdir -m 700 -- "$window_identity_directory"
    launch_arguments+=(
      --e2e-main-window-identity-url "$PWD/$window_identity_path"
      --e2e-main-window-launch-token "$window_identity_token"
    )
    if [[ "$uses_ui_entry_start_gate" == "1" ]]; then
      ui_entry_start_gate="${ui_entry_result}.start-gate.${launch_attempt}.fifo"
      ui_entry_start_gate_token="$(uuidgen)"
      prepare_ui_entry_start_gate \
        "$ui_entry_start_gate" \
        "$ui_entry_start_gate_token"
      launch_arguments+=(
        --e2e-ui-entry-start-gate-url "$ui_entry_start_gate"
        --e2e-ui-entry-start-gate-token "$ui_entry_start_gate_token"
      )
    fi
    echo "launch attempt=$launch_attempt page=$page expected_title=$expected_window_title" >>"$launch_log"
    if [[ -n "$ui_entry_result" ]]; then
      /usr/bin/open -W -n \
        -o "$launch_log" \
        --stderr "$launch_log" \
        "$app_path" \
        --args "${launch_arguments[@]}" --page "$page" \
        >"${launch_log}.open" 2>&1 &
      launcher_pid=$!
      app_pid=""
      for _ in {1..50}; do
        app_pid="$(pgrep -x "$app_executable_name" | head -1 || true)"
        if [[ -n "$app_pid" ]] || ! kill -0 "$launcher_pid" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
    else
      "$app_executable_path" "${launch_arguments[@]}" --page "$page" >>"$launch_log" 2>&1 &
      launcher_pid=$!
      app_pid=$launcher_pid
    fi
    if [[ -z "$app_pid" ]]; then
      echo "launch attempt=$launch_attempt app_process=missing" >>"$launch_log"
      wait "$launcher_pid" 2>/dev/null || true
      cat "${launch_log}.open" >>"$launch_log" 2>/dev/null || true
      close_ui_entry_start_gate
      continue
    fi
    if [[ -z "$ui_entry_result" ]]; then
      sleep "${NOONMARK_E2E_STARTUP_WAIT:-3}"
    fi

    for _ in {1..20}; do
      if window_id="$(
        resolve_exact_e2e_window_id \
          "$PWD/$window_identity_path" \
          "$window_identity_token" \
          "$app_pid" \
          "$expected_window_title" \
          "$expected_frame_width" \
          "$expected_frame_height" 2>/dev/null
      )"; then
        break
      fi
      sleep 0.25
    done

    if [[ -n "$window_id" ]]; then
      if [[ "$uses_ui_entry_start_gate" == "1" ]] &&
        ! arm_ui_entry_start_gate \
          "$ui_entry_result" \
          "$ui_entry_start_gate_token" \
          "$app_pid" \
          "$window_id"; then
        echo "failed to arm UI-entry start gate for ${screenshot_name}" >&2
        exit 1
      fi
      disown "$launcher_pid" 2>/dev/null || true
      break
    fi
    if kill -0 "$app_pid" >/dev/null 2>&1; then
      echo "launch attempt=$launch_attempt pid=$app_pid state=running window_match=missing" >>"$launch_log"
    else
      app_exit_code=0
      wait "$launcher_pid" || app_exit_code=$?
      echo "launch attempt=$launch_attempt pid=$app_pid state=exited exit_code=$app_exit_code window_match=missing" >>"$launch_log"
    fi
    dump_exact_e2e_window_evidence \
      "$PWD/$window_identity_path" \
      "$window_identity_token" \
      "$app_pid" \
      "$expected_window_title" \
      "$expected_frame_width" \
      "$expected_frame_height" >>"$launch_log"
    terminate_e2e_app
    close_ui_entry_start_gate
    sleep 0.5
  done

  if [[ -z "$window_id" ]]; then
    echo "Noonmark app window not found for ${page}" >&2
    cat "$launch_log" >&2
    exit 1
  fi

  if [[ -n "$ui_entry_result" && "$screenshot_name" != "pool-classification-overflow" ]]; then
    for _ in {1..80}; do
      if [[ -f "$ui_entry_result" ]]; then
        break
      fi
      sleep 0.1
    done
    if [[ ! -f "$ui_entry_result" ]]; then
      echo "UI entry result was not created: $ui_entry_result" >&2
      exit 1
    fi
    if [[ "$(<"$ui_entry_result")" != "ok" ]]; then
      echo "UI entry failed: $(<"$ui_entry_result")" >&2
      exit 1
    fi
  fi
  if [[ -n "$english_ui_result" ]]; then
    for _ in {1..80}; do
      if [[ -f "$english_ui_result" ]]; then
        break
      fi
      sleep 0.1
    done
    if [[ ! -f "$english_ui_result" ]]; then
      echo "English populated UI result was not created: $english_ui_result" >&2
      exit 1
    fi
    if [[ "$(head -n 1 "$english_ui_result")" != "ok" ]]; then
      echo "English populated UI verification failed: $(<"$english_ui_result")" >&2
      exit 1
    fi
    if [[ "$screenshot_name" == "english-day" ]]; then
      scripts/run-e2e-ax-inspect \
        "$app_pid" \
        "$PWD/$app_path" \
        "$window_id" \
        "$expected_window_title" \
        "$english_ui_result" \
        "$PWD/artifacts/e2e-english/day-ax"
    fi
  fi
  if [[ -n "$zhulong_title_geometry_result" ]]; then
    for _ in {1..80}; do
      if [[ -f "$zhulong_title_geometry_result" ]]; then
        break
      fi
      sleep 0.1
    done
    if [[ ! -f "$zhulong_title_geometry_result" ]]; then
      echo "Zhulong title geometry result was not created: $zhulong_title_geometry_result" >&2
      exit 1
    fi
    if [[ "$(head -n 1 "$zhulong_title_geometry_result")" != "ok" ]]; then
      echo "Zhulong title geometry verification failed:" >&2
      cat "$zhulong_title_geometry_result" >&2
      exit 1
    fi
  fi

  mkdir -p "$out_dir"
  screenshot="${out_dir}/${screenshot_name}.png"
  if [[ "$screenshot_name" == "pool-classification-overflow" ]]; then
    if [[ -z "$ui_entry_result" ]] || ! capture_classification_overflow_handshake \
      "$window_id" \
      "$app_pid" \
      "$ui_entry_result" \
      "$screenshot" \
      "$expected_overflow_recovery_count"; then
      echo "classification overflow popover was not capture-ready" >&2
      dump_exact_e2e_window_evidence \
        "$PWD/$window_identity_path" \
        "$window_identity_token" \
        "$app_pid" \
        "$expected_window_title" \
        "$expected_frame_width" \
        "$expected_frame_height" >&2
      exit 1
    fi
  else
    warmup_screenshot="${screenshot}.warmup.png"
    screencapture -x -o -l"$window_id" "$warmup_screenshot"
    sleep 0.25
    screencapture -x -o -l"$window_id" "$screenshot"
    rm -f "$warmup_screenshot"
  fi
  close_ui_entry_start_gate
  width="$(sips -g pixelWidth "$screenshot" | awk '/pixelWidth/ {print $2}')"
  height="$(sips -g pixelHeight "$screenshot" | awk '/pixelHeight/ {print $2}')"

  if [[ "$page" == "settings" ]]; then
    if [[ "${width:-0}" -lt 680 || "${height:-0}" -lt 500 || "${width:-0}" -gt 2000 || "${height:-0}" -gt 1600 ]]; then
      echo "invalid native Settings screenshot size for ${screenshot_name}: ${width:-unknown}x${height:-unknown}" >&2
      exit 1
    fi
  elif [[ "${width:-0}" -lt "$expected_frame_width" || "${height:-0}" -lt "$expected_frame_height" ||
    "${width:-0}" -gt 4800 || "${height:-0}" -gt 3200 ]]; then
    echo "invalid e2e screenshot size for ${screenshot_name}: ${width:-unknown}x${height:-unknown}" >&2
    exit 1
  fi

  assert_clean_app_log "${screenshot_name} screenshot" "$launch_log"
  echo "E2E ${screenshot_name} screenshot: ${screenshot} (${width}x${height})"
}

assert_clean_app_log() {
  local label="$1"
  local log_path="$2"

  if ! runtime_evidence_assert_clean_logs "$label" "$log_path"; then
    exit 1
  fi
}

sqlite_write_lock_holder_pid=""
sqlite_write_lock_holder_fifo=""
sqlite_write_lock_holder_ready=""
sqlite_write_lock_holder_log=""
sqlite_write_lock_holder_fd_open=0

stop_sqlite_write_lock_holder() {
  local holder_status=0

  if [[ "$sqlite_write_lock_holder_fd_open" == "1" ]]; then
    if [[ -n "$sqlite_write_lock_holder_pid" ]] \
      && kill -0 "$sqlite_write_lock_holder_pid" 2>/dev/null; then
      if ! printf 'ROLLBACK;\n.quit\n' >&9; then
        holder_status=1
      fi
    fi
    exec 9>&-
    sqlite_write_lock_holder_fd_open=0
  fi
  if [[ -n "$sqlite_write_lock_holder_pid" ]]; then
    if ! wait "$sqlite_write_lock_holder_pid"; then
      holder_status=1
    fi
  fi
  if [[ -n "$sqlite_write_lock_holder_fifo" ]]; then
    rm -f "$sqlite_write_lock_holder_fifo"
  fi
  sqlite_write_lock_holder_pid=""
  sqlite_write_lock_holder_fifo=""
  sqlite_write_lock_holder_ready=""
  sqlite_write_lock_holder_log=""
  return "$holder_status"
}

start_sqlite_write_lock_holder() {
  local database="$1"
  local fifo="$2"
  local ready="$3"
  local log_path="$4"
  local competitor_output=""
  local competitor_status=0
  local holder_ready=0
  local ready_directory
  local ready_path
  local shell_escaped_ready_path

  if [[ "$sqlite_write_lock_holder_fd_open" == "1" ]] \
    || [[ -n "$sqlite_write_lock_holder_pid" ]]; then
    echo "refusing to replace an active SQLite write lock holder" >&2
    return 1
  fi

  ready_directory="$(cd "$(dirname "$ready")" && pwd -P)"
  ready_path="${ready_directory}/$(basename "$ready")"
  printf -v shell_escaped_ready_path '%q' "$ready_path"
  rm -f "$fifo" "$ready" "$log_path"
  mkfifo -m 600 "$fifo"

  sqlite_write_lock_holder_fifo="$fifo"
  sqlite_write_lock_holder_ready="$ready"
  sqlite_write_lock_holder_log="$log_path"
  sqlite3 "$database" <"$fifo" >"$log_path" 2>&1 &
  sqlite_write_lock_holder_pid=$!
  exec 9>"$fifo"
  sqlite_write_lock_holder_fd_open=1

  if ! printf \
    '.bail on\n.timeout 0\nBEGIN IMMEDIATE;\n.shell /usr/bin/touch %s\n' \
    "$shell_escaped_ready_path" >&9; then
    echo "failed to submit the SQLite write lock transaction" >&2
    stop_sqlite_write_lock_holder >/dev/null 2>&1 || true
    return 1
  fi

  for _ in {1..100}; do
    if [[ -f "$ready" ]] \
      && kill -0 "$sqlite_write_lock_holder_pid" 2>/dev/null; then
      holder_ready=1
      break
    fi
    if ! kill -0 "$sqlite_write_lock_holder_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ "$holder_ready" != "1" ]]; then
    echo "SQLite write lock holder did not reach its ready handshake" >&2
    cat "$log_path" >&2
    stop_sqlite_write_lock_holder >/dev/null 2>&1 || true
    return 1
  fi

  if competitor_output="$(
    sqlite3 "$database" \
      'PRAGMA busy_timeout = 0; BEGIN IMMEDIATE; ROLLBACK;' 2>&1
  )"; then
    competitor_status=0
  else
    competitor_status=$?
  fi
  if [[ "$competitor_status" -eq 0 ]] \
    || [[ "$competitor_output" != *"database is locked"* ]]; then
    echo "SQLite write lock holder did not exclude a competing writer" >&2
    if [[ -n "$competitor_output" ]]; then
      printf '%s\n' "$competitor_output" >&2
    fi
    stop_sqlite_write_lock_holder >/dev/null 2>&1 || true
    return 1
  fi
}

prepare_english_screenshot_database() {
  local database_path="$1"
  local bootstrap_log="$2"
  local manifest_path
  local bootstrap_pid
  local app_exit_code=0
  local projection_counts
  local journal_transaction_count

  manifest_path="$(dirname "$database_path")/fixture-manifest.txt"
  rm -f \
    "$database_path" \
    "${database_path}-wal" \
    "${database_path}-shm" \
    "$manifest_path"
  : > "$bootstrap_log"
  "$app_executable_path" \
    --data-url "$database_path" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale en_SG \
    --e2e-bootstrap-english-screenshot-fixture \
    --e2e-english-fixture-result-url "$manifest_path" \
    --e2e-quit-after-automation \
    > "$bootstrap_log" 2>&1 &
  bootstrap_pid=$!

  for _ in {1..400}; do
    if [[ -f "$manifest_path" ]] || ! kill -0 "$bootstrap_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [[ ! -f "$manifest_path" ]]; then
    terminate_e2e_app
    wait "$bootstrap_pid" 2>/dev/null || true
    echo "English fixture manifest was not created by the real app" >&2
    cat "$bootstrap_log" >&2
    exit 1
  fi
  if [[ "$(head -n 1 "$manifest_path")" != "ok" ]]; then
    terminate_e2e_app
    wait "$bootstrap_pid" 2>/dev/null || true
    echo "English fixture bootstrap failed: $(<"$manifest_path")" >&2
    cat "$bootstrap_log" >&2
    exit 1
  fi

  for _ in {1..40}; do
    if ! kill -0 "$bootstrap_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$bootstrap_pid" 2>/dev/null; then
    terminate_e2e_app
    wait "$bootstrap_pid" 2>/dev/null || true
    echo "English fixture app wrote its manifest but did not terminate" >&2
    cat "$bootstrap_log" >&2
    exit 1
  fi
  wait "$bootstrap_pid" || app_exit_code=$?
  if [[ "$app_exit_code" != "0" ]]; then
    echo "English fixture app exited with status $app_exit_code" >&2
    cat "$bootstrap_log" >&2
    exit 1
  fi
  assert_clean_app_log "English database bootstrap" "$bootstrap_log"

  projection_counts="$(sqlite3 -noheader -separator '|' "$database_path" "
    SELECT
      (SELECT language FROM app_preferences WHERE id = 1),
      (SELECT count(*) FROM day_traces WHERE date = '2026-07-05' AND status != 'cancelledDraft'),
      (SELECT count(*) FROM task_pool_view),
      (SELECT count(*) FROM future_plan_view WHERE date > '2026-07-05'),
      (SELECT count(*) FROM unfinished_pool_view),
      (SELECT count(*) FROM day_traces WHERE status = 'completed'),
      (SELECT count(*) FROM task_chain_categories),
      (SELECT count(*) FROM task_chain_label_relations);
  ")"
  if [[ "$projection_counts" != "english|2|1|1|1|2|6|12" ]]; then
    echo "English fixture persisted projections are incomplete: ${projection_counts:-missing}" >&2
    cat "$manifest_path" >&2
    exit 1
  fi
  for key in \
    day_selected_id \
    pool_selected_id \
    future_selected_id \
    unfinished_selected_id \
    completed_selected_id \
    calendar_selected_id; do
    if [[ -z "$(awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2) }' "$manifest_path")" ]]; then
      echo "English fixture manifest is missing $key" >&2
      cat "$manifest_path" >&2
      exit 1
    fi
  done
  if ! grep -Fqx \
    "day_selected_title=Coordinate the launch readiness review with accessibility owners" \
    "$manifest_path"; then
    echo "English fixture manifest lost the complete long title" >&2
    cat "$manifest_path" >&2
    exit 1
  fi
  if ! grep -Fqx "classification_journal_count=6" "$manifest_path" ||
    ! grep -Fqx "classification_journal_exact=true" "$manifest_path" ||
    ! grep -Fqx "preferences_journal_exact=true" "$manifest_path" ||
    ! grep -Fqx "domain_journal_clock_exact=true" "$manifest_path"; then
    echo "English fixture manifest lost exact Store transaction/journal evidence" >&2
    cat "$manifest_path" >&2
    exit 1
  fi
  journal_transaction_count="$(
    awk -F= '$1 == "journal_transaction_count" { print $2 }' "$manifest_path"
  )"
  if [[ ! "$journal_transaction_count" =~ ^[0-9]+$ ]] ||
    (( journal_transaction_count < 24 )); then
    echo "English fixture did not preserve independent Store transaction frontiers" >&2
    cat "$manifest_path" >&2
    exit 1
  fi
  echo "E2E English populated fixture manifest: $manifest_path ($projection_counts)"
}

assert_english_screenshot() {
  local screenshot="$1"
  local page="$2"
  local screenshot_name="${3:-}"
  local expected_text
  local expected_header_date="5 July 2026"
  local ocr="${screenshot%.png}-ocr.txt"
  local ocr_log="${screenshot%.png}-ocr.log"

  case "$page" in
    day) expected_text="Day Todo" ;;
    pool) expected_text="Task Pool" ;;
    future) expected_text="Upcoming" ;;
    unfinished) expected_text="Unfinished" ;;
    completed) expected_text="Completed" ;;
    calendar) expected_text="Calendar" ;;
    settings) expected_text="Settings" ;;
    zhulong) expected_text="Zhulong" ;;
    *) expected_text="Noonmark" ;;
  esac

  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$screenshot" \
    NOONMARK_E2E_OCR_EXPECTED="$expected_text" swift -e '
import AppKit
import Foundation
import Vision

let environment = ProcessInfo.processInfo.environment
guard let path = environment["NOONMARK_E2E_OCR_IMAGE"],
      let expected = environment["NOONMARK_E2E_OCR_EXPECTED"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    fputs("unable to load English screenshot for OCR\n", stderr)
    exit(1)
}
let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["en-US", "zh-Hans"]
request.usesLanguageCorrection = false
try VNImageRequestHandler(cgImage: cgImage).perform([request])
let text = (request.results ?? [])
    .compactMap { $0.topCandidates(1).first?.string }
    .joined(separator: "\n")
print(text)
guard text.localizedCaseInsensitiveContains(expected) else {
    fputs("expected English page marker was not recognized: \(expected)\n", stderr)
    exit(2)
}
guard text.range(of: "\\p{Han}", options: .regularExpression) == nil else {
    fputs("English screenshot contains recognized Han text\n", stderr)
    exit(3)
}
' > "$ocr" 2> "$ocr_log"; then
    echo "English ${page} screenshot localization assertion failed:" >&2
    cat "$ocr" >&2
    cat "$ocr_log" >&2
    exit 1
  fi
  if [[ "$page" == "day" ]]; then
    if [[ "$screenshot_name" == "english-day-history-header" ]]; then
      expected_header_date="30 September 2025"
    fi
    if ! bash scripts/assert-english-day-header-screenshot \
      "$screenshot" \
      "$expected_header_date" \
      1 >>"$ocr" 2>>"$ocr_log"; then
      echo "English Day header pixel assertion failed:" >&2
      cat "$ocr" >&2
      cat "$ocr_log" >&2
      exit 1
    fi
  fi
  echo "E2E English ${page} screenshot has no recognized Han text: $screenshot"
}

assert_zhulong_title_geometry_result() {
  local result="$1"
  local expected_surface="$2"
  local expected_identifier="$3"
  local expected_text="$4"
  local mid_x_delta
  local leading_title_gap
  local trailing_title_gap

  if [[ ! -f "$result" || "$(head -n 1 "$result")" != "ok" ]]; then
    echo "Zhulong title geometry manifest is missing or failed: $result" >&2
    [[ -f "$result" ]] && cat "$result" >&2
    exit 1
  fi
  mid_x_delta="$(awk -F= '$1 == "mid_x_delta" { print $2 }' "$result")"
  if ! grep -Fqx "surface=$expected_surface" "$result" ||
    ! grep -Fqx "identifier=$expected_identifier" "$result" ||
    ! grep -Fqx "expected_text=$expected_text" "$result" ||
    ! grep -Fq "title_frame=x:" "$result" ||
    ! grep -Fq "middle_frame=x:" "$result" ||
    ! grep -Fq "title_mid_x=" "$result" ||
    ! grep -Fq "middle_mid_x=" "$result" ||
    ! grep -Fqx "tolerance=1.000" "$result" ||
    [[ ! "$mid_x_delta" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    ! awk -v delta="$mid_x_delta" 'BEGIN { exit !(delta <= 1) }'; then
    echo "Zhulong title geometry manifest lost its exact centering evidence: $result" >&2
    cat "$result" >&2
    exit 1
  fi
  if [[ "$expected_surface" == "session" ]]; then
    leading_title_gap="$(
      awk -F= '$1 == "leading_title_gap" { print $2 }' "$result"
    )"
    trailing_title_gap="$(
      awk -F= '$1 == "trailing_title_gap" { print $2 }' "$result"
    )"
    if ! grep -Eq '^detail_expanded=(true|false)$' "$result" ||
      ! grep -Fq "history_frame=x:" "$result" ||
      ! grep -Fq "variant_frame=x:" "$result" ||
      [[ ! "$leading_title_gap" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
      [[ ! "$trailing_title_gap" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
      ! awk -v gap="$leading_title_gap" 'BEGIN { exit !(gap >= 8) }' ||
      ! awk -v gap="$trailing_title_gap" 'BEGIN { exit !(gap >= 8) }'; then
      echo "Zhulong session-header geometry lost its non-overlap evidence: $result" >&2
      cat "$result" >&2
      exit 1
    fi
  fi
  echo "E2E Zhulong ${expected_surface} title geometry: $result (delta=${mid_x_delta}pt)"
}

record_english_scenario_evidence() {
  local scenario_name="$1"
  local screenshot="$2"
  local current_binary_sha256
  local external_ax="false"
  local oracles
  local screenshot_sha256

  if [[ ! -s "$screenshot" ]]; then
    echo "English scenario screenshot is missing: $screenshot" >&2
    exit 1
  fi
  current_binary_sha256="$(shasum -a 256 "$app_executable_path" | awk '{print $1}')"
  if [[ "$current_binary_sha256" != "$app_binary_sha256_before" ]]; then
    echo "English scenarios did not use one immutable App binary" >&2
    exit 1
  fi
  screenshot_sha256="$(shasum -a 256 "$screenshot" | awk '{print $1}')"

  if ! oracles="$(evidence_expected_english_oracles "$scenario_name")"; then
    echo "unknown English evidence scenario: $scenario_name" >&2
    exit 1
  fi
  if [[ "$scenario_name" == "english-day" ]]; then
    external_ax="true"
  fi

  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$scenario_name" \
    "$current_binary_sha256" \
    "$screenshot_sha256" \
    "$oracles" \
    "$external_ax" >>"$english_scenario_ledger"
}

assert_english_history_header_ui_result() {
  local result="artifacts/e2e-english/day-history-header-ui.txt"
  local actual_width

  if [[ ! -f "$result" || "$(head -n 1 "$result")" != "ok" ]]; then
    echo "English history header UI manifest is missing or failed" >&2
    [[ -f "$result" ]] && cat "$result" >&2
    exit 1
  fi
  actual_width="$(awk -F= '$1 == "detail_width" { print $2 }' "$result")"
  if ! grep -Fqx "page=day" "$result" ||
    ! awk -v actual="$actual_width" 'BEGIN { exit !(actual >= 278 && actual <= 282) }' ||
    ! grep -Fqx "header_full_date=30 September 2025" "$result" ||
    ! grep -Fqx "header_state=History locked" "$result" ||
    ! grep -Fqx "header_today_state_visible=false" "$result" ||
    ! grep -Fqx "header_today_action_visible=true" "$result" ||
    ! grep -Fqx "header_today_surface_count=1" "$result" ||
    ! grep -Fqx "header_navigation_target_count=4" "$result" ||
    ! grep -Fqx "header_navigation_minimum_target=28.0" "$result" ||
    ! grep -Fqx "header_compact_row_count=2" "$result" ||
    ! grep -Fqx "header_date_width_sufficient=true" "$result" ||
    ! grep -Fqx "header_navigation_targets_sufficient=true" "$result" ||
    ! grep -Fqx "header_date_action_overlap=false" "$result"; then
    echo "English history header lost its complete responsive contract" >&2
    cat "$result" >&2
    exit 1
  fi
  echo "E2E English history header responsive manifest: $result"
}

assert_english_populated_ui_result() {
  local page="$1"
  local result_key="${2:-$page}"
  local result="artifacts/e2e-english/${result_key}-ui.txt"
  local fixture_manifest="artifacts/e2e-english/fixture-manifest.txt"
  local fixture_key
  local expected_width="280.0"
  local actual_width
  local width_record_count
  local actual_count
  local selected_id
  local fixture_id

  case "$page" in
    day) fixture_key="day_selected_id" ;;
    pool) fixture_key="pool_selected_id" ;;
    future) fixture_key="future_selected_id" ;;
    unfinished) fixture_key="unfinished_selected_id" ;;
    completed) fixture_key="completed_selected_id" ;;
    calendar)
      fixture_key="calendar_selected_id"
      expected_width="248.0"
      ;;
    *) return 0 ;;
  esac

  if [[ ! -f "$result" || "$(head -n 1 "$result")" != "ok" ]]; then
    echo "English populated ${page} UI manifest is missing or failed" >&2
    [[ -f "$result" ]] && cat "$result" >&2
    exit 1
  fi
  actual_width="$(awk -F= '$1 == "detail_width" { print $2 }' "$result")"
  width_record_count="$(awk -F= '$1 == "detail_width" { count += 1 } END { print count + 0 }' "$result")"
  if ! grep -Fqx "page=$page" "$result" ||
    [[ "$width_record_count" != "1" ]] ||
    [[ ! "$actual_width" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    ! awk -v actual="$actual_width" -v expected="$expected_width" '
      BEGIN {
        difference = actual - expected
        if (difference < 0) difference = -difference
        exit !(difference <= 2)
      }
    '; then
    echo "English populated ${page} UI manifest has the wrong page or rail width" >&2
    cat "$result" >&2
    exit 1
  fi

  actual_count="$(awk -F= '$1 == "count" { print $2 }' "$result")"
  selected_id="$(awk -F= '$1 == "selected_id" { print $2 }' "$result")"
  fixture_id="$(awk -F= -v key="$fixture_key" '$1 == key { print $2 }' "$fixture_manifest")"
  if [[ ! "$actual_count" =~ ^[1-9][0-9]*$ || -z "$selected_id" ||
    "$selected_id" != "$fixture_id" ]]; then
    echo "English populated ${page} UI did not expose its fixture count/identity" >&2
    cat "$result" >&2
    exit 1
  fi

  if [[ "$page" == "day" ]]; then
    if ! grep -Fqx "selected_title=Coordinate the launch readiness review with accessibility owners" "$result" ||
      ! grep -Fqx "long_title_view_tree=complete" "$result" ||
      ! grep -Fqx "long_title_ax=complete" "$result" ||
      ! grep -Fqx "long_title_line_count=2" "$result" ||
      ! grep -Fqx "classification_remove_button_count=2" "$result" ||
      [[ "$(grep -Fc "classification_remove_button=" "$result")" != "2" ]]; then
      echo "English minimum-window Day detail lost or overflowed the complete long title" >&2
      cat "$result" >&2
      exit 1
    fi
    if [[ "$result_key" == "day" &&
      ! -s "artifacts/e2e-english/day-ax/ledger.tsv" ]]; then
      echo "English minimum-window Day external AX evidence is missing" >&2
      exit 1
    fi
  fi

  if [[ "$page" != "calendar" ]] && {
    ! grep -Fqx "classification_category_visible=Product Design" "$result" ||
      ! grep -Fqx "classification_label_visible=Accessibility" "$result" ||
      ! grep -Fqx "classification_secondary_label_visible=Launch Readiness" "$result";
  }; then
    echo "English populated ${page} screenshot did not expose its group and tags" >&2
    cat "$result" >&2
    exit 1
  fi
  echo "E2E English populated ${page} view-tree/AX manifest: $result (count=$actual_count selected=$selected_id)"
}

assert_settings_sidebar_screenshot() {
  local screenshot="$1"
  local language="$2"
  local ocr="${screenshot%.png}-ocr.txt"
  local ocr_log="${screenshot%.png}-ocr.log"

  if ! NOONMARK_E2E_OCR_IMAGE="$PWD/$screenshot" \
    NOONMARK_E2E_OCR_LANGUAGE="$language" swift -e '
import AppKit
import Foundation
import Vision

let environment = ProcessInfo.processInfo.environment
guard let path = environment["NOONMARK_E2E_OCR_IMAGE"],
      let language = environment["NOONMARK_E2E_OCR_LANGUAGE"],
      let image = NSImage(contentsOfFile: path),
      let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
else {
    fputs("unable to load Settings screenshot for OCR\n", stderr)
    exit(1)
}
let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.recognitionLanguages = ["zh-Hans", "en-US"]
request.usesLanguageCorrection = false
try VNImageRequestHandler(cgImage: cgImage).perform([request])
let text = (request.results ?? [])
    .compactMap { $0.topCandidates(1).first?.string }
    .joined(separator: "\n")
print(text)

func normalized(_ value: String) -> String {
    value.precomposedStringWithCompatibilityMapping
        .components(separatedBy: .whitespacesAndNewlines)
        .filter { !$0.isEmpty }
        .joined(separator: " ")
}

let expectedTitles = language == "english"
    ? ["Settings", "Zhulong and Automation", "Write & Privacy Boundaries"]
    : ["设置", "烛龙与自动化", "写入与隐私边界"]
let recognizedText = normalized(text)
for expectedTitle in expectedTitles {
    let normalizedTitle = normalized(expectedTitle)
    let found = language == "english"
        ? recognizedText.localizedCaseInsensitiveContains(normalizedTitle)
        : recognizedText.contains(normalizedTitle)
    guard found else {
        fputs("Settings sidebar is missing the complete title: \(expectedTitle)\n", stderr)
        exit(2)
    }
}
' > "$ocr" 2> "$ocr_log"; then
    echo "Settings sidebar OCR assertion failed:" >&2
    cat "$ocr" >&2
    cat "$ocr_log" >&2
    exit 1
  fi
  echo "E2E Settings sidebar titles are complete in ${language}: $screenshot"
}

run_english_menu_probe() {
  local database_path="$1"
  local menu_dir="artifacts/e2e-english/menu"
  local state_file="$menu_dir/state.json"
  local help_shortcut_result="$menu_dir/help-shortcut-result.txt"
  local help_shortcut_log="$menu_dir/help-shortcut.log"
  local exercise_result="$menu_dir/exercise-result.txt"
  local exercise_log="$menu_dir/exercise.log"
  local help_ready_path="$menu_dir/help-ready.txt"
  local helper_evidence_dir="$menu_dir/help-menu-helper"
  local verify_result="$menu_dir/verify-result.txt"
  local verify_log="$menu_dir/verify.log"
  local pool_result="$menu_dir/pool-result.txt"
  local pool_log="$menu_dir/pool.log"
  local pool_title="englishpoolreturntask"

  rm -rf "$menu_dir"
  mkdir -p "$menu_dir"
  terminate_e2e_app

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "English native Help shortcut" \
    "$help_shortcut_result" \
    "$help_shortcut_log" \
    --data-url "$database_path" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale en_SG \
    --e2e-reset-selection \
    --e2e-native-command-help-shortcut \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$help_shortcut_result"

  run_native_command_surface_exercise \
    "English native menu exercise" \
    "$exercise_result" \
    "$exercise_log" \
    "$help_ready_path" \
    "$helper_evidence_dir" \
    "Help" \
    "Noonmark Help" \
    --data-url "$database_path" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale en_SG \
    --e2e-reset-selection \
    --e2e-native-command-surface-exercise \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$exercise_result"

  NOONMARK_E2E_LAUNCH_WITH_OPEN=1 run_terminating_ui_probe \
    "English native menu restart" \
    "$verify_result" \
    "$verify_log" \
    --data-url "$database_path" \
    --page day \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale en_SG \
    --e2e-reset-selection \
    --e2e-native-command-surface-verify \
    --e2e-native-command-state-url "$PWD/$state_file" \
    --e2e-native-command-result-url "$PWD/$verify_result"

  run_terminating_ui_probe \
    "English task-pool quick-add" \
    "$pool_result" \
    "$pool_log" \
    --data-url "$database_path" \
    --page pool \
    --e2e-fixed-instant 2026-07-05T16:00:00Z \
    --e2e-fixed-time-zone America/New_York \
    --e2e-fixed-locale en_SG \
    --e2e-quick-add-via-ui pool \
    --e2e-quick-add-ui-title "$pool_title" \
    --e2e-quick-add-ui-result-url "$PWD/$pool_result"

  if [[ "$(sqlite3 -noheader "$database_path" "SELECT language FROM app_preferences WHERE id = 1;")" != "english" ]]; then
    echo "English native menu probe changed the persisted language" >&2
    exit 1
  fi
  if [[ "$(sqlite3 -noheader "$database_path" "
    SELECT description_text
    FROM task_definitions
    WHERE title = 'commandrecoverytask';
  ")" != "Quickly captured from Day Todo." ]]; then
    echo "English Quick Entry persisted a non-localized default description" >&2
    exit 1
  fi
  if [[ "$(sqlite3 -noheader -separator '|' "$database_path" "
    SELECT
      coalesce(definition.description_text, ''),
      json_array_length(chain.note_entries_json)
    FROM task_definitions AS definition
    JOIN task_chains AS chain ON chain.id = definition.chain_id
    WHERE definition.title = '$pool_title';
  ")" != "|0" ]]; then
    echo "English Task Pool quick-add polluted user-authored fields" >&2
    exit 1
  fi
  echo "E2E native menus and persisted Quick Entry/Task Pool defaults validated in English"
}

