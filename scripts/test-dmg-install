      evidence_read \
        "$package_manifest_path" \
        "release_symbols_${release_symbol_suffix}"
    )"
done
for release_identity_suffix in \
  version \
  build \
  git_commit \
  build_date \
  runtime \
  minimum_os_version \
  architecture \
  binary_uuid_set \
  binary_sha256 \
  binary_sha256_scope \
  provenance_path \
  provenance_sha256; do
  evidence_append \
    "$runtime_manifest_path" \
    "package_release_identity_${release_identity_suffix}" \
    "$(
      evidence_read \
        "$package_manifest_path" \
        "release_identity_${release_identity_suffix}"
    )"
done
evidence_append \
  "$runtime_manifest_path" \
  "production_bundle_identifier" \
  "$production_bundle_identifier"
evidence_append \
  "$runtime_manifest_path" \
  "production_mounted_executable" \
  "${source_app}/Contents/MacOS/NoonmarkMacApp"
evidence_append \
  "$runtime_manifest_path" \
  "production_app_executed" "false"
evidence_append \
  "$runtime_manifest_path" \
  "validation_bundle_identifier" \
  "$validation_bundle_identifier"
evidence_append \
  "$runtime_manifest_path" \
  "validation_executable" \
  "$installed_executable"
evidence_append \
  "$runtime_manifest_path" \
  "validation_data_directory_name" \
  "$validation_data_directory_name"
evidence_append \
  "$runtime_manifest_path" \
  "validation_icloud_repository" \
  "$validation_icloud_repository"
evidence_append \
  "$runtime_manifest_path" \
  "validation_derivation_allowed_delta" \
  "$validation_derivation_allowed_delta"
evidence_append \
  "$runtime_manifest_path" \
  "validation_derivation_source_binary_sha256" \
  "$validation_derivation_source_binary_sha256"
evidence_append \
  "$runtime_manifest_path" \
  "validation_derivation_pre_sign_binary_sha256" \
  "$validation_derivation_pre_sign_binary_sha256"
evidence_append \
  "$runtime_manifest_path" \
  "validation_derivation_pre_sign_uuid_set" \
  "$validation_derivation_pre_sign_uuid_set"
evidence_append \
  "$runtime_manifest_path" \
  "validation_source_linked_binary_sha256" \
  "$validation_source_linked_binary_sha256"
evidence_append \
  "$runtime_manifest_path" \
  "validation_source_linked_binary_sha256_scope" \
  "$validation_source_linked_binary_sha256_scope"
evidence_append \
  "$runtime_manifest_path" \
  "validation_source_linked_binary_uuid_set" \
  "$validation_source_linked_binary_uuid_set"
evidence_append \
  "$runtime_manifest_path" \
  "validation_signed_binary_sha256" \
  "$validation_signed_binary_sha256"
evidence_append \
  "$runtime_manifest_path" \
  "validation_signed_binary_uuid_set" \
  "$validation_signed_binary_uuid_set"
evidence_append \
  "$runtime_manifest_path" \
  "validation_derivation_fragment_sha256" \
  "$(shasum -a 256 "$validation_derivation_fragment" | awk '{print $1}')"
evidence_append \
  "$runtime_manifest_path" \
  "helper_process" \
  "$helper_executable_name"
evidence_append \
  "$runtime_manifest_path" \
  "helper_bundle_identifier" \
  "$helper_bundle_identifier"
evidence_append "$runtime_manifest_path" "helper_bundle" "$helper_app"
runtime_manifest_started=1

scripts/reset-dev-data dmg-validation
if [[ -e "$database_path" ]]; then
  echo "dmg-validation reset left persistence before permission preflight: $database_path" >&2
  exit 1
fi
run_permission_preflight

: >"$initial_launch_log"
start_runtime_capture "$initial_console_log"
launch_installed_app "$initial_launch_log"

installed_pid="$(wait_for_installed_pid)"
verify_installed_process_identity "$installed_pid"
active_app_pid="$installed_pid"
capture_window_evidence \
  "$installed_pid" \
  "$screenshot_path" \
  "$window_metadata_path" \
  "dmg-validation initial" \
  "$active_window_launch_token"
window_id="$CAPTURED_WINDOW_ID"
initial_day="$CAPTURED_WINDOW_DAY"
expected_window_title="$CAPTURED_WINDOW_TITLE"
width="$CAPTURED_WINDOW_WIDTH"
height="$CAPTURED_WINDOW_HEIGHT"
request_verified_app_termination "$installed_pid"
active_app_pid=""
runtime_evidence_stop_console_capture
runtime_evidence_assert_clean_logs \
  "DMG validation initial launch" \
  "$initial_launch_log" \
  "$initial_console_log"
assert_blank_persistence
evidence_append \
  "$runtime_manifest_path" \
  "validation_app_executed" "true"

scripts/reset-dev-data dmg-validation
if [[ -e "$database_path" ]]; then
  echo "dmg-validation reset left initial persistence before exercise: $database_path" >&2
  exit 1
fi

rm -f \
  "$task_identity_path" \
  "$task_snapshot_before_path" \
  "$task_snapshot_after_path"

run_validation_helper_phase exercise
exercise_day="$VALIDATION_PHASE_DAY"

IFS='|' read -r current_day_after_exercise _ < <(current_day_metadata)
if [[ "$current_day_after_exercise" != "$exercise_day" ]]; then
  echo "natural day crossed while creating the validation task: window=$exercise_day current=$current_day_after_exercise" >&2
  exit 1
fi
capture_task_snapshot "$exercise_day" "$task_snapshot_before_path"
{
  printf 'trace_id\tchain_id\tdefinition_id\tdate\ttrace_status\tchain_state\tdefinition_sequence\ttitle\n'
  printf '%s\n' "$TASK_IDENTITY_LINE"
} >"$task_identity_path"

run_validation_helper_phase restart
restart_day="$VALIDATION_PHASE_DAY"
if [[ "$restart_day" != "$exercise_day" ]]; then
  echo "natural day crossed before the persistence restart check: created=$exercise_day restart=$restart_day" >&2
  exit 1
fi

capture_task_snapshot "$exercise_day" "$task_snapshot_after_path"
if ! cmp -s "$task_snapshot_before_path" "$task_snapshot_after_path"; then
  echo "DMG validation task identity changed across a no-argument restart" >&2
  echo "before restart:" >&2
  cat "$task_snapshot_before_path" >&2
  echo "after restart:" >&2
  cat "$task_snapshot_after_path" >&2
  exit 1
fi

run_validation_diagnostic_export_phase

echo "Production DMG static evidence verified without execution: $source_app"
echo "Derived DMG validation App: $installed_app"
echo "Validation dynamic main window: $expected_window_title (natural_day=$initial_day)"
echo "Validation App screenshot: $screenshot_path (${width}x${height})"
echo "Validation Settings and Quick Entry used real WindowServer input: $exercise_ledger"
echo "Validation task persisted as pending/active/current: $task_identity_path"
echo "Validation restart exposed the same task through AX: $restart_ledger"
echo "Validation joined-row identity remained byte-for-byte stable: $task_snapshot_after_path"
echo "Validation diagnostics exported through real UI while both persistence locks were held: $diagnostic_export_ledger"
echo "Validation diagnostic package is bounded, private, and release-bound: $diagnostic_export_package_report"
echo "Validation App and helper unified logs are clean: $exercise_console_log, $restart_console_log, $diagnostic_export_console_log"
echo "Validation runtime diagnostics are guarded: $runtime_manifest_path"
