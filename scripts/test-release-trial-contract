#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

fail() {
  echo "release trial contract: $*" >&2
  exit 1
}

release_script="scripts/release-private-dmg"
trial_verifier="scripts/verify-release-trial-version"
[[ -x "$trial_verifier" ]] || fail "trial version verifier is missing or not executable"
source_verifier="scripts/verify-release-source-identity"
source_fingerprint="scripts/release-source-fingerprint"
origin_verifier="scripts/verify-origin-main-candidate"

for required in \
  'usage: scripts/release-private-dmg [--trial <absolute-output-dmg>]' \
  'mode="tagged"' \
  'mode="trial"' \
  'scripts/verify-release-trial-version' \
  'scripts/verify-release-version-tag' \
  'scripts/verify-github-release-readiness' \
  'scripts/verify-release-static-preflight' \
  'scripts/test-release-diagnostic-closure' \
  'scripts/test-tencent-ime-release-smoke release' \
  'scripts/package-dmg release' \
  'scripts/verify-dmg dist/Noonmark.dmg' \
  'scripts/test-dmg-install dist/Noonmark.dmg' \
  'scripts/verify-development-validation-evidence --scope full' \
  'scripts/publish-trial-dmg' \
  '"$package_manifest_sha256"'; do
  rg -F -- "$required" "$release_script" >/dev/null ||
    fail "private DMG entry lacks required trial boundary: $required"
done

trial_line="$(rg -n -F 'scripts/verify-release-trial-version' "$release_script" |
  head -n 1 | cut -d: -f1)"
tag_line="$(rg -n -F 'scripts/verify-release-version-tag' "$release_script" |
  head -n 1 | cut -d: -f1)"
github_line="$(rg -n -F 'scripts/verify-github-release-readiness' "$release_script" |
  head -n 1 | cut -d: -f1)"
shared_line="$(rg -n -F 'scripts/verify-release-static-preflight' "$release_script" |
  head -n 1 | cut -d: -f1)"
for line in "$trial_line" "$tag_line" "$github_line" "$shared_line"; do
  [[ "$line" =~ ^[0-9]+$ ]] || fail "release prerequisite line is missing"
done
((trial_line < shared_line)) || fail "trial verifier does not precede shared gates"
((tag_line < github_line && github_line < shared_line)) ||
  fail "tagged prerequisites do not precede shared gates"

fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-trial-contract.XXXXXX")"
fixture_root="$(cd "$fixture_root" && pwd -P)"
cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT INT TERM

entry_fixture="$fixture_root/entry"
mkdir -p "$entry_fixture/scripts" "$entry_fixture/dist"
cp "$release_script" "$entry_fixture/scripts/"
: >"$entry_fixture/scripts/evidence-common"
printf '%s\n' 'suite=package-dmg' >"$entry_fixture/dist/Noonmark.dmg.manifest"
package_manifest_sha256="$(
  shasum -a 256 "$entry_fixture/dist/Noonmark.dmg.manifest" | awk '{print $1}'
)"
stub_commands=(
  verify-release-trial-version
  verify-release-version-tag
  verify-github-release-readiness
  verify-release-static-preflight
  verify-development-validation-evidence
  test-release-diagnostic-closure
  test-tencent-ime-release-smoke
  verify-tencent-ime-release-smoke-evidence
  package-dmg
  verify-dmg
  test-dmg-install
  publish-trial-dmg
)
for stub_command in "${stub_commands[@]}"; do
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'if [[ "$#" -eq 0 ]]; then' \
    '  printf "%s\\n" "$(basename "$0")" >>"$NOONMARK_TRIAL_TRACE"' \
    'else' \
    '  printf "%s %s\\n" "$(basename "$0")" "$*" >>"$NOONMARK_TRIAL_TRACE"' \
    'fi' \
    'if [[ "$(basename "$0")" == "verify-development-validation-evidence" &&' \
    '  "$*" == "--scope full" && "${NOONMARK_MUTATE_PACKAGE_MANIFEST:-0}" == "1" ]]; then' \
    '  printf "%s\\n" "tampered=true" >>"$NOONMARK_PACKAGE_MANIFEST"' \
    'fi' \
    >"$entry_fixture/scripts/$stub_command"
  chmod +x "$entry_fixture/scripts/$stub_command"
done

if "$entry_fixture/scripts/release-private-dmg" --trial >/dev/null 2>&1; then
  fail "trial mode accepted a missing output path"
fi

trial_trace="$fixture_root/trial.trace"
marketing_version="$(scripts/release-version marketing-version)"
build_number="$(scripts/release-version build-number)"
trial_output="$fixture_root/Noonmark-${marketing_version}-build${build_number}.dmg"
(
  cd "$entry_fixture"
  NOONMARK_EVIDENCE_RUN_ID=trial-fixture \
    NOONMARK_TRIAL_TRACE="$trial_trace" \
    scripts/release-private-dmg --trial "$trial_output" >/dev/null
)
expected_trial_trace="$fixture_root/expected-trial.trace"
printf '%s\n' \
  'verify-release-trial-version' \
  'verify-release-static-preflight' \
  'verify-development-validation-evidence --scope runtime' \
  'test-release-diagnostic-closure' \
  'test-tencent-ime-release-smoke release' \
  'verify-tencent-ime-release-smoke-evidence' \
  'package-dmg release' \
  'verify-dmg dist/Noonmark.dmg' \
  'test-dmg-install dist/Noonmark.dmg' \
  'verify-development-validation-evidence --scope full' \
  "publish-trial-dmg $entry_fixture/dist/Noonmark.dmg $entry_fixture/dist/Noonmark.dmg.manifest $package_manifest_sha256 $trial_output" \
  >"$expected_trial_trace"
if ! cmp -s "$expected_trial_trace" "$trial_trace"; then
  diff -u "$expected_trial_trace" "$trial_trace" >&2 || true
  fail "trial mode did not execute the exact ordered gate chain"
fi

tagged_trace="$fixture_root/tagged.trace"
(
  cd "$entry_fixture"
  NOONMARK_EVIDENCE_RUN_ID=tagged-fixture \
    NOONMARK_TRIAL_TRACE="$tagged_trace" \
    scripts/release-private-dmg >/dev/null
)
expected_tagged_trace="$fixture_root/expected-tagged.trace"
printf '%s\n' \
  'verify-release-version-tag' \
  'verify-github-release-readiness' \
  'verify-release-static-preflight' \
  'verify-development-validation-evidence --scope runtime' \
  'test-release-diagnostic-closure' \
  'test-tencent-ime-release-smoke release' \
  'verify-tencent-ime-release-smoke-evidence' \
  'package-dmg release' \
  'verify-dmg dist/Noonmark.dmg' \
  'test-dmg-install dist/Noonmark.dmg' \
  'verify-development-validation-evidence --scope full' \
  >"$expected_tagged_trace"
if ! cmp -s "$expected_tagged_trace" "$tagged_trace"; then
  diff -u "$expected_tagged_trace" "$tagged_trace" >&2 || true
  fail "tagged mode did not execute the exact ordered gate chain"
fi

mutated_trace="$fixture_root/mutated.trace"
if (
  cd "$entry_fixture"
  NOONMARK_EVIDENCE_RUN_ID=mutated-fixture \
    NOONMARK_TRIAL_TRACE="$mutated_trace" \
    NOONMARK_MUTATE_PACKAGE_MANIFEST=1 \
    NOONMARK_PACKAGE_MANIFEST="$entry_fixture/dist/Noonmark.dmg.manifest" \
    scripts/release-private-dmg --trial "$trial_output" >/dev/null 2>&1
); then
  fail "trial mode accepted a package manifest changed by the full verifier"
fi
if rg -q '^publish-trial-dmg ' "$mutated_trace"; then
  fail "trial mode published after its package manifest authority changed"
fi

version_fixture="$fixture_root/version"
mkdir -p \
  "$version_fixture/scripts" \
  "$version_fixture/release" \
  "$version_fixture/Sources"
cp \
  "$trial_verifier" \
  "$source_verifier" \
  "$source_fingerprint" \
  "$origin_verifier" \
  scripts/release-version \
  "$version_fixture/scripts/"
chmod +x \
  "$version_fixture/scripts/verify-release-trial-version" \
  "$version_fixture/scripts/verify-release-source-identity" \
  "$version_fixture/scripts/release-source-fingerprint" \
  "$version_fixture/scripts/verify-origin-main-candidate" \
  "$version_fixture/scripts/release-version"
cp release/VERSION release/BUILD-LEDGER.tsv "$version_fixture/release/"
printf '%s\n' 'original candidate source' \
  >"$version_fixture/Sources/candidate-source.txt"
git -C "$version_fixture" init -q
git -C "$version_fixture" config user.name Noonmark
git -C "$version_fixture" config user.email noonmark@example.invalid
git -C "$version_fixture" add scripts release Sources
fixture_version="$(
  cd "$version_fixture"
  scripts/release-version marketing-version
)"
fixture_build="$(
  cd "$version_fixture"
  scripts/release-version build-number
)"
next_build=$((fixture_build + 1))
fixture_fingerprint="$(
  cd "$version_fixture"
  scripts/release-source-fingerprint
)"
printf '%s\n' \
  "marketing_version=$fixture_version" \
  "build_number=$fixture_build" \
  "source_fingerprint_sha256=$fixture_fingerprint" \
  >"$version_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$version_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$version_fixture" commit -qm 'test: establish bound trial fixture'
fixture_binding_commit="$(git -C "$version_fixture" rev-parse HEAD)"
version_origin="$fixture_root/version-origin.git"
git init --bare -q "$version_origin"
git -C "$version_fixture" branch -M main
git -C "$version_fixture" remote add origin "$version_origin"
git -C "$version_fixture" push -q origin HEAD:refs/heads/main
git -C "$version_origin" symbolic-ref HEAD refs/heads/main

(
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null
) || fail "fresh highest candidate without a tag was rejected"

amended_fixture="$fixture_root/amended-version"
git clone -q "$version_origin" "$amended_fixture"
git -C "$amended_fixture" config user.name Noonmark
git -C "$amended_fixture" config user.email noonmark@example.invalid
git -C "$amended_fixture" commit --amend -qm \
  'test: amend bound candidate identity'
(
  cd "$amended_fixture"
  scripts/verify-release-source-identity >/dev/null
) || fail "local source audit unexpectedly rejected an identical-tree amend"
if (
  cd "$amended_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted an amended commit absent from origin/main"
fi

synthetic_fixture="$fixture_root/synthetic-merge-version"
mkdir -p \
  "$synthetic_fixture/scripts" \
  "$synthetic_fixture/release" \
  "$synthetic_fixture/Sources"
cp \
  "$trial_verifier" \
  "$source_verifier" \
  "$source_fingerprint" \
  "$origin_verifier" \
  scripts/release-version \
  "$synthetic_fixture/scripts/"
chmod +x "$synthetic_fixture/scripts/"*
cp release/VERSION release/BUILD-LEDGER.tsv "$synthetic_fixture/release/"
synthetic_base_build=$((fixture_build - 1))
((synthetic_base_build > 0)) ||
  fail "fixture build cannot exercise a synthetic merge"
sed -i '' "s/^build_number=.*/build_number=$synthetic_base_build/" \
  "$synthetic_fixture/release/VERSION"
printf '%s\n' 'synthetic merge base source' \
  >"$synthetic_fixture/Sources/candidate-source.txt"
git -C "$synthetic_fixture" init -q
git -C "$synthetic_fixture" config user.name Noonmark
git -C "$synthetic_fixture" config user.email noonmark@example.invalid
git -C "$synthetic_fixture" add scripts release Sources
git -C "$synthetic_fixture" commit -qm 'test: establish synthetic merge base'
synthetic_base_commit="$(git -C "$synthetic_fixture" rev-parse HEAD)"
git -C "$synthetic_fixture" switch -qc candidate
sed -i '' "s/^build_number=.*/build_number=$fixture_build/" \
  "$synthetic_fixture/release/VERSION"
git -C "$synthetic_fixture" add release/VERSION
synthetic_fingerprint="$(
  cd "$synthetic_fixture"
  scripts/release-source-fingerprint
)"
printf '%s\n' \
  "marketing_version=$fixture_version" \
  "build_number=$fixture_build" \
  "source_fingerprint_sha256=$synthetic_fingerprint" \
  >"$synthetic_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$synthetic_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$synthetic_fixture" commit -qm 'test: bind candidate branch source'
synthetic_candidate_commit="$(git -C "$synthetic_fixture" rev-parse HEAD)"
synthetic_origin="$fixture_root/synthetic-origin.git"
git init --bare -q "$synthetic_origin"
git -C "$synthetic_fixture" remote add origin "$synthetic_origin"
git -C "$synthetic_fixture" push -q origin HEAD:refs/heads/main
git -C "$synthetic_origin" symbolic-ref HEAD refs/heads/main
git -C "$synthetic_fixture" switch --detach -q "$synthetic_base_commit"
git -C "$synthetic_fixture" merge --no-ff -qm \
  'test: create synthetic candidate merge' "$synthetic_candidate_commit"
(
  cd "$synthetic_fixture"
  scripts/verify-release-source-identity >/dev/null
) || fail "local source audit unexpectedly rejected the synthetic merge"
if (
  cd "$synthetic_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a synthetic merge absent from origin/main"
fi

shallow_fixture="$fixture_root/shallow-version"
git clone -q --depth 1 "file://$version_origin" "$shallow_fixture"
if (
  cd "$shallow_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a shallow candidate history"
fi

introduction_fixture="$fixture_root/introduction-version"
mkdir -p \
  "$introduction_fixture/scripts" \
  "$introduction_fixture/release" \
  "$introduction_fixture/Sources"
cp \
  "$trial_verifier" \
  "$source_verifier" \
  "$source_fingerprint" \
  "$origin_verifier" \
  scripts/release-version \
  "$introduction_fixture/scripts/"
chmod +x "$introduction_fixture/scripts/"*
cp release/VERSION release/BUILD-LEDGER.tsv "$introduction_fixture/release/"
printf '%s\n' 'pre-identity candidate source' \
  >"$introduction_fixture/Sources/candidate-source.txt"
git -C "$introduction_fixture" init -q
git -C "$introduction_fixture" config user.name Noonmark
git -C "$introduction_fixture" config user.email noonmark@example.invalid
git -C "$introduction_fixture" add scripts release Sources
git -C "$introduction_fixture" commit -qm 'test: establish unbound candidate'
introduction_fingerprint="$(
  cd "$introduction_fixture"
  scripts/release-source-fingerprint
)"
printf '%s\n' \
  "marketing_version=$fixture_version" \
  "build_number=$fixture_build" \
  "source_fingerprint_sha256=$introduction_fingerprint" \
  >"$introduction_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$introduction_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$introduction_fixture" commit -qm 'test: bind without a higher build'
if (
  cd "$introduction_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted first source binding without a higher build"
fi

preidentity_history_fixture="$fixture_root/preidentity-history-version"
mkdir -p \
  "$preidentity_history_fixture/scripts" \
  "$preidentity_history_fixture/release" \
  "$preidentity_history_fixture/Sources"
cp \
  "$source_verifier" \
  "$source_fingerprint" \
  scripts/release-version \
  "$preidentity_history_fixture/scripts/"
chmod +x "$preidentity_history_fixture/scripts/"*
cp release/VERSION release/BUILD-LEDGER.tsv \
  "$preidentity_history_fixture/release/"
printf '%s\n' 'historical high-build source' \
  >"$preidentity_history_fixture/Sources/candidate-source.txt"
git -C "$preidentity_history_fixture" init -q
git -C "$preidentity_history_fixture" config user.name Noonmark
git -C "$preidentity_history_fixture" config user.email noonmark@example.invalid
git -C "$preidentity_history_fixture" add scripts release Sources
git -C "$preidentity_history_fixture" commit -qm \
  'test: establish historical high build without identity'
preidentity_rollback_build=$((fixture_build - 1))
((preidentity_rollback_build > 0)) ||
  fail "fixture build cannot exercise preidentity rollback"
sed -i '' "s/^build_number=.*/build_number=$preidentity_rollback_build/" \
  "$preidentity_history_fixture/release/VERSION"
git -C "$preidentity_history_fixture" add release/VERSION
git -C "$preidentity_history_fixture" commit -qm \
  'test: roll back before introducing identity'
sed -i '' "s/^build_number=.*/build_number=$fixture_build/" \
  "$preidentity_history_fixture/release/VERSION"
git -C "$preidentity_history_fixture" add release/VERSION
preidentity_fingerprint="$(
  cd "$preidentity_history_fixture"
  scripts/release-source-fingerprint
)"
printf '%s\n' \
  "marketing_version=$fixture_version" \
  "build_number=$fixture_build" \
  "source_fingerprint_sha256=$preidentity_fingerprint" \
  >"$preidentity_history_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$preidentity_history_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$preidentity_history_fixture" commit -qm \
  'test: reuse historical build for first identity'
if (
  cd "$preidentity_history_fixture"
  scripts/verify-release-source-identity >/dev/null 2>&1
); then
  fail "source verifier accepted reuse of a preidentity historical build"
fi

head_fixture="$fixture_root/head-version"
git clone -q "$version_origin" "$head_fixture"
git -C "$head_fixture" config user.name Noonmark
git -C "$head_fixture" config user.email noonmark@example.invalid
git -C "$head_fixture" commit --allow-empty -qm 'test: advance candidate head'
if (
  cd "$head_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a candidate identity bound to an older HEAD"
fi

docs_fixture="$fixture_root/docs-version"
git clone -q "$version_origin" "$docs_fixture"
git -C "$docs_fixture" config user.name Noonmark
git -C "$docs_fixture" config user.email noonmark@example.invalid
docs_fingerprint_before="$(
  cd "$docs_fixture"
  scripts/release-source-fingerprint
)"
mkdir -p "$docs_fixture/docs"
printf '%s\n' 'machine-consumed release gate input' \
  >"$docs_fixture/docs/gate-input.tsv"
git -C "$docs_fixture" add docs/gate-input.tsv
docs_fingerprint_after="$(
  cd "$docs_fixture"
  scripts/release-source-fingerprint
)"
[[ "$docs_fingerprint_after" != "$docs_fingerprint_before" ]] ||
  fail "release source fingerprint ignored tracked documentation"
git -C "$docs_fixture" commit -qm 'test: change tracked documentation'
if (
  cd "$docs_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a docs-only candidate commit"
fi

history_fixture="$fixture_root/history-version"
git clone -q "$version_origin" "$history_fixture"
git -C "$history_fixture" config user.name Noonmark
git -C "$history_fixture" config user.email noonmark@example.invalid
rollback_build=$((fixture_build - 1))
((rollback_build > 0)) || fail "fixture build cannot exercise rollback"
printf '%s\n' 'rolled-back candidate source' \
  >"$history_fixture/Sources/candidate-source.txt"
sed -i '' "s/^build_number=.*/build_number=$rollback_build/" \
  "$history_fixture/release/VERSION"
git -C "$history_fixture" add Sources/candidate-source.txt release/VERSION
rollback_fingerprint="$(
  cd "$history_fixture"
  scripts/release-source-fingerprint
)"
sed -i '' "s/^build_number=.*/build_number=$rollback_build/" \
  "$history_fixture/release/CURRENT-BUILD-SOURCE"
sed -i '' \
  "s/^source_fingerprint_sha256=.*/source_fingerprint_sha256=$rollback_fingerprint/" \
  "$history_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$history_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$history_fixture" commit -qm 'test: roll back candidate build'
printf '%s\n' 'reused candidate source' \
  >"$history_fixture/Sources/candidate-source.txt"
sed -i '' "s/^build_number=.*/build_number=$fixture_build/" \
  "$history_fixture/release/VERSION"
git -C "$history_fixture" add Sources/candidate-source.txt release/VERSION
reused_fingerprint="$(
  cd "$history_fixture"
  scripts/release-source-fingerprint
)"
sed -i '' "s/^build_number=.*/build_number=$fixture_build/" \
  "$history_fixture/release/CURRENT-BUILD-SOURCE"
sed -i '' \
  "s/^source_fingerprint_sha256=.*/source_fingerprint_sha256=$reused_fingerprint/" \
  "$history_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$history_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$history_fixture" commit -qm 'test: reuse historical candidate build'
if (
  cd "$history_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted reuse of a historical candidate build"
fi

printf '%s\n' 'mutated candidate source' \
  >"$version_fixture/Sources/candidate-source.txt"
git -C "$version_fixture" add Sources/candidate-source.txt
git -C "$version_fixture" commit -qm 'test: mutate candidate source'
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted changed source under the same version and build"
fi
mutated_fingerprint="$(
  cd "$version_fixture"
  scripts/release-source-fingerprint
)"
sed -i '' \
  "s/^source_fingerprint_sha256=.*/source_fingerprint_sha256=$mutated_fingerprint/" \
  "$version_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$version_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$version_fixture" commit -qm 'test: rebind unchanged trial identity'
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted rebound source under the same version and build"
fi
mkdir -p "$version_fixture/docs"
printf '%s\n' 'follow-up documentation' \
  >"$version_fixture/docs/follow-up.md"
git -C "$version_fixture" add docs/follow-up.md
git -C "$version_fixture" commit -qm 'docs: follow rebound source'
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier forgot an invalid rebound after a later commit"
fi
git -C "$version_fixture" switch --detach -q "$fixture_binding_commit"

printf '%s\n' 'next candidate source' \
  >"$version_fixture/Sources/candidate-source.txt"
sed -i '' "s/^build_number=.*/build_number=$next_build/" \
  "$version_fixture/release/VERSION"
sed -i '' '$s/candidate$/retired/' \
  "$version_fixture/release/BUILD-LEDGER.tsv"
printf '%s\t%s\tcandidate\n' "$fixture_version" "$next_build" \
  >>"$version_fixture/release/BUILD-LEDGER.tsv"
git -C "$version_fixture" add \
  Sources/candidate-source.txt \
  release/VERSION \
  release/BUILD-LEDGER.tsv
next_fingerprint="$(
  cd "$version_fixture"
  scripts/release-source-fingerprint
)"
sed -i '' \
  "s/^build_number=.*/build_number=$next_build/" \
  "$version_fixture/release/CURRENT-BUILD-SOURCE"
sed -i '' \
  "s/^source_fingerprint_sha256=.*/source_fingerprint_sha256=$next_fingerprint/" \
  "$version_fixture/release/CURRENT-BUILD-SOURCE"
git -C "$version_fixture" add release/CURRENT-BUILD-SOURCE
git -C "$version_fixture" commit -qm 'test: allocate a higher build'
git -C "$version_fixture" push -q origin HEAD:refs/heads/main
(
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null
) || fail "trial verifier rejected source bound to a higher build"

marketing_version="$(
  cd "$version_fixture"
  scripts/release-version marketing-version
)"
git -C "$version_fixture" tag -a "v${marketing_version}" -m trial-contract
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted an existing exact version tag"
fi
git -C "$version_fixture" tag -d "v${marketing_version}" >/dev/null

sed -i '' '$s/candidate$/retired/' "$version_fixture/release/BUILD-LEDGER.tsv"
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a retired current build"
fi
git -C "$version_fixture" restore release/BUILD-LEDGER.tsv

printf '9.9.9\t99999\tcandidate\n' >>"$version_fixture/release/BUILD-LEDGER.tsv"
if (
  cd "$version_fixture"
  scripts/verify-release-trial-version >/dev/null 2>&1
); then
  fail "trial verifier accepted a current build that is not the ledger tip"
fi

echo "Release pre-tag trial contract passed"
