#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-dmg-evidence-contract.XXXXXX")"
fixture_root="$(cd "$fixture_root" && pwd -P)"

cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT

mkdir -p "$fixture_root/scripts" "$fixture_root/bin" "$fixture_root/dist/Noonmark.app"
cp "$repo_root/scripts/package-dmg" "$fixture_root/scripts/package-dmg"
cp "$repo_root/scripts/verify-dmg" "$fixture_root/scripts/verify-dmg"

: >"$fixture_root/dist/Noonmark.dmg"
: >"$fixture_root/dist/Noonmark.dmg.sha256"
: >"$fixture_root/dist/Noonmark.dmg.manifest"
: >"$fixture_root/dist/Noonmark.dmg.inventory.sha256"

cat >"$fixture_root/scripts/build-mac-app" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

for stale_path in \
  dist/Noonmark.app \
  dist/Noonmark.dmg \
  dist/Noonmark.dmg.sha256 \
  dist/Noonmark.dmg.inventory.sha256; do
  if [[ -e "$stale_path" ]]; then
    echo "package-dmg left stale evidence before build: $stale_path" >&2
    exit 91
  fi
done
if [[ ! -f dist/Noonmark.dmg.manifest ]] ||
  ! grep -Fqx 'suite=package-dmg' dist/Noonmark.dmg.manifest ||
  grep -Fq 'suite_exit_status=' dist/Noonmark.dmg.manifest; then
  echo "package-dmg did not replace the stale manifest with a fresh unfinished run" >&2
  exit 91
fi
if [[ "${NOONMARK_REQUIRE_STABLE_UI_SIGNING:-}" != "1" ]]; then
  echo "package-dmg did not require stable signing for its build" >&2
  exit 92
fi
mkdir -p dist/Noonmark.app/Contents/MacOS
printf 'fixture-production-binary\n' >dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp
chmod +x dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp
printf '<plist/>\n' >dist/Noonmark.app/Contents/Info.plist
SCRIPT
chmod +x "$fixture_root/scripts/build-mac-app"

cp "$repo_root/scripts/evidence-common" "$fixture_root/scripts/evidence-common"
cp \
  "$repo_root/scripts/verify-development-validation-evidence" \
  "$fixture_root/scripts/verify-development-validation-evidence"
cp \
  "$repo_root/scripts/runtime-evidence" \
  "$fixture_root/scripts/runtime-evidence"
cp \
  "$repo_root/scripts/verify-english-screenshot-content.swift" \
  "$fixture_root/scripts/verify-english-screenshot-content.swift"
chmod +x "$fixture_root/scripts/verify-development-validation-evidence"

cat >"$fixture_root/bin/ditto" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
cp -R "$1" "$2"
SCRIPT
chmod +x "$fixture_root/bin/ditto"

cat >"$fixture_root/bin/hdiutil" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
mode="$1"
shift
if [[ "$mode" != "create" ]]; then
  if [[ "$mode" == "attach" ]]; then
    dmg_path="$1"
    mountpoint=""
    while [[ "$#" -gt 0 ]]; do
      if [[ "$1" == "-mountpoint" ]]; then
        mountpoint="$2"
        break
      fi
      shift
    done
    [[ -n "$mountpoint" ]]
    cp -R "${dmg_path}.mount/." "$mountpoint/"
    exit 0
  fi
  if [[ "$mode" == "detach" ]]; then
    exit 0
  fi
  echo "unexpected fixture hdiutil mode: $mode" >&2
  exit 93
fi
srcfolder=""
arguments=("$@")
for ((index = 0; index < ${#arguments[@]}; index += 1)); do
  if [[ "${arguments[$index]}" == "-srcfolder" ]]; then
    srcfolder="${arguments[$((index + 1))]}"
  fi
done
dmg_path="${arguments[$((${#arguments[@]} - 1))]}"
[[ -n "$srcfolder" ]]
rm -rf "${dmg_path}.mount"
mkdir -p "${dmg_path}.mount"
cp -R "$srcfolder/." "${dmg_path}.mount/"
printf 'fixture-dmg\n' >"$dmg_path"
SCRIPT
chmod +x "$fixture_root/bin/hdiutil"

cat >"$fixture_root/bin/codesign" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${FIXTURE_CODESIGN_LOG:?}"
target="${@: -1}"
case "$target" in
  *NoonmarkMacAppE2E.app) identifier="app.noonmark.mac.e2e" ;;
  *NoonmarkDMGInstallHarness.app)
    identifier="app.noonmark.test.dmg-install-harness"
    ;;
  *) identifier="app.noonmark.mac" ;;
esac
case " $* " in
  *" --verify "*) exit 0 ;;
  *" --display --verbose=4 "*)
    cat <<DETAILS
Identifier=$identifier
TeamIdentifier=FIXTURETEAM
Authority=Apple Development: Fixture
Signature=Developer
DETAILS
    ;;
  *" --display --requirements - "*)
    printf 'designated => identifier "%s" and anchor apple generic\n' \
      "$identifier"
    ;;
  *" --display --extract-certificates="*)
    certificate_prefix="${2#*=}"
    printf 'fixture-certificate\n' >"${certificate_prefix}0"
    ;;
  *) echo "unexpected fixture codesign invocation: $*" >&2; exit 94 ;;
esac
SCRIPT
chmod +x "$fixture_root/bin/codesign"

cat >"$fixture_root/bin/plutil" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == "-extract" && "$2" == "CFBundleExecutable" ]]; then
  case "${@: -1}" in
    *NoonmarkMacAppE2E.app/*) echo "NoonmarkMacAppE2E" ;;
    *NoonmarkDMGInstallHarness.app/*) echo "NoonmarkDMGInstallHarness" ;;
    *) echo "NoonmarkMacApp" ;;
  esac
  exit 0
fi
echo "unexpected fixture plutil invocation: $*" >&2
exit 95
SCRIPT
chmod +x "$fixture_root/bin/plutil"

for verifier in test-app-icon-bundle verify-mac-app-metadata; do
  cat >"$fixture_root/scripts/$verifier" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
[[ -d "$1" ]]
SCRIPT
  chmod +x "$fixture_root/scripts/$verifier"
done

cat >"$fixture_root/.gitignore" <<'EOF'
dist/
artifacts/
*.log
*.stdout
*.stderr
EOF
(
  cd "$fixture_root"
  git init -q
  git config user.name "Noonmark Evidence Fixture"
  git config user.email "fixture@noonmark.invalid"
  git add .
  git commit -qm "fixture"
)

set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
  NOONMARK_EVIDENCE_RUN_ID="fixture-run" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/package-dmg release
) >"$fixture_root/package.stdout" 2>"$fixture_root/package.stderr"
package_status=$?
set -e

if [[ "$package_status" -ne 0 ]]; then
  echo "package-dmg violated its pre-build clean/signing contract (status=$package_status)" >&2
  cat "$fixture_root/package.stderr" >&2
  [[ ! -f "$fixture_root/codesign.log" ]] || cat "$fixture_root/codesign.log" >&2
  exit 1
fi

if [[ ! -s "$fixture_root/dist/Noonmark.dmg.manifest" ]]; then
  echo "package-dmg did not emit a provenance manifest beside the DMG" >&2
  exit 1
fi

for requirement in \
  "evidence_schema_version=1" \
  "evidence_run_id=fixture-run" \
  "suite=package-dmg" \
  "configuration=release" \
  "suite_mode=full" \
  "app_codesign_team_identifier=FIXTURETEAM" \
  "app_codesign_deep_strict=1" \
  "app_stable_required=1" \
  "suite_exit_status=0"; do
  if ! grep -Fqx "$requirement" "$fixture_root/dist/Noonmark.dmg.manifest"; then
    echo "package manifest is missing $requirement" >&2
    cat "$fixture_root/dist/Noonmark.dmg.manifest" >&2
    exit 1
  fi
done
if ! grep -Eq '^source_worktree_tree_oid=[0-9a-f]{40}$' \
  "$fixture_root/dist/Noonmark.dmg.manifest"; then
  echo "package manifest lacks the exact Git worktree tree OID" >&2
  cat "$fixture_root/dist/Noonmark.dmg.manifest" >&2
  exit 1
fi

if ! grep -Eq -- \
  '^--verify --deep --strict .*/Noonmark\.app$' \
  "$fixture_root/codesign.log"; then
  echo "verify-dmg did not run deep strict signature verification on the mounted app" >&2
  cat "$fixture_root/codesign.log" >&2 2>/dev/null || true
  exit 1
fi

cp \
  "$fixture_root/dist/Noonmark.dmg.manifest" \
  "$fixture_root/dist/Noonmark.dmg.manifest.valid"
sed -i '' \
  's/^app_binary_sha256=.*/app_binary_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff/' \
  "$fixture_root/dist/Noonmark.dmg.manifest"
set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/verify-dmg dist/Noonmark.dmg
) >"$fixture_root/verify-tampered.stdout" 2>"$fixture_root/verify-tampered.stderr"
tampered_status=$?
set -e
if [[ "$tampered_status" -eq 0 ]]; then
  echo "verify-dmg accepted a mounted binary that disagreed with the package manifest" >&2
  exit 1
fi
mv \
  "$fixture_root/dist/Noonmark.dmg.manifest.valid" \
  "$fixture_root/dist/Noonmark.dmg.manifest"

export FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log"
export PATH="$fixture_root/bin:$PATH"
mkdir -p \
  "$fixture_root/artifacts/e2e-runtime" \
  "$fixture_root/artifacts/e2e-data-root-process-lease" \
  "$fixture_root/artifacts/dmg-install/diagnostics" \
  "$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkMacAppE2E.app/Contents/MacOS" \
  "$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app/Contents/MacOS" \
  "$fixture_root/artifacts/e2e-data-root-process-lease/app-snapshot" \
  "$fixture_root/artifacts/dmg-install/Applications" \
  "$fixture_root/artifacts/dmg-install-harness"
printf 'fixture\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/summary.txt"
printf 'runtime_evidence_capture_started=fixture\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/unified.log"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-runtime/diagnostic-result.txt"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-runtime/helper-diagnostic-result.txt"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/diagnostic-result.txt"
printf 'runtime_evidence_capture_started=fixture\n' \
  >"$fixture_root/artifacts/e2e-runtime/unified.log"
cat >"$fixture_root/artifacts/e2e-runtime/runtime-manifest.txt" <<'EOF'
process=NoonmarkMacAppE2E
bundle=dist/NoonmarkMacAppE2E.app
started_at=2026-07-17T00:00:00Z
finished_at=2026-07-17T00:00:01Z
suite_exit_status=0
EOF
for diagnostic in \
  diagnostic-baseline.txt \
  diagnostic-baseline.txt.current \
  diagnostic-baseline.txt.new \
  helper-diagnostic-baseline.txt \
  helper-diagnostic-baseline.txt.current \
  helper-diagnostic-baseline.txt.new; do
  : >"$fixture_root/artifacts/e2e-runtime/$diagnostic"
done
for diagnostic in \
  diagnostic-baseline.txt \
  diagnostic-baseline.txt.current \
  diagnostic-baseline.txt.new; do
  : >"$fixture_root/artifacts/e2e-data-root-process-lease/$diagnostic"
done
for diagnostic in \
  noonmark-baseline.txt \
  noonmark-final.txt \
  noonmark-diff.txt \
  harness-baseline.txt \
  harness-final.txt \
  harness-diff.txt; do
  : >"$fixture_root/artifacts/dmg-install/diagnostics/$diagnostic"
done
printf 'fixture-e2e-binary\n' \
  >"$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkMacAppE2E.app/Contents/MacOS/NoonmarkMacAppE2E"
printf '<plist/>\n' \
  >"$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkMacAppE2E.app/Contents/Info.plist"
chmod +x \
  "$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkMacAppE2E.app/Contents/MacOS/NoonmarkMacAppE2E"
cp -R \
  "$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkMacAppE2E.app" \
  "$fixture_root/artifacts/e2e-data-root-process-lease/app-snapshot/NoonmarkMacAppE2E.app"
printf 'fixture-helper-binary\n' \
  >"$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app/Contents/MacOS/NoonmarkDMGInstallHarness"
printf '<plist/>\n' \
  >"$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app/Contents/Info.plist"
chmod +x \
  "$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app/Contents/MacOS/NoonmarkDMGInstallHarness"
cp -R \
  "$fixture_root/dist/Noonmark.app" \
  "$fixture_root/artifacts/dmg-install/Applications/Noonmark.app"
cp -R \
  "$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app" \
  "$fixture_root/artifacts/dmg-install-harness/NoonmarkDMGInstallHarness.app"
for install_screenshot in \
  installed-day.png \
  installed-exercise-before-input.png \
  installed-restart.png; do
  cp \
    "$repo_root/App/NoonmarkMacApp/Resources/AppIcon-master.png" \
    "$fixture_root/artifacts/dmg-install/$install_screenshot"
done
cat >"$fixture_root/artifacts/dmg-install/permission-preflight-ledger.tsv" <<'EOF'
2026-07-17T00:00:00Z	PASS	arguments	mode=preflight
2026-07-17T00:00:00Z	PASS	process	mode=preflight helper_pid=101 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE
2026-07-17T00:00:00Z	PASS	exit-observer	helper_pid=101 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE observer=EVFILT_PROC+NOTE_EXITSTATUS
2026-07-17T00:00:00Z	PASS	permissions	AXIsProcessTrusted=true CGPreflightPostEventAccess=true
2026-07-17T00:00:00Z	PASS	complete	mode=preflight
EOF
cat >"$fixture_root/artifacts/dmg-install/exercise-ledger.tsv" <<EOF
2026-07-17T00:00:01Z	PASS	arguments	mode=exercise pid=201 app=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app
2026-07-17T00:00:01Z	PASS	process	mode=exercise helper_pid=202 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-FFFFFFFFFFFF
2026-07-17T00:00:01Z	PASS	exit-observer	helper_pid=202 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-FFFFFFFFFFFF observer=EVFILT_PROC+NOTE_EXITSTATUS
2026-07-17T00:00:01Z	PASS	permissions	AXIsProcessTrusted=true CGPreflightPostEventAccess=true
2026-07-17T00:00:01Z	PASS	target	bundle=app.noonmark.mac path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app frontmost=true windows=1
2026-07-17T00:00:01Z	PASS	main-window	native AXWindow is visible
2026-07-17T00:00:01Z	PASS	settings-menu	title=设置… shortcut=Command-,
2026-07-17T00:00:01Z	PASS	settings-window	independent=true window=(0.0, 432.0, 820.0, 720.0) sidebar=(0.0, 484.0, 240.0, 668.0) content=(241.0, 484.0, 579.0, 668.0)
2026-07-17T00:00:01Z	PASS	settings-close	closed with real WindowServer click
2026-07-17T00:00:01Z	PASS	quick-entry-menu	title=快速记录… shortcut=Command-n
2026-07-17T00:00:01Z	PASS	quick-entry-input	value=dmgproductiontask source=cghidEventTap
2026-07-17T00:00:01Z	PASS	quick-entry-add	panel dismissed after real click
2026-07-17T00:00:01Z	PASS	exercise-title-visible	title=dmgproductiontask visibleAXMatches=2
2026-07-17T00:00:01Z	PASS	quit-menu	title=退出晷迹 shortcut=Command-q
2026-07-17T00:00:01Z	PASS	quit	terminated via real App menu click
2026-07-17T00:00:01Z	PASS	complete	mode=exercise
EOF
cat >"$fixture_root/artifacts/dmg-install/restart-ledger.tsv" <<EOF
2026-07-17T00:00:02Z	PASS	arguments	mode=restart pid=301 app=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app
2026-07-17T00:00:02Z	PASS	process	mode=restart helper_pid=302 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-111111111111
2026-07-17T00:00:02Z	PASS	exit-observer	helper_pid=302 launch_token=AAAAAAAA-BBBB-CCCC-DDDD-111111111111 observer=EVFILT_PROC+NOTE_EXITSTATUS
2026-07-17T00:00:02Z	PASS	permissions	AXIsProcessTrusted=true CGPreflightPostEventAccess=true
2026-07-17T00:00:02Z	PASS	target	bundle=app.noonmark.mac path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app frontmost=true windows=1
2026-07-17T00:00:02Z	PASS	main-window	native AXWindow is visible
2026-07-17T00:00:02Z	PASS	restart-title-visible	title=dmgproductiontask visibleAXMatches=1
2026-07-17T00:00:02Z	PASS	quit-menu	title=退出晷迹 shortcut=Command-q
2026-07-17T00:00:02Z	PASS	quit	terminated via real App menu click
2026-07-17T00:00:02Z	PASS	complete	mode=restart
EOF
cat >"$fixture_root/artifacts/dmg-install/installed-exercise-window.txt" <<EOF
phase=production exercise
pid=201
bundle_identifier=app.noonmark.mac
bundle_path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app
executable_path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app/Contents/MacOS/NoonmarkMacApp
window_id=401
natural_day=2026-07-17
title=晷迹 · Day Todo — 7月17日
screenshot=$fixture_root/artifacts/dmg-install/installed-exercise-before-input.png
pixel_size=1024x1024
EOF
cat >"$fixture_root/artifacts/dmg-install/installed-restart-window.txt" <<EOF
phase=production restart
pid=301
bundle_identifier=app.noonmark.mac
bundle_path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app
executable_path=$fixture_root/artifacts/dmg-install/Applications/Noonmark.app/Contents/MacOS/NoonmarkMacApp
window_id=402
natural_day=2026-07-17
title=晷迹 · Day Todo — 7月17日
screenshot=$fixture_root/artifacts/dmg-install/installed-restart.png
pixel_size=1024x1024
EOF
fixture_process_timestamp="$(
  /bin/date -r "$(
    /bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' \
      '2026-07-17T12:00:00Z' '+%s'
  )" '+%Y-%m-%d %H:%M:%S'
)"
fixture_restart_process_timestamp="$(
  /bin/date -r "$(
    /bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' \
      '2026-07-17T12:00:02Z' '+%s'
  )" '+%Y-%m-%d %H:%M:%S'
)"
cat >"$fixture_root/artifacts/dmg-install/exercise-console.log" <<EOF
runtime_evidence_capture_started=2026-07-17T12:00:00Z
$fixture_process_timestamp.100 I  CoreServicesUIAgent[51:abc] [com.apple.launchservices:cas] notifying server side, pid=201 appInfo={ "CFBundleExecutablePath"="$fixture_root/artifacts/dmg-install/Applications/Noonmark.app/Contents/MacOS/NoonmarkMacApp", "CFBundleIdentifier"="app.noonmark.mac", "LSAuditToken"=\$0000000000000000000000000000000000000000C90000000000000000000000, "LSBundlePath"="$fixture_root/artifacts/dmg-install/Applications/Noonmark.app" }
$fixture_process_timestamp.200 I  NoonmarkMacApp[201:def] [com.apple.launchservices:cas] fixture process launch
EOF
cat >"$fixture_root/artifacts/dmg-install/restart-console.log" <<EOF
runtime_evidence_capture_started=2026-07-17T12:00:01Z
$fixture_restart_process_timestamp.300 I  CoreServicesUIAgent[51:abc] [com.apple.launchservices:cas] notifying server side, pid=301 appInfo={ "CFBundleExecutablePath"="$fixture_root/artifacts/dmg-install/Applications/Noonmark.app/Contents/MacOS/NoonmarkMacApp", "CFBundleIdentifier"="app.noonmark.mac", "LSAuditToken"=\$00000000000000000000000000000000000000002D0100000000000000000000, "LSBundlePath"="$fixture_root/artifacts/dmg-install/Applications/Noonmark.app" }
$fixture_restart_process_timestamp.400 I  NoonmarkMacApp[301:def] [com.apple.launchservices:cas] fixture process restart
EOF
cat >"$fixture_root/artifacts/dmg-install/task-row-before-restart.txt" <<'EOF'
integrity_check=ok
identity=AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE	BBBBBBBB-CCCC-DDDD-EEEE-FFFFFFFFFFFF	CCCCCCCC-DDDD-EEEE-FFFF-000000000000	2026-07-17	pending	active	1	dmgproductiontask
joined_row={"trace":{"id":"AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE","chain_id":"BBBBBBBB-CCCC-DDDD-EEEE-FFFFFFFFFFFF","definition_id":"CCCCCCCC-DDDD-EEEE-FFFF-000000000000","date":"2026-07-17","status":"pending","priority":1},"chain":{"id":"BBBBBBBB-CCCC-DDDD-EEEE-FFFFFFFFFFFF","state":"active"},"definition":{"id":"CCCCCCCC-DDDD-EEEE-FFFF-000000000000","chain_id":"BBBBBBBB-CCCC-DDDD-EEEE-FFFFFFFFFFFF","sequence":1,"title":"dmgproductiontask"}}
EOF
cp \
  "$fixture_root/artifacts/dmg-install/task-row-before-restart.txt" \
  "$fixture_root/artifacts/dmg-install/task-row-after-restart.txt"
cat >"$fixture_root/artifacts/dmg-install/task-identity.tsv" <<'EOF'
trace_id	chain_id	definition_id	date	trace_status	chain_state	definition_sequence	title
AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE	BBBBBBBB-CCCC-DDDD-EEEE-FFFFFFFFFFFF	CCCCCCCC-DDDD-EEEE-FFFF-000000000000	2026-07-17	pending	active	1	dmgproductiontask
EOF
empty_sha256="$(
  shasum -a 256 \
    "$fixture_root/artifacts/dmg-install/diagnostics/noonmark-baseline.txt" |
    awk '{print $1}'
)"

app_binary_sha256="$(
  awk -F= '$1 == "app_binary_sha256" { print $2 }' \
    "$fixture_root/dist/Noonmark.dmg.manifest"
)"
dmg_sha256="$(
  awk -F= '$1 == "dmg_sha256" { print $2 }' \
    "$fixture_root/dist/Noonmark.dmg.manifest"
)"
dmg_checksum_sha256="$(
  awk -F= '$1 == "dmg_checksum_sha256" { print $2 }' \
    "$fixture_root/dist/Noonmark.dmg.manifest"
)"
package_manifest_sha256="$(
  shasum -a 256 "$fixture_root/dist/Noonmark.dmg.manifest" | awk '{print $1}'
)"
source_head_commit="$(awk -F= '$1 == "source_head_commit" { print $2 }' "$fixture_root/dist/Noonmark.dmg.manifest")"
source_head_tree_oid="$(awk -F= '$1 == "source_head_tree_oid" { print $2 }' "$fixture_root/dist/Noonmark.dmg.manifest")"
source_worktree_tree_oid="$(awk -F= '$1 == "source_worktree_tree_oid" { print $2 }' "$fixture_root/dist/Noonmark.dmg.manifest")"
source_tree_dirty="$(awk -F= '$1 == "source_tree_dirty" { print $2 }' "$fixture_root/dist/Noonmark.dmg.manifest")"
codesign_identity_sha1="$(awk -F= '$1 == "app_codesign_identity_sha1" { print $2 }' "$fixture_root/dist/Noonmark.dmg.manifest")"
