  "$notes_copy"; then
  echo 'Notes user copy reintroduced a retired product name' >&2
  exit 1
fi

if /usr/bin/grep -Eq \
  'IdeaPinnedSectionHeader|ideasPinnedSectionTitle|identifier: "ideas\.pinned"' \
  "$flylight_page" "$notes_copy"; then
  echo 'Flylight reintroduced a separate pinned collection' >&2
  exit 1
fi

if /usr/bin/grep -Eq \
  'StickyNotePresentationControl|sticky-notes\.mode\.\\\(mode\.rawValue\\\)|ideas\.layout|private struct IdeaInspector' \
  "$sticky_page" "$flylight_page"; then
  echo 'Notes UI retained the old segmented mode control or embedded Flylight rail' >&2
  exit 1
fi

if /usr/bin/grep -Eq \
  'pinnedSectionAboveTimeline|pinnedSectionUsesDayHeaderTypography|ideaCardPinAction|ideaCardUnpinAction|trashSectionCollapsedByDefault|trashRestoreRequiresNewBody|pinnedSectionFloatsAboveTimeline|trashCollapsedByDefault|trashHasNoHardDelete' \
  "$ui_contract"; then
  echo 'Mac UI contract reintroduced retired Flylight pinned or trash UI' >&2
  exit 1
fi

if /usr/bin/grep -Eq \
  'MemoTrashPage|IdeaTrashRow|IdeaRestoreComposer|sidebar\.nav\.memoTrash|ideas\.trash\.(restore|toggle)|ideasTrashSectionTitle|ideaRestore|beginIdeaRestore|commitIdeaRestore|ideaTrashItems|restoringIdeaID' \
  "$flylight_page" "$sidebar" "$notes_copy" "$store" "$store_ideas"; then
  echo 'Flylight trash or restore UI became user reachable' >&2
  exit 1
fi

if /usr/bin/grep -Fq 'value: isExpanded' "$flylight_composer"; then
  echo 'Flylight composer reintroduced unsafe whole-surface expansion animation' >&2
  exit 1
fi

echo 'Notes navigation, Flylight source, Sticky Note modes, hidden tombstones, composer geometry, and Markdown contract passed'
