            "const majorActivity=['run-contract','stop-condition','run-failed','run-cancelled'].includes(entry.dataset.activityType);"
            "const role=entry.dataset.kind==='checkpoint'?'checkpoint':['correction','invalidation'].includes(entry.dataset.kind)?'history-boundary':"
            "entry.dataset.artifactType==='receipt'?'receipt':majorActivity?'system-boundary':actor;"
            "const lane=['checkpoint','history-boundary','receipt','system-boundary'].includes(role)?'full':role;"
            "const milestone=role==='checkpoint'?'共同决策点':role==='history-boundary'?'历史边界':role==='receipt'?'结果回执':"
            "role==='system-boundary'&&['stop-condition','run-failed','run-cancelled'].includes(entry.dataset.activityType)?'运行边界':"
            "role==='system-boundary'?'系统边界':'';return {role,lane,milestone}};"
            "const mismatches=entries.map((entry)=>({id:entry.dataset.nodeId,actual:{role:entry.dataset.wovenRole,lane:entry.dataset.wovenLane,milestone:entry.dataset.wovenMilestone||''},expected:expected(entry)}))"
            ".filter((item)=>JSON.stringify(item.actual)!==JSON.stringify(item.expected));"
            "return {labels:[...document.querySelectorAll('.woven-labels>span')].map((label)=>label.innerText),"
            "zhulongCount:zhulong.length,userCount:user.length,fullCount:full.length,"
            "systemOnZhulong:zhulong.filter((entry)=>entry.classList.contains('actor-system')).length,"
            "zhulongActorsValid:zhulong.every((entry)=>!entry.classList.contains('actor-user')),"
            "userActorsValid:user.every((entry)=>entry.classList.contains('actor-user')),"
            "zhulongLeft:zhulong.every((entry)=>cardBox(entry).right<=spineCenter(entry)+1),"
            "userRight:user.every((entry)=>cardBox(entry).left>=spineCenter(entry)-1),"
            "fullSpans:full.every((entry)=>Math.abs(cardBox(entry).left-entryBox(entry).left)<=1&&Math.abs(cardBox(entry).right-entryBox(entry).right)<=1),"
            "fullRoles:full.map((entry)=>entry.dataset.wovenRole),"
            "checkpointRoles:entries.filter((entry)=>entry.dataset.kind==='checkpoint').map((entry)=>entry.dataset.wovenRole),"
            "mismatches,"
            "compactUser:document.querySelector('.woven-entry.lane-user.is-compact-user')?.dataset.nodeId||'',"
            "compactToggle:Boolean(document.querySelector('.woven-entry.lane-user.is-compact-user [data-action=\"toggle-entry\"]'))};})()"
        )
        self.check(
            "variant-c-is-a-stable-left-zhulong-right-user-dual-track-with-major-full-width-records",
            c_semantics["labels"] == ["烛龙\n分析、选项与执行", "你\n决定与授权"]
            and c_semantics["zhulongCount"] > 0
            and c_semantics["userCount"] > 0
            and c_semantics["fullCount"] > 0
            and c_semantics["systemOnZhulong"] > 0
            and c_semantics["zhulongActorsValid"]
            and c_semantics["userActorsValid"]
            and c_semantics["zhulongLeft"]
            and c_semantics["userRight"]
            and c_semantics["fullSpans"]
            and set(c_semantics["fullRoles"]).issubset({"checkpoint", "history-boundary", "receipt", "system-boundary"})
            and c_semantics["checkpointRoles"]
            and set(c_semantics["checkpointRoles"]) == {"checkpoint"}
            and not c_semantics["mismatches"]
            and bool(c_semantics["compactUser"])
            and c_semantics["compactToggle"],
            json.dumps(c_semantics, ensure_ascii=False, sort_keys=True),
        )
        compact_user_snapshot = self.snapshot()
        compact_user_height = self.evaluate(
            f"document.getElementById({json.dumps(c_semantics['compactUser'])}).getBoundingClientRect().height"
        )
        self.click(
            f'#{c_semantics["compactUser"]} [data-action="toggle-entry"]'
        )
        expanded_user = self.evaluate(
            f"(() => {{const entry=document.getElementById({json.dumps(c_semantics['compactUser'])});return {{"
            "compact:entry.classList.contains('is-compact-user'),height:entry.getBoundingClientRect().height,"
            "expanded:entry.querySelector('[data-action=\"toggle-entry\"]')?.getAttribute('aria-expanded')};})()"
        )
        self.check(
            "variant-c-long-user-decision-can-expand-without-changing-session",
            self.snapshot() == compact_user_snapshot
            and not expanded_user["compact"]
            and expanded_user["height"] > compact_user_height
            and expanded_user["expanded"] == "true",
            json.dumps(expanded_user, sort_keys=True),
        )

        self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');"
            "const target=[...document.querySelectorAll('.woven-entry[data-activity-type=\"long-fixture\"]')][7];"
            "const scrollerBox=scroller.getBoundingClientRect();const targetBox=target.getBoundingClientRect();"
            "scroller.style.scrollBehavior='auto';scroller.scrollTop+=targetBox.top-scrollerBox.top;"
            "window.__layoutScroller=scroller;return target.dataset.nodeId;})()"
        )
        layout_wheel_point = self.evaluate(
            "(() => {const box=document.querySelector('[data-stream-scroll]').getBoundingClientRect();"
            "return {x:box.left+box.width/2,y:box.top+box.height/2};})()"
        )
        self.cdp.command(
            "Input.dispatchMouseEvent",
            {"type": "mouseWheel", "x": layout_wheel_point["x"], "y": layout_wheel_point["y"], "deltaX": 0, "deltaY": 82},
