#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

configuration="${1:-debug}"
if [[ "${1:-}" == "--contract" && "$#" -eq 1 ]]; then
  cat <<'EOF'
surface=day-title
input_source=com.tencent.inputmethod.wetype.pinyin
behavior=composition-commit,immediate-exit,restart-sqlite-readback
unavailable_input_source=skip-with-auditable-evidence
EOF
  exit 0
fi
if [[ "$#" -gt 1 ]]; then
  echo "usage: scripts/test-tencent-ime-release-smoke [debug|release] | --contract" >&2
  exit 64
fi
case "$configuration" in
  debug | release) ;;
  *)
    echo "unsupported Tencent IME smoke configuration: $configuration" >&2
    exit 64
    ;;
esac

source scripts/evidence-common

evidence_relative="artifacts/e2e-tencent-ime-release-smoke"
evidence_root="$repo_root/$evidence_relative"
manifest="$evidence_root/manifest.txt"
inventory="$evidence_root/artifact-inventory.sha256"
source_start="$evidence_root/source-start.fragment"
source_end="$evidence_root/source-end.fragment"
summary_relative="artifacts/e2e-tencent-ime-termination/results.tsv"
summary_path="$repo_root/$summary_relative"
evidence_run_id="${NOONMARK_EVIDENCE_RUN_ID:-$(date -u '+%Y%m%dT%H%M%SZ')-$$}"
suite_status=0

tencent_input_source_is_enabled() {
  /usr/bin/defaults read com.apple.HIToolbox AppleEnabledInputSources 2>/dev/null |
    rg -Fq "com.tencent.inputmethod.wetype.pinyin"
}

if tencent_input_source_is_enabled; then
  input_source_available=true
  suite_mode=full
else
  input_source_available=false
  suite_mode=skipped
fi

evidence_prepare_fresh_directory "$repo_root" "$evidence_relative"
evidence_capture_source "$repo_root" source "$source_start"
evidence_begin_manifest \
  "$manifest" \
  "tencent-ime-release-smoke" \
  "$evidence_run_id" \
  "$configuration" \
  "$suite_mode"
evidence_append_snapshot "$manifest" "$source_start"
evidence_append "$manifest" input_source_available "$input_source_available"

if [[ "$input_source_available" == "false" ]]; then
  skip_relative="$evidence_relative/result.txt"
  skip_path="$repo_root/$skip_relative"
  printf 'status=SKIPPED\nreason=tencent_input_source_not_enabled\n' >"$skip_path"
  evidence_append "$manifest" skip_reason tencent_input_source_not_enabled
  evidence_capture_source "$repo_root" source_end "$source_end"
  evidence_append_snapshot "$manifest" "$source_end"
  evidence_append "$manifest" result_path "$skip_relative"
  evidence_append \
    "$manifest" \
    result_sha256 \
    "$(shasum -a 256 "$skip_path" | awk '{print $1}')"
  evidence_inventory \
    "$repo_root" \
    "$inventory" \
    "$skip_path" \
    "$source_start" \
    "$source_end"
  evidence_append \
    "$manifest" \
    artifact_inventory_sha256 \
    "$(shasum -a 256 "$inventory" | awk '{print $1}')"
  evidence_finish_manifest \
    "$manifest" \
    0 \
    source_head_commit \
    source_worktree_tree_oid \
    source_end_worktree_tree_oid \
    input_source_available \
    skip_reason \
    result_path \
    result_sha256 \
    artifact_inventory_sha256
  echo "Tencent IME release smoke skipped: input source is not enabled"
  exit 0
fi

evidence_append "$manifest" skip_reason none

# The release criterion is one stable user promise, not the whole coverage
# catalog: real Tencent composition commits exact text, the app exits while the
# autosave is pending, then the restarted App and SQLite agree on that text.
if ! NOONMARK_TENCENT_IME_TERMINATION_SURFACES=day-title \
  NOONMARK_TENCENT_IME_SKIP_FAILURE_RETRY=1 \
  scripts/test-tencent-ime-termination-persistence "$configuration"; then
  suite_status=1
fi

if [[ "$suite_status" -eq 0 ]] && ! awk -F $'\t' '
  NR == 1 { next }
  $1 == "day-title" {
    count += 1
    if ($2 == "PASS" && $4 == "false" && $5 == "true" && $6 == "true") {
      passed = 1
    }
  }
  END { exit(count == 1 && passed ? 0 : 1) }
' "$summary_path"; then
  echo "Tencent IME release smoke did not prove the day-title restart path" >&2
  suite_status=1
fi

evidence_capture_source "$repo_root" source_end "$source_end"
evidence_append_snapshot "$manifest" "$source_end"
evidence_append "$manifest" result_path "$summary_relative"
if [[ -s "$summary_path" ]]; then
  evidence_append \
    "$manifest" \
    result_sha256 \
    "$(shasum -a 256 "$summary_path" | awk '{print $1}')"
else
  evidence_append "$manifest" result_sha256 missing
  suite_status=1
fi
if evidence_inventory \
  "$repo_root" \
  "$inventory" \
  "$summary_path" \
  "$source_start" \
  "$source_end"; then
  evidence_append \
    "$manifest" \
    artifact_inventory_sha256 \
    "$(shasum -a 256 "$inventory" | awk '{print $1}')"
else
  suite_status=1
fi
if ! evidence_finish_manifest \
  "$manifest" \
  "$suite_status" \
  source_head_commit \
  source_worktree_tree_oid \
  source_end_worktree_tree_oid \
  result_path \
  result_sha256 \
  artifact_inventory_sha256; then
  suite_status=1
fi

if [[ "$suite_status" -ne 0 ]]; then
  exit "$suite_status"
fi

echo "Tencent IME release smoke passed: day-title composition, exit, restart"
