  "$package_manifest" \
  "dmg_checksum_sha256" \
  "$install_manifest" \
  "dmg_checksum_sha256" \
  "DMG checksum file SHA-256"

actual_package_manifest_sha256="$(
  shasum -a 256 "$package_manifest" | awk '{print $1}'
)"
recorded_package_manifest_sha256="$(
  evidence_read "$install_manifest" "package_manifest_sha256"
)"
if [[ "$actual_package_manifest_sha256" != \
  "$recorded_package_manifest_sha256" ]]; then
  echo "install evidence does not bind the exact package manifest" >&2
  exit 1
fi

