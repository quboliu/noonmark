#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-dmg-evidence-contract.XXXXXX")"
fixture_root="$(cd "$fixture_root" && pwd -P)"
source "$repo_root/scripts/diagnostic-scope-manifest"
source "$repo_root/scripts/diagnostic-lock-evidence"
source "$repo_root/scripts/dmg-harness-evidence"

cleanup() {
  rm -rf "$fixture_root"
}
trap cleanup EXIT

swift build --product NoonmarkDMGInstallHarness >/dev/null
harness_bin_directory="$(swift build --show-bin-path)"
real_harness_binary="$harness_bin_directory/NoonmarkDMGInstallHarness"
if [[ ! -x "$real_harness_binary" ]]; then
  echo "DMG evidence contract could not build the real install harness" >&2
  exit 1
fi

mkdir -p \
  "$fixture_root/scripts" \
  "$fixture_root/bin" \
  "$fixture_root/dist/Noonmark.app" \
  "$fixture_root/Tools/NoonmarkEvidencePathHelper" \
  "$fixture_root/Tools/NoonmarkEvidenceBootstrapCustodian"
cp "$repo_root/scripts/package-dmg" "$fixture_root/scripts/package-dmg"
cp "$repo_root/scripts/verify-dmg" "$fixture_root/scripts/verify-dmg"
cp \
  "$repo_root/scripts/diagnostic-scope-manifest" \
  "$fixture_root/scripts/diagnostic-scope-manifest"
cp \
  "$repo_root/scripts/diagnostic-lock-evidence" \
  "$fixture_root/scripts/diagnostic-lock-evidence"
cp \
  "$repo_root/scripts/dmg-harness-evidence" \
  "$fixture_root/scripts/dmg-harness-evidence"
cp \
  "$repo_root/scripts/dmg-harness-ledger-contract.tsv" \
  "$fixture_root/scripts/dmg-harness-ledger-contract.tsv"
cp \
  "$repo_root/scripts/dmg-install-observer-common" \
  "$fixture_root/scripts/dmg-install-observer-common"
cp \
  "$repo_root/scripts/verify-window-lookup-boundary" \
  "$fixture_root/scripts/verify-window-lookup-boundary"
chmod +x "$fixture_root/scripts/verify-window-lookup-boundary"

window_boundary_source="$fixture_root/window-boundary-production.c"
window_boundary_binary="$fixture_root/scripts/window-boundary-production-binary"
cat >"$window_boundary_source" <<'SOURCE'
#include <CoreGraphics/CoreGraphics.h>

int main(void) {
  CFArrayRef descriptions =
    CGWindowListCopyWindowInfo(
      kCGWindowListOptionIncludingWindow,
      (CGWindowID)1
    );
  if (descriptions != NULL) CFRelease(descriptions);
  return 0;
}
SOURCE
/usr/bin/xcrun --sdk macosx clang \
  "$window_boundary_source" \
  -framework CoreFoundation \
  -framework CoreGraphics \
  -o "$window_boundary_binary"
rm "$window_boundary_source"

window_boundary_root="$fixture_root/window-boundary-staging"
mkdir -p "$window_boundary_root/Noonmark.app/Contents/MacOS"
cp \
  "$window_boundary_binary" \
  "$window_boundary_root/Noonmark.app/Contents/MacOS/NoonmarkMacApp"
ln -s /Applications "$window_boundary_root/Applications"
"$fixture_root/scripts/verify-window-lookup-boundary" \
  dmg-staging-root \
  "$window_boundary_root"
mkdir -p "$window_boundary_root/NoonmarkDMGInstallHarness.app"
if "$fixture_root/scripts/verify-window-lookup-boundary" \
  dmg-staging-root \
  "$window_boundary_root" >/dev/null 2>&1; then
  echo "DMG staging boundary accepted the install harness" >&2
  exit 1
fi

: >"$fixture_root/dist/Noonmark.dmg"
: >"$fixture_root/dist/Noonmark.dmg.sha256"
: >"$fixture_root/dist/Noonmark.dmg.manifest"
: >"$fixture_root/dist/Noonmark.dmg.inventory.sha256"

cat >"$fixture_root/scripts/build-mac-app" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

for stale_path in \
  dist/Noonmark.app \
  dist/Noonmark.app.dSYM \
  dist/Noonmark.app.dSYM.inventory.sha256 \
  dist/Noonmark.app.release-build-identity \
  dist/Noonmark.dmg \
  dist/Noonmark.dmg.sha256 \
  dist/Noonmark.dmg.inventory.sha256; do
  if [[ -e "$stale_path" ]]; then
    echo "package-dmg left stale evidence before build: $stale_path" >&2
    exit 91
  fi
done
if [[ ! -f dist/Noonmark.dmg.manifest ]] ||
  ! grep -Fqx 'suite=package-dmg' dist/Noonmark.dmg.manifest ||
  grep -Fq 'suite_exit_status=' dist/Noonmark.dmg.manifest; then
  echo "package-dmg did not replace the stale manifest with a fresh unfinished run" >&2
  exit 91
fi
if [[ "${NOONMARK_REQUIRE_STABLE_UI_SIGNING:-}" != "1" ]]; then
  echo "package-dmg did not require stable signing for its build" >&2
  exit 92
fi
mkdir -p dist/Noonmark.app/Contents/MacOS
mkdir -p dist/Noonmark.app.dSYM/Contents/Resources/DWARF
cp \
  scripts/window-boundary-production-binary \
  dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp
chmod +x dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp
printf 'fixture-production-dwarf\n' \
  >dist/Noonmark.app.dSYM/Contents/Resources/DWARF/NoonmarkMacApp
release_build_date="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
release_git_commit="$(git rev-parse --verify HEAD)"
release_linked_sha256="$(
  shasum -a 256 dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp |
    awk '{print $1}'
)"
cat >dist/Noonmark.app/Contents/Info.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>NoonmarkMacApp</string>
  <key>CFBundleDisplayName</key>
  <string>Noonmark</string>
  <key>CFBundleIdentifier</key>
  <string>app.noonmark.mac</string>
  <key>CFBundleName</key>
  <string>Noonmark</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NoonmarkGitCommit</key>
  <string>$release_git_commit</string>
  <key>NoonmarkBuildDate</key>
  <string>$release_build_date</string>
  <key>NoonmarkRuntime</key>
  <string>Swift-native</string>
  <key>NoonmarkMinimumOSVersion</key>
  <string>14.0</string>
  <key>NoonmarkBuildArchitecture</key>
  <string>arm64</string>
  <key>NoonmarkBinaryUUID</key>
  <string>arm64:AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE</string>
  <key>NoonmarkBinarySHA256</key>
  <string>$release_linked_sha256</string>
  <key>NoonmarkBinarySHA256Scope</key>
  <string>linked-before-bundle-signing</string>
</dict>
</plist>
PLIST
cat >dist/Noonmark.app.release-build-identity <<IDENTITY
release_build_identity_schema_version=1
release_build_identity_version=0.1.0
release_build_identity_build=1
release_build_identity_git_commit=$release_git_commit
release_build_identity_build_date=$release_build_date
release_build_identity_runtime=Swift-native
release_build_identity_minimum_os_version=14.0
release_build_identity_architecture=arm64
release_build_identity_binary_uuid_set=arm64:AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE
release_build_identity_binary_sha256=$release_linked_sha256
release_build_identity_binary_sha256_scope=linked-before-bundle-signing
IDENTITY
printf 'fixture-code-signature\n' \
  >>dist/Noonmark.app/Contents/MacOS/NoonmarkMacApp
SCRIPT
chmod +x "$fixture_root/scripts/build-mac-app"

cp "$repo_root/scripts/evidence-common" "$fixture_root/scripts/evidence-common"
cp \
  "$repo_root/scripts/run-evidence-path-helper" \
  "$fixture_root/scripts/run-evidence-path-helper"
cp \
  "$repo_root/Tools/NoonmarkEvidencePathHelper/main.swift" \
  "$fixture_root/Tools/NoonmarkEvidencePathHelper/main.swift"
cp \
  "$repo_root/Tools/NoonmarkEvidenceBootstrapCustodian/main.swift" \
  "$fixture_root/Tools/NoonmarkEvidenceBootstrapCustodian/main.swift"
chmod +x "$fixture_root/scripts/run-evidence-path-helper"
for copied_tool in \
  scripts/evidence-common \
  scripts/run-evidence-path-helper \
  Tools/NoonmarkEvidencePathHelper/main.swift \
  Tools/NoonmarkEvidenceBootstrapCustodian/main.swift; do
  if ! cmp -s "$repo_root/$copied_tool" "$fixture_root/$copied_tool"; then
    echo "DMG fixture changed copied evidence tool bytes: $copied_tool" >&2
    exit 1
  fi
done
cp \
  "$repo_root/scripts/verify-development-validation-evidence" \
  "$fixture_root/scripts/verify-development-validation-evidence"
cp \
  "$repo_root/scripts/development-validation-e2e-inventory" \
  "$fixture_root/scripts/development-validation-e2e-inventory"
cp \
  "$repo_root/scripts/runtime-evidence" \
  "$fixture_root/scripts/runtime-evidence"
cp \
  "$repo_root/scripts/verify-english-screenshot-content.swift" \
  "$fixture_root/scripts/verify-english-screenshot-content.swift"
chmod +x "$fixture_root/scripts/verify-development-validation-evidence"
source "$fixture_root/scripts/development-validation-e2e-inventory"

cat >"$fixture_root/bin/ditto" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
cp -R "$1" "$2"
SCRIPT
chmod +x "$fixture_root/bin/ditto"

cat >"$fixture_root/bin/hdiutil" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
mode="$1"
shift
if [[ "$mode" != "create" ]]; then
  if [[ "$mode" == "attach" ]]; then
    dmg_path="$1"
    mountpoint=""
    while [[ "$#" -gt 0 ]]; do
      if [[ "$1" == "-mountpoint" ]]; then
        mountpoint="$2"
        break
      fi
      shift
    done
    [[ -n "$mountpoint" ]]
    cp -R "${dmg_path}.mount/." "$mountpoint/"
    exit 0
  fi
  if [[ "$mode" == "detach" ]]; then
    exit 0
  fi
  echo "unexpected fixture hdiutil mode: $mode" >&2
  exit 93
fi
srcfolder=""
arguments=("$@")
for ((index = 0; index < ${#arguments[@]}; index += 1)); do
  if [[ "${arguments[$index]}" == "-srcfolder" ]]; then
    srcfolder="${arguments[$((index + 1))]}"
  fi
done
dmg_path="${arguments[$((${#arguments[@]} - 1))]}"
[[ -n "$srcfolder" ]]
rm -rf "${dmg_path}.mount"
mkdir -p "${dmg_path}.mount"
cp -R "$srcfolder/." "${dmg_path}.mount/"
printf 'fixture-dmg\n' >"$dmg_path"
SCRIPT
chmod +x "$fixture_root/bin/hdiutil"

cat >"$fixture_root/bin/codesign" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${FIXTURE_CODESIGN_LOG:?}"
target="${@: -1}"
case "$target" in
  *NoonmarkE2E.app) identifier="app.noonmark.mac.e2e" ;;
  *NoonmarkDMGValidation.app)
    identifier="app.noonmark.mac.dmg-validation"
    ;;
  *NoonmarkDMGInstallHarness.app)
    identifier="app.noonmark.test.dmg-install-harness"
    ;;
  *) identifier="app.noonmark.mac" ;;
esac
case " $* " in
  *" --verify "*) exit 0 ;;
  *" --display --verbose=4 "*)
    cat <<DETAILS
Identifier=$identifier
TeamIdentifier=FIXTURETEAM
Authority=Apple Development: Fixture
Signature=Developer
DETAILS
    ;;
  *" --display --requirements - "*)
    printf 'designated => identifier "%s" and anchor apple generic\n' \
      "$identifier"
    ;;
  *" --display --extract-certificates="*)
    certificate_prefix="${2#*=}"
    printf 'fixture-certificate\n' >"${certificate_prefix}0"
    ;;
  *) echo "unexpected fixture codesign invocation: $*" >&2; exit 94 ;;
esac
SCRIPT
chmod +x "$fixture_root/bin/codesign"

cat >"$fixture_root/bin/plutil" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
exec /usr/bin/plutil "$@"
SCRIPT
chmod +x "$fixture_root/bin/plutil"

cat >"$fixture_root/bin/dwarfdump" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
[[ "$1" == "--uuid" && -f "$2" ]]
printf 'UUID: AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE (arm64) %s\n' "$2"
SCRIPT
chmod +x "$fixture_root/bin/dwarfdump"

cat >"$fixture_root/bin/xcrun" <<SCRIPT
#!/usr/bin/env bash
set -euo pipefail
if [[ "\$1" == "--find" && "\$2" == "dwarfdump" ]]; then
  printf '%s\n' "$fixture_root/bin/dwarfdump"
  exit 0
fi
exec /usr/bin/xcrun "\$@"
SCRIPT
chmod +x "$fixture_root/bin/xcrun"

for verifier in test-app-icon-bundle verify-mac-app-metadata; do
  cat >"$fixture_root/scripts/$verifier" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
[[ -d "$1" ]]
SCRIPT
  chmod +x "$fixture_root/scripts/$verifier"
done

cat >"$fixture_root/.gitignore" <<'EOF'
dist/
artifacts/
*.log
*.stdout
*.stderr
EOF
(
  cd "$fixture_root"
  git init -q
  git config user.name "Noonmark Evidence Fixture"
  git config user.email "fixture@noonmark.invalid"
  git add .
  git commit -qm "fixture"
)

# All validators in this fixture belong to one top-level run. Keep one
# descriptor-bound helper session across their child shells so the large
# negative matrix compiles the helper exactly once.
source "$fixture_root/scripts/evidence-common"
evidence_path_helper_session_start
export NOONMARK_EVIDENCE_HELPER_SESSION_ACTIVE
export NOONMARK_EVIDENCE_HELPER_SESSION_PID
export NOONMARK_EVIDENCE_HELPER_SESSION_ROOT

set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
  NOONMARK_EVIDENCE_RUN_ID="fixture-run" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/package-dmg release
) >"$fixture_root/package.stdout" 2>"$fixture_root/package.stderr"
package_status=$?
set -e

if [[ "$package_status" -ne 0 ]]; then
  echo "package-dmg violated its pre-build clean/signing contract (status=$package_status)" >&2
  cat "$fixture_root/package.stderr" >&2
  [[ ! -f "$fixture_root/codesign.log" ]] || cat "$fixture_root/codesign.log" >&2
  exit 1
fi

if [[ ! -s "$fixture_root/dist/Noonmark.dmg.manifest" ]]; then
  echo "package-dmg did not emit a provenance manifest beside the DMG" >&2
  exit 1
fi

for requirement in \
  "evidence_schema_version=1" \
  "evidence_run_id=fixture-run" \
  "suite=package-dmg" \
  "configuration=release" \
  "suite_mode=full" \
  "app_codesign_team_identifier=FIXTURETEAM" \
  "app_codesign_deep_strict=1" \
  "app_stable_required=1" \
  "release_symbols_uuid_match=true" \
  "release_identity_version=0.1.0" \
  "release_identity_build=1" \
  "release_identity_runtime=Swift-native" \
  "release_identity_minimum_os_version=14.0" \
  "release_identity_architecture=arm64" \
  "release_identity_binary_sha256_scope=linked-before-bundle-signing" \
  "release_identity_provenance_path=dist/Noonmark.app.release-build-identity" \
  "suite_exit_status=0"; do
  if ! grep -Fqx "$requirement" "$fixture_root/dist/Noonmark.dmg.manifest"; then
    echo "package manifest is missing $requirement" >&2
    cat "$fixture_root/dist/Noonmark.dmg.manifest" >&2
    exit 1
  fi
done
if ! grep -Eq '^source_worktree_tree_oid=[0-9a-f]{40}$' \
  "$fixture_root/dist/Noonmark.dmg.manifest"; then
  echo "package manifest lacks the exact Git worktree tree OID" >&2
  cat "$fixture_root/dist/Noonmark.dmg.manifest" >&2
  exit 1
fi
if ! grep -Eq '^release_identity_git_commit=[0-9a-f]{40}$' \
  "$fixture_root/dist/Noonmark.dmg.manifest" ||
  ! grep -Eq '^release_identity_build_date=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
    "$fixture_root/dist/Noonmark.dmg.manifest"; then
  echo "package manifest lacks exact release commit or build date identity" >&2
  exit 1
fi
if ! grep -Eq '^release_identity_provenance_sha256=[0-9a-f]{64}$' \
  "$fixture_root/dist/Noonmark.dmg.manifest"; then
  echo "package manifest lacks exact release identity provenance" >&2
  exit 1
fi
linked_binary_sha256="$(
  awk -F= \
    '$1 == "release_build_identity_binary_sha256" { print $2 }' \
    "$fixture_root/dist/Noonmark.app.release-build-identity"
)"
signed_binary_sha256="$(
  awk -F= '$1 == "release_symbols_binary_sha256" { print $2 }' \
    "$fixture_root/dist/Noonmark.dmg.manifest"
)"
if [[ -z "$linked_binary_sha256" || -z "$signed_binary_sha256" ||
  "$linked_binary_sha256" == "$signed_binary_sha256" ]]; then
  echo "package fixture did not distinguish linked and signed binary SHA" >&2
  exit 1
fi

if ! grep -Eq -- \
  '^--verify --deep --strict .*/Noonmark\.app$' \
  "$fixture_root/codesign.log"; then
  echo "verify-dmg did not run deep strict signature verification on the mounted app" >&2
  cat "$fixture_root/codesign.log" >&2 2>/dev/null || true
  exit 1
fi

cp \
  "$fixture_root/dist/Noonmark.dmg.manifest" \
  "$fixture_root/dist/Noonmark.dmg.manifest.valid"
sed -i '' \
  's/^app_binary_sha256=.*/app_binary_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff/' \
  "$fixture_root/dist/Noonmark.dmg.manifest"
set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/verify-dmg dist/Noonmark.dmg
) >"$fixture_root/verify-tampered.stdout" 2>"$fixture_root/verify-tampered.stderr"
tampered_status=$?
set -e
if [[ "$tampered_status" -eq 0 ]]; then
  echo "verify-dmg accepted a mounted binary that disagreed with the package manifest" >&2
  exit 1
fi
mv \
  "$fixture_root/dist/Noonmark.dmg.manifest.valid" \
  "$fixture_root/dist/Noonmark.dmg.manifest"

mv \
  "$fixture_root/dist/Noonmark.app.dSYM" \
  "$fixture_root/dist/Noonmark.app.dSYM.missing"
set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/verify-dmg dist/Noonmark.dmg
) >"$fixture_root/verify-missing-dsym.stdout" \
  2>"$fixture_root/verify-missing-dsym.stderr"
missing_dsym_status=$?
set -e
mv \
  "$fixture_root/dist/Noonmark.app.dSYM.missing" \
  "$fixture_root/dist/Noonmark.app.dSYM"
if [[ "$missing_dsym_status" -eq 0 ]]; then
  echo "verify-dmg accepted a missing release dSYM" >&2
  exit 1
fi

cp \
  "$fixture_root/dist/Noonmark.app.release-build-identity" \
  "$fixture_root/dist/Noonmark.app.release-build-identity.valid"
sed -i '' \
  's/^release_build_identity_binary_sha256=.*/release_build_identity_binary_sha256=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff/' \
  "$fixture_root/dist/Noonmark.app.release-build-identity"
set +e
(
  cd "$fixture_root"
  FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log" \
    PATH="$fixture_root/bin:$PATH" \
    scripts/verify-dmg dist/Noonmark.dmg
) >"$fixture_root/verify-tampered-build-identity.stdout" \
  2>"$fixture_root/verify-tampered-build-identity.stderr"
tampered_build_identity_status=$?
set -e
mv \
  "$fixture_root/dist/Noonmark.app.release-build-identity.valid" \
  "$fixture_root/dist/Noonmark.app.release-build-identity"
if [[ "$tampered_build_identity_status" -eq 0 ]]; then
  echo "verify-dmg accepted tampered release build identity provenance" >&2
  exit 1
fi

export FIXTURE_CODESIGN_LOG="$fixture_root/codesign.log"
export PATH="$fixture_root/bin:$PATH"
mkdir -p \
  "$fixture_root/artifacts/e2e-runtime" \
  "$fixture_root/artifacts/e2e-data-root-process-lease" \
  "$fixture_root/artifacts/dmg-install/diagnostics" \
  "$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkE2E.app/Contents/MacOS" \
  "$fixture_root/artifacts/e2e-runtime/helper-snapshot/NoonmarkDMGInstallHarness.app/Contents/MacOS" \
  "$fixture_root/artifacts/e2e-data-root-process-lease/app-snapshot" \
  "$fixture_root/artifacts/dmg-install/Applications" \
  "$fixture_root/artifacts/dmg-install-harness"
printf 'fixture\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/summary.txt"
printf 'runtime_evidence_capture_started=fixture\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/unified.log"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-runtime/diagnostic-result.txt"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-runtime/helper-diagnostic-result.txt"
printf 'new_diagnostic_count=0\n' \
  >"$fixture_root/artifacts/e2e-data-root-process-lease/diagnostic-result.txt"
printf 'runtime_evidence_capture_started=fixture\n' \
  >"$fixture_root/artifacts/e2e-runtime/unified.log"
cat >"$fixture_root/artifacts/e2e-runtime/runtime-manifest.txt" <<'EOF'
process=NoonmarkMacAppE2E
bundle=dist/NoonmarkE2E.app
started_at=2026-07-17T00:00:00Z
finished_at=2026-07-17T00:00:01Z
suite_exit_status=0
EOF
for diagnostic in \
  diagnostic-baseline.txt \
  diagnostic-baseline.txt.current \
  diagnostic-baseline.txt.new \
  helper-diagnostic-baseline.txt \
  helper-diagnostic-baseline.txt.current \
  helper-diagnostic-baseline.txt.new; do
  : >"$fixture_root/artifacts/e2e-runtime/$diagnostic"
done
for diagnostic in \
  diagnostic-baseline.txt \
  diagnostic-baseline.txt.current \
  diagnostic-baseline.txt.new; do
  : >"$fixture_root/artifacts/e2e-data-root-process-lease/$diagnostic"
done
for diagnostic in \
  noonmark-baseline.txt \
  noonmark-final.txt \
  noonmark-diff.txt \
  harness-baseline.txt \
  harness-final.txt \
  harness-diff.txt; do
  : >"$fixture_root/artifacts/dmg-install/diagnostics/$diagnostic"
done
printf 'fixture-e2e-binary\n' \
  >"$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkE2E.app/Contents/MacOS/NoonmarkMacAppE2E"
cat >"$fixture_root/artifacts/e2e-runtime/app-snapshot/NoonmarkE2E.app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
