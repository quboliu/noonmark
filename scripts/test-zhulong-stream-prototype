#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
prototype_html="${NOONMARK_ZHULONG_STREAM_PROTOTYPE_HTML:-${repo_root}/docs/design/prototypes/zhulong-converged-2026-07-10/stream-prototype.html}"
cdp_harness_source="${repo_root}/scripts/test-zhulong-r3-prototype"

chrome_binary="${NOONMARK_CHROME_BINARY:-}"
if [[ -z "$chrome_binary" ]]; then
  if command -v google-chrome >/dev/null 2>&1; then
    chrome_binary="$(command -v google-chrome)"
  elif command -v chromium >/dev/null 2>&1; then
    chrome_binary="$(command -v chromium)"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    chrome_binary="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    printf '%s\n' '{"status":"FAIL","error":"missing Chrome/Chromium for Zhulong stream CDP acceptance"}' >&2
    exit 1
  fi
fi

if [[ ! -f "$prototype_html" || ! -f "$cdp_harness_source" ]]; then
  printf '%s\n' '{"status":"FAIL","error":"missing stream prototype or shared CDP harness source"}' >&2
  exit 1
fi

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-zhulong-stream-cdp.XXXXXX")"
profile_dir="${tmp_dir}/chrome-profile"
chrome_log="${tmp_dir}/chrome.log"
chrome_pid=""

cleanup() {
  if [[ -n "$chrome_pid" ]] && kill -0 "$chrome_pid" 2>/dev/null; then
    kill "$chrome_pid" 2>/dev/null || true
    wait "$chrome_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp_dir"
}
trap cleanup EXIT INT TERM

mkdir -p "$profile_dir"
"$chrome_binary" \
  --headless=new \
  --disable-background-networking \
  --disable-background-timer-throttling \
  --disable-backgrounding-occluded-windows \
  --disable-component-update \
  --disable-default-apps \
  --disable-extensions \
  --disable-gpu \
  --disable-renderer-backgrounding \
  --disable-sync \
  --hide-scrollbars \
  --no-default-browser-check \
  --no-first-run \
  --remote-allow-origins='*' \
  --remote-debugging-port=0 \
  --user-data-dir="$profile_dir" \
  --window-size=1180,760 \
  about:blank >"$chrome_log" 2>&1 &
chrome_pid=$!

devtools_file="${profile_dir}/DevToolsActivePort"
for _ in {1..200}; do
  [[ -s "$devtools_file" ]] && break
  if ! kill -0 "$chrome_pid" 2>/dev/null; then
    printf '%s\n' '{"status":"FAIL","error":"Chrome exited before CDP became ready"}' >&2
    sed -n '1,120p' "$chrome_log" >&2
    exit 1
  fi
  sleep 0.05
done

if [[ ! -s "$devtools_file" ]]; then
  printf '%s\n' '{"status":"FAIL","error":"Chrome CDP readiness timed out"}' >&2
  sed -n '1,120p' "$chrome_log" >&2
  exit 1
fi

debug_port="$(sed -n '1p' "$devtools_file")"

set +e
python3 - "$debug_port" "$prototype_html" "$cdp_harness_source" <<'PY'
import json
import re
import sys
import time
import urllib.request
from pathlib import Path


def load_shared_cdp(harness_path):
    source = Path(harness_path).read_text()
    marker = "python3 - \"$debug_port\" \"$prototype_html\" <<'PY'\n"
    if marker not in source:
        raise RuntimeError("shared CDP harness marker not found")
    embedded = source.split(marker, 1)[1].split("\nPY\ntest_status=", 1)[0]
    prefix = embedded.split("\nclass ZhulongR3Acceptance:", 1)[0]
    namespace = {}
    exec(prefix, namespace)
    return namespace["AcceptanceFailure"], namespace["CDPWebSocket"]


AcceptanceFailure, CDPWebSocket = load_shared_cdp(sys.argv[3])


def page_websocket_url(port):
    deadline = time.monotonic() + 8
    last_error = None
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/list", timeout=1) as response:
                targets = json.load(response)
            for target in targets:
                if target.get("type") == "page" and target.get("webSocketDebuggerUrl"):
                    return target["webSocketDebuggerUrl"]
        except (OSError, ValueError) as error:
            last_error = error
        time.sleep(0.05)
    raise AcceptanceFailure(f"CDP page target did not become ready: {last_error}")


class StreamAcceptance:
    def __init__(self, cdp, prototype_path):
        self.cdp = cdp
        self.base_url = Path(prototype_path).resolve().as_uri()
        self.checks = []
        self.started_at = time.monotonic()
        self.geometry = None

    def evaluate(self, expression):
        response = self.cdp.command(
            "Runtime.evaluate",
            {
                "expression": expression,
                "returnByValue": True,
                "awaitPromise": True,
                "userGesture": True,
            },
        )
        if "exceptionDetails" in response:
            details = response["exceptionDetails"]
            raise AcceptanceFailure(f"browser evaluation failed: {details.get('text', 'unknown exception')}")
        result = response.get("result", {})
        if result.get("subtype") == "error":
            raise AcceptanceFailure(f"browser evaluation returned an error: {result.get('description', result)}")
        return result.get("value")

    def wait_for(self, expression, description, timeout=8):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if self.evaluate(expression):
                return
            time.sleep(0.05)
        raise AcceptanceFailure(f"timed out waiting for {description}")

    def navigate(self, query):
        response = self.cdp.command("Page.navigate", {"url": f"{self.base_url}?{query}"})
        if response.get("errorText"):
            raise AcceptanceFailure(f"navigation failed: {response['errorText']}")
        self.wait_for(
            "document.readyState === 'complete' && Boolean(document.querySelector('[data-stream-session]'))",
            f"stream page {query}",
        )

    def click(self, selector):
        result = self.evaluate(
            "(() => {"
            f"const element = document.querySelector({json.dumps(selector)});"
            "if (!element) return {found:false};"
            "if (element.disabled) return {found:true,disabled:true};"
            "element.click();"
            "return {found:true,disabled:false};"
            "})()"
        )
        if not result or not result.get("found"):
            raise AcceptanceFailure(f"required browser control not found: {selector}")
        if result.get("disabled"):
            raise AcceptanceFailure(f"required browser control is disabled: {selector}")

    def physical_click(self, selector):
        point = self.evaluate(
            "(() => {"
            f"const element=document.querySelector({json.dumps(selector)});"
            "if(!element||element.disabled) return null;const rect=element.getBoundingClientRect();"
            "return {x:rect.left+rect.width/2,y:rect.top+rect.height/2};})()"
        )
        if not point:
            raise AcceptanceFailure(f"required physical browser control not found or disabled: {selector}")
        self.cdp.command(
            "Input.dispatchMouseEvent",
            {"type": "mousePressed", "x": point["x"], "y": point["y"], "button": "left", "clickCount": 1},
        )
        self.cdp.command(
            "Input.dispatchMouseEvent",
            {"type": "mouseReleased", "x": point["x"], "y": point["y"], "button": "left", "clickCount": 1},
        )

    def choose_layout(self, variant):
        if not self.count('[data-layout-menu]'):
            self.physical_click('[data-layout-trigger]')
            self.wait_for(
                "Boolean(document.querySelector('[data-layout-menu]'))"
                " && document.querySelector('[data-layout-trigger]')?.getAttribute('aria-expanded')==='true'",
                "layout menu to open",
            )
        self.physical_click(f'[data-layout-option][data-value="{variant}"]')
        try:
            self.wait_for(
                f"Boolean(document.querySelector('[data-variant-view={json.dumps(variant)}]'))"
                f" && new URLSearchParams(location.search).get('variant')==={json.dumps(variant)}"
                " && !document.querySelector('[data-layout-menu]')",
                f"layout {variant} to render from the formal menu",
            )
        except AcceptanceFailure as error:
            probe = self.evaluate(
                "(() => ({url:new URLSearchParams(location.search).get('variant')||'',"
                "rendered:document.querySelector('.mac-window')?.dataset.variant||'',"
                "menu:Boolean(document.querySelector('[data-layout-menu]')),"
                "active:document.activeElement?.outerHTML||''}))()"
            )
            raise AcceptanceFailure(f"{error}; probe={json.dumps(probe, ensure_ascii=False, sort_keys=True)}")
        self.wait_for(
            "document.activeElement===document.querySelector('[data-layout-trigger]')",
            f"layout {variant} selection to restore PageHeader trigger focus",
        )

    def physical_double_click(self, selector):
        point = self.evaluate(
            "(() => {"
            f"const element=document.querySelector({json.dumps(selector)});"
            "if(!element) return null;const rect=element.getBoundingClientRect();"
            "return {x:rect.left+rect.width/2,y:rect.top+rect.height/2};})()"
        )
        if not point:
            raise AcceptanceFailure(f"required physical browser control not found: {selector}")
        for click_count in [1, 2]:
            self.cdp.command(
                "Input.dispatchMouseEvent",
                {"type": "mousePressed", "x": point["x"], "y": point["y"], "button": "left", "clickCount": click_count},
            )
            self.cdp.command(
                "Input.dispatchMouseEvent",
                {"type": "mouseReleased", "x": point["x"], "y": point["y"], "button": "left", "clickCount": click_count},
            )

    def physical_wheel(self, selector, delta_y):
        point = self.evaluate(
            "(() => {"
            f"const element=document.querySelector({json.dumps(selector)});"
            "if(!element) return null;const rect=element.getBoundingClientRect();"
            "return {x:rect.left+rect.width/2,y:rect.top+rect.height/2};})()"
        )
        if not point:
            raise AcceptanceFailure(f"required wheel target not found: {selector}")
        self.cdp.command(
            "Input.dispatchMouseEvent",
            {"type": "mouseWheel", "x": point["x"], "y": point["y"], "deltaX": 0, "deltaY": delta_y},
        )

    def install_painted_commit_probe(self):
        self.evaluate(
            """(() => {
              window.__streamPaintProbe?.observer?.disconnect();
              const samples=[];
              const read=()=>({
                t:performance.now(),
                count:document.querySelectorAll('[data-stream-node]').length,
                runState:document.querySelector('[data-stream-session]')?.dataset.runState||'',
                currentStage:document.querySelector('[data-stream-node][data-state="current"]')?.dataset.stage||'',
                unseen:Number(document.querySelector('[data-return-current]')?.dataset.unseenCount||0),
                unreadVisible:document.querySelector('[data-return-current]')?.classList.contains('visible')||false,
                unreadLabel:document.querySelector('[data-return-current]')?.innerText||'',
                motionState:document.querySelector('[data-stream-scroll]')?.dataset.scrollMotionState||'',
                fingerprints:[...document.querySelectorAll('[data-stream-node]')].map((node)=>({
                  id:node.dataset.nodeId,stage:node.dataset.stage,kind:node.dataset.kind,branch:node.dataset.branch,
                  dependsOn:node.dataset.dependsOn,resolves:node.dataset.resolves,authorityId:node.dataset.authorityId,
                  contractId:node.dataset.contractId,runId:node.dataset.runId,runStatus:node.dataset.runStatus,
                  runOrdinal:node.dataset.runOrdinal,activityType:node.dataset.activityType,artifactType:node.dataset.artifactType,
                  invalidates:node.dataset.invalidates,diffHash:node.dataset.diffHash,idempotencyKey:node.dataset.idempotencyKey,
                  payload:node.querySelector('[data-node-payload]')?.textContent||''
                }))
              });
              let scheduled=false;
              const sampleAfterPaint=()=>{
                if(scheduled) return;
                scheduled=true;
                requestAnimationFrame(()=>requestAnimationFrame(()=>{samples.push(read());scheduled=false;}));
              };
              const log=document.querySelector('[data-stream-log]');
              const observer=new MutationObserver(sampleAfterPaint);
              observer.observe(log,{childList:true,subtree:true});
              samples.push(read());
              window.__streamPaintProbe={observer,samples};
              return true;
            })()"""
        )

    def painted_commit_samples(self):
        time.sleep(0.08)
        return self.evaluate("window.__streamPaintProbe?.samples || []")

    def input(self, selector, value):
        result = self.evaluate(
            "(() => {"
            f"const element = document.querySelector({json.dumps(selector)});"
            "if (!element) return false;"
            f"element.value = {json.dumps(value)};"
            "element.dispatchEvent(new Event('input', {bubbles:true}));"
            "return true;"
            "})()"
        )
        if not result:
            raise AcceptanceFailure(f"required browser input not found: {selector}")

    def text(self, selector="body"):
        return self.evaluate(f"document.querySelector({json.dumps(selector)})?.innerText || ''")

    def count(self, selector):
        return self.evaluate(f"document.querySelectorAll({json.dumps(selector)}).length")

    def trace_scroll_action(self, action_selector, source_selector, target_selector, semantic_expression):
        time.sleep(0.08)
        initial = self.evaluate(
            "(() => {"
            "const scroller=document.querySelector('[data-stream-scroll]');"
            "window.__streamTraceScroller=scroller;"
            f"const source=document.querySelector({json.dumps(source_selector)});"
            "const rect=scroller.getBoundingClientRect();"
            "const sidebar=document.querySelector('.sidebar').getBoundingClientRect();"
            "const header=document.querySelector('.page-header').getBoundingClientRect();"
            "const rail=document.querySelector('.detail-rail').getBoundingClientRect();"
            "return {beforeTop:scroller.scrollTop,sourceId:source?.dataset.nodeId||'',"
            "sourceBeforeY:source?source.getBoundingClientRect().top-rect.top:null,"
            "shellBefore:[sidebar.x,sidebar.y,sidebar.width,sidebar.height,header.x,header.y,header.width,header.height,rail.x,rail.y,rail.width,rail.height]};})()"
        )
        self.click(action_selector)
        samples = []
        stable = 0
        last_top = None
        started = time.monotonic()
        while time.monotonic() - started <= 2.2:
            sample = self.evaluate(
                "(() => {"
                "const scroller=document.querySelector('[data-stream-scroll]');"
                "const rect=scroller.getBoundingClientRect();"
                f"const sourceId={json.dumps(initial['sourceId'])};"
                "const source=sourceId?document.getElementById(sourceId):null;"
                f"const target=document.querySelector({json.dumps(target_selector)});"
                "const targetRect=target?.getBoundingClientRect();"
                "const visibleHeight=targetRect?Math.max(0,Math.min(targetRect.bottom,rect.bottom)-Math.max(targetRect.top,rect.top)):0;"
                "const actionButton=target?.querySelector('[data-current-action] .primary-button, .primary-button')||"
                "(target?.matches('[data-state=\"current\"]')?target.querySelector('.primary-button'):null);"
                "let actionHit=true;if(actionButton){const box=actionButton.getBoundingClientRect();"
                "const hit=document.elementFromPoint(box.left+box.width/2,box.top+box.height/2);actionHit=hit===actionButton||actionButton.contains(hit);}"
                "const sidebar=document.querySelector('.sidebar').getBoundingClientRect();"
                "const header=document.querySelector('.page-header').getBoundingClientRect();"
                "const rail=document.querySelector('.detail-rail').getBoundingClientRect();"
                f"return {{t:{(time.monotonic() - started) * 1000},top:scroller.scrollTop,"
                "sourceY:source&&source.offsetParent!==null?source.getBoundingClientRect().top-rect.top:null,"
                "targetRatio:targetRect&&targetRect.height?visibleHeight/targetRect.height:0,actionHit,"
                "sameScroller:scroller===window.__streamTraceScroller,"
                "state:scroller.dataset.scrollMotionState||'',"
                "motionStart:scroller.dataset.scrollMotionStart||'',motionTarget:scroller.dataset.scrollMotionTarget||'',"
                "motionDirection:scroller.dataset.scrollMotionDirection||'',"
                "controllerMaxStep:Number(scroller.dataset.scrollMotionMaxStep||0),clientHeight:scroller.clientHeight,"
                "shell:[sidebar.x,sidebar.y,sidebar.width,sidebar.height,header.x,header.y,header.width,header.height,rail.x,rail.y,rail.width,rail.height],"
                f"semanticDone:Boolean({semantic_expression})}};}})()"
            )
            samples.append(sample)
            stable = stable + 1 if last_top is not None and abs(sample["top"] - last_top) <= 0.75 else 0
            last_top = sample["top"]
            moved = abs(sample["top"] - initial["beforeTop"]) > 8
            if sample["semanticDone"] and moved and sample["state"] in ["settled", "idle"] and stable >= 4:
                return {**initial, "samples": samples}
            time.sleep(0.016)
        return {**initial, "samples": samples, "error": "timeout"}

    def assert_scroll_trace(self, name, trace, direction, require_action_hit=False):
        samples = trace.get("samples", []) if trace else []
        positions = [sample["top"] for sample in samples]
        start = positions[0] if positions else (trace.get("beforeTop", 0) if trace else 0)
        end = positions[-1] if positions else start
        total = abs(end - start)
        epsilon = 0.75
        intermediates = []
        for position in positions:
            if abs(position - start) > epsilon and abs(position - end) > epsilon:
                if not intermediates or abs(position - intermediates[-1]) > epsilon:
                    intermediates.append(position)
        deltas = [positions[index] - positions[index - 1] for index in range(1, len(positions))]
        reverse = sum(max(0, delta if direction == "backward" else -delta) for delta in deltas)
        max_step = max((abs(delta) for delta in deltas), default=0)
        moving_times = [sample["t"] for sample in samples if abs(sample["top"] - start) > epsilon]
        settled_time = next((sample["t"] for sample in samples if sample["state"] in ["settled", "idle"]), None)
        duration = (settled_time - moving_times[0]) if moving_times and settled_time is not None else 0
        first_travel = next((sample for sample in samples if sample["state"] == "traveling"), None)
        early_samples = [
            sample for sample in samples
            if first_travel and first_travel["t"] <= sample["t"] <= first_travel["t"] + 100
        ]
        early_displacement = max((abs(sample["top"] - first_travel["top"]) for sample in early_samples), default=0)
        client_height = samples[-1]["clientHeight"] if samples else 0
        controller_max_step = samples[-1]["controllerMaxStep"] if samples else 999
        first_source_y = next((sample["sourceY"] for sample in samples if sample["sourceY"] is not None), None)
        source_drift = abs(first_source_y - trace.get("sourceBeforeY", first_source_y or 0)) if first_source_y is not None else 999
        shell_before = trace.get("shellBefore", []) if trace else []
        shell_drift = max(
            (abs(value - shell_before[index]) for sample in samples for index, value in enumerate(sample["shell"]) if index < len(shell_before)),
            default=999,
        )
        direction_ok = (end < start - 120) if direction == "backward" else (end > start + 120)
        detail = json.dumps(
            {
                "error": trace.get("error") if trace else "missing trace",
                "start": start,
                "end": end,
                "total": total,
                "intermediates": len(intermediates),
                "duration": duration,
                "reverse": reverse,
                "maxStep": max_step,
                "controllerMaxStep": controller_max_step,
                "earlyDisplacement": early_displacement,
                "clientHeight": client_height,
                "sourceDrift": source_drift,
                "shellDrift": shell_drift,
                "samples": len(samples),
                "last": samples[-1] if samples else {},
            },
            sort_keys=True,
        )
        self.check(
            name,
            # A CDP poll can span more than one painted frame; controllerMaxStep is the exact per-frame guard.
            not trace.get("error")
            and direction_ok
            and len(intermediates) >= 4
            and 64 <= duration <= 850
            and reverse <= 4
            and max_step <= client_height * 0.48
            and controller_max_step <= client_height * 0.18
            and early_displacement <= client_height * 0.45
            and source_drift <= 12
            and shell_drift <= 1
            and all(sample["sameScroller"] for sample in samples)
            and samples[-1]["targetRatio"] >= 0.6
            and (not require_action_hit or samples[-1]["actionHit"]),
            detail,
        )

    def snapshot(self):
        return self.evaluate(
            "(() => ({"
            "active: document.querySelector('[data-stream-session]')?.dataset.activeNodeId || '',"
            "planState: document.querySelector('[data-stream-session]')?.dataset.planState || '',"
            "nodes: [...document.querySelectorAll('[data-stream-node]')].map((node) => ({"
            "id: node.dataset.nodeId, stage: node.dataset.stage, kind: node.dataset.kind,"
            "state: node.dataset.state, invalidatedBy: node.dataset.invalidatedBy || '',"
            "semantic: [node.dataset.dependsOn,node.dataset.resolves,node.dataset.authorityId,node.dataset.invalidates,node.dataset.diffHash,node.dataset.idempotencyKey].join('|'),"
            "payload: node.querySelector('[data-node-payload]')?.textContent || ''"
            "}))"
            "}))()"
        )

    def check(self, name, condition, detail=""):
        if not condition:
            message = f"acceptance check failed: {name}"
            if detail:
                message += f" ({detail})"
            raise AcceptanceFailure(message)
        self.checks.append(name)

    def assert_append_only(self, before, after, name):
        old_ids = [node["id"] for node in before["nodes"]]
        new_ids = [node["id"] for node in after["nodes"]]
        old_payload = [node["payload"] for node in before["nodes"]]
        new_payload = [node["payload"] for node in after["nodes"][: len(old_payload)]]
        old_semantic = [node["semantic"] for node in before["nodes"]]
        new_semantic = [node["semantic"] for node in after["nodes"][: len(old_semantic)]]
        mismatches = [
            {"id": old_ids[index], "before": old_payload[index], "after": new_payload[index]}
            for index in range(min(len(old_payload), len(new_payload)))
            if old_payload[index] != new_payload[index]
        ]
        self.check(
            name,
            len(new_ids) > len(old_ids)
            and new_ids[: len(old_ids)] == old_ids
            and new_payload == old_payload
            and new_semantic == old_semantic,
            json.dumps({"before": len(old_ids), "after": len(new_ids), "payloadMismatches": mismatches, "semanticMatch": new_semantic == old_semantic}, ensure_ascii=False),
        )

    def assert_single_tail_current(self, name):
        result = self.evaluate(
            "(() => { const nodes=[...document.querySelectorAll('[data-stream-node]')];"
            "const current=nodes.filter((node)=>node.dataset.state==='current');"
            "return {count:current.length, atTail:current.length===1 && current[0]===nodes.at(-1),"
            "active:document.querySelector('[data-stream-session]').dataset.activeNodeId,"
            "currentId:current[0]?.dataset.nodeId || ''}; })()"
        )
        self.check(name, result["count"] == 1 and result["atTail"] and result["active"] == result["currentId"], json.dumps(result))

    def choose_and_confirm(self, kind, value):
        before = self.snapshot()
        self.click(f'[data-action="choose"][data-kind="{kind}"][data-value="{value}"]')
        self.click('[data-action="confirm-current"]')
        after = self.snapshot()
        self.assert_append_only(before, after, f"{kind}-{value}-appends-without-rewriting-prefix")
        self.assert_single_tail_current(f"{kind}-{value}-leaves-one-tail-checkpoint")
        return after

    def confirm_simple(self, expected_stage):
        before = self.snapshot()
        self.check(f"current-stage-is-{expected_stage}", before["nodes"][-1]["stage"] == expected_stage)
        self.click('[data-action="confirm-current"]')
        if expected_stage in ["run", "amendment"]:
            destination = "gate" if expected_stage == "run" else "draft"
            self.wait_for(
                "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
                f" && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==={json.dumps(destination)}",
                f"record-by-record {expected_stage} run to settle at {destination}",
            )
        after = self.snapshot()
        self.assert_append_only(before, after, f"{expected_stage}-action-appends-without-rewriting-prefix")
        self.assert_single_tail_current(f"{expected_stage}-action-leaves-one-tail-checkpoint")
        return after

    def run(self):
        self.cdp.command("Runtime.enable")
        self.cdp.command("Page.enable")
        self.cdp.command("Page.bringToFront")
        self.cdp.command(
            "Emulation.setDeviceMetricsOverride",
            {"width": 1180, "height": 760, "deviceScaleFactor": 1, "mobile": False},
        )
        self.cdp.command(
            "Emulation.setEmulatedMedia",
            {"features": [{"name": "prefers-reduced-motion", "value": "no-preference"}]},
        )

        self.navigate("scenario=focus&preference-case=bootstrap")
        self.evaluate("localStorage.removeItem('noonmark.zhulong.stream-layout')")
        self.navigate("scenario=focus&preference-case=fresh")
        self.check(
            "first-visit-without-url-or-preference-renders-c",
            self.evaluate("document.querySelector('.mac-window')?.dataset.variant") == "C"
            and self.count('[data-variant-view="C"]') == 1
            and self.evaluate("document.querySelector('[data-layout-trigger]')?.innerText.includes('双轨')")
            and self.count('[data-prototype-switcher]') == 0,
        )
        self.wait_for(
            "(() => {const current=document.querySelector('[data-stream-node][data-state=\"current\"]');"
            "const action=current?.querySelector('[data-current-action] .primary-button');const scroller=document.querySelector('[data-stream-scroll]');"
            "if(!current||!action||!scroller)return false;const actionBox=action.getBoundingClientRect();const scrollBox=scroller.getBoundingClientRect();"
            "return actionBox.top>=scrollBox.top+41&&actionBox.bottom<=scrollBox.bottom"
            "&&!document.querySelector('[data-return-current]').classList.contains('visible')"
            "&&document.querySelector('.stream-detail-rail').innerText.includes(current.dataset.nodeId);})()",
            "minimum C first paint to remain on the visible current decision",
        )
        current_decision_geometry = self.evaluate(
            "(() => {const action=document.querySelector('[data-current-action] .primary-button');"
            "const actionBox=action.getBoundingClientRect();const hit=document.elementFromPoint(actionBox.left+actionBox.width/2,actionBox.top+actionBox.height/2);"
            "return {returnVisible:document.querySelector('[data-return-current]').classList.contains('visible'),"
            "actionHit:hit===action||action.contains(hit),rail:document.querySelector('.stream-detail-rail .rail-header p')?.innerText||''};})()"
        )
        self.check(
            "minimum-c-visible-current-action-does-not-enter-history-mode-or-show-an-overlapping-return-pill",
            not current_decision_geometry["returnVisible"]
            and current_decision_geometry["actionHit"]
            and "当前" in current_decision_geometry["rail"],
            json.dumps(current_decision_geometry, ensure_ascii=False, sort_keys=True),
        )
        shell_before_menu = self.evaluate(
            "(() => {const rect=(selector)=>{const box=document.querySelector(selector).getBoundingClientRect();return [box.x,box.y,box.width,box.height]};"
            "return {sidebar:rect('.sidebar'),header:rect('.page-header'),rail:rect('.detail-rail')};})()"
        )
        self.physical_click('[data-layout-trigger]')
        self.wait_for("Boolean(document.querySelector('[data-layout-menu]'))", "formal layout menu")
        layout_menu = self.evaluate(
            "(() => {const menu=document.querySelector('[data-layout-menu]');const box=menu.getBoundingClientRect();"
            "const action=document.querySelector('[data-current-action] .primary-button');const actionBox=action.getBoundingClientRect();"
            "const actionHit=document.elementFromPoint(actionBox.left+actionBox.width/2,actionBox.top+actionBox.height/2);"
            "const rect=(selector)=>{const value=document.querySelector(selector).getBoundingClientRect();return [value.x,value.y,value.width,value.height]};"
            "return {left:box.left,top:box.top,right:box.right,bottom:box.bottom,options:document.querySelectorAll('[data-layout-option]').length,"
            "pressed:document.querySelectorAll('[data-layout-option][aria-pressed=\"true\"]').length,expanded:document.querySelector('[data-layout-trigger]').getAttribute('aria-expanded'),"
            "overlapsAction:!(box.right<=actionBox.left||box.left>=actionBox.right||box.bottom<=actionBox.top||box.top>=actionBox.bottom),"
            "actionHit:actionHit===action||action.contains(actionHit),"
            "sidebar:rect('.sidebar'),header:rect('.page-header'),rail:rect('.detail-rail'),docWidth:document.documentElement.scrollWidth,bodyWidth:document.body.scrollWidth};})()"
        )
        self.check(
            "page-header-layout-menu-replaces-prototype-chrome-without-shell-shift",
            layout_menu["options"] == 3
            and layout_menu["pressed"] == 1
            and layout_menu["expanded"] == "true"
            and layout_menu["left"] >= 0
            and layout_menu["top"] >= 0
            and layout_menu["right"] <= 1180
            and layout_menu["bottom"] <= 760
            and layout_menu["docWidth"] <= 1180
            and layout_menu["bodyWidth"] <= 1180
            and not layout_menu["overlapsAction"]
            and layout_menu["actionHit"]
            and all(abs(layout_menu[key][index] - shell_before_menu[key][index]) <= 1 for key in ["sidebar", "header", "rail"] for index in range(4)),
            json.dumps(layout_menu, ensure_ascii=False, sort_keys=True),
        )
        self.cdp.command("Input.dispatchKeyEvent", {"type": "keyDown", "key": "Escape", "code": "Escape"})
        self.cdp.command("Input.dispatchKeyEvent", {"type": "keyUp", "key": "Escape", "code": "Escape"})
        self.wait_for(
            "!document.querySelector('[data-layout-menu]') && document.activeElement===document.querySelector('[data-layout-trigger]')",
            "Escape to close layout menu and restore trigger focus",
        )
        self.choose_layout("A")
        self.check(
            "layout-menu-selection-updates-url-and-local-preference",
            self.evaluate("localStorage.getItem('noonmark.zhulong.stream-layout')") == "A"
            and self.evaluate("new URLSearchParams(location.search).get('variant')") == "A",
        )
        self.navigate("variant=B&scenario=focus&preference-case=explicit")
        self.check(
            "explicit-url-wins-without-overwriting-user-preference",
            self.count('[data-variant-view="B"]') == 1
            and self.evaluate("localStorage.getItem('noonmark.zhulong.stream-layout')") == "A",
        )
        self.navigate("scenario=focus&preference-case=remembered")
        self.check(
            "url-free-navigation-restores-user-layout-preference",
            self.count('[data-variant-view="A"]') == 1,
        )
        self.navigate("variant=INVALID&scenario=focus&preference-case=invalid-url")
        self.check(
            "invalid-url-falls-back-to-valid-user-layout-preference",
            self.count('[data-variant-view="A"]') == 1
            and self.evaluate("localStorage.getItem('noonmark.zhulong.stream-layout')") == "A",
        )
        self.evaluate("localStorage.setItem('noonmark.zhulong.stream-layout','INVALID')")
        self.navigate("variant=INVALID&scenario=focus&preference-case=invalid")
        self.check(
            "invalid-url-and-preference-fail-safe-to-c",
            self.count('[data-variant-view="C"]') == 1,
        )
        self.evaluate("localStorage.removeItem('noonmark.zhulong.stream-layout')")

        self.navigate("variant=C&scenario=run&menu-case=live-append")
        self.click('[data-action="confirm-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='authorized'",
            "authorized live run before opening layout menu",
        )
        self.click('[data-layout-trigger]')
        self.wait_for(
            "Boolean(document.querySelector('[data-layout-menu]')) && document.activeElement?.matches('[data-layout-option]')",
            "layout menu and focused option during live run",
        )
        self.evaluate(
            "window.__liveMenu=document.querySelector('[data-layout-menu]');"
            "window.__liveFocusedOption=document.activeElement;"
            "window.__liveFocusedValue=document.activeElement?.dataset.value||''"
        )
        menu_open_count = self.count('[data-stream-node]')
        self.wait_for(
            f"document.querySelectorAll('[data-stream-node]').length>{menu_open_count}"
            " && Boolean(document.querySelector('[data-layout-menu]'))"
            " && document.querySelector('[data-layout-trigger]')?.getAttribute('aria-expanded')==='true'"
            " && document.querySelector('[data-layout-menu]')===window.__liveMenu"
            " && document.activeElement===window.__liveFocusedOption"
            " && document.activeElement?.dataset.value===window.__liveFocusedValue",
            "live append to preserve the open layout menu",
        )
        self.check(
            "live-append-does-not-dismiss-the-user-opened-layout-menu",
            self.count('[data-layout-option]') == 3
            and self.evaluate("document.activeElement===window.__liveFocusedOption") is True
            and self.evaluate("window.__liveFocusedValue") == "C",
        )
        live_menu_node_count = self.count('[data-stream-node]')
        self.click('.page-header-copy')
        self.wait_for(
            "!document.querySelector('[data-layout-menu]')"
            f" && document.querySelector('.page-header-copy p')?.innerText.includes('{live_menu_node_count} 条流式记录')",
            "outside click to close the layout menu and refresh deferred Header state",
        )

        self.navigate("variant=A&scenario=run")
        self.install_painted_commit_probe()
        live_before = self.snapshot()
        self.physical_double_click('[data-action="confirm-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='gate'",
            "physical double-click run to settle once at gate",
        )
        painted_samples = self.painted_commit_samples()
        painted_transitions = list(zip(painted_samples, painted_samples[1:]))
        growth_pairs = []
        previous_sample = painted_samples[0]
        for sample in painted_samples[1:]:
            if sample["count"] > previous_sample["count"]:
                growth_pairs.append((previous_sample, sample))
            previous_sample = sample
        self.check(
            "live-run-uses-distinct-painted-single-entry-commits",
            len(growth_pairs) == 5
            and all(after["count"] == before["count"] + 1 for before, after in growth_pairs)
            and len({after["t"] for _, after in growth_pairs}) == len(growth_pairs),
            json.dumps({"samples": len(painted_samples), "growth": [after["count"] - before["count"] for before, after in growth_pairs]}, sort_keys=True),
        )
        self.check(
            "every-painted-commit-is-monotonic-and-prefix-stable",
            all(
                (after["count"] == before["count"] and after["fingerprints"] == before["fingerprints"])
                or (
                    after["count"] == before["count"] + 1
                    and after["fingerprints"][: before["count"]] == before["fingerprints"]
                )
                for before, after in painted_transitions
            ),
            json.dumps(
                [{"before": before["count"], "after": after["count"]} for before, after in painted_transitions],
                sort_keys=True,
            ),
        )
        run_nodes = self.evaluate(
            "[...document.querySelectorAll('[data-stream-node][data-run-id]')].filter((node)=>node.dataset.runId).map((node)=>({"
            "id:node.dataset.nodeId,dependsOn:node.dataset.dependsOn,runId:node.dataset.runId,status:node.dataset.runStatus,ordinal:Number(node.dataset.runOrdinal),"
            "authorityId:node.dataset.authorityId,contractId:node.dataset.contractId}))"
        )
        self.check(
            "physical-double-start-creates-exactly-one-ordered-producer",
            len(run_nodes) == 5
            and len({node["runId"] for node in run_nodes}) == 1
            and len({node["authorityId"] for node in run_nodes}) == 1
            and len({node["contractId"] for node in run_nodes}) == 1
            and bool(run_nodes[0]["authorityId"])
            and self.count(f'#{run_nodes[0]["contractId"]}[data-activity-type="run-contract"]') == 1
            and [node["status"] for node in run_nodes] == ["authorized", "started", "running", "finishing", "completed"]
            and [node["ordinal"] for node in run_nodes] == list(range(5))
            and all(run_nodes[index]["dependsOn"] == run_nodes[index - 1]["id"] for index in range(1, len(run_nodes))),
            json.dumps(run_nodes, ensure_ascii=False, sort_keys=True),
        )
        self.assert_append_only(live_before, self.snapshot(), "live-run-completion-preserves-pre-run-prefix")
        self.assert_single_tail_current("live-run-completion-settles-one-gate-checkpoint")

        self.navigate("variant=A&scenario=run")
        self.install_painted_commit_probe()
        self.click('[data-action="confirm-current"]')
        time.sleep(0.22)
        self.physical_double_click('.page-header [data-action="pause-session"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='paused'",
            "durable live run pause",
        )
        time.sleep(0.08)
        paused_count = self.count('[data-stream-node]')
        paused_snapshot = self.snapshot()
        paused_probe_count = self.evaluate("window.__streamPaintProbe.samples.length")
        paused_head = self.evaluate(
            "(() => {const node=document.querySelector('[data-stream-node][data-state=\"current\"]');"
            "return {status:node?.dataset.runStatus||'',activity:node?.querySelector('[data-node-payload]')?.innerText||''};})()"
        )
        time.sleep(1.2)
        self.check(
            "paused-run-has-a-durable-receipt-and-emits-nothing",
            paused_head["status"] == "paused"
            and "不会追加新的规划步骤" in paused_head["activity"]
            and self.count('[data-stream-node]') == paused_count,
            json.dumps({"pausedCount": paused_count, "afterWindow": self.count('[data-stream-node]'), "head": paused_head}, ensure_ascii=False, sort_keys=True),
        )
        self.check(
            "paused-window-has-zero-painted-domain-commits-or-rewrites",
            self.snapshot() == paused_snapshot
            and self.evaluate("window.__streamPaintProbe.samples.length") == paused_probe_count,
        )
        paused_run_id = self.evaluate("document.querySelector('[data-stream-session]').dataset.runId")
        for layout in ["C", "B", "A"]:
            self.choose_layout(layout)
            self.check(
                f"paused-run-layout-{layout.lower()}-preserves-one-producer",
                self.snapshot() == paused_snapshot
                and self.evaluate("document.querySelector('[data-stream-session]').dataset.runState") == "paused"
                and self.evaluate("document.querySelector('[data-stream-session]').dataset.runId") == paused_run_id,
            )
        self.physical_double_click('.page-header [data-action="resume-run"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='gate'",
            "paused run to resume from the next unexecuted step",
        )
        paused_run_nodes = self.evaluate(
            "[...document.querySelectorAll('[data-stream-node]')].filter((node)=>node.dataset.runId).map((node)=>({"
            "id:node.dataset.nodeId,dependsOn:node.dataset.dependsOn,runId:node.dataset.runId,status:node.dataset.runStatus,ordinal:Number(node.dataset.runOrdinal)}))"
        )
        self.check(
            "resume-keeps-one-run-identity-and-contiguous-dependency-chain",
            [node["ordinal"] for node in paused_run_nodes] == list(range(len(paused_run_nodes)))
            and len({node["runId"] for node in paused_run_nodes}) == 1
            and sum(node["status"] == "paused" for node in paused_run_nodes) == 1
            and sum(node["status"] == "resumed" for node in paused_run_nodes) == 1
            and all(paused_run_nodes[index]["dependsOn"] == paused_run_nodes[index - 1]["id"] for index in range(1, len(paused_run_nodes))),
            json.dumps(paused_run_nodes, ensure_ascii=False, sort_keys=True),
        )

        self.navigate("variant=A&scenario=run")
        self.click('[data-action="confirm-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='authorized'",
            "cancellable run authorization",
        )
        first_cancelled_run_id = self.evaluate("document.querySelector('[data-stream-session]').dataset.runId")
        self.click('[data-action="open-session"]')
        self.click('.detail-rail [data-action="cancel-run"]')
        self.wait_for(
            "document.querySelectorAll('[data-stream-node][data-run-status=\"cancelling\"]').length>=2",
            "cancellation receipt while terminal checkpoint is pending",
        )
        self.check(
            "cancelling-phase-never-reopens-pause-or-cancel-controls",
            self.count('.page-header [data-action="pause-session"]:not([disabled])') == 0
            and self.count('.detail-rail [data-action="cancel-run"]') == 0,
        )
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='run'",
            "cancelled run recovery checkpoint",
        )
        cancelled_run_nodes = self.evaluate(
            f"[...document.querySelectorAll('[data-stream-node][data-run-id={json.dumps(first_cancelled_run_id)}]')].map((node)=>({{"
            "id:node.dataset.nodeId,dependsOn:node.dataset.dependsOn,status:node.dataset.runStatus,ordinal:Number(node.dataset.runOrdinal)}))"
        )
        self.check(
            "cancel-discards-unexecuted-steps-and-forms-a-recovery-checkpoint",
            [node["status"] for node in cancelled_run_nodes] == ["authorized", "cancelling", "cancelling", "cancelled"]
            and [node["ordinal"] for node in cancelled_run_nodes] == list(range(4))
            and all(cancelled_run_nodes[index]["dependsOn"] == cancelled_run_nodes[index - 1]["id"] for index in range(1, len(cancelled_run_nodes)))
            and self.count('[data-stream-node][data-activity-type="planning-step"]') == 0
            and self.evaluate("document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.nodeId") == cancelled_run_nodes[-1]["id"],
            json.dumps(cancelled_run_nodes, ensure_ascii=False, sort_keys=True),
        )
        self.click('[data-action="confirm-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='gate'",
            "fresh run after cancellation",
        )
        run_ids_after_restart = self.evaluate(
            "[...new Set([...document.querySelectorAll('[data-stream-node]')].map((node)=>node.dataset.runId).filter(Boolean))]"
        )
        cancelled_run_after_restart = self.evaluate(
            f"[...document.querySelectorAll('[data-stream-node][data-run-id={json.dumps(first_cancelled_run_id)}]')].map((node)=>({{"
            "id:node.dataset.nodeId,dependsOn:node.dataset.dependsOn,status:node.dataset.runStatus,ordinal:Number(node.dataset.runOrdinal)}))"
        )
        self.check(
            "restart-after-cancel-uses-a-new-run-identity",
            len(run_ids_after_restart) == 2
            and first_cancelled_run_id in run_ids_after_restart
            and cancelled_run_after_restart == cancelled_run_nodes,
            json.dumps(run_ids_after_restart, sort_keys=True),
        )

        self.navigate("variant=A&scenario=gate")
        self.click('[data-action="choose"][data-kind="gate"][data-value="investigate"]')
        self.click('[data-action="confirm-current"]')
        self.check(
            "live-draft-fixture-starts-at-amendment-checkpoint",
            self.evaluate("document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage") == "amendment",
        )
        self.install_painted_commit_probe()
        self.click('[data-action="confirm-current"]')
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='authorized'",
            "draft live run authorization",
        )
        time.sleep(0.08)
        self.physical_wheel('[data-stream-scroll]', -620)
        time.sleep(0.12)
        away_probe_index = self.evaluate("Math.max(0,window.__streamPaintProbe.samples.length-1)")
        away = self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');const box=scroller.getBoundingClientRect();"
            "const anchor=[...document.querySelectorAll('[data-stream-node]')].find((node)=>{const rect=node.getBoundingClientRect();return rect.bottom>box.top+20&&rect.top<box.bottom-20;});"
            "return {count:document.querySelectorAll('[data-stream-node]').length,scrollTop:scroller.scrollTop,anchorId:anchor?.dataset.nodeId||'',anchorY:anchor?anchor.getBoundingClientRect().top-box.top:null};})()"
        )
        self.wait_for(
            "document.querySelector('[data-stream-session]')?.dataset.runState==='idle'"
            " && document.querySelector('[data-stream-node][data-state=\"current\"]')?.dataset.stage==='draft'",
            "draft live run to finish while user owns scroll",
        )
        away_after = self.evaluate(
            "(() => {const scroller=document.querySelector('[data-stream-scroll]');const box=scroller.getBoundingClientRect();"
            f"const anchor=document.getElementById({json.dumps(away['anchorId'])});"
            "return {count:document.querySelectorAll('[data-stream-node]').length,scrollTop:scroller.scrollTop,anchorY:anchor?anchor.getBoundingClientRect().top-box.top:null,"
            "unseen:Number(document.querySelector('[data-return-current]')?.dataset.unseenCount||0),label:document.querySelector('[data-return-current]')?.innerText||'',"
            "visible:document.querySelector('[data-return-current]')?.classList.contains('visible')||false};})()"
        )
        away_painted_samples = self.painted_commit_samples()[away_probe_index:]
        away_growth = [
            after
            for before, after in zip(away_painted_samples, away_painted_samples[1:])
            if after["count"] == before["count"] + 1
        ]
        appended_while_away = away_after["count"] - away["count"]
        self.check(
            "manual-wheel-scroll-away-is-not-stolen-by-live-appends",
            away["anchorId"]
            and appended_while_away >= 4
            and abs(away_after["scrollTop"] - away["scrollTop"]) <= 3
            and abs(away_after["anchorY"] - away["anchorY"]) <= 3,
            json.dumps({"before": away, "after": away_after}, ensure_ascii=False, sort_keys=True),
        )
        self.check(
            "scroll-away-shows-exact-unread-live-record-count",
            away_after["visible"]
            and away_after["unseen"] == appended_while_away
            and f"{appended_while_away} 条新运行记录" in away_after["label"],
            json.dumps({"appended": appended_while_away, "indicator": away_after}, ensure_ascii=False, sort_keys=True),
        )
        self.check(
            "unread-indicator-increments-on-every-painted-live-commit",
            len(away_growth) == appended_while_away
            and [sample["unseen"] for sample in away_growth] == list(range(1, appended_while_away + 1))
            and all(sample["unreadVisible"] for sample in away_growth)
            and all(f"{index} 条新运行记录" in sample["unreadLabel"] for index, sample in enumerate(away_growth, 1)),
            json.dumps(
                [{"count": sample["count"], "unseen": sample["unseen"], "label": sample["unreadLabel"]} for sample in away_growth],
                ensure_ascii=False,
                sort_keys=True,
            ),
        )
        draft_chain = self.evaluate(
            "(() => {const nodes=[...document.querySelectorAll('[data-stream-node]')];"
            "const complete=nodes.find((node)=>node.dataset.activityType==='planning-complete');"
            "const plan=nodes.find((node)=>node.dataset.stage==='draft'&&node.dataset.artifactType==='plan');"
            "const checkpoint=nodes.find((node)=>node.dataset.stage==='draft'&&node.dataset.kind==='checkpoint');"
            "return {completeId:complete?.dataset.nodeId||'',planId:plan?.dataset.nodeId||'',planDepends:plan?.dataset.dependsOn||'',"
            "checkpointId:checkpoint?.dataset.nodeId||'',checkpointDepends:checkpoint?.dataset.dependsOn||'',"
            "tailId:nodes.at(-1)?.dataset.nodeId||'',currentId:nodes.find((node)=>node.dataset.state==='current')?.dataset.nodeId||'',"
            "currentCount:nodes.filter((node)=>node.dataset.state==='current').length,"
            "activeId:document.querySelector('[data-stream-session]')?.dataset.activeNodeId||''};})()"
        )
        self.check(
            "live-delegated-planning-produces-one-plan-and-one-review-checkpoint",
            self.count('[data-stream-node][data-stage="draft"][data-kind="artifact"]') == 1
            and self.count('[data-stream-node][data-stage="draft"][data-kind="checkpoint"]') == 1
            and draft_chain["planDepends"] == draft_chain["completeId"]
            and draft_chain["checkpointDepends"] == draft_chain["planId"]
            and draft_chain["currentCount"] == 1
            and draft_chain["checkpointId"] == draft_chain["tailId"] == draft_chain["currentId"] == draft_chain["activeId"],
            json.dumps(draft_chain, ensure_ascii=False, sort_keys=True),
        )
        unread_before_return = away_after["unseen"]
        self.click('[data-action="return-current"]')
        self.check(
            "return-current-keeps-unread-before-visual-travel",
            self.evaluate("Number(document.querySelector('[data-return-current]')?.dataset.unseenCount||0)") == unread_before_return,
        )
        self.wait_for(
            "document.querySelector('[data-stream-scroll]')?.dataset.scrollMotionState==='traveling'",
