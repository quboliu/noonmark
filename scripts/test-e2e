  echo "zhulong database was not created: $zhulong_db" >&2
  exit 1
fi

zhulong_sidecar_dir="${zhulong_dir}/ZhulongSidecar"
zhulong_session_count="$(find "$zhulong_sidecar_dir" -type f -name '*.zhs' | wc -l | tr -d ' ')"
if [[ "$zhulong_session_count" -ne 1 ]]; then
  echo "zhulong encrypted session was not persisted: sessions=$zhulong_session_count" >&2
  exit 1
fi

if grep -a -q "结束今天并形成下一次可信承诺" "$zhulong_sidecar_dir"/*.zhs; then
  echo "zhulong session leaked plaintext intent" >&2
  exit 1
fi

zhulong_persistence_result="${zhulong_dir}/persistence-result.txt"
open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-zhulong-sidecar-key \
  --e2e-verify-zhulong-persistence-result-url "$PWD/$zhulong_persistence_result" \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_persistence_result" || "$(cat "$zhulong_persistence_result")" != "ok" ]]; then
  echo "zhulong encrypted session did not recover after relaunch" >&2
  exit 1
fi

printf 'invalid encrypted sidecar' > "$zhulong_sidecar_dir/invalid.zhs"
zhulong_corruption_result="${zhulong_dir}/corruption-result.txt"
open -W -n "$app_path" --args \
  --data-url "$PWD/$zhulong_db" \
  --page zhulong \
  --e2e-zhulong-sidecar-key \
  --e2e-verify-zhulong-persistence-result-url "$PWD/$zhulong_corruption_result" \
  --e2e-quit-after-automation

if [[ ! -f "$zhulong_corruption_result" || "$(cat "$zhulong_corruption_result")" != "corruption-detected" ]]; then
  echo "zhulong corrupted sidecar was not reported fail-closed" >&2
  exit 1
fi

echo "E2E zhulong encrypted persistence and corruption detection: $zhulong_sidecar_dir (sessions=$zhulong_session_count)"

