                "event-history linked stream entry",
            )
        except AcceptanceFailure as error:
            probe = self.evaluate(
                "(() => ({located:document.querySelector('[data-stream-node].is-located')?.dataset.nodeId||'',"
                "returnVisible:document.querySelector('[data-return-current]')?.classList.contains('visible')||false,"
