#!/usr/bin/env bash
set -euo pipefail

configuration="${1:-debug}"
product="SuntraceMacApp"
bundle_name="${SUNTRACE_APP_BUNDLE_NAME:-$product}"
executable_name="${SUNTRACE_APP_EXECUTABLE_NAME:-$product}"
bundle_identifier="${SUNTRACE_BUNDLE_IDENTIFIER:-app.suntrace.mac}"
bundle_display_name="${SUNTRACE_APP_DISPLAY_NAME:-晷迹}"
bundle_short_name="${SUNTRACE_APP_SHORT_NAME:-Suntrace}"
bundle_dir="dist/${bundle_name}.app"
contents_dir="${bundle_dir}/Contents"
macos_dir="${contents_dir}/MacOS"
resources_dir="${contents_dir}/Resources"

swift build -c "$configuration" --product "$product"

rm -rf "$bundle_dir"
mkdir -p "$macos_dir" "$resources_dir"

binary_path=".build/arm64-apple-macosx/${configuration}/${product}"
if [[ ! -x "$binary_path" ]]; then
  binary_path=".build/${configuration}/${product}"
fi

cp "$binary_path" "${macos_dir}/${executable_name}"
chmod +x "${macos_dir}/${executable_name}"

cat > "${contents_dir}/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleDisplayName</key>
  <string>${bundle_display_name}</string>
  <key>CFBundleExecutable</key>
  <string>${executable_name}</string>
  <key>CFBundleIdentifier</key>
  <string>${bundle_identifier}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>${bundle_short_name}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
PLIST

codesign --force --sign - "$bundle_dir" >/dev/null
echo "$bundle_dir"
