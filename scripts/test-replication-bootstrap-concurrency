#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

authority_source="Sources/NoonmarkSync/ICloudReplicationRepositoryAuthority.swift"
if ! rg -Uq \
  'beforeRead: \{ coordinatedURL in\n([^\n]*\n){0,8}[[:space:]]*self\.startNonlocalVersionLoad\(\n[[:space:]]*at: coordinatedURL,' \
  "$authority_source"; then
  echo "non-local marker inventory must start inside the coordinated read accessor" >&2
  exit 1
fi
if rg -Fq -- 'initialLocalSnapshot.coordinatedURL' "$authority_source"; then
  echo "a coordinated marker URL must not escape its read accessor" >&2
  exit 1
fi

scripts/reset-dev-data audit
swift test \
  --filter 'ReplicationRepositoryBootstrapTests|ICloudReplicationRepositoryAuthorityTests|ContentAddressedFileReplicationEndpointTests.testICloudEndpoint'
