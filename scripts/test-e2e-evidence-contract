#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

if [[ ! -r scripts/evidence-common ]]; then
  echo "missing public evidence module: scripts/evidence-common" >&2
  exit 1
fi

# shellcheck source=scripts/evidence-common
source scripts/evidence-common

fixture_root="$repo_root/artifacts/evidence-contract-fixture-$$"
trap 'rm -rf "$fixture_root"' EXIT

evidence_root="$fixture_root/e2e-runtime"
manifest="$evidence_root/manifest.txt"
source_fragment="$fixture_root/source.fragment"
mkdir -p "$evidence_root"
printf 'stale\n' >"$evidence_root/stale.txt"

# Public seam: every run must replace its evidence root and expose an
# independently inspectable manifest/inventory. This fixture never builds or
# launches Noonmark.
evidence_prepare_fresh_directory "$repo_root" "$evidence_root"

if [[ -e "$evidence_root/stale.txt" ]]; then
  echo "evidence_begin_run retained an artifact from an older run" >&2
  exit 1
fi

mkdir -p "$evidence_root/actual"
printf 'current-run\n' >"$evidence_root/actual/result.txt"
evidence_capture_source "$repo_root" "source" "$source_fragment"
evidence_begin_manifest \
  "$manifest" \
  "e2e-contract" \
  "fixture-run" \
  "fixture" \
  "filtered"
evidence_append_snapshot "$manifest" "$source_fragment"
evidence_append "$manifest" "scenario_set" "english-day"
evidence_inventory \
  "$repo_root" \
  "$evidence_root/artifact-inventory.sha256" \
  "$evidence_root/actual"
inventory_sha256="$(
  shasum -a 256 "$evidence_root/artifact-inventory.sha256" | awk '{print $1}'
)"
evidence_append \
  "$manifest" \
  "artifact_inventory_sha256" \
  "$inventory_sha256"
evidence_finish_manifest \
  "$manifest" \
  0 \
  "source_head_commit" \
  "source_head_tree_oid" \
  "source_worktree_tree_oid" \
  "source_tree_dirty" \
  "scenario_set" \
  "artifact_inventory_sha256"

for required in \
  "evidence_schema_version=1" \
  "suite=e2e-contract" \
  "evidence_run_id=fixture-run" \
  "source_head_commit=" \
  "source_head_tree_oid=" \
  "source_worktree_tree_oid=" \
  "source_tree_dirty=" \
  "suite_mode=filtered" \
  "configuration=fixture" \
  "suite_exit_status=0" \
  "artifact_inventory_sha256="; do
  if ! grep -F "$required" "$manifest" >/dev/null; then
    echo "evidence manifest is missing $required" >&2
    cat "$manifest" >&2
    exit 1
  fi
done

inventory="$evidence_root/artifact-inventory.sha256"
if [[ ! -s "$inventory" ]] ||
  ! grep -F "actual/result.txt" "$inventory" >/dev/null; then
  echo "evidence inventory did not bind the observable fixture artifact" >&2
  [[ ! -f "$inventory" ]] || cat "$inventory" >&2
  exit 1
fi

require_literal() {
  local path="$1"
  local literal="$2"
  if ! grep -F -- "$literal" "$path" >/dev/null; then
    echo "$path is missing evidence contract: $literal" >&2
    exit 1
  fi
}

forbid_literal() {
  local path="$1"
  local literal="$2"
  if grep -F -- "$literal" "$path" >/dev/null; then
    echo "$path contains forbidden evidence behavior: $literal" >&2
    exit 1
  fi
}

require_order() {
  local path="$1"
  local earlier="$2"
  local later="$3"
  local earlier_line
  local later_line

  earlier_line="$(grep -nF -- "$earlier" "$path" | head -1 | cut -d: -f1 || true)"
  later_line="$(grep -nF -- "$later" "$path" | head -1 | cut -d: -f1 || true)"
  if [[ -z "$earlier_line" || -z "$later_line" ]] ||
    (( earlier_line >= later_line )); then
    echo "$path does not run '$earlier' before '$later'" >&2
    exit 1
  fi
}

