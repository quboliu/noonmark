#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
cd "$repo_root"

source scripts/dmg-install-observer-common

target_pid="${1:-}"
target_app="${2:-}"
window_number="${3:-}"
window_title="${4:-}"
expectations_path="${5:-}"
evidence_dir="${6:-}"
helper_app="${repo_root}/artifacts/dmg-install-harness/NoonmarkDMGInstallHarness.app"
helper_executable="${helper_app}/Contents/MacOS/NoonmarkDMGInstallHarness"
mode="e2e-inspect"
helper_pid=""
observer_pid=""
active_helper_observer_pid=""
active_helper_observer_parent_pid=""
active_helper_observer_token=""

helper_process_matches() {
  local command="$1"

  [[ "$command" == "$helper_executable --mode $mode "* &&
    " $command " == *" --launch-token $token "* ]]
}

if [[ ! "$target_pid" =~ ^[1-9][0-9]*$ ||
  "$target_app" != /* || ! -d "$target_app" ||
  ! "$window_number" =~ ^[1-9][0-9]*$ ||
  -z "$window_title" || "$window_title" == *$'\n'* || "$window_title" == *$'\r'* ||
  "$expectations_path" != /* || ! -f "$expectations_path" ||
  "$evidence_dir" != /* ]]; then
  echo "usage: run-e2e-ax-inspect PID ABS_APP WINDOW_NUMBER WINDOW_TITLE ABS_EXPECTATIONS ABS_EVIDENCE_DIR" >&2
  exit 2
fi
if [[ ! -x "$helper_executable" ]]; then
  echo "missing built E2E AX helper: $helper_executable" >&2
  exit 2
fi

mkdir -p "$evidence_dir"
ledger_path="${evidence_dir}/ledger.tsv"
stdout_path="${evidence_dir}/stdout.log"
stderr_path="${evidence_dir}/stderr.log"
launch_path="${evidence_dir}/open.log"
observer_log_path="${evidence_dir}/exit-observer.log"
observer_gate_path="${evidence_dir}/exit-observer-gate.txt"
exit_result_path="${evidence_dir}/exit-status.txt"
token="$(uuidgen)"

cleanup() {
  local status=$?
  trap - EXIT
  set +e
  if [[ -n "$observer_pid" ]] && kill -0 "$observer_pid" 2>/dev/null; then
    kill -TERM "$observer_pid" 2>/dev/null || true
    wait "$observer_pid" 2>/dev/null || true
  fi
  if [[ -n "$helper_pid" ]] && kill -0 "$helper_pid" 2>/dev/null; then
    helper_command="$(ps -ww -p "$helper_pid" -o command= 2>/dev/null || true)"
    if helper_process_matches "$helper_command"; then
      kill -TERM "$helper_pid" 2>/dev/null || true
    fi
  fi
  exit "$status"
}
trap cleanup EXIT

rm -f \
  "$ledger_path" \
  "$stdout_path" \
  "$stderr_path" \
  "$launch_path" \
  "$observer_log_path" \
  "$observer_gate_path" \
  "$exit_result_path"
: >"$stdout_path"
: >"$stderr_path"
: >"$launch_path"
: >"$observer_log_path"

/usr/bin/open \
  -n \
  -g \
  --stdout "$stdout_path" \
  --stderr "$stderr_path" \
  "$helper_app" \
  --args \
  --mode "$mode" \
  --ledger "$ledger_path" \
  --launch-token "$token" \
  --start-gate "$observer_gate_path" \
  --pid "$target_pid" \
  --app-path "$target_app" \
  --window-number "$window_number" \
  --window-title "$window_title" \
  --expectations "$expectations_path" \
  >"$launch_path" 2>&1

for _ in {1..400}; do
  if [[ -f "$ledger_path" ]]; then
    if grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
      break
    fi
    helper_pid="$(sed -n 's/.*helper_pid=\([0-9][0-9]*\).*/\1/p' "$ledger_path" | tail -1)"
    [[ -n "$helper_pid" ]] && break
  fi
  sleep 0.025
done
if [[ ! "$helper_pid" =~ ^[1-9][0-9]*$ ]]; then
  echo "E2E AX helper did not publish its process identity" >&2
  [[ -f "$ledger_path" ]] && cat "$ledger_path" >&2
  exit 1
fi
helper_command="$(ps -ww -p "$helper_pid" -o command= 2>/dev/null || true)"
if ! helper_process_matches "$helper_command"; then
  echo "E2E AX helper process identity or launch token did not match" >&2
  exit 1
fi

NOONMARK_HELPER_MODE="$mode" \
NOONMARK_HELPER_PID="$helper_pid" \
NOONMARK_HELPER_TOKEN="$token" \
NOONMARK_HELPER_GATE_PATH="$observer_gate_path" \
NOONMARK_HELPER_EXIT_RESULT_PATH="$exit_result_path" \
NOONMARK_HELPER_EXIT_TIMEOUT_SECONDS=30 \
swift -module-name "NoonmarkE2EAXExitObserver_${token//-/}" \
  scripts/dmg-install-exit-observer.swift \
  >"$observer_log_path" 2>&1 &
observer_pid=$!
active_helper_observer_pid="$observer_pid"
active_helper_observer_parent_pid="$$"
active_helper_observer_token="$token"

wait_for_helper_observer_gate \
  "$mode" \
  "$helper_pid" \
  "$token" \
  "$observer_gate_path" \
  "$exit_result_path"
wait_for_helper_exit_result \
  "$helper_pid" \
  "$mode" \
  "$token" \
  "$exit_result_path"
observer_pid=""

for _ in {1..160}; do
  if ! kill -0 "$helper_pid" 2>/dev/null; then
    break
  fi
  sleep 0.025
done
if kill -0 "$helper_pid" 2>/dev/null; then
  echo "E2E AX helper did not terminate" >&2
  exit 1
fi

if ! awk -v mode="$mode" -v pid="$helper_pid" -v token="$token" '
  NR == 1 { valid += ($0 == "status=PASS") }
  NR == 2 { valid += ($0 == "mode=" mode) }
  NR == 3 { valid += ($0 == "helper_pid=" pid) }
  NR == 4 { valid += ($0 == "launch_token=" token) }
  NR == 5 { valid += ($0 ~ /^fflags=0x[0-9A-F]+$/) }
  NR == 6 { valid += ($0 == "raw_status=0") }
  NR == 7 { valid += ($0 == "normal_exit=true") }
  NR == 8 { valid += ($0 == "exit_code=0") }
  NR == 9 { valid += ($0 == "signal=0") }
  END { exit !(NR == 9 && valid == 9) }
' "$exit_result_path"; then
  echo "E2E AX helper kernel exit result was invalid" >&2
  exit 1
fi
if [[ ! -s "$ledger_path" ]] || ! cmp -s "$ledger_path" "$stdout_path" ||
  [[ -s "$stderr_path" || -s "$launch_path" || -s "$observer_log_path" ]] ||
  grep -F $'\tFAIL\t' "$ledger_path" >/dev/null 2>&1; then
  echo "E2E AX helper evidence was incomplete or contained a failure" >&2
  for path in \
    "$ledger_path" "$stderr_path" "$launch_path" \
    "$observer_log_path" "$exit_result_path"; do
    [[ -f "$path" ]] && { echo "--- $path" >&2; cat "$path" >&2; }
  done
  exit 1
fi
for step in arguments process exit-observer permissions target e2e-window e2e-remove-buttons complete; do
  if [[ "$(awk -F $'\t' -v step="$step" '$2 == "PASS" && $3 == step { count += 1 } END { print count + 0 }' "$ledger_path")" != "1" ]]; then
    echo "E2E AX helper ledger lost unique step: $step" >&2
    exit 1
  fi
done
if ! grep -F $'\tPASS\tpermissions\tAXIsProcessTrusted=true CGPreflightPostEventAccess=true' \
  "$ledger_path" >/dev/null 2>&1 ||
  ! grep -F $'\tPASS\te2e-remove-buttons\tcount=2 unique=true ' \
    "$ledger_path" >/dev/null 2>&1; then
  echo "E2E AX helper did not prove trusted unique remove buttons" >&2
  exit 1
fi

echo "E2E external AX inspection: $ledger_path"
