#!/usr/bin/env bash

# Caller contract:
# - active_helper_observer_pid identifies a direct child of the current shell.
# - the observer writes gate and result artifacts atomically.
# - the observer has its own bounded kernel wait, so joining it cannot hang
#   beyond the protocol timeout.

start_helper_exit_observer_process() {
  local mode="$1"
  local helper_pid="$2"
  local token="$3"
  local gate_path="$4"
  local result_path="$5"
  local observer_log_path="$6"
  local timeout_seconds="$7"
  local observer_script_path="$8"
  local observer_module="NoonmarkExitObserver_${token//-/}"

  if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ||
    "$timeout_seconds" -gt 3600 ]]; then
    echo "helper exit observer timeout is invalid: $timeout_seconds" >&2
    return 1
  fi
  if [[ ! -f "$observer_script_path" ]]; then
    echo "helper exit observer script is missing: $observer_script_path" >&2
    return 1
  fi

  : >"$observer_log_path"
  NOONMARK_HELPER_MODE="$mode" \
    NOONMARK_HELPER_PID="$helper_pid" \
    NOONMARK_HELPER_TOKEN="$token" \
    NOONMARK_HELPER_GATE_PATH="$gate_path" \
    NOONMARK_HELPER_EXIT_RESULT_PATH="$result_path" \
    NOONMARK_HELPER_EXIT_TIMEOUT_SECONDS="$timeout_seconds" \
    swift -module-name "$observer_module" \
    "$observer_script_path" \
    >"$observer_log_path" 2>&1 &
  active_helper_observer_pid=$!
  active_helper_observer_parent_pid=$$
  active_helper_observer_token="$token"
}

helper_observer_gate_matches() {
  [[ $# -eq 4 ]] || return 1

  local gate_path="$1"
  local expected_mode="$2"
  local expected_helper_pid="$3"
  local expected_token="$4"

  if [[ ! -f "$gate_path" || -L "$gate_path" ||
    -z "$expected_mode" || "$expected_mode" == *$'\n'* ||
    "$expected_mode" == *$'\r'* ||
    ! "$expected_helper_pid" =~ ^[1-9][0-9]*$ ||
    ! "$expected_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    return 1
  fi

  awk \
    -v mode="$expected_mode" \
    -v pid="$expected_helper_pid" \
    -v token="$expected_token" '
      NR == 1 { valid += ($0 == "mode=" mode) }
      NR == 2 { valid += ($0 == "helper_pid=" pid) }
      NR == 3 { valid += ($0 == "launch_token=" token) }
      NR == 4 { valid += ($0 == "observer=EVFILT_PROC+NOTE_EXITSTATUS") }
      END { exit !(NR == 4 && valid == 4) }
    ' "$gate_path"
}

wait_for_helper_observer_gate() {
  local mode="$1"
  local helper_pid="$2"
  local token="$3"
  local gate_path="$4"
  local result_path="$5"
  for _ in {1..400}; do
    if [[ -s "$result_path" ]]; then
      if [[ ! -s "$gate_path" ]]; then
        echo "helper exit observer failed before arming" >&2
        return 1
      fi
      if ! helper_observer_gate_matches \
        "$gate_path" "$mode" "$helper_pid" "$token"; then
        echo "helper exit observer gate did not match this launch" >&2
        return 1
      fi
      return 0
    fi
    if [[ -s "$gate_path" ]]; then
      if ! helper_observer_gate_matches \
        "$gate_path" "$mode" "$helper_pid" "$token"; then
        echo "helper exit observer gate did not match this launch" >&2
        return 1
      fi
      return 0
    fi
    sleep 0.025
  done
  echo "timed out waiting for the helper exit observer to arm" >&2
  return 1
}

wait_for_helper_exit_result() {
  local helper_pid="$1"
  local mode="$2"
  local token="$3"
  local result_path="$4"
  local observer_pid="$active_helper_observer_pid"
  local observer_status

  if [[ ! "$observer_pid" =~ ^[0-9]+$ || "$observer_pid" -le 0 ]]; then
    echo "helper exit observer pid is missing or invalid" >&2
    return 1
  fi

  # `wait` is the authoritative completion boundary for this direct child.
  # A prior file-size snapshot must never be combined with a later process
  # snapshot: the observer may atomically publish its result between them.
  if wait "$observer_pid"; then
    observer_status=0
  else
    observer_status=$?
  fi
  active_helper_observer_pid=""
  active_helper_observer_parent_pid=""
  active_helper_observer_token=""

  if [[ "$observer_status" -ne 0 ]]; then
    echo "helper exit observer exited with status $observer_status" >&2
    return 1
  fi
  if [[ ! -s "$result_path" ]]; then
    echo "helper exit observer completed without a result" >&2
    return 1
  fi

  # The result's exact mode, pid, token, flags and status are validated by
  # assert_helper_completed. Keep this join responsible only for lifecycle.
  : "$helper_pid" "$mode" "$token"
}

helper_exit_result_matches() {
  [[ $# -eq 4 ]] || return 1

  local result_path="$1"
  local expected_mode="$2"
  local expected_helper_pid="$3"
  local expected_token="$4"
  local flags_hex
  local flags_value
  local required_flags=$((0x84000000))

  if [[ ! -f "$result_path" || -L "$result_path" ||
    -z "$expected_mode" || "$expected_mode" == *$'\n'* ||
    "$expected_mode" == *$'\r'* ||
    ! "$expected_helper_pid" =~ ^[1-9][0-9]*$ ||
    ! "$expected_token" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]]; then
    return 1
  fi

  if ! awk \
    -v mode="$expected_mode" \
    -v pid="$expected_helper_pid" \
    -v token="$expected_token" '
      NR == 1 { valid += ($0 == "status=PASS") }
      NR == 2 { valid += ($0 == "mode=" mode) }
      NR == 3 { valid += ($0 == "helper_pid=" pid) }
      NR == 4 { valid += ($0 == "launch_token=" token) }
      NR == 5 {
        valid += ($0 ~ /^fflags=0x[0-9A-F]{1,8}$/)
      }
      NR == 6 { valid += ($0 == "raw_status=0") }
      NR == 7 { valid += ($0 == "normal_exit=true") }
      NR == 8 { valid += ($0 == "exit_code=0") }
      NR == 9 { valid += ($0 == "signal=0") }
      END { exit !(NR == 9 && valid == 9) }
    ' "$result_path"; then
    return 1
  fi
  flags_hex="$(sed -n '5s/^fflags=0x//p' "$result_path")"
  [[ "$flags_hex" =~ ^[0-9A-F]{1,8}$ ]] || return 1
  flags_value=$((16#$flags_hex))
  (( (flags_value & required_flags) == required_flags ))
}
