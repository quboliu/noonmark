expected_e2e_binary="$(
  evidence_read "$e2e_manifest" "app_binary_sha256_before"
)"
if [[ ! -f "$english_ledger" ]] ||
  [[ "$(head -n 1 "$english_ledger")" != \
    $'scenario\tapp_binary_sha256\tscreenshot_sha256\toracles\texternal_ax' ]] ||
  [[ "$(awk -F $'\t' 'NR > 1 { print $1 }' "$english_ledger" | paste -sd, -)" != \
    "$expected_english_scenarios" ]] ||
  ! awk -F $'\t' -v expected_binary="$expected_e2e_binary" '
    NR == 1 { next }
    NF != 5 || $2 != expected_binary || length($3) != 64 ||
      $3 !~ /^[0-9a-f]+$/ { exit 1 }
    $5 != "true" && $5 != "false" { exit 1 }
    $5 == "true" && $1 != "english-day" { exit 1 }
    ($1 == "english-settings" || $1 == "english-zhulong") && $5 != "false" { exit 1 }
    END { if (NR != 11) exit 1 }
  ' "$english_ledger"; then
  echo "full English E2E ledger is missing, incomplete, or cross-binary" >&2
  exit 1
fi
actual_english_ledger_sha256="$(
  shasum -a 256 "$english_ledger" | awk '{print $1}'
)"
recorded_english_ledger_sha256="$(
  evidence_read "$e2e_manifest" "english_scenario_ledger_sha256"
)"
if [[ "$actual_english_ledger_sha256" != \
  "$recorded_english_ledger_sha256" ]]; then
  echo "English E2E ledger does not match its manifest hash" >&2
  exit 1
fi

english_screenshot_oracle_args=()
while IFS=$'\t' read -r \
  scenario scenario_binary recorded_screenshot_sha256 recorded_oracles \
  recorded_external_ax; do
  screenshot_path="$repo_root/artifacts/e2e/${scenario}.png"
  if [[ "$(evidence_expected_english_oracles "$scenario")" != \
    "$recorded_oracles" ]]; then
    echo "English E2E scenario has an unexpected oracle set: $scenario" >&2
    exit 1
  fi
  require_png_evidence "$screenshot_path" "English E2E $scenario screenshot"
  actual_screenshot_sha256="$(
    shasum -a 256 "$screenshot_path" | awk '{print $1}'
  )"
  if [[ "$actual_screenshot_sha256" != "$recorded_screenshot_sha256" ]]; then
    echo "English E2E screenshot disagrees with its ledger digest: $scenario" >&2
    exit 1
  fi
  english_screenshot_oracle_args+=("$scenario" "$screenshot_path")
done < <(tail -n +2 "$english_ledger")
verify_english_screenshot_content() {
  local english_oracle_result
  local english_oracle_error

  english_oracle_result="$(
    mktemp "${TMPDIR:-/tmp}/noonmark-english-oracles.XXXXXX"
  )"
  english_oracle_error="${english_oracle_result}.stderr"
  if ! /usr/bin/xcrun swift \
    scripts/verify-english-screenshot-content.swift \
    "${english_screenshot_oracle_args[@]}" \
    >"$english_oracle_result" 2>"$english_oracle_error"; then
    echo "English E2E screenshots failed independent Vision content verification" >&2
    cat "$english_oracle_error" >&2
    rm -f "$english_oracle_result" "$english_oracle_error"
    return 1
  fi
  if [[ "$(wc -l <"$english_oracle_result" | tr -d ' ')" != "10" ]]; then
    echo "English E2E independent Vision verifier returned an incomplete result" >&2
    rm -f "$english_oracle_result" "$english_oracle_error"
    return 1
  fi
  rm -f "$english_oracle_result" "$english_oracle_error"
}

