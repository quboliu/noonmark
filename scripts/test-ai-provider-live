#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"
source "$script_dir/load-ai-provider-config"
if ! noonmark_load_ai_provider_config; then
  exit 1
fi

case "$NOONMARK_AI_BASE_URL" in
  https://api.deepseek.com | https://api.deepseek.com/ | https://api.deepseek.com/v1 | https://api.deepseek.com/v1/) ;;
  *)
    echo "live AI tests only accept the official DeepSeek API base URL" >&2
    exit 1
    ;;
esac

case "$NOONMARK_AI_MODEL" in
  deepseek-*) ;;
  *)
    echo "live AI tests only accept a DeepSeek model" >&2
    exit 1
    ;;
esac

evidence_dir="artifacts/ai-provider-live"
database="$evidence_dir/Noonmark.sqlite"
result="$evidence_dir/result.txt"
app_log="$evidence_dir/app.log"
stream_log="$evidence_dir/stream-transport.log"
app_path="dist/NoonmarkMacAppE2E.app"
app_executable="$app_path/Contents/MacOS/NoonmarkMacAppE2E"
app_pid=""

e2e_provider_credential_state() {
  local find_status=0
  security find-generic-password \
    -s app.noonmark.zhulong.provider.e2e \
    >/dev/null 2>&1 || find_status=$?
  return "$find_status"
}

e2e_provider_defaults_state() {
  local defaults_output=""
  if defaults_output="$(
    defaults read \
      app.noonmark.mac.e2e \
      noonmark.zhulong.provider.config \
      2>&1
  )"; then
    return 0
  fi
  if [[ "$defaults_output" == *"does not exist"* ]]; then
    return 44
  fi
  return 1
}

clear_e2e_provider_credentials() {
  local deletion_count=0
  local credential_state=0
  local defaults_state=0
  while true; do
    credential_state=0
    e2e_provider_credential_state || credential_state=$?
    if [[ "$credential_state" -eq 44 ]]; then
      break
    fi
    if [[ "$credential_state" -ne 0 ]]; then
      return 1
    fi
    if ! security delete-generic-password \
      -s app.noonmark.zhulong.provider.e2e \
      >/dev/null 2>&1; then
      return 1
    fi
    deletion_count=$((deletion_count + 1))
    if [[ "$deletion_count" -ge 64 ]]; then
      return 1
    fi
  done
  defaults_state=0
  e2e_provider_defaults_state || defaults_state=$?
  if [[ "$defaults_state" -eq 0 ]]; then
    defaults delete \
      app.noonmark.mac.e2e \
      noonmark.zhulong.provider.config \
      >/dev/null 2>&1 || return 1
  elif [[ "$defaults_state" -ne 44 ]]; then
    return 1
  fi
  credential_state=0
  e2e_provider_credential_state || credential_state=$?
  defaults_state=0
  e2e_provider_defaults_state || defaults_state=$?
  [[ "$credential_state" -eq 44 && "$defaults_state" -eq 44 ]]
}

cleanup_resources() {
  if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
    if ! kill "$app_pid" 2>/dev/null && kill -0 "$app_pid" 2>/dev/null; then
      return 1
    fi
    wait "$app_pid" 2>/dev/null || true
  fi
  app_pid=""
  clear_e2e_provider_credentials
}

cleanup_on_exit() {
  local status=$?
  trap - EXIT
  if ! cleanup_resources; then
    echo "DeepSeek App E2E cleanup failed; isolated Provider state may remain" >&2
    exit 1
  fi
  exit "$status"
}
trap cleanup_on_exit EXIT

rm -rf "$evidence_dir"
mkdir -p "$evidence_dir"
if ! clear_e2e_provider_credentials; then
  echo "DeepSeek App E2E preflight cleanup failed" >&2
  exit 1
fi
scripts/reset-dev-data
if ! swift run NoonmarkAIProviderLiveSmoke >"$stream_log" 2>&1; then
  echo "DeepSeek streaming transport smoke failed" >&2
  sed -n '1,160p' "$stream_log" >&2
  exit 1
fi
echo "DeepSeek live streaming transport passed: $stream_log"
scripts/build-mac-app debug e2e >/dev/null

"$app_executable" \
  --data-url "$PWD/$database" \
  --page day \
  --e2e-automatic-classification-live \
  --e2e-automatic-classification-result-url "$PWD/$result" \
  >"$app_log" 2>&1 &
app_pid=$!

for _ in {1..1000}; do
  if [[ -f "$result" ]] || ! kill -0 "$app_pid" 2>/dev/null; then
    break
  fi
  sleep 0.1
done
if [[ ! -f "$result" ]]; then
  echo "DeepSeek App E2E did not publish a result" >&2
  sed -n '1,160p' "$app_log" >&2
  exit 1
fi
if [[ "$(<"$result")" != "ok" ]]; then
  echo "DeepSeek App E2E failed: $(<"$result")" >&2
  sed -n '1,160p' "$app_log" >&2
  exit 1
fi

for _ in {1..50}; do
  kill -0 "$app_pid" 2>/dev/null || break
  sleep 0.1
done
if kill -0 "$app_pid" 2>/dev/null; then
  echo "DeepSeek App E2E wrote ok but did not terminate" >&2
  exit 1
fi
if ! wait "$app_pid"; then
  echo "DeepSeek App E2E process failed" >&2
  sed -n '1,160p' "$app_log" >&2
  exit 1
fi
app_pid=""

sqlite_probe="$(sqlite3 -noheader -separator ' ' "$database" "
  WITH target AS (
    SELECT chain.id AS chain_id
    FROM task_chains AS chain
    JOIN task_definitions AS definition
      ON definition.chain_id = chain.id
    WHERE definition.title = 'E2E DeepSeek 自动归类真实任务'
      AND definition.superseded_at IS NULL
  )
  SELECT
    (SELECT count(*) FROM target),
    (SELECT count(*)
     FROM automatic_classification_jobs AS job
     JOIN target ON target.chain_id = job.chain_id
     WHERE job.state = 'completed'
       AND job.attempt BETWEEN 1 AND 3
       AND job.terminal_at IS NOT NULL),
    (SELECT count(*)
     FROM classification_current_relation_facts AS fact
     JOIN target ON target.chain_id = fact.chain_id
     WHERE fact.kind = 'category'
       AND fact.source_kind = 'automaticAI'),
    (SELECT count(*)
     FROM classification_current_relation_facts AS fact
     JOIN target ON target.chain_id = fact.chain_id
     WHERE fact.kind = 'label'
       AND fact.source_kind = 'automaticAI');
")"
read -r task_count job_count category_count label_count <<< "$sqlite_probe"
if [[ "$task_count" != "1" || "$job_count" != "1" \
  || "$category_count" != "1" \
  || ! "$label_count" =~ ^[1-3]$ ]]; then
  echo "DeepSeek App E2E persistence probe failed: ${sqlite_probe:-missing}" >&2
  exit 1
fi

if ! cleanup_resources; then
  echo "DeepSeek App E2E final cleanup failed" >&2
  exit 1
fi
trap - EXIT

echo "DeepSeek real App automatic classification passed: $database (category=$category_count labels=$label_count)"
