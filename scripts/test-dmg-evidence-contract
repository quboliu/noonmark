  task-row-after-restart.txt; do
  refresh_install_manifest_binding \
    "artifacts/dmg-install/$forged_day_artifact"
done
expect_install_semantic_mutation_rejected \
  self-consistent-forged-natural-day \
  "DMG install exercise process dates disagree with its natural day"
cp "$exercise_window_pristine" "$exercise_window"
cp "$restart_window_pristine" "$restart_window"
cp "$task_identity_pristine" "$task_identity"
cp "$task_before_pristine" "$task_before"
cp "$task_after_pristine" "$task_after"
cp "$install_inventory_pristine" "$install_inventory"
cp "$install_manifest_pristine" "$install_manifest"

sed -i '' \
  -e 's/2026-07-17/2099-01-01/g' \
  -e 's/7月17日/1月1日/g' \
  "$exercise_window" "$restart_window"
sed -i '' 's/2026-07-17/2099-01-01/g' \
  "$task_identity" "$task_before" "$task_after" \
  "$exercise_console" "$restart_console"
for forged_timeline_artifact in \
  installed-exercise-window.txt \
  installed-restart-window.txt \
  task-identity.tsv \
  task-row-before-restart.txt \
  task-row-after-restart.txt \
  exercise-console.log \
  restart-console.log; do
  refresh_install_manifest_binding \
    "artifacts/dmg-install/$forged_timeline_artifact"
done
expect_install_semantic_mutation_rejected \
  self-consistent-forged-system-timeline \
  "DMG install exercise system runtime timeline is outside its install manifest"
cp "$exercise_window_pristine" "$exercise_window"
cp "$restart_window_pristine" "$restart_window"
cp "$task_identity_pristine" "$task_identity"
cp "$task_before_pristine" "$task_before"
cp "$task_after_pristine" "$task_after"
cp "$exercise_console_pristine" "$exercise_console"
cp "$restart_console_pristine" "$restart_console"
cp "$install_inventory_pristine" "$install_inventory"
cp "$install_manifest_pristine" "$install_manifest"

sed -i '' \
  -e 's#pid=201 app=[^[:space:]]*#pid=999999 app=/tmp/forged/Applications/Noonmark.app#' \
  -e 's#path=[^[:space:]]* frontmost=true#path=/tmp/forged/Applications/Noonmark.app frontmost=true#' \
  "$exercise_ledger"
refresh_install_manifest_binding "artifacts/dmg-install/exercise-ledger.tsv"
expect_install_semantic_mutation_rejected \
  self-consistent-forged-exercise-target \
  "DMG install exercise ledger disagrees with archived window metadata"
cp "$exercise_ledger_pristine" "$exercise_ledger"
cp "$install_inventory_pristine" "$install_inventory"
cp "$install_manifest_pristine" "$install_manifest"

sed -i '' \
  's/independent=true window=([^)]*) sidebar=([^)]*) content=([^)]*)/independent=true window=() sidebar=() content=()/' \
  "$exercise_ledger"
refresh_install_manifest_binding "artifacts/dmg-install/exercise-ledger.tsv"
expect_install_semantic_mutation_rejected \
