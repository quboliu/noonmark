ui_entry_gate_function="$(
  sed -n '/^arm_ui_entry_start_gate() {$/,/^}$/p' scripts/test-e2e
)"
for required_gate_literal in \
  'for _ in {1..120}; do' \
  'waiting_state="$(<"$result_path")"' \
  '"waiting|$token|$process_id"' \
  'sleep 0.025'; do
  if ! grep -F -- "$required_gate_literal" \
    <<<"$ui_entry_gate_function" >/dev/null; then
    echo "UI-entry start gate lacks its bounded exact waiting event: $required_gate_literal" >&2
    exit 1
  fi
done
if [[ "$(grep -cF 'sleep 0.025' <<<"$ui_entry_gate_function")" != "1" ]]; then
  echo "UI-entry start gate has an unbounded or duplicate polling delay" >&2
  exit 1
fi
if grep -F '|| true' <<<"$ui_entry_gate_function" >/dev/null; then
  echo "UI-entry start gate suppresses its pre-arm observer failure" >&2
  exit 1
fi
gate_contract_root="$(mktemp -d "${TMPDIR:-/tmp}/noonmark-ui-entry-gate-contract.XXXXXX")"
gate_contract_fifo="$gate_contract_root/start-gate.fifo"
gate_contract_result="$gate_contract_root/result.txt"
gate_contract_record="$gate_contract_root/arm-record.txt"
gate_contract_token="11111111-2222-3333-4444-555555555555"
mkfifo -m 600 "$gate_contract_fifo"
if (
  set -euo pipefail
  active_ui_entry_start_gate_token="$gate_contract_token"
  ui_entry_start_gate_fd_open=1
  exec 8<>"$gate_contract_fifo"
  printf 'failed:synthetic-identity-handshake\n' >"$gate_contract_result"
  eval "$ui_entry_gate_function"
  if arm_ui_entry_start_gate \
    "$gate_contract_result" \
    "$gate_contract_token" \
    123 \
    456 \
    >/dev/null 2>&1; then
    exit 0
  fi
  if IFS= read -r -t 0 -u 8 unexpected_arm_record; then
    printf '%s\n' "$unexpected_arm_record" >"$gate_contract_record"
  fi
  exit 1
); then
  rm -rf "$gate_contract_root"
  echo "UI-entry start gate armed after its pre-arm observer failed" >&2
  exit 1
fi
if [[ -e "${gate_contract_result}.start-gate.txt" ]]; then
  rm -rf "$gate_contract_root"
  echo "UI-entry start gate wrote an arm ledger after observer failure" >&2
  exit 1
fi
if [[ -e "$gate_contract_record" ]]; then
  rm -rf "$gate_contract_root"
  echo "UI-entry start gate wrote an arm record after observer failure" >&2
  exit 1
fi
rm -rf "$gate_contract_root"
